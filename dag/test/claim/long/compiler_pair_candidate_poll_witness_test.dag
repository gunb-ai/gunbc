module test.claim.long.compiler_pair_candidate_poll_witness

import std.types { String, List, Bool }
import std.measure { second }
import v2.std.node { Node }
import std.optional { Present, Absent }
import v2.std.diagnostic { Outcome }
import extdeps.shell.exec { TransportScript }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.output_policy { ExpectFailure }
import gunbc.fleet_release_bins_key {
  lit, var, words, cmd, cmdl, assign_sub, seq, release_bins_emitted, release_bins_transport,
  release_bins_pack_object_name,
}
import gunbc.fleet_desired_candidate {
  compiler_pair_candidate_fetch_statements, PollForCandidate, CandidateStandingOutputOnly,
}
import v2.extdeps.languages.bash_build { bash_build_with_redir_to_file }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FLOOR'S CANDIDATE FETCH, EXECUTED AGAINST A SUPPLIED SEQUENCE OF ACTIONS API ANSWERS. The
// subject is gunbc.fleet_desired_candidate compiler_pair_candidate_fetch_statements -- the statements
// the workflow emits -- run with a stub `curl` that serves one merge_group run, reports it completed,
// and answers each artifact query from a sequence file in order. The poll reads the artifacts, then
// the run's status, so a run can upload between those two observations; the sequence
// empty -> completed -> present is that interleaving, and it must end PRESENT. Before the fetch read
// the artifacts again after observing completion, it ended absent: a base compiler that existed was
// refused as BaseCompilerUnavailable.

fn fx(t: String) -> Node { lit(t: t) }
fn in_t(path: String) -> Node { words(ws: [var(n: "T"), lit(t: path)]) }

fn write_file(path: Node, lines: List<String>) -> Node {
  bash_build_with_redir_to_file(inner: cmd(ws: concat([fx(t: "printf"), fx(t: "%s\\n")], map(lines, l => fx(t: l)))), path: path)
}

// The stub answers by URL shape. Each artifact query consumes the next line of $T/artifacts.seq.
fn stub_curl_lines() -> List<String> {
  [
    "#!/bin/sh",
    "out=; url=; while [ $# -gt 0 ]; do case \"$1\" in -o) out=\"$2\"; shift 2;; -H|--max-time) shift 2;; -*) shift;; *) url=\"$1\"; shift;; esac; done",
    "case \"$url\" in",
    "  */actions/runs\\?*) echo '{\"total_count\":1,\"workflow_runs\":[{\"id\":7,\"path\":\".github/workflows/witnesses.yml\",\"created_at\":\"2026-01-01T00:00:00Z\"}]}' > \"$out\";;",
    "  */actions/runs/7/artifacts*) n=$(cat \"$T/artifacts.n\"); n=$((n+1)); echo $n > \"$T/artifacts.n\"; a=$(sed -n \"$n\"p \"$T/artifacts.seq\");",
    "    if [ \"$a\" = present ]; then echo '{\"total_count\":1,\"artifacts\":[{\"id\":99,\"expired\":false,\"created_at\":\"2026-01-01T00:00:00Z\"}]}' > \"$out\"; else echo '{\"total_count\":0,\"artifacts\":[]}' > \"$out\"; fi;;",
    "  */actions/runs/7) echo '{\"status\":\"completed\"}' > \"$out\";;",
    join(["  */actions/artifacts/99/zip) python3 -c 'import sys,zipfile; z=zipfile.ZipFile(sys.argv[1],\"w\"); z.writestr(sys.argv[2],\"pack\"); z.close()' \"$out\" ", release_bins_pack_object_name, ";;"], ""),
    "  *) echo \"stub curl: unexpected $url\" >&2; exit 22;;",
    "esac",
  ]
}

fn fixture(artifact_answers: List<String>) -> List<Node> {
  seq(parts: [
    [
      assign_sub(name: "T", body: cmdl(ls: ["mktemp", "-d", "/tmp/gunbc_candidate_poll.XXXXXX"])),
      cmdl(ls: ["trap", "rm -rf \"$T\"", "EXIT"]),
      cmdl(ls: ["export", "T"]),
      cmd(ws: [fx(t: "mkdir"), fx(t: "-p"), in_t(path: "/bin"), in_t(path: "/rt")]),
      write_file(path: in_t(path: "/bin/curl"), lines: stub_curl_lines()),
      cmd(ws: [fx(t: "chmod"), fx(t: "+x"), in_t(path: "/bin/curl")]),
      write_file(path: in_t(path: "/artifacts.seq"), lines: artifact_answers),
      write_file(path: in_t(path: "/artifacts.n"), lines: ["0"]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "RUNNER_TEMP="), in_t(path: "/rt")])]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "GITHUB_OUTPUT="), in_t(path: "/rt/output")])]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "GITHUB_ENV="), in_t(path: "/rt/env")])]),
      cmdl(ls: ["export", "GITHUB_API_URL=https://api.invalid", "GITHUB_REPOSITORY=fixture/fixture", "GITHUB_TOKEN=fixture"]),
      cmd(ws: [fx(t: "export"), words(ws: [fx(t: "PATH="), in_t(path: "/bin:"), var(n: "PATH")])]),
    ],
  ])
}

fn fetch() -> List<Node> {
  compiler_pair_candidate_fetch_statements(
    revision: cmdl(ls: ["echo", "1111111111111111111111111111111111111111"]),
    wait: PollForCandidate { polls: 1, interval: second(count: 0) },
    export: CandidateStandingOutputOnly,
  )
}

fn e(statements: List<Node>) -> Outcome<String> { release_bins_emitted(statements: statements) }

data part_fetch: Outcome<String> = e(statements: fetch())
data script_empty_completed_present: TransportScript? = release_bins_transport(parts: [e(statements: fixture(artifact_answers: ["empty", "present"])), part_fetch])
data script_empty_completed_empty: TransportScript? = release_bins_transport(parts: [e(statements: fixture(artifact_answers: ["empty", "empty"])), part_fetch])

type ShellRun { ran: Bool, success: Bool, stdout: String }

fn run_script(script: TransportScript?) -> ShellRun {
  match script {
    Present { value: script } => {
      let r = shell.Exec.Run(script: script, expect: ExpectFailure)
      ShellRun { ran: true, success: r.success, stdout: r.stdout }
    }
    Absent => ShellRun { ran: false, success: false, stdout: "" }
  }
}

// The interleaving: the run uploaded between the empty read and the completed status. PRESENT.
test fn an_artifact_uploaded_as_the_run_completes_is_present_not_absent() -> Bool {
  let r = run_script(script: script_empty_completed_present)
  r.ran && r.success && string_contains(s: r.stdout, pattern: "pair-candidate: present, artifact 99")
}

// The positive control on the absent arm: the read after completion is empty too, so it is absence.
test fn a_run_completed_with_no_artifact_after_the_reread_is_absent() -> Bool {
  let r = run_script(script: script_empty_completed_empty)
  r.ran && r.success && string_contains(s: r.stdout, pattern: "pair-candidate: absent")
}
