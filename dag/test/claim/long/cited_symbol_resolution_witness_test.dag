test fn cited_symbol_refuses_ambiguous_binding() -> Bool {
  let facts = [
    v2.std.decl_index.DeclFact {
      qualified_name: "std.node.g1_ambiguous",
      name: "g1_ambiguous",
      kind: v2.std.decl_index.FnItem,
      node: v2.lens.enforcement.receipts.enforcement_red_probe_body_leaf,
      rel_path: "synthetic/a.dag",
    },
    v2.std.decl_index.DeclFact {
      qualified_name: "std.node.g1_ambiguous",
      name: "g1_ambiguous",
      kind: v2.std.decl_index.FnItem,
      node: v2.lens.enforcement.receipts.enforcement_red_probe_body_leaf,
      rel_path: "synthetic/b.dag",
    },
  ]
  match v2.std.decl_ref_resolution.resolve_declaration_ref(
    ref: std.decl_ref.DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "g1_ambiguous",
      field: std.decl_ref.WholeDeclaration,
    },
    facts: facts,
    modules: cited_symbol_long_witness_layer_modules
  ) {
    DeclarationRefAmbiguous { reference: _, candidates: c } => length(xs: c) == 2
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
  }
}

test fn cited_symbol_refuses_named_field_absent() -> Bool {
  match v2.std.decl_ref_resolution.resolve_declaration_ref(
    ref: std.decl_ref.DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NodeKind",
      field: std.decl_ref.NamedField { field_name: "NoSuchField_G1_RED" },
