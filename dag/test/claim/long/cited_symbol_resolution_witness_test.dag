    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

data roster_registry_ref_witness_note: String = "The roster registry joined this lens's production population because a registration named a deleted producer and nothing noticed (cited_symbol_roster_registry_widening_note, v2.lens.cited_symbol_resolution). These two witnesses are that widening's evidence, and they are a PAIR by DESIGN 4b(1): the green measures the live registry, and the red plants the exact defect that shipped — a ByDerivation predicate naming a declaration that does not exist — so the green cannot pass by measuring an empty population or a resolver that resolves everything. The red is constructed rather than drawn from history so it stays discriminating after the live defect is repaired; it does not retire when production goes green (4b(4))."

test fn roster_registry_declaration_refs_all_resolve() -> Bool {
  let pool = gunbc.doc_graph_roots.hand_authored_works_resolution_pool_roots()
  v2.std.decl_ref_resolution.cited_declaration_ref_refusal_count(
    refs: v2.lens.roster_registry.roster_registry_declaration_refs(),
    facts: v2.std.decl_index.decl_facts(pool_roots: pool),
    modules: v2.lens.module_graph.module_declaration_facts_live(pool_roots: pool)
  ) == 0
}

test fn roster_registry_ref_population_is_not_empty() -> Bool {
  length(xs: v2.lens.roster_registry.roster_registry_declaration_refs()) >= length(xs: gunbc.roster_registry.roster_registry)
}

test fn roster_registry_dangling_predicate_red_control_refuses() -> Bool {
  let planted = [
    gunbc.roster_registry.RosterRegistration {
      roster: gunbc.roster_registry.roster_decl(module_path: "v2.std.node", decl_name: "NodeKind"),
      unit_kind: "planted control unit",
      membership: gunbc.roster_registry.ByDerivation {
        predicate: gunbc.roster_registry.roster_decl(
          module_path: "v2.std.node",
          decl_name: "NoSuchProducer_G1_ROSTER_RED"
        )
      }
    }
  ]
  let refs = v2.lens.roster_registry.roster_registry_declaration_refs_from(registrations: planted)
  (length(xs: refs) == 2)
    && v2.std.decl_ref_resolution.cited_declaration_ref_refusal_count(
      refs: refs,
      facts: cited_symbol_long_witness_layer_facts,
      modules: cited_symbol_long_witness_layer_modules
    ) == 1
}
