module test.claim.long.cited_symbol_resolution_witness_test


data cited_symbol_resolution_long_witness_note: String = "G1 corpus-scale cited-symbol resolution witnesses — production HandAuthoredDocBind census and planted-control mutation proofs over live decl_facts + module_declaration_facts. Long lane only: each witness pays full witness-layer decl_facts scan(s) (operator 5s fast-lane rule 2026-07-12)."

data cited_symbol_long_witness_layer_facts: List<v2.std.decl_index.DeclFact> = v2.std.decl_index.decl_facts(pool_roots: gunbc.ci_layer_roots.witness_layer_roots)

data cited_symbol_long_witness_layer_modules: List<v2.lens.module_graph.ModuleDeclarationFact> = v2.lens.module_graph.module_declaration_facts_live(pool_roots: gunbc.ci_layer_roots.witness_layer_roots)

fn cited_symbol_hand_authored_census_live() -> v2.std.decl_ref_resolution.DeclarationRefResolutionCensus {
  let pool = gunbc.doc_graph_roots.hand_authored_works_resolution_pool_roots()
  let facts = v2.std.decl_index.decl_facts(pool_roots: pool)
  let modules = v2.lens.module_graph.module_declaration_facts_live(pool_roots: pool)
  v2.std.decl_ref_resolution.declaration_ref_resolution_census(
    refs: gunbc.doc_graph_roots.hand_authored_production_doc_declaration_refs(),
    facts: facts,
    modules: modules
  )
}

test fn cited_symbol_hand_authored_binds_all_resolve() -> Bool {
  gunbc.doc_graph_roots.hand_authored_works_refs_all_resolve()
}

test fn cited_symbol_hand_authored_census_is_zero_refusals() -> Bool {
  let pool = gunbc.doc_graph_roots.hand_authored_works_resolution_pool_roots()
  let facts = v2.std.decl_index.decl_facts(pool_roots: pool)
  let modules = v2.lens.module_graph.module_declaration_facts_live(pool_roots: pool)
  let census = v2.std.decl_ref_resolution.declaration_ref_resolution_census(
    refs: gunbc.doc_graph_roots.hand_authored_production_doc_declaration_refs(),
    facts: facts,
    modules: modules
  )
  census.module_absent_count == 0
    && census.declaration_absent_count == 0
    && census.field_absent_count == 0
    && census.ambiguous_count == 0
    && census.resolved_count == length(xs: gunbc.doc_graph_roots.hand_authored_production_doc_declaration_refs())
}

test fn cited_symbol_resolution_lens_is_green_on_live_corpus() -> Bool {
  v2.lens.cited_symbol_resolution.cited_symbol_resolution_violation_count() == 0
}

test fn doc_graph_works_refs_all_resolve() -> Bool {
  gunbc.doc_graph_roots.hand_authored_works_refs_all_resolve()
}

test fn cited_symbol_post7688_production_census_is_zero_violations() -> Bool {
  let census = cited_symbol_hand_authored_census_live()
  census.declaration_absent_count == 0
    && census.module_absent_count == 0
    && census.field_absent_count == 0
    && census.ambiguous_count == 0
    && census.resolved_count == length(xs: gunbc.doc_graph_roots.hand_authored_production_doc_declaration_refs())
}

test fn cited_symbol_refusal_count_red_on_dangling_fixture() -> Bool {
  let dangling = [
    std.decl_ref.DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NoSuchDecl_G1_RED",
      field: std.decl_ref.WholeDeclaration,
    },
  ]
  v2.std.decl_ref_resolution.cited_declaration_ref_refusal_count(
    refs: dangling,
    facts: cited_symbol_long_witness_layer_facts,
    modules: cited_symbol_long_witness_layer_modules
  ) == 1
}

test fn cited_symbol_planted_doc_graph_controls_all_refuse() -> Bool {
  v2.lens.cited_symbol_resolution.cited_symbol_planted_control_refusal_count() == 3
}

test fn cited_symbol_enrolled_population_refusal_proves_gate_not_vacuous() -> Bool {
  v2.lens.cited_symbol_resolution.cited_symbol_enrolled_refusal_count() >= 3 && v2.lens.cited_symbol_resolution.cited_symbol_resolution_violation_count() == v2.lens.cited_symbol_resolution.cited_symbol_enrolled_refusal_count() - v2.lens.cited_symbol_resolution.cited_symbol_planted_control_refusal_count()
}

test fn cited_symbol_planted_ambiguous_control_refuses_via_resolver() -> Bool {
  match v2.std.decl_ref_resolution.resolve_declaration_ref(
    ref: v2.lens.cited_symbol_resolution.cited_symbol_planted_ambiguous_control_ref,
    facts: v2.lens.cited_symbol_resolution.cited_symbol_planted_ambiguous_control_facts,
    modules: cited_symbol_long_witness_layer_modules
  ) {
    DeclarationRefAmbiguous { reference: _, candidates: c } => length(xs: c) == 2
    DeclarationRefResolved { declaration_identity: _ } => false
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
  }
}

test fn cited_symbol_production_census_ambiguous_count_is_zero() -> Bool {
  cited_symbol_hand_authored_census_live().ambiguous_count == 0
}

test fn cited_symbol_resolves_node_kind_authority() -> Bool {
  match v2.std.decl_ref_resolution.resolve_declaration_ref(
    ref: std.decl_ref.DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NodeKind",
      field: std.decl_ref.WholeDeclaration,
    },
    facts: cited_symbol_long_witness_layer_facts,
    modules: cited_symbol_long_witness_layer_modules
  ) {
    DeclarationRefResolved { declaration_identity: id } => id.qualified_name == "std.node.NodeKind"
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

