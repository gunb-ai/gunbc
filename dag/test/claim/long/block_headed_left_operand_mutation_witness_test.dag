module test.claim.long.block_headed_left_operand_mutation_witness_test

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { fold_list }
import v2.std.grammar { GrammarRoot, GrammarProduction, GrammarExpr, ParseGrammar, ModeledGrammar, VoidGrammar }
import v2.std.compilers.lexing { lex_artifact_semantic_tokens }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag {
  dag_lex_rules,
  dag_grammar,
  dag_grammar_choice,
  dag_grammar_nonterminal
}
import v2.test.parse.block_headed_left_operand_parse {
  bare_match_source,
  if_add_left_source,
  if_and_left_source,
  match_add_left_source,
  match_and_left_source,
  match_cmp_left_source,
  match_eq_left_source,
  match_mul_left_source,
  match_or_left_source,
  match_pipe_left_source,
  match_sub_left_source,
  right_operand_match_source
}

// THE MUTATION THAT REDS THE BLOCK-HEADED LEFT-OPERAND CONTROLS (v2.test.parse.
// block_headed_left_operand_parse). It rebuilds the dag grammar with the expr production swapped
// back to the shape before the repair -- match_expr, if_expr and loop_expr offered as expr
// alternatives AHEAD of binary_expr -- selected by DECLARED production identity with the swap
// count asserted, so the discrimination is one production and nothing else. Under the mutant every
// left-operand control refuses and the neighbours (a bare match, a match as the right operand)
// still parse; under the live grammar every one of them parses. Long lane: preparing the mutant
// grammar is past the floor's per-claim budget.

fn parse_accepts_with(source: String, grammar: ParseGrammar) -> Bool {
  match lex_walk_artifact(source: chars(s: source), file: ^block_left_probe, rules: dag_lex_rules()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } =>
      match parse_module(tokens: lex_artifact_semantic_tokens(artifact: a), grammar: grammar) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

fn pre_fix_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_match_expr),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_if_expr),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_loop_expr),
        right: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: ^dag_production_fn_literal),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: ^dag_production_block_expr),
            right: dag_grammar_choice(
              left: dag_grammar_nonterminal(production: ^dag_production_arrow_lambda),
              right: dag_grammar_nonterminal(production: ^dag_production_binary_expr)
            )
          )
        )
      )
    )
  )
}

fn no_productions() -> List<GrammarProduction> {
  []
}

fn swap_expr_production(productions: List<GrammarProduction>) -> List<GrammarProduction> {
  fold_list(xs: productions, empty: no_productions(), cons: fn(acc, prod) {
    match prod.name == ^dag_production_expr {
      true => concat(acc, [GrammarProduction { name: prod.name, expression: pre_fix_expr_expr(), emitted: prod.emitted }])
      false => concat(acc, [prod])
    }
  })
}

fn swapped_count(productions: List<GrammarProduction>) -> Int {
  fold_list(xs: productions, empty: 0, cons: fn(acc, prod) {
    match prod.name == ^dag_production_expr {
      true => acc + 1
      false => acc
    }
  })
}

fn pre_fix_grammar() -> ParseGrammar {
  match dag_grammar() {
    ModeledGrammar { root: r } =>
      ModeledGrammar {
        root: GrammarRoot {
          start: r.start,
          productions: swap_expr_production(productions: r.productions),
          sync_tokens: r.sync_tokens
        }
      }
    VoidGrammar => VoidGrammar
  }
}

fn swap_targets_exactly_one() -> Bool {
  match dag_grammar() {
    ModeledGrammar { root: r } => swapped_count(productions: r.productions) == 1
    VoidGrammar => false
  }
}

fn left_operand_controls() -> List<String> {
  [
    match_mul_left_source,
    match_add_left_source,
    match_cmp_left_source,
    match_eq_left_source,
    match_and_left_source,
    match_or_left_source,
    match_pipe_left_source,
    if_add_left_source,
    if_and_left_source
  ]
}

fn all_accept(sources: List<String>, grammar: ParseGrammar) -> Bool {
  fold_list(xs: sources, empty: true, cons: fn(acc, s) { acc && parse_accepts_with(source: s, grammar: grammar) })
}

fn none_accept(sources: List<String>, grammar: ParseGrammar) -> Bool {
  fold_list(xs: sources, empty: true, cons: fn(acc, s) { acc && (parse_accepts_with(source: s, grammar: grammar) == false) })
}

test fn witness_live_grammar_accepts_every_left_operand_control() -> Bool {
  all_accept(sources: left_operand_controls(), grammar: dag_grammar())
}

// `match w {..} - n` is the one control the mutant does NOT refuse: `-` is also a prefix operator,
// so under the pre-fix grammar the match ends the expression and `- n` parses as a SECOND
// statement, a unary negation. It is excluded from the refusal set above and pinned here as what it
// is: the mutant ACCEPTS it, silently, as different code. Under the live grammar it is one binary
// expression, as the seed reads it. (The newline form of the same ambiguity is the
// v2_lexer_carries_no_layout_so_a_newline_before_a_dual_role_operator_merges_silently row.)
test fn witness_pre_fix_grammar_reads_a_block_minus_as_two_statements() -> Bool {
  parse_accepts_with(source: match_sub_left_source, grammar: pre_fix_grammar())
    && parse_accepts_with(source: match_sub_left_source, grammar: dag_grammar())
}

test fn witness_pre_fix_grammar_refuses_every_left_operand_control_RED() -> Bool {
  let mutant = pre_fix_grammar()
  swap_targets_exactly_one()
    && none_accept(sources: left_operand_controls(), grammar: mutant)
    && parse_accepts_with(source: bare_match_source, grammar: mutant)
    && parse_accepts_with(source: right_operand_match_source, grammar: mutant)
}
