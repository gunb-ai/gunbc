data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// TYPED-REFERENCE INTEGRITY OF THE CARRIERS THAT PROJECT DeclarationRefs, REHOMED 2026-08-26 OFF
// v2.lens.cited_symbol_resolution'S WITNESS FILE.
//
// These rows never had the lens as their SUBJECT. Their subjects are gunbc.doc_graph_roots,
// gunbc.roster_registry, and the two instance-gap carriers (gunbc.lambda_argument_typing_gate,
// gunbc.list_membership_operation_gap) — each projects typed DeclarationRefs and each can go
// quietly false when a cited declaration is renamed. They lived in the lens's witness file because
// the lens was the mechanism they were checked THROUGH, which is a different thing from what they
// are about, and it is why deleting the lens looked like it should take them.
//
// WHAT IS SUBSUMED AND WHAT IS NOT, per row rather than per file. The rows that assert citations
// RESOLVE are now also enforced corpus-wide by v1_compiler.declaration_index at ingestion, and that
// enforcement is STRICTLY BROADER — every module, every push, not one long-lane file that executes
// nowhere. They are kept because their subject is a CARRIER'S PROJECTION rather than the corpus,
// and because the index's coverage is scoped to TYPED-LITERAL citations: DeclarationRef record
// literals and the decl_ref / decl_field_ref constructors. A computed or non-literal reference
// field is reported by the index as a coverage boundary rather than resolved, so a carrier that
// builds refs by projection is exactly the population where the two mechanisms differ.
//
// The rows that assert a POPULATION — that a projection is not empty, that citable plus
// outside-index equals total — are subsumed by nothing, before or after. The index checks whether
// the references it CAN SEE resolve, never whether a carrier silently stopped emitting some. That
// is the same property test.claim.doc_graph_reference_partition_witness_test carries per-PR, and
// the same reason it survives this cut.
//
// WHAT THIS IS NOT: enforcement. Long lane, declined by the required floor, executes nowhere today
// — each row pays a full witness-layer decl_facts scan (operator 5s fast-lane rule 2026-07-12).
// Preserved and unrun; saying otherwise would be the rung inflation DESIGN 4b(1) calls worse than
// sitting low.

data carrier_witness_layer_facts: List<DeclFact> = decl_facts(pool_roots: witness_layer_roots)

data carrier_witness_layer_modules: List<ModuleDeclarationFact> = module_declaration_facts_live(pool_roots: witness_layer_roots)

fn carrier_hand_authored_census_live() -> DeclarationRefResolutionCensus {
  let pool = hand_authored_works_resolution_pool_roots()
  let facts = decl_facts(pool_roots: pool)
  let modules = module_declaration_facts_live(pool_roots: pool)
  declaration_ref_resolution_census(
    refs: hand_authored_production_doc_declaration_refs(),
    facts: facts,
    modules: modules
  )
}

test fn carrier_ref_hand_authored_binds_all_resolve() -> Bool {
  hand_authored_works_refs_all_resolve()
}

test fn carrier_ref_hand_authored_census_is_zero_refusals() -> Bool {
  let pool = hand_authored_works_resolution_pool_roots()
  let facts = decl_facts(pool_roots: pool)
  let modules = module_declaration_facts_live(pool_roots: pool)
  let census = declaration_ref_resolution_census(
    refs: hand_authored_production_doc_declaration_refs(),
    facts: facts,
    modules: modules
  )
  census.module_absent_count == 0
    && census.declaration_absent_count == 0
    && census.field_absent_count == 0
    && census.ambiguous_count == 0
    && census.resolved_count == length(xs: hand_authored_production_doc_declaration_refs())
}

test fn doc_graph_works_refs_all_resolve() -> Bool {
  hand_authored_works_refs_all_resolve()
}

test fn carrier_ref_post7688_production_census_is_zero_violations() -> Bool {
  let census = carrier_hand_authored_census_live()
  census.declaration_absent_count == 0
    && census.module_absent_count == 0
    && census.field_absent_count == 0
    && census.ambiguous_count == 0
    && census.resolved_count == length(xs: hand_authored_production_doc_declaration_refs())
}

test fn carrier_ref_refusal_count_red_on_dangling_fixture() -> Bool {
  let dangling = [
    DeclarationRef {
      module_path: "v2.std.node",
      decl_name: "NoSuchDecl_G1_RED",
      field: WholeDeclaration,
    },
  ]
  cited_declaration_ref_refusal_count(
    refs: dangling,
    facts: carrier_witness_layer_facts,
    modules: carrier_witness_layer_modules
  ) == 1
}

test fn carrier_ref_production_census_ambiguous_count_is_zero() -> Bool {
  carrier_hand_authored_census_live().ambiguous_count == 0
}

// The roster registry joined this lens's production population because a registration named a
// deleted producer and nothing noticed (cited_symbol_roster_registry_widening_note,
// v2.lens.cited_symbol_resolution). These two witnesses are that widening's evidence, and they are
// a PAIR by DESIGN 4b(1): the green measures the live registry, and the red plants the exact defect
// that shipped — a ByDerivation predicate naming a declaration that does not exist — so the green
// cannot pass by measuring an empty population or a resolver that resolves everything. The red is
// constructed rather than drawn from history so it stays discriminating after the live defect is
// repaired; it does not retire when production goes green (4b(4)).

test fn roster_registry_declaration_refs_all_resolve() -> Bool {
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: roster_registry_declaration_refs(),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  ) == 0
}

test fn roster_registry_ref_population_is_not_empty() -> Bool {
  length(xs: roster_registry_declaration_refs()) >= length(xs: roster_registry)
}

test fn roster_registry_dangling_predicate_red_control_refuses() -> Bool {
  let planted = [
    RosterRegistration {
      roster: roster_decl(module_path: "v2.std.node", decl_name: "NodeKind"),
      unit_kind: "planted control unit",
      membership: ByDerivation {
        predicate: roster_decl(
          module_path: "v2.std.node",
          decl_name: "NoSuchProducer_G1_ROSTER_RED"
        )
      }
    }
  ]
  let refs = roster_registry_declaration_refs_from(registrations: planted)
  (length(xs: refs) == 2)
    && cited_declaration_ref_refusal_count(
      refs: refs,
      facts: carrier_witness_layer_facts,
      modules: carrier_witness_layer_modules
    ) == 1
}

// THE OUTSIDE-INDEX DISPOSITION IS GUARDED FROM BOTH SIDES, because a classification that removes
// rows from a checked population is one edit away from being an exemption list.
// instance_gap_outside_index_refs_really_do_refuse is the load-bearing half: it asserts the refs
// marked outside the index ACTUALLY REFUSE, in the exact count claimed. Mark a resolvable ref as
// outside-index to dodge a red and that witness fails, because the ref resolves and the refusal
// count comes up short. So the disposition can only ever be applied to references that genuinely
// cannot be answered, and the population it removes stays measured rather than disappearing. The
// partition witness beside it holds citable + outside == total, so a row cannot fall out of both
// halves. MUTATION-TESTED, not asserted: swapping a resolvable row to outside-index AND a
// genuinely-outside row to citable — a swap chosen because it leaves the COUNT at two, so the
// counting witness cannot see it — leaves the counting witness PASS and turns both honesty
// witnesses RED. The guard therefore discriminates the exact abuse it exists to prevent, and the
// counting witness is measured to be insufficient alone rather than assumed to be. Measured cause
// of the two outside-index rows: v2.std.decl_index decl_facts skips test .dag files deliberately —
// gunbc.ci_layer_roots records that exclusion in the row explaining why a SECOND walk must not skip
// them — so a declaration authored in a witness module is absent from the index while its module is
// present in module_declaration_facts_live. The citation is true and unanswerable at once.

// The instance-gap carriers joined this lens's production population because their entire content
// is DeclarationRefs and nothing resolved any of them: rename a cited declaration and the row goes
// quietly false while every required check stays green
// (cited_symbol_instance_gap_carrier_widening_note, v2.lens.cited_symbol_resolution). These
// witnesses are that widening's evidence and they are a PAIR by DESIGN 4b(1). The greens measure
// the live carriers; the red plants the exact defect the widening exists to catch — a site whose
// caller names a declaration that does not exist — so a green cannot pass by measuring an empty
// population or a resolver that resolves everything. The red is CONSTRUCTED rather than drawn from
// either carrier, so it stays discriminating after every live row resolves, and it does not retire
// when production goes green (4b(4)). Both carriers are enrolled together deliberately: two
// carriers of one shape with only one enrolled is the same one-class-enforced-adjacent-class-exempt
// asymmetry that motivated the generated-document widening.

test fn instance_gap_carrier_declaration_refs_all_resolve() -> Bool {
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: concat(lambda_typing_gate_declaration_refs(), list_membership_gap_declaration_refs()),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  ) == 0
}

test fn instance_gap_carrier_ref_population_is_not_empty() -> Bool {
  length(xs: lambda_typing_gate_declaration_refs()) == length(xs: lambda_typing_gate_citable_sites())
    && length(xs: list_membership_gap_declaration_refs()) == length(xs: list_membership_gap_citable_sites())
    && length(xs: lambda_typing_gate_sites) >= 3
    && length(xs: list_membership_gap_sites) >= 4
    && length(xs: list_membership_gap_declaration_refs()) >= 3
}

test fn instance_gap_outside_index_population_is_counted() -> Bool {
  lambda_typing_gate_outside_index_count() == 0
    && list_membership_gap_outside_index_count() == 2
    && length(xs: list_membership_gap_citable_sites()) + list_membership_gap_outside_index_count()
         == length(xs: list_membership_gap_sites)
}

test fn instance_gap_outside_index_refs_really_do_refuse() -> Bool {
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: list_membership_gap_outside_index_refs(),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  ) == list_membership_gap_outside_index_count()
}

// THE PLANTED REDS ARE MARKED CitableThroughDeclIndex DELIBERATELY. Both name modules the index
// covers (v2.compiler.parse, gunbc.publication_policy) and a declaration that does not exist inside
// them, so they must refuse for the reason under test — the declaration is absent — and not because
// they sit outside the index. Marking a planted red outside-index would make it refuse for the
// wrong reason and the control would stop discriminating the thing it was planted for.
//
// THE CAUSE FIELDS ARE SiteCauseUnmeasured / NotYetProbed AND MUST STAY THAT WAY. This site is
// SYNTHETIC -- it names a declaration that does not exist, so no probe can ever have measured why it
// fails to type, and there is nothing for a receipt to point at. Copying a real site's cause here to
// make the literal look complete would put a measured attribution on a specimen no run produced,
// which is the fabricated-receipt failure the carrier's own receipt field exists to prevent. The
// fields were added when the carrier gained per-site causes and the census refused this literal;
// that refusal is the mechanism working.
test fn instance_gap_carrier_dangling_caller_red_control_refuses() -> Bool {
  let planted = [
    LambdaTypingGateSite {
      caller: decl_ref(
        module_path: "v2.compiler.parse",
        decl_name: "G1_planted_instance_gap_caller_control_RED"
      ),
      callee_spelled: "fold_list",
      miss: AbsentFromRoster,
      index_coverage: CitableThroughDeclIndex,
      cause: SiteCauseUnmeasured,
      cause_receipt: NotYetProbed,
    },
  ]
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: lambda_typing_gate_declaration_refs_from(sites: planted),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  ) == 1
}

test fn instance_gap_membership_dangling_producer_red_control_refuses() -> Bool {
  let planted = [
    ListMembershipGapSite {
      collection_producer: decl_ref(
        module_path: "gunbc.publication_policy",
        decl_name: "G1_planted_instance_gap_producer_control_RED"
      ),
      element_type: "String",
      occurrences: 1,
      argument_shape: PositionalPair,
      index_coverage: CitableThroughDeclIndex,
    },
  ]
  let pool = hand_authored_works_resolution_pool_roots()
  cited_declaration_ref_refusal_count(
    refs: list_membership_gap_declaration_refs_from(sites: planted),
    facts: decl_facts(pool_roots: pool),
    modules: module_declaration_facts_live(pool_roots: pool)
  ) == 1
}
