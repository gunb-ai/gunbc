module test.claim.long.fleet_converge_launch_scope_constructor_site_census

import v2.std.decl_index { DeclFact, decl_facts }
import v2.std.node { Atom, Edge, Named, Node, NodeFold, Positional, Symbol, TypeNode, fold_node }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

// THE PRODUCTION CONSTRUCTOR-SITE WALL FOR THE LAUNCH-ENVIRONMENT SCOPE.
//
// WHY THIS EXISTS. The current compiler admits ARBITRARY excess fields on a payload-carrying
// coproduct arm literal -- not just fields borrowed from a sibling arm, but any name at all, and
// the excess field's initializer is ANALYSED even though the field is dropped. Both facts are
// measured in test.claim.fleet_converge_launch_scope_constructor_compile_control, and the mechanism
// is owned by the compiler-floor lane (dashboard adhoc-0f99c6bc-193, session sharp-otter-269): a
// payload arm is not projected to its arm record, so the record-literal field roster is Absent and
// the unknown-field arm's Absent case is silence. So the type declaration is NOT the wall, and the
// executed non-interference evidence in
// test.claim.fleet_converge_launch_scope_non_interference proves only that the excess-field
// populations MEASURED THERE cannot influence the transaction. Neither closes the forward-looking
// hole: a future author could add an excess field carrying an operational expression to a
// production constructor, and nothing in this repository would say a word.
//
// WHAT THIS FILE CLOSES, AND WHAT IT HONESTLY DOES NOT. It closes the SITE population: every
// production record-literal construction of LaunchEnvironmentConverge in the whole corpus, at
// identity grain, against a declared roster. A new constructor anywhere -- including one carrying an
// excess field -- makes this red and names the declaration it appeared in. Editing one of the two
// rostered constructors to add an excess field does NOT make it red, because the field NAMES are
// not readable; see the missing-capability trigger below. The wall is therefore over WHERE launch
// requests are built, not over WHAT is put in them, and the pair (this census + the review of two
// named declarations) is what stands until the capability lands.
//
// THE MISSING CAPABILITY, NAMED RATHER THAN WORKED AROUND. An exact "the field-name set of this
// literal equals {host, observed_timers}" assertion is NOT AUTHORABLE in .dag today. The field
// names exist in the v1 AST -- make_field_init_node stamps them and declaration_field_names reads
// them -- but the reflection projection exposed to the substrate drops them: coproduct_reflection's
// marshal_generic pushes every field-init child on an UNLABELLED positional edge, and the only named
// edge a record literal ever mints is record_construction_spelling, which carries the CONSTRUCTOR
// spelling and nothing about fields. NEXT-RUNG TRIGGER, stated as the capability and not as an
// artifact: a substrate-readable per-field label on record-literal children -- a named edge minted
// per field-init in the host marshal, parallel to record_construction_spelling -- SUFFICIENT FOR a
// witness to assert the exact field-name SET of a named construction site. A spelling grep is not
// an acceptable substitute and none is offered here: a grep is a second naming scheme over what the
// containment tree already names, and it would read as coverage while establishing nothing.
//
// WHY THE SPELLING EDGE IS SOUND FOR THIS QUESTION EVEN THOUGH IT IS NOT AN IDENTITY. The edge
// carries the AUTHORED CONSTRUCTOR SPELLING, so it over-approximates: a same-spelled type in
// another module would also count. Over-approximation is the SAFE direction for a census whose
// verdict is "exactly these sites and no others" -- a foreign homonym makes this red, never green.
// It discriminates a construction from a match pattern (which marshals no construction spelling)
// and from a callee or string-literal atom (which ride positional edges), and it is suffix-aware so
// a qualified construction cannot hide. LaunchEnvironmentConverge carries fields, so it is NOT the
// invisible nullary case whose zero would be vacuous -- and the positive control below executes
// that rather than assuming it.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ONE PASS OVER THE CORPUS, COUNTING BOTH TARGETS. An earlier cut folded the corpus once per
// target, so the sentinel row below - which needs the launch count AND the FullHostConverge control
// - paid two full corpus folds where one suffices. Measured on the floor cost artifact of run
// 33459143928: that row cost 19342ms against 13532ms for the single-fold rows, so the second fold
// was ~5.8s of pure duplicate traversal. The pair is carried in the fold state instead.
type ConstructionCounts {
  launch: Int
  sentinel: Int
  self_is_launch: Bool
  self_is_sentinel: Bool
}

fn edge_is_construction(e: Edge) -> Bool {
  match e.label {
    Named { name: nm } => nm == ^record_construction_spelling
    Positional => false
  }
}

// THE DOTTED SUFFIXES ARE BUILT ONCE, NOT PER NODE. An earlier cut evaluated "." + (target as
// String) inside the fold's init arm, which runs for EVERY Atom node in the production corpus, so a
// two-token concatenation was allocated corpus-many times to compare against a constant. DESIGN 6
// bare-minimum-cost: the realized n here is the whole corpus, and hoisting is free.
data launch_bare: String = ^LaunchEnvironmentConverge as String
data launch_dotted: String = "." + launch_bare
data sentinel_bare: String = ^FullHostConverge as String
data sentinel_dotted: String = "." + sentinel_bare

fn spelling_names(spelling: String, bare: String, dotted: String) -> Bool {
  spelling == bare || ends_with(spelling, dotted)
}

fn construction_fold_pair(n: Node) -> ConstructionCounts {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        match n0.kind {
          TypeNode { connective: Atom { identity: s } } =>
            ConstructionCounts {
              launch: 0,
              sentinel: 0,
              self_is_launch: spelling_names(spelling: s as String, bare: launch_bare, dotted: launch_dotted),
              self_is_sentinel: spelling_names(spelling: s as String, bare: sentinel_bare, dotted: sentinel_dotted),
            }
          _ => ConstructionCounts { launch: 0, sentinel: 0, self_is_launch: false, self_is_sentinel: false }
        }
      },
      step: fn(acc, e, child) {
        ConstructionCounts {
          launch: acc.launch + child.launch
            + (if edge_is_construction(e: e) && child.self_is_launch { 1 } else { 0 }),
          sentinel: acc.sentinel + child.sentinel
            + (if edge_is_construction(e: e) && child.self_is_sentinel { 1 } else { 0 }),
          self_is_launch: acc.self_is_launch,
          self_is_sentinel: acc.self_is_sentinel,
        }
      }
    }
  )
}

// decl_facts SKIPS test .dag files, so this population IS the production corpus -- the filter is a
// property of the walk rather than a path convention this file re-implements.
data production_roots: List<String> = ["dag", "src/v1", "src/v2"]

// THE WALK AND THE FOLD ARE BOTH HOISTED, AND THE FOLD NOW RUNS ONCE. decl_facts over the production
// corpus and the skeleton fold of ~3000 modules are the two dominant terms of this module -- ~7.7s
// and ~5.8s respectively on the run-33459143928 cost artifact. Every row below reads this one
// derived population, so no row pays a traversal another row already paid.
// WHY THIS MODULE IS CADENCE-HOMED RATHER THAN PER-PR, with the measurement that decided it.
// This is the only whole-production-corpus decl_facts walk in dag/test/claim: every other decl_facts
// consumer outside test/claim/long walks a FIXTURE pool, record_construction_census_witness_test --
// itself a record-construction census -- among them. On the required floor run 33459143928 at head
// 1ac3485 the three rows below cost 13532ms, 14044ms and 19342ms, against 488ms for the next-worst
// row in the whole 3426-row population; they were the three most expensive witnesses in the run and
// exhausted the batch budget, interrupting eight cheap sibling rows that cost 6-10ms each. The cost
// is subject shape and not a defect: n IS the production corpus, and both terms -- the decl_facts
// walk and one linear fold_node pass per declaration -- scale with it.
// THE THREE CONSTANT-FACTOR DEFECTS THAT WERE REAL WERE FIXED FIRST, not priced in: the copied
// accumulator, the per-target double fold, and the per-node suffix concatenation, all described
// above. The double fold is the one with a visible receipt -- pre-fix the sentinel row cost 1.43x
// its siblings (19342ms vs 13532ms) because it folded the corpus twice; post-fix all three rows
// measure within 0.8% of each other (82823ms, 82163ms, 82128ms, each standalone in its own process
// on an arm64 session container, which is ~6x slower than the CI runner and is NOT a floor-comparable
// figure). Re-homing an unfixed cost shape would have priced the defect in instead of removing it.
// ENROLLMENT: the three check_fns ride surfaces: [FalsifierCadenceJob] in gunbc.commit_workflow
// commit_gate_roster, landed in the same change as the move here. That pairing is load-bearing, not
// bookkeeping -- test/claim/long is excluded from floor discovery at dir grain, and
// falsifier_cadence_surface_note records that of the 63 files under the two long/ dirs only 9 are
// enrolled while the rest are enrolled NOWHERE, so a move without the enrollment converts deferred
// into unscheduled. The eight compile-control rows stay per-PR as the cheap grain for this concern.
// WHERE THE REASON LIVES, AND WHY IT IS HERE: CommitCheckEnrollment carries entry, check_fns, kind,
// span and surfaces, and no per-row reason or measured-wall field. The typed carrier that does have
// those fields, gunbc.ci_layer_roots RehomedBinWetRow, is explicitly NOT this shape --
// falsifier_cadence_surface_note states it models the bin_witness_wet per-row budget overflow and
// not CommitWitnessClaim rows -- so borrowing it would be authority substitution. The rationale is
// therefore homed on the subject it describes. Minting a per-row justification field on the
// enrollment carrier is a real modeling question and is deliberately NOT decided here.
data production_facts: List<DeclFact> = decl_facts(pool_roots: production_roots)

type SiteCount {
  qualified_name: String
  launch: Int
  sentinel: Int
}

fn site_count_of(fact: DeclFact) -> SiteCount {
  let counts = construction_fold_pair(n: fact.node)
  SiteCount {
    qualified_name: fact.qualified_name,
    launch: counts.launch,
    sentinel: counts.sentinel,
  }
}

data corpus_site_counts: List<SiteCount> = map(production_facts, fact => site_count_of(fact: fact))

// A COPIED ACCUMULATOR IS NOT USED HERE, AND THAT IS DELIBERATE. An earlier cut grew this list with
// concat(acc, [name]) inside a fold, which copies the accumulator on every append. The realized
// result has two elements, so the realized cost was negligible -- and it is fixed anyway, because
// DESIGN 6's standing rule prices a proven cost-shape defect regardless of the realized n: "n is
// small here" is not a time-stable fact, since the roster this feeds is expected to grow.
data launch_constructor_sites: List<String> = map(filter(corpus_site_counts, s => s.launch > 0), s => s.qualified_name)

data launch_construction_total: Int = fold(corpus_site_counts, init: 0, f: (acc, s) => acc + s.launch)

data sentinel_construction_total: Int = fold(corpus_site_counts, init: 0, f: (acc, s) => acc + s.sentinel)

// THE DECLARED ROSTER. Two production constructors and no others: the scoped plan fold, and the wet
// observer branch that builds a request from a decoded scope wire. Both are reviewed in this PR and
// both supply exactly host and observed_timers.
data rostered_launch_constructor_sites: List<String> = [
  "gunbc.fleet_converge_plan.fleet_converge_launch_environment_plan_artifact",
  "gunbc.fleet_converge_plan_cli.observe_fleet_converge_request_wet",
]

fn roster_is_exactly(found: List<String>, declared: List<String>) -> Bool {
  list_length(items: found) == list_length(items: declared)
    && all(declared, d => any(found, f => f == d))
    && all(found, f => any(declared, d => d == f))
}

// THE POPULATION IS REAL. A census whose walk silently returned nothing would satisfy an
// "and no others" claim for free, so the corpus is proved nonempty and proved to CONTAIN
// constructions of this shape before any absence is asserted. FullHostConverge is the sibling arm
// with the largest production presence and is the sentinel: if the walk can see it, the walk works.
test fn the_production_corpus_walk_is_nonempty_and_sees_this_construction_shape() -> Bool {
  list_length(items: production_facts) > 0
    && sentinel_construction_total > 0
    && launch_construction_total > 0
}

// THE WALL. Every production construction site of the launch-environment arm, at identity grain
// against a declared roster -- not a count, because a count would be satisfied by one site moving
// and another appearing.
test fn every_production_launch_constructor_is_on_the_declared_roster() -> Bool {
  roster_is_exactly(
    found: launch_constructor_sites,
    declared: rostered_launch_constructor_sites,
  )
}

// AND EXACTLY ONE CONSTRUCTION IN EACH. The row above is an identity join over DECLARATIONS; a
// second literal added inside one of the two rostered functions would leave it green. This pins the
// occurrence count too, so the reviewed pair really is the whole population.
test fn the_two_rostered_declarations_carry_exactly_two_constructions_between_them() -> Bool {
  launch_construction_total == 2
}
