module test.claim.long.fx_probe

import std.markup { Element }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }
import gunbc.roadmap_page { issue_detail_page_launch }
import gunbc.roadmap_launch_admission { LaunchAdmitted, Operator }
import gunbc.roadmap_belt { ManualReady }
import test.claim.roadmap.roadmap_launch_admission_fixture { launch_fixture_identity }
import gunbc.roadmap.roadmap_event_log { NodeClaimed, EventPrincipalAuthenticated }
import gunbc.principal_projection { PrincipalRef }
import gunbc.auth.profile_projection { PrincipalProfile, ProfileSourceGoogleOidcLogin }
import extdeps.uri { Uri, Https }
import std.types { Email, NonEmptyStr }
import test.claim.long.roadmap_page_witness { fx_comment_stream_events, fx_handoff_events, issue_detail_fixture_panel }
import gunbc.roadmap_presentation

fn fx_ref() -> PrincipalRef {
  PrincipalRef { authority: "google-oidc" as NonEmptyStr, namespace: "accounts" as NonEmptyStr, subject: "sub-viewer" as NonEmptyStr }
}

fn fx_principal() -> gunbc.roadmap.roadmap_event_log.EventPrincipal {
  EventPrincipalAuthenticated { ref: fx_ref() }
}

fn fx_profile() -> PrincipalProfile {
  PrincipalProfile {
    principal: fx_ref(),
    name: Present { value: "Fixture Viewer" },
    email: Present { value: "viewer@gunb.ai" as Email },
    picture: Present { value: Uri { scheme: Https, locator: "lh3.googleusercontent.com/a/fixture-picture" as NonEmptyStr } },
    updated_at: "2026-09-28T00:00:00Z",
    source: ProfileSourceGoogleOidcLogin,
  }
}

fn fx_view() -> gunbc.roadmap_presentation.WorkRowView {
  gunbc.roadmap_presentation.WorkRowView {
    node_id: "issue-detail-specimen",
    headline: "Specimen issue",
    summary: none,
    lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
    scheduling: gunbc.roadmap_presentation.SchedulingReady,
    superseded_by: "",
    activity: gunbc.roadmap_presentation.NoActiveWork,
    action: gunbc.roadmap_presentation.action_view(
      lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
      admission: LaunchAdmitted { identity: launch_fixture_identity(node_id: "issue-detail-specimen", cause: Operator, mode: ManualReady) }),
    supporting_facts: [],
    disclosure: gunbc.roadmap_presentation.NoDisclosure,
    rounds: RoundsUnobserved { reason: "x" as NonEmptyStr },
    worker_alive: true,
    standing: Present { value: NodeClaimed { by: fx_principal(), since: "2026-09-23" } },
    attempt_stale: false,
    profiles: [fx_profile()],
  }
}

fn fx_panel() -> gunbc.roadmap_presentation.IssueLinkPanel {
  gunbc.roadmap_presentation.issue_link_panel(
    rn: gunbc.roadmap_authority.authored(identity: "rnfx_idspec", id: "issue-detail-specimen", done: false, content: "Specimen issue"),
    nodes: [],
    edges: [])
}

fn fx_events() -> List<gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope> {
  [
    gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
      id: "ho-1" as gunbc.roadmap.roadmap_event_log.RoadmapEventId,
      event: gunbc.roadmap.roadmap_event_log.RoadmapEvent {
        node: "issue-detail-specimen" as gunbc.roadmap_model.RoadmapNodeId,
        author: fx_principal(),
        parent: none,
        kind: gunbc.roadmap.roadmap_event_log.Claimed { assignee: gunbc.roadmap.roadmap_event_log.EventPrincipalAuthenticated { ref: gunbc.principal_projection.fabric_workflow_principal }, return_to: fx_principal() },
        recorded_at: "2026-09-25T10:00:00Z",
      },
    },
  ]
}


fn occurrence_count_local(s: String, pattern: String) -> Int {
  count(split(s: s, delimiter: pattern)) - 1
}

fn probe() -> String {
  match try_serialize_html_source(node: issue_detail_page_launch(
    view: fx_view(),
    panel: issue_detail_fixture_panel(),
    observation: gunbc.roadmap_presentation.ObservationsNominal,
    attempts: [],
    events: concat(fx_comment_stream_events(), fx_handoff_events()),
    viewer: "principal:google-oidc/accounts/sub-viewer",
    recents: [],
    expected_revision: "",
    csrf: "")) {
    EmitRejected { reason } => join(["REJECTED: ", reason], "")
    EmitOk { html: h } =>
      let rail_region = string_at_local(parts: split(s: h, delimiter: "<aside class=\"issue-rail\">"), index: 1)
      let after_author = string_at_local(parts: split(s: h, delimiter: "issue-comment-author\">"), index: 1)
      join([
        "rail_full=", to_string(occurrence_count_local(s: rail_region, pattern: "class=\"issue-avatar\" data-avatar=\"resolved\" title=\"Fixture Viewer — viewer@gunb.ai\">FV</span><span class=\"issue-assignee-text\">viewer@gunb.ai</span>")),
        " author_window=", substring(s: after_author, start: 0, end: 120),
        " merge_window=", string_at_local(parts: split(s: h, delimiter: "reassigned for merge to "), index: 1) |> substring(s: _, start: 0, end: 60),
        " rail_text=", to_string(occurrence_count_local(s: rail_region, pattern: "issue-assignee-text")),
      ], "")
  }
}

fn string_at_local(parts: List<String>, index: Int) -> String {
  match parts.skip(n: index).first() {
    Present { value: s } => s
    Absent => ""
  }
}
