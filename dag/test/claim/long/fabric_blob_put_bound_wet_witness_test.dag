module test.claim.long.fabric_blob_put_bound_wet_witness

import std.types { String, NonEmptyStr, Bool }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.measure { byte_size, measure_count }
import std.content_hash { sha256_hex_digest }
import std.fabric_blob {
  FabricBlobAddress, FabricBlobRead, FabricBlobReadRefused, read_staged_fabric_blob, fabric_blob_reading_size,
  FabricBlobPutAdmitted, FabricBlobPutTooLarge, fabric_blob_put_plan,
}

// WET: the hermetic mocks describe the empty file, so they cannot construct an over-bound sealed
// reading. Run with claim_batch --wet: sha256sum and stat read a real 28-byte fixture, and the put plan
// is reached with a reading whose size exceeds the bound. This is the executing
// control for FabricBlobPutTooLarge that review of gunbc#13082 asked the first consumer to carry.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data fixture_path: NonEmptyStr = "dag/test/fixture/fabric_blob/nonempty.bin"
data key_hex: String = "89427e487454c1b5b3cafc50013e056c2d496587b9922f4e8600a3b3c7e3be4f"

fn address() -> FabricBlobAddress? {
  match sha256_hex_digest(hex: key_hex) {
    Present { value: d } => Present { value: FabricBlobAddress { key: d } }
    Absent => none
  }
}

test fn a_real_reading_over_its_bound_refuses_before_upload() -> Bool {
  match address() {
    Absent => false
    Present { value: a } =>
      match read_staged_fabric_blob(path: fixture_path) {
        FabricBlobReadRefused { fault: _ } => false
        FabricBlobRead { reading: r } =>
          measure_count(m: fabric_blob_reading_size(reading: r)) == 28
            && match fabric_blob_put_plan(address: a, reading: r, bound: byte_size(count: 1)) {
                 FabricBlobPutTooLarge { address: _, size: s, bound: _ } => measure_count(m: s) == 28
                 FabricBlobPutAdmitted { address: _, reading: _ } => false
               }
            && match fabric_blob_put_plan(address: a, reading: r, bound: byte_size(count: 64)) {
                 FabricBlobPutAdmitted { address: _, reading: _ } => true
                 FabricBlobPutTooLarge { address: _, size: _, bound: _ } => false
               }
      }
  }
}
