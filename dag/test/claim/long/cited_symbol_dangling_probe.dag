module test.claim.long.cited_symbol_dangling_probe

import gunbc.doc_graph_roots {
  hand_authored_production_doc_declaration_refs,
  hand_authored_works_resolution_pool_roots,
}
import gunbc.documentary_refs { generated_document_declaration_refs }
import std.decl_ref { DeclarationRef }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }
import v2.lens.roster_registry { roster_registry_declaration_refs }
import v2.std.decl_index { DeclFact, decl_facts }
import v2.std.decl_ref_resolution {
  declaration_ref_resolves,
  resolve_declaration_ref,
  DeclarationRefAmbiguous,
  DeclarationRefResolved,
  DeclarationRefModuleAbsent,
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
}

fn cited_symbol_dangling_probe_report() -> String {
  let pool = hand_authored_works_resolution_pool_roots()
  let facts = decl_facts(pool_roots: pool)
  let modules = module_declaration_facts_live(pool_roots: pool)
  let refs = concat(
    concat(hand_authored_production_doc_declaration_refs(), generated_document_declaration_refs()),
    roster_registry_declaration_refs()
  )
  let bad = filter(refs, r => !declaration_ref_resolves(ref: r, facts: facts, modules: modules))
  join(map(bad, r => concat(probe_arm(ref: r, facts: facts, modules: modules), concat(" ", concat(r.module_path, concat(" :: ", r.decl_name))))), "\n")
}

fn probe_arm(
  ref: DeclarationRef,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>
) -> String {
  match resolve_declaration_ref(ref: ref, facts: facts, modules: modules) {
    DeclarationRefResolved { declaration_identity: _ } => "RESOLVED"
    DeclarationRefModuleAbsent { reference: _ } => "MODULE_ABSENT"
    DeclarationRefDeclarationAbsent { reference: _ } => "DECL_ABSENT"
    DeclarationRefFieldAbsent { reference: _ } => "FIELD_ABSENT"
    DeclarationRefAmbiguous { reference: _, candidates: _ } => "AMBIGUOUS"
  }
}

fn probe_index_coverage_report() -> String {
  let pool = hand_authored_works_resolution_pool_roots()
  let facts = decl_facts(pool_roots: pool)
  let modules = module_declaration_facts_live(pool_roots: pool)
  join(
    map(
      [
        "dag/test/claim/floor_materialization_witness_test.dag",
        "dag/test/claim/claude_sdk_parser_drop_witness_test.dag",
        "dag/test/claim/claude_sdk_parser_drop_live_witness_test.dag",
        "src/v2/test/claim/round_trip/dag_comment_wall_test.dag",
        "src/v2/lens/cited_symbol_resolution.dag",
        "dag/gunbc/doc_graph_roots.dag",
      ],
      p => concat(
        p,
        concat(
          " indexed_in_decl_facts=",
          concat(
            (any(facts, d => d.rel_path == p) as String),
            concat(
              " module_declared=",
              (any(modules, m => m.path == p) as String)
            )
          )
        )
      )
    ),
    "\n"
  )
}
