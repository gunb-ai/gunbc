module test.claim.long.allocation_page_witness

import std.types { String, Bool }
import gunbc.roadmap_allocation_page { allocation_page_with_stylesheet }
import gunbc.roadmap_allocation_style { allocation_css }
import gunbc.roadmap_allocation_client { allocation_draft_source }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }

// The roadmap stylesheet is supplied: no claim below reads it, and rendering the real one is the
// whole cost of the page. The route that supplies roadmap_css() is gunbc.roadmap_serve
// allocation_page_response.
data fx_roadmap_stylesheet: String = ".fx-roadmap-sheet{}"

fn allocation_preview_signed_in() -> String {
  match try_serialize_html_source(node: allocation_page_with_stylesheet(signed_in: true, roadmap_stylesheet: fx_roadmap_stylesheet)) {
    EmitOk { html } => html
    EmitRejected { reason } => reason
  }
}

fn allocation_preview_signed_out() -> String {
  match try_serialize_html_source(node: allocation_page_with_stylesheet(signed_in: false, roadmap_stylesheet: fx_roadmap_stylesheet)) {
    EmitOk { html } => html
    EmitRejected { reason } => reason
  }
}

test fn allocation_signed_out_cannot_edit_draft() -> Bool {
  let html = allocation_preview_signed_out()
  string_contains(s: html, pattern: "<fieldset disabled")
    && string_contains(s: html, pattern: "Sign in to prepare an allocation.")
    && string_contains(s: html, pattern: "/auth/login")
}

test fn allocation_signed_in_can_prepare_but_cannot_submit() -> Bool {
  let html = allocation_preview_signed_in()
  !string_contains(s: html, pattern: "<fieldset disabled")
    && string_contains(s: html, pattern: "Request allocation")
    && string_contains(s: html, pattern: "aria-describedby=\"allocation-submit-reason\"")
    && string_contains(s: html, pattern: "Allocation requests are not available yet.")
}

test fn allocation_client_has_no_request_effect() -> Bool {
  let js = allocation_draft_source()
  !string_contains(s: js, pattern: "fetch(")
    && !string_contains(s: js, pattern: "localStorage")
    && string_contains(s: js, pattern: "preventDefault")
    && string_contains(s: js, pattern: "reportValidity")
}

// The supplied stylesheet reaches the page head, ahead of the allocation rules, in one style element.
test fn allocation_head_carries_the_supplied_stylesheet_then_the_allocation_rules() -> Bool {
  string_contains(s: allocation_preview_signed_in(), pattern: concat("<style>", concat(fx_roadmap_stylesheet, allocation_css())))
}
