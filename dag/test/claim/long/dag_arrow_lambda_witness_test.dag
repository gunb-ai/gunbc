module test.claim.long.dag_arrow_lambda_witness_test

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { fold_list, for_all }
import v2.std.grammar { GrammarRoot, GrammarProduction, GrammarExpr, ParseGrammar, ModeledGrammar, VoidGrammar }
import v2.std.compilers.lexing { LexRuleSet, lex_artifact_semantic_tokens }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.compiler.parse { parse_module }
import v2.extdeps.languages.dag {
  dag_lex_rules,
  dag_grammar,
  dag_grammar_choice,
  dag_grammar_nonterminal
}

data arrow_lambda_witness_note: String = "CI2-0 grammar-extension proof obligation (operator repair sequencing msg_7152180b item a; premise corrected by direct probe 2026-08-10): the v2 grammar already admits |> — the measured corpus-wide parse wall in dag/std/algebra.dag, a dependency the v2 compiler itself imports, is the ARROW LAMBDA, v1-only surface syntax. This witness admits it parse-only, mirroring the v1 frontend's exact admission (single bare ident, or parenthesized >=2 idents; () and (x) are NOT lambdas in v1 and stay refused). The rule-removed RED rebuilds the grammar with the EXPR production's expression swapped back to the pre-repair shape, selected by DECLARED production identity with the replacement count asserted, so the discrimination is single-variable at the production grain. Non-interference rows pin the neighbors that share tokens with the new arm: match-arm fat arrows, named args, parenthesized arithmetic, and the recently-landed leading-pipe sum admission. TWO CLAIMS, NOT FOURTEEN (witness-cost consolidation, 2026-08-19): every source here probes ONE mechanism -- whether a given grammar admits a given surface shape -- and the cost of a row is not the parse, which is over three lines of source, but the frontend construction ahead of it: dag_lex_rules() and a 6,230-line dag_grammar() were rebuilt once per claim because each claim evaluates in a fresh frame, and the pre-repair claim rebuilt the grammar five more times because pre_repair_grammar() and its swap check each called dag_grammar() again. Nineteen builds served thirteen three-line sources. The rows are now folded through ONE constructed frontend per grammar under test: the live grammar builds once and every admitted, non-interference and refused-shape source is asserted against it, and the pre-repair grammar is derived from that same base value and asserted against the discriminating subset. The fixture population, the sources, and every assertion are UNCHANGED -- what is removed is the repeated construction, not a claim. WHAT THIS COSTS, stated rather than left to be discovered: a failure now names a claim rather than a source, so the failing fixture is read from the fold rather than from the row name. That is the price of the consolidation and it is why the three source lists are named by what they assert."

fn parse_accepts_with(source: String, rules: LexRuleSet, grammar: ParseGrammar) -> Bool {
  match lex_walk_artifact(source: source, file: ^lambda_probe, rules: rules) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } =>
      match parse_module(tokens: lex_artifact_semantic_tokens(artifact: a), grammar: grammar) {
        v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => true
        v2.std.diagnostic.Rejected { diagnostics: _ } => false
      }
  }
}

fn accepts_all(rules: LexRuleSet, grammar: ParseGrammar, sources: List<String>) -> Bool {
  for_all(xs: sources, predicate: fn(src) {
    parse_accepts_with(source: src, rules: rules, grammar: grammar)
  })
}

fn refuses_all(rules: LexRuleSet, grammar: ParseGrammar, sources: List<String>) -> Bool {
  for_all(xs: sources, predicate: fn(src) {
    parse_accepts_with(source: src, rules: rules, grammar: grammar) == false
  })
}

fn admitted_lambda_sources() -> List<String> {
  [
    single_param_lambda_source,
    multi_param_lambda_source,
    lambda_in_pipeline_source,
    authored_algebra_shape_source,
    lambda_block_body_source
  ]
}

fn non_interference_sources() -> List<String> {
  [
    match_arm_unchanged_source,
    named_arg_unchanged_source,
    paren_arithmetic_unchanged_source,
    sum_decl_unchanged_source
  ]
}

fn refused_shape_sources() -> List<String> {
  [
    missing_body_source,
    missing_param_source,
    single_paren_param_source,
    zero_param_source
  ]
}

data single_param_lambda_source: String = "module zz_lambda_probe\n\nfn f(xs: List<Int>) -> Bool {\n  any(xs, p => p == 1)\n}\n"

data multi_param_lambda_source: String = "module zz_lambda_probe\n\nfn f() -> Int {\n  combine((a, b) => a + b)\n}\n"

data lambda_in_pipeline_source: String = "module zz_lambda_probe\n\nfn f(xs: List<Int>) -> Bool {\n  xs |> any(p => p == 1)\n}\n"

data authored_algebra_shape_source: String = "module zz_lambda_probe\n\nfn algebra_method_template_name(name: String) -> Bool {\n  all_algebra_profiles()\n    |> any(profile => algebra_templates_for_profile(profile: profile) |> any(t => t.name == name))\n}\n"

data lambda_block_body_source: String = "module zz_lambda_probe\n\nfn f(xs: List<Int>) -> Bool {\n  any(xs, p => {\n    let q = p == 1\n    q\n  })\n}\n"

data match_arm_unchanged_source: String = "module zz_lambda_probe\n\nfn f(x: Bool) -> Int {\n  match x {\n    true => 1,\n    false => 2\n  }\n}\n"

data named_arg_unchanged_source: String = "module zz_lambda_probe\n\nfn f(x: Int) -> Int {\n  g(v: x)\n}\n"

data paren_arithmetic_unchanged_source: String = "module zz_lambda_probe\n\nfn f(x: Int) -> Int {\n  (x + 1) * 2\n}\n"

data sum_decl_unchanged_source: String = "module zz_lambda_probe\n\ntype AlgX = AlphaX | BetaX\n"

data missing_body_source: String = "module zz_lambda_probe\n\nfn f() -> Int {\n  g(p => )\n}\n"

data missing_param_source: String = "module zz_lambda_probe\n\nfn f() -> Int {\n  g(=> x)\n}\n"

data single_paren_param_source: String = "module zz_lambda_probe\n\nfn f() -> Int {\n  g((p) => p)\n}\n"

data zero_param_source: String = "module zz_lambda_probe\n\nfn f() -> Int {\n  g(() => 1)\n}\n"

fn pre_repair_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_match_expr),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_if_expr),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_loop_expr),
        right: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: ^dag_production_fn_literal),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: ^dag_production_block_expr),
            right: dag_grammar_nonterminal(production: ^dag_production_binary_expr)
          )
        )
      )
    )
  )
}

fn no_productions() -> List<GrammarProduction> {
  []
}

fn swap_expr_production(productions: List<GrammarProduction>) -> List<GrammarProduction> {
  fold_list(xs: productions, empty: no_productions(), cons: fn(acc, prod) {
    match prod.name == ^dag_production_expr {
      true => concat(acc, [GrammarProduction {
        name: prod.name,
        expression: pre_repair_expr_expr(),
        emitted: prod.emitted
      }])
      false => concat(acc, [prod])
    }
  })
}

fn swapped_count(productions: List<GrammarProduction>) -> Int {
  fold_list(xs: productions, empty: 0, cons: fn(acc, prod) {
    match prod.name == ^dag_production_expr {
      true => acc + 1
      false => acc
    }
  })
}

fn pre_repair_grammar_from(base: ParseGrammar) -> ParseGrammar {
  match base {
    ModeledGrammar { root: r } =>
      ModeledGrammar {
        root: GrammarRoot {
          start: r.start,
          productions: swap_expr_production(productions: r.productions),
          sync_tokens: r.sync_tokens
        }
      }
    VoidGrammar => VoidGrammar
  }
}

fn pre_repair_swap_targeted_exactly_one(base: ParseGrammar) -> Bool {
  match base {
    ModeledGrammar { root: r } => swapped_count(productions: r.productions) == 1
    VoidGrammar => false
  }
}

test fn witness_dag_grammar_arrow_lambda_admission_holds() -> Bool {
  let rules = dag_lex_rules()
  let g = dag_grammar()
  accepts_all(rules: rules, grammar: g, sources: admitted_lambda_sources())
    && accepts_all(rules: rules, grammar: g, sources: non_interference_sources())
    && refuses_all(rules: rules, grammar: g, sources: refused_shape_sources())
}

test fn witness_pre_repair_grammar_restores_the_RED() -> Bool {
  let rules = dag_lex_rules()
  let g = dag_grammar()
  let pre = pre_repair_grammar_from(base: g)
  pre_repair_swap_targeted_exactly_one(base: g)
    && refuses_all(rules: rules, grammar: pre, sources: [single_param_lambda_source, authored_algebra_shape_source])
    && accepts_all(rules: rules, grammar: pre, sources: non_interference_sources())
}
