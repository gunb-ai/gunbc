// THE WITHIN-SECOND CONTROL (F4): seventeen eligible main-ref entries; the OLDEST two share a
// second -- id 2 at 12:00:00.900Z and id 1 at 12:00:00.100Z -- and the listing presents the
// pair newest-first (id 2 before id 1). Dropping the fraction ties them and jq's stable sort
// would keep the input order, naming id 2 (the newer) for deletion. The full key
// [epoch, numeric fraction, id] must name id 1. Pre-F4 this prints due=2 and deletes id 2.
fn retention_tie_entry_text(id: Int) -> String {
  let frac = if int_eq(id, 1) { "100" } else { "900" }
  join([
    "{\"id\": ", int_to_decimal_string(id),
    ", \"key\": \"release-bins-t", int_to_decimal_string(id),
    "\", \"ref\": \"refs/heads/main\", \"created_at\": \"2025-12-31T23:59:59.", frac, "Z\"}",
  ], "")
}

fn retention_tie_page_body() -> String {
  join(["{\"total_count\": 17, \"actions_caches\": ["], "")
    + join(map(retention_int_range(17, 3), i => retention_family_entry_text(i: i)), ", ")
    + ", "
    + retention_tie_entry_text(id: 2)
    + ", "
    + retention_tie_entry_text(id: 1)
    + "]}"
}

data retention_tie_body: String = retention_tie_page_body()
data script_retention_within_second_tie: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: retention_tie_body)))

test fn release_bins_retention_orders_within_a_second_by_fraction() -> Bool {
  let r = run_script(script: script_retention_within_second_tie)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: deleting=1 keep=16")
    && string_contains(s: r.stdout, pattern: "release-bins retention: due=1")
    && !string_contains(s: r.stdout, pattern: "release-bins retention: due=1 ")
    && !string_contains(s: r.stdout, pattern: "due=2")
    && !string_contains(s: r.stdout, pattern: "due=10")
    && !string_contains(s: r.stdout, pattern: "due=11")
    && !string_contains(s: r.stdout, pattern: "due=12")
    && !string_contains(s: r.stdout, pattern: "due=13")
    && !string_contains(s: r.stdout, pattern: "due=14")
    && !string_contains(s: r.stdout, pattern: "due=15")
    && !string_contains(s: r.stdout, pattern: "due=16")
    && !string_contains(s: r.stdout, pattern: "due=17")
    && !string_contains(s: r.stdout, pattern: "plan-failed")
}

fn retention_family_entry_text(i: Int) -> String {
  join([
    "{\"id\": ", int_to_decimal_string(i),
    ", \"key\": \"release-bins-r", int_to_decimal_string(i),
    "\", \"ref\": \"refs/heads/main\", \"created_at\": \"2026-", int_to_decimal_string(int_add(retention_div28(i), 1)), "-", int_to_decimal_string(int_add(int_sub(i, int_mul(retention_div28(i), 28)), 1)), "T00:00:00Z\"}",
  ], "")
}

fn retention_page_body(start: Int, end: Int, total: Int) -> String {
  join(["{\"total_count\": ", int_to_decimal_string(total), ", \"actions_caches\": ["], "")
    + join(map(retention_int_range(start, end), i => retention_family_entry_text(i)), ", ")
    + "]}"
}

fn fake_curl_static(body: String) -> Outcome<String> {
  e(statements: fake_tool(
    name: "curl",
    lines: [
      "o=0",
      "for a in \"$\"@\"; do if [ \"$\"o\" = 1 ]; then printf %s \"" + body + "\" > \"$\"a\"; o=0; fi; if [ \"$\"a\" = -o ]; then o=1; fi; done",
      "exit 0",
    ]
  ))
}

// One fake curl for the whole paged listing: it serves page 2 and page 3 by
// their &page= parameter and page 1 (any other URL) as the base body. A DELETE
// carries no -o, so it writes nothing and succeeds -- the deletion itself is
// asserted through the typed lines, not through fake state.
fn fake_curl_pages(body1: String, body2: String, body3: String) -> Outcome<String> {
  e(statements: fake_tool(
    name: "curl",
    lines: [
      "o=0",
      "u=\"\"",
      "for a in \"$\"@\"; do case \"$\"a\" in -o) o=1;; *) if [ \"$\"o\" = 1 ]; then o=\"$\"a\"; fi;; esac; case \"$\"a\" in http*) u=\"$\"a\";; esac; done",
      "case \"$\"u\" in *page=2*) printf %s \"" + body2 + "\" > \"$\"o\";; *page=3*) printf %s \"" + body3 + "\" > \"$\"o\";; *) printf %s \"" + body1 + "\" > \"$\"o\";; esac",
      "exit 0",
    ]
  ))
}

// A family of exactly 250 entries (ids 1..250, created_at increasing with the
// id), listed created_at-descending: page 1 = ids 151..250, page 2 = 51..150,
// page 3 = the 50-entry remainder. Every page is exactly as full as its own
// total_count demands (the page admission refuses a short page).
data retention_pages_body1: String = retention_page_body(start: 151, end: 250, total: 250)
data retention_pages_body2: String = retention_page_body(start: 51, end: 150, total: 250)
data retention_pages_body3: String = retention_page_body(start: 1, end: 50, total: 250)
data retention_over_bound_body: String = retention_page_body(start: 3000, end: 3099, total: 501)
data retention_at_cap_family_body: String = retention_page_body(start: 7000, end: 7015, total: 16)

// Past the bound: the typed over-cap line, no plan, no deletions, and NOT the
// misleading no-answer line (the answer was seen; the guardian chose to stop).
data script_retention_over_bound: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    retention_answer_part(body: retention_over_bound_body),
    fake_curl_static(body: retention_over_bound_body),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_over_bound_types_total_and_deletes_nothing() -> Bool {
  let r = run_script(script: script_retention_over_bound)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: over-cap total=501")
    && !string_contains(s: r.stdout, pattern: "deleting=")
    && !string_contains(s: r.stdout, pattern: "due=")
    && !string_contains(s: r.stdout, pattern: "no-answer")
    && !string_contains(s: r.stdout, pattern: "plan-failed")
}

// The paged delete over a real 250-entry family: the union plan sorts all 250
// by created_at once and keeps the 16 newest (ids 235..250); due is exactly
// ids 1..234 -- 250 - 16 = 234 of them, counted from the emitted due= line and
// the deleting= line agreeing. Pre-pagination this claim's ancestor could not
// exist: the answer refused admission at 250 total.
data script_retention_paged_delete: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    retention_answer_part(body: retention_pages_body1),
    fake_curl_pages(body1: retention_pages_body1, body2: retention_pages_body2, body3: retention_pages_body3),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_paged_delete_reaches_past_one_page() -> Bool {
  let r = run_script(script: script_retention_paged_delete)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: deleting=16 keep=16")
    && string_contains(s: r.stdout, pattern: "due=1 ")
    && string_contains(s: r.stdout, pattern: " 234")
    && !string_contains(s: r.stdout, pattern: " 235")
    && !string_contains(s: r.stdout, pattern: "page-failed")
}

// THE CENSUS REFUSAL (review 96120; gunbc.design_argument::fail_closed). The one number that
// bounds what retention deletes must never be fabricated: the former sentinel (Err => 1000000)
// turned a zero-divisor census into a giant keep and the chore then reported nothing-due as if it
// had worked. These two inputs discriminate: the real census MUST admit, and a broken one MUST
// refuse loudly. Red either way: if someone restores a fabricated default, the broken-census test
// goes red; if the gate wrongly refuses, the admit test goes red.
// REVIEW 96127 F1, EXECUTED: the keep window must be computed over the CONSUMABLE population
// only. 50 entries: 30 refs/heads/main (2026 dates) and 20 refs/pull/4321/head that are the
// NEWEST (2027 dates). The consumer ref's window keeps main's 16 newest: due = 30-16 = 14,
// deleting=14. A window computed over the whole union would keep the 16 newest -- all PR-ref,
// consumable by nobody -- and declare 34 due, of which all 30 main entries are candidates:
// the cap turns that into deleting=16. 14 vs 16: the wrong grouping cannot print 14.
fn retention_prref_entry_text(i: Int) -> String {
  join([
    "{\"id\": ", int_to_decimal_string(i),
    ", \"key\": \"release-bins-p", int_to_decimal_string(i),
    "\", \"ref\": \"refs/pull/4321/head\", \"created_at\": \"2027-", int_to_decimal_string(int_add(retention_div28(int_sub(i, 90000)), 1)), "-", int_to_decimal_string(int_add(int_sub(int_sub(i, 90000), int_mul(retention_div28(int_sub(i, 90000)), 28)), 1)), "T00:00:00Z\"}",
  ], "")
}

fn retention_prref_page_body2(start: Int, end: Int, main_start: Int, main_end: Int, total: Int) -> String {
  join(["{\"total_count\": ", int_to_decimal_string(total), ", \"actions_caches\": ["], "")
    + join(map(retention_int_range(start, end), i => retention_prref_entry_text(i: i)), ", ")
    + ", "
    + join(map(retention_int_range(main_start, main_end), i => retention_family_entry_text(i: i)), ", ")
    + "]}"
}

data retention_prref_body1: String = retention_prref_page_body2(start: 90001, end: 90020, main_start: 1, main_end: 30, total: 50)
data retention_prref_body2: String = retention_prref_body1
data retention_prref_body3: String = retention_prref_body1

data script_retention_prref: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    retention_answer_part(body: retention_prref_body1),
    fake_curl_pages(body1: retention_prref_body1, body2: retention_prref_body2, body3: retention_prref_body3),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_window_spares_pr_ref_entries() -> Bool {
  let r = run_script(script: script_retention_prref)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: deleting=14 keep=16")
    && !string_contains(s: r.stdout, pattern: "deleting=16 ")
    && !string_contains(s: r.stdout, pattern: "deleting=30")
    && !string_contains(s: r.stdout, pattern: "page-failed")
}

test fn release_bins_retention_census_admits_the_computed_keep() -> Bool {
  match fleet_converge_release_bins_retention_census_refusal() {
    Absent => true
    Present { value: _ } => false
  }
}

test fn release_bins_retention_census_refuses_a_broken_census() -> Bool {
  match release_bins_retention_census_refusal_of(result: Err { value: "test census: ceiling division by a zero divisor" }) {
    Present { value: r } => string_contains(s: r, pattern: "REFUSED") && string_contains(s: r, pattern: "zero divisor")
    Absent => false
  }
}

test fn release_bins_retention_census_refuses_a_zero_keep() -> Bool {
  match release_bins_retention_census_refusal_of(result: Ok { value: 0 }) {
    Present { value: r } => string_contains(s: r, pattern: "REFUSED") && string_contains(s: r, pattern: "keep 0")
    Absent => false
  }
}

// A required page failing, whole step (F4d, review 96005): page 2 never
// arrives, so the plan must NOT run on a partial listing, nothing may be
// deleted, and the single refusal line 'pages-incomplete' must be typed.
fn fake_curl_pages_fail_page2(body1: String, body3: String) -> Outcome<String> {
  e(statements: fake_tool(
    name: "curl",
    lines: [
      "o=0",
      "u=\"\"",
      "for a in \"$\"@\"; do case \"$\"a\" in -o) o=1;; *) if [ \"$\"o\" = 1 ]; then o=\"$\"a\"; fi;; esac; case \"$\"a\" in http*) u=\"$\"a\";; esac; done",
      "case \"$\"u\" in *page=2*) exit 22;; *page=3*) printf %s \"" + body3 + "\" > \"$\"o\";; *) printf %s \"" + body1 + "\" > \"$\"o\";; esac",
      "exit 0",
    ]
  ))
}

data script_retention_page2_fail: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    retention_answer_part(body: retention_pages_body1),
    fake_curl_pages_fail_page2(body1: retention_pages_body1, body3: retention_pages_body3),
    e(statements: release_bins_retention_statements()),
  ]
)

// THE DUPLICATE-ID REPRODUCTION (side chat, #16596 review 2): three pages all
// declaring total 250, with id 250 REPEATED across pages 1 and 2 and the
// per-page counts exactly as full as 250 demands, so every page-admission
// check passes. A repeated id implies something else was SKIPPED: the listing
// is incomplete, the typed lines are duplicate-ids and pages-incomplete, and
// nothing is deleted -- not even the 233 ids a naive keep-16 over the raw
// union would name.
fn fake_curl_pages_dup(body1: String, body2: String, body3: String) -> Outcome<String> {
  e(statements: fake_tool(
    name: "curl",
    lines: [
      "o=0",
      "u=\"\"",
      "for a in \"$\"@\"; do case \"$\"a\" in -o) o=1;; *) if [ \"$\"o\" = 1 ]; then o=\"$\"a\"; fi;; esac; case \"$\"a\" in http*) u=\"$\"a\";; esac; done",
      "case \"$\"u\" in *page=2*) printf %s \"" + body2 + "\" > \"$\"o\";; *page=3*) printf %s \"" + body3 + "\" > \"$\"o\";; *) printf %s \"" + body1 + "\" > \"$\"o\";; esac",
      "exit 0",
    ]
  ))
}

fn retention_dup_page_body(items: String) -> String {
  "{\"total_count\": 250, \"actions_caches\": [" + items + "]}"
}

data retention_dup_body1: String = retention_dup_page_body(items: join(map(retention_int_range(151, 250), i => retention_family_entry_text(i)), ", "))
data retention_dup_body2: String = retention_dup_page_body(items: retention_family_entry_text(i: 250) + ", " + join(map(retention_int_range(52, 150), i => retention_family_entry_text(i)), ", "))
data retention_dup_body3: String = retention_dup_page_body(items: join(map(retention_int_range(2, 51), i => retention_family_entry_text(i)), ", "))

data script_retention_dup_ids: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    retention_answer_part(body: retention_dup_body1),
    fake_curl_pages_dup(body1: retention_dup_body1, body2: retention_dup_body2, body3: retention_dup_body3),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_duplicate_ids_refuse_all_deletions() -> Bool {
  let r = run_script(script: script_retention_dup_ids)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: duplicate-ids")
    && string_contains(s: r.stdout, pattern: "release-bins retention: pages-incomplete")
    && !string_contains(s: r.stdout, pattern: "deleting=")
    && !string_contains(s: r.stdout, pattern: "done")
}

// THE ATTEMPT-ISOLATION MATRIX CASE (side chat, #16596 review 2): scratch left
// by an earlier attempt (ids, dedup, pages-incomplete flag) must not drive a
// later invocation whose own GET fails: the answer, the plan and the
// deletions all come from THIS invocation or not at all.
data script_retention_attempt_isolation: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    e(statements: concat(
      [bash_build_with_redir_to_file(inner: cmdl(ls: ["seq", "1", "40"]), path: rooted(file: release_bins_retention_ids_basename))],
      [bash_build_with_redir_to_file(inner: cmdl(ls: ["printf", "%s", "{\"total_count\": 250, \"actions_caches\": []}"]), path: rooted(file: release_bins_retention_union_basename))],
      [cmdl(ls: ["touch", rooted(file: release_bins_retention_incomplete_basename)])],
      [bash_build_with_redir_to_file(inner: cmdl(ls: ["printf", "%s", retention_pages_body1]), path: fx(t: release_bins_retention_answer_file()))],
    )),
    fake_curl_pages_fail_page2(body1: retention_pages_body1, body3: retention_pages_body3),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_stale_scratch_cannot_delete_on_failed_get() -> Bool {
  let r = run_script(script: script_retention_attempt_isolation)
  r.ran
    && r.success
    && !string_contains(s: r.stdout, pattern: "deleting=")
    && !string_contains(s: r.stdout, pattern: "done")
}

test fn release_bins_retention_page2_failure_refuses_to_delete() -> Bool {
  let r = run_script(script: script_retention_page2_fail)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: page-failed=2")
    && string_contains(s: r.stdout, pattern: "release-bins retention: pages-incomplete")
    && !string_contains(s: r.stdout, pattern: "deleting=")
    && !string_contains(s: r.stdout, pattern: "plan-failed")
}

// THE FIVE WHOLE-STEP PATHS (manager, msg_495d8e8e): every claim below runs
// release_bins_outcome_with_retention_statements -- the emitted step, outcome
// and chore together -- against the fixture store and a fake curl.

fn full_step_parts(prepare: List<Outcome<String>>, chore: Outcome<String>) -> List<Outcome<String>> {
  concat(prepare, [part_retention_exports, chore, e(statements: release_bins_outcome_with_retention_statements(product: fleet_release_bins_product()))])
}

// cache hit: the verified store promotes, and the chore finds an empty family.
data script_full_step_hit: TransportScript? = release_bins_transport(
  parts: full_step_parts(
    prepare: [part_produced_store, part_no_mutation, part_restore_prep],
    chore: fake_curl_static(body: "{\"total_count\":0,\"actions_caches\":[]}"),
  )
)

test fn release_bins_full_step_hit_reports_restore_and_nothing_due() -> Bool {
  let r = run_script(script: script_full_step_hit)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins: stored pack verified and promoted")
    && string_contains(s: r.stdout, pattern: "release-bins retention: nothing-due")
    && !string_contains(s: r.stdout, pattern: "ReleaseBinsBuildReceipt")
}

// zero due: family at exactly the keep count deletes nothing and says so.
data script_full_step_zero_due: TransportScript? = release_bins_transport(
  parts: full_step_parts(
    prepare: [part_produced_store, part_no_mutation, part_restore_prep],
    chore: fake_curl_static(body: retention_at_cap_family_body),
  )
)

test fn release_bins_full_step_zero_due_keeps_the_keep_window() -> Bool {
  let r = run_script(script: script_full_step_zero_due)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins: stored pack verified and promoted")
    && string_contains(s: r.stdout, pattern: "release-bins retention: nothing-due")
    && !string_contains(s: r.stdout, pattern: "deleting=")
}

// failed GET with a valid stale answer already present: the step invalidates
// the answer before fetching, so the stale listing can neither plan nor delete;
// the failure is typed and the run still reports its outcome honestly.
data script_full_step_get_fail: TransportScript? = release_bins_transport(
  parts: full_step_parts(
    prepare: [part_produced_store, part_no_mutation, part_restore_prep],
    chore: e(statements: concat(
      [bash_build_with_redir_to_file(inner: cmdl(ls: ["printf", "%s", retention_at_cap_family_body]), path: fx(t: release_bins_retention_answer_file()))],
      fake_tool(name: "curl", lines: ["for a in \"$\"@\"; do case \"$\"a\" in http*) exit 22;; esac; done", "exit 0"]),
    )),
  )
)

test fn release_bins_full_step_get_fail_types_and_ignores_the_stale_answer() -> Bool {
  let r = run_script(script: script_full_step_get_fail)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins: stored pack verified and promoted")
    && string_contains(s: r.stdout, pattern: "release-bins retention: lookup-failed")
    && string_contains(s: r.stdout, pattern: "release-bins retention: no-answer")
    && !string_contains(s: r.stdout, pattern: "deleting=")
}

// over-page, whole step: over-cap stops the chore; the outcome is untouched.
data script_full_step_over_page: TransportScript? = release_bins_transport(
  parts: full_step_parts(
    prepare: [part_produced_store, part_no_mutation, part_restore_prep],
    chore: fake_curl_static(body: retention_over_bound_body),
  )
)

test fn release_bins_full_step_over_page_types_over_cap_and_promotes_anyway() -> Bool {
  let r = run_script(script: script_full_step_over_page)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins: stored pack verified and promoted")
    && string_contains(s: r.stdout, pattern: "release-bins retention: over-cap total=501")
    && !string_contains(s: r.stdout, pattern: "deleting=")
    && !string_contains(s: r.stdout, pattern: "no-answer")
}

// cache miss: the established-absence branch builds (fake cargo runs) and the
// chore still executes afterwards -- the behavioural half of F1, the static
// half being ..._falls_through_build_to_the_chore above.
data script_full_step_miss: TransportScript? = release_bins_transport(
  parts: [
    part_fixture,
    part_supplied_key,
    body_valid_empty,
    e(statements: [cmdl(ls: ["export", "LOOKUP_STANDING=absent", "LOOKUP_ENTRY=none", "CACHE_HIT=false", "GH_TOKEN=fake-token", "GITHUB_API_URL=http://127.0.0.1:1"])]),
    fake_curl_static(body: "{\"total_count\":0,\"actions_caches\":[]}"),
    e(statements: release_bins_outcome_with_retention_statements(product: fleet_release_bins_product())),
  ]
)

test fn release_bins_full_step_miss_builds_then_runs_the_chore() -> Bool {
  let r = run_script(script: script_full_step_miss)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "cargo 1.93.0 (fixture)")
    && string_contains(s: r.stdout, pattern: "ReleaseBinsBuildReceipt")
    && string_contains(s: r.stdout, pattern: "release-bins retention: nothing-due")
    && !string_contains(s: r.stdout, pattern: "stored pack verified and promoted")
}
