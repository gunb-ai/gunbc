// ── THE CACHE BUDGET GUARDIAN (review 95940 fixture) ─────────────────────────────────────────
// The retention decision block runs over a FIXTURED caches-list answer -- the same inject-the-answer
// shape the lookup decode claims use (decode_answer / answer_body) -- so no claim touches the network.
// Deletion is exercised against GITHUB_API_URL pointed at 127.0.0.1:1 (connection refused locally),
// which is how the claims observe the typed `delete-failed` line. Each fixture answer holds: 17
// release-bins-family entries (ids 1010..1026, created_at ascending, so id 1010 is the oldest family
// member and the single entry a KEEP of 16 owes), the CURRENT run's key as the second-oldest member
// (id 999 -- if the plan ever stops excluding it, `999` appears in stdout and the claims go red), and
// a foreign-family member (cargo-ci prefix, id 500, oldest of all -- it must never be due).
data retention_current_key: String = "release-bins-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

data retention_over_cap_body: String = "{\"total_count\":19,\"actions_caches\":[{\"id\":500,\"key\":\"cargo-ci-x86_64-mainsha\",\"created_at\":\"2019-01-01T00:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":999,\"key\":\"release-bins-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"created_at\":\"2020-01-01T00:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1010,\"key\":\"release-bins-10aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T10:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1011,\"key\":\"release-bins-11aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T11:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1012,\"key\":\"release-bins-12aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T12:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1013,\"key\":\"release-bins-13aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T13:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1014,\"key\":\"release-bins-14aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T14:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1015,\"key\":\"release-bins-15aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T15:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1016,\"key\":\"release-bins-16aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T16:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1017,\"key\":\"release-bins-17aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T17:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1018,\"key\":\"release-bins-18aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T18:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1019,\"key\":\"release-bins-19aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T19:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1020,\"key\":\"release-bins-20aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T20:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1021,\"key\":\"release-bins-21aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T21:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1022,\"key\":\"release-bins-22aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T22:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1023,\"key\":\"release-bins-23aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1024,\"key\":\"release-bins-24aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:10:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1025,\"key\":\"release-bins-25aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:20:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1026,\"key\":\"release-bins-26aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:30:00Z\",\"ref\":\"refs/heads/main\"}]}"

data retention_at_cap_body: String = "{\"total_count\":18,\"actions_caches\":[{\"id\":500,\"key\":\"cargo-ci-x86_64-mainsha\",\"created_at\":\"2019-01-01T00:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":999,\"key\":\"release-bins-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"created_at\":\"2020-01-01T00:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1011,\"key\":\"release-bins-11aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T11:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1012,\"key\":\"release-bins-12aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T12:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1013,\"key\":\"release-bins-13aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T13:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1014,\"key\":\"release-bins-14aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T14:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1015,\"key\":\"release-bins-15aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T15:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1016,\"key\":\"release-bins-16aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T16:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1017,\"key\":\"release-bins-17aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T17:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1018,\"key\":\"release-bins-18aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T18:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1019,\"key\":\"release-bins-19aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T19:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1020,\"key\":\"release-bins-20aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T20:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1021,\"key\":\"release-bins-21aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T21:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1022,\"key\":\"release-bins-22aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T22:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1023,\"key\":\"release-bins-23aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:00:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1024,\"key\":\"release-bins-24aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:10:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1025,\"key\":\"release-bins-25aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:20:00Z\",\"ref\":\"refs/heads/main\"},{\"id\":1026,\"key\":\"release-bins-26aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"created_at\":\"2026-11-01T23:30:00Z\",\"ref\":\"refs/heads/main\"}]}"

data part_retention_exports: Outcome<String> = exports(["GH_TOKEN=fixture-token","GITHUB_API_URL=http://127.0.0.1:1","GITHUB_REPOSITORY_OWNER=gunb-ai","GITHUB_REPOSITORY_NAME=gunbc",join(["RELEASE_BINS_KEY=", retention_current_key], "")])

fn retention_answer_part(body: String) -> Outcome<String> {
  e(statements: [bash_build_with_redir_to_file(inner: cmdl(ls: ["printf", "%s", body]), path: fx(t: release_bins_retention_answer_file()))])
}

data part_retention_decide: Outcome<String> = e(statements: release_bins_retention_decide_statements())

fn retention_claim(answer: Outcome<String>) -> List<Outcome<String>> {
  [part_fixture_env, part_retention_exports, answer, part_retention_decide]
}

data script_retention_over_cap: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: retention_over_cap_body)))
data script_retention_at_cap: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: retention_at_cap_body)))
data script_retention_malformed_answer: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: "oops")))
data script_retention_missing_answer: TransportScript? = release_bins_transport(parts: retention_claim(answer: part_no_mutation))

