// F1 (side chat 2026-11-17): admission is UNFILTERED -- a page program that dropped
// $ENV.RELEASE_BINS_KEY before the union would hide a duplicated id carrying the current key
// from the uniqueness and completeness gates (the reproduced case planned 232 deletions through
// exactly that hole). The plan excludes the current key only when selecting delete candidates,
// after the keep-window slice, and caps the per-run deletions.
test fn release_bins_retention_admission_is_unfiltered_and_the_plan_excludes_by_key() -> Bool {
  !string_contains(s: release_bins_retention_page1_program(), pattern: "and .key != $ENV.RELEASE_BINS_KEY")
    && !string_contains(s: release_bins_retention_page_program(n: 2), pattern: "and .key != $ENV.RELEASE_BINS_KEY")
    && string_contains(s: release_bins_retention_union_program(), pattern: "map(select(.key != $ENV.RELEASE_BINS_KEY))")
    // THE WINDOW IS OVER THE CONSUMABLE POPULATION (review 96127): the keep-window slice runs
    // over the ref==refs/heads/main population -- the only entries the lookup can consume --
    // BEFORE the current-key exclusion. If the slice ever moves back in front of the ref filter,
    // a PR-ref crowd can evict main's entries and this assertion goes red with them.
    && string_contains(s: release_bins_retention_union_program(), pattern: "map(select(.ref == \"refs/heads/main\"))")
    // recency is REAL time, not string order (2026-11-100 would sort before 2026-11-2 lexically)
    && string_contains(s: release_bins_retention_union_program(), pattern: "sub(\"\\\\.[0-9]+Z$\"; \"Z\") | strptime(\"%Y-%m-%dT%H:%M:%SZ\") | mktime")
    && string_contains(s: release_bins_retention_union_program(), pattern: "sort_by([._retention_epoch, ._retention_frac, .id])")
    && string_contains(s: release_bins_retention_union_program(), pattern: ".ref | type) == \"string\"")
}

// F2 (side chat 2026-11-17): every retention network call is bounded -- a `timeout` prefix and
// curl --max-time on each curl, and the plan carries the per-run delete-cap slice -- so the
// chore cannot overrun the step it lives in, and the chore runs inside a best-effort subshell.
test fn release_bins_retention_network_calls_are_bounded() -> Bool {
  let text = release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_retention_statements()))
  string_contains(s: text, pattern: "--max-time")
    // every failure word is a job annotation, not a bare echo (review 96127: countable degradations)
    && string_contains(s: text, pattern: "::warning title=release-bins retention::")
    && string_contains(s: text, pattern: "'timeout'")
    && string_contains(s: text, pattern: "map(select(.key != $ENV.RELEASE_BINS_KEY)) | .[0: ")
}

// F1 REVISED (review 96095, superseding the 2026-11-16 side-chat shape): the step's script must
// BOTH end the outcome=build arm in `exit 0` AND lead with the retention chore. The old claim
// here asserted the opposite -- no exit 0 anywhere, so the build arm "fell through" to a chore
// appended at the tail -- and that shape was wrong twice over: falling through runs on into the
// REUSE path's stored-pack verification, which refuses the just-emptied $STAGE with a fabricated
// StoredEntryIncomplete on every cache-miss run, and a tail chore never runs on the build path
// anyway because the arm exits. Discriminators: no exit 0 anywhere is red (the fabricated-refusal
// shape), and retention not leading is red (the tail-chore shape).
data script_outcome_with_retention_text: String = release_bins_outcome_with_retention_script()

data script_retention_head_text: String = release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_retention_statements()))

test fn release_bins_retention_outcome_script_leads_with_the_chore_and_the_build_arm_exits_zero() -> Bool {
  string_contains(s: script_outcome_with_retention_text, pattern: "outcome=build")
    && string_contains(s: script_outcome_with_retention_text, pattern: "release-bins retention:")
    && string_contains(s: script_outcome_with_retention_text, pattern: "exit 0")
    && starts_with(s: script_outcome_with_retention_text, prefix: script_retention_head_text)
}

// F3 (side chat): a failed lookup is TYPED as lookup-failed, and deletions can
// only be planned from THIS invocation's own successful answer. The fixture
// pre-seeds a stale answer that would plan deletions (the over-cap body), then
// the fetch's curl fails: after the fix the answer is invalidated before the
// fetch and removed again on failure, so nothing is planned or deleted and
// both lookup-failed and no-answer appear. Pre-fix this was red: the failure
// was swallowed ('|| true'), the stale answer drove the plan, and the step
// printed deleting=... lines from data it never fetched.
data part_retention_stale_answer: Outcome<String> = retention_answer_part(body: retention_over_cap_body)

fn fake_curl_failing() -> Outcome<String> {
  e(statements: fake_tool(name: "curl", lines: ["exit 22"]))
}

data script_retention_fetch_fails_over_stale: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    part_retention_stale_answer,
    fake_curl_failing(),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_fetch_failure_is_typed_and_cannot_delete_on_stale() -> Bool {
  let r = run_script(script: script_retention_fetch_fails_over_stale)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: lookup-failed")
    && string_contains(s: r.stdout, pattern: "release-bins retention: no-answer")
    && !string_contains(s: r.stdout, pattern: "deleting=")
    && !string_contains(s: r.stdout, pattern: "due=1010")
}

// The successful end of the same path: the chore fetches its OWN answer
// (fake curl honours -o), plans and deletes through the real statements --
// so the typed success lines are produced by the code the workflow runs,
// not only by a pre-seeded file.
fn fake_curl_answering(body: String) -> Outcome<String> {
  e(statements: fake_tool(
    name: "curl",
    lines: [
      "o=0",
      "for a in \"$\"@\"; do if [ \"$\"o\" = 1 ]; then printf %s \"" + body + "\" > \"$\"a\"; o=0; fi; if [ \"$\"a\" = -o ]; then o=1; fi; done",
      "exit 0",
    ]
  ))
}

data script_retention_full_chore: TransportScript? = release_bins_transport(
  parts: [
    part_fixture_env,
    part_retention_exports,
    fake_curl_answering(body: retention_over_cap_body),
    e(statements: release_bins_retention_statements()),
  ]
)

test fn release_bins_retention_full_chore_deletes_from_its_own_answer() -> Bool {
  let r = run_script(script: script_retention_full_chore)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: due=1010")
    && string_contains(s: r.stdout, pattern: "release-bins retention: deleting=1 keep=16")
}


// ---------------------------------------------------------------------------
// F4 (side chat, 2026-11-16, msg_495d8e8e): pagination. One page of 100 with a
// strict total_count == length admission silently disabled the guardian the
// moment the release-bins family exceeded 100 entries. These claims pin the
// replacement: page 1's total gates pages 2..5, each page is admitted on its
// own and appends only its own ids, a total past the bound types `over-cap`
// and deletes nothing, and the five whole-step paths run the EMITTED step.
// Bodies are generated, not hand-counted: one family entry per id, created_at
// ascending with the id, listing order created_at-descending as the API sends.
// ---------------------------------------------------------------------------

fn retention_int_range(from: Int, to: Int) -> List<Int> {
  if from > to {
    []
  } else {
    concat([from], retention_int_range(from + 1, to))
  }
}


// i div 28 for fixture calendar fields (month/day split); divisors are constants, so the Err
// arm is totalization only -- 0 can never order a fixture page out of monotonicity unnoticed,
// and a wrong calendar field makes strptime refuse the whole plan (fail-closed).
fn retention_div28(i: Int) -> Int {
  match int_div_result(i, 28) {
    Ok { value: q } => q
    Err { value: _ } => 0
  }
}

// FRACTIONAL-SECOND SHAPES (F3, bright-ibex-807): GitHub's cache API documents created_at like
// "2019-01-24T22:45:36.000Z"; jq 1.7 strptime rejects that string outright, so without the
// fractional strip EVERY valid listing would plan-fail and retention would silently never
// delete. These two executed cases are the discriminators a whole-second fixture cannot be:
// seventeen main-ref entries whose timestamps all carry .000Z, and seventeen whose shapes are
// mixed -- both must plan, name the oldest eligible entry (id 1), and keep the newest 16.
// The refusal side of the parse (F3's "an unparseable timestamp must still refuse, not silently
// sort"): seventeen main-ref entries where the newest carries a timestamp in neither documented
// shape. The plan must abort with plan-failed and issue zero deletions -- retention degrades
// visibly (annotation) rather than ordering deletions on a guess.
fn retention_garbage_entry_text(i: Int) -> String {
  join([
    "{\"id\": ", int_to_decimal_string(i),
    ", \"key\": \"release-bins-r", int_to_decimal_string(i),
    "\", \"ref\": \"refs/heads/main\", \"created_at\": \"not-a-timestamp\"}",
  ], "")
}

fn retention_garbage_page_body() -> String {
  join(["{\"total_count\": 17, \"actions_caches\": ["], "")
    + join(map(retention_int_range(1, 16), i => retention_family_entry_text(i: i)), ", ")
    + ", "
    + retention_garbage_entry_text(i: 17)
    + "]}"
}

data retention_garbage_body: String = retention_garbage_page_body()
data script_retention_garbage_timestamp: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: retention_garbage_body)))

test fn release_bins_retention_refuses_an_unparseable_timestamp() -> Bool {
  let r = run_script(script: script_retention_garbage_timestamp)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: plan-failed")
    && !string_contains(s: r.stdout, pattern: "deleting=")
}

fn retention_family_entry_text_frac(i: Int) -> String {
  join([
    "{\"id\": ", int_to_decimal_string(i),
    ", \"key\": \"release-bins-r", int_to_decimal_string(i),
    "\", \"ref\": \"refs/heads/main\", \"created_at\": \"2026-", int_to_decimal_string(int_add(retention_div28(i), 1)),
    "-", int_to_decimal_string(int_add(int_sub(i, int_mul(retention_div28(i), 28)), 1)), "T00:00:00.000Z\"}",
  ], "")
}

fn retention_family_entry_text_shape(i: Int) -> String {
  match int_div_result(i, 2) {
    // even ids carry the fraction, odd ids do not: one ordering across two shapes
    Ok { value: q } => if int_eq(int_mul(q, 2), i) { retention_family_entry_text_frac(i: i) } else { retention_family_entry_text(i: i) }
    Err { value: _ } => retention_family_entry_text(i: i)
  }
}

fn retention_shape_page_body(start: Int, end: Int, total: Int, frac: Bool) -> String {
  join(["{\"total_count\": ", int_to_decimal_string(total), ", \"actions_caches\": ["], "")
    + join(map(retention_int_range(start, end), i => if frac { retention_family_entry_text_frac(i: i) } else { retention_family_entry_text_shape(i: i) }), ", ")
    + "]}"
}

data retention_frac_body: String = retention_shape_page_body(start: 1, end: 17, total: 17, frac: true)
data retention_mixedshape_body: String = retention_shape_page_body(start: 1, end: 17, total: 17, frac: false)

data script_retention_frac_shapes: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: retention_frac_body)))
data script_retention_mixed_shapes: TransportScript? = release_bins_transport(parts: retention_claim(answer: retention_answer_part(body: retention_mixedshape_body)))

test fn release_bins_retention_parses_fractional_seconds() -> Bool {
  let r = run_script(script: script_retention_frac_shapes)
  r.ran
    && r.success
    && string_contains(s: r.stdout, pattern: "release-bins retention: deleting=1 keep=16")
    && string_contains(s: r.stdout, pattern: "release-bins retention: due=1")
    && !string_contains(s: r.stdout, pattern: "release-bins retention: due=1 ")
    && !string_contains(s: r.stdout, pattern: "due=2")
    && !string_contains(s: r.stdout, pattern: "due=3")
    && !string_contains(s: r.stdout, pattern: "due=4")
    && !string_contains(s: r.stdout, pattern: "due=5")
    && !string_contains(s: r.stdout, pattern: "due=6")
    && !string_contains(s: r.stdout, pattern: "due=7")
    && !string_contains(s: r.stdout, pattern: "due=8")
    && !string_contains(s: r.stdout, pattern: "due=9")
    && !string_contains(s: r.stdout, pattern: "due=10")
    && !string_contains(s: r.stdout, pattern: "due=11")
    && !string_contains(s: r.stdout, pattern: "due=12")
    && !string_contains(s: r.stdout, pattern: "due=13")
    && !string_contains(s: r.stdout, pattern: "due=14")
    && !string_contains(s: r.stdout, pattern: "due=15")
    && !string_contains(s: r.stdout, pattern: "due=16")
    && !string_contains(s: r.stdout, pattern: "due=17")
    && !string_contains(s: r.stdout, pattern: "plan-failed")
