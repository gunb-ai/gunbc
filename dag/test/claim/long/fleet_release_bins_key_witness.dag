  r.ran && r.success && string_contains(s: r.stdout, pattern: "release-bins retention: due=1010") && string_contains(s: r.stdout, pattern: "release-bins retention: deleting=1 keep=16") && !string_contains(s: r.stdout, pattern: "999")
}

