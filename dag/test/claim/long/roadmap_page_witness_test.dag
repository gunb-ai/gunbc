// surface ruling: (1) the SERVED page half — the chain renders as flat table rows, every node
// exactly once, and the cap machinery (the deeper disclosure) no longer ships on this surface;
// (2) the MACHINERY half — the project-tree component the /sandbox exhibit still consumes renders
// three expanded project levels, the project AT the cap behind a collapsed "+N deeper" disclosure
// (N = the tasks hidden at the next level), and the rows beyond still render inside it — the cap
// bounds the default view, it never drops a node.
fn fx_page_chain_doc() -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [ RoadmapSection {
      title: "Chain",
      elements: [ section_group(label: "", nodes: fx_page_chain_nodes(), edges: fx_page_chain_edges()) ],
    } ],
  }
}

fn fx_page_chain_html() -> HtmlEmitResult {
  try_serialize_html_source(node: roadmap_daily_workspace_page_launch_with_stylesheet(doc: fx_page_chain_doc(), merged: [], launch: dispatch_doc_standing(), memberships: fixture_nesting_relation(edges: doc_all_edges(doc: fx_page_chain_doc())), stylesheet: site_styles(rules: [])))
}

fn fx_chain_top_project_view() -> gunbc.roadmap_presentation.ProjectTreeView {
  let doc = fx_page_chain_doc()
  let nodes = gunbc.roadmap_spawner.doc_all_nodes(doc: doc)
  let edges = gunbc.roadmap_spawner.doc_all_edges(doc: doc)
  let ctx = gunbc.roadmap_page.page_launch_context(doc: doc, merged: [], launch: dispatch_doc_standing())
  let rows = map(nodes, rn => gunbc.roadmap_presentation.work_row_view(
    rn: rn, nodes: nodes, edges: edges, merged: [],
    activity: gunbc.roadmap_presentation.NoActiveWork,
    rounds: RoundsUnobserved { reason: "no active attempt" as NonEmptyStr },
    worker_alive: false, standing: none, launch: ctx, attempt_stale: false, profiles: []))
  match (filter(rows, r => r.node_id == "page-chain-c1")).first() {
    Absent => fx_project_tree_view(auto_open: false)
    Present { value: top } =>
      gunbc.roadmap_presentation.project_tree_view(
        row: top, rows: rows, edges: edges, members: [], depth: 1, fuel: count(rows), memberships: membership_index(memberships: fixture_nesting_relation(edges: edges)))
  }
}

test fn witness_project_depth_cap_renders_deeper_affordance() -> Bool {
  match fx_page_chain_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let table = string_at(parts: split(s: table_region(html: h), delimiter: "<div class=\"issue-table\" role=\"table\" aria-label=\"Issue search results\">"), index: 1)
      !string_contains(s: table, pattern: "project-deeper")
        && !string_contains(s: table, pattern: "+2 deeper")
        && !string_contains(s: table, pattern: "class=\"project-tasks\"")
        && occurrence_count(s: h, pattern: "data-node=\"page-chain-c4\" tabindex=\"0\"") == 1
        && occurrence_count(s: h, pattern: "data-node=\"page-chain-x3\" tabindex=\"0\"") == 1
        && string_contains(s: h, pattern: "chain level four")
  }
    && match try_serialize_html_source(node: gunbc.roadmap_page.project_tree_li(view: fx_chain_top_project_view(), observation: gunbc.roadmap_presentation.ObservationsNominal)) {
      EmitRejected { reason: _ } => false
      EmitOk { html: h } =>
        occurrence_count(s: h, pattern: "<details class=\"project-tasks project-deeper\">") == 1
          && string_contains(s: h, pattern: "+2 deeper")
          && !string_contains(s: h, pattern: "project-deeper\" open")
          && string_contains(s: h, pattern: "data-node=\"page-chain-c4\" tabindex=\"0\"")
          && string_contains(s: h, pattern: "chain level four")
    }
}

// THE LIVE EXEMPLAR (identity grain, never a population count), re-pointed at the 2026-09-30 tree:
// over the real authority the shell batch is shell-typed-invocation's ten authored shell-dag-*
// tasks. Every member renders as its own flat row exactly once, and the project renders once: the
// table swallows nothing and drops nothing, and the not-ready filter hides neither a ready task nor
// a project with members.
fn li_of_node(html: String, node_id: String) -> String {
  fold(split(s: html, delimiter: "<li"), init: "", f: (acc, p) =>
    if string_contains(s: p, pattern: join(["data-node=\"", node_id, "\""], "")) { p } else { acc })
}

// THE COLLAPSED CHAIN ON THE TABLE (the 2026-09-25 rendering half): the tree derivation swallows
// the single-child intermediate — top's row carries the chain end's "0 of 2 tasks closed" count
// chip — while the TABLE swallows nothing: the intermediate and both tasks render as their own
// flat rows, each exactly once, and no chain line or tasks disclosure ships on this surface
// (that rendering survives on the /sandbox exhibit's grouping path, pinned at unit level by
// witness_project_disclosure_open_attribute_is_derived and the depth-cap machinery half).
test fn witness_collapsed_chain_renders_one_row_with_chain_line() -> Bool {
  let top = fx_authored_wi(identity: "rnfx_PAGEHIERCOLLAPSE00001", id: "page-collapse-top",
    done: false, content: "collapse top", repo: "gunbc")
  let mid = fx_authored_wi(identity: "rnfx_PAGEHIERCOLLAPSE00002", id: "page-collapse-mid",
    done: false, content: "collapse mid", repo: "gunbc")
  let t1 = fx_authored_wi(identity: "rnfx_PAGEHIERCOLLAPSE00003", id: "page-collapse-t1",
    done: false, content: "collapse task one", repo: "gunbc")
  let t2 = fx_authored_wi(identity: "rnfx_PAGEHIERCOLLAPSE00004", id: "page-collapse-t2",
    done: false, content: "collapse task two", repo: "gunbc")
  let edges = [
    gunbc.roadmap_authority.edge(child: "page-collapse-top", parent: "page-collapse-mid"),
    gunbc.roadmap_authority.edge(child: "page-collapse-mid", parent: "page-collapse-t1"),
    gunbc.roadmap_authority.edge(child: "page-collapse-mid", parent: "page-collapse-t2"),
  ]
  let doc = RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [ RoadmapSection {
      title: "Collapse",
      elements: [ section_group(label: "", nodes: [top, mid, t1, t2], edges: edges) ],
    } ],
  }
  match try_serialize_html_source(node: roadmap_daily_workspace_page_launch_with_stylesheet(doc: doc, merged: [], launch: dispatch_doc_standing(), memberships: fixture_nesting_relation(edges: doc_all_edges(doc: doc)), stylesheet: site_styles(rules: []))) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let top_row = li_of_node(html: h, node_id: "page-collapse-top")
      !string_contains(s: top_row, pattern: "node-project")
        && !string_contains(s: top_row, pattern: "tasks closed")
        && !string_contains(s: h, pattern: "project-chain-member")
        && !string_contains(s: h, pattern: "class=\"project-tasks\"")
        && occurrence_count(s: h, pattern: "data-node=\"page-collapse-mid\" tabindex=\"0\"") == 1
        && occurrence_count(s: h, pattern: "data-node=\"page-collapse-t1\" tabindex=\"0\"") == 1
        && occurrence_count(s: h, pattern: "data-node=\"page-collapse-t2\" tabindex=\"0\"") == 1
        && string_contains(s: h, pattern: "collapse mid")
  }
}

// ── Hero attempt rows, red flags, activity coloring (operator request 2026-09-21) ───────────────
//
// The attempt row's collapsed face is the bar: the stage strip (one segment per workflow
// obligation, state class from the wire's own decided state key), the one-line state carrying its
// decided activity-line class, and the throughput line. Everything that used to ride the face —
// the round strip, the obligation ledger with its texts, the bounded refusal payloads, the
// session/process evidence — sits behind the activity disclosure, which never arrives open. The
// strip segment classes below pin EVERY state; the refused and failed fixtures pin the red
// segment and the error-refusal summary class; the project fixture pins the red flag on the
// progress region derived from the seam's subtree_error.

fn hero_green_segments() -> List<gunbc.roadmap_workflow_stage.WorkflowSegment> {
  [
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.EnvironmentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.WorkspaceWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentActive, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.SubmissionWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentStopped, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.ReviewWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.GoalAuditWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
  ]
}

fn hero_rounds_fixture() -> HarnessRoundLedger {
  RoundsObserved { rounds: [
    RoundObservation { step: 1, input_tokens: 0, output_tokens: 10, epoch_ms: 0, files_changed: none, tool_calls: none },
    RoundObservation { step: 2, input_tokens: 0, output_tokens: 20, epoch_ms: 5000, files_changed: Present { value: 0 }, tool_calls: Present { value: 2 } },
    RoundObservation { step: 3, input_tokens: 0, output_tokens: 30, epoch_ms: 9000, files_changed: Present { value: 2 }, tool_calls: Present { value: 1 } },
    RoundObservation { step: 4, input_tokens: 0, output_tokens: 40, epoch_ms: 12000, files_changed: Present { value: 2 }, tool_calls: Present { value: 0 } },
  ] }
}

