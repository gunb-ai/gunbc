        gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused, detail: "oracle missing" },
      ],
      remaining: 6,
      process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
      throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
      current_activity: ""),
    alive: false)
}

fn hero_failed_view() -> gunbc.roadmap_presentation.WorkRowView {
  hero_row_view(
    node_id: "hero-failed",
    activity: gunbc.roadmap_presentation.activity_view_from_parts(
      segments: [
        gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentFailed, detail: "exit 1 before terminal event" },
      ],
      remaining: 6,
      process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 1, last_command: "codex" },
      throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
      current_activity: ""),
    alive: false)
}

// THE RED FLAG: a refused segment renders RED at its stage segment and the one-line state carries
// error-refusal; the refused payload stays behind a disclosure that does not arrive open. The
// failed arm flags the same way at its own segment.
test fn witness_red_flagged_attempt_row() -> Bool {
  match hero_row_html(view: hero_refused_view()) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "class=\"stage-segment stage-refused\"") == 1
        && occurrence_count(s: h, pattern: "class=\"stage-segment stage-complete\"") == 1
        && string_contains(s: h, pattern: "class=\"taskbar taskbar-error\"")
        && string_contains(s: h, pattern: "class=\"taskbar-signal activity-line-error-refusal\"")
        && string_contains(s: h, pattern: "data-arm=\"refused\"")
        && !string_contains(s: h, pattern: "<details class=\"taskbar-inspect\" open")
  }
    && match hero_row_html(view: hero_failed_view()) {
      EmitRejected { reason: _ } => false
      EmitOk { html: h } =>
        occurrence_count(s: h, pattern: "class=\"stage-segment stage-failed\"") == 1
          && string_contains(s: h, pattern: "class=\"taskbar taskbar-error\"")
          && string_contains(s: h, pattern: "data-attention=\"anomalous\"")
    }
}

// The project bar's red flag renders from the seam's DECIDED subtree_error: the renderer reads the
// field, it does not re-derive. (The derivation — refused or anomalous attempt anywhere in the
// subtree — is pinned in test.claim.roadmap_presentation_witness.)
test fn witness_project_bar_flags_red_from_decided_field() -> Bool {
  let base = gunbc.roadmap_presentation.ProjectTreeView {
    row: hero_green_view(alive: false),
    chain: [],
    depth: 1,
    closed_count: 1,
    total_count: 3,
    auto_open: false,
    subtree_error: true,
    entries: [],
    linked: [],
  }
  let quiet = gunbc.roadmap_presentation.ProjectTreeView {
    row: hero_green_view(alive: false),
    chain: [],
    depth: 1,
    closed_count: 1,
    total_count: 3,
    auto_open: false,
    subtree_error: false,
    entries: [],
    linked: [],
  }
  match try_serialize_html_source(node: gunbc.roadmap_page.project_tree_li(view: base, observation: gunbc.roadmap_presentation.ObservationsNominal)) {
    EmitRejected { reason: _ } => false
    EmitOk { html: flagged } =>
      match try_serialize_html_source(node: gunbc.roadmap_page.project_tree_li(view: quiet, observation: gunbc.roadmap_presentation.ObservationsNominal)) {
        EmitRejected { reason: _ } => false
        EmitOk { html: calm } =>
          string_contains(s: flagged, pattern: "class=\"taskbar taskbar-error\"")
            && string_contains(s: flagged, pattern: "1 of 3 tasks closed")
            && !string_contains(s: calm, pattern: "taskbar-error")
            && string_contains(s: calm, pattern: "class=\"taskbar\"")
      }
  }
}

// The client's half of the hero face (single projection authority): the emitted asset paints the
// stage strip from the wire's decided segment state keys, the summary's decided class, and the
// wire throughput — all verbatim, no policy.
test fn witness_client_paints_hero_face_verbatim() -> Bool {
  let js = fx_client_group_js(stmts: workflow_fetch_statements())
  string_contains(s: js, pattern: "stage-strip")
    && string_contains(s: js, pattern: "stage-segment stage-")
    && string_contains(s: js, pattern: "+ seg.state")
    && string_contains(s: js, pattern: "attempt.throughput")
    && string_contains(s: js, pattern: "av.summary_class")
    && string_contains(s: js, pattern: "activity-throughput")
}

// ── GROUP-EVERYWHERE (operator feedback 2026-09-21: "I'm not seeing the grouping") ───────────────
//
// The amended placement rule, rendered: grouping is the organizing principle of the row set — a
// task belongs to its project's flat-table contribution regardless of attempts, and a top-level
// row joins the Active band's head when its SUBTREE carries live work. These fixtures drive the
// real authority's shell graph: one fabricated live attempt on
// shell-dag-cron-entry-line-builder (the row the live belt happens to be working) pulls the whole
// collapsed shell project to the table's head — and a refused attempt marks the live row's status
// line error-refusal (the retired forest used to roll the red flag up to the project bar; that
// render survives on the kept project-tree component).

// THE ISSUE TRACKER'S SURFACE (owner ruling 2026-09-22, amended 2026-09-25 "just copy buganizer"):
// the page opens on the searchable issue table — one flat container with every rendered issue as a
// dense line carrying data-search (headline · node id · owner), the search input, and the band
// filter chips. THE VIEW TABS AND THEIR FOREST RETIRED with the 2026-09-25 ruling: no view chips,
// no second container, no data-view attribute — a resurrected tab or forest reds here.
test fn witness_default_view_is_the_searchable_issue_table() -> Bool {
  match fx_page_project_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "<section class=\"roadmap-frontier\">")
        && string_contains(s: h, pattern: "<div class=\"view-table\">")
        && !string_contains(s: h, pattern: "view-forest")
        && !string_contains(s: h, pattern: "data-view")
        && string_contains(s: h, pattern: "<input type=\"search\" class=\"issue-search\"")
        && string_contains(s: h, pattern: "data-band-chip=\"active\"")
        && string_contains(s: h, pattern: "data-band-chip=\"all\"")
        && !string_contains(s: h, pattern: "data-view-chip")
        && occurrence_count(s: h, pattern: "data-node=\"page-task-one\" tabindex=\"0\"") == 1
        && string_contains(s: h, pattern: "data-search=\"page task one page-task-one")
  }
}

// The client mechanics and the stylesheet law, both pinned at their contracts: the band chips only
// write data-band-filter — the stylesheet hides non-matching rows of the one table; the search
// reads the row's own decided data-search; filters retain nothing (matching is a substring read
// over the flat table, never a tree walk). The retired view switch is the census half: no
// [data-view-chip] binding in the emitted asset, no data-view rule in the sheet.
test fn witness_view_switch_and_filter_contracts() -> Bool {
  let js = fx_client_group_js(stmts: issue_filter_bind_statements())
  let css = fx_css_rule_blocks()
  !string_contains(s: js, pattern: "[data-view-chip]")
    && string_contains(s: js, pattern: "[data-band-chip]")
    && string_contains(s: js, pattern: "input.issue-search")
    && string_contains(s: js, pattern: "dataset.search")
    && string_contains(s: js, pattern: "toLowerCase()")
    && string_contains(s: js, pattern: "bandFilter")
    && !string_contains(s: css, pattern: "data-view")
    && string_contains(s: css, pattern: ".roadmap-frontier[data-band-filter=\"active\"] .view-table li.node:not([data-band=\"active\"]) { display: none }")
    && string_contains(s: css, pattern: ".taskbar-sub:empty, .taskbar-signal:empty, .taskbar-count:empty { display: none }")
}

