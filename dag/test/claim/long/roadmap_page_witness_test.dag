  }
}

fn brief_fixture_html(lifecycle: gunbc.roadmap_presentation.WorkLifecycle, control_label: String = "red control") -> HtmlEmitResult {
  try_serialize_html_source(node: fx_issue_detail_body(
    view: issue_detail_fixture_view_with_brief(lifecycle: lifecycle, control_label: control_label),
    panel: issue_detail_fixture_panel(),
    observation: gunbc.roadmap_presentation.ObservationsNominal,
    attempts: [],
    events: [],
    viewer: "principal:google-oidc/accounts/sub-viewer",
    recents: [ fixture_teammate_legacy() ],
    expected_revision: "",
    command_context: IssueFormContext { operation: "", csrf: "" },
    profiles: []))
}

// THE AUTHORED FIELDS FOLD (owner mandate 2026-09-25, docs/plans/issue-page-architecture.md):
// Description renders the brief; Acceptance criteria carries the red control and hand-back; the
// code-ish red control (multi-line, fn signature) renders in a MONO block, never a prose
// paragraph; Current plan rides a details/summary disclosure OPEN while the work is not done;
// Scope rides a collapsed disclosure; and the verified row NEVER forms when no verification was
// recorded.
test fn witness_issue_authored_fields_fold_per_the_mandate() -> Bool {
  match brief_fixture_html(lifecycle: gunbc.roadmap_presentation.OpenLifecycle) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "<h2 class=\"issue-description-heading\">Description</h2>") == 1
        && occurrence_count(s: h, pattern: "<h3 class=\"issue-authored-heading\">Acceptance criteria</h3>") == 1
        && occurrence_count(s: h, pattern: "<details class=\"issue-authored-details\" open=\"\"><summary>Current plan</summary>") == 1
        && occurrence_count(s: h, pattern: "<details class=\"issue-authored-details\"><summary>Scope</summary>") == 1
        && occurrence_count(s: h, pattern: "<pre class=\"ticket-field-code\">first line\nfn example_signature() :: typed</pre>") == 1
        && string_contains(s: h, pattern: "<span class=\"ticket-field-label\">red control</span>")
        && string_contains(s: h, pattern: "<span class=\"ticket-field-label\">hand-back</span>")
        && string_contains(s: h, pattern: "<span class=\"ticket-field-label\">current state</span>")
        && string_contains(s: h, pattern: "<span class=\"ticket-field-label\">first slice</span>")
        && string_contains(s: h, pattern: "<span class=\"ticket-field-label\">displaced cost</span>")
        && string_contains(s: h, pattern: "<summary>Scope</summary><div class=\"ticket-field\"><span class=\"ticket-field-label\">out of scope</span>")
        && occurrence_count(s: h, pattern: "issue-field-label\">verified</span>") == 0
  }
}

// CURRENT PLAN COLLAPSES ONCE THE WORK IS DONE: the same fixture under a done lifecycle renders
// the plan disclosure with NO open attribute — the summary stays, the body rests.
test fn witness_issue_current_plan_collapses_once_done() -> Bool {
  match brief_fixture_html(lifecycle: gunbc.roadmap_presentation.DoneLifecycle) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "<details class=\"issue-authored-details\"><summary>Current plan</summary>") == 1
  }
}

// THE HEADER ACCOUNT AREA, DYNAMIC CONTRACT (owner defect 2026-09-27: the main page body is the
// belt's pre-rendered static body, so the account area personalizes client-side). THE STATIC
// BODY renders a HIDDEN, EMPTY session target — the session span carries hidden with EMPTY avatar
// and name fields (no identity claim in the static bytes). DISCRIMINATING ABSENCE (#12787): the
// Google login, callback and logout routes moved to a follow-up PR, so the page must address
// none of them — no href to /auth/login (Sign in, Switch account), no form action /auth/logout
// (Sign out), and no account menu; a link to a route this server does not serve is a dead control.
test fn witness_header_account_static_body_carries_hidden_target_and_no_login_controls() -> Bool {
  match issue_detail_fixture_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let body = match (split(s: h, delimiter: "</style>")).skip(n: 1).first() { Present { value: b } => b  Absent => h }
      occurrence_count(s: body, pattern: "<span class=\"header-account header-account-session\" data-account-session=\"\" hidden=\"\">") == 1
        && occurrence_count(s: body, pattern: "<button class=\"header-account-trigger\" type=\"button\" data-account-trigger=\"\">") == 1
        && occurrence_count(s: body, pattern: "<span class=\"site-avatar\" data-account-avatar=\"\" data-avatar=\"absent\"></span>") == 1
        && occurrence_count(s: body, pattern: "<span class=\"header-account-name\" data-account-name=\"\"></span>") == 1
        && !string_contains(s: body, pattern: "/auth/login")
        && !string_contains(s: body, pattern: "/auth/logout")
        && !string_contains(s: body, pattern: "data-account-menu")
        && !string_contains(s: body, pattern: "data-account-signin")
  }
}

// The account controls' hiding and avatar-crop rules, read where they are emitted (the serialized
// rules); the static body claim above reads the markup.
test fn witness_header_account_rules_hide_and_crop() -> Bool {
  let css = fx_css_rule_blocks()
  string_contains(s: css, pattern: ".header-account-session[hidden] { display: none }")
    && !string_contains(s: css, pattern: "header-account-signin")
    && !string_contains(s: css, pattern: "header-account-menu")
    && string_contains(s: css, pattern: ".site-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover }")
    && fx_emitted_property(selector: ".site-avatar", property: "position", value: "relative")
    && fx_emitted_property(selector: ".site-avatar", property: "overflow", value: "hidden")
}

// THE SWAP TABLE (the client program's contract), ONE SESSION READ since the 2026-09-27
// unification: the program names GET /auth/session exactly ONCE — the shared gunbcSessionRead
// promise (same-origin credentials, no-store, non-OK standings rejected) — and BOTH consumers
// ride it: the account swap's .then gates on s && s.authenticated === true and the assignment
// seeding's .then(assignmentSetSession). An authenticated response hides Sign in, unhides the
// session target, and writes the display name (the wire's OPTIONAL name member preferred, the
// principal's short form — viewer split on '/' — when the login projected no name), initials
// in the avatar (substring 0..1) — the name and avatar ride the SESSION RESPONSE alone;
// unauthenticated, absent, or a FAILED read leaves Sign in and disables assignment (each
// consumer's catch; never an identity claim from a failed fetch). THE SHAPES ARE PINNED, not
// just the words: exactly one fetch (a second /auth/session fetch is a contract break), the
// guard reads the bare slot consts (a stray `b.` receiver is a page-breaking ReferenceError),
// no `=> if (` arrow (a JS syntax error substring-matching cannot see), and the assignment
// consumption names the shared read. THE
// PFP BRANCH is the never-blocks law rendered: when the wire's OPTIONAL picture member is
// present, an <img> (src = s.picture, alt = '' so a broken image renders nothing) appends INSIDE
// the same avatar chip and the standing flips to data-avatar="resolved" — the initials are
// never removed, so a slow or failed image falls back to them; when the member is absent the
// branch never runs and the initials stand alone.
test fn witness_header_account_swap_table() -> Bool {
  let js = fx_client_group_js(stmts: concat(session_read_bind_statements(), concat(account_swap_statements(), inline_assignment_bind_statements())))
  occurrence_count(s: js, pattern: "fetch('/auth/session'") == 1
    && string_contains(s: js, pattern: "const gunbcSessionRead = fetch('/auth/session', { credentials: 'same-origin', cache: 'no-store' })")
    && string_contains(s: js, pattern: "if (!response.ok)")
    && string_contains(s: js, pattern: "if (gunbcAccountSlot)")
    && !string_contains(s: js, pattern: "gunbcAccountSignin")
    && string_contains(s: js, pattern: "gunbcSessionRead.then((s) =>")
    && string_contains(s: js, pattern: "gunbcSessionRead.then(assignmentSetSession)")
    && !string_contains(s: js, pattern: "=> if (")
    && string_contains(s: js, pattern: "s && s.authenticated && s.authenticated === true")
    && string_contains(s: js, pattern: "gunbcAccountSlot.hidden = false")
    && string_contains(s: js, pattern: "s.name || s.viewer || s.principal")
    && string_contains(s: js, pattern: "if (s.picture) {")
    && string_contains(s: js, pattern: "const gunbcAvatarImg = document.createElement('img');")
    && string_contains(s: js, pattern: "gunbcAvatarImg.src = s.picture;")
    && string_contains(s: js, pattern: "gunbcAvatarImg.alt = '';")
    && string_contains(s: js, pattern: ".setAttribute('data-avatar', 'resolved');")
    && string_contains(s: js, pattern: ".appendChild(gunbcAvatarImg);")
    && !string_contains(s: js, pattern: "data-account-menu")
}
// THE RAIL-FIT LAW (owner polish 2026-09-26: the Assign button clipped the rail's right edge):
// the input flexes with min-width 0 — it shrinks below its default intrinsic size instead of
// overflowing — and the form wraps as the belt-and-braces, so the input+button row's declared
// geometry fits the 34ch rail's inner width (padding included) by construction.
test fn witness_issue_assign_form_fits_the_rail() -> Bool {
  fx_emitted_property(selector: ".site-choice-rich", property: "display", value: "block")
    && fx_emitted_property(selector: ".site-choice-rich", property: "width", value: "100%")
    && fx_emitted_property(selector: ".issue-assign-input", property: "min-width", value: "0")
    && fx_emitted_property(selector: ".issue-assign-input", property: "width", value: "100%")
    && fx_emitted_property(selector: ".issue-rail", property: "flex", value: "0 1 34ch")
}

// ── The profile-bound assignee identity (owner ask 2026-09-28) ──────────────────────────────────
// THE FIXTURE PROFILE: the store record a completed login would have upserted for the fixture
// human principal — a real name, the email, and the Google photo URI.
fn fixture_human_profile() -> PrincipalProfile {
  PrincipalProfile {
    principal: fixture_human_ref(),
    name: Present { value: "Fixture Viewer" },
    email: Present { value: "viewer@gunb.ai" as Email },
    picture: Present { value: Uri { scheme: Https, locator: "lh3.googleusercontent.com/a/fixture-picture" as NonEmptyStr } },
    updated_at: "2026-09-28T00:00:00Z",
    source: ProfileSourceGoogleOidcLogin,
  }
}

fn fixture_stranger_ref() -> gunbc.principal_projection.PrincipalRef {
  gunbc.principal_projection.PrincipalRef { authority: "google-oidc" as NonEmptyStr, namespace: "accounts" as NonEmptyStr, subject: "sub-stranger" as NonEmptyStr }
}

fn fixture_assignee_chip_html(holder: gunbc.roadmap.roadmap_event_log.EventPrincipal, profiles: List<PrincipalProfile>) -> String {
  match try_serialize_html_source(node: Element { tag: "span", attributes: [], children: issue_assignee_chip_node(holder: holder, profiles: profiles) }) {
    EmitOk { html } => html
    EmitRejected { reason: _ } => ""
  }
}

// THE ASSIGNEE CHIP under the profile binding: a KNOWN principal (the store names them) renders
// the email as the visible issue-assignee-text beside the chip, the title carries "name — email",
// the initials come from the display name, and the picture resolves the avatar standing; an
// UNKNOWN principal — an empty roster (the read failed or the store has no record) or a roster
// naming a DIFFERENT principal — renders EXACTLY the pre-profile fallback: the chip alone with
// the absent standing, the label title, no text span.
test fn witness_assignee_chip_renders_the_profile_identity_when_known() -> Bool {
  let known = fixture_assignee_chip_html(holder: fixture_human_principal(), profiles: [fixture_human_profile()])
  let unknown = fixture_assignee_chip_html(holder: fixture_human_principal(), profiles: [])
  let stranger = fixture_assignee_chip_html(holder: gunbc.roadmap.roadmap_event_log.EventPrincipalAuthenticated { ref: fixture_stranger_ref() }, profiles: [fixture_human_profile()])
  string_contains(s: known, pattern: "<img src=\"https://lh3.googleusercontent.com/a/fixture-picture\"")
    && string_contains(s: known, pattern: "class=\"issue-assignee-text\">viewer@gunb.ai</span>")
    && string_contains(s: unknown, pattern: "— unknown profile")
    && !string_contains(s: unknown, pattern: "issue-assignee-text")
    && string_contains(s: stranger, pattern: "— unknown profile")
    && !string_contains(s: stranger, pattern: "issue-assignee-text")

}

// THE DETAIL PAGE carries the roster on the decided row: the rail's assignee chip and the
// return-to chip both project the stored identity (the page-level half of the chip law; the
// roster reaches the row read-once from the render entry — gunbc.roadmap_serve for the detail
// route, gunbc.roadmap_served_observation for the daily page).
