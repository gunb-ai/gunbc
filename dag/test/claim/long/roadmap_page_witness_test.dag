  try_serialize_html_source(node: fx_authority_subtree_daily_page(ids: fx_live_project_ids()))
}

fn depth_chain_html(fuel: Int) -> HtmlEmitResult {
  let parent = fx_authored(identity: "rnfx_716835YJMPRW9JAC4H1Z", id: "p", done: false, content: "parent-node")
  let child = fx_authored(identity: "rnfx_DY971T4PDGRTPY6WDHDR", id: "c", done: false, content: "child-node-title")
  let edge = RoadmapEdge { child: child.node, parent: parent.node }
  try_serialize_html_source(node: nodes_ul(items: [parent], nodes: [parent, child], edges: [edge], merged: [], fuel: fuel,
    launch: gunbc.roadmap_page.page_launch_context(doc: launch_fixture_doc(nodes: [parent, child], edges: [edge]), merged: [], launch: dispatch_doc_standing())))
}

fn bold_title_html() -> HtmlEmitResult {
  let rn = fx_authored(identity: "rnfx_4JKJ1ZMAYSR30YJW8T8B", id: "bold1", done: false, content: "**bold** item")
  try_serialize_html_source(node: nodes_ul(items: [rn], nodes: [rn], edges: [], merged: [], fuel: 0,
    launch: gunbc.roadmap_page.page_launch_context(doc: launch_fixture_doc(nodes: [rn], edges: []), merged: [], launch: dispatch_doc_standing())))
}

test fn witness_bold_title_renders_strong() -> Bool {
  match bold_title_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "<strong>bold</strong>")
        && !string_contains(s: h, pattern: "**")
  }
}

test fn witness_depth_cap_fails_honest() -> Bool {
  match depth_chain_html(fuel: 0) {
    EmitRejected { reason: _ } => false
    EmitOk { html: truncated } =>
      match depth_chain_html(fuel: 1) {
        EmitRejected { reason: _ } => false
        EmitOk { html: expanded } =>
          string_contains(s: truncated, pattern: "depth limit")
            && !string_contains(s: truncated, pattern: "child-node-title")
            && string_contains(s: expanded, pattern: "child-node-title")
            && !string_contains(s: expanded, pattern: "depth limit")
      }
  }
}

data dispatch_doc_standing_note: String = "RLM-1: the dispatch fixtures render against a fabricated CLEAR host standing (actuating instance, transition clear, revision converged, no live sessions, ManualReady), so what the button shows is the launch admission's verdict over the NODE alone. The unobserved static standing would refuse every row at the instance gate and hide the node-level distinctions these witnesses exist to pin."

fn dispatch_doc_standing() -> LaunchHostStanding {
  launch_fixture_standing_clear(mode: ManualReady)
}

fn dispatch_doc_html_for(rn: RoadmapNode) -> HtmlEmitResult {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  try_serialize_html_source(node: roadmap_page_launch(doc: doc, merged: [], launch: dispatch_doc_standing()))
}

// THE ROW CLAIMS SUPPLY THE STYLESHEET; ONE CLAIM STILL DERIVES IT (DESIGN section 3 pairing).
// Everything these claims assert lives in the BODY -- a button, its wire label, a disclosure block --
// and the head's style text reaches none of it. Deriving roadmap_css() to read a button cost 157,986
// of each claim's ~163,000 eval steps. witness_ready_node_doc_emits_button_and_external_script is
// deliberately left on roadmap_page_launch above: it is the claim that still renders a page through
// the REAL stylesheet on the real fold, so the integration cannot be deleted without a red, and it
// asserts the ROUTE (the external script the live page emits) rather than only a shape.
data supplied_stylesheet_note: String = "A stylesheet no assertion reads is an input, not a subject. The supplied text is a recognizable sentinel rather than empty so that a claim accidentally asserting on head chrome reds loudly instead of matching the empty string."

fn supplied_stylesheet() -> SiteStyles { site_styles(rules: []) }

fn dispatch_doc_html_supplied(rn: RoadmapNode) -> HtmlEmitResult {
  dispatch_doc_html_supplied_with_merged(rn: rn, merged: [])
}

fn dispatch_doc_html_supplied_with_merged(rn: RoadmapNode, merged: List<Int>) -> HtmlEmitResult {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  try_serialize_html_source(node: roadmap_page_launch_with_stylesheet(doc: doc, merged: merged, launch: dispatch_doc_standing(), stylesheet: supplied_stylesheet()))
}

fn dispatch_doc_html_for_with_merged(rn: RoadmapNode, merged: List<Int>) -> HtmlEmitResult {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  try_serialize_html_source(node: roadmap_page_launch(doc: doc, merged: merged, launch: dispatch_doc_standing()))
}

// The ready fixture carries the launch canary's PARENT id: the centering gate (operator ruling
// 2026-09-19, gunbc.roadmap.roadmap_centering declared_node_centerings) refuses any id its roster
// does not name before the dependency and capacity gates run, so a fixture-minted id would read
// back centering_absent rather than the admission this witness's subject is about. The canary ids
// are the admission's owned synthetic graph, rostered for exactly this use (the same pattern as
// test.claim.roadmap.roadmap_launch_admission_witness rlm_ready_node).
fn ready_dispatch_node() -> RoadmapNode {
  launch_fixture_with_contract(rn: fx_authored_wi(identity: "rnfx_7KPP33Y7P6BH9CBVKZ03", id: "roadmap-launch-canary",
    done: false,
    content: "dispatch-me",
    repo: "gunbc"))
}

fn unsized_open_dispatch_node() -> RoadmapNode {
  fx_authored(identity: "rnfx_324RFH775DGZZMVETPT6", id: "disp-unsized", done: false, content: "observe-only")
}

fn signed_off_dispatch_node() -> RoadmapNode {
  let base = ready_dispatch_node()
  RoadmapNode {
    identity: "rnfx_08P5JSFSS1NH1YY20PWV" as RoadmapNodeIdentity,
    node: base.node,
    line: base.line,
    carriers: base.carriers,
    dispatch: base.dispatch,
    execution: base.execution,
    owner: base.owner,
    signoff: fx_signed(by: "op", works: RedControlExecuted { witness_module: "test.fixture", witness_fn: "fixture_red_control", executed_on: "2026-07-28" }, scope_equivalent: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] }, as_expected: true),
    parent: none,
    centering: none,
  }
}

fn dispatch_doc_page(rn: RoadmapNode) -> Fragment {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  roadmap_page_launch(doc: doc, merged: [], launch: dispatch_doc_standing())
}

data server_zero_furniture_note: String = "The attention rule's server half (A2): a rendered row carries NO workflow furniture — no pre-rendered stage chips, no lamp strip, no hidden progress container, no 'waiting' text. Activity DOM exists only when the client paints it from the decided /workflow.json view of a live attempt. The former version of this witness pinned the seven server-rendered pending chips as a POSITIVE; the same patterns are now the discriminating negatives, so reintroducing preloaded furniture reds here."

// THIS IS THE CLAIM THAT RUNS THE REAL PAGE FOLD (DESIGN section 3 pairing obligation). The three
// row claims below supply the stylesheet at roadmap_page_launch_with_stylesheet; this one renders
// through roadmap_page_launch, which derives it, and the last pin ASSERTS THE ROUTE rather than a
// shape: the head must carry the stylesheet gunbc.roadmap_style actually produces, cited by calling
// the producer instead of spelling any of its bytes (DESIGN section 3 -- cite the symbol). Stop
// passing roadmap_css() into the page and this reds, which is exactly what makes supplying it in
// the sibling claims a hypothesis about a boundary rather than a hole in the evidence.
test fn witness_ready_node_doc_emits_button_and_external_script() -> Bool {
  match dispatch_doc_html_for(rn: ready_dispatch_node()) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "<button class=\"dispatch-btn action-primary\"")
        && string_contains(s: h, pattern: "data-availability=\"available\"")
        && string_contains(s: h, pattern: "data-node=")
        && !string_contains(s: h, pattern: "workflow-progress")
        && string_contains(s: h, pattern: roadmap_css())
        && !string_contains(s: h, pattern: site_styles_css(styles: supplied_stylesheet()))
        && !string_contains(s: h, pattern: "data-workflow-stage=")
        && !string_contains(s: h, pattern: "workflow-strip")
        && !string_contains(s: h, pattern: "workflow-lamp")
        && !string_contains(s: h, pattern: "class=\"node-activity\"")
        && !string_contains(s: h, pattern: "class=\"taskbar-fill\"")
        && string_contains(s: h, pattern: "<script src=\"/assets/roadmap-dispatch.js\"")
        && !string_contains(s: h, pattern: "querySelectorAll")
        && !string_contains(s: h, pattern: "j.status")
  }
}

data client_reads_decided_activity_note: String = "A2 flip of the belt-B contract pins: the client consumes the DECIDED activity object (attempt.activity — arm, attention, summary, evidence) and the segment roster; the former positives provider_activity / workflow_status / remaining_obligations are now the discriminating NEGATIVES, because a client that re-derives a summary or a remaining count from the raw fields is a second projection authority. The segments receiver is pinned in its grouped spelling — (attempt.segments || []).forEach — the exact shape whose ungrouped form was the 2026-08-01 silent no-op."

test fn witness_dispatch_asset_reads_belt_b_status_contract() -> Bool {
  let js = dispatch_client_js_source()
  string_contains(s: js, pattern: "fetch('/dispatch/")
    && string_contains(s: js, pattern: "fetch('/workflow.json')")
    && string_contains(s: js, pattern: "attempt.activity")
    && string_contains(s: js, pattern: "av.arm")
    && string_contains(s: js, pattern: "av.attention")
    && string_contains(s: js, pattern: "(attempt.segments || []).forEach")
    && !string_contains(s: js, pattern: "provider_activity")
    && !string_contains(s: js, pattern: "workflow_status")
    && !string_contains(s: js, pattern: "remaining_obligations")
    && string_contains(s: js, pattern: "gunbcRefreshWorkflow().finally")
    && string_contains(s: js, pattern: "s === 'spawned' ? 'ok'")
    && string_contains(s: js, pattern: "s === 'already_live' ? 'ok'")
    && all(
      belt_dispatch_all_status_labels(),
      label => string_contains(s: js, pattern: join(["'", label, "'"], "")),
    )
    && !string_contains(s: js, pattern: "j.node)")
}

test fn witness_page_script_census_clean() -> Bool {
  page_script_census(page: dispatch_doc_page(rn: ready_dispatch_node())).length() == 0
}

fn hand_inline_script_page() -> Fragment {
  Element { tag: "body", attributes: [], children: [
    dispatch_client_script(),
    Element { tag: "script", attributes: [], children: [ FragmentText { content: "alert('rogue')" } ] },
  ] }
}

test fn witness_inline_hand_script_reds() -> Bool {
  let v = page_script_census(page: hand_inline_script_page())
  v.length() == 1 && all(v, x => x.kind == "inline-js" && x.detail == "alert('rogue')")
}

fn rogue_src_script_page() -> Fragment {
  Element { tag: "body", attributes: [], children: [
    dispatch_client_script(),
    Element { tag: "script", attributes: [ attr(name: "src", value: "https://evil.example/x.js" ) ], children: [] },
  ] }
}

test fn witness_rogue_src_script_reds() -> Bool {
  let v = page_script_census(page: rogue_src_script_page())
  v.length() == 1 && all(v, x => x.kind == "unknown-src")
}

test fn witness_signed_off_node_doc_has_no_button() -> Bool {
  match dispatch_doc_html_for(rn: signed_off_dispatch_node()) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      !string_contains(s: h, pattern: "<button class=\"dispatch-btn")
  }
}

// RLM-1: a review row is NOT relaunchable by an ordinary click. The button renders, disabled, carrying
// the admission's wire label -- the same word POST /dispatch answers -- and no override arm exists.
test fn witness_merged_pr_is_review_evidence_not_acceptance() -> Bool {
  let node = launch_fixture_with_contract(rn: fx_derivable_wi(identity: "rnfx_0RXWPCEK3N82T9871CXP", id: "disp-review",
    prs: [7301],
    title: "review-me",
    description: "",
    repo: "gunbc"))
  match dispatch_doc_html_supplied_with_merged(rn: node, merged: [7301]) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "class=\"status status-review\"")
        && string_contains(s: h, pattern: "<button class=\"dispatch-btn action-secondary\"")
        && string_contains(s: h, pattern: "data-availability=\"unavailable\"")
        && string_contains(s: h, pattern: "data-launch=\"not_ready\"")
        && string_contains(s: h, pattern: "disabled=\"\"")
        && !string_contains(s: h, pattern: "data-availability=\"override\"")
  }
}

// RLM-1: the open row's manual out-of-order dispatch is GONE; the button is disabled carrying
// LaunchDispatchBindingMissing. The node refuses because it has NO DISPATCH BINDING, which is a
// fact about its WorkItemDispatch and not about a size -- sizing is derived now and this row
// never had a cell to be missing.
test fn witness_undispatchable_open_node_refused_dispatch_binding_missing() -> Bool {
  match dispatch_doc_html_supplied(rn: unsized_open_dispatch_node()) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "class=\"workflow-controls\"")
        && string_contains(s: h, pattern: "<button class=\"dispatch-btn action-secondary\"")
        && string_contains(s: h, pattern: "data-launch=\"not_ready\"")
        && string_contains(s: h, pattern: "disabled=\"\"")
  }
}

data supporting_facts_disclosure_note: String = "The A1 row-reduction wall (presentation recon, operator-signed 2026-08-01): the head row carries the row's PRIMARY facts only — status, title, state badges, the dependency line — plus the actuator; owner, the repository, any derived sizing cell, and carrier links are SUPPORTING facts and render inside the disclosure's item-facts block. The pin below expects a repo fact and NO sizing fact: sizing is derived now (gunbc.roadmap_sizing) and the deriver is a stub that refuses, so the badge the fused NodeSizing used to render is absent rather than empty — a sizing span reappearing here means the deriver started answering, which is gunbc.rung_drop.roadmap_sizing_authored_to_derived retiring. Both pins are exact-shape over a constructed fixture: a supporting fact reappearing in node-mid reds the first, the facts block dropping (rather than demoting) the fact reds the second. A row with facts but no body still discloses under the 'facts' summary label, so demotion never becomes deletion."

test fn witness_supporting_facts_live_in_disclosure_not_head() -> Bool {
  match dispatch_doc_html_supplied(rn: ready_dispatch_node()) {
