  gunbc.roadmap_page.roadmap_page(doc: doc, merged: [])
}

data server_zero_furniture_note: String = "The attention rule's server half (A2): a rendered row carries NO workflow furniture — no pre-rendered stage chips, no lamp strip, no hidden progress container, no 'waiting' text. Activity DOM exists only when the client paints it from the decided /workflow.json view of a live attempt. The former version of this witness pinned the seven server-rendered pending chips as a POSITIVE; the same patterns are now the discriminating negatives, so reintroducing preloaded furniture reds here."

test fn witness_ready_node_doc_emits_button_and_external_script() -> Bool {
  let h = dispatch_doc_html_for(rn: ready_dispatch_node())
  string_contains(s: h, pattern: "<button class=\"dispatch-btn action-primary\"")
    && string_contains(s: h, pattern: "data-availability=\"available\"")
    && string_contains(s: h, pattern: "data-node=")
    && !string_contains(s: h, pattern: "workflow-progress")
    && !string_contains(s: h, pattern: "data-workflow-stage=")
    && !string_contains(s: h, pattern: "workflow-strip")
    && !string_contains(s: h, pattern: "workflow-lamp")
    && !string_contains(s: h, pattern: "class=\"node-activity\"")
    && string_contains(s: h, pattern: "<script src=\"/assets/roadmap-dispatch.js\"")
    && !string_contains(s: h, pattern: "querySelectorAll")
    && !string_contains(s: h, pattern: "j.status")
}

data client_reads_decided_activity_note: String = "A2 flip of the belt-B contract pins: the client consumes the DECIDED activity object (attempt.activity — arm, attention, summary, evidence) and the segment roster; the former positives provider_activity / workflow_status / remaining_obligations are now the discriminating NEGATIVES, because a client that re-derives a summary or a remaining count from the raw fields is a second projection authority. The segments receiver is pinned in its grouped spelling — (attempt.segments || []).forEach — the exact shape whose ungrouped form was the 2026-08-01 silent no-op."

test fn witness_dispatch_asset_reads_belt_b_status_contract() -> Bool {
  let js = gunbc.roadmap_component.dispatch_client_js_source()
  string_contains(s: js, pattern: "fetch('/dispatch/")
    && string_contains(s: js, pattern: "fetch('/workflow.json')")
    && string_contains(s: js, pattern: "attempt.activity")
    && string_contains(s: js, pattern: "av.arm")
    && string_contains(s: js, pattern: "av.attention")
    && string_contains(s: js, pattern: "(attempt.segments || []).forEach")
    && !string_contains(s: js, pattern: "provider_activity")
    && !string_contains(s: js, pattern: "workflow_status")
    && !string_contains(s: js, pattern: "remaining_obligations")
    && string_contains(s: js, pattern: "gunbcRefreshWorkflow().finally")
    && string_contains(s: js, pattern: "s === 'spawned' ? 'ok'")
    && string_contains(s: js, pattern: "s === 'already_live' ? 'ok'")
    && all(
      gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels(),
      label => string_contains(s: js, pattern: join(["'", label, "'"], "")),
    )
    && !string_contains(s: js, pattern: "j.node)")
}

test fn witness_page_script_census_clean() -> Bool {
  gunbc.roadmap_page.page_script_census(page: dispatch_doc_page(rn: ready_dispatch_node())).length() == 0
}

fn hand_inline_script_page() -> std.markup.Fragment {
  std.markup.Element { tag: "body", attributes: [], children: [
    gunbc.roadmap_page.dispatch_client_script(),
    std.markup.Element { tag: "script", attributes: [], children: [ std.markup.FragmentText { content: "alert('rogue')" } ] },
  ] }
}

test fn witness_inline_hand_script_reds() -> Bool {
  let v = gunbc.roadmap_page.page_script_census(page: hand_inline_script_page())
  v.length() == 1 && all(v, x => x.kind == "inline-js" && x.detail == "alert('rogue')")
}

fn rogue_src_script_page() -> std.markup.Fragment {
  std.markup.Element { tag: "body", attributes: [], children: [
    gunbc.roadmap_page.dispatch_client_script(),
    std.markup.Element { tag: "script", attributes: [ std.markup.attr(name: "src", value: "https://evil.example/x.js" ) ], children: [] },
  ] }
}

test fn witness_rogue_src_script_reds() -> Bool {
  let v = gunbc.roadmap_page.page_script_census(page: rogue_src_script_page())
  v.length() == 1 && all(v, x => x.kind == "unknown-src")
}

test fn witness_signed_off_node_doc_has_no_button() -> Bool {
  let h = dispatch_doc_html_for(rn: signed_off_dispatch_node())
  !string_contains(s: h, pattern: "<button class=\"dispatch-btn")
}

test fn witness_merged_pr_is_review_evidence_not_acceptance() -> Bool {
  let node = gunbc.roadmap_authority.derivable_wi(identity: "rnfx_0RXWPCEK3N82T9871CXP", id: "disp-review",
    prs: [7301],
    title: "review-me",
    description: "",
    intricacy: gunbc.roadmap_model.IntricacyLow,
    volume: gunbc.roadmap_model.VolumeSmall,
    repo: "gunbc")
  let h = dispatch_doc_html_for_with_merged(rn: node, merged: [7301])
  string_contains(s: h, pattern: "class=\"status status-review\"")
    && string_contains(s: h, pattern: "<button class=\"dispatch-btn action-secondary\"")
    && string_contains(s: h, pattern: "data-availability=\"override\"")
}

test fn witness_unsized_open_node_keeps_manual_dispatch() -> Bool {
  let h = dispatch_doc_html_for(rn: unsized_open_dispatch_node())
  string_contains(s: h, pattern: "class=\"workflow-controls\"")
    && string_contains(s: h, pattern: "<button class=\"dispatch-btn action-secondary\"")
}

data supporting_facts_disclosure_note: String = "The A1 row-reduction wall (presentation recon, operator-signed 2026-08-01): the head row carries the row's PRIMARY facts only — status, title, state badges, the dependency line — plus the actuator; owner, sizing codes, and carrier links are SUPPORTING facts and render inside the disclosure's item-facts block. Both pins are exact-shape over a constructed fixture: a supporting fact reappearing in node-mid reds the first, the facts block dropping (rather than demoting) the fact reds the second. A row with facts but no body still discloses under the 'facts' summary label, so demotion never becomes deletion."

test fn witness_supporting_facts_live_in_disclosure_not_head() -> Bool {
  let h = dispatch_doc_html_for(rn: ready_dispatch_node())
  string_contains(s: h, pattern: "<span class=\"node-mid\"><span class=\"title\">dispatch-me</span></span>")
    && string_contains(
      s: h,
      pattern: "<details class=\"item-detail\"><summary><span class=\"disclosure-mark\">›</span>facts</summary><div class=\"item-body\"><div class=\"item-facts\"><span class=\"sizing\">i:low v:small gunbc</span></div></div></details>")
    && !string_contains(s: h, pattern: "class=\"title\">dispatch-me</span><span class=\"sizing\"")
}

fn blocked_dispatch_workspace_html() -> String {
  let policy_blocker = gunbc.roadmap_authority.authored(identity: "rnfx_ENDCMSJ7A7XTXK91KKZD", id: "disp-policy-blocker",
    done: false,
    content: "policy prerequisite")
  let model_blocker = gunbc.roadmap_authority.authored(identity: "rnfx_2R3ZJWEHE8BDYVGJ82Z9", id: "disp-model-blocker",
    done: false,
    content: "model prerequisite")
  let blocked = gunbc.roadmap_authority.authored_wi(identity: "rnfx_VRBYQ6ZVRKNMCNVXFCG6", id: "disp-blocked",
    done: false,
    content: "blocked work",
    intricacy: gunbc.roadmap_model.IntricacyLow,
    volume: gunbc.roadmap_model.VolumeSmall,
    repo: "gunbc")
  let edges = [
    gunbc.roadmap_model.RoadmapEdge { child: blocked.node, parent: policy_blocker.node },
    gunbc.roadmap_model.RoadmapEdge { child: blocked.node, parent: model_blocker.node },
  ]
  let sec = gunbc.roadmap_document.RoadmapSection {
    title: "Belt",
    elements: [ gunbc.roadmap_model.section_group(label: "", nodes: [policy_blocker, model_blocker, blocked], edges: edges) ],
  }
  let doc = gunbc.roadmap_document.RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  match extdeps.languages.html.try_serialize_html_source(node: gunbc.roadmap_page.roadmap_daily_workspace_page(doc: doc, merged: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_upcoming_node_keeps_manual_out_of_order_dispatch() -> Bool {
  let h = blocked_dispatch_workspace_html()
  string_contains(s: h, pattern: "class=\"frontier-bucket frontier-upcoming\"")
    && string_contains(s: h, pattern: "data-node=\"disp-blocked\"")
    && string_contains(s: h, pattern: "class=\"workflow-controls\"")
    && string_contains(s: h, pattern: "<button class=\"dispatch-btn action-secondary\"")
    && string_contains(s: h, pattern: "data-availability=\"override\"")
}

test fn witness_upcoming_node_preserves_multi_parent_dependencies() -> Bool {
  string_contains(
    s: blocked_dispatch_workspace_html(),
    pattern: "requires all: disp-policy-blocker, disp-model-blocker",
  )
}

