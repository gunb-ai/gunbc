// THE COMPOSER: a native text/plain POST to the comment route — key, csrf, and expected_revision
// ride as hidden fields, the body LAST (markdown freely carries newlines), the submit wears no
// .issue-action class (the client's bodyless bind must not race the native submit). The composer's
// wire shape and its stable operation key + csrf fields are Cut 1's (the urlencoded codec owns the
// text/plain CR-strip repair it superseded — the 2026-09-28 'CSRF mismatch' defect's full fix).
// .issue-action class (the client's bodyless bind must not race the native submit).
test fn witness_issue_comment_composer_posts_urlencoded_with_stable_key_and_csrf() -> Bool {
  match issue_detail_fixture_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "<form class=\"issue-comment-form\" method=\"post\" enctype=\"application/x-www-form-urlencoded\" action=\"/issue/issue-detail-specimen/comment\">") == 1
        && occurrence_count(s: h, pattern: "name=\"key\" type=\"hidden\"") == 2
        && occurrence_count(s: h, pattern: "name=\"csrf\" type=\"hidden\"") == 2
        && occurrence_count(s: h, pattern: "name=\"expected_revision\" type=\"hidden\"") == 2
        && string_contains(s: h, pattern: "<textarea name=\"body\" class=\"issue-comment-input\" placeholder=\"Write a comment. Type @ to mention a person or group.\"")
        && occurrence_count(s: h, pattern: "class=\"issue-comment-submit issue-action-text\" type=\"submit\"") == 1
        && occurrence_count(s: h, pattern: "issue-action\" type=\"button\"") == 0
  }
}

// THE PUBLICATION HANDOFF (owner mandate control 9): a published attempt result renders ONE compact
// automated entry in the Comments stream — fabric's service avatar, the PR and head, and the
// merge owner the fold reassigned to (the stored return_to) — while the standing the page reads
// becomes ready for review and the History tab carries the raw event.
fn fx_handoff_events() -> List<gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope> {
  let claim = fx_event_envelope(id: "ho-1", at: "2026-09-25T10:00:00Z", kind: gunbc.roadmap.roadmap_event_log.Claimed { assignee: fixture_fabric_principal(), return_to: fixture_human_principal() })
  let pub = gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
    id: "ho-2" as gunbc.roadmap.roadmap_event_log.RoadmapEventId,
    event: gunbc.roadmap.roadmap_event_log.RoadmapEvent {
      node: "issue-detail-specimen" as gunbc.roadmap_model.RoadmapNodeId,
      author: fixture_fabric_principal(),
      parent: Present { value: "ho-1" as gunbc.roadmap.roadmap_event_log.RoadmapEventId },
      kind: gunbc.roadmap.roadmap_event_log.ResultReturned { attempt: "feedfacefeedface" as NonEmptyStr, claim: "ho-1" as gunbc.roadmap.roadmap_event_log.RoadmapEventId, outcome: gunbc.roadmap.roadmap_event_log.ResultPublished { pr: "gunb-ai/gunbc#12210" as NonEmptyStr, head: "52c56a8" as NonEmptyStr } },
      recorded_at: "2026-09-25T11:00:00Z",
    },
  }
  [claim, pub]
}

test fn witness_issue_publication_handoff_renders_the_compact_automated_entry() -> Bool {
  match try_serialize_html_source(node: fx_issue_detail_body(
    view: issue_detail_fixture_view(),
    panel: issue_detail_fixture_panel(),
    observation: gunbc.roadmap_presentation.ObservationsNominal,
