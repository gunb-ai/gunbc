data dispatch_asset_status_contract_note: String = "The dispatch client consumes the belt's LABEL authority, so the discriminating assertion is total coverage of belt_dispatch_all_status_labels() in the emitted band chain — a boolean-ok wire contract cannot satisfy it, and a new belt label that the client cannot band reds here. The former blob-wide `!j.ok` negative did not scope to the dispatch handler: the separately-modeled POST /cleanup/ route legitimately answers a boolean, so scanning the whole asset for `j.ok` reported a contract violation that the dispatch path never committed."

// Rendered UNFOCUSED deliberately. These claims are about ROW MARKUP, not about which lanes appear; leaving them on the focused page made them silently depend on the focus setting and go red when a lane they sampled was hidden. The served page's own focus behaviour is covered by roadmap_focus_witness_test, where it belongs.
fn authority_page_html() -> HtmlEmitResult {
  try_serialize_html_source(node: roadmap_page_for_doc(doc: gunbc.roadmap_authority.roadmap_authority()))
}

data header_pin_a1_note: String = "Superseded 2026-10-04 by owner request: use the gunb logo linked to the workspace, preserving page-name and labeled controls. Historical ruling: The header assertions moved TWICE at A1 (presentation recon, operator feedback 2026-08-01). First the content: the unselected site mark (candidate A, whose aria-label said gunb.ai on a gunbc tool surface) is replaced by the text wordmark, the h1 carries the PAGE name alone so it never restates the wordmark, and both toggles are server-rendered with visible content and an accessible name — the theme toggle with its parse-time-true initial state ('theme · auto': no data-theme exists until the client program runs, so prefers-color-scheme governs, which IS auto), the sound toggle with its name only (its state has no parse-time truth; see gunbc.roadmap_page.sound_toggle_placement_note). Second the SHAPE of the assertion: the former whole-header byte pin asserted the accidental composition — element order and adjacency that nobody decided — so it redded on any reorder while proving nothing semantic. Each assertion below is now ONE claim (wordmark exists; page-name h1 exists; each control is labeled before JavaScript). Header composition is deliberately NOT pinned: the A1 list layout is a provisional renderer, per the PR's own scope statement."

// The /roadmap fold over the authority's own multi-parent rows (the shared subtree fixture): the page
// chrome and the row markup are claims about the fold, so they read a projection holding real rows
// rather than paying for every row of the whole authority.
fn authority_subtree_page_html() -> HtmlEmitResult {
  try_serialize_html_source(node: fx_authority_subtree_roadmap_page(ids: fx_multi_parent_ids()))
}

fn empty_doc_html() -> HtmlEmitResult {
  let empty = RoadmapDocument { preamble: [], lead_lanes: [], sections: [] }
  try_serialize_html_source(node: roadmap_page(doc: empty, merged: []))
}

test fn witness_empty_doc_is_minimal_shell() -> Bool {
  match empty_doc_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      starts_with(s: h, prefix: "<html lang=\"en\"><head><meta charset=\"utf-8\"")
        && string_contains(s: h, pattern: "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"")
        && string_contains(s: h, pattern: "<title>gunbc — roadmap</title>")
        && string_contains(s: h, pattern: "<a class=\"site-brand\" href=\"/\" aria-label=\"gunb · workspace\"")
        && string_contains(s: h, pattern: "<h1>roadmap</h1>")
        && string_contains(s: h, pattern: "<button class=\"sound-toggle\" type=\"button\">sound</button>")
        && string_contains(s: h, pattern: "<button class=\"theme-toggle\" type=\"button\">theme · auto</button>")
        && string_contains(s: h, pattern: "<main class=\"roadmap\"></main></body></html>")
        && occurrence_count(s: h, pattern: "<script src=\"/assets/site.js\"") == 1
  }
}

test fn witness_authority_differs_from_empty() -> Bool {
  match authority_page_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: authority } =>
      match empty_doc_html() {
        EmitRejected { reason: _ } => false
        EmitOk { html: empty } => !(authority == empty)
      }
  }
}

test fn witness_authority_shows_finish_line_progress() -> Bool {
  match authority_page_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: authority } =>
      match empty_doc_html() {
        EmitRejected { reason: _ } => false
        EmitOk { html: empty } =>
          string_contains(s: authority, pattern: "class=\"finish-line-progress\"")
            && string_contains(s: authority, pattern: "v1 exit: four finish lines")
            && string_contains(s: authority, pattern: " of 4 complete")
            && string_contains(s: authority, pattern: "Compiler fixed point")
            && string_contains(s: authority, pattern: "Interpreter deleted")
            && string_contains(s: authority, pattern: "Products v1-free")
            && string_contains(s: authority, pattern: "Zero hand-maintained Rust")
            && string_contains(s: authority, pattern: "v1-products-v1-free")
            && !string_contains(s: authority, pattern: " declared · ")
            && !string_contains(s: authority, pattern: "class=\"three-gate-progress\"")
            && !string_contains(s: empty, pattern: "class=\"finish-line-progress\"")
      }
  }
}

data finish_line_variant_fixture_note: String = "The accepted variant is proven by FIXTURE, not by live-population absence (A1; the former !contains('finish-line-accepted') negative both redded on the stylesheet — which now legitimately carries the .finish-line-accepted rule — and was the live-state transcription class the operator ruled against: it would have reported 'a finish line was accepted', which is news, not a defect). Both reachable variants render from constructed inputs: the same spec accepted and not accepted, so the state class, the chip word, and their divergence are pinned independent of today's roadmap population."

test fn witness_finish_line_variants_render_from_fixture() -> Bool {
  let s = first(v1_exit_finish_lines()).value
  match try_serialize_html_source(node: finish_line_row(spec: s, accepted_ids: [s.node])) {
    EmitRejected { reason: _ } => false
    EmitOk { html: accepted_html } =>
      match try_serialize_html_source(node: finish_line_row(spec: s, accepted_ids: [])) {
        EmitRejected { reason: _ } => false
        EmitOk { html: active_html } =>
          string_contains(s: accepted_html, pattern: "class=\"finish-line finish-line-accepted\"")
            && string_contains(s: accepted_html, pattern: ">accepted<")
            && string_contains(s: active_html, pattern: "class=\"finish-line finish-line-active\"")
            && string_contains(s: active_html, pattern: ">active<")
            && !string_contains(s: active_html, pattern: "finish-line-accepted")
      }
  }
}

data daily_leads_operational_note: String = "The A1 placement wall (presentation recon, operator-signed 2026-08-01): the daily workspace's declared archetype is Operational (gunbc.design.archetype dashboard_archetype), so / may not open with the four strategic finish-line claims — the full narrative block lives on /roadmap only. The 'of 4' magnitude was structural, not a live-population transcription. SUPERSEDED 2026-09-28 by the owner ruling retiring the v1-exit framing from the workspace header: the one-line strip now carries only the readiness count ('N ready now'), and the program view's name reads 'workspace'."

