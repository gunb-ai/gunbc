      string_contains(s: h, pattern: "<span class=\"taskbar-title\">dispatch-me</span>")
        && string_contains(
          s: h,
          pattern: "<details class=\"taskbar-inspect\"><summary>inspect</summary><div class=\"inspect-body\"><div class=\"item-facts\"><span class=\"repo\">gunbc</span></div></div></details>")
        && !string_contains(s: h, pattern: "class=\"sizing\"")
        && !string_contains(s: h, pattern: "class=\"taskbar-title\">dispatch-me</span><span class=\"repo\"")
  }
}

// The blocked child carries the launch canary's FOLLOWUP id for the same reason as
// ready_dispatch_node above: the centering gate runs before the dependencies gate, and only a
// rostered id lets the admission reach the DependenciesBlocked refusal this workspace exists to
// exercise. The parents keep fixture-minted ids -- the dependencies gate asks whether they are
// accepted, never whether they are dispatchable.
fn blocked_dispatch_workspace_html() -> HtmlEmitResult {
  let policy_blocker = fx_authored(identity: "rnfx_ENDCMSJ7A7XTXK91KKZD", id: "disp-policy-blocker",
    done: false,
    content: "policy prerequisite")
  let model_blocker = fx_authored(identity: "rnfx_2R3ZJWEHE8BDYVGJ82Z9", id: "disp-model-blocker",
    done: false,
    content: "model prerequisite")
  let blocked = launch_fixture_with_contract(rn: fx_authored_wi(identity: "rnfx_VRBYQ6ZVRKNMCNVXFCG6", id: "roadmap-launch-canary-followup",
    done: false,
    content: "blocked work",
    repo: "gunbc"))
  let edges = [
    RoadmapEdge { child: blocked.node, parent: policy_blocker.node },
    RoadmapEdge { child: blocked.node, parent: model_blocker.node },
  ]
  let sec = RoadmapSection {
    title: "Belt",
    elements: [ section_group(label: "", nodes: [policy_blocker, model_blocker, blocked], edges: edges) ],
  }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  try_serialize_html_source(node: roadmap_page_launch_with_stylesheet(doc: doc, merged: [], launch: dispatch_doc_standing(), stylesheet: supplied_stylesheet()))
}

// RLM-1 red control (d, page half): the blocked child renders NO ordinary Launch — the button is
// disabled and carries the admission's DependenciesBlocked label naming the exact parents; the
// override arm that used to make it operable is gone. RENDER REPOINTED 2026-09-25 with the button
// retirement: the tracker table and detail pages render no dispatch actuator at all (owner:
// "scrap the button stuff ... just copy buganizer"), so the admission's page-render half lives on
// the full-roadmap surface, whose taskbar rows still carry the control.
test fn witness_blocked_node_dispatch_refused_dependencies_blocked() -> Bool {
