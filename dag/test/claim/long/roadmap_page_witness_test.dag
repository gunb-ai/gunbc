}

fn issue_detail_fixture_view_with_brief(lifecycle: gunbc.roadmap_presentation.WorkLifecycle, control_label: String = "red control") -> gunbc.roadmap_presentation.WorkRowView {
  gunbc.roadmap_presentation.WorkRowView {
    node_id: "issue-detail-specimen",
    headline: "Specimen issue",
    summary: none,
    lifecycle: lifecycle,
    scheduling: gunbc.roadmap_presentation.SchedulingReady,
    superseded_by: "",
