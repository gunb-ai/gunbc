// THE PAGE ARCHITECTURE (owner mandate 2026-09-25, docs/plans/issue-page-architecture.md): the
// header carries the slug + title + planning chips ONLY; the tabs read Comments (default) ·
// Dependencies · Work · History; the body splits the panels from the right metadata rail.
test fn witness_issue_detail_page_renders_header_fields_and_tabs() -> Bool {
  match issue_detail_fixture_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "<main class=\"issue-detail\" data-tab=\"comments\">")
        && string_contains(s: h, pattern: "<span class=\"issue-id\">issue-detail-specimen</span>")
        && string_contains(s: h, pattern: "<h1 class=\"issue-detail-title\">Specimen issue</h1>")
        && !string_contains(s: h, pattern: "<span class=\"issue-type-chip\">")
        && occurrence_count(s: h, pattern: "issue-status\"") == 0
        && string_contains(s: h, pattern: "<button class=\"chip chip-on\" type=\"button\" data-tab-chip=\"comments\">")
        && string_contains(s: h, pattern: "<button class=\"chip\" type=\"button\" data-tab-chip=\"dependencies\">")
        && string_contains(s: h, pattern: "<button class=\"chip\" type=\"button\" data-tab-chip=\"work\">")
        && string_contains(s: h, pattern: "<button class=\"chip\" type=\"button\" data-tab-chip=\"history\">")
        && string_contains(s: h, pattern: "<section class=\"panel-comments\">")
        && string_contains(s: h, pattern: "<section class=\"panel-dependencies\">")
        && string_contains(s: h, pattern: "<section class=\"panel-work\">")
        && string_contains(s: h, pattern: "<section class=\"panel-history\">")
        && string_contains(s: h, pattern: "<aside class=\"issue-rail\">")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">assignee</span>")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">status</span>")
        && string_contains(s: h, pattern: "<details class=\"issue-status-detail\"><summary>Active</summary>")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">reporter</span>")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">reporter</span><span class=\"issue-field-value\">not recorded (authored roadmap row)</span>")
        && !string_contains(s: h, pattern: "<span class=\"issue-field-label\">reporter</span><span class=\"issue-field-value\">agent-35</span>")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">component</span>")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">parent</span>")
        && string_contains(s: h, pattern: "href=\"/issue/issue-detail-parent\"")
        && !string_contains(s: h, pattern: "<span class=\"issue-field-label\">standing</span>")
  }
}

// THE WORK TAB: execution history as taskbar rows, NEWEST FIRST — the fixture ledger clocks
// rounds 1..4, and the segment authority (which cannot clock the first round: no predecessor
// epoch) carries steps 2..4, so the rows must read 4,3,2 — each row carrying its decided
// round-kind class. Beneath the rows the tab carries the stage ledger (the pipeline position)
// decided by the same view the bar's disclosure owns.
type SeenSteps {
  seen: Int
  steps: List<String>
}

fn ordered_work_steps(work_section: String) -> List<String> {
  let parts = split(s: work_section, delimiter: "data-step=\"")
  fold(parts, init: SeenSteps { seen: 0, steps: [] }, f: (acc, p) =>
    if acc.seen == 0 {
      SeenSteps { seen: 1, steps: acc.steps }
    } else {
      SeenSteps { seen: acc.seen + 1, steps: concat(acc.steps, [substring(s: p, start: 0, end: 1)]) }
    }).steps
}

test fn witness_issue_work_tab_renders_history_newest_first() -> Bool {
  match issue_detail_fixture_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let work_parts = split(s: h, delimiter: "<section class=\"panel-work\">")
      count(work_parts) == 2
        && ordered_work_steps(work_section: string_at(parts: work_parts, index: 1)) == ["4", "3", "2"]
        && string_contains(s: string_at(parts: work_parts, index: 1), pattern: "taskbar-title\">write</span>")
        && occurrence_count(s: h, pattern: "work-history-step\">round ") == 3
        && string_contains(s: string_at(parts: work_parts, index: 1), pattern: "activity-obligation")
        && string_contains(s: string_at(parts: work_parts, index: 1), pattern: "waiting on Workspace")
  }
}

// The tab mechanics and the stylesheet law, pinned at their contracts: a TAB chip only writes the
// detail root's data-tab, the stylesheet decides which panel shows, and the no-JavaScript default
// is the issue panel — the page ships data-tab="issue" and the issue chip arrives chip-on.
test fn witness_issue_tab_switch_contracts() -> Bool {
  let js = fx_client_group_js(stmts: issue_filter_bind_statements())
  let css = fx_css_rule_blocks()
  string_contains(s: js, pattern: "[data-tab-chip]")
    && string_contains(s: js, pattern: "dataset")
    && string_contains(s: js, pattern: "tab")
    && string_contains(s: css, pattern: ".issue-detail[data-tab=\"comments\"] .panel-dependencies, .issue-detail[data-tab=\"comments\"] .panel-work, .issue-detail[data-tab=\"comments\"] .panel-history { display: none }")
    && string_contains(s: css, pattern: ".issue-detail[data-tab=\"work\"] .panel-comments, .issue-detail[data-tab=\"work\"] .panel-dependencies, .issue-detail[data-tab=\"work\"] .panel-history { display: none }")
}

// DEFECT 1 (owner 2026-09-23): attempt history spilled into the issue table — the client paint
// minted one taskbar-inspect disclosure after EVERY row the wire carried an attempt for, inline
// in the dense table and stacked one-per-member inside project and family rows on the old
// dashboard lanes (fifteen deep). The fix is decided at serve: the dense issue line and the
// member rows carry data-summary-only — the row's whole claim about execution is the latest
// attempt's summary, painted by no one but the server. The client paint must skip these rows,
// and the table region must render zero taskbar-inspect disclosures.
fn fx_summary_only_page_html(stale: Bool) -> HtmlEmitResult {
  try_serialize_html_source(node: gunbc.roadmap_page.roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(
    doc: fx_page_project_doc(),
    merged: [],
    accepted_ids: [],
    withheld: [],
    main_prefix: [],
    attempts: [ completed_attempt_progress(node_id: "page-task-one") ],
    attempts_refused: none,
    standings: StandingsObserved { rows: [
      NodeStandingRow { node_id: "page-task-one", assignment: gunbc.roadmap.roadmap_event_log.IssueAssignmentProjection { holder: Present { value: fixture_human_principal() }, return_to: none }, standing: NodeInProgress { by: fixture_human_principal(), last_note: "working" as NonEmptyStr } },
    ] },
    launch: dispatch_doc_standing(),
    stale_nodes: if stale { ["page-task-one"] } else { [] },
    profiles: [],
    memberships: fixture_nesting_relation(edges: doc_all_edges(doc: fx_page_project_doc())),
    stylesheet: site_styles(rules: [])))
}

fn table_region(html: String) -> String {
  let parts = split(s: html, delimiter: "<div class=\"view-table\">")
  match (split(s: string_at(parts: parts, index: 1), delimiter: "</main>")).first() {
    Present { value: t } => t
    Absent => ""
  }
}

test fn witness_issue_table_is_summary_only_and_stale_attempts_preserve_current_standing() -> Bool {
  match fx_summary_only_page_html(stale: false) {
    EmitRejected { reason: _ } => false
    EmitOk { html: live_h } =>
      match fx_summary_only_page_html(stale: true) {
        EmitRejected { reason: _ } => false
        EmitOk { html: stale_h } =>
          let live_table = table_region(html: live_h)
          let stale_table = table_region(html: stale_h)
          occurrence_count(s: live_table, pattern: "taskbar-inspect") == 0
            && occurrence_count(s: stale_table, pattern: "taskbar-inspect") == 0
            && string_contains(s: li_of_node(html: live_table, node_id: "page-task-one"), pattern: "data-search=\"page task one page-task-one \"")
            && string_contains(s: li_of_node(html: live_table, node_id: "page-task-one"), pattern: "data-summary-only=\"\"")
            && string_contains(s: live_table, pattern: "<span class=\"taskbar-signal issue-status\" title=\"Submission · failed\">Active</span>")
            && !string_contains(s: live_table, pattern: "earlier attempt")
            && !string_contains(s: stale_table, pattern: "earlier attempt")
            && string_contains(s: stale_table, pattern: "<span class=\"taskbar-signal issue-status\" title=\"ready to dispatch\">Active</span>")
      }
  }
}

