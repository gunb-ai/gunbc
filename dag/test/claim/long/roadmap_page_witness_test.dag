test fn witness_css_audition_part_1_laws_hold() -> Bool {
  fx_css_part_holds(css: join(map(audition_sets.skip(n: 1), a => audition_block_css(a: a)), "\n"), rail_widths: 0, grid_templates: 0, token_declarations: 0)
}

test fn witness_css_rule_blocks_laws_hold() -> Bool {
  fx_css_part_holds(css: fx_css_rule_blocks(), rail_widths: 1, grid_templates: 1, token_declarations: 0)
}

test fn witness_css_tail_part_laws_hold() -> Bool {
  fx_css_part_holds(css: fx_css_tail_part(), rail_widths: 0, grid_templates: 0, token_declarations: 0)
}

test fn witness_prominence_and_frame_rules_present_in_css() -> Bool {
  let css = fx_css_rule_blocks()
  string_contains(s: css, pattern: ".dispatch-btn.action-primary, .dispatch-btn.action-secondary { color: var(--text-dim); background: var(--surface); border-color: var(--border) }")
    && string_contains(s: css, pattern: ".dispatch-btn.action-focal { color: var(--band-invite-ink); background: var(--band-invite); border-color: var(--band-invite) }")
    && string_contains(s: css, pattern: "li.node:focus-visible { outline: var(--border-2) solid var(--focus) }")
    && !string_contains(s: css, pattern: "action-live")
    && fx_emitted_property(selector: ".header-inner", property: "display", value: "flex")
    && fx_emitted_property(selector: ".header-inner", property: "align-items", value: "center")
}

