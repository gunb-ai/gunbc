    && string_contains(s: js, pattern: "av.arm")
    && string_contains(s: js, pattern: "av.attention")
    && string_contains(s: js, pattern: "seg.label + ' · ' + seg.state")
    && string_contains(s: js, pattern: "' — ' + seg.detail")
    && string_contains(s: js, pattern: "row.label + ': ' + row.value")
    && string_contains(s: js, pattern: "'inspect'")
    && string_contains(s: js, pattern: "av.bar_signal")
    && string_contains(s: js, pattern: "av.bar_count")
}

data parity_refused_note: String = "The refused arm's parity, post the 2026-09-20 status-surface ruling: the server realization carries the refusal's LABEL as its summary (state word plus the short reason) and keeps the located reason inside a CLOSED activity disclosure — evidence behind disclosure, not an open error dump — and the client no longer auto-opens on the refused arm (the data-auto-opened guard is deleted in both realizations). A refusal whose label or reason failed to reach the surface is the title-only world the anomaly witnesses forbid; a refusal that renders open again is the overwhelming-dump regression this ruling closed."

test fn witness_parity_refused_arm_labels_and_discloses() -> Bool {
  let refused = gunbc.roadmap_presentation.activity_view_from_parts(
    segments: [
      gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.EnvironmentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "" },
      gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused, detail: "turn.completed with process unobserved: no exit was established" },
    ],
    remaining: 6,
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "")
  match parity_row_html(activity: refused) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "data-arm=\"refused\"")
        && string_contains(s: h, pattern: "class=\"taskbar taskbar-error\"")
        && string_contains(s: h, pattern: "<span class=\"taskbar-signal activity-line-error-refusal\" data-rest-signal=\"ready to dispatch\" data-rest-class=\"activity-line-neutral\">Agent · refused</span>")
        && string_contains(s: h, pattern: "Agent · refused — turn.completed with process unobserved: no exit was established")
        && string_contains(s: h, pattern: "class=\"activity-located-reason\"")
        && string_contains(s: h, pattern: "turn.completed with process unobserved: no exit was established")
        && !string_contains(s: h, pattern: " open")
  }
}

// The stale-attempt dim (operator ruling 2026-09-20): a row whose attempt_stale fact is set renders
// the dim class and the machine-readable data-attempt-revision on its li; the same row without the
// fact renders neither. The revision comparison that SETS the fact is witnessed in
// test.claim.roadmap_presentation_witness (stale_attempt_nodes); this pin is the rendering half.
test fn witness_stale_attempt_row_renders_dimmed() -> Bool {
  let stale_view = gunbc.roadmap_presentation.WorkRowView {
    node_id: "parity-stale",
    headline: "Record which generator actually produced each result",
    summary: none,
    lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
    scheduling: gunbc.roadmap_presentation.SchedulingReady,
    superseded_by: "",
    activity: parity_specimen_activity(),
    action: gunbc.roadmap_presentation.action_view(
      lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
      admission: LaunchAdmitted { identity: launch_fixture_identity(node_id: "parity-stale", cause: Operator, mode: ManualReady) }),
    supporting_facts: [],
    disclosure: gunbc.roadmap_presentation.NoDisclosure,
    rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    worker_alive: false,
    assignment: none,
    standing: none,
    attempt_stale: true,
    profiles: [],
  }
  match try_serialize_html_source(node: Element {
    tag: "li",
    attributes: gunbc.roadmap_page.node_li_attributes(view: stale_view),
    children: gunbc.roadmap_page.render_task_row(view: stale_view, observation: gunbc.roadmap_presentation.ObservationsNominal),
  }) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "node-attempt-stale")
        && string_contains(s: h, pattern: "data-attempt-revision=\"stale\"")
  }
    && match parity_row_html(activity: parity_specimen_activity()) {
      EmitRejected { reason: _ } => false
      EmitOk { html: h } =>
        !string_contains(s: h, pattern: "node-attempt-stale")
          && !string_contains(s: h, pattern: "data-attempt-revision")
    }
    && string_contains(s: fx_css_rule_blocks(), pattern: ".node-attempt-stale .taskbar-inspect")
}

data a2_hierarchy_closeout_witnesses_note: String = "The A2 hierarchy-closeout receipts (operator gap ruling 2026-08-02; S0 amendments, operator recalibration 2026-08-02), each pinning a decided fact rather than accidental composition: the selection grammar ships in the emitted client asset (selection and activation distinct — interactive elements never move selection through the click channel; Escape clears; exactly the selected row's primary action earns action-focal, the class renamed from action-live because live means sessions/observation elsewhere in this product); selection has KEYBOARD PARITY (rows carry tabindex, keyboard focus is gated on :focus-visible so pointer clicks on inner controls cannot move selection through the focus channel, Enter/Space on the focused row toggles, and every path funnels through the one gunbcSelectRow); the three observation channels join ONE impact region (each channel's located row appends into the shared disclosure and the painter no longer prepends free-standing banners to main); and the stylesheet carries the quiet-rest pair, the action-focal band restore on the family's DERIVED rest-band vars, the li.node:focus-visible outline, and the header's shared composition frame. The axis pins on the dispatch button itself (ready renders action-primary/available; review and out-of-order render action-secondary/override; done and superseded render no button at all) live with the existing per-fixture witnesses above. The action-live spellings below are DISCRIMINATING NEGATIVES: the retired name reappearing means the rename regressed or a second prominence authority stood up."

test fn witness_selection_grammar_ships_in_client_asset() -> Bool {
  let js = fx_client_group_js(stmts: row_selection_bind_statements())
  string_contains(s: js, pattern: "const gunbcClearSelection")
    && string_contains(s: js, pattern: "const gunbcSelectRow")
    && string_contains(s: js, pattern: "classList.add('node-selected')")
    && string_contains(s: js, pattern: ".taskbar .dispatch-btn.action-primary")
    && string_contains(s: js, pattern: "classList.add('action-focal')")
    && string_contains(s: js, pattern: "e.key === 'Escape'")
    && string_contains(s: js, pattern: "closest('summary, button, a, input, select, textarea')")
    && !string_contains(s: js, pattern: "closest('button, a, details, input, select, textarea')")
    && !string_contains(s: js, pattern: "action-live")
}

// The channels' statement groups (the impact preamble, the observation fetch, the workflow fetch)
// are where each of these lines is emitted; the asset-wide negative -- no channel prepends its own
// banner -- rides the client-asset partition, which reads every group.
test fn witness_observation_channels_join_one_impact_region() -> Bool {
  let js = join([
    fx_client_group_js(stmts: observe_impact_preamble_statements()),
    fx_client_group_js(stmts: observation_fetch_statements()),
    fx_client_group_js(stmts: workflow_fetch_statements()),
  ], "\n")
  string_contains(s: js, pattern: "const gunbcObserveImpactBox")
    && string_contains(s: js, pattern: "'workspace-observation client-minted'")
    && string_contains(s: js, pattern: "impactDetail && impactDetail.append(bn)")
    && string_contains(s: js, pattern: "'observe-refused sessions-observe-refused'")
    && string_contains(s: js, pattern: "'observe-refused attempts-observe-refused'")
    && string_contains(s: js, pattern: "'observe-refused workflow-observe-refused'")
}

// THE STYLESHEET, SUPPLIED BY ITS PARTS (DESIGN section 3, a witness discriminates at one interface).
// roadmap_css() is the newline join of the root custom-property blocks, the audition swatch blocks,
// the serialized rules and the reduced-motion block; deriving all of it to read one rule cost every
// claim ~165k steps, ~100k of them the audition blocks no claim here reads. Each claim below reads
// the part that emits its subject, built by the same production functions roadmap_css calls, and
// the per-part claims hold the sheet-wide counts and absences over a partition of every part:
// root blocks, each audition set, every rule's block, and the cycles, carriers and reduced-motion
// tail serialize_rules and roadmap_css append. The sheet's composition itself stays held by the
// claims that read roadmap_css() whole (the page head carries it verbatim).
fn fx_css_root_part() -> String {
  join([scale_root_css(), theme_root_css(base: day_theme, alternate: night_theme), issue_tracker_root_css(), band_root_css()], "\n")
}

fn fx_css_audition_part(index: Int) -> String {
  join(map(audition_sets.skip(n: index).take(n: 1), a => audition_block_css(a: a)), "\n")
}

fn fx_emitted_property(selector: String, property: String, value: String) -> Bool {
  any(site_styles_rules(styles: site_styles(rules: roadmap_rules())), r => match r {
    StaticRule { selector: subject, decls } => selector_subject_wire(s: subject) == selector && any(decls, d => css_property_wire(p: d.prop) == property && d.value == value)
    ResponseRule { subject: _, shape: _, trigger: _, transition_props: _, timing: _, base_decls: _, response_decls: _ } => false
    AmbientRule { selector: _, cycle: _, timing: _, repeat: _ } => false
  })
}

fn fx_css_rule_blocks() -> String {
  join(map(site_styles_rules(styles: site_styles(rules: roadmap_rules())), r => serialize_rule(rule: r)), "\n")
}

fn fx_css_tail_part() -> String {
  let rules = roadmap_rules()
  join([
    join(map(ambient_cycles(rules: rules), c => serialize_cycle(cycle: c)), "\n"),
    serialize_transition_carriers(carriers: all_transition_carriers(rules: rules)),
    reduced_motion_block(rules: rules),
  ], "\n")
}

data fx_issue_token_names: List<String> = ["text", "text-dim", "border", "bg-hover", "bg-subtle", "highlight", "action", "action-hover", "error", "font", "font-heading"]

// The sheet-wide laws, part by part: the rail width is declared once, the retired action-live
// class never ships, the issue grid template is declared once and the header/line rows never
// re-declare a grid, the retired data-view switch, the escaped child combinator and the retired
// max-width page containers never ship, and every issue token is declared three times (day root, night attribute,
// dark media query) -- all of them in the issue-tracker root block.
fn fx_css_part_holds(css: String, rail_widths: Int, grid_templates: Int, token_declarations: Int) -> Bool {
  occurrence_count(s: css, pattern: "flex: 0 1 34ch") == rail_widths
    && !string_contains(s: css, pattern: "action-live")
    && occurrence_count(s: css, pattern: join(["grid-template-columns: ", issue_results_row_tracks()], "")) == grid_templates
    && !string_contains(s: css, pattern: ".issue-table-header { display: grid")
    && !string_contains(s: css, pattern: ".issue-line { display: grid")
    && !string_contains(s: css, pattern: "data-view")
    && !string_contains(s: css, pattern: ".node-superseded > .taskbar-title")
    && !string_contains(s: css, pattern: ".roadmap { padding: var(--space-16) var(--space-24); max-width")
    && !string_contains(s: css, pattern: ".header-inner { max-width")
    && !string_contains(s: css, pattern: ".daily-workspace { padding: var(--space-16) var(--space-24); max-width")
    && all(fx_issue_token_names, n => occurrence_count(s: css, pattern: join(["--issue-", n, ":"], "")) == token_declarations)
}

test fn witness_css_root_part_laws_hold() -> Bool {
  fx_css_part_holds(css: fx_css_root_part(), rail_widths: 0, grid_templates: 0, token_declarations: 3)
}

test fn witness_css_audition_part_0_laws_hold() -> Bool {
  fx_css_part_holds(css: fx_css_audition_part(index: 0), rail_widths: 0, grid_templates: 0, token_declarations: 0)
}

