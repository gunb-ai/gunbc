test fn witness_hero_attempt_row_is_bar_first() -> Bool {
  match hero_row_html(view: hero_green_view(alive: true)) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      string_contains(s: h, pattern: "<div class=\"taskbar\" data-arm=\"active\" data-attention=\"routine\"><div class=\"taskbar-fill\"><div class=\"stage-strip\">")
        && string_contains(s: h, pattern: "<div class=\"taskbar-face\">")
        && occurrence_count(s: h, pattern: "class=\"stage-segment stage-complete\"") == 1
        && occurrence_count(s: h, pattern: "class=\"stage-segment stage-active stage-live\"") == 1
        && occurrence_count(s: h, pattern: "class=\"stage-segment stage-pending\"") == 5
        && occurrence_count(s: h, pattern: "class=\"stage-segment stage-stopped\"") == 1
        && string_contains(s: h, pattern: "title=\"Environment · complete\"")
        && string_contains(s: h, pattern: "title=\"Workspace · active\"")
        && string_contains(s: h, pattern: "<span class=\"taskbar-title\">Hero specimen row</span>")
        && string_contains(s: h, pattern: "<span class=\"taskbar-signal activity-line-neutral\" data-rest-signal=\"ready to dispatch\" data-rest-class=\"activity-line-neutral\">Workspace · active</span>")
        && string_contains(s: h, pattern: "<span class=\"taskbar-count\">2 of 8 stages</span>")
        && string_contains(s: h, pattern: "<span class=\"taskbar-sub\">Agent working</span>")
        && string_contains(s: h, pattern: "<details class=\"taskbar-inspect\">")
        && !string_contains(s: h, pattern: "<details class=\"taskbar-inspect\" open")
  }
}

// The live pulse belongs to the active segment ONLY while the worker is alive; the same attempt
// with a dead process renders the active segment without it.
test fn witness_stage_live_only_while_worker_alive() -> Bool {
  match hero_row_html(view: hero_green_view(alive: false)) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "class=\"stage-segment stage-active\"") == 1
        && !string_contains(s: h, pattern: "stage-live")
  }
}

// The round strip moved UNDER the disclosure (bar-first face): it renders only inside the activity
// details, and its segments carry the semantic activity-line classes — a read round, a write
// round, and a no-tool-call (provider round-trip) round from the fixture ledger.
test fn witness_round_strip_disclosed_and_classified() -> Bool {
  match hero_row_html(view: hero_green_view(alive: true)) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let parts = split(s: h, delimiter: "<details class=\"taskbar-inspect\"")
      count(parts) == 2
        && string_contains(s: string_at(parts: parts, index: 1), pattern: "class=\"activity-round-strip\"")
        && string_contains(s: h, pattern: "activity-round-read activity-line-read")
        && string_contains(s: h, pattern: "activity-round-write activity-line-write")
        && string_contains(s: h, pattern: "activity-round-reason activity-line-provider-call")
  }
}

type StringPick {
  seen: Int
  found: String
}

fn string_at(parts: List<String>, index: Int) -> String {
  fold(parts, init: StringPick { seen: 0, found: "" }, f: (acc, p) =>
    if acc.seen == index {
      StringPick { seen: acc.seen + 1, found: p }
    } else {
      StringPick { seen: acc.seen + 1, found: acc.found }
    }).found
}

fn hero_refused_view() -> gunbc.roadmap_presentation.WorkRowView {
  hero_row_view(
    node_id: "hero-refused",
    activity: gunbc.roadmap_presentation.activity_view_from_parts(
