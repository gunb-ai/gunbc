data parity_witness_note: String = "The server/client semantic parity obligation (operator blocker 7, 2026-08-01), discharged over the SAME constructed facts across every executable link: (1) the SERVER realization — render_work_row over the falsifier specimen view — is serialized and its semantic regions asserted exactly (arm and attention data, the decided summary sentence, each obligation label · state — detail line, each evidence label: value row, and on the refused arm the label on the surface with the located reason inside a CLOSED disclosure, per the 2026-09-20 status-surface ruling); (2) the WIRE — activity_view_json_value over the same view — carries the identical summary string, so the client receives byte-what the server rendered; (3) the CLIENT realization is pinned verbatim-paint: it reads av.summary / av.arm / av.attention and composes obligation and evidence lines from the SAME seam constants (activity_state_sep / activity_detail_sep / activity_evidence_kv_sep / activity_disclosure_label are data the emitted program embeds), so its composed strings equal the server's by one-authority construction. The DOM-mutation link the interpreter cannot execute is covered by the playwright specimen receipt (falsifier fixture intercepted, real emitted client, three widths). RED directions: a server renderer that drops a region reds (1); a seam change that moves the summary reds (1) and (2) together or not at all; a client that re-derives its own composition loses the shared-constant literals and reds (3)."

fn parity_specimen_segments() -> List<gunbc.roadmap_workflow_stage.WorkflowSegment> {
  [
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.EnvironmentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "admission receipt readable" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.WorkspaceWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "worktree created" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "turn.completed and process exit 0" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.ReviewWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.GoalAuditWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
  ]
}

fn parity_specimen_activity() -> gunbc.roadmap_presentation.ActivityView {
  gunbc.roadmap_presentation.activity_view_from_parts(
    segments: parity_specimen_segments(),
    remaining: 4,
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "Worked for 6m 34s")
}

fn parity_specimen_view(activity: gunbc.roadmap_presentation.ActivityView) -> gunbc.roadmap_presentation.WorkRowView {
  gunbc.roadmap_presentation.WorkRowView {
    node_id: "parity-specimen",
    headline: "Record which generator actually produced each result",
    summary: none,
    lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
    scheduling: gunbc.roadmap_presentation.SchedulingReady,
    superseded_by: "",
    activity: activity,
    action: gunbc.roadmap_presentation.action_view(
      lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
      admission: LaunchAdmitted { identity: launch_fixture_identity(node_id: "parity-specimen", cause: Operator, mode: ManualReady) }),
    supporting_facts: [],
    disclosure: gunbc.roadmap_presentation.NoDisclosure,
    rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    worker_alive: false,
    assignment: none,
    standing: none,
    attempt_stale: false,
    profiles: [],
  }
}

fn parity_row_html(activity: gunbc.roadmap_presentation.ActivityView) -> HtmlEmitResult {
  let view = parity_specimen_view(activity: activity)
  try_serialize_html_source(node: Element {
    tag: "li",
    attributes: gunbc.roadmap_page.node_li_attributes(view: view),
    children: gunbc.roadmap_page.render_task_row(view: view, observation: gunbc.roadmap_presentation.ObservationsNominal),
  })
}

test fn witness_parity_server_realizes_decided_regions() -> Bool {
  let summary = gunbc.roadmap_presentation.activity_summary_line(a: parity_specimen_activity())
  match parity_row_html(activity: parity_specimen_activity()) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      summary == "Agent turn completed; the retained session is no longer running · Verification next · 4 remaining"
        && string_contains(s: h, pattern: "class=\"taskbar\"")
        && string_contains(s: h, pattern: "data-arm=\"active\"")
        && string_contains(s: h, pattern: "data-attention=\"routine\"")
        && string_contains(s: h, pattern: "<span class=\"taskbar-signal activity-line-neutral\" data-rest-signal=\"ready to dispatch\" data-rest-class=\"activity-line-neutral\">Verification · pending</span>")
        && string_contains(s: h, pattern: "<span class=\"taskbar-count\">3 of 7 stages</span>")
        && string_contains(s: h, pattern: summary)
        && string_contains(s: h, pattern: "Environment · complete — admission receipt readable")
        && string_contains(s: h, pattern: "session container: present")
        && string_contains(s: h, pattern: "worker process: process exited")
        && string_contains(s: h, pattern: ">inspect</summary>")
  }
}

test fn witness_parity_wire_carries_the_server_sentence() -> Bool {
  let summary = gunbc.roadmap_presentation.activity_summary_line(a: parity_specimen_activity())
  let wire = serialize_json(
    v: gunbc.roadmap_presentation.activity_view_json_value(view: parity_specimen_activity()))
  string_contains(s: wire, pattern: join(["\"summary\": \"", summary, "\""], ""))
    && string_contains(s: wire, pattern: "\"arm\": \"active\"")
    && string_contains(s: wire, pattern: "\"attention\": \"routine\"")
    && string_contains(s: wire, pattern: "\"remaining_obligation_count\": 4")
}

// THE CLIENT ASSET, SUPPLIED BY ITS STATEMENT GROUPS (DESIGN section 3, a witness discriminates at
// one interface). Serializing the whole asset to read one group's spelling cost every claim the
// full ~108k-step serialization; each claim below serializes only the groups that emit what it
// reads. The groups are the production functions themselves, with the arguments
// dispatch_client_program passes, and witness_client_asset_is_exactly_its_statement_groups holds
// the real program to them -- so a group added to or dropped from the asset
// reds there, and the per-part claims below still cover every group the asset ships.
fn fx_client_groups() -> List<List<TsStmt>> {
  [
    [],
    dispatch_preamble_statements(),
    observe_impact_preamble_statements(),
    dispatch_bind_statements(selector: ".dispatch-btn", url_expr: dispatch_fetch_url_expr()),
    issue_action_bind_statements(),
    [],
    [],
    disclosure_bind_statements(),
    swatch_toggle_bind_statements(),
    observation_fetch_statements(),
    workflow_fetch_statements(),
    row_selection_bind_statements(),
    issue_filter_bind_statements(),
    [],
    [],
    issue_sort_bind_statements(),
    inline_assignment_bind_statements(),
    dashboard_instance_fetch_statements(),
  ]
}

fn fx_client_js_of(header: List<String>, stmts: List<TsStmt>) -> String {
  serialize_typescript_program(p: TsProgram { ts_nocheck: false, header_lines: header, statements: stmts })
}

fn fx_client_group_js(stmts: List<TsStmt>) -> String {
  fx_client_js_of(header: [], stmts: stmts)
}

// The asset's statements from group index lo (inclusive) to hi (exclusive), serialized as one
// program text; the header rides with part 0 so the asset-wide negatives see it too.
fn fx_client_part_js(lo: Int, hi: Int) -> String {
  let part = fx_client_groups().skip(n: lo).take(n: hi - lo)
  let stmts = fold(part, init: [], f: (acc, g) => concat(acc, g))
  fx_client_js_of(header: if lo == 0 { dispatch_client_program().header_lines } else { [] }, stmts: stmts)
}

// THE ROUTE: the shipped client program is made of exactly these groups. Without it the
// group-scoped claims could keep passing over a group the asset no longer ships. Statement lists
// admit no structural `==` here (their equality is unjudged), so the join is the statement count:
// a group dropped from, added to, or grown inside the asset changes it.
test fn witness_client_asset_is_exactly_its_statement_groups() -> Bool {
  count(dispatch_client_program().statements) == fold(fx_client_groups(), init: 0, f: (acc, g) => acc + count(g))
}

// THE ASSET-WIDE NEGATIVES AND THE ONE-FETCH LAW, over a partition of the groups that together
// cover the whole asset (sized so each part serializes inside the new-witness budget): no part ships the retired selection closest() list, the retired
// action-live class, a `=> if (` arrow (a JS syntax error), the retired view-chip selector or a channel prepending its
// own observation banner (the channels join one impact region), and exactly one part -- the one
// holding session_read_bind_statements -- fetches /auth/session, exactly once; and exactly one part -- the one
// holding workflow_fetch_statements -- paints the data-summary-only mark, exactly once.
fn fx_client_part_holds(js: String, session_fetches: Int, summary_only_marks: Int) -> Bool {
  !string_contains(s: js, pattern: "closest('button, a, details, input, select, textarea')")
    && !string_contains(s: js, pattern: "action-live")
    && !string_contains(s: js, pattern: "=> if (")
    && !string_contains(s: js, pattern: "[data-view-chip]")
    && !string_contains(s: js, pattern: "mn && mn.prepend(bn)")
    && occurrence_count(s: js, pattern: "fetch('/auth/session'") == session_fetches
    && occurrence_count(s: js, pattern: "data-summary-only") == summary_only_marks
}

test fn witness_client_asset_part_0_negatives_hold() -> Bool {
  fx_client_part_holds(js: fx_client_part_js(lo: 0, hi: 9), session_fetches: 0, summary_only_marks: 0)
}

test fn witness_client_asset_part_1_negatives_hold() -> Bool {
  fx_client_part_holds(js: fx_client_part_js(lo: 9, hi: 11), session_fetches: 0, summary_only_marks: 1)
}

test fn witness_client_asset_part_2_negatives_hold() -> Bool {
  fx_client_part_holds(js: fx_client_part_js(lo: 11, hi: 16), session_fetches: 0, summary_only_marks: 0)
}

// The last part runs to the end of the group list, so a group appended to the asset is still read.
test fn witness_client_asset_part_3_negatives_hold() -> Bool {
  fx_client_part_holds(js: fx_client_part_js(lo: 16, hi: 1000), session_fetches: 0, summary_only_marks: 0)
}

