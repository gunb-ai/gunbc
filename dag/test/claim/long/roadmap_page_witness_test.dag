fn occurrence_count(s: String, pattern: String) -> Int {
  count(split(s: s, delimiter: pattern)) - 1
}

// Uniform recursive issue rows (owner 2026-09-27): the table keeps every issue once,
// with no project-only counter, wrapper, or dispatch control. The sandbox forest is separate.
test fn witness_project_row_renders_progress_bar_and_tasks() -> Bool {
  match fx_page_project_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let table = string_at(parts: split(s: table_region(html: h), delimiter: "<div class=\"issue-table\" role=\"table\" aria-label=\"Issue search results\">"), index: 1)
      string_contains(s: h, pattern: "<li class=\"node node-open\" data-band=\"not-ready\" data-node=\"page-project\" tabindex=\"0\"")
        && !string_contains(s: table, pattern: "tasks closed")
        && !string_contains(s: table, pattern: "taskbar-project-bar")
        && !string_contains(s: table, pattern: "project-tasks")
        && !string_contains(s: table, pattern: "project-chain")
        && !string_contains(s: table, pattern: "class=\"taskbar\"")
        && !string_contains(s: table, pattern: "dispatch-btn")
        && !string_contains(s: table, pattern: "issue-action")
        && occurrence_count(s: h, pattern: "data-node=\"page-task-one\" tabindex=\"0\"") == 1
        && occurrence_count(s: h, pattern: "data-node=\"page-task-two\" tabindex=\"0\"") == 1
        && occurrence_count(s: h, pattern: "data-node=\"page-project\" tabindex=\"0\"") == 1
  }
}

