// DEFECT 2 (owner 2026-09-23): the Buganizer token capture is light-only and dark mode painted
// the light tokens on dark ground. Both schemes now resolve the SAME token set: the day values
// on :root, the Google dark equivalents under [data-theme="night"] and the prefers-color-scheme
// fallback, in the theme machinery's own three-block grammar — one token structure, two value
// sets. Every --issue-* var resolves in all three blocks (a token present in one scheme but
// absent in the other fails the surface when the toggle flips).
test fn witness_issue_tokens_resolve_in_both_themes() -> Bool {
  let css = fx_css_root_part()
  string_contains(s: css, pattern: ":root[data-theme=\"night\"]")
    && string_contains(s: css, pattern: "@media (prefers-color-scheme: dark)")
    && string_contains(s: css, pattern: "--issue-text: #202124")
    && string_contains(s: css, pattern: "--issue-text: #e8eaed")
    && string_contains(s: css, pattern: "--issue-action: #1a73e8")
    && string_contains(s: css, pattern: "--issue-action: #8ab4f8")
    && string_contains(s: css, pattern: "--issue-error: #c5221f")
    && string_contains(s: css, pattern: "--issue-error: #f28b82")
    && all(fx_issue_token_names, n => occurrence_count(s: css, pattern: join(["--issue-", n, ":"], "")) == 3)
}

// The issue action's two rule states, read where they are emitted -- the serialized rules, not the
// root custom-property blocks the token claim above reads.
test fn witness_issue_action_rules_consume_the_tokens() -> Bool {
  let rules = fx_css_rule_blocks()
  string_contains(s: rules, pattern: ".issue-action-contained { background: var(--issue-action)")
    && string_contains(s: rules, pattern: ".issue-action.is-disabled, .issue-action:disabled { background: transparent")
}

// THE TABLE'S BUTTON CENSUS (owner ruling 2026-09-25, "scrap the button stuff ... just copy
// buganizer"): the Buganizer results row carries NO action surface — no Start Work, no Assign, no
// dispatch control, no chip-button of any kind in the actions track. The actions region is status
// only (the attempt summary count / the project's k-of-n chip), and every pressable action on the
