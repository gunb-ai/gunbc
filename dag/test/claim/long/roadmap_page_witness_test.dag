// THE ASSIGNEE CELL (owner ruling 2026-09-25, "copy the UI semantics of assigned/etc from
// THE ASSIGNEE CELL (owner ruling 2026-09-25, "make assignee always be the pfp (or a
// default/placeholder) of the email account"): the cell renders the principal's AVATAR CHIP — a
// fixed-size circular chip, deterministic initials under the avatar law (photo when resolved, the
// /avatar realization is the follow-up), the workflow badge for Fabric — NEVER the email text
// (the full identity rides the title attribute). An unassigned issue renders the model's "--"
// placeholder, the capture-verified unassigned spelling (34 of the 50 saved rows in "test -
// Chromium.html"). The fixture: page-task-one holds an in-progress standing (by
// "operator@gunb.ai"); page-task-two and the project hold none — one row shows the chip, two show
// the placeholder, and no cell carries a link or button.
test fn witness_issue_table_assignee_renders_the_avatar_chip_or_placeholder() -> Bool {
  match fx_summary_only_page_html(stale: false) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let table = table_region(html: h)
      occurrence_count(s: table, pattern: "class=\"site-avatar site-avatar-default\" data-avatar=\"absent\"") == 1
        && occurrence_count(s: table, pattern: ">--</button>") == 2
        && occurrence_count(s: table, pattern: "class=\"issue-inline-assign\" disabled=\"disabled\"") == 3
        && string_contains(s: table, pattern: "Sign in to assign this issue; checking session.")
  }
}

// Headers derive from the model and expose keyboard-operable sort controls. TYPE and
// the special count slot are absent under the uniform-row ruling (2026-09-27).
test fn witness_issue_table_header_derives_from_the_model_roster() -> Bool {
  match fx_page_project_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let table = table_region(html: h)
      all(issue_results_columns, c =>
        string_contains(s: table, pattern: join(["data-sort-key=\"", extdeps.google.issue_tracker.issue_results_sort_key_wire(key: c.sort_key), "\""], ""))
          && string_contains(s: table, pattern: join([">", c.header as String, "</button>"], "")))
        && occurrence_count(s: table, pattern: "aria-sort=\"none\"") == count(issue_results_columns)
        && !string_contains(s: table, pattern: "data-col=\"type\"")
        && !string_contains(s: table, pattern: "data-col=\"actions\"")
  }
}

fn marker_before(s: String, first: String, second: String) -> Bool {
  match split(s: s, delimiter: first).skip(n: 1).first() {
    Absent => false
    Present { value: rest } => string_contains(s: rest, pattern: second)
  }
}

// Every row follows the same column roster and carries underlying sort values.
// Empty values retain their cells; type labels and project counters add no columns.
test fn witness_issue_table_rows_share_the_header_template() -> Bool {
  match fx_summary_only_page_html(stale: false) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let table = table_region(html: h)
      let row_body = li_of_node(html: table, node_id: "page-task-one")
      occurrence_count(s: table, pattern: "class=\"issue-cell issue-cell-") == 3 * count(issue_results_columns)
        && occurrence_count(s: table, pattern: "class=\"issue-col issue-col-") == count(issue_results_columns)
        && all(issue_results_columns, c => occurrence_count(s: table, pattern: join(["data-col=\"", issue_results_column_kind_wire(kind: c.kind), "\""], "")) == 4)
        && marker_before(s: row_body, first: "data-col=\"priority\"", second: "data-col=\"title\"")
        && marker_before(s: row_body, first: "data-col=\"title\"", second: "data-col=\"assignee\"")
        && marker_before(s: row_body, first: "data-col=\"assignee\"", second: "data-col=\"status\"")
        && marker_before(s: row_body, first: "data-col=\"status\"", second: "data-col=\"last-modified\"")
        && string_contains(s: row_body, pattern: "href=\"/issue/page-task-one\"")
        && string_contains(s: row_body, pattern: "data-sort-value=\"Active\"")
        && !string_contains(s: table, pattern: "data-col=\"type\"")
        && !string_contains(s: table, pattern: "data-col=\"actions\"")
  }
}

// THE SERVED TEMPLATE'S PROVENANCE (owner ruling 2026-09-24, amended by the shared-grid fix):
// the roster-derived tracks render ONCE — on .issue-table, the one grid container — with the
// header and the rows reaching them through display: contents, never a second
// grid-template-columns spelling. The old shape gave the header and each row its OWN grid:
// max-content tracks measure per container, so every row sized its columns independently of the
// header, and long cells ran off the page. The census counts the rendered template bytes: exactly
// one spelling of the tracks anywhere in the sheet.
test fn witness_issue_table_grid_template_comes_from_the_model() -> Bool {
  let css = fx_css_rule_blocks()
  let tracks = issue_results_row_tracks()
  string_contains(s: css, pattern: join([".issue-table { display: grid; grid-template-columns: ", tracks], ""))
    && occurrence_count(s: css, pattern: join(["grid-template-columns: ", tracks], "")) == 1
    && string_contains(s: css, pattern: ".issue-table-header { display: contents")
    && string_contains(s: css, pattern: ".issue-line { display: contents")
    && !string_contains(s: css, pattern: ".issue-table-header { display: grid")
    && !string_contains(s: css, pattern: ".issue-line { display: grid")
}

// THE HEADER AND A ROW'S CELLS OCCUPY THE SAME GRID TRACKS (owner ruling 2026-09-24, the
// structural half of the column-alignment fix): every wrapper between the table element and the
// cells — the list, the list item, the header div, the row div — is display: contents, so the
// header's and each row's cells box-tree into the table's ONE grid as direct children, nine per
// source row filling the template's nine tracks; the heading and the empty state span every track
// (grid-column: 1 / -1) so they break the cell flow instead of displacing a column. Filtering is
// untouched: the band-filter hide rules out-specificity the contents rules, and the search
// filter's inline display outranks the sheet altogether.
test fn witness_issue_table_cells_are_direct_grid_children() -> Bool {
  let css = fx_css_rule_blocks()
  string_contains(s: css, pattern: ".issue-table ul { display: contents }")
    && string_contains(s: css, pattern: ".issue-table li { display: contents }")
    && string_contains(s: css, pattern: ".issue-table-heading { font-family: var(--issue-font-heading); font-size: var(--text-15); font-weight: 500; margin-bottom: var(--space-8); grid-column: 1 / -1 }")
    && fx_emitted_property(selector: ".issue-empty", property: "display", value: "none")
    && fx_emitted_property(selector: ".issue-empty", property: "grid-column", value: "1 / -1")
    && string_contains(s: css, pattern: ".issue-line:hover .issue-cell { background: var(--issue-bg-hover) }")
}

// OVERFLOW CONTROL (owner complaint 2026-09-24: rows ran entirely off the page): a deliberately
// long title is served IN FULL — the markup carries the truth, the sheet paints the clip — inside
// the title cell, and the containment chain that keeps the row's right edge at the container's
// edge is present on the shared grid: the title track is the roster's minmax(0, 1fr), which takes
// only the space the fixed tracks leave, and .issue-cell's min-width: 0 lets that track shrink
// below the content while overflow: hidden + nowrap + text-overflow: ellipsis paint the ellipsis.
// The status cell wears the same issue-cell class, so status text rides the same chain; the
// container bound is structural — .roadmap's max-width sizes the table's grid, and one grid's
// tracks never extend past their container.
fn fx_long_title_doc(long: String) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [ RoadmapSection {
      title: "Projects",
      elements: [ section_group(label: "", nodes: [
        fx_authored_wi(identity: "rnfx_PAGELONGTITLE00000000001", id: "page-long-title",
          done: false, content: long, repo: "gunbc"),
      ], edges: []) ],
    } ],
  }
}

fn fx_long_title_page_html(long: String) -> HtmlEmitResult {
  try_serialize_html_source(node: gunbc.roadmap_page.roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(
    doc: fx_long_title_doc(long: long),
    merged: [],
    accepted_ids: [],
    withheld: [],
    main_prefix: [],
    attempts: [],
    attempts_refused: none,
    standings: StandingsObserved { rows: [] },
    launch: dispatch_doc_standing(),
    stale_nodes: [],
    profiles: [],
    memberships: fixture_nesting_relation(edges: doc_all_edges(doc: fx_long_title_doc(long: long))),
    stylesheet: site_styles(rules: [])))
}

test fn witness_issue_table_long_cells_clip_within_their_tracks() -> Bool {
  let long_title = "an deliberately enormous issue title that would run the row entirely off the page when its track sized to the content the way the old per-row grids did"
  let css = fx_css_rule_blocks()
  match fx_long_title_page_html(long: long_title) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let table = table_region(html: h)
      string_contains(s: table, pattern: join(["<a class=\"issue-title-link\" href=\"/issue/page-long-title\">", long_title], ""))
        && string_contains(s: table, pattern: "class=\"issue-cell issue-cell-status\"")
        && occurrence_count(s: table, pattern: "class=\"issue-cell issue-cell-") == 5
        && occurrence_count(s: table, pattern: "data-col=\"actions\"") == 0
        && string_contains(s: css, pattern: ".issue-cell { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis")
        && string_contains(s: css, pattern: join([".issue-table { display: grid; grid-template-columns: ", issue_results_row_tracks()], ""))
        && fx_emitted_property(selector: ".roadmap", property: "padding", value: "var(--space-24)")
  }
}

// THE ASSIGN CONTROL (owner rulings 2026-09-25, "just copy buganizer" + the issue-page mandate):
// the durable Assign action is a NATIVE FORM — text/plain POST to the assign route, the email
// input with its datalist, the hidden expected_revision pin, the avatar-backed suggestions roster
// (viewer + fabric pinned, then recents), the model's wire label on the submit — and the submit
// deliberately wears NO .issue-action class (the client's bodyless action bind must not race the
// native submit). The retired Start Work stays absent (a census control: zero dispatch-btn and
// zero "Start Work" in the body).
test fn witness_issue_detail_renders_enabled_modeled_action_and_attempt_assignee() -> Bool {
  match issue_detail_fixture_html() {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let body = match (split(s: h, delimiter: "</style>")).skip(n: 1).first() {
        Present { value: b } => b
        Absent => h
      }
      occurrence_count(s: body, pattern: "dispatch-btn") == 0
        && string_contains(s: body, pattern: "data-site-choice=\"rich\"")
        && string_contains(s: body, pattern: "role=\"combobox\"")
        && !string_contains(s: body, pattern: "<datalist")
        && string_contains(s: body, pattern: "data-choice-value=\"fabric@gunb.ai\" data-workflow=\"1\"")
        && string_contains(s: body, pattern: "data-choice-value=\"teammate@gunb.ai\" data-workflow=\"0\"")
        && !string_contains(s: body, pattern: "data-choice-value=\"principal:")
        && occurrence_count(s: body, pattern: "class=\"site-choice-option issue-assign-suggestion\"") == 2
        && string_contains(s: body, pattern: "Group · starts a workflow run")
        && string_contains(s: body, pattern: "aria-label=\"Fabric group\"")
        && string_contains(s: body, pattern: "name=\"expected_revision\" type=\"hidden\"")
        && occurrence_count(s: body, pattern: "class=\"issue-action\"") == 0
        && string_contains(s: body, pattern: "data-action=\"Assign\" data-idiom=\"text\" data-action-route=\"assign\" data-action-state=\"enabled\"")
        && string_contains(s: body, pattern: "class=\"issue-assign-submit issue-action-text\" hidden")
        && occurrence_count(s: body, pattern: "Start Work") == 0

  }
}

// PARENT AND BLOCKING RENDER SEPARATELY (owner ruling 2026-09-24): the detail field panel carries
// the decomposition link in its own "parent" row, beside the dependency rows "blocking" and
// "blocked by" — three distinct fields, never one merged list. The fixture: specimen's primary
// parent is the parent issue; it blocks the child; the parent blocks it.
test fn witness_issue_detail_parent_and_blocking_render_separately() -> Bool {
  match issue_detail_fixture_html() {
