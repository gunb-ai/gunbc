  string_contains(s: h, pattern: ".roadmap { padding: var(--space-16) var(--space-24); max-width: var(--measure); margin-left: auto; margin-right: auto }")
}

test fn witness_authority_leads_within_budget() -> Bool {
  roadmap_authority_lead_budget_violations().length() == 0
}

fn overlong_lead_node() -> gunbc.roadmap_model.RoadmapNode {
  let chunk = "a lead with no separator so the whole line stands "
  gunbc.roadmap_authority.authored(identity: "rnfx_FKEE5NQSZN982W3TF9SS", id: "overlong-lead",
    done: false,
    content: join([chunk, chunk, chunk, chunk, chunk, chunk, chunk], ""),
  )
}

test fn witness_overlong_lead_reds() -> Bool {
  let v = lead_budget_violations(nodes: [overlong_lead_node()])
  v.length() == 1
    && all(v, x => x.node == "overlong-lead" && x.lead_chars > roadmap_lead_budget_chars())
    && lead_budget_violations(nodes: [ready_dispatch_node()]).length() == 0
}

data parity_witness_note: String = "The server/client semantic parity obligation (operator blocker 7, 2026-08-01), discharged over the SAME constructed facts across every executable link: (1) the SERVER realization — render_work_row over the falsifier specimen view — is serialized and its semantic regions asserted exactly (arm and attention data, the decided summary sentence, each obligation label · state — detail line, each evidence label: value row, and on the refused arm the located reason inside an OPEN disclosure); (2) the WIRE — activity_view_json_value over the same view — carries the identical summary string, so the client receives byte-what the server rendered; (3) the CLIENT realization is pinned verbatim-paint: it reads av.summary / av.arm / av.attention and composes obligation and evidence lines from the SAME seam constants (activity_state_sep / activity_detail_sep / activity_evidence_kv_sep / activity_disclosure_label are data the emitted program embeds), so its composed strings equal the server's by one-authority construction. The DOM-mutation link the interpreter cannot execute is covered by the playwright specimen receipt (falsifier fixture intercepted, real emitted client, three widths). RED directions: a server renderer that drops a region reds (1); a seam change that moves the summary reds (1) and (2) together or not at all; a client that re-derives its own composition loses the shared-constant literals and reds (3)."

fn parity_specimen_segments() -> List<gunbc.roadmap_workflow_stage.WorkflowSegment> {
  [
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.EnvironmentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "admission receipt readable" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.WorkspaceWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "worktree created" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "turn.completed and process exit 0" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.VerificationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.PublicationWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.ReviewWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
    gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.GoalAuditWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentPending, detail: "" },
  ]
}

fn parity_specimen_activity() -> gunbc.roadmap_presentation.ActivityView {
  gunbc.roadmap_presentation.activity_view_from_parts(
    segments: parity_specimen_segments(),
    remaining: 4,
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    current_activity: "Worked for 6m 34s")
}

fn parity_specimen_view(activity: gunbc.roadmap_presentation.ActivityView) -> gunbc.roadmap_presentation.WorkRowView {
  gunbc.roadmap_presentation.WorkRowView {
    node_id: "parity-specimen",
    headline: "Record which generator actually produced each result",
    summary: none,
    lifecycle: gunbc.roadmap_presentation.OpenLifecycle,
    scheduling: gunbc.roadmap_presentation.SchedulingReady,
    superseded_by: "",
    activity: activity,
    action: gunbc.roadmap_presentation.action_view(
      scheduling: gunbc.roadmap_presentation.SchedulingReady,
      lifecycle: gunbc.roadmap_presentation.OpenLifecycle),
    supporting_facts: [],
    disclosure: gunbc.roadmap_presentation.NoDisclosure,
  }
}

fn parity_row_html(activity: gunbc.roadmap_presentation.ActivityView) -> String {
  let view = parity_specimen_view(activity: activity)
  match extdeps.languages.html.try_serialize_html_source(node: std.markup.Element {
    tag: "li",
    attributes: gunbc.roadmap_page.node_li_attributes(view: view),
    children: gunbc.roadmap_page.render_work_row(view: view),
  }) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_parity_server_realizes_decided_regions() -> Bool {
  let summary = gunbc.roadmap_presentation.activity_summary_line(a: parity_specimen_activity())
  let h = parity_row_html(activity: parity_specimen_activity())
  summary == "Agent turn completed; the retained session is no longer running · Verification next · 4 remaining"
    && string_contains(s: h, pattern: "class=\"node-activity\"")
    && string_contains(s: h, pattern: "data-arm=\"active\"")
    && string_contains(s: h, pattern: "data-attention=\"routine\"")
    && string_contains(s: h, pattern: summary)
    && string_contains(s: h, pattern: "Environment · complete — admission receipt readable")
    && string_contains(s: h, pattern: "Verification · pending")
    && string_contains(s: h, pattern: "session container: present")
    && string_contains(s: h, pattern: "worker process: process exited")
    && string_contains(s: h, pattern: ">activity</summary>")
}

test fn witness_parity_wire_carries_the_server_sentence() -> Bool {
  let summary = gunbc.roadmap_presentation.activity_summary_line(a: parity_specimen_activity())
  let wire = extdeps.languages.json.emit.serialize_json(
    v: gunbc.roadmap_presentation.activity_view_json_value(view: parity_specimen_activity()))
  string_contains(s: wire, pattern: join(["\"summary\": \"", summary, "\""], ""))
    && string_contains(s: wire, pattern: "\"arm\": \"active\"")
    && string_contains(s: wire, pattern: "\"attention\": \"routine\"")
    && string_contains(s: wire, pattern: "\"remaining_obligation_count\": 4")
}

test fn witness_parity_client_paints_verbatim_with_shared_constants() -> Bool {
  let js = gunbc.roadmap_component.dispatch_client_js_source()
  string_contains(s: js, pattern: "av.summary")
    && string_contains(s: js, pattern: "av.arm")
    && string_contains(s: js, pattern: "av.attention")
    && string_contains(s: js, pattern: "seg.label + ' · ' + seg.state")
    && string_contains(s: js, pattern: "' — ' + seg.detail")
    && string_contains(s: js, pattern: "row.label + ': ' + row.value")
    && string_contains(s: js, pattern: "'activity'")
}

data parity_refused_note: String = "The refused arm's parity: the server realization carries the located reason inside an OPEN activity disclosure (the attention rule's auto-expand, realized as the open attribute at render), and the client pins the same auto-open decision through data-auto-opened. A refusal whose reason failed to reach either surface is the title-only world the anomaly witnesses forbid."

test fn witness_parity_refused_arm_carries_located_reason_open() -> Bool {
  let refused = gunbc.roadmap_presentation.activity_view_from_parts(
    segments: [
      gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.EnvironmentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentComplete, detail: "" },
      gunbc.roadmap_workflow_stage.WorkflowSegment { kind: gunbc.roadmap_workflow_stage.AgentWorkflowSegment, state: gunbc.roadmap_workflow_stage.WorkflowSegmentRefused, detail: "turn.completed with process unobserved: no exit was established" },
    ],
    remaining: 6,
    process: gunbc.worker_lifecycle.WorkerProcessExited { exit_code: 0, last_command: "codex" },
    current_activity: "")
  let h = parity_row_html(activity: refused)
  string_contains(s: h, pattern: "data-arm=\"refused\"")
    && string_contains(s: h, pattern: "class=\"activity-located-reason\"")
    && string_contains(s: h, pattern: "turn.completed with process unobserved: no exit was established")
    && string_contains(s: h, pattern: " open")
}

data a2_hierarchy_closeout_witnesses_note: String = "The A2 hierarchy-closeout receipts (operator gap ruling 2026-08-02; S0 amendments, operator recalibration 2026-08-02), each pinning a decided fact rather than accidental composition: the selection grammar ships in the emitted client asset (selection and activation distinct — interactive elements never move selection through the click channel; Escape clears; exactly the selected row's primary action earns action-focal, the class renamed from action-live because live means sessions/observation elsewhere in this product); selection has KEYBOARD PARITY (rows carry tabindex, keyboard focus is gated on :focus-visible so pointer clicks on inner controls cannot move selection through the focus channel, Enter/Space on the focused row toggles, and every path funnels through the one gunbcSelectRow); the three observation channels join ONE impact region (each channel's located row appends into the shared disclosure and the painter no longer prepends free-standing banners to main); and the stylesheet carries the quiet-rest pair, the action-focal band restore on the family's DERIVED rest-band vars, the li.node:focus-visible outline, and the header's shared composition frame. The axis pins on the dispatch button itself (ready renders action-primary/available; review and out-of-order render action-secondary/override; done and superseded render no button at all) live with the existing per-fixture witnesses above. The action-live spellings below are DISCRIMINATING NEGATIVES: the retired name reappearing means the rename regressed or a second prominence authority stood up."

test fn witness_selection_grammar_ships_in_client_asset() -> Bool {
  let js = gunbc.roadmap_component.dispatch_client_js_source()
  string_contains(s: js, pattern: "const gunbcClearSelection")
    && string_contains(s: js, pattern: "const gunbcSelectRow")
    && string_contains(s: js, pattern: "classList.add('node-selected')")
    && string_contains(s: js, pattern: ".node-head .dispatch-btn.action-primary")
    && string_contains(s: js, pattern: "classList.add('action-focal')")
    && string_contains(s: js, pattern: "e.key === 'Escape'")
    && string_contains(s: js, pattern: "closest('summary, button, a, input, select, textarea')")
    && !string_contains(s: js, pattern: "closest('button, a, details, input, select, textarea')")
    && !string_contains(s: js, pattern: "action-live")
}

test fn witness_selection_has_keyboard_parity() -> Bool {
  let js = gunbc.roadmap_component.dispatch_client_js_source()
  string_contains(s: dispatch_doc_html_for(rn: ready_dispatch_node()), pattern: "tabindex=\"0\"")
    && string_contains(s: js, pattern: "addEventListener('focusin'")
    && string_contains(s: js, pattern: "matches(':focus-visible')")
    && string_contains(s: js, pattern: "matches('li.node')")
    && string_contains(s: js, pattern: "e.key !== 'Enter' && e.key !== ' '")
    && string_contains(s: js, pattern: "e.preventDefault()")
    && string_contains(s: js, pattern: "gunbcSelectRow(t)")
    && string_contains(s: js, pattern: "gunbcSelectRow(li)")
}

test fn witness_observation_channels_join_one_impact_region() -> Bool {
  let js = gunbc.roadmap_component.dispatch_client_js_source()
  string_contains(s: js, pattern: "const gunbcObserveImpactBox")
    && string_contains(s: js, pattern: "'workspace-observation client-minted'")
    && string_contains(s: js, pattern: "impactDetail && impactDetail.append(bn)")
    && string_contains(s: js, pattern: "'observe-refused sessions-observe-refused'")
    && string_contains(s: js, pattern: "'observe-refused attempts-observe-refused'")
    && string_contains(s: js, pattern: "'observe-refused workflow-observe-refused'")
    && !string_contains(s: js, pattern: "mn && mn.prepend(bn)")
}

test fn witness_prominence_and_frame_rules_present_in_css() -> Bool {
  string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".dispatch-btn.action-primary, .dispatch-btn.action-secondary { color: var(--text-dim); background: var(--surface); border-color: var(--border) }")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".dispatch-btn.action-focal { color: var(--band-invite-ink); background: var(--band-invite); border-color: var(--band-invite) }")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: "li.node:focus-visible { outline: var(--border-2) solid var(--focus) }")
    && !string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: "action-live")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".header-inner { max-width: var(--measure); margin-left: auto; margin-right: auto; display: flex; align-items: center; gap: var(--space-12) }")
}
