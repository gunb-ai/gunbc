    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "data-event-kind=\"result_returned\"") == 2
        && string_contains(s: h, pattern: "data-result-outcome=\"published\" data-attempt=\"feedfacefeedface\"")
        && string_contains(s: h, pattern: "<span class=\"site-avatar site-avatar-workflow\" data-avatar=\"absent\" title=\"Fabric — workflow · fabric@gunb.ai\"><svg class=\"site-avatar-default-mark\" viewBox=\"0 0 64 64\" role=\"img\" aria-label=\"Fabric group\">")
        && string_contains(s: h, pattern: "published gunb-ai/gunbc#12210 at 52c56a8 — reassigned for merge to principal:google-oidc/accounts/sub-viewer")
