      admission: LaunchAdmitted { identity: launch_fixture_identity(node_id: "issue-detail-specimen", cause: Operator, mode: ManualReady) }),
    supporting_facts: [ gunbc.roadmap_presentation.SupportingFact { label: "owner", value: "agent-35", href: "" } ],
    disclosure: gunbc.roadmap_presentation.NoDisclosure,
    rounds: hero_rounds_fixture(),
    worker_alive: true,
    standing: Present { value: NodeClaimed { by: fixture_human_principal(), since: "2026-09-23" } },
    attempt_stale: false,
    profiles: [fixture_human_profile()],
  }
}

test fn witness_issue_detail_rail_and_comments_render_the_profile_identity() -> Bool {
  let claim = fx_event_envelope_chained(id: "prof-ho-1", parent: "cmt-3d", at: "2026-09-25T10:00:00Z", kind: gunbc.roadmap.roadmap_event_log.Claimed { assignee: fixture_fabric_principal(), return_to: fixture_human_principal() })
  let pub = gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
    id: "prof-ho-2" as gunbc.roadmap.roadmap_event_log.RoadmapEventId,
    event: gunbc.roadmap.roadmap_event_log.RoadmapEvent {
      node: "issue-detail-specimen" as gunbc.roadmap_model.RoadmapNodeId,
      author: fixture_fabric_principal(),
      parent: Present { value: "prof-ho-1" as gunbc.roadmap.roadmap_event_log.RoadmapEventId },
      kind: gunbc.roadmap.roadmap_event_log.ResultReturned { attempt: "feedfacefeedface" as NonEmptyStr, claim: "prof-ho-1" as gunbc.roadmap.roadmap_event_log.RoadmapEventId, outcome: gunbc.roadmap.roadmap_event_log.ResultPublished { pr: "gunb-ai/gunbc#12210" as NonEmptyStr, head: "52c56a8" as NonEmptyStr } },
      recorded_at: "2026-09-25T11:00:00Z",
    },
  }
  match try_serialize_html_source(node: fx_issue_detail_body(
    view: issue_detail_profiled_fixture_view(),
    panel: issue_detail_fixture_panel(),
    observation: gunbc.roadmap_presentation.ObservationsNominal,
    attempts: [],
    events: concat(fx_comment_stream_events(), [claim, pub]),
    viewer: "principal:google-oidc/accounts/sub-viewer",
    recents: [ fixture_teammate_legacy() ],
    expected_revision: "",
    command_context: IssueFormContext { operation: "", csrf: "" },
    profiles: [])) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let rail_region = string_at(parts: split(s: h, delimiter: "<aside class=\"issue-rail\">"), index: 1)
      string_contains(s: rail_region, pattern: "value=\"viewer@gunb.ai\"")
        && string_contains(s: rail_region, pattern: "<img src=\"https://lh3.googleusercontent.com/a/fixture-picture\"")
        && occurrence_count(s: h, pattern: "class=\"issue-comment-author\">Fixture Viewer</span>") == 3
        && string_contains(s: h, pattern: "reassigned for merge to Fixture Viewer")
  }
}

// THE PICKER'S CHIP_HTML carries the same display: the assignment context's options serialize the
// profile-bound chip — the JSON string member escapes its quotes, so the pins ride the escaped
// spelling. The seated viewer (self) binds the fixture profile; the unprofiled recent renders the
// fallback chip with no text span.
fn picker_session_fixture() -> AuthenticatedSession {
  AuthenticatedSession {
    session_id: "picker-fixture" as NonEmptyStr,
    principal: fixture_human_ref(),
    authenticated_at: "2026-09-28T00:00:00Z",
    expires_at: "2026-09-29T00:00:00Z",
    auth_method: AuthMethodGoogleOidc,
    client: SessionClientTrackerWeb,
    csrf: CsrfToken { token: "picker-fixture-csrf" as NonEmptyStr },
    profile: SessionProfile { picture: none, name: none, email: none },
  }
}

test fn witness_inline_assignment_context_chip_html_carries_the_profile_display() -> Bool {
  let body = inline_assignment_context_body(
    session: picker_session_fixture(),
    events: [],
    recents: [ gunbc.roadmap.roadmap_event_log.EventPrincipalAuthenticated { ref: fixture_stranger_ref() } ],
    profiles: [fixture_human_profile()])
  string_contains(s: body, pattern: "picker-fixture-csrf")
    && occurrence_count(s: body, pattern: "class=\\\"issue-assignee-text\\\">viewer@gunb.ai</span>") == 1
    && occurrence_count(s: body, pattern: "data-avatar=\\\"resolved\\\"") == 1
    && occurrence_count(s: body, pattern: "issue-assignee-text") == 1
    && occurrence_count(s: body, pattern: "data-avatar=\\\"absent\\\"") == 2
    && string_contains(s: body, pattern: "principal:google-oidc/accounts/sub-stranger")
}

// These older fixtures explicitly declare both relations with the same endpoints. Production
// never derives ownership this way; the independent-relation control uses different endpoints.
fn fixture_nesting_relation(edges: List<gunbc.roadmap_model.RoadmapEdge>) -> List<gunbc.roadmap_nesting.RoadmapMembership> {
  map(edges, e => gunbc.roadmap_nesting.RoadmapMembership { member: e.parent as String, project: e.child as String, contribution: "fixture contribution" })
}

test fn renamed_field_label_keeps_its_typed_section_and_brief_renders_once() -> Bool {
  match brief_fixture_html(lifecycle: gunbc.roadmap_presentation.OpenLifecycle, control_label: "Independent display label") {
    EmitRejected { reason: _ } => false
    EmitOk { html } => occurrence_count(s: html, pattern: "the brief words") == 1
      && marker_before(s: html, first: "Acceptance criteria", second: "Independent display label")
      && string_contains(s: html, pattern: "<span class=\"ticket-field-label\">Independent display label</span>")
  }
}

// THE RAIL'S STANDING SENTENCE NAMES PRINCIPALS THE WAY THE CHIPS DO. The live rail printed
// "claimed by principal:gunbc/workflows/fabric", an unbreakable token that ran past the 34ch rail;
// the one ledger sentence now takes the page's display naming, so Fabric reads "Fabric" and a
// human with a stored profile reads their name, while a principal nobody knows keeps its label.
test fn witness_issue_standing_text_names_principals_by_their_display() -> Bool {
  let fabric = issue_standing_text(s: NodeClaimed { by: fixture_fabric_principal(), since: "2026-09-30T15:15:48Z" }, profiles: [])
  let known = issue_standing_text(s: NodeClaimed { by: fixture_human_principal(), since: "" }, profiles: [fixture_human_profile()])
  let unknown = issue_standing_text(s: NodeClaimed { by: fixture_human_principal(), since: "" }, profiles: [])
  fabric == "claimed by Fabric since 2026-09-30T15:15:48Z"
    && !string_contains(s: fabric, pattern: "principal:")
    && known == "claimed by Fixture Viewer"
    && unknown == "claimed by principal:google-oidc/accounts/sub-viewer"
}

