// THE ISSUE PAGE'S BODY, WITHOUT THE STYLESHEET (DESIGN section 3, a witness discriminates at one
// interface). gunbc.roadmap_page issue_detail_page_launch inlines roadmap_css() into its head --
// ~165k of each claim's ~213k steps -- and no issue-page claim here reads the head. This renders
// the same html > body the launch renders, from the same producers (roadmap_header, the
// issue_detail_page component, the dispatch client script tag), so every body assertion reads the
// markup the served page carries. The launch's composition is NOT re-asserted here: holding it
// in budget needs a stylesheet-supplied launch seam like roadmap_page_launch_with_stylesheet.
fn fx_issue_detail_body(view: gunbc.roadmap_presentation.WorkRowView, panel: gunbc.roadmap_presentation.IssueLinkPanel, observation: gunbc.roadmap_presentation.ObservationImpactView, attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress>, events: List<gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope>, viewer: String, recents: List<gunbc.roadmap.roadmap_event_log.EventPrincipal>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }, profiles: List<PrincipalProfile>) -> Fragment {
  Element {
    tag: "html",
    attributes: [ attr(name: "lang", value: "en" ) ],
    children: [
      Element { tag: "body", attributes: [], children: [
        gunbc.site.document.site_header(page: "issue"),
        gunbc.roadmap_page.issue_detail_page(view: view, panel: panel, observation: observation, attempts: attempts, events: events, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context),
        gunbc.roadmap_page.dispatch_client_script(),
      ] },
    ],
  }
}

