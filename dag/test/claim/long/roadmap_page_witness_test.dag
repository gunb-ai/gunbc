        gunbc.roadmap_presentation.DisclosureField { identity: gunbc.roadmap_presentation.TicketHandback, label: "hand-back", value: "the hand-back clause" },
        gunbc.roadmap_presentation.DisclosureField { identity: gunbc.roadmap_presentation.TicketCurrentState, label: "current state", value: "the current state" },
        gunbc.roadmap_presentation.DisclosureField { identity: gunbc.roadmap_presentation.TicketFirstSlice, label: "first slice", value: "the first slice" },
        gunbc.roadmap_presentation.DisclosureField { identity: gunbc.roadmap_presentation.TicketDisplacedCost, label: "displaced cost", value: "the displaced cost" },
        gunbc.roadmap_presentation.DisclosureField { identity: gunbc.roadmap_presentation.TicketOutOfScope, label: "out of scope", value: "the out-of-scope clause" },
      ],
      updates: [],
    },
    rounds: hero_rounds_fixture(),
    worker_alive: true,
    assignment: none,
    standing: Present { value: NodeClaimed { by: fixture_human_principal(), since: "2026-09-23" } },
