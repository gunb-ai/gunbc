    EmitOk { html: h } =>
      occurrence_count(s: h, pattern: "<span class=\"issue-field-label\">parent</span>") == 1
        && occurrence_count(s: h, pattern: "class=\"issue-dag-role\">Prerequisite</span>") == 1
        && occurrence_count(s: h, pattern: "class=\"issue-dag-role\">Depends on this issue</span>") == 1
        && occurrence_count(s: h, pattern: "<h3>Project membership</h3>") == 1
        && occurrence_count(s: h, pattern: "class=\"issue-membership-tree\"") == 1
        && occurrence_count(s: h, pattern: "class=\"issue-membership-children\"") == 1
        && string_contains(s: h, pattern: "aria-current=\"true\" data-current=\"1\"")
        && occurrence_count(s: h, pattern: "href=\"/issue/issue-detail-parent\"") == 3
        && occurrence_count(s: h, pattern: "href=\"/issue/issue-detail-child\"") == 2
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">blocked by</span><span class=\"issue-field-value\"><button class=\"issue-rail-link\" type=\"button\" data-tab-chip=\"dependencies\">1 issue</button></span>")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">blocking</span><span class=\"issue-field-value\"><button class=\"issue-rail-link\" type=\"button\" data-tab-chip=\"dependencies\">1 issue</button></span>")
  }
}

// The assignment mapping after the legacy-session cleanup (owner 2026-09-26): when an attempt
// exists, the assignee renders as the WORKFLOW principal — a session or attempt key is not an
// identity and never surfaces as one (the attempt evidence lives in the Work tab); with no
// attempt it falls back to the standing's holder. The fixture view carries a claimed standing AND
// one supplied attempt here, so the Fabric chip wins.
test fn witness_issue_detail_attempt_does_not_invent_a_workflow_assignee() -> Bool {
  match try_serialize_html_source(node: fx_issue_detail_body(
    view: issue_detail_fixture_view(),
    panel: issue_detail_fixture_panel(),
    observation: gunbc.roadmap_presentation.ObservationsNominal,
    attempts: [ completed_attempt_progress(node_id: "issue-detail-specimen") ],
    events: [],
    viewer: "principal:google-oidc/accounts/sub-viewer",
    recents: [ fixture_teammate_legacy() ],
    expected_revision: "",
    command_context: IssueFormContext { operation: "", csrf: "" },
    profiles: [])) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let region = string_at(parts: split(s: string_at(parts: split(s: h, delimiter: "issue-field-label\">assignee"), index: 1), delimiter: "<form"), index: 0)
      !string_contains(s: region, pattern: "title=\"Fabric — fabric@gunb.ai\"")
        && !string_contains(s: region, pattern: "site-avatar site-avatar-workflow")
        && !string_contains(s: region, pattern: "feedface")
        && string_contains(s: h, pattern: "<span class=\"issue-field-label\">assignee</span>")
  }
}

// THE HISTORY TAB'S EVENT LEDGER (owner ruling 2026-09-24, moved to the History tab by the
// 2026-09-25 page architecture): the issue's durable event history renders one row per envelope,
// NEWEST FIRST by recorded_at — the envelope written at 03:00 heads the 02:00 and the 01:00, each
// row naming its author, kind, and payload. Execution evidence (attempts, rounds) stays on Work.
fn fx_event_envelope(id: String, at: String, kind: gunbc.roadmap.roadmap_event_log.RoadmapEventKind) -> gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
  gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
    id: id as gunbc.roadmap.roadmap_event_log.RoadmapEventId,
    event: gunbc.roadmap.roadmap_event_log.RoadmapEvent {
      node: "issue-detail-specimen" as gunbc.roadmap_model.RoadmapNodeId,
      author: gunbc.roadmap.roadmap_event_log.EventPrincipalAuthenticated { ref: fixture_human_ref() },
      parent: none,
      kind: kind,
      recorded_at: at,
    },
  }
}

fn fx_event_envelope_chained(id: String, parent: String, at: String, kind: gunbc.roadmap.roadmap_event_log.RoadmapEventKind) -> gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
  gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope {
    id: id as gunbc.roadmap.roadmap_event_log.RoadmapEventId,
    event: gunbc.roadmap.roadmap_event_log.RoadmapEvent {
      node: "issue-detail-specimen" as gunbc.roadmap_model.RoadmapNodeId,
      author: gunbc.roadmap.roadmap_event_log.EventPrincipalAuthenticated { ref: fixture_human_ref() },
      parent: Present { value: parent as gunbc.roadmap.roadmap_event_log.RoadmapEventId },
      kind: kind,
      recorded_at: at,
    },
  }
}

test fn witness_issue_history_tab_renders_event_history_newest_first() -> Bool {
  let events = [
    fx_event_envelope(id: "evt-one", at: "2026-09-24T01:00:00Z", kind: gunbc.roadmap.roadmap_event_log.Claimed { assignee: fixture_human_principal(), return_to: fixture_human_principal() }),
    fx_event_envelope_chained(id: "evt-two", parent: "evt-three", at: "2026-09-24T03:00:00Z", kind: gunbc.roadmap.roadmap_event_log.Progress { note: "kv receipts joined" as NonEmptyStr }),
    fx_event_envelope_chained(id: "evt-three", parent: "evt-one", at: "2026-09-24T02:00:00Z", kind: gunbc.roadmap.roadmap_event_log.Progress { note: "ranks realized" as NonEmptyStr }),
  ]
  match try_serialize_html_source(node: fx_issue_detail_body(
    view: issue_detail_fixture_view(),
    panel: issue_detail_fixture_panel(),
    observation: gunbc.roadmap_presentation.ObservationsNominal,
    attempts: [],
    events: events,
    viewer: "principal:google-oidc/accounts/sub-viewer",
    recents: [ fixture_teammate_legacy() ],
    expected_revision: "",
    command_context: IssueFormContext { operation: "", csrf: "" },
    profiles: [])) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      let work_parts = split(s: h, delimiter: "<section class=\"panel-history\">")
      count(work_parts) == 2
        && string_contains(s: string_at(parts: work_parts, index: 1), pattern: "<section class=\"panel-comments\">") == false
        && occurrence_count(s: string_at(parts: work_parts, index: 1), pattern: "class=\"issue-event-row\"") == 3
        && string_contains(s: string_at(parts: work_parts, index: 1), pattern: "data-event-kind=\"progress\">")
        && (match (split(s: string_at(parts: work_parts, index: 1), delimiter: "2026-09-24T03:00:00Z")).first() {
          Absent => false
          Present { value: _ } =>
            let after_three = string_at(parts: split(s: string_at(parts: work_parts, index: 1), delimiter: "2026-09-24T03:00:00Z"), index: 1)
            occurrence_count(s: after_three, pattern: "2026-09-24T02:00:00Z") == 1
              && (match (split(s: after_three, delimiter: "2026-09-24T02:00:00Z")).skip(n: 1).first() {
                Absent => false
                Present { value: after_two } => occurrence_count(s: after_two, pattern: "2026-09-24T01:00:00Z") == 1
              })
        })
  }
}

// THE COMMENT STREAM (A5 surface, owner mandate 2026-09-25): the description pins above a
// chronological stream — one row per comment, avatar-backed (author principal → display
// projection with initials fallback), the ordinal deep link on the row id AND the href, created
// and edited timestamps, the markdown body, the reply marker naming the comment answered, and the
// deleted tombstone with its ordinal RETAINED (the deep link stays addressed). The fixture: one
// root comment edited once, one reply, one deleted.
fn fx_comment_stream_events() -> List<gunbc.roadmap.roadmap_event_log.RoadmapEventEnvelope> {
  let c1 = fx_event_envelope(id: "cmt-1", at: "2026-09-24T01:00:00Z", kind: gunbc.roadmap.roadmap_event_log.CommentCreated { comment: "k1" as NonEmptyStr, body: "first **words**" as NonEmptyStr, visibility: "public" as NonEmptyStr, parent_comment: none })
  let e1 = fx_event_envelope_chained(id: "cmt-1e", parent: "cmt-1", at: "2026-09-24T01:30:00Z", kind: gunbc.roadmap.roadmap_event_log.CommentEdited { comment: "k1" as NonEmptyStr, body: "first **words** (edited)" as NonEmptyStr })
  let c2 = fx_event_envelope_chained(id: "cmt-2", parent: "cmt-1e", at: "2026-09-24T02:00:00Z", kind: gunbc.roadmap.roadmap_event_log.CommentCreated { comment: "k2" as NonEmptyStr, body: "a reply" as NonEmptyStr, visibility: "public" as NonEmptyStr, parent_comment: Present { value: "k1" as NonEmptyStr } })
  let c3 = fx_event_envelope_chained(id: "cmt-3", parent: "cmt-2", at: "2026-09-24T03:00:00Z", kind: gunbc.roadmap.roadmap_event_log.CommentCreated { comment: "k3" as NonEmptyStr, body: "gone" as NonEmptyStr, visibility: "public" as NonEmptyStr, parent_comment: none })
  let d3 = fx_event_envelope_chained(id: "cmt-3d", parent: "cmt-3", at: "2026-09-24T03:30:00Z", kind: gunbc.roadmap.roadmap_event_log.CommentDeleted { comment: "k3" as NonEmptyStr })
  [c1, e1, c2, c3, d3]
}

