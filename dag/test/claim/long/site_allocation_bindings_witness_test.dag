module test.claim.long.site_allocation_bindings_witness
import gunbc.site.controls { site_client_program }

import gunbc.site.client_bindings { client_program_free_names }
import gunbc.roadmap_allocation_client { allocation_client_program }
import extdeps.languages.typescript.program { TsProgram, Const }

// These are separate served scripts. Each must close over its own declarations and
// browser globals, rather than accidentally borrowing a declaration from the other.
data client_platform_names: List<String> = ["String", "encodeURIComponent", "Map", "Uint8Array", "crypto", "btoa", "setInterval", "Array", "CustomEvent", "AudioContext", "document", "window", "localStorage", "fetch", "Promise", "Error", "JSON", "Math", "Date", "console", "setTimeout", "clearTimeout", "true", "false", "null", "undefined"]

// The actual session owner, not an isomorphic fixture: remove its declaration to
// reproduce the observed defect. Application names are never platform names.
fn shell_free_names_without_session(remove_session: Bool) -> List<String> {
  let program = site_client_program()
  client_program_free_names(program: TsProgram {
    ts_nocheck: program.ts_nocheck,
    header_lines: program.header_lines,
    statements: filter(program.statements, s => match s {
      Const { name, value: _ } => !(remove_session && name == "gunbcSessionRead")
      _ => true
    }),
  }, platform_names: client_platform_names)
}

test fn allocation_client_has_no_unbound_names() -> Bool {
  client_program_free_names(program: allocation_client_program(), platform_names: client_platform_names) == []
}

test fn shell_client_has_no_unbound_names() -> Bool {
  shell_free_names_without_session(remove_session: false) == []
}

test fn deleting_session_binding_is_detected_in_real_program() -> Bool {
  let names = shell_free_names_without_session(remove_session: true)
  any(names, n => n == "gunbcSessionRead")
}
