module test.claim.long.walk_target_alias_apply_parse_witness

import tools.walk_target_alias_apply {
  alias_apply_parse_module_source,
  alias_apply_parse_module_tree_and_span,
  alias_apply_module_splice_offset,
  walk_target_alias_apply_module_fold,
  WalkTargetAliasModuleInput
}
import tools.walk_target_alias_plan {
  WalkTargetAliasPlanRow,
  WalkTargetAliasPlanRowKey,
  GlobalBareLcp
}
import v2.std.collection { Present, Absent, Optional, optional_absent, optional_present }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Node }
import v2.std.logic { Bool }
import std.types { list_length }
import v2.extdeps.languages.dag {
  parse_production_emitted_identity_optional,
  dag_language_model
}
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }

fn wtaa_find_import_node_in_children(tree: Node) -> Optional<Node> {
  fold(tree.children, init: optional_absent(), f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => wtaa_find_import_node(tree: edge.target)
    }
  })
}

fn wtaa_find_import_node(tree: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: tree) {
    Present { value: id } =>
      if id == ^dag_surface_import_decl {
        optional_present(value: tree)
      } else {
        wtaa_find_import_node_in_children(tree: tree)
      }
    Absent => wtaa_find_import_node_in_children(tree: tree)
  }
}

fn wtaa_fixture_has_import_decl(tree: Node) -> Bool {
  match wtaa_find_import_node(tree: tree) {
    Present { value: _ } => true
    Absent => false
  }
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wtaa_parse_lane_note: String = "Long-lane home for the parse-driven apply witnesses (operator 5s rule 2026-07-12): alias_apply_parse_module_artifact pulls the v2 tokenize/parse closure, whose eval cost alone exceeds the 5000ms fast-lane budget (CI receipt: 5014ms/5015ms censored at the cap, run 29956469084; ~11.4s measured locally). The row/oracle witnesses stay in test.claim.walk_target_alias_apply_witness_test (sub-ms)."

data wtaa_import_block_fixture_source: String = "module v2.test.walk_target_alias_apply.probe\nimport v2.std.algebra { Cons, Empty }\n"

data wtaa_no_import_fixture_source: String = "module v2.test.walk_target_alias_apply.noimports\n\ndata wtaa_probe_marker: Int = 1\n"

fn wtaa_probe_plan_row(declaring_module: String, binding: String, target: String) -> WalkTargetAliasPlanRow {
  WalkTargetAliasPlanRow {
    key: WalkTargetAliasPlanRowKey {
      class: GlobalBareLcp,
      declaring_module: declaring_module,
      binding: binding,
      walk_target_qualified_path: target
    },
    pre_flip_qualified_path: target,
    walk_verified: true,
    lookup_events: 1
  }
}

fn wtaa_parsed_fixture_has_import_decl_holds() -> Bool {
  match alias_apply_parse_module_source(
    text: wtaa_import_block_fixture_source,
    file_anchor: ^walk_target_alias_apply_insert_anchor_fixture
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: module_root, diagnostics: _ } =>
      wtaa_fixture_has_import_decl(tree: module_root)
  }
}

fn wtaa_splice_offset_after_import_block_holds() -> Bool {
  match alias_apply_parse_module_tree_and_span(
    text: wtaa_import_block_fixture_source,
    file_anchor: ^walk_target_alias_apply_splice_fixture
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: parsed, diagnostics: _ } =>
      match alias_apply_module_splice_offset(parsed: parsed) {
        Rejected { diagnostics: _ } => false
        Accepted { value: offset, diagnostics: _ } => offset == 82
      }
  }
}

fn wtaa_splice_offset_no_imports_after_header_holds() -> Bool {
  match alias_apply_parse_module_tree_and_span(
    text: wtaa_no_import_fixture_source,
    file_anchor: ^walk_target_alias_apply_no_import_fixture
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: parsed, diagnostics: _ } =>
      match alias_apply_module_splice_offset(parsed: parsed) {
        Rejected { diagnostics: _ } => false
        Accepted { value: offset, diagnostics: _ } => offset == 48
      }
  }
}

fn wtaa_module_fold_end_to_end_plans_edit() -> Bool {
  let module_input = WalkTargetAliasModuleInput {
    declaring_module: "v2.test.walk_target_alias_apply.probe",
    rel_source_path: "v2/test/walk_target_alias_apply/probe.dag",
    source_text: wtaa_import_block_fixture_source,
    rows: [
      wtaa_probe_plan_row(
        declaring_module: "v2.test.walk_target_alias_apply.probe",
        binding: "ProbeAlias",
        target: "test.aliasplan.near.AmbigType"
      )
    ]
  }
  match walk_target_alias_apply_module_fold(
    inputs: [module_input],
    source_scope_label: "end-to-end-fixture",
    write_requested: false
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: report, diagnostics: _ } =>
      (list_length(items: report.edits) == 1)
        && (list_length(items: report.splices) == 1)
        && (list_length(items: report.refused) == 0)
        && (report.skipped_existing == 0)
        && fold(report.splices, init: false, f: fn(_, splice) {
             (splice.splice_offset == 82)
               && string_contains(s: splice.insert_text, pattern: "alias ProbeAlias")
               && string_contains(s: splice.insert_text, pattern: "test.aliasplan.near.AmbigType")
           })
        && fold(report.edits, init: false, f: fn(_, edit) {
             string_contains(s: edit.alias_line, pattern: "alias ProbeAlias = test.aliasplan.near.AmbigType")
               && !edit.written
           })
  }
}

data wtaa_existing_alias_fixture_source: String = "module v2.test.walk_target_alias_apply.present\nimport v2.std.algebra { Cons, Empty }\nalias ProbeAlias = test.aliasplan.near.AmbigType\n"

fn wtaa_module_fold_skips_existing_alias() -> Bool {
  let module_input = WalkTargetAliasModuleInput {
    declaring_module: "v2.test.walk_target_alias_apply.present",
    rel_source_path: "v2/test/walk_target_alias_apply/present.dag",
    source_text: wtaa_existing_alias_fixture_source,
    rows: [
      wtaa_probe_plan_row(
        declaring_module: "v2.test.walk_target_alias_apply.present",
        binding: "ProbeAlias",
        target: "test.aliasplan.near.AmbigType"
      )
    ]
  }
  match walk_target_alias_apply_module_fold(
    inputs: [module_input],
    source_scope_label: "skip-existing-fixture",
    write_requested: false
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: report, diagnostics: _ } =>
      (report.skipped_existing == 1)
        && (list_length(items: report.edits) == 0)
        && (list_length(items: report.splices) == 0)
        && (list_length(items: report.refused) == 0)
  }
}

test fn walk_target_alias_apply_parse_fixture_holds() -> Bool {
  match alias_apply_parse_module_source(
    text: wtaa_import_block_fixture_source,
    file_anchor: ^walk_target_alias_apply_insert_anchor_fixture
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn walk_target_alias_apply_parsed_import_decl_tree_fact_holds() -> Bool {
  wtaa_parsed_fixture_has_import_decl_holds()
}

test fn walk_target_alias_apply_splice_offset_import_block_holds() -> Bool {
  wtaa_splice_offset_after_import_block_holds()
}

test fn walk_target_alias_apply_splice_offset_no_imports_holds() -> Bool {
  wtaa_splice_offset_no_imports_after_header_holds()
}

test fn walk_target_alias_apply_module_fold_end_to_end_holds() -> Bool {
  wtaa_module_fold_end_to_end_plans_edit()
}

test fn walk_target_alias_apply_module_fold_skips_existing_holds() -> Bool {
  wtaa_module_fold_skips_existing_alias()
}
