module test.claim.gunb_ai_frontend_mark_witness_test

import std.types { Bool, List }
import std.nat { Nat }
import std.measure { Micrometer, micrometer, micrometer_count }
import extdeps.gunb_ai.frontend {
  MarkFrameLength, frame_length, frame_length_tenths, mark_frame_span,
  MarkFeature, MarkRoundedRect, MarkCircle,
  mark_body, mark_eye_left, mark_eye_right, mark_mouth,
  StoicGiantMark, gunb_stoic_giant_mark,
  MarkScale, MarkScaleExact, MarkScaleNotDivisible, MarkScaleRatio, mark_scale_ratio_value,
  mark_scale_for_width, scale_frame_length,
}

// THE TRANSFORM IS THE THING MOST LIKELY TO BE WRONG, so it is asserted at both ends. The SVG
// authors the body at x 10..110 inside a 0..120 viewBox -- INSET on both sides. Only after
// translate(-12 -12) scale(1.2) does it span the frame exactly. A witness that merely checked the
// body was "about right" would pass on the untransformed coordinates too.
test fn w_the_body_spans_the_full_declared_frame() -> Bool {
  match mark_body {
    MarkCircle { center_x: cx, center_y: cy, radius: r } => false
    MarkRoundedRect { x: x, y: y, width: w, height: h, corner_radius: cr } =>
      frame_length_tenths(l: x) == 0
        && frame_length_tenths(l: w) == mark_frame_span
        && frame_length_tenths(l: y) == 120
        && frame_length_tenths(l: h) == 960
  }
}

// A face whose eyes are not symmetric is wrong in a way no dimension check would catch: both eyes
// could be individually plausible and the mark still lopsided. This asserts the PAIR.
test fn w_the_eyes_are_symmetric_about_the_frame_centre() -> Bool {
  match mark_eye_left {
    MarkRoundedRect { x: a, y: b, width: c, height: d, corner_radius: e } => false
    MarkCircle { center_x: lx, center_y: ly, radius: lr } =>
      match mark_eye_right {
        MarkRoundedRect { x: a, y: b, width: c, height: d, corner_radius: e } => false
        MarkCircle { center_x: rx, center_y: ry, radius: rr } =>
          frame_length_tenths(l: lx) + frame_length_tenths(l: rx) == mark_frame_span
            && frame_length_tenths(l: ly) == frame_length_tenths(l: ry)
            && frame_length_tenths(l: lr) == frame_length_tenths(l: rr)
      }
  }
}

// 60 mm is the declared insert width BECAUSE it divides: 60000 um over 1200 tenths is exactly 50.
test fn w_sixty_millimetres_scales_to_exactly_fifty_micrometres_per_tenth() -> Bool {
  match mark_scale_for_width(width: micrometer(count: 60000)) {
    MarkScaleNotDivisible { requested_width: w, frame_span: s, remainder: r } => false
    MarkScaleExact { ratio: per } =>
      mark_scale_ratio_value(r: per) == 50
        && micrometer_count(m: scale_frame_length(ratio: per, l: frame_length(tenths: mark_frame_span))) == 60000
  }
}

// THE DISCRIMINATING RED. 50 mm is a perfectly reasonable-sounding insert width and it does NOT
// divide 1200: 50000/1200 leaves 800. Without this arm the scale would round every feature
// independently and a circle would stop being concentric with the opening it sits in.
test fn w_a_width_that_does_not_divide_the_frame_refuses() -> Bool {
  match mark_scale_for_width(width: micrometer(count: 50000)) {
    MarkScaleExact { ratio: per } => false
    MarkScaleNotDivisible { requested_width: w, frame_span: s, remainder: r } =>
      r == 800 && s == mark_frame_span && micrometer_count(m: w) == 50000
  }
}

// EXTENTS ON BOTH AXES. An earlier form of this pair computed x only, and the containment witness
// below compared it against the FRAME span rather than the body -- which review caught. The body is
// inset vertically (y 120..1080), so a feature at y 0 sits outside it while lying inside the frame,
// and the check would have passed on exactly the case it is named for.
fn feature_min_x(f: MarkFeature) -> Nat {
  match f {
    MarkRoundedRect { x: x, y: y, width: w, height: h, corner_radius: cr } => frame_length_tenths(l: x)
    MarkCircle { center_x: cx, center_y: cy, radius: r } =>
      frame_length_tenths(l: cx) - frame_length_tenths(l: r)
  }
}

fn feature_max_x(f: MarkFeature) -> Nat {
  match f {
    MarkRoundedRect { x: x, y: y, width: w, height: h, corner_radius: cr } =>
      frame_length_tenths(l: x) + frame_length_tenths(l: w)
    MarkCircle { center_x: cx, center_y: cy, radius: r } =>
      frame_length_tenths(l: cx) + frame_length_tenths(l: r)
  }
}

fn feature_min_y(f: MarkFeature) -> Nat {
  match f {
    MarkRoundedRect { x: x, y: y, width: w, height: h, corner_radius: cr } => frame_length_tenths(l: y)
    MarkCircle { center_x: cx, center_y: cy, radius: r } =>
      frame_length_tenths(l: cy) - frame_length_tenths(l: r)
  }
}

fn feature_max_y(f: MarkFeature) -> Nat {
  match f {
    MarkRoundedRect { x: x, y: y, width: w, height: h, corner_radius: cr } =>
      frame_length_tenths(l: y) + frame_length_tenths(l: h)
    MarkCircle { center_x: cx, center_y: cy, radius: r } =>
      frame_length_tenths(l: cy) + frame_length_tenths(l: r)
  }
}

// The BODY's own extents, read from the body rather than restated. A literal here would be a second
// authority for the rectangle the module already declares, and would keep passing if the body moved.
fn body_bounds_hold(min_x: Nat, max_x: Nat, min_y: Nat, max_y: Nat) -> Bool {
  match mark_body {
    MarkCircle { center_x: cx, center_y: cy, radius: r } => false
    MarkRoundedRect { x: bx, y: by, width: bw, height: bh, corner_radius: bcr } =>
      min_x >= frame_length_tenths(l: bx)
        && max_x <= frame_length_tenths(l: bx) + frame_length_tenths(l: bw)
        && min_y >= frame_length_tenths(l: by)
        && max_y <= frame_length_tenths(l: by) + frame_length_tenths(l: bh)
  }
}

fn feature_inside_body(f: MarkFeature) -> Bool {
  body_bounds_hold(
    min_x: feature_min_x(f: f), max_x: feature_max_x(f: f),
    min_y: feature_min_y(f: f), max_y: feature_max_y(f: f),
  )
}

// Every cut must land in material. A feature outside the body would be an opening cut through air --
// on screen a stray dot, in plastic a hole in the board the insert is supposed to cover.
test fn w_every_feature_lies_inside_the_body() -> Bool {
  let inside = gunb_stoic_giant_mark.features |> filter(f => feature_inside_body(f: f)) |> count
  let total = gunb_stoic_giant_mark.features |> count
  total == 3 && inside == total
}

// THE DISCRIMINATING RED FOR THE CHECK ABOVE, which it did not have. A feature straddling y 120
// lies inside the FRAME and outside the BODY, so it separates the two readings: under the previous
// frame-relative comparison it would have been reported as contained.
//
// ITS CENTRE IS 100 AND NOT 0, AND THAT IS NOT A COSMETIC CHOICE. The first version centred it at
// y 0 with radius 96, so feature_min_y evaluated 0 - 96 on a Nat. Probing the substrate directly
// shows that expression does NOT saturate to zero -- it yields a NEGATIVE value, so `Nat` is not a
// runtime wall here. The witness then reported "not contained" because a negative is below the
// body's lower bound, which is the right verdict reached through a meaningless intermediate: the
// test would have kept passing if the containment rule were rewritten, and would have flipped if
// the substrate ever made that subtraction refuse.
//
// At centre 100 radius 96 the extents are 4..196, computed without underflow, and 4 is genuinely
// below the body's 120. The arm is exercised by arithmetic that means what it says.
data mark_feature_above_the_body: MarkFeature = MarkCircle {
  center_x: frame_length(tenths: 600),
  center_y: frame_length(tenths: 100),
  radius: frame_length(tenths: 96),
}

test fn w_a_feature_inside_the_frame_but_above_the_body_is_not_contained() -> Bool {
  feature_inside_body(f: mark_feature_above_the_body) == false
    && feature_min_x(f: mark_feature_above_the_body) >= 0
    && feature_max_x(f: mark_feature_above_the_body) <= mark_frame_span
}
