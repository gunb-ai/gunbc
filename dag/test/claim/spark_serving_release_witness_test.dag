module test.claim.spark_serving_release_witness_test

import std.types { String, Bool, List, Int, NonEmptyStr }
import std.measure { byte_size }
import gunbc.spark_serving_release {
  SparkServingReleaseIdentity, SparkServingOccurrence, SecretVersionRef,
  SparkServingRelease, RuntimeArtifactIdentity, ModelArtifactIdentity,
  ServingConfigurationIdentity, InferenceCapacityPolicy, spark_serving_release_identity,
  SparkServingReconciliation, SparkServingAlreadyConverged, SparkServingDeltaRequired,
  SparkServingInstallRequired,
  SparkServingRefused, SparkServingRefusal,
  SparkServingObservation, SparkServingObserved, SparkServingObservationRefused,
  SparkServingAbsent,
  SparkServingPrerequisite, PrerequisiteAbsent, ManagedHostAccessGrounded,
  reconcile_spark_serving,
  spark_serving_may_actuate, spark_occurrences_share_release,
}

fn release_base() -> SparkServingRelease {
  SparkServingRelease { runtime: RuntimeArtifactIdentity { closure_digest: "closure-1" }, model: ModelArtifactIdentity { repository: "Qwen/Qwen2.5-7B-Instruct", revision: "a09a35458c702b33eeacc393d103063234e8bc28" }, serving_configuration: ServingConfigurationIdentity { configuration_digest: "cfg-1" }, capacity: InferenceCapacityPolicy { max_model_len: 4096, shared_memory_budget_bytes: byte_size(127600816) } }
}

fn release_other_revision() -> SparkServingRelease {
  SparkServingRelease { runtime: RuntimeArtifactIdentity { closure_digest: "closure-1" }, model: ModelArtifactIdentity { repository: "Qwen/Qwen2.5-7B-Instruct", revision: "0000000000000000000000000000000000000000" }, serving_configuration: ServingConfigurationIdentity { configuration_digest: "cfg-1" }, capacity: InferenceCapacityPolicy { max_model_len: 4096, shared_memory_budget_bytes: byte_size(127600816) } }
}

fn release_other_capacity() -> SparkServingRelease {
  SparkServingRelease { runtime: RuntimeArtifactIdentity { closure_digest: "closure-1" }, model: ModelArtifactIdentity { repository: "Qwen/Qwen2.5-7B-Instruct", revision: "a09a35458c702b33eeacc393d103063234e8bc28" }, serving_configuration: ServingConfigurationIdentity { configuration_digest: "cfg-1" }, capacity: InferenceCapacityPolicy { max_model_len: 8192, shared_memory_budget_bytes: byte_size(127600816) } }
}

// CONTROL 5: the identity is a FUNCTION OF THE RELEASE, both directions. An independently
// constructed but identical release yields the IDENTICAL digest, and changing any single input --
// here the model revision, and separately the capacity -- CHANGES it. Without the second direction
// a constant function passes; without the first, a nondeterministic one does.
fn digest_of(spec: SparkServingRelease) -> String {
  spark_serving_release_identity(spec: spec).digest.digest as String
}

test fn release_identity_is_derived_not_authored() -> Bool {
  digest_of(spec: release_base()) == digest_of(spec: release_base())
    && digest_of(spec: release_base()) != digest_of(spec: release_other_revision())
    && digest_of(spec: release_base()) != digest_of(spec: release_other_capacity())
}

fn refusal_specimen() -> SparkServingReconciliation {
  SparkServingRefused { first: SparkServingRefusal { subject: "srv5", cause: "managed automation principal absent" }, more: [SparkServingRefusal { subject: "srv5", cause: "host key has no independent anchor" }] }
}

fn occ_srv5() -> SparkServingOccurrence {
  SparkServingOccurrence { host: "srv5", release_identity: spark_serving_release_identity(spec: release_base()), endpoint_credential: SecretVersionRef { secret: "spark-serving-api-key", version: "3" } }
}

fn occ_srv6_same() -> SparkServingOccurrence {
  SparkServingOccurrence { host: "srv6", release_identity: spark_serving_release_identity(spec: release_base()), endpoint_credential: SecretVersionRef { secret: "spark-serving-api-key", version: "3" } }
}

fn occ_srv6_other() -> SparkServingOccurrence {
  SparkServingOccurrence { host: "srv6", release_identity: spark_serving_release_identity(spec: release_other_revision()), endpoint_credential: SecretVersionRef { secret: "spark-serving-api-key", version: "3" } }
}

// BOTH prerequisites, and both naming srv5. This list previously carried only the managed-access
// row, and the reconciler passed anyway -- because it checked only for an explicit absence, so a
// prerequisite nobody had recorded read as one that held.
data grounded_prereqs: List<SparkServingPrerequisite> = [HostIdentityBindingAdmitted { host: "srv5" }, ManagedHostAccessGrounded { host: "srv5" }]

data no_prereqs: List<SparkServingPrerequisite> = []

// Both prerequisites grounded, both for the WRONG host.
data grounded_prereqs_srv6: List<SparkServingPrerequisite> = [HostIdentityBindingAdmitted { host: "srv6" }, ManagedHostAccessGrounded { host: "srv6" }]

fn observed_on_srv6() -> SparkServingObservation {
  SparkServingObserved { host: "srv6", loaded_release: spark_serving_release_identity(spec: release_base()) }
}

data absent_prereqs: List<SparkServingPrerequisite> = [PrerequisiteAbsent { host: "srv5", requirement: "managed automation principal", cause: "only the human bootstrap account is admitted" }]

fn observed_matching() -> SparkServingObservation {
  SparkServingObserved { host: "srv5", loaded_release: spark_serving_release_identity(spec: release_base()) }
}

fn observed_other() -> SparkServingObservation {
  SparkServingObserved { host: "srv5", loaded_release: spark_serving_release_identity(spec: release_other_revision()) }
}

fn observation_absent() -> SparkServingObservation {
  SparkServingAbsent { host: "srv5" }
}

fn observation_absent_wrong_host() -> SparkServingObservation {
  SparkServingAbsent { host: "srv6" }
}

fn observation_refused() -> SparkServingObservation {
  SparkServingObservationRefused { host: "srv5", cause: "loaded revision not observable from the unit MainPID" }
}

fn reconcile_arm(observation: SparkServingObservation, prereqs: List<SparkServingPrerequisite>) -> String {
  match reconcile_spark_serving(desired: occ_srv5(), observation: observation, prerequisites: prereqs) {
    SparkServingAlreadyConverged { converged_release: _ } => "converged"
    SparkServingInstallRequired { subject: _, desired_release: _ } => "install"
    SparkServingDeltaRequired { plan_subject: _ } => "delta"
    SparkServingRefused { first: _, more: _ } => "refused"
  }
}

// CONTROL 6: THE MECHANISM DISCRIMINATES. A matching observation converges, a differing one
// requires a delta. Without both, the reconciler could be a constant and every other control here
// would still pass -- which is exactly how a structural no-op becomes a shape with nothing behind
// it.
test fn reconciliation_discriminates_matching_from_differing() -> Bool {
  reconcile_arm(observation: observed_matching(), prereqs: grounded_prereqs) == "converged"
    && reconcile_arm(observation: observed_other(), prereqs: grounded_prereqs) == "delta"
}

// CONTROL 7: AN UNOBSERVABLE HOST REFUSES, IT DOES NOT READ AS DRIFT. "We could not see what is
// loaded" and "what is loaded is wrong" have different remedies, and answering the first with a
// delta would send an actuator to rewrite a host nobody could observe.
test fn unobservable_host_refuses_rather_than_drifting() -> Bool {
  reconcile_arm(observation: observation_refused(), prereqs: grounded_prereqs) == "refused"
}

// CONTROL 8: PREREQUISITES ARE CHECKED FIRST. A host missing its managed principal refuses even
// when the observation would otherwise CONVERGE -- comparing state on a host we have no grounded
// way to reach answers a question we cannot ask, and letting a convergent-looking observation
// override a missing prerequisite is how an ungrounded host reports as fine.
test fn missing_prerequisite_refuses_even_when_observation_matches() -> Bool {
  reconcile_arm(observation: observed_matching(), prereqs: absent_prereqs) == "refused"
}

// CONTROL 9: THE OBSERVATION'S SUBJECT IS BOUND. srv5 and srv6 are deliberately configured to
// share one release identity, so a digest comparison alone CANNOT tell the two apart -- an
// observation taken on srv6 satisfied srv5's desired occurrence, and the matching digest is
// precisely what made the swapped subject invisible. This is the copied-receipt class: a receipt
// produced for one host consumed as another's answer with nothing to detect the swap. It refuses
// rather than converging, and refuses rather than reporting a delta, because the subject being
// wrong is not evidence about what srv5 is running.
test fn observation_from_the_other_replica_cannot_satisfy_this_one() -> Bool {
  reconcile_arm(observation: observed_on_srv6(), prereqs: grounded_prereqs) == "refused"
}

// CONTROL 10: SILENCE IS NOT CONSENT. An empty prerequisite list contains no absent row, so a
// reconciler that checks only for explicit absence converges on a host for which nothing was ever
// established. "Nobody recorded a prerequisite for srv5" and "srv5's prerequisites hold" are
// different states, and the first must not reach an actuator.
test fn absent_prerequisite_records_do_not_read_as_satisfied() -> Bool {
  reconcile_arm(observation: observed_matching(), prereqs: no_prereqs) == "refused"
}

// CONTROL 11: PREREQUISITES ARE BOUND TO THEIR SUBJECT TOO. Grounding srv6 does not ground srv5.
// Without this, the two-replica fleet grounds itself: whichever host was established first would
// silently authorize convergence on the other.
test fn the_other_replica_grounding_does_not_ground_this_one() -> Bool {
  reconcile_arm(observation: observed_matching(), prereqs: grounded_prereqs_srv6) == "refused"
}

// CONTROL 1: the no-op is STRUCTURAL. A converged host cannot reach an actuator, and the arm that
// represents it carries no effect plan at all -- there is no field through which a write could be
// smuggled. This is the property the bmc_*_reconciled_policy no-op write lacks, where both arms
// return the policy and an already-converged policy is rewritten on every converge.
test fn converged_cannot_actuate() -> Bool {
  !spark_serving_may_actuate(reconciliation: SparkServingAlreadyConverged { converged_release: spark_serving_release_identity(spec: release_base()) })
}

// CONTROL 2: the POSITIVE direction. Without it, control 1 passes against a function hardwired to
// return false -- and a route that can never actuate is not a route. Both directions or the
// function is a name.
test fn delta_required_may_actuate() -> Bool {
  spark_serving_may_actuate(reconciliation: SparkServingDeltaRequired { plan_subject: "install pinned runtime" })
}

// CONTROL 3: a refusal is not a quiet no-op. It must be non-actuating for a DIFFERENT reason than
// convergence, and it carries its causes rather than collapsing to a bare false.
test fn refusal_cannot_actuate() -> Bool {
  !spark_serving_may_actuate(reconciliation: refusal_specimen())
}

// CONTROL 4: exact replication is ONE comparison at the release digest. Two hosts sharing a
// release identity are replicas; differing digests are not, and the check cannot be weakened one
// field at a time the way a field-wise conjunction can.
test fn occurrences_replicate_exactly_when_release_identity_agrees() -> Bool {
  spark_occurrences_share_release(a: occ_srv5(), b: occ_srv6_same())
  && !spark_occurrences_share_release(a: occ_srv5(), b: occ_srv6_other())
}


// AN ABSENT HOST PROPOSES AN INSTALL, and this is the state both Sparks are actually in. Before the
// SparkServingAbsent arm existed this reconciliation was unreachable: nothing serving on the host
// could only be reported as an observation refusal, which answers "refused", so the first install
// on a clean machine had no route through the fold at all.
test fn w_a_host_serving_nothing_reconciles_to_install_required() -> Bool {
  reconcile_arm(observation: observation_absent(), prereqs: grounded_prereqs) == "install"
}

// THE DISCRIMINATING PAIR: absence and unobservability are different answers. If these ever agree,
// the arm added here has collapsed back into the refusal it was split out of.
test fn w_absence_and_unobservability_do_not_agree() -> Bool {
  reconcile_arm(observation: observation_absent(), prereqs: grounded_prereqs) != reconcile_arm(observation: observation_refused(), prereqs: grounded_prereqs)
}

// THE SUBJECT GUARD APPLIES TO THE NEW ARM TOO. srv6 reporting itself absent must not authorize an
// install on srv5 -- the copied-receipt class the host_matches guard exists to refuse, which a new
// observation arm could silently escape by not consulting it.
test fn w_another_hosts_absence_does_not_authorize_this_hosts_install() -> Bool {
  reconcile_arm(observation: observation_absent_wrong_host(), prereqs: grounded_prereqs) == "refused"
}

// An install-required reconciliation MAY actuate: it is a real delta, not a no-op and not a refusal.
test fn w_install_required_may_actuate() -> Bool {
  spark_serving_may_actuate(reconciliation: SparkServingInstallRequired {
    subject: "srv5",
    desired_release: spark_serving_release_identity(spec: release_base()),
  })
}
