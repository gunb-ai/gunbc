// THE ADMITTED RESIDUAL, AS THE CORPUS WRITES IT: a match binding over a generic builtin's result (list_find_first,
// map_get_checked) carries the callee's uninstantiated parameter and is unjudged until pattern bindings carry the
// instantiated type (C1.2c + C1.2d). These two are the positive controls for the keyed exclusion at the corpus shape.
fn ut_find_first_binding_source() -> String {
  "module ut.probe\n\nimport std.algebra { list_find_first, trim }\nimport std.optional { Absent, Optional, Present, optional_absent, optional_present }\n\nfn probe(content: String) -> Optional<String> {\n  match list_find_first(xs: split(s: content, delimiter: \"\\n\"), predicate: fn(line) { starts_with(s: trim(line), prefix: \"module \") }) {\n    Absent => optional_absent()\n    Present { value: line } => optional_present(value: trim(line))\n  }\n}\n"
}

test fn ut_find_first_binding_at_string_formal_is_the_admitted_residual() -> Bool {
  compile_dag_rust_emit_check(ut_find_first_binding_source(), "src/ut_probe.rs", [], [])
}

fn ut_map_get_checked_binding_source() -> String {
  "module ut.probe\n\nimport v2.std.witness { map_get_checked }\nimport std.algebra { trim }\nimport std.types { Map }\nimport std.optional { Present }\nimport v2.std.diagnostic { Accepted }\n\nfn probe(m: Map<String, String>, k: String) -> String {\n  match map_get_checked(m, k) {\n    Accepted { value: Present { value: v }, diagnostics: _ } => trim(v)\n    _ => k\n  }\n}\n"
}

test fn ut_map_get_checked_binding_at_string_formal_is_the_admitted_residual() -> Bool {
  compile_dag_rust_emit_check(ut_map_get_checked_binding_source(), "src/ut_probe.rs", [], [])
}

// THE BUILT-IN CONTAINER AT A NON-MATCHING DECLARED HEAD (gunbc.recurring_failure_mode
// declared_type_wall_keyed_on_the_value_being_a_kernel, specimen seven). A produced List/Map/Optional
// head left every position's judgment because the nominal-product relation excludes the container
// carriers and the kernel relation read the value as a kernel. Each RED is a fixture compiled whole,
// paired with an accepted control at the same position.
//  (a) a Map<K, V> formal given an Optional actual     (call argument)
//  (b) a List<T> formal given a Map actual             (call argument)
//  (c) a raw List<String> in a record field declared as the nonempty carrier that RungDropPopulation's
//      Enumerated variant holds (FreeSemigroup<String>; row falsifier_rehomed_rows_unexecuted), control: a
//      FreeSemigroup value (record field). The RungDropPopulation spelling itself is not authorable until the
//      gunbc.rung_drop import closure compiles in the probe harness (C1.2d).
fn ut_map_formal_optional_actual_source() -> String {
  "module ut.probe\n\nimport std.optional { Optional }\n\nfn takes_map<K, V>(m: Map<K, V>) -> Int {\n  0\n}\n\nfn probe(o: Optional<Int>) -> Int {\n  takes_map(m: o)\n}\n"
}

fn ut_map_formal_map_actual_source() -> String {
  "module ut.probe\n\nfn takes_map<K, V>(m: Map<K, V>) -> Int {\n  0\n}\n\nfn probe(o: Map<Int, Int>) -> Int {\n  takes_map(m: o)\n}\n"
}

fn ut_list_formal_map_actual_source() -> String {
  "module ut.probe\n\nfn takes_list<T>(xs: List<T>) -> Int {\n  0\n}\n\nfn probe(m: Map<String, String>) -> Int {\n  takes_list(xs: m)\n}\n"
}

fn ut_list_formal_list_actual_source() -> String {
  "module ut.probe\n\nfn takes_list<T>(xs: List<T>) -> Int {\n  0\n}\n\nfn probe(m: List<String>) -> Int {\n  takes_list(xs: m)\n}\n"
}

fn ut_population_field_raw_list_source() -> String {
  "module ut.probe\n\nimport std.algebra { FreeSemigroup }\n\ntype Pop\n  = Enumerated { members: FreeSemigroup<String> }\n  | NotYetCounted { n: Int }\n\ntype PopulationHolder { population: Pop }\n\nfn probe(xs: List<String>) -> PopulationHolder {\n  PopulationHolder { population: xs }\n}\n"
}

fn ut_population_field_nonempty_source() -> String {
  "module ut.probe\n\nimport std.algebra { FreeSemigroup }\n\ntype Pop\n  = Enumerated { members: FreeSemigroup<String> }\n  | NotYetCounted { n: Int }\n\ntype PopulationHolder { population: Pop }\n\nfn probe(h: String, t: List<String>) -> PopulationHolder {\n  PopulationHolder { population: Enumerated { members: FreeSemigroup { head: h, tail: t } } }\n}\n"
}

test fn ut_map_formal_optional_actual_must_refuse() -> Bool {
  !compile_dag_rust_emit_check(ut_map_formal_optional_actual_source(), "src/ut_probe.rs", [], [])
}

test fn ut_map_formal_map_actual_still_compiles() -> Bool {
  compile_dag_rust_emit_check(ut_map_formal_map_actual_source(), "src/ut_probe.rs", [], [])
}

test fn ut_list_formal_map_actual_must_refuse() -> Bool {
  !compile_dag_rust_emit_check(ut_list_formal_map_actual_source(), "src/ut_probe.rs", [], [])
