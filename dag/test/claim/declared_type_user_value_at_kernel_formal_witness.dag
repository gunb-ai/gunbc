fn ut_named_t_control_source() -> String {
  "module ut.probe\n\ntype T {\n  value: Int\n}\n\nfn takes(x: T) -> T {\n  x\n}\n\nfn probe(q: T) -> T {\n  takes(x: q)\n}\n"
