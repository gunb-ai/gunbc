}

test fn ut_raw_list_in_population_field_must_refuse() -> Bool {
  !compile_dag_rust_emit_check(ut_population_field_raw_list_source(), "src/ut_probe.rs", [], [])
}

test fn ut_nonempty_in_population_field_still_compiles() -> Bool {
  compile_dag_rust_emit_check(ut_population_field_nonempty_source(), "src/ut_probe.rs", [], [])
}
