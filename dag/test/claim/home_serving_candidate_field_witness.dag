module test.claim.home_serving_candidate_field_witness

// THE WITNESS FOR THE P4 SELECTION FOLD (dag/gunbc/serving/home_serving_candidate_field.dag).
//
// WHAT THIS IS FOR. DESIGN.md §5: "A claim is a check someone can make, and the check must be SEEN
// executing." The fold's comments say what it refuses; comments are not evidence. Each claim below
// calls the fold and inspects the verdict the kernel actually returned, so a change that turns a
// refusal into a fabricated purchase recommendation — or a refusal into a silent empty field — goes
// red here.
//
// WHAT THE HONEST STATE ACTUALLY IS, AND WHY THESE CLAIMS SAY THAT AND NOT "pick a card".
// No receipt records an operator-applied power limit on any of these cards (the P4 plan states it:
// "(2) No receipt anywhere records an applied power limit", confirmed by the sealed policy's own
// AppliedStandingUnstated arm being what fires). So every card x rung cell is a PLANNED sweep value
// whose watt is UNREAD. std.pareto is explicit about what an entry does with that: a nonempty
// missing_inputs "states what is absent instead of substituting a zero or an average", and
// std.decision's scan_feasibility answers a declared gap with SelectionNeedsEvidence carrying the
// cause. So today's verdict is the instrument's OWN REFUSAL, and pinning THAT green is the point.
// It is not "no candidates": sixteen candidates are offered, each with its gap. The distinction is
// the whole content of this witness — see the pair of claims 3 and 4.
//
// EVERY CLAIM CAN FAIL, AND THE PAIRS ARE WHAT MAKE THAT MEANINGFUL. A single red claim proves
// nothing about which guard is doing the work, so each refusal sits beside its inverse:
//   live field needs evidence (3)      vs  the same field is never a pick, never "empty" (4)
//   hand-built tie needs policy (5)    vs  hand-built pair IS selected (6)
//   read candidate excluded (7)        vs  unread candidate is NOT excluded by an unread bound (8)
//   roster rows all present (11)       vs  an SXM reference never enters (12)
// Without the inverse, "always refuses" and "correctly refuses" look identical — the failure mode
// this lane was filed for once already (a control that could not fail). A claim over an EMPTY list
// is the same trap in a different costume: every `all(...)` below is preceded by a count check, so
// a field that silently empties goes red instead of green.
//
// WHAT IT DELIBERATELY DOES NOT CLAIM. It never asserts a card was bought, installed, or measured,
// and it never funds throughput: no WarmValid exists (extdeps.ninfer.replayed_tokens_total is
// TranscribedUncited and no home host has a GPU to observe one), so a watt-ranked pick is all this
// fold may say.
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.nat { Nat }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.algebra { string_contains }
import std.measure { watt_count }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.interval { degenerate_interval }
import std.pareto { AxisGap, AxisReading, ParetoEntry }
import std.decision {
  NoFeasibleRealization,
  SelectedWithin,
  SelectionNeedsEvidence,
  SelectionNeedsPolicy,
  SelectionPolicy,
  UniqueSurvivorRequired,
  UnfundedAxis,
}
import gunbc.serving.home_serving_candidate_field {
  HomeServingBuyerTerms,
  home_serving_applied_rung_watts,
  ax_applied_draw_watts,
  home_serving_candidate_field,
  home_serving_selection_for,
  home_serving_sxm_rows_are_not_candidates,
  select_home_serving_candidate,
}
import gunbc.serving.home_serving_accelerator_field { home_serving_add_in_card_catalog_rows, home_serving_reference_sxm_catalog_rows }

// ── FIXTURES (test.claim.* may state buyer terms the production module must not hard-code) ─────
data hscf_roomy: HomeServingBuyerTerms = HomeServingBuyerTerms { max_applied_watts: 600 }
data hscf_ceiling_350: HomeServingBuyerTerms = HomeServingBuyerTerms { max_applied_watts: 350 }
data hscf_ceiling_100: HomeServingBuyerTerms = HomeServingBuyerTerms { max_applied_watts: 100 }

fn hscf_live() -> List<ParetoEntry> = home_serving_candidate_field()


fn hscf_display(e: ParetoEntry) -> String = e.display_label as String


fn hscf_entry(ref: DeclarationRef, label: String, watts: Nat) -> ParetoEntry {
  ParetoEntry {
    identity: ref,
    display_label: label as NonEmptyStr,
    readings: [AxisReading { axis: ax_applied_draw_watts, interval_micro: degenerate_interval(point: watts as Int) }],
    missing_inputs: [],
  }
}


data hscf_probe_a: DeclarationRef = decl_ref(module_path: "test.claim.home_serving_candidate_field_witness", decl_name: "hscf_probe_a")
data hscf_probe_b: DeclarationRef = decl_ref(module_path: "test.claim.home_serving_candidate_field_witness", decl_name: "hscf_probe_b")

data hscf_no_policy_identity: DeclarationRef = decl_ref(module_path: "test.claim.home_serving_candidate_field_witness", decl_name: "hscf_no_policy_identity")

// UniqueSurvivorRequired is the arm that says "refuse to guess": one survivor or none, never a coin
// flip. Its identity names THIS fixture module, because the policy under test is the question this
// witness asks, not a production policy — production states none, and this module must not be able to
// pass as the seat of one.
fn hscf_no_policy() -> SelectionPolicy = UniqueSurvivorRequired { identity: hscf_no_policy_identity }

// ── 1. THE FIELD IS OFFERED WITH ITS GAPS, NOT WITHHELD ────────────────────────────────────────
// FOUR cards x FOUR rungs = sixteen cells, and all sixteen are OFFERED. This is the claim that the
// fold does not silence the sweep: before the gap was carried through, the unread cells were dropped
// (PowerPolicyUnread { cause: _ } => Absent) and the field came back empty, which std.decision
// reported as "candidate field is empty" — an arm that means nobody offered a candidate at all.
// Sixteen offered-with-a-gap and zero offered are different facts and only this claim tells them apart.
test fn home_serving_field_offers_all_sixteen_cells() -> ProcessExit {
  if (hscf_live() |> count) == 16 {
    ExitSuccess
  } else {
    exit_failure("the field does not hold the full four-card x four-rung sweep")
  }
}

// ── 2. EVERY OFFERED CELL DECLARES ITS GAP ON THE ONE FUNDED AXIS ───────────────────────────────
// Each entry must state exactly one absence, on exactly the axis this fold funds, and must carry no
// reading. This is std.pareto's own rule ("states what is absent instead of substituting a zero")
// made checkable. An entry with no gap and no reading would be a zero-substitution; an entry with a
// gap on some other axis would be a gap the kernel cannot answer.
test fn home_serving_every_cell_declares_its_watt_gap() -> ProcessExit {
  let entries = hscf_live()
  let gaps_are_the_watt_axis = all(entries, e =>
    (e.missing_inputs |> count) == 1
      && any(e.missing_inputs, g => declaration_ref_eq(a: g.axis, b: ax_applied_draw_watts))
  )
  if (entries |> count) > 0 && all(entries, e => (e.readings |> count) == 0) && gaps_are_the_watt_axis {
    ExitSuccess
  } else {
    exit_failure("a candidate does not declare exactly one gap on the funded watt axis")
  }
}

// ── 3. THE LIVE VERDICT IS THE INSTRUMENT'S OWN REFUSAL FOR EVIDENCE ────────────────────────────
// Not a hand-written message: std.decision's SelectionNeedsEvidence arm, reached by calling the fold.
// The needs must name the watt axis and must be attributable to a receipt, which is what the policy
// carries its cause for ("carried for attribution and never interrogated for the split").
test fn home_serving_live_verdict_needs_evidence() -> ProcessExit {
  match home_serving_selection_for(terms: hscf_roomy) {
    SelectionNeedsEvidence { needs: needs } =>
      if (needs |> count) > 0
        && all(needs, n => match n {
             UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: ax_applied_draw_watts)
             _ => false
           })
        && any(needs, n => match n {
             UnfundedAxis { gap: g } => string_contains(s: g.cause as String, pattern: "receipt")
             _ => false
           }) {
        ExitSuccess
      } else {
        exit_failure("the evidence refusal does not name the watt axis or the receipt to go read")
      }
    _ => exit_failure("the live verdict is not std.decision's own evidence refusal")
  }
}

// THE INVERSE ON THAT REFUSAL, AND THE ANTI-SILENCE CLAIM. The same call must NOT be a pick, and
// must NOT be CandidateFieldUnestablished — that arm is for nobody having offered a candidate, so
// landing in it means candidates were withheld rather than declared unread. This is the claim that
// would have gone red at the defect the gap-carrying entry fixes, from the other side.
test fn home_serving_live_verdict_is_never_a_pick_and_never_empty() -> ProcessExit {
  match home_serving_selection_for(terms: hscf_roomy) {
    SelectedWithin { candidate: c, receipt: _ } =>
      exit_failure("a card was picked with no power-limit receipt behind the rung")
    NoFeasibleRealization { causes: _, scope: _ } =>
      exit_failure("an unread rung was declared infeasible rather than unread")
    SelectionNeedsPolicy { survivors: _ } =>
      exit_failure("the field was asked to choose among unread candidates")
    _ =>
      if (hscf_live() |> count) == 16 { ExitSuccess } else { exit_failure("the field emptied instead of declaring its gaps") }
  }
}

// ── 4. THE NEAR-MISS: TWO READ SURVIVORS, NO POLICY, MUST NOT PRODUCE A PICK ────────────────────
// The case the design review asked for by name. Two hand-built candidates with READ watt values,
// equal at 200 W, on two different cards. Nothing distinguishes them, so the kernel must return
// SelectionNeedsPolicy with BOTH survivors and must not pick. Reaching this arm requires entries that
// actually have readings (scan_feasibility answers a gap first), which is why the pair is built here
// rather than read from the live field — and why claim 3 and this one cannot substitute for each
// other. Built entries, not the live field: no policy is invented in production, and a fixture that
// supplies tie_break there would answer the question being asked.
test fn home_serving_two_equal_survivors_need_policy() -> ProcessExit {
  let tied = [
    hscf_entry(ref: hscf_probe_a, label: "tied probe A at 200 W", watts: 200),
    hscf_entry(ref: hscf_probe_b, label: "tied probe B at 200 W", watts: 200),
  ]
  match select_home_serving_candidate(field: tied, terms: hscf_roomy, policy: hscf_no_policy()) {
    SelectionNeedsPolicy { survivors: survivors } =>
      if (survivors |> count) == 2 { ExitSuccess } else { exit_failure("the tie was refused without naming both survivors") }
    _ => exit_failure("two indistinguishable candidates produced a verdict other than needs-policy")
  }
}

// THE INVERSE ON THE TIE: the same fold, the same policy, the same call — a pair that IS distinguished
// by the funded axis must actually be selected, and the cheaper card must win. Without this, claim 4
// cannot tell "correctly refuses a tie" from "refuses everything".
test fn home_serving_distinguished_pair_is_selected() -> ProcessExit {
  let pair = [
    hscf_entry(ref: hscf_probe_a, label: "probe A at 200 W", watts: 200),
    hscf_entry(ref: hscf_probe_b, label: "probe B at 600 W", watts: 600),
  ]
  match select_home_serving_candidate(field: pair, terms: hscf_roomy, policy: hscf_no_policy()) {
    SelectedWithin { candidate: chosen, receipt: _ } =>
      if declaration_ref_eq(a: chosen.identity, b: hscf_probe_a) {
        ExitSuccess
      } else {
        exit_failure("the pair was selected but not by the lower applied watt")
      }
    _ => exit_failure("a distinguished pair was not selected")
  }
}

// ── 5. THE BUYER CEILING EXCLUDES IN THE KERNEL, NOT BESIDE IT ──────────────────────────────────
// A ceiling of 350 W with two READ candidates, one at 600 W: the 600 W one must be excluded and the
// 200 W one selected. The exclusion is done by std.decision's hard-constraint scan, so it is observable
// only where a reading exists — which is why this pair is hand-built and the live field cannot show it.
test fn home_serving_ceiling_excludes_a_read_candidate_above_the_bound() -> ProcessExit {
  let pair = [
    hscf_entry(ref: hscf_probe_a, label: "probe A at 200 W", watts: 200),
    hscf_entry(ref: hscf_probe_b, label: "probe B at 600 W", watts: 600),
  ]
  match select_home_serving_candidate(field: pair, terms: hscf_ceiling_350, policy: hscf_no_policy()) {
    SelectedWithin { candidate: chosen, receipt: _ } =>
      if declaration_ref_eq(a: chosen.identity, b: hscf_probe_a) {
        ExitSuccess
      } else {
        exit_failure("the candidate above the buyer ceiling was selected")
      }
    _ => exit_failure("the buyer ceiling did not produce a kernel exclusion")
  }
}

// THE INVERSE: AN UNREAD CANDIDATE IS NOT OVER THE LIMIT. With the live field and a 100 W ceiling, the
// kernel must NOT declare NoFeasibleRealization. A rung that is unread is not a rung measured above the
// bound, and treating it as one would let a missing receipt silently mean "this card cannot be bought"
// — the substitution §5's ladder refuses. The verdict must stay the evidence refusal.
test fn home_serving_unread_cell_is_not_excluded_by_an_unread_bound() -> ProcessExit {
  match home_serving_selection_for(terms: hscf_ceiling_100) {
    NoFeasibleRealization { causes: causes, scope: _ } =>
      exit_failure("an unread rung was declared infeasible against the buyer ceiling")
    SelectedWithin { candidate: _, receipt: _ } =>
      exit_failure("a card was declared feasible against a 100 W ceiling with no receipt")
    SelectionNeedsEvidence { needs: needs } =>
      if (needs |> count) > 0 { ExitSuccess } else { exit_failure("the ceiling refusal carried no need") }
    _ => exit_failure("the unread field did not stay an evidence refusal under a tight ceiling")
  }
}

// ── 6. NO UNFUNDED PERFORMANCE CLAIM ────────────────────────────────────────────────────────────
// No entry carries ANY reading, let alone a second one. A reading appearing without a funded WarmValid
// behind it is the harm the warm-capacity ledger row names ("a card is ranked on a workload it did not
// actually hold"), and this claim makes that loud rather than silent.
test fn home_serving_no_entry_claims_performance() -> ProcessExit {
  let entries = hscf_live()
  if (entries |> count) == 16 && all(entries, e => (e.readings |> count) == 0) {
    ExitSuccess
  } else {
    exit_failure("an entry carries a reading, and no WarmValid funds one")
  }
}

// The fold funds exactly one axis, and it is the watt, minimizing.
test fn home_serving_funds_exactly_one_axis() -> ProcessExit {
  // The fold's own list is the thing under test; a literal list here would stay green even if the
  // fold funded a second axis, which is a control that cannot fail.
  let axes = home_serving_candidate_axes
  // Every axis the fold actually funds, compared by identity — a fold rather than a positional read,
  // so the claim cannot inspect a slot the fold never promised.
  let only_the_watt = fold(axes, init: true, f: (acc, a) =>
    acc && declaration_ref_eq(a: a.identity, b: ax_applied_draw_watts)
  )
  if (axes |> count) == 1 && only_the_watt {
    ExitSuccess
  } else {
    exit_failure("the fold does not fund exactly the one applied-watt axis")
  }
}

// ── 7. THE RUNG LADDER IS THE SWEEP ─────────────────────────────────────────────────────────────
// The four rungs are the sweep the plan asks for (a ladder over applied watts), each watt-sized.
test fn home_serving_rungs_are_watt_sized() -> ProcessExit {
  let rungs = home_serving_applied_rung_watts()
  if (rungs |> count) == 4 && all(rungs, r => watt_count(w: r) > 0) {
    ExitSuccess
  } else {
    exit_failure("an applied rung is not watt-sized")
  }
}

// ── 8. SXM ROWS ARE REFERENCES, NOT CANDIDATES ──────────────────────────────────────────────────
// The frontier names them as references only. A reference reaching the field would let a $30k+
// server module be recommended for a tower.
test fn home_serving_sxm_rows_stay_out_of_the_field() -> ProcessExit {
  let sxm = home_serving_reference_sxm_catalog_rows
  let labels = map(hscf_live(), e => hscf_display(e: e))
  if home_serving_sxm_rows_are_not_candidates()
    && (sxm |> count) > 0
    && (hscf_live() |> count) == 16
    && all(labels, l => !string_contains(s: l, pattern: "B200") && !string_contains(s: l, pattern: "B300")) {
    ExitSuccess
  } else {
    exit_failure("an SXM reference row reached the candidate field")
  }
}

// ── 9. EVERY CELL OF THE GRID IS PRESENT, BY ITS OWN NAME ──────────────────────────────────────
// Each candidate's DeclarationRef is self-naming (cand_<card>_at_<n>w), so presence is pinned through
// the fold's OWN identities rather than through display text typed by hand into this file. That
// matters twice over. Hand-typed labels are a second authority for what a candidate is called, and a
// label is a renderer: pinning on it (§13762's finding) tests the rendering's exact bytes instead of
// the candidate, and it broke the moment a model string turned out not to contain the SKU the
// declaration name uses. Here the four cards and four rungs are each named, so a cell that quietly
// stops being minted goes red with the name of the missing cell in the failure reason.
fn hscf_identity_key(e: ParetoEntry) -> String = e.identity.decl_name as String

test fn home_serving_field_covers_every_card_and_rung() -> ProcessExit {
  let keys = map(hscf_live(), e => hscf_identity_key(e: e))
  let cards = ["rtx_pro_5000_48gb", "rtx_pro_5000_72gb", "rtx_pro_6000_workstation", "rtx_pro_6000_max_q"]
  let rungs = ["200w", "300w", "400w", "600w"]
  let missing = flat_map(cards, c =>
    flat_map(rungs, r =>
      if any(keys, k => string_contains(s: k, pattern: (c + "_at_" + r) as String)) { [] } else { [(c + " @ " + r) as String] }
    )
  )
  if (hscf_live() |> count) == 16 && (missing |> count) == 0 {
    ExitSuccess
  } else {
    exit_failure("candidate cells are missing from the grid")
  }
}

// THE INVERSE ON THAT: a label must still NAME its card and its rung, or the instrument is refusing
// about something the reader cannot identify. Checked against the row's own model string and the rung
// in the identity — both taken from the tree, neither typed here.
test fn home_serving_every_entry_is_identifiable_to_a_buyer() -> ProcessExit {
  let entries = hscf_live()
  let roster = home_serving_add_in_card_catalog_rows
  let readable = all(entries, e =>
    any(roster, row => string_contains(s: hscf_display(e: e), pattern: row.model as String))
      && string_contains(s: hscf_identity_key(e: e), pattern: "_at_")
  )
  if (entries |> count) == 16 && readable {
    ExitSuccess
  } else {
    exit_failure("an entry does not name a roster card, or its identity does not name a rung")
  }
}

// ── 10. THE TDP CITATION GUARD IS LOAD-BEARING (recorded negative control) ─────────────────────
// A row whose TDP carries no citation contributes NO candidate: the fold refuses to mint an entry
// with an invented ceiling, so its whole card disappears from the grid and the count drops from 16 to
// 12. That guard cannot be exercised from a claim without editing the catalog, so the negative control
// is RECORDED here rather than asserted: delete the tdp_watts FactCitation from
// nvidia_rtx_pro_6000_workstation_catalog in dag/extdeps/gpu/nvidia.dag and both this claim and the
// grid claim go red, naming the Workstation cells. Trusting the guard without running that is exactly
// the "control that cannot fail" this lane was filed for.
test fn home_serving_control_card_is_present() -> ProcessExit {
  let keys = map(hscf_live(), e => hscf_identity_key(e: e))
  let both_controls =
    any(keys, k => string_contains(s: k, pattern: "rtx_pro_5000_48gb_at_200w"))
      && any(keys, k => string_contains(s: k, pattern: "rtx_pro_6000_workstation_at_600w"))
  if (hscf_live() |> count) == 16 && both_controls {
    ExitSuccess
  } else {
    exit_failure("a control card is missing from the grid")
  }
}
