  r2_head_body, r2_head_body_reading,
  R2HeadObserved, R2HeadObservedAbsent, R2HeadObservedAt, R2HeadObservedRefused, r2_head_observed_of,
  R2HeadAdvanceSettledUnwritten, R2HeadAdvancePut, r2_head_advance_plan,
  R2HeadAdvancedTo, R2HeadMovedFrom, R2HeadStoreRefused,
  R2HeadAdvanceKnown, R2HeadAdvanceOutcomeUnknown, r2_head_result_of,
  R2HeadStagingCustody, r2_head_staging_of, r2_head_staging_join,
  R2HeadCredential, r2_head_binding, r2_head_read_target, r2_head_write_target,
  r2_head_cas_ground, r2_head_cas_ground_headers, r2_head_cas_ground_linearizability,
