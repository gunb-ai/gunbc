import std.optional { Present, Absent }
import std.fabric_storage {
  FabricObject, FabricObjectRef, fabric_object_ref_of, fabric_object_ref_eq,
  FabricHeadReading, FabricHeadAbsent, FabricHeadAt, ExpectHeadAbsent, ExpectHeadAt,
  FabricHeadObserved, FabricHeadReadRefused, FabricStoreUnreachable, FabricStoreRefused,
}
import extdeps.object_storage { ObjectEntityTag, PutIfAbsent, PutIfMatch }
import extdeps.external_authority { TranscribedUncited, CitedToAuthority, ObservedByReceipt }
import extdeps.cloudflare.r2 { R2ObjectLocator, R2S3Endpoint, R2JurisdictionDefault, r2_object_url, r2_conditional_put_linearizability }
import gunbc.secret_provision { fleet_secret_ref }
import extdeps.shell.exec { process_observation }
import gunbc.cloudflare.r2_staged_transfer {
  R2FetchStaged, R2FetchObjectAbsent, R2FetchStoreRefused, R2FetchTransportUnanswered, R2FetchLocalFailure,
  R2StagingRemoved, R2StagingResidue, R2StagingNotCreated,
  classify_s3_transfer, classify_r2_fetch, r2_fetch_of_verdict, r2_fetch_retains_staging,
  R2ObjectStored, R2ObjectAlreadyPresent, R2ObjectTagMoved, R2PutRefused, R2PutOutcomeUnknown,
  WriteCredentialShredded, WriteCredentialResidueRemains,
}
