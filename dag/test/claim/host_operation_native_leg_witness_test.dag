module test.claim.host_operation_native_leg_witness

import std.types { Bool, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.systemd { MemoryCurrent }
import v2.std.operation_argv { OperationRef, bind_operation_invocation, operation_argv_bind_text }
import gunbc.host_operation_exec {
  HostOperation,
  SystemctlIsActive,
  host_operation,
  host_operation_native_leg_agrees,
  hostname_read_short_host_operation,
  systemctl_is_active_host_operation,
  systemctl_show_property_host_operation,
  systemctl_status_host_operation,
  systemctl_stop_host_operation,
}

// WHAT THIS FILE IS EVIDENCE FOR. gunbc.host_operation_exec carries each seam's operation identity
// and its local invocation as two separate fields, and nothing in the record's shape relates them.
// The agreement check is a mapping, so the only thing that makes it real is a row that goes RED when
// the pairing is wrong -- a check whose red is unauthorable is a decoration (DESIGN 4b). The red IS
// authorable here: the mispaired row below is an ordinary record literal.
//
// Per DESIGN 4b meta-obligation (4), these stay enrolled once the wall holds. They are the executing
// evidence that it still does, not a step that retires on green.

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data unit_under_test: NonEmptyStr = "demo.service" as NonEmptyStr

test fn witness_is_active_native_leg_agrees() -> Bool {
  host_operation_native_leg_agrees(operation: systemctl_is_active_host_operation(unit: unit_under_test))
}

test fn witness_status_native_leg_agrees() -> Bool {
  host_operation_native_leg_agrees(operation: systemctl_status_host_operation(unit: unit_under_test))
}

test fn witness_stop_native_leg_agrees() -> Bool {
  host_operation_native_leg_agrees(operation: systemctl_stop_host_operation(unit: unit_under_test))
}

test fn witness_show_property_native_leg_agrees() -> Bool {
  host_operation_native_leg_agrees(
    operation: systemctl_show_property_host_operation(unit: unit_under_test, property: MemoryCurrent),
  )
}

test fn witness_hostname_read_short_native_leg_agrees() -> Bool {
  host_operation_native_leg_agrees(operation: hostname_read_short_host_operation())
}

// THE DISCRIMINATING RED. `HostOperation` is `sole_constructor`, so this mispairing is authorable
// ONLY because this declaration is named in the mint's admit list -- see the annotation on
// gunbc.host_operation_exec `host_operation` for why that one exception is taken and what it costs.
// A record literal here would not compile, which is the seal working. Status's identity, IsActive's local leg -- the exact silent failure the
// guard exists to catch: over ssh this row runs `systemctl status`, locally it runs
// `systemctl is-active`, and both succeed while answering different questions. If the guard is ever
// weakened to something that cannot see the disagreement, this witness stops refusing and goes red.
fn mispaired_host_operation() -> HostOperation {
  host_operation(
    invocation: bind_operation_invocation(
      at: OperationRef {
        path: "dag/extdeps/systemd/systemctl.dag",
        service: "systemd.Systemctl",
        operation: "Status",
      },
      bindings: [operation_argv_bind_text(name: "unit", text: unit_under_test as String)],
    ),
    native: SystemctlIsActive { unit: unit_under_test },
  )
}

test fn witness_mispaired_native_leg_is_refused() -> Bool {
  !host_operation_native_leg_agrees(operation: mispaired_host_operation())
}
