module test.claim.r2_conditional_put_race_probe

import std.types { String, NonEmptyStr, Int, Bool, List, FilePath }
import std.optional { Present, Absent }
import extdeps.object_storage { ObjectEntityTag, PutIfMatch }
import extdeps.exec.command { argv_words }
import extdeps.version.semver { semver_core_of_dotted, semver_minimum_of_constraint, semver_version_label }
import extdeps.tools.curl {
  curl_sigv4_s3_parallel_upload_command, curl_parallel_transfer_report, S3ParallelUpload,
  CurlParallelTransferReport, CurlParallelTransferReported, CurlParallelTransferUnreported,
  curl_trace_reading, CurlTraceRead, CurlTraceRefused, CurlTraceEvent,
  curl_trace_ids_cli_tool, curl_version_standing, CurlVersionMeetsPin, CurlVersionBelowPin, CurlVersionUnreadable,
}
import gunbc.cloudflare.r2_conditional_put_race_probe {
  RaceRoundObservation, RaceRoundUnseeded, RaceRoundRaced,
  RaceOverlap, RaceOverlapEstablished, RaceOverlapUnestablished, race_overlap_of_trace,
  RaceRoundConsistent, RaceRoundBothSucceeded, RaceRoundInconclusive, race_round_verdict,
  RaceProbePassed, RaceProbeFalsified, RaceProbeInconclusive, race_probe_verdict,
  race_writer_a, race_writer_b,
}

// Supplied values at the verdict's own interface: what curl reported for each writer, and the trace
// it wrote, are constructed here. The real producer is run_r2_conditional_put_race_probe under the
// fleet-converge mode r2_conditional_put_race_probe, whose receipt is the live reading; the route
// claims below run the real argv builder and the real parsers over the shapes curl writes.

fn rep(status: Int) -> CurlParallelTransferReport { CurlParallelTransferReported { status: status } }

fn raced(a: CurlParallelTransferReport, b: CurlParallelTransferReport) -> RaceRoundObservation { RaceRoundRaced { a: a, b: b, overlap: RaceOverlapEstablished } }

fn raced_without_overlap(a: CurlParallelTransferReport, b: CurlParallelTransferReport) -> RaceRoundObservation {
  RaceRoundRaced { a: a, b: b, overlap: RaceOverlapUnestablished { cause: "one writer was answered before the other had finished sending" } }
}

fn consistent_round() -> RaceRoundObservation { raced(a: rep(status: 200), b: rep(status: 412)) }

fn rounds_of(o: RaceRoundObservation, n: Int, acc: List<RaceRoundObservation>) -> List<RaceRoundObservation> {
  if n <= 0 { acc } else { rounds_of(o: o, n: n - 1, acc: concat(acc, [o])) }
}

fn is_consistent(o: RaceRoundObservation) -> Bool {
  match race_round_verdict(observation: o) { RaceRoundConsistent => true  RaceRoundBothSucceeded => false  RaceRoundInconclusive { cause: _ } => false }
}

fn is_falsifying(o: RaceRoundObservation) -> Bool {
  match race_round_verdict(observation: o) { RaceRoundBothSucceeded => true  RaceRoundConsistent => false  RaceRoundInconclusive { cause: _ } => false }
}

fn is_inconclusive(o: RaceRoundObservation) -> Bool {
  match race_round_verdict(observation: o) { RaceRoundInconclusive { cause: _ } => true  RaceRoundConsistent => false  RaceRoundBothSucceeded => false }
}

test fn one_2xx_and_one_412_that_raced_is_consistent_either_way_round() -> Bool {
  is_consistent(o: raced(a: rep(status: 200), b: rep(status: 412))) && is_consistent(o: raced(a: rep(status: 412), b: rep(status: 200)))
}

test fn two_2xx_falsify_whether_or_not_the_race_is_established() -> Bool {
  is_falsifying(o: raced(a: rep(status: 200), b: rep(status: 204)))
    && is_falsifying(o: raced_without_overlap(a: rep(status: 200), b: rep(status: 200)))
}

test fn a_split_whose_race_is_not_established_proves_nothing() -> Bool {
  is_inconclusive(o: raced_without_overlap(a: rep(status: 200), b: rep(status: 412)))
}

test fn both_412_any_other_status_and_any_non_answer_are_inconclusive() -> Bool {
  is_inconclusive(o: raced(a: rep(status: 412), b: rep(status: 412)))
    && is_inconclusive(o: raced(a: rep(status: 200), b: rep(status: 503)))
    && is_inconclusive(o: raced(a: rep(status: 403), b: rep(status: 412)))
    && is_inconclusive(o: raced(a: rep(status: 200), b: CurlParallelTransferUnreported { cause: "no write-out line" }))
    && is_inconclusive(o: RaceRoundUnseeded { cause: "seed answered 500" })
}

test fn every_declared_round_consistent_passes() -> Bool {
  match race_probe_verdict(declared_rounds: 5, observations: rounds_of(o: consistent_round(), n: 5, acc: [])) {
    RaceProbePassed { rounds: n } => n == 5
    RaceProbeFalsified { rounds: _, witnesses: _ } => false
    RaceProbeInconclusive { rounds: _, cause: _, witnesses: _ } => false
  }
}

test fn one_double_success_falsifies_the_probe_and_names_its_round() -> Bool {
  let obs = concat(concat(rounds_of(o: consistent_round(), n: 2, acc: []), [raced(a: rep(status: 200), b: rep(status: 200))]), [raced(a: rep(status: 412), b: rep(status: 412))])
  match race_probe_verdict(declared_rounds: 4, observations: obs) {
    RaceProbeFalsified { rounds: n, witnesses: ws } => n == 4 && length(ws) == 1 && (match ws.first() { Present { value: w } => w.round == 3  Absent => false })
    RaceProbePassed { rounds: _ } => false
    RaceProbeInconclusive { rounds: _, cause: _, witnesses: _ } => false
  }
}

test fn one_inconclusive_round_or_a_short_run_or_no_rounds_never_passes() -> Bool {
  let one_bad = match race_probe_verdict(declared_rounds: 3, observations: concat(rounds_of(o: consistent_round(), n: 2, acc: []), [RaceRoundUnseeded { cause: "no tag" }])) {
    RaceProbeInconclusive { rounds: _, cause: _, witnesses: ws } => length(ws) == 1
    RaceProbePassed { rounds: _ } => false
    RaceProbeFalsified { rounds: _, witnesses: _ } => false
  }
  let short = match race_probe_verdict(declared_rounds: 3, observations: rounds_of(o: consistent_round(), n: 2, acc: [])) {
    RaceProbeInconclusive { rounds: n, cause: _, witnesses: _ } => n == 2
    RaceProbePassed { rounds: _ } => false
    RaceProbeFalsified { rounds: _, witnesses: _ } => false
  }
  let empty = match race_probe_verdict(declared_rounds: 0, observations: []) {
    RaceProbeInconclusive { rounds: _, cause: _, witnesses: _ } => true
    RaceProbePassed { rounds: _ } => false
    RaceProbeFalsified { rounds: _, witnesses: _ } => false
  }
  one_bad && short && empty
}

// ── THE OVERLAP FACT, READ FROM A TRACE ON ONE CLOCK ────────────────────────────────────────────

// One transfer's events in the shape --trace-ascii --trace-time --trace-ids writes: a stamped send
// header (whose bytes carry the Authorization header), a stamped send of the body, and a stamped
// first response header.
fn header_event(at: String, xfer: String) -> String {
  join([at, " [", xfer, "-0] => Send header, 300 bytes (0x12c)\n",
    "0000: PUT /bucket/probe HTTP/1.1\n",
    "001c: Authorization: AWS4-HMAC-SHA256 Credential=KEYIDMARK/20261006/auto/s3/aws4_request, SignedHeaders=host, Signature=SIGNATUREMARK\n"], "")
}

fn body_event(at: String, xfer: String, writer: String) -> String {
  join([at, " [", xfer, "-0] => Send data, 48 bytes (0x30)\n", "0000: r2 conditional put race probe round 1 ", writer, "\n"], "")
}

fn answer_event(at: String, xfer: String) -> String {
  join([at, " [", xfer, "-0] <= Recv header, 17 bytes (0x11)\n", "0000: HTTP/1.1 200 OK\n"], "")
}

fn overlap_of(trace: String) -> RaceOverlap { race_overlap_of_trace(reading: curl_trace_reading(trace: trace), label_a: race_writer_a, label_b: race_writer_b) }

fn established(o: RaceOverlap) -> Bool { match o { RaceOverlapEstablished => true  RaceOverlapUnestablished { cause: _ } => false } }

// The positive control: both bodies sent, then both answered, interleaved across transfers.
fn overlapping_trace() -> String {
  join([
    "10:00:00.000100 [0-x] == Info: Trying 1.2.3.4:443...\n",
    header_event(at: "10:00:00.010000", xfer: "0"), header_event(at: "10:00:00.010500", xfer: "1"),
    body_event(at: "10:00:00.011000", xfer: "1", writer: "writer-b"), body_event(at: "10:00:00.011200", xfer: "0", writer: "writer-a"),
    answer_event(at: "10:00:00.040000", xfer: "0"), answer_event(at: "10:00:00.041000", xfer: "1"),
  ], "")
}

test fn bodies_sent_before_either_answer_on_one_clock_establish_the_race() -> Bool {
  established(o: overlap_of(trace: overlapping_trace()))
}

// THE COUNTEREXAMPLE that falsified the duration route: each transfer's own durations look like an
// overlap (sent early, answered late, relative to its own start), but on the shared clock writer a was
// answered before writer b sent anything. It must stay unestablished, so a 200/412 split stays
// inconclusive.
test fn sequential_requests_on_the_shared_clock_never_establish_the_race() -> Bool {
  let sequential = join([
    header_event(at: "10:00:00.000000", xfer: "0"), body_event(at: "10:00:00.000010", xfer: "0", writer: "writer-a"),
    answer_event(at: "10:00:00.000020", xfer: "0"),
    header_event(at: "10:00:00.000100", xfer: "1"), body_event(at: "10:00:00.000101", xfer: "1", writer: "writer-b"),
    answer_event(at: "10:00:00.000120", xfer: "1"),
  ], "")
  established(o: overlap_of(trace: sequential)) == false
    && is_inconclusive(o: RaceRoundRaced { a: rep(status: 200), b: rep(status: 412), overlap: overlap_of(trace: sequential) })
}

// THE BACKWARDS STEP: a's answer at .040, then the clock steps back and b's body is stamped .030, which
// would read as sent-before-answered. Any stamp lower than the line before it refuses the trace.
test fn a_backwards_clock_step_anywhere_in_the_trace_refuses_it() -> Bool {
  let stepped = join([
    header_event(at: "10:00:00.010000", xfer: "0"), body_event(at: "10:00:00.011000", xfer: "0", writer: "writer-a"),
    answer_event(at: "10:00:00.040000", xfer: "0"),
    header_event(at: "10:00:00.020000", xfer: "1"), body_event(at: "10:00:00.030000", xfer: "1", writer: "writer-b"),
    answer_event(at: "10:00:00.050000", xfer: "1"),
  ], "")
  let refused = match curl_trace_reading(trace: stepped) { CurlTraceRefused { cause: _ } => true  CurlTraceRead { events: _ } => false }
  let info_step = match curl_trace_reading(trace: join(["10:00:00.500000 [0-x] == Info: one\n", "10:00:00.400000 [0-x] == Info: two\n"], "")) { CurlTraceRefused { cause: _ } => true  CurlTraceRead { events: _ } => false }
  refused && info_step && established(o: overlap_of(trace: stepped)) == false
}

// TLS records are traced as "Send SSL data"; they are not the request body and must not stand for it.
test fn tls_data_is_not_a_body_send() -> Bool {
  let tls_only = join([
    "10:00:00.010000 [0-0] => Send SSL data, 5 bytes (0x5)\n", "0000: writer-a\n",
    "10:00:00.010100 [1-0] => Send SSL data, 5 bytes (0x5)\n", "0000: writer-b\n",
    answer_event(at: "10:00:00.040000", xfer: "0"), answer_event(at: "10:00:00.041000", xfer: "1"),
  ], "")
  established(o: overlap_of(trace: tls_only)) == false
}

fn event_carries(e: CurlTraceEvent, mark: String) -> Bool { length(filter(e.body, b => string_contains(s: b, pattern: mark))) > 0 }

// THE CREDENTIAL NEVER LEAVES THE PARSER. The send-header bytes (Authorization, key id, signature) are
// in the trace file; no parsed event carries them.
test fn the_authorization_header_never_reaches_a_parsed_event() -> Bool {
  match curl_trace_reading(trace: overlapping_trace()) {
    CurlTraceRefused { cause: _ } => false
    CurlTraceRead { events: es } =>
      length(es) == 7
        && length(filter(es, e => event_carries(e: e, mark: "Authorization") || event_carries(e: e, mark: "KEYIDMARK") || event_carries(e: e, mark: "SIGNATUREMARK"))) == 0
        && length(filter(es, e => event_carries(e: e, mark: "writer-a"))) == 1
  }
}

// ── ROUTE: the argv the run executes, and the parser over the format that argv carries ──────────

fn parallel_argv() -> List<String> {
  argv_words(command: curl_sigv4_s3_parallel_upload_command(
    uploads: [
      S3ParallelUpload { label: race_writer_a, url: "https://h/b/k", local_path: "/tmp/a", precondition: PutIfMatch { tag: ObjectEntityTag { value: "\"t1\"" } } },
      S3ParallelUpload { label: race_writer_b, url: "https://h/b/k", local_path: "/tmp/b", precondition: PutIfMatch { tag: ObjectEntityTag { value: "\"t1\"" } } },
    ],
    netrc_path: "/tmp/n" as FilePath, sigv4_region: "auto", trace_path: "/tmp/d/trace" as FilePath,
  ))
}

fn count_word(ws: List<String>, w: String) -> Int { length(filter(ws, x => x == w)) }

test fn the_parallel_argv_races_both_writers_on_one_tag_through_one_netrc_and_traces_once() -> Bool {
  let ws = parallel_argv()
  count_word(ws: ws, w: "-Z") == 1 && count_word(ws: ws, w: "--parallel-immediate") == 1
    && count_word(ws: ws, w: "--trace-ascii") == 1 && count_word(ws: ws, w: "/tmp/d/trace") == 1
    && count_word(ws: ws, w: "--trace-time") == 1 && count_word(ws: ws, w: "--trace-ids") == 1
    && count_word(ws: ws, w: "--next") == 1
    && count_word(ws: ws, w: "If-Match: \"t1\"") == 2
    && count_word(ws: ws, w: "/tmp/n") == 2
    && count_word(ws: ws, w: "-w") == 2
}

fn write_out_of(ws: List<String>, label: NonEmptyStr) -> String {
  match first(filter(ws, w => starts_with(s: w, prefix: concat(label as String, " ")))) {
    Present { value: f } => f
    Absent => ""
  }
}

test fn the_parser_reads_each_writer_from_the_format_the_builder_emits() -> Bool {
  let ws = parallel_argv()
  let stdout = concat(replace(s: write_out_of(ws: ws, label: race_writer_b), from: "%\{http_code\}", to: "412"), replace(s: write_out_of(ws: ws, label: race_writer_a), from: "%\{http_code\}", to: "200"))
  let a_ok = match curl_parallel_transfer_report(stdout: stdout, label: race_writer_a) {
    CurlParallelTransferReported { status: s } => s == 200
    CurlParallelTransferUnreported { cause: _ } => false
  }
  let b_ok = match curl_parallel_transfer_report(stdout: stdout, label: race_writer_b) {
    CurlParallelTransferReported { status: s } => s == 412
    CurlParallelTransferUnreported { cause: _ } => false
  }
  a_ok && b_ok
}

fn unrep(r: CurlParallelTransferReport) -> Bool {
  match r { CurlParallelTransferUnreported { cause: _ } => true  CurlParallelTransferReported { status: _ } => false }
}

test fn a_missing_duplicated_or_000_writer_line_is_unreported() -> Bool {
  unrep(r: curl_parallel_transfer_report(stdout: "writer-b 412\n", label: race_writer_a))
    && unrep(r: curl_parallel_transfer_report(stdout: "writer-a 200\nwriter-a 412\n", label: race_writer_a))
    && unrep(r: curl_parallel_transfer_report(stdout: "writer-a 000\n", label: race_writer_a))
    && unrep(r: curl_parallel_transfer_report(stdout: "writer-a 200 extra\n", label: race_writer_a))
}

// ── THE VERSION GATE ────────────────────────────────────────────────────────────────────────────

test fn the_installed_curl_is_compared_against_the_rows_own_floor() -> Bool {
  let meets = match curl_version_standing(tool: curl_trace_ids_cli_tool, stdout: "curl 8.5.0 (x86_64-pc-linux-gnu) libcurl/8.5.0 OpenSSL/3.0.13\nRelease-Date: 2023-12-06\n") {
    CurlVersionMeetsPin { observed: v } => semver_version_label(v: v) == "8.5.0"
    CurlVersionBelowPin { observed: _, required: _ } => false
    CurlVersionUnreadable { cause: _ } => false
  }
  let exact = match curl_version_standing(tool: curl_trace_ids_cli_tool, stdout: "curl 8.2.0 (aarch64-unknown-linux-gnu)\n") {
    CurlVersionMeetsPin { observed: _ } => true
    CurlVersionBelowPin { observed: _, required: _ } => false
    CurlVersionUnreadable { cause: _ } => false
  }
  let below = match curl_version_standing(tool: curl_trace_ids_cli_tool, stdout: "curl 7.81.0 (x86_64-pc-linux-gnu) libcurl/7.81.0\n") {
    CurlVersionBelowPin { observed: v, required: _ } => semver_version_label(v: v) == "7.81.0"
    CurlVersionMeetsPin { observed: _ } => false
    CurlVersionUnreadable { cause: _ } => false
  }
  let garbage = match curl_version_standing(tool: curl_trace_ids_cli_tool, stdout: "wget 1.21\n") {
    CurlVersionUnreadable { cause: _ } => true
    CurlVersionMeetsPin { observed: _ } => false
    CurlVersionBelowPin { observed: _, required: _ } => false
  }
  meets && exact && below && garbage
}

test fn only_a_lower_bound_constraint_names_a_floor() -> Bool {
  let floor = match semver_minimum_of_constraint(constraint: ">= 8.2") { Present { value: v } => semver_version_label(v: v) == "8.2.0"  Absent => false }
  let range = match semver_minimum_of_constraint(constraint: "< 9") { Absent => true  Present { value: _ } => false }
  let four = match semver_core_of_dotted(text: "1.2.3.4") { Absent => true  Present { value: _ } => false }
  floor && range && four
}
