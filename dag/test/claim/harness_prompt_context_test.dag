module test.claim.harness_prompt_context_test

import std.types { Bool, String, List }
import std.decl_ref { decl_ref }
import gunbc.harness.harness_prompt_context {
  PromptInput, AuthorityInput, WorkContractInput, EvidenceInput, ConversationTurnInput, GuidanceInput,
  ContextStanding, EstablishedObservation, Withdrawn,
  PromptContextSnapshot, prompt_snapshot_digest,
  PromptSegment, prompt_segment_render,
  PromptPlan, PromptPlanAssembly, PromptPlanReady, PromptPlanRefused,
  prompt_plan_assemble, prompt_render_receipt, PromptRenderReceipt,
}

fn fx_input(id: String, revision: String) -> PromptInput {
  AuthorityInput {
    declaration: decl_ref(module_path: "gunbc.design_document", decl_name: "design_document"),
    revision: join([id, revision], ""),
  }
}

fn fx_snapshot(revision: String) -> PromptContextSnapshot {
  PromptContextSnapshot {
    attempt_lineage: "worker:task-a-deadbeef",
    epoch: 1,
    source_revision: "rev-src",
    work_contract_revision: "rev-contract",
    inputs: [fx_input(id: "a", revision: revision)],
  }
}

fn fx_segment(input: PromptInput, required: Bool, content: String) -> PromptSegment {
  prompt_segment_render(purpose: "test segment", source: input, required: required, content: content)
}

// THE SNAPSHOT DIGEST IS DERIVATION-EXACT: identical inputs digest identically, and any moved
// revision -- source, contract, or an input's own -- moves the digest.
test fn identical_snapshots_digest_identically_and_any_revision_moves_it() -> Bool {
  let base = prompt_snapshot_digest(snapshot: fx_snapshot(revision: "r1"))
  base == prompt_snapshot_digest(snapshot: fx_snapshot(revision: "r1"))
    && base != prompt_snapshot_digest(snapshot: fx_snapshot(revision: "r2"))
    && base != ""
}

// A WITHDRAWN REQUIRED SOURCE REFUSES ASSEMBLY; the same segment optional assembles. The standing
// is a first-class state -- it cannot silently render as established.
test fn a_withdrawn_required_input_refuses_the_plan() -> Bool {
  let withdrawn = EvidenceInput { artifact: "receipt-x", subject: "claim-y", standing: Withdrawn }
  let refused = prompt_plan_assemble(
    snapshot: fx_snapshot(revision: "r1"),
    rendered: [fx_segment(input: withdrawn, required: true, content: "stale claim")],
  )
  let ready = prompt_plan_assemble(
    snapshot: fx_snapshot(revision: "r1"),
    rendered: [fx_segment(input: withdrawn, required: false, content: "stale claim")],
  )
  (match refused {
    PromptPlanRefused { detail } => detail.contains("Withdrawn")
    PromptPlanReady { plan: _ } => false
  })
    && (match ready {
      PromptPlanReady { plan } => count(plan.ordered_segments) == 1
      PromptPlanRefused { detail: _ } => false
    })
}

// THE RENDER RECEIPT binds the snapshot digest, the per-input digests, and the rendered bytes, so a
// cache hit and a cache miss of one plan produce the same receipt fields.
test fn the_render_receipt_is_a_pure_projection_of_the_plan() -> Bool {
  let input = fx_input(id: "a", revision: "r1")
  let assembled = prompt_plan_assemble(
    snapshot: fx_snapshot(revision: "r1"),
    rendered: [fx_segment(input: input, required: true, content: "the principles pointer")],
  )
  match assembled {
    PromptPlanRefused { detail: _ } => false
    PromptPlanReady { plan } => {
      let receipt_a = prompt_render_receipt(plan: plan, rendered_text: "rendered text", provider_projection: "anthropic")
      let receipt_b = prompt_render_receipt(plan: plan, rendered_text: "rendered text", provider_projection: "openai-chat")
      receipt_a.rendered_digest == receipt_b.rendered_digest
        && receipt_a.plan_snapshot_digest == receipt_b.plan_snapshot_digest
        && count(receipt_a.input_digests) == 1
        && receipt_a.provider_projection != receipt_b.provider_projection
    }
  }
}
