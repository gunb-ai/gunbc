module test.claim.ci_remedy_witness

import gunbc.ci_gate {
  Gate,
  EmitHostGate, LayeringImportsGate, ExtdepsExternalAuthorityGate,
  DagCompileCleanGate, GeneratedArtifactDriftGate, SourceRootIngestGate,
  RegenVerifyGate, SelfHostReadsRealBytesGate, SelfHostStalenessGate
}
import gunbc.ci_remedy {
  Remedy, RemedyDerivation, RemedyJudgment,
  RemedyChannel, GeneratedArtifactRegen, SeedRegen,
  RemedyCommand,
  gate_remedy, gate_is_chore_able, remedy_is_derivation,
  remedy_channel_eq, generated_artifact_regen_command, generated_artifact_gate_entry
}
import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.generated_artifact { committed_generated_artifacts }

data ci_remedy_witness_note: String = "Anti-fork wall for the remedy classification (DESIGN §3). The gate→channel table in gunbc.ci_remedy is a minimal hand-mapping (gate-body introspection is not yet infra); these witnesses are the construction wall around it. witness_derivation_heals_registry proves the GeneratedArtifactRegen command IS the registry projector — its source_roots are witness_layer_roots and its entry is the generated-artifact gate, the exact projector of committed_generated_artifacts() the drift gate folds over — so the derivation cannot silently point at a set other than the one the gate guards. witness_judgment_is_default is the fail-closed RED control: every producer-logic / ingest / compile gate classifies RemedyJudgment, and specifically LayeringImportsGate (a real producer bug, #7080, that NO chore commit may write) must NOT be chore-able. If someone adds a chore-able arm without grounding it, these reds."

fn channel_of(g: Gate) -> RemedyChannel {
  match gate_remedy(g: g) {
    RemedyDerivation { channel, command: _ } => channel
    RemedyJudgment { located_debt: _ } => GeneratedArtifactRegen
  }
}

fn command_of_derivation(r: Remedy) -> RemedyCommand {
  match r {
    RemedyDerivation { channel: _, command } => command
    RemedyJudgment { located_debt: _ } => RemedyCommand { source_roots: [], entry: "", function: "" }
  }
}

fn witness_two_derivable_channels() -> Bool {
  gate_is_chore_able(g: GeneratedArtifactDriftGate)
    && gate_is_chore_able(g: RegenVerifyGate)
    && remedy_channel_eq(a: channel_of(g: GeneratedArtifactDriftGate), b: GeneratedArtifactRegen)
    && remedy_channel_eq(a: channel_of(g: RegenVerifyGate), b: SeedRegen)
}

fn witness_derivation_heals_registry() -> Bool {
  let cmd = generated_artifact_regen_command()
  count(committed_generated_artifacts()) > 0
    && (cmd.source_roots == witness_layer_roots)
    && (cmd.entry == generated_artifact_gate_entry)
    && (cmd.function == "main_wet")
}

fn witness_judgment_is_default() -> Bool {
  !gate_is_chore_able(g: LayeringImportsGate)
    && !gate_is_chore_able(g: EmitHostGate)
    && !gate_is_chore_able(g: ExtdepsExternalAuthorityGate)
    && !gate_is_chore_able(g: DagCompileCleanGate)
    && !gate_is_chore_able(g: SourceRootIngestGate)
    && !gate_is_chore_able(g: SelfHostReadsRealBytesGate)
    && !gate_is_chore_able(g: SelfHostStalenessGate)
}

fn witness_judgment_carries_located_debt() -> Bool {
  match gate_remedy(g: LayeringImportsGate) {
    RemedyJudgment { located_debt } => !(located_debt == "")
    RemedyDerivation { channel: _, command: _ } => false
  }
}

test fn ci_remedy_witnesses() -> Bool {
  witness_two_derivable_channels()
    && witness_derivation_heals_registry()
    && witness_judgment_is_default()
    && witness_judgment_carries_located_debt()
}
