module test.claim.github_app_control_plane_observe

import std.types { Bool, String, Map }
import extdeps.auth.jws { JwsSigningKeyRef, HostKeyFile }
import extdeps.transports.rest { RestOutcome, RestOk, RestStatusRefused, RestTransportRefused }
import extdeps.github.github { GitHubUser, Organization }
import extdeps.github.app { GitHubAppPublicRecord, GitHubAppInstallationRecord }
import gunbc.auth.github_credential { app_installation_metadata_baseline }
import gunbc.auth.github_apps {
  DeclaredGitHubApp, gunbai_ci_declared, gunbai_bot_declared, gunbai_ci_declared_installation_id,
  GitHubAppControlPlaneState, app_control_plane_state,
  SignerCustodyUnresolved, InstallationUnobserved, InstallationGrantObserved,
  SignerReadbackFailed, SignerKeyRejected, SignerNamesDifferentApp, SignerReadbackNotReached,
}
import gunbc.auth.github_app_control_plane_observe {
  signer_custody_of_app_read, registration_of_app_read, installation_of_read,
}

// The producer's decisions over SUPPLIED RestOutcomes (DESIGN §3: a witness discriminates at one
// interface). The effectful route -- the controller signing with its custodied key and calling
// GitHub -- is inhabited by gunbc.runner_microvm_slot_controller observe_app_control_plane, not
// here; these witnesses pin which arm each GitHub answer reaches.

data key: JwsSigningKeyRef = HostKeyFile { path: "/nonexistent/witness-app.pem" }

data metadata_read: Map<String, String> = { "metadata": "read" }

fn app_record(app: DeclaredGitHubApp) -> GitHubAppPublicRecord {
  GitHubAppPublicRecord {
    id: app.app_id.value,
    slug: app.slug,
    node_id: "A_witness",
    name: app.slug,
    html_url: "https://github.com/apps/gunbai-ci",
    permissions: metadata_read,
    events: [],
  }
}

data installation_record: GitHubAppInstallationRecord = GitHubAppInstallationRecord {
  id: gunbai_ci_declared_installation_id.value,
  app_id: gunbai_ci_declared.app_id.value,
  app_slug: "gunbai-ci",
  html_url: "https://github.com/organizations/gunb-ai/settings/installations/104134109",
  account: GitHubUser { login: "gunb-ai", id: 0, type: Organization },
  repository_selection: "all",
  permissions: metadata_read,
  events: [],
}

fn sealed(app_outcome: RestOutcome, app_seen: DeclaredGitHubApp, installation_outcome: RestOutcome) -> GitHubAppControlPlaneState {
  app_control_plane_state(
    app: gunbai_ci_declared,
    custody: signer_custody_of_app_read(key: key, observed_at: 1790000000, outcome: app_outcome, record: app_record(app: app_seen)),
    registration: registration_of_app_read(outcome: app_outcome, record: app_record(app: app_seen)),
    observed: installation_of_read(outcome: installation_outcome, record: installation_record),
    required: [app_installation_metadata_baseline],
    reason: "witness",
  )
}

// POSITIVE CONTROL: GitHub accepts the key as gunbai-ci and the installation grants what is required.
test fn witness_accepted_key_and_granting_installation_seal_the_grant() -> Bool {
  match sealed(app_outcome: RestOk, app_seen: gunbai_ci_declared, installation_outcome: RestOk) {
    InstallationGrantObserved { installation: i } => i.installation_id.value == gunbai_ci_declared_installation_id.value
    _ => false
  }
}

// THE DISCRIMINATING RED: a key GitHub does not accept is a 401 at GET /app, and it is a KEY
// rejection -- not an unobserved registration, not a missing installation.
test fn witness_a_rejected_key_is_signer_key_rejected() -> Bool {
  match signer_custody_of_app_read(
    key: key,
    observed_at: 1790000000,
    outcome: RestStatusRefused { status: 401, body: "{\"message\":\"A JSON web token could not be decoded\"}" },
    record: app_record(app: gunbai_ci_declared),
  ) {
    SignerReadbackFailed { cause } => match cause {
      SignerKeyRejected { status: s, body: _ } => s == 401
      _ => false
    }
    _ => false
  } && match sealed(
    app_outcome: RestStatusRefused { status: 401, body: "bad credentials" },
    app_seen: gunbai_ci_declared,
    installation_outcome: RestOk,
  ) {
    SignerCustodyUnresolved { app: _, custody: _ } => true
    _ => false
  }
}

// THE OTHER RED: a key GitHub accepts, but as a DIFFERENT App, refuses by name.
test fn witness_a_key_accepted_as_another_app_refuses_by_name() -> Bool {
  match sealed(app_outcome: RestOk, app_seen: gunbai_bot_declared, installation_outcome: RestOk) {
    SignerCustodyUnresolved { app: _, custody } => match custody {
      SignerReadbackFailed { cause } => match cause {
        SignerNamesDifferentApp { observed_app_id: o, declared_app_id: d } =>
          o.value == gunbai_bot_declared.app_id.value && d.value == gunbai_ci_declared.app_id.value
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

// A refusal that is not about the key (403, transport) is NOT reported as a rejected key.
test fn witness_a_non_401_refusal_is_unreached_not_rejected() -> Bool {
  match signer_custody_of_app_read(key: key, observed_at: 1790000000, outcome: RestStatusRefused { status: 403, body: "rate limited" }, record: app_record(app: gunbai_ci_declared)) {
    SignerReadbackFailed { cause } => match cause {
      SignerReadbackNotReached { detail: _ } => true
      _ => false
    }
    _ => false
  } && match signer_custody_of_app_read(key: key, observed_at: 1790000000, outcome: RestTransportRefused { cause: "connection refused" }, record: app_record(app: gunbai_ci_declared)) {
    SignerReadbackFailed { cause } => match cause {
      SignerReadbackNotReached { detail: _ } => true
      _ => false
    }
    _ => false
  }
}

// Custody observed, installation read refused: InstallationUnobserved, never a grant.
test fn witness_an_unread_installation_is_unobserved() -> Bool {
  match sealed(app_outcome: RestOk, app_seen: gunbai_ci_declared, installation_outcome: RestStatusRefused { status: 404, body: "Not Found" }) {
    InstallationUnobserved { app: _, reason: _ } => true
    _ => false
  }
}
