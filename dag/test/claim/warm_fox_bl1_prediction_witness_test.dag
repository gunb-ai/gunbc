module test.claim.warm_fox_bl1_prediction_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data warm_fox_bl1_prediction_note: String = "Compile-refusal RED at a FreeMonoid<Node> actual passed to a FreeMonoid<NormalizedTree> parameter (function-call boundary, not a record literal). Main control (origin/main): the same inline virtual module also refuses — observed mechanism container_element_nominal_brand_mismatch in direct_call_arg_type_mismatch, pre-existing, not structured_application_site_type_mismatch — so this witness does not credit PR #8262's wall for warm-fox BL-1. warm-fox-179's imported-carrier specimen (v2.compiler.normalized_tree.NormalizedTree sealed carrier) is a separate shape; merged scratch still reaches runtime root.root projection failure. Dissolve-on: replace inline virtual source with warm-fox's wall_specimen once the wall refuses that shape at typecheck."

fn w_warm_fox_bl1_call_boundary_red() -> Bool {
  compile_dag_rust_emit_check(
    "module warmfox_bl1_prediction\nimport std.algebra { Cons, Empty, FreeMonoid }\nimport v2.std.node { Node, TypeNode, Atom, SyntheticOccurrence }\n\ntype NormalizedTree sole_constructor {\n  root: Node,\n}\n\nfn fc_module_root() -> Node {\n  Node {\n    kind: TypeNode { connective: Atom { identity: ^fc_seg } },\n    children: [],\n    occurrence_id: SyntheticOccurrence,\n  }\n}\n\nfn fc_single_found_root() -> FreeMonoid<Node> {\n  Cons { head: fc_module_root(), tail: Empty }\n}\n\nfn validate_module_roots(roots: FreeMonoid<NormalizedTree>) -> Bool {\n  true\n}\n\nfn bad_call() -> Bool {\n  validate_module_roots(roots: fc_single_found_root())\n}\n",
    "src/warmfox_bl1_prediction.rs",
    [],
    []
  )
}

test fn warm_fox_bl1_free_monoid_node_at_normalized_tree_param_refuses() -> Bool {
  !w_warm_fox_bl1_call_boundary_red()
}
