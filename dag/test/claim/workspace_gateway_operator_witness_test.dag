module test.claim.workspace_gateway_operator_witness_test

import std.types { Bool, String }
import gunbc.runner_slot_allocation
import gunbc.workspace_gateway
import gunbc.fleet_known_hosts_anchor
import std.process { ExitSuccess, ExitFailure }
import gunbc.workspace_gateway_operator { workspace_gateway_refresh_operator_wet }

test fn gateway_refresh_refuses_unbounded_or_noncanonical_durations_before_observation() -> Bool {
  all(["", "0", "-1", "3601", "01", "forever"], duration => match workspace_gateway_refresh_operator_wet(seconds: duration) {
    ExitFailure { code: _, reason } => starts_with(s: reason, prefix: "GatewayRefreshRefused:")
    ExitSuccess => false
  })
}

test fn workspace_gateway_tailnet_names_have_one_enrolled_host_key() -> Bool {
  all(gunbc.runner_slot_allocation.workspace_execution_slot_identities(), slot =>
    match gunbc.workspace_gateway.workspace_fleet_gateway(slot: slot) {
      Absent => false
      Present { value: gateway } => count(filter(gunbc.fleet_known_hosts_anchor.fleet_known_hosts_rows(), row => row.endpoint == (gateway.tailnet_name as String))) == 1
    })
}
