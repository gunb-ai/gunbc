module test.claim.litsymbol_is_symbol

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_blocking_rows_of_class,
  census_total_count,
}

// Producer: v1.compiler.infer_types infer_literal_node types LitSymbol as symbol_type.
// The discriminating RED is the rust unit test infer_literal_node_types_litsymbol_as_symbol
// (node name Symbol). These rows are compile-path controls that stay after the producer lands.
// Symbol-vs-String inhabitance at a declared return is the implicit-safe subset, not this PR.

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn two_carets_compare() -> Bool {
  blocking_count(source: "module litsymbol.eq\nfn f() -> Bool { ^tag == ^tag }\n") == 0
}

test fn quoted_string_still_inhabits_string() -> Bool {
  blocking_count(source: "module litsymbol.litstr\nfn f() -> String { \"tag\" }\n") == 0
}

fn blocking_in_class(source: String, wanted_class: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows_of_class(rows: rows, wanted: wanted_class))
    CensusNotRunnable { cause: _ } => -1
  }
}

// RED for the widening: Symbol is outside kernel_type_set, so conformance once emitted nothing at ANY
// ground type and `-> Int { ^tag }` passed. Each refusal asserts the class, not only a nonzero count.
// The asserted class is the one the census checker EMITS at that position. At the seed's fixed-point
// stage0 mirrors all three refusals report TypeMismatch: an earlier mirror state reported
// DeclaredTypeNotInhabited at Int while Bool and a record reported TypeMismatch -- two classes for one
// judgment. Unifying them is the follow-up: bright-pike-492's item-2 scalar-formal rule.
test fn symbol_at_int_refuses() -> Bool {
  blocking_in_class(source: "module litsymbol.atint\nfn f() -> Int { ^tag }\n", wanted_class: "TypeMismatch") >= 1
}

test fn symbol_at_bool_refuses() -> Bool {
  blocking_in_class(source: "module litsymbol.atbool\nfn f() -> Bool { ^tag }\n", wanted_class: "TypeMismatch") >= 1
}

test fn symbol_at_record_refuses() -> Bool {
  blocking_in_class(source: "module litsymbol.atrec\ntype P { x: Int }\nfn f() -> P { ^tag }\n", wanted_class: "TypeMismatch") >= 1
}

// The declared gap stays open and is a control, not a refusal: Symbol at String is accepted
// (gunbc.recurring_failure_mode caret_symbol_inhabits_string_via_conformance_unjudged).
test fn symbol_at_string_stays_accepted() -> Bool {
  blocking_count(source: "module litsymbol.atstr\nfn f() -> String { ^tag }\n") == 0
}
