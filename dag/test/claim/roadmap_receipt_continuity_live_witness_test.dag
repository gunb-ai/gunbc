module test.claim.roadmap_receipt_continuity_live_witness

import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.roadmap_authority { roadmap_acceptance_history_integrity_holds }
import gunbc.roadmap_acceptance_history_carrier {
  load_roadmap_acceptance_event_history,
  RoadmapAcceptanceEventHistoryLoaded,
  RoadmapAcceptanceEventHistoryLoadRefused,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data live_witness_split_note: String = "SPLIT OUT OF roadmap_receipt_continuity_acceptance_test.dag AND roadmap_authority_test.dag SO THE HERMETIC DISCOVERY CORPUS CAN RUN. roadmap_acceptance_history_integrity_holds reaches git.Inspect.HeadCommit, git.Inspect.MergeBase, and git.Core.Show without mock_response, so under the hermetic envelope the observation REFUSES rather than skipping — and a planted git refusal must refuse integrity rather than fabricate prior_history = current. witness_missing_head_carrier_path_read_refuses uses Filesystem.Read on a deliberately missing path (no mock_response in the hermetic corpus), so it executes here on the wet batch. The hermetic contract keeps planted red controls only; this file executes the live git-observed integrity path and the carrier read-refusal control on the wet corpora batch."

test fn live_acceptance_history_integrity_holds_on_authority() -> Bool {
  roadmap_acceptance_history_integrity_holds()
}

test fn witness_missing_head_carrier_path_read_refuses() -> Bool {
  match load_roadmap_acceptance_event_history(
    path: "target/gunbc_missing_roadmap_carrier_probe_should_not_exist.jsonl",
  ) {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: detail } => detail != ""
  }
}
