  obligation_seed_escape_is_open,
  v2_compile_obligation_census
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CHECKS THAT MATTER HERE ARE THE ONES THAT READ SOMEBODY ELSE'S DATA. An earlier cut of this
// file folded over rows the census itself authored and called the result a check; review 63152 named
// that correctly as a change detector over a copy of the current tree, and DESIGN section 5 says the
// same thing in its own words. The census now DERIVES each obligation's per-PR standing by asking
// gunbc.witness_deferral_freeze and gunbc.ci_layer_roots, so the arms below exercise a join against
// two live rosters this file does not own and cannot edit — which is what makes them oracles rather
// than mirrors, and which is what would have caught the reading error that cut shipped.
//
// WHAT IS STILL NOT CHECKED, SAID PLAINLY. Nothing here asserts that the census's row set equals the
// contents of always_required_root_lenses and always_required_lenses: that is an identity join over
// two list literals no reader available here can walk, so a lens de-enrolled from the roster would
// leave a stale row standing. Cited-symbol resolution is uncovered corpus-wide under the existing
// declared drop gunbc.rung_drop cited_symbol_census, and the entry paths below inherit it. Both are
// the census's own next trigger, not silences.

data fixture_home: DeclarationRef = decl_ref(module_path: "fixture.module", decl_name: "fixture_decl")

data fixture_stall: DeclarationRef = decl_ref(
  module_path: "fixture.stall",
  decl_name: "fixture_stall_decl"
)

// TWO REAL SUBJECTS FROM OPPOSITE SIDES OF THE LIVE ROSTERS, chosen because each is decided by a
// DIFFERENT authority. The mandatory-tag entry is covered by gunbc.witness_deferral_freeze AND sits
// under the "test/claim/long/" exclusion pattern; the fact-density entry is subtracted by neither.
// If either roster changes underneath this file, one of these two arms flips — which is the whole
// point of asking rather than asserting.
fn frozen_and_excluded_subject() -> WitnessSubject {
  witness_subject(
    entry: "src/v2/test/claim/long/mandatory_tag_gate_witness_test.dag",
    function: "mandatory_tag_enrolled_in_root_roster_rejects_violating_module",
    module_path: "v2.test.long.mandatory_tag_gate_witness"
  )
}

fn discovered_subject() -> WitnessSubject {
  witness_subject(
    entry: "src/v2/test/lens_fact_density/hollow_alias_blocked_via_always_required_lenses_test.dag",
    function: "hollow_alias_blocked_via_always_required_lenses_holds",
    module_path: "v2.test.lens_fact_density.hollow_alias_blocked_via_always_required_lenses"
  )
}

fn non_executing_arm() -> PathExecution {
  RouteGapHeld { stall: fixture_stall }
}

fn fixture_reach() -> RouteReach {
  NotNamedByAnyExecutingRoute { note: "fixture reach" as NonEmptyStr }
}

fn fixture_row(subject: WitnessSubject) -> V2CompileObligation {
  V2CompileObligation {
    identity: "fixture_row" as NonEmptyStr,
    kind: RequiredRootLens,
    home: HomeAuthority { authority: fixture_home },
    claimed_rung: StructurallyGuaranteed,
    witnesses: [subject],
    discriminating_red: "fixture red" as NonEmptyStr,
    positive_control: "fixture positive control" as NonEmptyStr,
    route_reach: fixture_reach(),
    ceiling: StructurallyGuaranteed,
    next_trigger: climbs_when(capability: "fixture trigger"),
    seed_escape: SeedEscapeOpen { what_the_seed_does: "fixture escape" as NonEmptyStr },
    related_drops: [],
  }
}

fn closed_escape_fixture_row() -> V2CompileObligation {
  V2CompileObligation {
    identity: "fixture_closed" as NonEmptyStr,
    kind: CompileDoor,
    home: HomeAuthority { authority: fixture_home },
    claimed_rung: MechanicallyPreventable,
    witnesses: [discovered_subject()],
    discriminating_red: "fixture red" as NonEmptyStr,
    positive_control: "fixture positive control" as NonEmptyStr,
    route_reach: fixture_reach(),
    ceiling: StructurallyGuaranteed,
    next_trigger: climbs_when(capability: "fixture trigger"),
    seed_escape: SeedEscapeClosed { by: fixture_home },
    related_drops: [],
  }
}

fn guarantee_rung_is(r: GuaranteeRung, expected: String) -> Bool {
  match r {
    OutsideTheLadder => expected == "OutsideTheLadder"
    Mitigatable => expected == "Mitigatable"
    MechanicallyPreventable => expected == "MechanicallyPreventable"
    StructurallyGuaranteed => expected == "StructurallyGuaranteed"
    StructurallyImpossible => expected == "StructurallyImpossible"
  }
}

// THE JOIN, IN BOTH DIRECTIONS, AGAINST BOTH ROSTERS. A derivation that answered "not executing" to
// everything would satisfy the first conjunct and fail the second; one that answered "executing" to
// everything fails the first. The two inner arms additionally separate WHICH authority decided,
// because a derivation that had silently lost the freeze lookup would still get the mandatory-tag
// answer right through the exclusion pattern alone and nobody would notice the missing half.
test fn v2_compile_obligation_per_pr_standing_is_derived_from_the_live_rosters_holds() -> Bool {
  !witness_subject_survives_every_subtraction(w: frozen_and_excluded_subject())
    && witness_subject_survives_every_subtraction(w: discovered_subject())
    && witness_subject_is_frozen(w: frozen_and_excluded_subject())
    && witness_subject_is_excluded(w: frozen_and_excluded_subject())
    && !witness_subject_is_frozen(w: discovered_subject())
    && !witness_subject_is_excluded(w: discovered_subject())
}

// THE ROUTE-COVERAGE RUNG IGNORES THE CLAIM. Both fixture rows claim StructurallyGuaranteed. The one whose
// paths do not execute must still read Mitigatable, and the one whose paths do execute must read
// MechanicallyPreventable — so the function is neither a constant nor a reader of claimed_rung. This
// is DESIGN section 4b(1) applied to the census itself: without this arm a row could raise its own
// executed rung by restating its claim, which is the exact inflation the census exists to measure.
test fn v2_compile_obligation_route_coverage_rung_reads_the_paths_not_the_claim_holds() -> Bool {
  guarantee_rung_is(
    r: obligation_route_coverage_rung(
      o: fixture_row(subject: frozen_and_excluded_subject())
    ),
    expected: "Mitigatable"
  )
    && guarantee_rung_is(
      r: obligation_route_coverage_rung(
        o: fixture_row(subject: discovered_subject())
      ),
      expected: "MechanicallyPreventable"
    )
}

// THE SEED-ESCAPE ARMS ARE DISTINGUISHED BY THE ARM, NOT BY PROSE. Every row in the live roster is
// currently open, so a constant-true reader would be indistinguishable from a correct one when read
// over the roster alone. The closed fixture is what separates them.
test fn v2_compile_obligation_seed_escape_arms_are_distinguished_holds() -> Bool {
  obligation_seed_escape_is_open(
    o: fixture_row(subject: discovered_subject())
  )
    && !obligation_seed_escape_is_open(o: closed_escape_fixture_row())
}

// THE NATIVE COLUMN IS DERIVED, AND ITS PREDECESSOR ARM RETIRED BY ITS OWN DISSOLUTION. Until
// gunbc#10882 landed, this file asserted that no row executes natively, and said in its own words
// that the flip "is this arm's intended dissolution, not a regression — the arm deletes then rather
// than being repaired back to passing". The lane landed, the arm went red, and it is deleted rather
// than weakened. What replaces it is the check that matters now: native standing is DERIVED from the
// lane's own universe predicate intersected with floor discovery, so a row is reported as executing
// natively only when the emitted binary's population actually contains its identity.
//
// THE NEGATIVE CONTROL IS AN EXCLUDED SUBJECT, NOT AN OUT-OF-PREFIX ONE, because the prefix half is
// already covered by the gate-closure arm and because the excluded half is where the first cut of
// this derivation was wrong: asking the lane's prefix predicate alone reported two carved-out
// obligations as natively executing.
test fn v2_compile_obligation_native_standing_intersects_discovery_holds() -> Bool {
  witness_subject_in_native_lane(w: discovered_subject())
    && !witness_subject_in_native_lane(w: frozen_and_excluded_subject())
    && !witness_subject_in_native_lane(w: this_witnesss_own_subject())
}

// THE CENSUS'S HEADLINE COMPARISON, EXERCISED ON FOUR ROWS THAT DIFFER ON BOTH AXES. Inflation is
// claimed > executed, so the arms have to vary the claim AND the paths independently or a passing
// predicate could be reading only one of them. A row claiming StructurallyGuaranteed on
// non-executing paths IS inflated (rank 3 over 1). The same row claiming Mitigatable on the same
// paths is NOT, because claiming no more than your paths establish is honesty and not a defect —
// that arm is what stops the predicate from being "claim is high". A row whose paths both execute
// and whose claim is exactly the MechanicallyPreventable that establishes is NOT inflated — that arm
// is what stops it from being "paths do not execute", and it is the arm that would convict every
// correctly-claimed row the day the native lane starts executing. And a row whose paths both execute
// while it still claims StructurallyGuaranteed IS inflated, one rank rather than two, which is what
// stops the predicate from collapsing to a boolean executes/does-not.
//
// THE THIRD ARM WAS WRONG IN THE FIRST CUT AND THE WITNESS CAUGHT IT: it reused the shared fixture,
// which hardcodes a StructurallyGuaranteed claim, and then asserted the row was not inflated while
// it executed at MechanicallyPreventable. The witness returned false rather than green, which is the
// arm doing its job on its own author.
test fn v2_compile_obligation_rung_inflation_is_a_strict_inequality_holds() -> Bool {
  obligation_rung_is_inflated(
    o: fixture_row(subject: frozen_and_excluded_subject())
  )
    && !obligation_rung_is_inflated(o: honestly_claimed_fixture_row())
    && !obligation_rung_is_inflated(o: fully_executing_exact_claim_fixture_row())
    && obligation_rung_is_inflated(
      o: fixture_row(subject: discovered_subject())
    )
}

// A CLAIM ABOVE THE ROW'S OWN CEILING IS INCOHERENT, and unlike the emptiness checks this module
// deleted, this RED is authorable — the ceiling and the claim are independent fields and a fixture
// can set them in either order.
test fn v2_compile_obligation_claim_above_its_own_ceiling_is_detected_holds() -> Bool {
  obligation_claim_exceeds_its_ceiling(o: over_ceiling_fixture_row())
    && !obligation_claim_exceeds_its_ceiling(
      o: fixture_row(subject: discovered_subject())
    )
}

fn honestly_claimed_fixture_row() -> V2CompileObligation {
  V2CompileObligation {
    identity: "fixture_honest" as NonEmptyStr,
    kind: RequiredRootLens,
    home: HomeAuthority { authority: fixture_home },
    claimed_rung: Mitigatable,
    witnesses: [frozen_and_excluded_subject()],
    discriminating_red: "fixture red" as NonEmptyStr,
    positive_control: "fixture positive control" as NonEmptyStr,
    route_reach: fixture_reach(),
    ceiling: StructurallyGuaranteed,
    next_trigger: climbs_when(capability: "fixture trigger"),
    seed_escape: SeedEscapeOpen { what_the_seed_does: "fixture escape" as NonEmptyStr },
    related_drops: [],
  }
}

fn over_ceiling_fixture_row() -> V2CompileObligation {
  V2CompileObligation {
    identity: "fixture_over_ceiling" as NonEmptyStr,
    kind: RequiredRootLens,
    home: HomeAuthority { authority: fixture_home },
    claimed_rung: StructurallyGuaranteed,
    witnesses: [discovered_subject()],
    discriminating_red: "fixture red" as NonEmptyStr,
    positive_control: "fixture positive control" as NonEmptyStr,
    route_reach: fixture_reach(),
    ceiling: Mitigatable,
    next_trigger: climbs_when(capability: "fixture trigger"),
    seed_escape: SeedEscapeOpen { what_the_seed_does: "fixture escape" as NonEmptyStr },
    related_drops: [],
  }
}

fn fully_executing_exact_claim_fixture_row() -> V2CompileObligation {
  V2CompileObligation {
    identity: "fixture_exact" as NonEmptyStr,
    kind: RequiredRootLens,
    home: HomeAuthority { authority: fixture_home },
    claimed_rung: MechanicallyPreventable,
    witnesses: [discovered_subject()],
    discriminating_red: "fixture red" as NonEmptyStr,
    positive_control: "fixture positive control" as NonEmptyStr,
    route_reach: fixture_reach(),
    ceiling: StructurallyGuaranteed,
    next_trigger: climbs_when(capability: "fixture trigger"),
    seed_escape: SeedEscapeOpen { what_the_seed_does: "fixture escape" as NonEmptyStr },
    related_drops: [],
  }
}

// THE UNVERIFIED-ENTRY DEBT IS COUNTED, NOT ASSUMED. A row whose subject survives both subtractions
// reports ExecutedPendingVerification and is counted as debt; a row whose subject is frozen and
// excluded reports neither and is not. Without the second arm a constant-true reader would be
// indistinguishable from a correct one, and the debt number would equal the row count forever.
//
// THIS ARM EXISTS BECAUSE THE FIRST CUT WIDENED. "Not frozen and not excluded" was reported as plain
// ExecutedOnPath, so a moved or deleted entry — covered by neither roster — would have read as
// covered at exactly the moment the derivation stopped being able to decide. The arm is now
// separate, loud and counted, and its dissolution is bound to
// gunbc.v2_compile_obligation_census entry_existence_verification_trigger.
test fn v2_compile_obligation_unverified_entry_debt_is_counted_holds() -> Bool {
  obligation_executes_on_an_unverified_entry(
    o: fixture_row(subject: discovered_subject())
  )
    && !obligation_executes_on_an_unverified_entry(
      o: fixture_row(subject: frozen_and_excluded_subject())
    )
}

// THE GATE-CLOSURE SUBTRACTION, WITH THIS FILE'S OWN MODULE AS THE NEGATIVE CONTROL. The required
// floor prepares the import closure of v2.workflow.required_floor required_gate_prefixes, not the
// corpus, so a discovered witness outside that roster is dispositioned DeclinedOutsideGateClosure
// and does not run. Every witness the census names is under v2.test., which the roster admits.
//
// AND THIS WITNESS IS NOT. test.claim.v2_compile_obligation_census_witness_test matches no prefix in
// the roster, so the arm below asserts its own dormancy on ordinary required floors. What selects it
// otherwise is narrower than a closure walk: changed-witness selection folds the EDITED TEST
// FUNCTIONS in the run's diff, so editing what these arms CALL without editing the arms themselves
// selects nothing. That is an
// uncomfortable thing for a witness to prove about itself and it is the honest pair: a predicate
// that answered "inside" to everything would pass the first conjunct and fail the second, and using
// any other module as the control would have let this file avoid stating its own standing.
test fn v2_compile_obligation_gate_closure_subtraction_is_asked_holds() -> Bool {
  witness_subject_is_inside_gate_closure(w: discovered_subject())
    && witness_subject_is_inside_gate_closure(w: frozen_and_excluded_subject())
    && !witness_subject_is_inside_gate_closure(w: this_witnesss_own_subject())
}

fn this_witnesss_own_subject() -> WitnessSubject {
  witness_subject(
    entry: "dag/test/claim/v2_compile_obligation_census_witness_test.dag",
    function: "v2_compile_obligation_gate_closure_subtraction_is_asked_holds",
    module_path: "test.claim.v2_compile_obligation_census_witness_test"
  )
}

// THE PENDING PREMISES ARE DISTINGUISHED BY THE PREMISE, NOT BY THE ARM. The per-premise counts move
// together on the live roster, so a reader could reasonably suspect one is the other under another
// name — and in the first cut of that pair it WAS, folding the same predicate twice. This arm builds
// a standing carrying only the entry premise and shows the gate premise is absent from it, which is
// the shape neither count can produce from the live roster and the only thing that makes "two
// numbers, two premises" a claim rather than a coincidence.
test fn v2_compile_obligation_pending_premises_are_read_individually_holds() -> Bool {
  standing_carries_premise(p: entry_only_pending_standing(), premise: unverified_entry_premise)
    && !standing_carries_premise(
      p: entry_only_pending_standing(),
      premise: unread_native_verdict_premise
    )
    && standing_carries_premise(p: both_premises_pending_standing(), premise: unverified_entry_premise)
    && standing_carries_premise(
      p: both_premises_pending_standing(),
      premise: unread_native_verdict_premise
    )
    && !standing_carries_premise(p: non_executing_arm(), premise: unverified_entry_premise)
}

fn entry_only_pending_standing() -> PathExecution {
  ExecutedPendingVerification {
    instrument: "fixture instrument" as NonEmptyStr,
    unverified_premises: [unverified_entry_premise]
  }
}

fn both_premises_pending_standing() -> PathExecution {
  ExecutedPendingVerification {
    instrument: "fixture instrument" as NonEmptyStr,
    unverified_premises: [unverified_entry_premise, unread_native_verdict_premise]
  }
}

// THE NATIVE PREMISE IS READ OFF THE NATIVE ARM, NOT THE INTERPRETED ONE. For one cut
// unread_native_verdict_premise was attached to every native standing and folded by nothing, so the
// coverage and inflation counts spent it as if the verdict had been read. The fold that fixes it
// has to reach native_standing specifically, and the second conjunct is what pins that: the SAME row
// asked through obligation_is_pending_on -- the interpreted fold -- answers false for this premise,
// because the interpreted arm does not carry it. So a fold that read the wrong standing would look
// exactly like a correct one on the first conjunct and fail here.
//
// THE FIRST CUT OF THIS ARM CONTRASTED THE WRONG THING. It asserted the native arm does NOT carry
// the entry premise, and the native arm carries both -- the premises co-occur, which is why they are
// a list. The arm went red and the contrast moved to the fold, which is where the defect was.
test fn v2_compile_obligation_native_verdict_premise_is_counted_holds() -> Bool {
  obligation_is_pending_on_native(
    o: fixture_row(subject: discovered_subject()),
    premise: unread_native_verdict_premise
  )
    && !obligation_is_pending_on(
      o: fixture_row(subject: discovered_subject()),
      premise: unread_native_verdict_premise
    )
    && !obligation_is_pending_on_native(
      o: fixture_row(subject: frozen_and_excluded_subject()),
      premise: unread_native_verdict_premise
    )
}
