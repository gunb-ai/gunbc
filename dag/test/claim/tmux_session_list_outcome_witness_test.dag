module test.claim.tmux_session_list_outcome_witness


test fn witness_no_server_running_classifies_empty() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: false,
    stdout: "",
    stderr: "no server running on /tmp/tmux-1000/default",
  ) {
    extdeps.tmux.TmuxNoServer { evidence: _ } => true
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => false
    extdeps.tmux.TmuxListStdoutRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_no_sessions_classifies_empty() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: false,
    stdout: "",
    stderr: "no sessions",
  ) {
    extdeps.tmux.TmuxNoServer { evidence: _ } => true
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => false
    extdeps.tmux.TmuxListStdoutRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_enoent_socket_classifies_empty() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/srv1-green (No such file or directory)",
  ) {
    extdeps.tmux.TmuxNoServer { evidence: e } =>
      e == "error connecting to /tmp/tmux-1000/srv1-green (No such file or directory)"
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => false
    extdeps.tmux.TmuxListStdoutRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_connection_refused_is_unknowable() -> Bool {
  let stderr = "error connecting to /tmp/tmux-1000/srv1-green (Connection refused)"
  match extdeps.tmux.classify_tmux_session_list(exit_ok: false, stdout: "", stderr: stderr) {
    extdeps.tmux.TmuxListUnknowable { stderr: e } => e == stderr
    extdeps.tmux.TmuxNoServer { evidence: _ } => false
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxListStdoutRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_permission_denied_is_unknowable() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/default (Permission denied)",
  ) {
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => true
    extdeps.tmux.TmuxNoServer { evidence: _ } => false
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxListStdoutRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_exit_ok_parses_sessions() -> Bool {
  let output = "alpha: 1 windows (created Fri Jul  3 04:14:00 2026)\nbeta: 2 windows (created Fri Jul  3 04:15:00 2026)\n"
  match extdeps.tmux.classify_tmux_session_list(exit_ok: true, stdout: output, stderr: "") {
    extdeps.tmux.TmuxSessionsListed { entries } =>
      count(entries) == 2
        && entries.first().session_name == "alpha"
        && entries.first().windows == 1
        && entries.skip(n: 1).first().session_name == "beta"
        && entries.skip(n: 1).first().windows == 2
    extdeps.tmux.TmuxNoServer { evidence: _ } => false
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => false
    extdeps.tmux.TmuxListStdoutRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_ls_output_parse_matches_classifier() -> Bool {
  let output = "gunbc-dispatch-node-4: 2 windows (created Fri Jul  3 04:15:00 2026)\n"
  match extdeps.tmux.parse_tmux_ls_output(output: output) {
    extdeps.tmux.TmuxLsParsed { entries } =>
      count(entries) == 1
        && entries.first().session_name == "gunbc-dispatch-node-4"
    extdeps.tmux.TmuxLsParseRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_malformed_stdout_line_refuses() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: true,
    stdout: "gunbc-dispatch-a: not-a-window-count\n",
    stderr: "",
  ) {
    extdeps.tmux.TmuxListStdoutRefused { line_number, raw, reason } =>
      line_number == 1
        && string_contains(s: raw, pattern: "not-a-window-count")
        && string_contains(s: reason, pattern: "windows")
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxNoServer { evidence: _ } => false
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => false
  }
}

test fn witness_truncated_stdout_refuses_not_empty_listed() -> Bool {
  match extdeps.tmux.classify_tmux_session_list(
    exit_ok: true,
    stdout: "gunbc-dispatch-a: 1 windows (created ...)\npartial-line-without-colon\n",
    stderr: "",
  ) {
    extdeps.tmux.TmuxListStdoutRefused { line_number, raw, reason } =>
      line_number == 2
        && string_contains(s: raw, pattern: "partial-line-without-colon")
        && string_contains(s: reason, pattern: "windows")
    extdeps.tmux.TmuxSessionsListed { entries: _ } => false
    extdeps.tmux.TmuxNoServer { evidence: _ } => false
    extdeps.tmux.TmuxListUnknowable { stderr: _ } => false
  }
}

test fn witness_corrupted_windows_token_refuses() -> Bool {
  match extdeps.tmux.parse_tmux_ls_output(output: "gunbc-dispatch-a: 1 corrupted windows\n") {
    extdeps.tmux.TmuxLsParsed { entries: _ } => false
    extdeps.tmux.TmuxLsParseRefused { line_number, raw, reason } =>
      line_number == 1
        && string_contains(s: raw, pattern: "corrupted")
        && string_contains(s: reason, pattern: "positive_int")
  }
}

test fn witness_negative_window_count_refuses() -> Bool {
  match extdeps.tmux.parse_tmux_ls_output(output: "gunbc-dispatch-a: -1 windows\n") {
    extdeps.tmux.TmuxLsParsed { entries: _ } => false
    extdeps.tmux.TmuxLsParseRefused { line_number, raw, reason } =>
      line_number == 1
        && string_contains(s: raw, pattern: "-1")
        && string_contains(s: reason, pattern: "positive_int")
  }
}

test fn witness_attempt_panes_parse_alive_and_exit() -> Bool {
  match extdeps.tmux.parse_tmux_attempt_panes_output(
    output: "gunbc-dispatch-a\t0\t\tnode\ngunbc-dispatch-b\t1\t7\tnode\n",
  ) {
    extdeps.tmux.AttemptPanesParsed { panes } =>
      count(panes) == 2
        && !panes.first().dead
        && panes.skip(n: 1).first().dead
        && panes.skip(n: 1).first().exit_code == Present { value: 7 }
    extdeps.tmux.AttemptPanesParseRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_attempt_panes_malformed_row_refuses() -> Bool {
  match extdeps.tmux.parse_tmux_attempt_panes_output(
    output: "gunbc-dispatch-a\t1\tbogus\tnode\n",
  ) {
    extdeps.tmux.AttemptPanesParsed { panes: _ } => false
    extdeps.tmux.AttemptPanesParseRefused { line_number, raw, reason } =>
      line_number == 1
        && string_contains(s: raw, pattern: "bogus")
        && string_contains(s: reason, pattern: "dead/status")
  }
}
