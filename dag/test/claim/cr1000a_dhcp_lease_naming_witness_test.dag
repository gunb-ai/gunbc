module test.claim.cr1000a_dhcp_lease_naming


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data srv1_option12_host_name: extdeps.dns.domain_name.HostName = extdeps.dns.domain_name.HostName {
  name: extdeps.dns.domain_name.DomainName { labels: ["srv1" as extdeps.dns.domain_name.DnsLabel] },
  qualification: extdeps.dns.domain_name.PartiallyQualified,
}

data sample_dynamic_srv1_lease: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow {
  mac_address: "48:21:0B:81:C6:EA" as extdeps.dhcp.v4.MacAddress,
  ipv4_address: "192.168.1.185" as extdeps.dhcp.v4.Ipv4Address,
  lease: extdeps.dhcp.v4.DynamicDhcpLease {
    client_hostname: Present { value: srv1_option12_host_name },
    lease_time_remaining: extdeps.dhcp.v4.dhcp_lease_remaining_from_cited_minutes(minutes: 120),
    status: extdeps.dhcp.v4.Active,
  },
}

data sample_static_srv3_reservation: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow {
  mac_address: "48:21:0B:81:C5:14" as extdeps.dhcp.v4.MacAddress,
  ipv4_address: "192.168.1.192" as extdeps.dhcp.v4.Ipv4Address,
  lease: extdeps.dhcp.v4.StaticDhcpReservation {
    reservation_label: "bmc-altrad8ud-1l2t-3" as std.types.NonEmptyStr,
    status: extdeps.dhcp.v4.Active,
  },
}

test fn cr1000a_catalog_grounds_verizon_cr1000a() -> Bool {
  extdeps.router.verizon_cr1000a.cr1000a_catalog.model_number == "CR1000A"
    && extdeps.router.verizon_cr1000a.cr1000a_catalog.manufacturer == extdeps.vendor.verizon.verizon
}

test fn dhcp_lease_observation_discriminates_option_12_vs_reservation_label() -> Bool {
  match sample_dynamic_srv1_lease.lease {
    extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: Present { value: h }, lease_time_remaining: remaining, status: Active } =>
      h == srv1_option12_host_name
        && extdeps.dhcp.v4.dhcp_lease_remaining_cited_minutes(remaining: remaining) == 120
    extdeps.dhcp.v4.StaticDhcpReservation { reservation_label: _, status: _ } => false
  }
    && match sample_static_srv3_reservation.lease {
      extdeps.dhcp.v4.StaticDhcpReservation { reservation_label: l, status: Active } =>
        l == ("bmc-altrad8ud-1l2t-3" as std.types.NonEmptyStr)
      extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: _, lease_time_remaining: _, status: _ } => false
    }
}

test fn dhcp_lease_observation_construction_excludes_misbound_name_kind() -> Bool {
  match sample_dynamic_srv1_lease.lease {
    extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: _, lease_time_remaining: _, status: _ } => true
    extdeps.dhcp.v4.StaticDhcpReservation { reservation_label: _, status: _ } => false
  }
    && match sample_static_srv3_reservation.lease {
      extdeps.dhcp.v4.StaticDhcpReservation { reservation_label: _, status: _ } => true
      extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: _, lease_time_remaining: _, status: _ } => false
    }
}
