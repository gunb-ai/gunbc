module test.claim.altra_placement_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn plan_or_empty() -> product.altra_motherboard.placement.BoardPlacementPlan? {
  match product.altra_motherboard.placement.altra_reference_plan() {
    std.orthogonal_geometry.OrthogonalReady { value: p } => Present { value: p }
    std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
  }
}

fn cause_tag(r: product.altra_motherboard.placement.PlacementRefusal) -> std.types.NonEmptyStr {
  match r {
    product.altra_motherboard.placement.ComponentEnvelopeNotEstablished { component: _, gap: _ } => "EnvelopeMissing"
    product.altra_motherboard.placement.RequiredRoleUnfilled { role: _ } => "RoleUnfilled"
    product.altra_motherboard.placement.ComponentFillsNoRequiredRole { component: _, role_named: _ } => "RoleUnjustified"
    product.altra_motherboard.placement.PlannedIdentityRepeated { component: _ } => "IdentityRepeated"
    product.altra_motherboard.placement.RoleFilledMoreThanOnce { role: _, fills: _ } => "RoleFilledTwice"
    product.altra_motherboard.placement.PlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => "DesignMismatch"
    RequiredFunctionWithoutJustifiedPartOnBoard { requirement: _ } => "FunctionMissing"
  }
}

fn count_tagged(cs: List<product.altra_motherboard.placement.PlacementRefusal>, wanted: String) -> Int {
  fold(cs, init: 0, f: fn(acc, r) { if (cause_tag(r: r) as String) == wanted { acc + 1 } else { acc } })
}

// THE OUTLINE CONSTRUCTS, which is what makes every test below a statement about placement rather
// than about a plan that does not exist. It is asserted rather than assumed because the plan's
// refused arm is real: if the outline ever stopped constructing, the tests would otherwise pass
// vacuously against an absent plan.
test fn w_the_reference_plan_constructs() -> Bool {
  match plan_or_empty() {
    Present { value: _ } => true
    Absent => false
  }
}

// THE PLAN REFUSES, AND THAT IS THE INCREMENT'S HONEST STATE. One envelope is established and the
// rest are obligations, so a board cannot be laid out yet. Reporting this as admitted would be the
// fabricated plausible output: a layout built from dimensions nobody established.
test fn w_the_reference_plan_refuses_because_envelopes_are_outstanding() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      match product.altra_motherboard.placement.admit_placement(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p) {
        product.altra_motherboard.placement.PlacementAdmitted { plan: _ } => false
        product.altra_motherboard.placement.PlacementRefused { causes: cs } => count_tagged(cs: cs, wanted: "EnvelopeMissing") > 0
      }
  }
}

// EVERY REQUIRED ROLE IS FILLED. The plan is not short of parts — it names every component the
// design requires — so the refusal above is exactly about dimensions and not about an incomplete
// population. Without this, a plan missing half the board would produce the same verdict.
test fn w_the_population_is_complete_so_the_refusal_is_only_about_envelopes() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p), wanted: "RoleUnfilled") == 0
        && count_tagged(cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p), wanted: "RoleUnjustified") == 0
  }
}

// THE OBLIGATIONS ARE EXACT AND COUNTED. Twelve of seventeen required components have no
// established envelope; the five that do are the board-control CPLD, the processor package, and
// three cited mechanical-candidate bodies for host PHY, power stage, and power-good supervision.
test fn w_the_outstanding_obligations_are_counted_exactly() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      product.altra_motherboard.placement.established_envelope_count(plan: p) == 5
        && product.altra_motherboard.placement.outstanding_obligation_count(plan: p) == 12
  }
}

// THE PREMISE THE CONTROL BELOW NEEDS, and it is only the premise. The socket layer and the
// processor package layer report DIFFERENT standings — the socket has a blocker, the package has
// none — so "which one did placement consume" is a question with a distinguishable answer. This
// test reads the two standings directly and never touches placement, so it cannot detect a wrong
// binding; asserting it separately keeps the control below from passing vacuously if the two
// standings ever converge.
test fn w_the_socket_and_package_standings_are_distinguishable() -> Bool {
  let socket_has_blocker = match product.altra_motherboard.attachment_stack.subject_blocker(fact: socket_standing.fact, carriage: socket_standing.carriage) {
    Present { value: _ } => true
    Absent => false
  }
  let package_has_none = match product.altra_motherboard.attachment_stack.subject_blocker(fact: processor_package_standing.fact, carriage: processor_package_standing.carriage) {
    Absent => true
    Present { value: _ } => false
  }
  socket_has_blocker && package_has_none
}

// THE REGRESSION CONTROL FOR THIS PR'S ROOT DEFECT. The socket obligation must carry the SOCKET
// layer's blocker, and this joins the plan's gap to that layer's own payload — no literal appears
// on either side, so the test states an identity rather than recognizing a phrase somebody could
// paste onto the wrong standing. Mutation-verified: rebinding placement to the package standing
// reds this, because the package reports no blocker and the socket obligation loses its payload.
// THE PAYLOAD OF ANY BLOCKER, projected once and used on both sides of the join below. Reading it
// per-variant at each site would make the witness a statement about which KIND of blocker the
// socket layer currently has, and the land-pattern layer has already changed kind once -- from a
// document nobody had found to a figure nobody has read. The claim being made is that the plan's
// socket gap IS the socket layer's blocker, and that claim should survive the layer changing kind.
fn blocker_payload(b: product.altra_motherboard.attachment_stack.FactAuthorityBlocker) -> String {
  match b {
    product.altra_motherboard.attachment_stack.NeedsSomeoneToFindTheDocument { what_is_missing: w } => w as String
    product.altra_motherboard.attachment_stack.NeedsCommercialAccess { subject: sj, access_route: _ } => sj as String
    product.altra_motherboard.attachment_stack.NeedsARedistributionDecision { reason: r } => r as String
    product.altra_motherboard.attachment_stack.NeedsAHumanToReadTheDrawing { figure: _, what_is_drawn: d } => d as String
    product.altra_motherboard.attachment_stack.NeedsTheStandingItselfRepaired { refusal: _ } => "standing-self-contradictory"
  }
}

fn socket_layer_gap_text() -> String {
  match product.altra_motherboard.attachment_stack.subject_blocker(fact: socket_standing.fact, carriage: socket_standing.carriage) {
    Present { value: b } => blocker_payload(b: b)
    Absent => ""
  }
}

test fn w_the_plan_socket_obligation_carries_the_socket_layers_own_blocker() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      (socket_layer_gap_text() as String) != ""
        && fold(p.components, init: false, f: fn(acc, c) {
          if !product.altra_motherboard.placement.roles_equal(a: c.role, b: product.altra_motherboard.placement.ProcessorSocket) {
            acc
          } else {
            match c.envelope {
              product.altra_motherboard.placement.EnvelopeEstablished { envelope: _, source: _ } => acc
              product.altra_motherboard.placement.EnvelopeNotEstablished { gap: g } =>
                acc || (blocker_payload(b: g) as String) == (socket_layer_gap_text() as String)
            }
          }
        })
  }
}

// ONLY ESTABLISHED COMPONENTS CROSS INTO GEOMETRY. An obligation has no extent, so handing it to a
// collision check would require inventing one. This asserts the bridge carries exactly the
// components whose size is known — the alternative, a zero-sized part that collides with nothing,
// is how an unplaced component would come to read as a placed one. The processor package is the
// second member and the one that matters: its envelope comes from a cited datasheet section rather
// than from a part somebody picked, so this is the join proving an established fact reaches
// geometry. The socket is deliberately NOT here — same silicon, different subject, still owed.
test fn w_only_established_components_reach_the_geometry_bridge() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      fold(product.altra_motherboard.placement.placeable_components(plan: p), init: 0, f: fn(acc, _c) { acc + 1 }) == 5
        && fold(product.altra_motherboard.placement.placeable_components(plan: p), init: false, f: fn(acc, c) {
          acc || (c.identity as String) == "board_control_cpld"
        })
        && fold(product.altra_motherboard.placement.placeable_components(plan: p), init: false, f: fn(acc, c) {
          acc || (c.identity as String) == "processor_package"
        })
        && fold(product.altra_motherboard.placement.placeable_components(plan: p), init: false, f: fn(acc, c) {
          acc || (c.identity as String) == "host_phy"
        })
        && fold(product.altra_motherboard.placement.placeable_components(plan: p), init: false, f: fn(acc, c) {
          acc || (c.identity as String) == "power_stage"
        })
        && fold(product.altra_motherboard.placement.placeable_components(plan: p), init: false, f: fn(acc, c) {
          acc || (c.identity as String) == "power_good"
        })
        && fold(product.altra_motherboard.placement.placeable_components(plan: p), init: true, f: fn(acc, c) {
          acc && (c.identity as String) != "cpu_socket"
        })
  }
}

// THE TRANSCRIPTION IS PINNED TO THE CITED SECTION. The oracle here is the external document —
// Rev A1 datasheet Issue 1.15, section 3 Mechanical Data, 77.080 mm by 67.000 mm — and not a
// measurement taken from this tree, so the literals are grounded rather than copied from whatever
// the row currently says. Micrometres because the datasheet's third decimal place is significant:
// 77.080 mm is 77080 um exactly, and a carrier in millimetres would have to round it.
test fn w_the_package_envelope_carries_the_cited_body_extent() -> Bool {
  match product.altra_motherboard.placement.processor_package_envelope {
    product.altra_motherboard.placement.EnvelopeNotEstablished { gap: _ } => false
    product.altra_motherboard.placement.EnvelopeEstablished { envelope: e, source: _ } =>
      std.measure.micrometer_count(m: e.body_width) == 77080
        && std.measure.micrometer_count(m: e.body_height) == 67000
        && (e.package_designator as String) == "FCLGA4926"
  }
}

// THE UNIT-ERROR DISCRIMINATOR, which is the failure this transcription is actually exposed to. A
// package written as 77 um instead of 77080 um is still a well-typed Micrometer, still passes every
// structural check, and would place a server processor in less board area than a 144-pin CPLD. The
// ordering against a package whose dimensions came from a different authority entirely is what
// makes the scale claim independent of the row being tested.
test fn w_the_package_is_larger_than_the_cpld_by_orders_of_magnitude() -> Bool {
  match product.altra_motherboard.placement.processor_package_envelope {
    product.altra_motherboard.placement.EnvelopeNotEstablished { gap: _ } => false
    product.altra_motherboard.placement.EnvelopeEstablished { envelope: pkg, source: _ } =>
      match product.altra_motherboard.placement.board_control_envelope {
        product.altra_motherboard.placement.EnvelopeNotEstablished { gap: _ } => false
        product.altra_motherboard.placement.EnvelopeEstablished { envelope: cpld, source: _ } =>
          std.measure.micrometer_count(m: pkg.body_width) > (std.measure.micrometer_count(m: cpld.body_width) * 3)
            && std.measure.micrometer_count(m: pkg.body_height) > (std.measure.micrometer_count(m: cpld.body_height) * 3)
      }
  }
}

fn memory_role_count(d: product.altra_motherboard.minimal_design.AltraMinimalMotherboard) -> Int {
  fold(product.altra_motherboard.placement.required_roles(d: d), init: 0, f: fn(acc, r) {
    if (product.altra_motherboard.placement.role_tag(r: r) as String) == "MemoryModuleSlot" { acc + 1 } else { acc }
  })
}

fn requires_slot(d: product.altra_motherboard.minimal_design.AltraMinimalMotherboard, c: product.altra_motherboard.minimal_design.DdrChannelIdentity, p: product.altra_motherboard.minimal_design.DimmSlotPosition) -> Bool {
  fold(product.altra_motherboard.placement.required_roles(d: d), init: false, f: fn(acc, r) {
    acc || product.altra_motherboard.placement.roles_equal(a: r, b: product.altra_motherboard.placement.MemoryModuleSlot { slot: product.altra_motherboard.minimal_design.DdrSlotIdentity { channel: c, position: p } })
  })
}

fn design_over(t: product.altra_motherboard.minimal_design.ActiveDdrTopology) -> product.altra_motherboard.minimal_design.AltraMinimalMotherboard {
  product.altra_motherboard.minimal_design.AltraMinimalMotherboard {
    intent: product.altra_motherboard.minimal_design.Production,
    memory: product.altra_motherboard.minimal_design.MemoryConfiguration { topology: t },
    pcie_lanes_broken_out: 4,
  }
}

// THE REQUIRED POPULATION FOLLOWS THE DESIGN RATHER THAN A LIST BESIDE IT, and it follows the
// NAMED population rather than its size. The second design below populates four controllers that
// are not the first four, with two DIMM positions on each -- a board the previous shape could not
// describe at all, because it expanded a count into [0..n) and every four-channel design came out
// as channels zero through three. The eight roles it requires are the cross product of two
// authored sets, so this witness fails if either axis stops being consulted.
test fn w_the_required_roles_are_the_named_slots_not_a_generated_range() -> Bool {
  let split = design_over(t: product.altra_motherboard.minimal_design.ActiveDdrTopology {
    populated_channels: [product.altra_motherboard.minimal_design.DdrChannel0, product.altra_motherboard.minimal_design.DdrChannel1, product.altra_motherboard.minimal_design.DdrChannel4, product.altra_motherboard.minimal_design.DdrChannel5],
    positions_per_channel: [product.altra_motherboard.minimal_design.FirstDimmOnChannel, product.altra_motherboard.minimal_design.SecondDimmOnChannel],
  })
  memory_role_count(d: product.altra_motherboard.minimal_design.altra_1p_minimum) == 4
    && memory_role_count(d: split) == 8
    && requires_slot(d: split, c: product.altra_motherboard.minimal_design.DdrChannel5, p: product.altra_motherboard.minimal_design.SecondDimmOnChannel)
    && !requires_slot(d: split, c: product.altra_motherboard.minimal_design.DdrChannel2, p: product.altra_motherboard.minimal_design.FirstDimmOnChannel)
}

// A ROLE IS COMPARED STRUCTURALLY, ON BOTH SLOT COORDINATES. Two memory slots on different
// channels are different roles, and so are the two positions on ONE channel: an equality blind to
// position would report a two-DIMM channel as filled by its first slot alone, and the second
// connector would vanish from the population join without any refusal naming it.
test fn w_memory_slots_are_distinguished_on_both_coordinates() -> Bool {
  let c0p0 = product.altra_motherboard.placement.MemoryModuleSlot { slot: product.altra_motherboard.minimal_design.DdrSlotIdentity { channel: product.altra_motherboard.minimal_design.DdrChannel0, position: product.altra_motherboard.minimal_design.FirstDimmOnChannel } }
  let c0p1 = product.altra_motherboard.placement.MemoryModuleSlot { slot: product.altra_motherboard.minimal_design.DdrSlotIdentity { channel: product.altra_motherboard.minimal_design.DdrChannel0, position: product.altra_motherboard.minimal_design.SecondDimmOnChannel } }
  let c1p0 = product.altra_motherboard.placement.MemoryModuleSlot { slot: product.altra_motherboard.minimal_design.DdrSlotIdentity { channel: product.altra_motherboard.minimal_design.DdrChannel1, position: product.altra_motherboard.minimal_design.FirstDimmOnChannel } }
  !product.altra_motherboard.placement.roles_equal(a: c0p0, b: c1p0)
    && !product.altra_motherboard.placement.roles_equal(a: c0p0, b: c0p1)
    && product.altra_motherboard.placement.roles_equal(a: c0p1, b: c0p1)
    && !product.altra_motherboard.placement.roles_equal(a: c0p0, b: product.altra_motherboard.placement.ProcessorSocket)
    && product.altra_motherboard.placement.roles_equal(a: product.altra_motherboard.placement.DebugConnector, b: product.altra_motherboard.placement.DebugConnector)
}

// THE DISCRIMINATING RED FOR THE POPULATION JOIN. A plan holding only the CPLD is missing sixteen
// roles, and the join reports them — so the completeness check is an identity join and not a
// count that happens to agree.
fn plan_with_only(cs: List<product.altra_motherboard.placement.PlannedComponent>, template: product.altra_motherboard.placement.BoardPlacementPlan) -> product.altra_motherboard.placement.BoardPlacementPlan {
  product.altra_motherboard.placement.BoardPlacementPlan { frame: template.frame, outline: template.outline, design: template.design, components: cs }
}

test fn w_a_plan_missing_roles_names_every_one_of_them() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(
        cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: plan_with_only(cs: [product.altra_motherboard.placement.PlannedComponent {
          identity: "board_control_cpld",
          role: product.altra_motherboard.placement.BoardControlCpld,
          envelope: product.altra_motherboard.placement.board_control_envelope,
          origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 240000, y: 200000),
        }], template: p)),
        wanted: "RoleUnfilled"
      ) == 16
  }
}

// AND A COMPONENT THE DESIGN DOES NOT REQUIRE IS ITS OWN REFUSAL, not silence. A ninth memory slot
// on a four-channel design is a part somebody added; reporting only missing roles would admit it.
test fn w_a_component_filling_no_required_role_refuses() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(
        cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: plan_with_only(cs: [product.altra_motherboard.placement.PlannedComponent {
          identity: "dimm_slot_spurious",
          role: product.altra_motherboard.placement.MemoryModuleSlot { slot: product.altra_motherboard.minimal_design.DdrSlotIdentity { channel: product.altra_motherboard.minimal_design.DdrChannel5, position: product.altra_motherboard.minimal_design.SecondDimmOnChannel } },
          envelope: product.altra_motherboard.placement.board_control_envelope,
          origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 10000, y: 10000),
        }], template: p)),
        wanted: "RoleUnjustified"
      ) == 1
  }
}

// EVERY PLANNED COMPONENT HAS ITS OWN IDENTITY, and this witness exists because the reference plan
// did not. All four memory-slot obligations shared the identity "dimm_slot". Nothing failed, because
// an obligation never reaches the geometry bridge and physical.dag therefore never saw the
// duplicate — the collision was authored and dormant, due to fire the moment DIMM envelopes were
// established. A defect that is invisible until a later increment is worse than one that fails now.
test fn w_every_planned_component_has_a_distinct_identity() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p), wanted: "IdentityRepeated") == 0
  }
}

// THE DISCRIMINATING RED. Two components sharing one identity refuse, and refuse ONCE rather than
// once per occurrence. Without this the check above is satisfied by a plan-level rule that never
// fires — which is exactly the state the reference plan was in.
test fn w_two_components_sharing_an_identity_refuse_once() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(
        cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: plan_with_only(cs: [
          product.altra_motherboard.placement.PlannedComponent {
            identity: "collides", role: product.altra_motherboard.placement.BoardControlCpld, envelope: product.altra_motherboard.placement.board_control_envelope,
            origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 10000, y: 10000),
          },
          product.altra_motherboard.placement.PlannedComponent {
            identity: "collides", role: ResetController, envelope: product.altra_motherboard.placement.board_control_envelope,
            origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 20000, y: 20000),
          },
        ], template: p)),
        wanted: "IdentityRepeated"
      ) == 1
  }
}

// THE BOARD AS IT STANDS TODAY REPORTS THE SUBSET ARM, and that is the whole point of the arm
// existing. Five of seventeen parts have an established envelope, so the body-envelope check ran over
// five rectangles and found nothing wrong -- and reporting that as a clean board would be a
// finished-looking answer about a board that is twelve parts short.
test fn w_a_partial_board_reports_the_subset_arm_carrying_what_it_did_not_check() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      match product.altra_motherboard.placement.board_body_layout_standing(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p) {
        product.altra_motherboard.placement.BodyLayoutCheckedOverEstablishedSubsetOnly { parts_still_owed: n, geometry: _ } =>
          n == 12 && n == product.altra_motherboard.placement.parts_not_geometrically_checked(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p)
        product.altra_motherboard.placement.BodyLayoutAdmittedOverEveryRequiredPart { article: _ } => false
        product.altra_motherboard.placement.BodyLayoutRefused { causes: _ } => false
      }
  }
}

// A COMPONENT WHOSE ENVELOPE IS OWED IS A PART THE GEOMETRY NEVER SAW, and a role nothing fills is
// another. A defect in a part that IS present is neither, and counting it as one would overstate
// the gap -- so the two classes are asserted apart rather than through one total.
test fn w_a_present_but_unjustified_part_is_not_counted_as_unchecked() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      product.altra_motherboard.placement.parts_not_geometrically_checked(
        d: product.altra_motherboard.minimal_design.altra_1p_minimum,
        d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(),
        plan: plan_with_only(cs: concat(p.components, [product.altra_motherboard.placement.PlannedComponent {
          identity: "spurious_extra",
          role: product.altra_motherboard.placement.MemoryModuleSlot { slot: product.altra_motherboard.minimal_design.DdrSlotIdentity { channel: product.altra_motherboard.minimal_design.DdrChannel2, position: product.altra_motherboard.minimal_design.SecondDimmOnChannel } },
          envelope: product.altra_motherboard.placement.board_control_envelope,
          origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 10000, y: 10000),
        }]), template: p)
      ) == 12
  }
}

// THE POSITIVE CONTROL, WITHOUT WHICH THE SUBSET ARM PROVES NOTHING. If the complete arm were
// unreachable, a witness asserting that today's board is partial would be satisfied by a function
// that always answers partial. Every required role is given an established envelope on a grid that
// fits inside the outline and does not overlap, and the complete arm is reached.
fn every_role_established(template: product.altra_motherboard.placement.BoardPlacementPlan) -> product.altra_motherboard.placement.BoardPlacementPlan {
  let built = fold(product.altra_motherboard.placement.required_roles(d: product.altra_motherboard.minimal_design.altra_1p_minimum), init: IndexedComponents { index: 0, out: [] }, f: fn(acc, r) {
    let col = acc.index - ((acc.index / 5) * 5)
    let row = acc.index / 5
    IndexedComponents {
      index: acc.index + 1,
      out: concat(acc.out, [product.altra_motherboard.placement.PlannedComponent {
        identity: "grid_part_{acc.index}",
        role: r,
        envelope: product.altra_motherboard.placement.board_control_envelope,
        origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 10000 + (col * 30000), y: 10000 + (row * 30000)),
      }]),
    }
  })
  plan_with_only(cs: built.out, template: template)
}

type IndexedComponents {
  index: Int
  out: List<product.altra_motherboard.placement.PlannedComponent>
}

test fn w_a_complete_board_reaches_the_admitted_arm() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      match product.altra_motherboard.placement.board_body_layout_standing(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: every_role_established(template: p)) {
        product.altra_motherboard.placement.BodyLayoutAdmittedOverEveryRequiredPart { article: _ } => true
        product.altra_motherboard.placement.BodyLayoutCheckedOverEstablishedSubsetOnly { parts_still_owed: _, geometry: _ } => false
        product.altra_motherboard.placement.BodyLayoutRefused { causes: _ } => false
      }
  }
}

// AND THE DISCRIMINATING RED: the same complete board with two parts stacked on one another is
// refused rather than admitted. Without this the arm above is satisfied by a check that looks at
// nothing, which is the shape a geometry verdict most easily degenerates into.
test fn w_a_complete_board_with_overlapping_bodies_is_refused() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      let complete = every_role_established(template: p)
      match product.altra_motherboard.placement.board_body_layout_standing(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: plan_with_only(
        cs: fold(complete.components, init: [], f: fn(acc, c) {
          concat(acc, [product.altra_motherboard.placement.PlannedComponent {
            identity: c.identity,
            role: c.role,
            envelope: c.envelope,
            origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 10000, y: 10000),
          }])
        }),
        template: p
      )) {
        product.altra_motherboard.placement.BodyLayoutRefused { causes: _ } => true
        product.altra_motherboard.placement.BodyLayoutAdmittedOverEveryRequiredPart { article: _ } => false
        product.altra_motherboard.placement.BodyLayoutCheckedOverEstablishedSubsetOnly { parts_still_owed: _, geometry: _ } => false
      }
  }
}

// TWO PROCESSOR SOCKETS ON A ONE-SOCKET BOARD IS A REFUSAL, and until this witness existed it was
// not. The population join asked only whether SOME component filled each role, so both sockets
// answered a requirement, neither was unjustified, nothing was missing, and the board passed. That
// is the completeness check reporting a wrong board as complete -- the failure mode it exists to
// prevent, reached through the one direction it was not walking.
test fn w_a_role_filled_twice_refuses_naming_how_many_fill_it() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      fold(
        product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: plan_with_only(
          cs: concat(p.components, [product.altra_motherboard.placement.PlannedComponent {
            identity: "second_cpu_socket",
            role: product.altra_motherboard.placement.ProcessorSocket,
            envelope: product.altra_motherboard.placement.board_control_envelope,
            origin: std.affine_space.point2(frame: product.altra_motherboard.placement.altra_board_frame(), x: 10000, y: 10000),
          }]),
          template: p
        )),
        init: false,
        f: fn(acc, c) {
          acc || match c {
            product.altra_motherboard.placement.RoleFilledMoreThanOnce { role: r, fills: n } => (product.altra_motherboard.placement.role_tag(r: r) as String) == "ProcessorSocket" && n == 2
            product.altra_motherboard.placement.RequiredRoleUnfilled { role: _ } => false
            product.altra_motherboard.placement.ComponentEnvelopeNotEstablished { component: _, gap: _ } => false
            product.altra_motherboard.placement.ComponentFillsNoRequiredRole { component: _, role_named: _ } => false
            product.altra_motherboard.placement.PlannedIdentityRepeated { component: _ } => false
            product.altra_motherboard.placement.PlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            RequiredFunctionWithoutJustifiedPartOnBoard { requirement: _ } => false
          }
        }
      )
  }
}

// AND THE POSITIVE CONTROL, so the arm above is not satisfied by a check that refuses every board.
// The reference plan fills each of its seventeen roles exactly once and raises no multiplicity cause.
test fn w_the_reference_plan_fills_every_role_exactly_once() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p), wanted: "RoleFilledTwice") == 0
  }
}

// A PLAN BUILT FROM ANOTHER DESIGN IS NOT COMPARABLE, and saying so is different from reporting the
// symptoms. Retargeting the reference plan at a design declaration it did not come from produces a
// named mismatch carrying both references. The alternative -- letting the population join speak --
// would report a list of unjustified parts, which is exactly what a board with spare connectors
// reports, and the reader would go and delete real components.
test fn w_a_plan_from_another_design_is_refused_as_incomparable() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      count_tagged(
        cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: product.altra_motherboard.placement.BoardPlacementPlan {
          frame: p.frame,
          outline: p.outline,
          design: std.decl_ref.decl_ref(module_path: "product.altra_motherboard.minimal_design", decl_name: "some_other_board"),
          components: p.components,
        }),
        wanted: "DesignMismatch"
      ) == 1
  }
}

// AND THE POSITIVE CONTROL: the reference plan names the design it was built from, so the join is
// not satisfied by a check that refuses every plan.
test fn w_the_reference_plan_names_the_design_it_came_from() -> Bool {
  match plan_or_empty() {
    Absent => false
    Present { value: p } =>
      std.decl_ref.declaration_ref_eq(a: p.design, b: product.altra_motherboard.placement.altra_1p_minimum_ref())
        && count_tagged(cs: product.altra_motherboard.placement.placement_causes(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: p), wanted: "DesignMismatch") == 0
  }
}

fn envelope_source(e: product.altra_motherboard.placement.ComponentEnvelopeStanding) -> std.decl_ref.DeclarationRef? {
  match e {
    product.altra_motherboard.placement.EnvelopeEstablished { envelope: _, source: sc } => Present { value: sc }
    product.altra_motherboard.placement.EnvelopeNotEstablished { gap: _ } => none
  }
}

// EVERY ESTABLISHED ENVELOPE NAMES A DECLARATION, AND THE TWO NAME DIFFERENT ONES. The second half
// is the part worth testing. While the source was prose, one authority pasted onto both envelopes
// was invisible -- two plausible sentences, no way to compare them -- and it would have meant this
// board claiming the processor package's extent came from the CPLD's datasheet or the reverse.
// Comparing declarations makes that a decidable question, and this asserts the answer.
test fn w_the_established_envelopes_cite_distinct_declarations() -> Bool {
  match envelope_source(e: product.altra_motherboard.placement.processor_package_envelope) {
    Absent => false
    Present { value: pkg } =>
      match envelope_source(e: product.altra_motherboard.placement.board_control_envelope) {
        Absent => false
        Present { value: cpld } => !std.decl_ref.declaration_ref_eq(a: pkg, b: cpld)
      }
  }
}

// THE CONTROL, on a pair this witness authors: two envelopes citing one declaration ARE detected as
// the same, so the claim above is capable of failing rather than asserting that two things somebody
// wrote differently are different.
test fn w_two_envelopes_citing_one_declaration_are_seen_as_the_same() -> Bool {
  let one = std.decl_ref.decl_ref(module_path: "planted.module", decl_name: "planted_row")
  let same = std.decl_ref.decl_ref(module_path: "planted.module", decl_name: "planted_row")
  let other = std.decl_ref.decl_ref(module_path: "planted.module", decl_name: "a_different_row")
  std.decl_ref.declaration_ref_eq(a: one, b: same) && !std.decl_ref.declaration_ref_eq(a: one, b: other)
}

// THE BOARD FRAME REGISTERS, AND THE STANDING SAYS SO RATHER THAN AN EMPTY REGISTRY SAYING
// NOTHING. This is a positive control, and it is the only half of this class that is provable
// here: register_frame refuses on a non-decimal length scale or a frame already present, and
// altra_frame_registry supplies Micro against an empty registry, so neither refusal is reachable
// from this call site and no discriminating red can be built for it without planting a defect in
// the function's own body. What the change bought is therefore not a new wall -- it is that if
// either refusal ever does become reachable, the cause travels to BodyLayoutRefused as
// BoardFrameRegistrationRefused instead of being replaced downstream by BoardFrameUnregistered,
// which names a different state.
test fn w_the_board_frame_registry_is_established_not_silently_empty() -> Bool {
  match product.altra_motherboard.placement.altra_frame_registry() {
    product.altra_motherboard.placement.FrameRegistryEstablished { registry: _ } => true
    product.altra_motherboard.placement.FrameRegistryRefused { cause: _ } => false
  }
}


// ================= INTENT GATES THE ROLE SET, NOT ONLY THE CHANNEL COUNT =================

// THE THREE PRODUCTION FEATURES DROP OUT OF A BRING-UP BOARD, and nothing else does. This is the
// claim the change exists to make: a fixture is not obliged to carry a host PHY, an out-of-band
// management path or an NVMe endpoint, none of which is on any path required to bring the
// processor out of reset. The count is asserted BOTH ways rather than only for bring-up, because
// a gate that dropped roles under every intent would satisfy a one-sided check while quietly
// removing them from the production board too.
test fn w_bring_up_drops_exactly_the_three_production_features() -> Bool {
  let prod = product.altra_motherboard.minimal_design.altra_1p_minimum
  let fixture = product.altra_motherboard.minimal_design.AltraMinimalMotherboard {
    intent: product.altra_motherboard.minimal_design.EngineeringBringUp,
    memory: prod.memory,
    pcie_lanes_broken_out: prod.pcie_lanes_broken_out,
  }
  let prod_roles = std.types.list_length(items: product.altra_motherboard.placement.required_roles(d: prod))
  let fixture_roles = std.types.list_length(items: product.altra_motherboard.placement.required_roles(d: fixture))
  prod_roles - fixture_roles == 3
    && product.altra_motherboard.placement.role_is_required_under(r: product.altra_motherboard.placement.HostNetworkPhy, intent: product.altra_motherboard.minimal_design.Production)
    && !product.altra_motherboard.placement.role_is_required_under(r: product.altra_motherboard.placement.HostNetworkPhy, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
    && product.altra_motherboard.placement.role_is_required_under(r: product.altra_motherboard.placement.ManagementNetworkPath, intent: product.altra_motherboard.minimal_design.Production)
    && !product.altra_motherboard.placement.role_is_required_under(r: product.altra_motherboard.placement.ManagementNetworkPath, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
    && product.altra_motherboard.placement.role_is_required_under(r: product.altra_motherboard.placement.StorageEndpoint, intent: product.altra_motherboard.minimal_design.Production)
    && !product.altra_motherboard.placement.role_is_required_under(r: product.altra_motherboard.placement.StorageEndpoint, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
}

// THE BOOT PATH IS NOT NEGOTIABLE BY INTENT. Power sequencing, supervision, reset, firmware and
// the socket itself are required under BOTH intents, and this asserts it over the whole role
// coproduct rather than over a list someone remembered to write: every role that is not one of the
// three features above must survive the bring-up gate. A future edit that makes the power-good
// supervisor bring-up-only -- the kind of "minimisation" that produces a board which cannot tell a
// rail that came up from one that did not -- fails here without anyone having to name that role.
test fn w_every_role_but_the_three_features_survives_the_bring_up_gate() -> Bool {
  fold(product.altra_motherboard.placement.every_non_slot_role(), init: true, f: fn(acc, r) {
    let is_feature = product.altra_motherboard.placement.roles_equal(a: r, b: product.altra_motherboard.placement.HostNetworkPhy)
      || product.altra_motherboard.placement.roles_equal(a: r, b: product.altra_motherboard.placement.ManagementNetworkPath)
      || product.altra_motherboard.placement.roles_equal(a: r, b: product.altra_motherboard.placement.StorageEndpoint)
    if is_feature {
      acc && !product.altra_motherboard.placement.role_is_required_under(r: r, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
    } else {
      acc && product.altra_motherboard.placement.role_is_required_under(r: r, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
        && product.altra_motherboard.placement.role_is_required_under(r: r, intent: product.altra_motherboard.minimal_design.Production)
    }
  })
}

// REACHABILITY CONTROL FOR THE ARM NO ROLE CURRENTLY OCCUPIES. RequiredOnlyUnderBringUp is carried
// by the type and by requirement_applies_under, and after the DebugConnector row was corrected to
// RequiredUnderEveryIntent no role uses it. That makes it a QUIET arm, not a dead one, and the
// distinction is decidable rather than a matter of opinion: the state is authorable here, so the
// arm can be driven and its behaviour observed. An arm whose red could not be produced anywhere a
// check can run would be a decoration -- permanently green by construction and worse than absent,
// because it would be cited as coverage.
test fn w_red_the_bring_up_only_arm_is_reachable_and_discriminates() -> Bool {
  let planted = product.altra_motherboard.placement.RequiredOnlyUnderBringUp {
    basis: product.altra_motherboard.placement.RepositoryDesignPolicy { because: "planted: no production role currently claims this arm" },
  }
  let every = product.altra_motherboard.placement.RequiredUnderEveryIntent {
    basis: product.altra_motherboard.placement.RepositoryDesignPolicy { because: "planted control" },
  }
  let prod_only = product.altra_motherboard.placement.RequiredOnlyUnderProduction {
    basis: product.altra_motherboard.placement.RepositoryDesignPolicy { because: "planted control" },
  }
  product.altra_motherboard.placement.requirement_applies_under(req: planted, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
    && !product.altra_motherboard.placement.requirement_applies_under(req: planted, intent: product.altra_motherboard.minimal_design.Production)
    && product.altra_motherboard.placement.requirement_applies_under(req: every, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
    && product.altra_motherboard.placement.requirement_applies_under(req: every, intent: product.altra_motherboard.minimal_design.Production)
    && !product.altra_motherboard.placement.requirement_applies_under(req: prod_only, intent: product.altra_motherboard.minimal_design.EngineeringBringUp)
    && product.altra_motherboard.placement.requirement_applies_under(req: prod_only, intent: product.altra_motherboard.minimal_design.Production)
}

// MEMORY SLOTS FOLLOW THE TOPOLOGY, NOT THE GATE. The slot roles are already selected against
// intent one layer up, where minimal_design refuses a debug-only channel count under production
// intent. This asserts the two mechanisms compose rather than double-count: changing intent alone,
// with the topology held fixed, must not add or remove a single memory slot.
test fn w_the_role_gate_does_not_touch_the_memory_slots() -> Bool {
  let prod = product.altra_motherboard.minimal_design.altra_1p_minimum
  let fixture = product.altra_motherboard.minimal_design.AltraMinimalMotherboard {
    intent: product.altra_motherboard.minimal_design.EngineeringBringUp,
    memory: prod.memory,
    pcie_lanes_broken_out: prod.pcie_lanes_broken_out,
  }
  memory_role_count(d: prod) == memory_role_count(d: fixture)
    && memory_role_count(d: prod) == 4
}
