module test.claim.harness_shell_job_policy

import std.types { Bool, Int, String }
import std.measure { second }
import gunbc.harness.harness_shell_job_policy {
  ShellJobSchedule, HarnessWaitPace, WaitPaceReset, WaitPaceAfterWait,
  WaitUseDefault, WaitRequestedMinutes, WaitMalformedMinutes, WaitAdmitted, WaitRefusedNotADuration,
  harness_shell_job_schedule, harness_admit_wait, schedule_seconds,
  harness_pace_after_window_change, harness_pace_after_expired_wait,
}

data live_tree_disposition: std.live_tree.LiveTreeDisposition = std.live_tree.SubstrateInputsOnly

fn fx() -> ShellJobSchedule {
  harness_shell_job_schedule
}

test fn the_production_schedule_is_the_ctrl_window() -> Bool {
  schedule_seconds(s: fx().inline_hold) == 90
    && schedule_seconds(s: fx().wait_base) == 300
    && fx().wait_factor == 2
    && fx().wait_request_cap_factor == 4
    && schedule_seconds(s: fx().wait_minimum) == 60
    && schedule_seconds(s: fx().backstop) == 21600
}

test fn a_reset_pace_defaults_to_the_base() -> Bool {
  match harness_admit_wait(schedule: fx(), pace: WaitPaceReset, request: WaitUseDefault) {
    WaitAdmitted { seconds, clamped, raised_to_minimum, capped_at_backstop, asked_seconds: _ } =>
      schedule_seconds(s: seconds) == 300 && !clamped && !raised_to_minimum && !capped_at_backstop
    WaitRefusedNotADuration { minutes: _, cause: _ } => false
  }
}

test fn the_backoff_doubles_after_an_expired_wait() -> Bool {
  match harness_admit_wait(
    schedule: fx(),
    pace: harness_pace_after_expired_wait(seconds: second(count: 300)),
    request: WaitUseDefault,
  ) {
    WaitAdmitted { seconds, clamped, raised_to_minimum, capped_at_backstop, asked_seconds: _ } =>
      schedule_seconds(s: seconds) == 600 && !clamped && !raised_to_minimum && !capped_at_backstop
    WaitRefusedNotADuration { minutes: _, cause: _ } => false
  }
}

test fn a_request_above_4x_is_clamped_and_said() -> Bool {
  match harness_admit_wait(
    schedule: fx(),
    pace: WaitPaceAfterWait { seconds: second(count: 300) },
    request: WaitRequestedMinutes { minutes: 30 },
  ) {
    WaitAdmitted { seconds, clamped, raised_to_minimum, capped_at_backstop, asked_seconds } =>
      schedule_seconds(s: seconds) == 1200 && clamped && !raised_to_minimum && !capped_at_backstop
        && schedule_seconds(s: asked_seconds) == 1800
    WaitRefusedNotADuration { minutes: _, cause: _ } => false
  }
}

test fn a_wait_shorter_than_the_minimum_is_raised_never_a_poll() -> Bool {
  let high_floor = ShellJobSchedule {
    inline_hold: fx().inline_hold,
    wait_base: fx().wait_base,
    wait_factor: fx().wait_factor,
    wait_request_cap_factor: fx().wait_request_cap_factor,
    wait_minimum: second(count: 120),
    backstop: fx().backstop,
  }
  match harness_admit_wait(
    schedule: high_floor,
    pace: WaitPaceReset,
    request: WaitRequestedMinutes { minutes: 1 },
  ) {
    WaitAdmitted { seconds, clamped, raised_to_minimum, capped_at_backstop, asked_seconds } =>
      schedule_seconds(s: seconds) == 120 && !clamped && raised_to_minimum && !capped_at_backstop
        && schedule_seconds(s: asked_seconds) == 60
    WaitRefusedNotADuration { minutes: _, cause: _ } => false
  }
    && (match harness_admit_wait(
      schedule: fx(),
      pace: WaitPaceReset,
      request: WaitRequestedMinutes { minutes: 0 },
    ) {
      WaitRefusedNotADuration { minutes, cause } => minutes == 0 && cause.contains("0")
      WaitAdmitted { seconds: _, clamped: _, raised_to_minimum: _, capped_at_backstop: _, asked_seconds: _ } => false
    })
}

test fn a_window_change_resets_the_pace_to_the_base() -> Bool {
  match harness_pace_after_window_change() {
    WaitPaceReset =>
      match harness_admit_wait(
        schedule: fx(),
        pace: harness_pace_after_window_change(),
        request: WaitUseDefault,
      ) {
        WaitAdmitted { seconds, clamped: _, raised_to_minimum: _, capped_at_backstop: _, asked_seconds: _ } =>
          schedule_seconds(s: seconds) == 300
        WaitRefusedNotADuration { minutes: _, cause: _ } => false
      }
    WaitPaceAfterWait { seconds: _ } => false
  }
}

test fn wait_use_default_is_capped_at_the_backstop_and_said() -> Bool {
  match harness_admit_wait(
    schedule: fx(),
    pace: harness_pace_after_expired_wait(seconds: second(count: 21600)),
    request: WaitUseDefault,
  ) {
    WaitAdmitted { seconds, clamped: _, raised_to_minimum: _, capped_at_backstop, asked_seconds } =>
      schedule_seconds(s: seconds) == 21600
        && capped_at_backstop
        && schedule_seconds(s: asked_seconds) == 43200
    WaitRefusedNotADuration { minutes: _, cause: _ } => false
  }
}

test fn a_malformed_minutes_request_carries_the_parse_cause() -> Bool {
  match harness_admit_wait(
    schedule: fx(),
    pace: WaitPaceReset,
    request: WaitMalformedMinutes { cause: "minutes is a string where a number was expected" },
  ) {
    WaitRefusedNotADuration { minutes: _, cause } => cause.contains("string where a number")
    WaitAdmitted { seconds: _, clamped: _, raised_to_minimum: _, capped_at_backstop: _, asked_seconds: _ } => false
  }
}
