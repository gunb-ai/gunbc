test fn rest_200_uninhabiting_root_refuses_instead_of_null_under_rest_ok() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "RootArray",
      observation: RestResponseObserved {
        status: 200
        body: RestBodyRead { body: "{\"pulls\":null}" }
      }
    )]),
    subject: fn(_scope) { test.RestReplay.RootArray() }
  )
  match result {
    WitnessReturned { value } => match value.observed {
      RestBodyUndecodable { status, cause } =>
        status == 200 && string_contains(s: cause, pattern: "did not inhabit")
      RestOk => false
      _ => false
    }
    WitnessRefused { diagnostic } => false
  }
}

