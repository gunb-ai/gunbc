test fn rest_replay_binding_does_not_escape_its_frame() -> Bool {
  let inside = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: []),
    subject: fn(_scope) { witness_evaluation_frame_active() }
  )
  match inside {
    WitnessReturned { value } => value && !witness_evaluation_frame_active()
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// TYPE-DIRECTED RESPONSE DECODE. A nullary coproduct field is decoded through its declared wire
// contract (extdeps.github.workflow_runs_contracts), so the recorded spelling becomes the arm.
data decoded_run_list_body: String = "{\"total_count\":1,\"workflow_runs\":[{\"id\":34853888826,\"name\":\"witnesses\",\"path\":\".github/workflows/witnesses.yml\",\"head_sha\":\"a8d4fdeb1c2c971fcf9b17614d80e75c63f07d50\",\"head_branch\":\"gh-readonly-queue/main/pr-11256-74627165a69024b49b4069f25ac285c9abdade5d\",\"event\":\"merge_group\",\"status\":\"completed\",\"conclusion\":\"success\",\"workflow_id\":335117115,\"run_number\":19305,\"run_attempt\":1,\"actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"triggering_actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"html_url\":\"https://github.com/gunb-ai/gunbc/actions/runs/34853888826\",\"created_at\":\"2026-09-14T14:10:32Z\",\"updated_at\":\"2026-09-14T15:00:21Z\",\"pull_requests\":[]}]}"

// One character of the recorded body changed: "success" -> "succeeded", a spelling that names no
// WorkflowRunConclusion arm under SnakeCase. It refuses at the located field rather than carrying
// the string into a match that would take its wildcard arm.
data misspelled_conclusion_body: String = "{\"total_count\":1,\"workflow_runs\":[{\"id\":34853888826,\"name\":\"witnesses\",\"path\":\".github/workflows/witnesses.yml\",\"head_sha\":\"a8d4fdeb1c2c971fcf9b17614d80e75c63f07d50\",\"head_branch\":\"gh-readonly-queue/main/pr-11256-74627165a69024b49b4069f25ac285c9abdade5d\",\"event\":\"merge_group\",\"status\":\"completed\",\"conclusion\":\"succeeded\",\"workflow_id\":335117115,\"run_number\":19305,\"run_attempt\":1,\"actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"triggering_actor\":{\"login\":\"briansrls\",\"id\":11205878,\"type\":\"User\"},\"html_url\":\"https://github.com/gunb-ai/gunbc/actions/runs/34853888826\",\"created_at\":\"2026-09-14T14:10:32Z\",\"updated_at\":\"2026-09-14T15:00:21Z\",\"pull_requests\":[]}]}"

fn first_run_completed_successfully(runs: WorkflowRunList) -> Bool {
  match runs.workflow_runs |> first {
    Present { value: run } => match run.status {
      Completed => match run.conclusion {
        Present { value: Success } => true
        _ => false
      }
      _ => false
    }
    none => false
  }
}

fn run_list_frame(body: String) -> WitnessEvaluationFrame<Unit> {
  replay_frame(fixtures: [
    fixture_for(operation: "WorkflowRunsPage", observation: RestResponseObserved { status: 200, body: RestBodyRead { body: body } }),
  ])
}

test fn a_contracted_coproduct_field_decodes_to_its_arm() -> Bool {
  match evaluate_in_witness_frame(frame: run_list_frame(body: decoded_run_list_body), subject: fn(_scope) {
    match test.RestReplay.WorkflowRunsPage() {
      RestAnswered { answer } => first_run_completed_successfully(runs: answer.runs)
      RestRefused { refusal: _ } => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn an_unknown_spelling_refuses_at_the_located_field() -> Bool {
  match evaluate_in_witness_frame(frame: run_list_frame(body: misspelled_conclusion_body), subject: fn(_scope) {
    match test.RestReplay.WorkflowRunsPage() {
      RestRefused { refusal: RestBodyUndecodable { status, cause } } =>
        status == 200
          && string_contains(s: cause, pattern: "workflow_runs[0].conclusion")
          && string_contains(s: cause, pattern: "\"succeeded\" names no arm")
      _ => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// NO LENIENT ARM FOR AN UNDECLARED SPELLING. The string "Alpha" is exactly an arm's authored name,
// so a decoder that guessed AsAuthored would accept it; the coproduct has no contract and its module
// declares no wire_contract, so it refuses.
test fn a_coproduct_with_no_declared_wire_spelling_refuses_even_an_authored_match() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "RootUncontracted",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: "{\"arm\":\"Alpha\"}" } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.RootUncontracted() {
        RestRefused { refusal: RestBodyUndecodable { status, cause } } =>
          status == 200 && string_contains(s: cause, pattern: "shape.arm (UncontractedArm)") && string_contains(s: cause, pattern: "wire spelling is undeclared")
        _ => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// THE TYPED RESPONSE FORMAT IS HONOURED (gunbc.recurring_failure_mode
// response_format_variant_silently_read_as_json). RED before the fix: the interpreter read
// response_format only as a string literal, so `response_format: Text` fell back to Json and this
// plain-text body answered RestBodyUndecodable at status 200.
test fn a_text_response_format_reads_a_plain_body_as_text() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "TextBody",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: "diff --git a/x b/x\n+plain text, not JSON" } }
    )]),
    subject: fn(_scope) {
      match test.RestReplay.TextBody() {
        RestAnswered { answer } => answer.text == "diff --git a/x b/x\n+plain text, not JSON"
        RestRefused { refusal: _ } => false
      }
    }
  )
  match result {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

// ANY OTHER SPELLING REFUSES. The quoted string is the one that used to be the only working
// spelling in the interpreter and was read as Json by emitted code; now neither realization
// can take it, and the interpreter says so instead of guessing.
test fn an_unrecognized_response_format_refuses_rather_than_defaulting_to_json() -> Bool {
  let result = evaluate_in_witness_frame(
    frame: replay_frame(fixtures: [fixture_for(
      operation: "FormatUnrecognized",
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: "plain" } }
    )]),
    subject: fn(_scope) { test.RestReplay.FormatUnrecognized() }
  )
  match result {
    WitnessReturned { value } => false
    WitnessRefused { diagnostic } => contains(witness_diagnostic_rendered_reason(diagnostic: diagnostic), "response_format must be a std.serialization WireFormat variant")
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}
