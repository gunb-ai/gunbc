module test.claim.roadmap_site_healthz_json_parse_witness

import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.roadmap_site_healthz_validate {
  roadmap_site_healthz_body_parses,
  roadmap_site_healthz_json_string_parses,
  roadmap_site_healthz_json_string_parses_via_node,
}
import gunbc.roadmap_static_site { roadmap_site_healthz_body }

func roadmap_site_healthz_json_parse_witness() -> ProcessExit {
  let body = roadmap_site_healthz_body()
  let ok = roadmap_site_healthz_json_string_parses(body: body)
    && roadmap_site_healthz_json_string_parses_via_node(body: body)
    && roadmap_site_healthz_json_string_parses(body: concat(body, "\n"))
  let bad = !roadmap_site_healthz_json_string_parses(body: concat(body, "}"))
  return if ok && bad {
    ExitSuccess
  } else {
    exit_failure(reason: "roadmap_site_healthz_body JSON.parse witness failed")
  }
}
