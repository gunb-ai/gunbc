module test.claim.roadmap_site_healthz_json_parse_witness


func roadmap_site_healthz_json_parse_witness() -> std.process.ProcessExit {
  let body = gunbc.roadmap_static_site.roadmap_site_healthz_body()
  let ok = gunbc.roadmap_site_healthz_validate.roadmap_site_healthz_json_string_parses(body: body)
    && gunbc.roadmap_site_healthz_validate.roadmap_site_healthz_json_string_parses(body: concat(body, "\n"))
  let bad = !gunbc.roadmap_site_healthz_validate.roadmap_site_healthz_json_string_parses(body: concat(body, "}"))
  return if ok && bad {
    ExitSuccess
  } else {
    std.process.exit_failure(reason: "roadmap_site_healthz_body JSON.parse witness failed")
  }
}
