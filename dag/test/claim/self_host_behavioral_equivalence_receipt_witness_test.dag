module test.claim.self_host_behavioral_equivalence_receipt_witness

import std.types { Bool, Int, String, NonEmptyStr, CommitSha }
import v2.std.algebra { any }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import tools.self_host_module_behavioral_transport_roster { ModuleBehavioralTransportConfig, BehavioralReceiptSetupRefused }
import tools.self_host_behavioral_equivalence_take { no_verdict_cause }
import tools.host_prelude { WitnessBinReady, WitnessBinRefused, WitnessBinArtifactAbsent, WitnessBinBuildFailed }
import tools.self_host_curated_seed_linked_harness {
  CsslWitnessDriver,
  CsslReceiptOutcome,
  CsslBehaviorHeld,
  CsslBehaviorDiverged,
  CsslSetupRefused,
  cssl_classify_receipt,
  cssl_readiness_refusal,
}
import gunbc.self_host_behavioral_equivalence_receipt {
  BehavioralRowVerdict,
  BehavioralRowHeld,
  BehavioralRowRefuted,
  BehavioralRowNoVerdict,
  BehavioralEquivalenceRow,
  BehavioralEquivalenceReceipt,
  BehavioralEquivalenceStanding,
  BehavioralEquivalenceSeriesEmpty,
  BehavioralEquivalenceSeriesInvalid,
  BehavioralEquivalenceLatest,
  behavioral_equivalence_standing,
  current_behavioral_equivalence_standing,
}
import gunbc.compiler_frontend_program_interlock { SelfHostEmittedContractsHeld }
import gunbc.compiler_frontend_program_status {
  ClassClear,
  ClassOutstanding,
  ClassNotDerivable,
  milestone_status,
  standing_class,
  standing_class_label,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The fold is judged over SUPPLIED receipts and a supplied two-module roster (DESIGN section 3: a
// witness discriminates at one interface), so no claim here runs the wet emit-and-drive a real
// receipt records. The last claim is the inhabitance claim for the real route: the live milestone
// reads the persisted series through the same standing, and is no longer NotDerivable.

data fixture_roster: List<ModuleBehavioralTransportConfig> = [
  ModuleBehavioralTransportConfig { module_path: "a.dag", driver: CsslWitnessDriver { contract_entry_rel: "a_contract.dag", contract_module: "a.contract", contract_function: "a_contract_holds" }, pass_marker: "A: PASS", claim_runs: [] },
  ModuleBehavioralTransportConfig { module_path: "b.dag", driver: CsslWitnessDriver { contract_entry_rel: "b_contract.dag", contract_module: "b.contract", contract_function: "b_contract_holds" }, pass_marker: "B: PASS", claim_runs: [] },
]

fn row(module_path: String, verdict: BehavioralRowVerdict) -> BehavioralEquivalenceRow {
  BehavioralEquivalenceRow { module_path: module_path, verdict: verdict }
}

fn receipt(sequence: Int, rows: List<BehavioralEquivalenceRow>) -> BehavioralEquivalenceReceipt {
  BehavioralEquivalenceReceipt {
    sequence: sequence,
    main_sha: "0123456789abcdef0123456789abcdef01234567" as CommitSha,
    instrument: "//gunbc/instruments:self-host-behavioral-equivalence" as NonEmptyStr,
    observed_at: "2026-09-27T00:00:00Z" as NonEmptyStr,
    rows: rows
  }
}

fn all_held(sequence: Int) -> BehavioralEquivalenceReceipt {
  receipt(sequence: sequence, rows: [row(module_path: "a.dag", verdict: BehavioralRowHeld), row(module_path: "b.dag", verdict: BehavioralRowHeld)])
}

fn b_refuted(sequence: Int) -> BehavioralEquivalenceReceipt {
  receipt(sequence: sequence, rows: [row(module_path: "a.dag", verdict: BehavioralRowHeld), row(module_path: "b.dag", verdict: BehavioralRowRefuted { observed: "fixture divergence" })])
}

fn outstanding_of(s: BehavioralEquivalenceStanding) -> List<String> {
  match s {
    BehavioralEquivalenceLatest { latest: _, outstanding } => outstanding
    BehavioralEquivalenceSeriesEmpty => ["<empty>"]
    BehavioralEquivalenceSeriesInvalid { reason: _ } => ["<invalid>"]
  }
}

fn is_latest(s: BehavioralEquivalenceStanding) -> Bool {
  match s {
    BehavioralEquivalenceLatest { latest: _, outstanding: _ } => true
    BehavioralEquivalenceSeriesEmpty => false
    BehavioralEquivalenceSeriesInvalid { reason: _ } => false
  }
}

fn standing(series: List<BehavioralEquivalenceReceipt>) -> BehavioralEquivalenceStanding {
  behavioral_equivalence_standing(series: series, roster: fixture_roster)
}

fn mentions(xs: List<String>, needle: String) -> Bool {
  xs |> any(x => string_contains(s: x, pattern: needle))
}

test fn an_empty_series_is_its_own_standing() -> Bool {
  match standing(series: []) {
    BehavioralEquivalenceSeriesEmpty => true
    BehavioralEquivalenceLatest { latest: _, outstanding: _ } => false
    BehavioralEquivalenceSeriesInvalid { reason: _ } => false
  }
}

// Positive control: exactly the roster, every row held, reads Clear (no outstanding).
test fn a_complete_all_held_receipt_has_nothing_outstanding() -> Bool {
  let s = standing(series: [all_held(sequence: 1)])
  is_latest(s: s) && count(outstanding_of(s: s)) == 0
}

// The discriminating red: one refuted row is outstanding, and names its module.
test fn a_refuted_row_is_outstanding_and_named() -> Bool {
  let o = outstanding_of(s: standing(series: [b_refuted(sequence: 1)]))
  count(o) == 1 && mentions(xs: o, needle: "b.dag") && !mentions(xs: o, needle: "a.dag")
}

test fn a_row_with_no_verdict_is_outstanding_not_held() -> Bool {
  let r = receipt(sequence: 1, rows: [row(module_path: "a.dag", verdict: BehavioralRowHeld), row(module_path: "b.dag", verdict: BehavioralRowNoVerdict { cause: "never ran" })])
  let o = outstanding_of(s: standing(series: [r]))
  count(o) == 1 && mentions(xs: o, needle: "never ran")
}

// Completeness is an identity join: a missing roster module, and a row naming no roster module,
// are each outstanding even when every present row held.
test fn a_missing_and_an_unrostered_row_are_each_outstanding() -> Bool {
  let r = receipt(sequence: 1, rows: [row(module_path: "a.dag", verdict: BehavioralRowHeld), row(module_path: "z.dag", verdict: BehavioralRowHeld)])
  let o = outstanding_of(s: standing(series: [r]))
  count(o) == 2 && mentions(xs: o, needle: "b.dag") && mentions(xs: o, needle: "z.dag")
}

test fn a_duplicated_row_is_outstanding() -> Bool {
  let r = receipt(sequence: 1, rows: [row(module_path: "a.dag", verdict: BehavioralRowHeld), row(module_path: "a.dag", verdict: BehavioralRowHeld), row(module_path: "b.dag", verdict: BehavioralRowHeld)])
  count(outstanding_of(s: standing(series: [r]))) == 1
}

// Only the latest receipt speaks: a repair clears, and a later failure is not masked by an earlier pass.
test fn the_latest_receipt_decides_in_both_directions() -> Bool {
  count(outstanding_of(s: standing(series: [b_refuted(sequence: 1), all_held(sequence: 2)]))) == 0
    && count(outstanding_of(s: standing(series: [all_held(sequence: 1), b_refuted(sequence: 2)]))) == 1
}

test fn a_non_increasing_sequence_refuses_the_series() -> Bool {
  match standing(series: [all_held(sequence: 2), b_refuted(sequence: 2)]) {
    BehavioralEquivalenceSeriesInvalid { reason: _ } => true
    BehavioralEquivalenceSeriesEmpty => false
    BehavioralEquivalenceLatest { latest: _, outstanding: _ } => false
  }
}

fn foreign_instrument(sequence: Int) -> BehavioralEquivalenceReceipt {
  BehavioralEquivalenceReceipt {
    sequence: sequence,
    main_sha: all_held(sequence: sequence).main_sha,
    instrument: "//gunbc/instruments:self-host" as NonEmptyStr,
    observed_at: all_held(sequence: sequence).observed_at,
    rows: all_held(sequence: sequence).rows
  }
}

// The red is a receipt whose rows all hold: without the instrument check it would read Clear.
test fn a_receipt_from_another_instrument_refuses_the_series() -> Bool {
  let forged = match standing(series: [foreign_instrument(sequence: 1)]) {
    BehavioralEquivalenceSeriesInvalid { reason: _ } => true
    BehavioralEquivalenceSeriesEmpty => false
    BehavioralEquivalenceLatest { latest: _, outstanding: _ } => false
  }
  let genuine = match standing(series: [all_held(sequence: 1)]) {
    BehavioralEquivalenceLatest { latest: _, outstanding } => count(outstanding) == 0
    BehavioralEquivalenceSeriesEmpty => false
    BehavioralEquivalenceSeriesInvalid { reason: _ } => false
  }
  forged && genuine
}

// The real route: the interlock milestone reads the persisted series through the same standing.
// A latest receipt yields Clear or Outstanding by its outstanding set; an empty or refused series is
// NO OBSERVATION and stays NotDerivable -- never Outstanding, which would report an unmeasured
// equivalence as a measured failure.
fn class_of_series(s: BehavioralEquivalenceStanding) -> String {
  match s {
    BehavioralEquivalenceLatest { latest: _, outstanding } =>
      if count(outstanding) == 0 { standing_class_label(c: ClassClear) } else { standing_class_label(c: ClassOutstanding) }
    BehavioralEquivalenceSeriesEmpty => standing_class_label(c: ClassNotDerivable)
    BehavioralEquivalenceSeriesInvalid { reason: _ } => standing_class_label(c: ClassNotDerivable)
  }
}

test fn the_milestone_derives_from_the_persisted_series() -> Bool {
  standing_class_label(c: standing_class(s: milestone_status(m: SelfHostEmittedContractsHeld)))
    == class_of_series(s: current_behavioral_equivalence_standing())
}

// ---------------------------------------------------------------------------------------------
// A ROW WHOSE WITNESS BINARY WAS NEVER BUILT IS NO VERDICT, NEVER A DIVERGENCE (srv1 validation run,
// 2026-09-27: `WitnessBin.Run ... target/release/witness --inject-fault (exit=127) No such file`).
// The classifier the wet harness ends in is pure, so the order is pinned here over supplied step
// results.

fn outcome_word(o: CsslReceiptOutcome) -> String {
  match o {
    CsslBehaviorHeld => "held"
    CsslBehaviorDiverged { observed: _ } => "diverged"
    CsslSetupRefused { step: _ } => "setup-refused"
  }
}

test fn an_absent_witness_artifact_is_a_setup_refusal_not_a_divergence() -> Bool {
  let refusal = cssl_readiness_refusal(readiness: WitnessBinRefused { bin_name: "witness", path: "/tmp/x/target/release/witness", reason: WitnessBinArtifactAbsent })
  let o = cssl_classify_receipt(setup_refusal: refusal, pass_ok: false, fault_detected: false, claim_ok: true)
  outcome_word(o: o) == "setup-refused"
    && string_contains(s: refusal, pattern: "artifact absent")
    && string_contains(s: refusal, pattern: "/tmp/x/target/release/witness")
}

test fn a_failed_build_names_itself_and_outranks_the_failed_drive() -> Bool {
  let refusal = cssl_readiness_refusal(readiness: WitnessBinRefused { bin_name: "gunbc", path: "/r/target/release/gunbc", reason: WitnessBinBuildFailed })
  match cssl_classify_receipt(setup_refusal: refusal, pass_ok: false, fault_detected: false, claim_ok: false) {
    CsslSetupRefused { step: refused_step } => string_contains(s: refused_step, pattern: "build failed")
    CsslBehaviorDiverged { observed: _ } => false
    CsslBehaviorHeld => false
  }
}

// The discriminating pair: with setup clean, the same failed drive IS a divergence, and a clean
// drive holds -- so the setup arm is not simply swallowing every failure.
test fn with_setup_clean_a_failed_drive_diverges_and_a_clean_one_holds() -> Bool {
  cssl_readiness_refusal(readiness: WitnessBinReady { path: "/r/w" }) == ""
    && outcome_word(o: cssl_classify_receipt(setup_refusal: "", pass_ok: false, fault_detected: true, claim_ok: true)) == "diverged"
    && outcome_word(o: cssl_classify_receipt(setup_refusal: "", pass_ok: true, fault_detected: false, claim_ok: true)) == "diverged"
    && outcome_word(o: cssl_classify_receipt(setup_refusal: "", pass_ok: true, fault_detected: true, claim_ok: true)) == "held"
}

// The taker renders the located setup step into the row's NoVerdict cause rather than dropping it.
test fn the_taker_carries_the_setup_step_into_the_no_verdict_cause() -> Bool {
  no_verdict_cause(cause: BehavioralReceiptSetupRefused { module_path: "m.dag", step: "binary witness: artifact absent at /p" })
    == "setup refused: binary witness: artifact absent at /p"
}
