module test.claim.printed_chassis_stack_feed_witness
import extdeps.fans.arctic { arctic_p8_cable_length, arctic_p8_pwm_sharing, arctic_p8_rated_current, arctic_p14_rated_current, arctic_p14_pwm_sharing }
import std.types { Bool, List }
import std.nat { Nat }
import std.measure { watt, millivolt, millivolt_count, millimeter, millimeter_count, milliampere_count, percent, gram, watt_count }
import v2.std.optional { Present, Absent }
import product.printed_chassis.node_power_feed {
  NodeFeedInputs, declared_connector_derating, node_feed, NodeFeedReading, NodeFeedScreeningOnly, NodeFeedRefused,
  FeedRefusalCause, LoadExceedsBoardInputs, PopulationRuleUnresolved, BranchGaugeUnknown, ConnectorVoltageBelowBand, SetpointAboveBand,
  fan_bank_header_load, FanHeaderLoad, FanHeaderLoadAgainstUnreadLimit, FanBankNeedsOneHeaderPerFan,
}
import product.printed_chassis.power_cassette {
  PowerCassette, TopOfColumn, BottomOfColumn, BesideColumn, station_adequacy, units_lifted_to_pop, station_wall_draw,
}
import product.node_power_envelope { Gold, PsuAdequacy, PsuAdequate, PsuUndersized, PsuUndecidable }
import product.printed_chassis.harness_census { HarnessCensus, HarnessPlan, InletAtRear, InletAtFront, harness_census, disconnect_sets_to_pop, CableRole, DcBranch, Atx12vPigtail, FanHeaderCable, FanPstLink, EthernetPatch }
import extdeps.connector.molex_mini_fit_jr { mini_fit_jr_standard_terminal_rating }
import extdeps.standards.atx12v_psdg { atx12v_twelve_volt_regulation }

fn inputs(load_w: Nat, gauge: Nat, length_mm: Nat, setpoint_mv: Nat) -> NodeFeedInputs {
  NodeFeedInputs {
    node_dc_load: watt(count: load_w),
    connector_rating: mini_fit_jr_standard_terminal_rating,
    derating: declared_connector_derating(retained: percent(count: 60)),
    branch_gauge_awg: gauge,
    branch_length: millimeter(count: length_mm),
    station_setpoint: millivolt(count: setpoint_mv),
    regulation: atx12v_twelve_volt_regulation,
  }
}

// 300 W over 10 AWG at 1.5 m from a 12.2 V setpoint: 26.316 A at the 11.4 V floor, one input at 60 percent of 24 A
// cannot carry it, two can; the round-trip drop is a few hundred millivolts and the connector
// stays inside the band.
test fn a_300_watt_node_takes_two_inputs_and_stays_in_band() -> Bool {
  match node_feed(inputs: inputs(load_w: 300, gauge: 10, length_mm: 1500, setpoint_mv: 12200)) {
    NodeFeedScreeningOnly { feed: f } => f.inputs_populated == 2 && milliampere_count(i: f.node_current) == 26316
      && millivolt_count(v: f.at_connector) >= millivolt_count(v: atx12v_twelve_volt_regulation.minimum)
      && millivolt_count(v: f.branch_round_trip_drop) > 0
    NodeFeedRefused { cause: _ } => false
  }
}

// The same node over 18 AWG at 3 m lands below 11.40 V at the connector: a typed refusal
// naming the drop, not a quietly undervolted board.
test fn a_thin_long_branch_refuses_below_the_band() -> Bool {
  match node_feed(inputs: inputs(load_w: 300, gauge: 18, length_mm: 3000, setpoint_mv: 12000)) {
    NodeFeedScreeningOnly { feed: _ } => false
    NodeFeedRefused { cause: c } => match c { ConnectorVoltageBelowBand { at_connector: v, band_minimum: m, drop: _ } => millivolt_count(v: v) < millivolt_count(v: m) LoadExceedsBoardInputs { required_inputs: _, available_inputs: _, per_input_limit: _ } => false PopulationRuleUnresolved => false BranchGaugeUnknown { gauge: _ } => false SetpointAboveBand { setpoint: _, band_maximum: _ } => false }
  }
}

test fn a_load_beyond_three_inputs_and_an_unknown_gauge_each_refuse_by_name() -> Bool {
  let over = match node_feed(inputs: inputs(load_w: 1500, gauge: 10, length_mm: 500, setpoint_mv: 12000)) {
    NodeFeedScreeningOnly { feed: _ } => false
    NodeFeedRefused { cause: c } => match c { LoadExceedsBoardInputs { required_inputs: r, available_inputs: a, per_input_limit: _ } => r > a && a == 3 ConnectorVoltageBelowBand { at_connector: _, band_minimum: _, drop: _ } => false PopulationRuleUnresolved => false BranchGaugeUnknown { gauge: _ } => false SetpointAboveBand { setpoint: _, band_maximum: _ } => false }
  }
  let gauge = match node_feed(inputs: inputs(load_w: 300, gauge: 11, length_mm: 500, setpoint_mv: 12000)) {
    NodeFeedScreeningOnly { feed: _ } => false
    NodeFeedRefused { cause: c } => match c { BranchGaugeUnknown { gauge: g } => g == 11 LoadExceedsBoardInputs { required_inputs: _, available_inputs: _, per_input_limit: _ } => false ConnectorVoltageBelowBand { at_connector: _, band_minimum: _, drop: _ } => false PopulationRuleUnresolved => false SetpointAboveBand { setpoint: _, band_maximum: _ } => false }
  }
  let high = match node_feed(inputs: inputs(load_w: 300, gauge: 10, length_mm: 500, setpoint_mv: 12700)) {
    NodeFeedScreeningOnly { feed: _ } => false
    NodeFeedRefused { cause: c } => match c { SetpointAboveBand { setpoint: _, band_maximum: _ } => true LoadExceedsBoardInputs { required_inputs: _, available_inputs: _, per_input_limit: _ } => false ConnectorVoltageBelowBand { at_connector: _, band_minimum: _, drop: _ } => false PopulationRuleUnresolved => false BranchGaugeUnknown { gauge: _ } => false }
  }
  over && gauge && high
}

test fn the_fan_bank_reaches_one_header_against_an_unread_limit() -> Bool {
  match fan_bank_header_load(fans: 3, rated_current: arctic_p8_rated_current, sharing: arctic_p8_pwm_sharing) {
    FanHeaderLoadAgainstUnreadLimit { header_current: i, fans: n } => n == 3 && milliampere_count(i: i) == 270
    FanBankNeedsOneHeaderPerFan { fans: _, headers_available: _ } => false
  }
}

fn station(placement_top: Bool) -> PowerCassette {
  PowerCassette { nodes_fed: 4, placement: if placement_top { TopOfColumn } else { BottomOfColumn }, supply_rated_output: watt(count: 1600), supply_efficiency: Gold, mass: gram(count: 4000) }
}

test fn a_station_is_adequate_for_four_nodes_and_not_for_eight() -> Bool {
  let four = match station_adequacy(station: station(placement_top: false), node_dc_loads: [watt(count: 300), watt(count: 300), watt(count: 300), watt(count: 300)]) { PsuAdequate { dc_load: _, rated: _, headroom: h } => watt_count(w: h) == 400 PsuUndersized { dc_load: _, rated: _, shortfall: _ } => false PsuUndecidable { cause: _ } => false }
  let eight = match station_adequacy(station: station(placement_top: false), node_dc_loads: [watt(count: 300), watt(count: 300), watt(count: 300), watt(count: 300), watt(count: 300), watt(count: 300), watt(count: 300), watt(count: 300)]) { PsuAdequate { dc_load: _, rated: _, headroom: _ } => false PsuUndersized { dc_load: _, rated: _, shortfall: s } => watt_count(w: s) == 800 PsuUndecidable { cause: _ } => false }
  four && eight && watt_count(w: station_wall_draw(station: station(placement_top: false), node_dc_loads: [watt(count: 900)])) == 1000
}

// A station on top is lifted by every pop; at the bottom by none. Popping the bottom node of
// four lifts three nodes either way.
test fn station_placement_decides_what_a_pop_lifts() -> Bool {
  units_lifted_to_pop(station: station(placement_top: true), node_count: 4, node_index_from_bottom: 0) == 4
  && units_lifted_to_pop(station: station(placement_top: false), node_count: 4, node_index_from_bottom: 0) == 3
  && units_lifted_to_pop(station: station(placement_top: false), node_count: 4, node_index_from_bottom: 3) == 0
}

fn plan(top: Bool, front: Bool, allowance: Nat) -> HarnessPlan {
  HarnessPlan { node_count: 4, station: station(placement_top: top), inlet: if front { InletAtFront } else { InletAtRear }, inputs_populated: 2, fans_per_node: 3, fan_cable_length: arctic_p8_cable_length, fan_pwm_sharing: arctic_p8_pwm_sharing, ethernet_per_node: 2, switch_level_from_bottom: 4, service_allowance: millimeter(count: allowance) }
}

// Four nodes: per node one branch, two pigtails, two patch leads, one fan header cable and two
// PST links, so five runs and eight cables per node, 20 runs and 32 cables in all. The rear fan offset makes the lead too short with either 100 mm
// or 150 mm allowance, and the census says which.
test fn the_census_counts_every_cable_and_prices_the_fan_lead() -> Bool {
  let c = harness_census(plan: plan(top: false, front: false, allowance: 100))
  let tight = harness_census(plan: plan(top: false, front: false, allowance: 150))
  c.cable_count == 32 && count(c.runs) == 20 && millimeter_count(m: c.total_length) > 0
  && c.fan_header_extension_needed && tight.fan_header_extension_needed
  && disconnect_sets_to_pop(plan: plan(top: true, front: false, allowance: 100), node: 0) == 5
  && disconnect_sets_to_pop(plan: plan(top: false, front: false, allowance: 100), node: 0) == 4
}

// Moving the inlet to the front moves the tray crossing from the pigtail to the branch; the
// total copper does not vanish, it moves, and the census shows the move.
test fn inlet_placement_moves_copper_rather_than_removing_it() -> Bool {
  let rear = harness_census(plan: plan(top: false, front: false, allowance: 100))
  let front = harness_census(plan: plan(top: false, front: true, allowance: 100))
  role_length(c: rear, pigtail: true) > role_length(c: front, pigtail: true) && role_length(c: front, pigtail: false) > role_length(c: rear, pigtail: false)
}

fn role_length(c: HarnessCensus, pigtail: Bool) -> Nat {
  fold(filter(c.runs, r => match r.role { Atx12vPigtail => pigtail DcBranch => !pigtail FanHeaderCable => false FanPstLink => false EthernetPatch => false }), init: 0, f: (acc, r) => acc + r.count * millimeter_count(m: r.each))
}

test fn zero_connector_derating_cannot_admit_a_feed() -> Bool {
 let i=inputs(load_w:300,gauge:10,length_mm:1500,setpoint_mv:12200)
 let invalid=NodeFeedInputs {node_dc_load:i.node_dc_load,connector_rating:i.connector_rating,derating:declared_connector_derating(retained:percent(count:0)),branch_gauge_awg:i.branch_gauge_awg,branch_length:i.branch_length,station_setpoint:i.station_setpoint,regulation:i.regulation}
 match node_feed(inputs:invalid) {NodeFeedRefused {cause:PopulationRuleUnresolved}=>true _=>false}
}

test fn header_load_follows_selected_fan_current() -> Bool {
 match fan_bank_header_load(fans:2,rated_current:arctic_p14_rated_current,sharing:arctic_p14_pwm_sharing) {
 FanHeaderLoadAgainstUnreadLimit {header_current:i,fans:n}=>n==2 && milliampere_count(i:i)==240
 _=>false
 }
}
