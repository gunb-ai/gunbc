module test.claim.huggingface.hub_blob_store_layout_witness

import std.types { Bool, String, List, NonEmptyStr }
import extdeps.huggingface.hub { hub_dereferenced_bytes_argv, hub_repo_blob_hard_link_argv }

// A REPO BLOB ENTRY MAY BE A SHARED-STORE LINK OR A REPO-LOCAL FILE, PER FILE (hf 1.33 on srv7
// 2026-10-03 wrote links; upstream falls back to repo-local blobs where sharing fails). The byte
// operations therefore take no layout and dereference every entry: deleting -L from either argv reds
// the claims below.

test fn w_hard_link_of_a_repo_blob_dereferences() -> Bool {
  join(hub_repo_blob_hard_link_argv(repo_blob: "/c/models--o--m/blobs/ab" as NonEmptyStr, destination: "/f/ab" as NonEmptyStr), " ")
    == "ln -fL /c/models--o--m/blobs/ab /f/ab"
}

// A MIXED CACHE: one entry a shared-store link, one a repo-local fallback blob. Both go through the
// same dereferencing argv; nothing about either entry selects a different operation.
data mixed_cache_entries: List<NonEmptyStr> = [
  "/c/models--o--m/blobs/linked-into-hub-blobs" as NonEmptyStr,
  "/c/models--o--m/blobs/repo-local-fallback" as NonEmptyStr,
]

test fn w_mixed_cache_entries_all_dereference() -> Bool {
  all(mixed_cache_entries, e => {
    let argv = hub_repo_blob_hard_link_argv(repo_blob: e, destination: "/f/x" as NonEmptyStr)
    join(argv, " ") == join(["ln -fL ", e as String, " /f/x"], "")
  })
}

// A repo folder's completed bytes are read DEREFERENCED: undereferenced, a folder whose blobs are
// links reads near zero and shrinks as the fetch completes.
test fn w_completed_bytes_are_read_dereferenced() -> Bool {
  join(hub_dereferenced_bytes_argv(path: "/c/models--o--m" as NonEmptyStr), " ") == "du -sbL /c/models--o--m"
}
