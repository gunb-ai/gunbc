module test.claim.bmc_factory_credential


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data new_server_baseboard: std.baseboard.ServerBaseboard = std.baseboard.ServerBaseboard {
  catalog: extdeps.boards.asrock_rack.asrock_altrad8ud_1l2t_catalog,
  bmc: std.bmc.BmcEndpoint { host: "10.0.0.10", protocol: Redfish },
}

data new_server_factory_login: FactoryLogin = extdeps.bmc.openbmc.bmc_firmware_factory_login(family: new_server_baseboard.catalog.bmc_firmware)

fn protocol_count(ps: List<std.bmc.BmcProtocol>) -> Int {
  fold(ps, init: 0, f: (acc, gunbc.plans.md_helpers.p) => acc + 1)
}

fn manufacturer_matches(m: std.baseboard.BaseboardManufacturer) -> Bool {
  match m {
    AsrockRack => true
  }
}

test fn bmc_factory_credential_holds() -> Bool {

  new_server_factory_login.username == "root"
    && new_server_factory_login.published_password == "0penBmc"

    && manufacturer_matches(std.baseboard.baseboard_manufacturer(model: new_server_baseboard.catalog.model))

    && protocol_count(ps: extdeps.bmc.openbmc.bmc_firmware_supported_protocols(family: OpenBmc)) == 2
}
