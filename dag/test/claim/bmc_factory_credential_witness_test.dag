module test.claim.bmc_factory_credential


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data new_server_baseboard: extdeps.boards.types.ServerBaseboard = extdeps.boards.types.ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: std.bmc.BmcEndpoint { host: "10.0.0.10", protocol: Redfish },
}

data new_server_factory_login: std.credentials.FactoryLogin = bmc_firmware_factory_login(family: new_server_baseboard.catalog.bmc_firmware)

fn protocol_count(ps: List<std.bmc.BmcProtocol>) -> Int {
  fold(ps, init: 0, f: (acc, p) => acc + 1)
}

test fn bmc_factory_credential_holds() -> Bool {

  new_server_factory_login.username == "root"
    && new_server_factory_login.published_password == "0penBmc"

    && new_server_baseboard.catalog.vendor == extdeps.vendor.asrock_rack.asrock_rack

    && protocol_count(ps: bmc_firmware_supported_protocols(family: OpenBmc)) == 2
}
