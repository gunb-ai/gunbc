module test.claim.map_key_alias_hop_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data map_key_alias_hop_witness_note: String = "Executing floor witness for the alias arm of the Eq + Hash capability fixpoint (v1.compiler.trait_derive_emit v1_eq_hash_capable_type_names; the alias is reached through v1_item_field_type_exprs's v1_item_alias_hop_type_exprs). POSITIVE (w_structural_alias_hop_follows_to_its_target): a holder whose field is spelled through an alias of a capable record stays capable, and the record derives Eq + Hash. NEGATIVE (w_alias_to_incapable_record_makes_holder_incapable): the same shape over a record with a Float field -- Float has no Eq or Hash row -- so incapability crosses the alias hop and the holder derives neither. Both fixtures compile through compile_dag_rust_emit_check, so this is green-by-execution against the real emitter. THE EARLIER NEGATIVE, a realized alias named Bytes declining the hop, was a consumer-seeded map-key case; the requirement it controlled no longer exists, and type_realization_decision's Realized branch it exercised has no witness here."

fn w_structural_alias_hop_follows_to_its_target() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_alias_hop_witness.structural\n\ntype AliasedPayload {\n  tag: Int\n}\n\ntype StructuralKeyAlias = AliasedPayload\n\ntype AliasHopTable {\n  entries: Map<StructuralKeyAlias, Int>\n}\n",
    "src/map_key_alias_hop_witness_structural.rs",
    ["Eq, std::hash::Hash)]\npub struct AliasedPayload"],
    []
  )
}

fn w_alias_to_incapable_record_makes_holder_incapable() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_alias_hop_witness.incapable\n\ntype FloatPayload {\n  weight: Float\n}\n\ntype FloatKeyAlias = FloatPayload\n\ntype AliasHopHolder {\n  held: FloatKeyAlias\n}\n",
    "src/map_key_alias_hop_witness_incapable.rs",
    ["pub struct AliasHopHolder"],
    ["std::hash::Hash"]
  )
}

test fn structural_alias_hop_follows_to_its_target() -> Bool {
  w_structural_alias_hop_follows_to_its_target()
}

test fn alias_to_incapable_record_makes_holder_incapable() -> Bool {
  w_alias_to_incapable_record_makes_holder_incapable()
}
