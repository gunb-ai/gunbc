module test.claim.merge_admission_enforcement_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data scenario_base_b0: extdeps.git.object_store.GitObjectId = merge_admission_witness_git_tree(label: "merge-admission-enforce-base-b0")
data scenario_base_b1: extdeps.git.object_store.GitObjectId = merge_admission_witness_git_tree(label: "merge-admission-enforce-base-b1")
data scenario_roster_r1: gunbc.merge_admission.GateRosterHash = merge_admission_witness_gate_roster(label: "merge-admission-enforce-roster-r1")
data scenario_head: std.types.CommitSha = "abc1234def5678901234567890abcd1234567890"
data fresh_receipt: gunbc.merge_admission.MergeAdmissionReceipt = stamp_floor_receipt(
  pr_number: Present { value: 5933 },
  head_sha: test.claim.merge_admission_enforcement_witness.scenario_head,
  base_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
  floor_exit_code: 0,
)

data stale_base_receipt: gunbc.merge_admission.MergeAdmissionReceipt = gunbc.merge_admission.MergeAdmissionReceipt {
  pr_number: Present { value: 5933 },
  head_sha: test.claim.merge_admission_enforcement_witness.scenario_head,
  base_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
  gate_roster_hash: current_gate_roster_hash,
  conclusion: Success,
}

data stale_roster_receipt: gunbc.merge_admission.MergeAdmissionReceipt = gunbc.merge_admission.MergeAdmissionReceipt {
  pr_number: Present { value: 5933 },
  head_sha: test.claim.merge_admission_enforcement_witness.scenario_head,
  base_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
  gate_roster_hash: test.claim.merge_admission_enforcement_witness.scenario_roster_r1,
  conclusion: Success,
}

data red_receipt: gunbc.merge_admission.MergeAdmissionReceipt = stamp_floor_receipt(
  pr_number: Present { value: 5933 },
  head_sha: test.claim.merge_admission_enforcement_witness.scenario_head,
  base_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
  floor_exit_code: 1,
)

test fn gating_still_deferred_until_activation_flip() -> Bool {
  (merge_freshness_gating_status == GatingComputedDeferred)
    && (gating_is_enforced(s: merge_freshness_gating_status) == false)
}

test fn enforcement_gating_scaffold_is_tracked() -> Bool {
  match merge_admission_enforcement_gating_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn gating_activation_trigger_names_flip() -> Bool {
  match merge_admission_enforcement_gating_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

test fn would_block_stale_base() -> Bool {
  merge_admission_would_block(
    receipt: stale_base_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b1,
    current_roster_hash: current_gate_roster_hash,
  )
}

test fn would_block_stale_roster() -> Bool {
  merge_admission_would_block(
    receipt: stale_roster_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
    current_roster_hash: current_gate_roster_hash,
  )
}

test fn would_block_red_conclusion() -> Bool {
  merge_admission_would_block(
    receipt: test.claim.merge_admission_enforcement_witness.red_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
    current_roster_hash: current_gate_roster_hash,
  )
}

test fn would_not_block_fresh_green() -> Bool {
  !merge_admission_would_block(
    receipt: fresh_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
    current_roster_hash: current_gate_roster_hash,
  )
}

test fn blocks_merge_false_while_deferred_even_if_stale() -> Bool {
  merge_admission_would_block(
    receipt: stale_base_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b1,
    current_roster_hash: current_gate_roster_hash,
  )
    && (merge_admission_blocks_merge(
      receipt: stale_base_receipt,
      merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b1,
      current_roster_hash: current_gate_roster_hash,
    ) == false)
}

test fn wire_stale_base_fails_verdict_parse_path() -> Bool {
  let wire = render_receipt_wire(receipt: stale_base_receipt)
  match parse_receipt_wire(text: wire) {
    Present { value: parsed } =>
      match classify_merge_admission_verdict(
        receipt: parsed,
        merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b1,
        current_roster_hash: current_gate_roster_hash,
      ) {
        MergeDeniedStaleBase => true
        MergeAdmitted => false
        MergeDeniedStaleRoster => false
        MergeDeniedNotSuccess => false
        MergeDeniedWrongAttempt => false
        MergeDeniedSubjectMismatch => false
      }
    Absent => false
  }
}

test fn fresh_verdict_is_merge_admitted() -> Bool {
  match classify_merge_admission_verdict(
    receipt: fresh_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
    current_roster_hash: current_gate_roster_hash,
  ) {
    MergeAdmitted => true
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
  }
}

test fn red_verdict_is_merge_denied_not_success() -> Bool {
  match classify_merge_admission_verdict(
    receipt: test.claim.merge_admission_enforcement_witness.red_receipt,
    merge_target_tree_hash: test.claim.merge_admission_enforcement_witness.scenario_base_b0,
    current_roster_hash: current_gate_roster_hash,
  ) {
    MergeDeniedNotSuccess => true
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
    MergeAdmitted => false
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
  }
}
