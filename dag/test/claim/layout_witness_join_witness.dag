module test.claim.layout_witness_join_witness

import std.types { Bool, List, String }
import std.optional { Present }
import v2.std.live_tree { SubstrateInputsOnly }
import v2.workflow.floor_discovery_row { FloorDiscoveryRow }
import gunbc.instruments.layout_witness_join {
  JoinFinding,
  Observation,
  ObservedRow,
  PlanEdges,
  finding_line,
  join_summary_lines,
  observation_of,
  observed_file_line,
  observed_row_line,
  plan_edges_of,
  red_findings,
  reported_findings,
  witness_set_join
}

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// WITNESSES FOR THE WITNESS-SET IDENTITY JOIN (gunbc.instruments.layout_witness_join), the C4 admission
// that the floor's discovered witness set is the same set, carried through the sweep's rename map,
// before and after the sweep. Each control isolates one way a sweep can change the set, over invented
// observations, so a red names the discrepancy that broke.
//
// THE PAIRING OBLIGATION. These claims supply the observations; the real producer is run by
// layout_witness_observe, once per tree, and its receipt is the join over the real trees. The one
// claim here that touches the producer's own vocabulary is the round trip, which pins that the line the
// observer writes for a real FloorDiscoveryRow is the line the join reads back.

fn file_line(path: String) -> String {
  observed_file_line(path: path)
}

fn row_line(entry: String, function: String) -> String {
  join(["ROW", entry, function, concat("label_", function), "SubstrateInputsOnly"], "\t")
}

fn row_line_labelled(entry: String, function: String, label: String) -> String {
  join(["ROW", entry, function, label, "SubstrateInputsOnly"], "\t")
}

fn row_line_live(entry: String, function: String) -> String {
  join(["ROW", entry, function, concat("label_", function), "ReadsLiveTree"], "\t")
}

fn observation(lines: List<String>) -> Observation {
  observation_of(text: join(lines, "\n"))
}

fn edge(old_path: String, new_path: String) -> String {
  join([old_path, new_path, "some.module", "A"], "\t")
}

fn plan(edges: List<String>) -> PlanEdges {
  plan_edges_of(text: join(concat(["modules changed: 1"], edges), "\n"))
}

fn no_plan() -> PlanEdges {
  plan(edges: [])
}

fn reds(old: Observation, new: Observation, edges: PlanEdges, removals: List<String>) -> String {
  join(red_findings(findings: witness_set_join(old: old, new: new, plan: edges, declared_removals: removals)) |> map(f => finding_line(finding: f)), "|")
}

fn infos(old: Observation, new: Observation, edges: PlanEdges, removals: List<String>) -> String {
  join(reported_findings(findings: witness_set_join(old: old, new: new, plan: edges, declared_removals: removals)) |> map(f => finding_line(finding: f)), "|")
}

fn base_old() -> Observation {
  observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1"),
    row_line(entry: "dag/a/x_test.dag", function: "f2")
  ])
}

// ---- the join holds --------------------------------------------------------------------------------
test fn an_unchanged_set_is_equal() -> Bool {
  reds(old: base_old(), new: base_old(), edges: no_plan(), removals: []) == ""
}

test fn a_set_carried_through_the_plan_is_equal() -> Bool {
  let moved = observation(lines: [
    file_line(path: "dag/b/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/b/x_test.dag", function: "f1"),
    row_line(entry: "dag/b/x_test.dag", function: "f2")
  ])
  reds(old: base_old(), new: moved, edges: plan(edges: [edge(old_path: "dag/a/x_test.dag", new_path: "dag/b/x_test.dag")]), removals: []) == ""
}

test fn a_carried_set_reports_nothing_beyond_preservation() -> Bool {
  let moved = observation(lines: [
    file_line(path: "dag/b/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/b/x_test.dag", function: "f1"),
    row_line(entry: "dag/b/x_test.dag", function: "f2")
  ])
  infos(old: base_old(), new: moved, edges: plan(edges: [edge(old_path: "dag/a/x_test.dag", new_path: "dag/b/x_test.dag")]), removals: []) == ""
}

test fn an_equal_join_says_equal_in_its_summary() -> Bool {
  let findings = witness_set_join(old: base_old(), new: base_old(), plan: no_plan(), declared_removals: [])
  join_summary_lines(old: base_old(), new: base_old(), findings: findings)[4] == Present { value: "RESULT\tEQUAL" }
}

// ---- the join refuses ------------------------------------------------------------------------------
test fn a_lost_row_is_red() -> Bool {
  let fewer = observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1")
  ])
  reds(old: base_old(), new: fewer, edges: no_plan(), removals: []) == "RED\tROW_LOST\tdag/a/x_test.dag\tf2"
}

test fn a_gained_row_in_a_retained_file_is_red() -> Bool {
  let more = observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1"),
    row_line(entry: "dag/a/x_test.dag", function: "f2"),
    row_line(entry: "dag/a/x_test.dag", function: "f3")
  ])
  reds(old: base_old(), new: more, edges: no_plan(), removals: []) == "RED\tROW_GAINED\tdag/a/x_test.dag\tf3"
}

test fn an_altered_label_is_red() -> Bool {
  let relabelled = observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1"),
    row_line_labelled(entry: "dag/a/x_test.dag", function: "f2", label: "another_label")
  ])
  string_contains(s: reds(old: base_old(), new: relabelled, edges: no_plan(), removals: []), pattern: "RED\tROW_ALTERED\tdag/a/x_test.dag\tf2")
}

test fn an_altered_live_tree_disposition_is_red() -> Bool {
  let live = observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1"),
    row_line_live(entry: "dag/a/x_test.dag", function: "f2")
  ])
  string_contains(s: reds(old: base_old(), new: live, edges: no_plan(), removals: []), pattern: "RED\tROW_ALTERED\tdag/a/x_test.dag\tf2")
}

// THE DEFECT THIS ADMISSION EXISTS FOR: a sweep that renames a sidecar-stem file to a stem without the
// suffix. The count of files is unchanged and the total of rows would be equal if the rows moved to a
// file the floor still reads; here the file no longer qualifies, so its rows are lost AND the file's
// status changed, and both are reported.
test fn a_dropped_sidecar_suffix_is_red() -> Bool {
  let renamed = observation(lines: [
    file_line(path: "dag/b/x.dag"),
    file_line(path: "dag/a/y.dag")
  ])
  let found = reds(old: base_old(), new: renamed, edges: plan(edges: [edge(old_path: "dag/a/x_test.dag", new_path: "dag/b/x.dag")]), removals: [])
  string_contains(s: found, pattern: "RED\tTEST_STATUS_CHANGED\tdag/a/x_test.dag\tdag/b/x.dag")
    && string_contains(s: found, pattern: "RED\tROW_LOST\tdag/a/x_test.dag\tf1")
}

test fn a_rename_the_plan_does_not_name_is_red() -> Bool {
  let renamed = observation(lines: [
    file_line(path: "dag/b/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    row_line(entry: "dag/b/x_test.dag", function: "f1"),
    row_line(entry: "dag/b/x_test.dag", function: "f2")
  ])
  string_contains(s: reds(old: base_old(), new: renamed, edges: no_plan(), removals: []), pattern: "RED\tTEST_FILE_REMOVED\tdag/a/x_test.dag")
}

test fn an_undeclared_removal_of_a_sidecar_stem_file_is_red() -> Bool {
  let without = observation(lines: [file_line(path: "dag/a/y.dag")])
  reds(old: base_old(), new: without, edges: no_plan(), removals: []) == "RED\tTEST_FILE_REMOVED\tdag/a/x_test.dag"
}

test fn a_declared_removal_of_a_sidecar_stem_file_is_not_red() -> Bool {
  let without = observation(lines: [file_line(path: "dag/a/y.dag")])
  reds(old: base_old(), new: without, edges: no_plan(), removals: ["dag/a/x_test.dag"]) == ""
}

test fn a_declared_removal_is_still_reported() -> Bool {
  let without = observation(lines: [file_line(path: "dag/a/y.dag")])
  string_contains(s: infos(old: base_old(), new: without, edges: no_plan(), removals: ["dag/a/x_test.dag"]), pattern: "INFO\tTEST_FILE_REMOVED_DECLARED\tdag/a/x_test.dag")
}

test fn a_declaration_for_another_path_does_not_excuse_a_removal() -> Bool {
  let without = observation(lines: [file_line(path: "dag/a/y.dag")])
  reds(old: base_old(), new: without, edges: no_plan(), removals: ["dag/a/y.dag"]) == "RED\tTEST_FILE_REMOVED\tdag/a/x_test.dag"
}

test fn a_plan_edge_for_a_file_the_old_tree_lacks_is_red() -> Bool {
  reds(old: base_old(), new: base_old(), edges: plan(edges: [edge(old_path: "dag/a/gone.dag", new_path: "dag/b/gone.dag")]), removals: []) == "RED\tPLAN_STALE\tdag/a/gone.dag"
}

test fn two_files_carried_to_one_path_are_red() -> Bool {
  let old = observation(lines: [file_line(path: "dag/a/p.dag"), file_line(path: "dag/a/q.dag")])
  let new = observation(lines: [file_line(path: "dag/b/p.dag")])
  string_contains(
    s: reds(old: old, new: new, edges: plan(edges: [edge(old_path: "dag/a/p.dag", new_path: "dag/b/p.dag"), edge(old_path: "dag/a/q.dag", new_path: "dag/b/p.dag")]), removals: []),
    pattern: "RED\tPLAN_COLLISION"
  )
}

test fn a_malformed_observation_line_is_red() -> Bool {
  let bad = observation(lines: [file_line(path: "dag/a/x_test.dag"), "ROW\tonly\tthree"])
  string_contains(s: reds(old: bad, new: bad, edges: no_plan(), removals: []), pattern: "RED\tINPUT_MALFORMED\told\tROW")
}

test fn a_malformed_plan_line_is_red() -> Bool {
  let bad = plan_edges_of(text: "dag/a/x_test.dag\tdag/b/x_test.dag")
  string_contains(s: reds(old: base_old(), new: base_old(), edges: bad, removals: []), pattern: "RED\tINPUT_MALFORMED\tplan")
}

// ---- what is not red -------------------------------------------------------------------------------
test fn rows_in_an_added_file_are_introduced_not_red() -> Bool {
  let added = observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    file_line(path: "dag/a/y.dag"),
    file_line(path: "dag/c/z_test.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1"),
    row_line(entry: "dag/a/x_test.dag", function: "f2"),
    row_line(entry: "dag/c/z_test.dag", function: "g1")
  ])
  reds(old: base_old(), new: added, edges: no_plan(), removals: []) == ""
    && string_contains(s: infos(old: base_old(), new: added, edges: no_plan(), removals: []), pattern: "INFO\tROW_INTRODUCED\tdag/c/z_test.dag\tg1")
}

test fn removing_a_file_without_the_sidecar_suffix_is_reported_not_red() -> Bool {
  let without = observation(lines: [
    file_line(path: "dag/a/x_test.dag"),
    row_line(entry: "dag/a/x_test.dag", function: "f1"),
    row_line(entry: "dag/a/x_test.dag", function: "f2")
  ])
  reds(old: base_old(), new: without, edges: no_plan(), removals: []) == ""
    && string_contains(s: infos(old: base_old(), new: without, edges: no_plan(), removals: []), pattern: "INFO\tFILE_REMOVED\tdag/a/y.dag")
}

// ---- the join and the producer agree on the line --------------------------------------------------
test fn the_line_the_observer_writes_for_a_discovery_row_is_the_row_the_join_reads() -> Bool {
  let row = FloorDiscoveryRow {
    label: "a_label",
    entry: "dag/a/x_test.dag",
    function: "f1",
    reads_live_tree: SubstrateInputsOnly
  }
  let read = observation_of(text: observed_row_line(row: row))
  count(read.rows) == 1
    && count(read.malformed) == 0
    && read.rows[0] == Present { value: ObservedRow { entry: "dag/a/x_test.dag", function: "f1", label: "a_label", live: "SubstrateInputsOnly" } }
}

test fn a_tracked_file_line_round_trips() -> Bool {
  let read = observation_of(text: observed_file_line(path: "dag/a/x_test.dag"))
  count(read.files) == 1 && count(read.malformed) == 0 && read.files[0] == Present { value: "dag/a/x_test.dag" }
}
