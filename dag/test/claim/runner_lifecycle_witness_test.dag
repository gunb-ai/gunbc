module test.claim.runner_lifecycle

import std.logic { Bool }
import std.types { list_length, NonEmptyStr }
import std.measure { byte_size, byte_size_count }
import gunbc.runner_lifecycle {
  runner_slot_add_sequence_for,
  RunnerSlotAddSequence,
  GitHubRunnerAddSequence,
  FabricSlotHasNoGitHubAddSequence,
  SlotIsNotACommittedMember,
  runner_slot_add_steps_ordered,
  runner_slot_caps_precede_start,
  runner_slot_add_step_index,
  AddStepMemoryCaps,
  AddStepStartUnit,
  AddStepDaemonReload,
  runner_width_disk_preflight,
  runner_width_disk_required,
  DiskHeadroomSufficient,
  DiskHeadroomInsufficient,
  DiskHeadroomUnobserved,
  host_runner_capacity_converged,
  HostRunnerCapacityReceipt,
  runner_slot_unit_name,
}
import gunbc.build_cache_instance { runner_slot_instance_name, runner_slot_index_suffix }
import gunbc.runner_incarnation { runner_slot_incarnation }
import gunbc.host_disk_observation {
  DiskObserved,
  DiskUnobserved,
  DiskObservationRefused,
}
import gunbc.build_cache_instance { RunnerSlotIdentity }
import gunbc.runner_slot_allocation {
  gunbc_runner_slot_allocation_srv3,
  gunbc_runner_slot_allocation_srv4,
  gunbc_runner_slots_per_host,
}
import gunbc.fleet_intent_network { operator_host_srv3, operator_host_srv4 }

test fn witness_add_sequence_caps_before_start() -> Bool {
  runner_slot_caps_precede_start()
    && runner_slot_add_step_index(step: AddStepMemoryCaps) == 8
    && runner_slot_add_step_index(step: AddStepDaemonReload) == 9
    && runner_slot_add_step_index(step: AddStepStartUnit) == 10
    && list_length(items: runner_slot_add_steps_ordered()) == 12
}

test fn witness_disk_preflight_sufficient_at_apply_width() -> Bool {
  let required = runner_width_disk_required(requested_width: 6)
  let free = byte_size(byte_size_count(b: required) + 1)
  match runner_width_disk_preflight(requested_width: 6, disk: DiskObserved { free_bytes: free, observed_on: "srv4" as NonEmptyStr }) {
    DiskHeadroomSufficient { requested_width: w, required: r, observed_free: o } =>
      w == 6 && byte_size_count(b: r) == byte_size_count(b: required) && byte_size_count(b: o) > byte_size_count(b: r)
    DiskHeadroomInsufficient { requested_width: _, required: _, observed_free: _ } => false
    DiskHeadroomUnobserved { requested_width: _, reason: _ } => false
  }
}

test fn witness_disk_preflight_insufficient_refuses_not_fallback() -> Bool {
  let required = runner_width_disk_required(requested_width: 6)
  let free = byte_size(byte_size_count(b: required) - 1)
  match runner_width_disk_preflight(requested_width: 6, disk: DiskObserved { free_bytes: free, observed_on: "srv4" as NonEmptyStr }) {
    DiskHeadroomInsufficient { requested_width: w, required: r, observed_free: o } =>
      w == 6 && byte_size_count(b: o) < byte_size_count(b: r)
    DiskHeadroomSufficient { requested_width: _, required: _, observed_free: _ } => false
    DiskHeadroomUnobserved { requested_width: _, reason: _ } => false
  }
}

test fn witness_disk_preflight_unobservable_refuses_not_width_five() -> Bool {
  match runner_width_disk_preflight(
    requested_width: 6,
    disk: DiskUnobserved { reason: "df producer scaffold" },
  ) {
    DiskHeadroomUnobserved { requested_width: w, reason: _ } => w == 6
    DiskHeadroomSufficient { requested_width: _, required: _, observed_free: _ } => false
    DiskHeadroomInsufficient { requested_width: _, required: _, observed_free: _ } => false
  }
    && match runner_width_disk_preflight(
      requested_width: 6,
      disk: DiskObservationRefused { detail: "reach refused" as NonEmptyStr },
    ) {
      DiskHeadroomUnobserved { requested_width: w, reason: r } => w == 6 && string_contains(s: r, pattern: "reach refused")
      DiskHeadroomSufficient { requested_width: _, required: _, observed_free: _ } => false
      DiskHeadroomInsufficient { requested_width: _, required: _, observed_free: _ } => false
    }
}

// RENAMED 2026-08-23: the width is 21, not six. The two hosts still agree with each other and with
// gunbc_runner_slots_per_host, which is what this row actually checks -- that the materialized
// per-host allocation rows and the function that derives width have not drifted apart. Naming the
// number in the test's own identity meant the name went stale the moment the fleet's memory did.
test fn witness_srv3_srv4_committed_width_agrees_with_the_derivation() -> Bool {
  gunbc_runner_slot_allocation_srv3.slots_per_host == 21
    && gunbc_runner_slot_allocation_srv4.slots_per_host == 21
    && gunbc_runner_slots_per_host(host: operator_host_srv3) == 21
    && gunbc_runner_slots_per_host(host: operator_host_srv4) == 21
}

test fn witness_host_capacity_receipt_converged_shape() -> Bool {
  let w = 3
  let receipt = HostRunnerCapacityReceipt {
    host: operator_host_srv3,
    requested_width: w,
    materialized_count: w,
    active_unit_count: w,
    registered_count: w,
    online_count: w,
    slots: [],
  }
  host_runner_capacity_converged(receipt: receipt)
}

test fn witness_RED_host_capacity_receipt_one_count_short_does_not_converge() -> Bool {
  let w = 3
  !host_runner_capacity_converged(receipt: HostRunnerCapacityReceipt {
    host: operator_host_srv3,
    requested_width: w,
    materialized_count: w,
    active_unit_count: w,
    registered_count: w,
    online_count: w - 1,
    slots: [],
  })
    && !host_runner_capacity_converged(receipt: HostRunnerCapacityReceipt {
      host: operator_host_srv3,
      requested_width: w,
      materialized_count: w - 1,
      active_unit_count: w,
      registered_count: w,
      online_count: w,
      slots: [],
    })
}

test fn witness_slot_identity_formats_zero_padded_unit() -> Bool {
  let slot = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 6 }
  runner_slot_instance_name(slot: slot) == "srv3-06"
    && runner_slot_unit_name(slot: slot) == "actions-runner@srv3-06.service"
}

fn sequence_registers_with_github(seq: RunnerSlotAddSequence) -> Bool {
  match seq {
    GitHubRunnerAddSequence { steps: s } => list_length(items: s) == 12
    FabricSlotHasNoGitHubAddSequence { reason: _ } => false
    SlotIsNotACommittedMember { reason: _ } => false
  }
}

// A COMPUTE-FABRIC SLOT HAS NO ARM THAT REACHES GitHub REGISTRATION -- not an arm that skips it,
// no arm at all. This is the half that makes the purpose field real: a purpose that does not gate
// the add sequence would record which slots we INTENDED not to register while leaving every one of
// them registrable.
//
// BOTH DIRECTIONS ARE ASSERTED BECAUSE ONLY ONE OF THEM IS THE SAFETY CLAIM AND ONLY THE OTHER
// PROVES THE GATE IS NOT VACUOUS. A gate that refused everything would satisfy the fabric row
// alone; srv4-06 is the control -- the same slot index on a host of the same committed width --
// and it must still receive the full twelve-step GitHub sequence.
test fn the_fabric_slot_cannot_be_registered_and_the_gate_is_not_vacuous() -> Bool {
  !sequence_registers_with_github(seq: runner_slot_add_sequence_for(host: operator_host_srv3, slot_index: 6))
    && sequence_registers_with_github(seq: runner_slot_add_sequence_for(host: operator_host_srv4, slot_index: 6))
    && sequence_registers_with_github(seq: runner_slot_add_sequence_for(host: operator_host_srv3, slot_index: 5))
}

// THE COLLISION ROW. Before the suffix fork was dissolved, runner_incarnation enumerated indices 1
// through 8 and returned the literal "00" for everything above, while the other four sites derived
// the pad. So at index 9 the fleet had two answers -- srv3-09 and srv3-00 -- and worse, EVERY index
// above 8 produced that same "00", meaning two distinct slots would contend for one registration in
// the GitHub runner namespace. This row goes red against the enumerator and green against the
// derived rule, and it is written at 9 because that is the first index where they differed.
test fn the_incarnation_name_agrees_with_the_slot_name_above_the_old_enumerated_range() -> Bool {
  let slot = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 9 }
  (runner_slot_incarnation(host: operator_host_srv3, slot_index: 9, unit_active: true).registration_name as String)
    == runner_slot_instance_name(slot: slot)
    && runner_slot_instance_name(slot: slot) == "srv3-09"
}

// NON-COLLISION, STATED AS THE PROPERTY RATHER THAN AS TWO SAMPLES. Two different indices above the
// old enumerated range must not share a name. Under the enumerator both were "00"; under the derived
// rule they differ. Without this row the one above is satisfied by any function that happens to
// return "srv3-09" at 9, including another bucket with one more arm.
test fn two_indices_above_the_old_range_do_not_share_a_registration_name() -> Bool {
  runner_slot_index_suffix(index: 9) != runner_slot_index_suffix(index: 10)
    && runner_slot_index_suffix(index: 10) != runner_slot_index_suffix(index: 11)
    && runner_slot_index_suffix(index: 9) == "09"
    && runner_slot_index_suffix(index: 10) == "10"
}

// THE UNCHANGED-BELOW-THE-RANGE CONTROL. The consolidation must not move any name the fleet actually
// uses today, so the committed range keeps its existing spelling.
test fn the_suffix_is_unchanged_across_the_committed_range() -> Bool {
  runner_slot_index_suffix(index: 1) == "01"
    && runner_slot_index_suffix(index: 5) == "05"
    && runner_slot_index_suffix(index: 6) == "06"
}
