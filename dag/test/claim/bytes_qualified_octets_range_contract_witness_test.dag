module test.claim.bytes_qualified_octets_range_contract_witness_test

import std.types { Bool, String }
import std.primitive_projection { primitive_identity_slug }
import gunbc.primitive_egress.dispositions_text { dispositions_text_rows }
import gunbc.primitive_egress.disposition {
  PureComputationOverInputs,
  NoPureComputationHalf,
  ComputationUnestablished
}

// THE WALL UNDER std.bytes bytes_qualified_octets, AND IT EXISTS BECAUSE THE ANNOTATION ALONE WAS
// A READER OBLIGATION WEARING A MECHANISM'S CLOTHES.
//
// bytes_qualified_octets OBSERVES its host value through the uint8_octets_of_ints fold rather than
// sealing it, precisely because the range it would otherwise have asserted is not computed in this
// corpus the way word_to_octets' is:
// word_to_octets runs its members through uint8_of_int where a reader can follow it, while
// bytes_octets' own .dag body is the divergent seam. The range is therefore established by ONE
// declared row -- gunbc.primitive_egress.dispositions_text, the bytes_octets evidence row, whose
// result reads "List<Int> of octets 0..255; total" -- and by nothing that module can see. The fold
// is what makes the received value honest; this claim is about the DECLARED contract beside it.
//
// The annotation on the mint said that if the row stops saying 0..255 the mint owes the fold. In
// prose that sentence is an obligation on whoever happens to read it, and DESIGN section 4c is
// explicit that an annotation is never evidence a machine claim holds, because no Accepted program
// can read one. So the dependency is asserted HERE, where a change to the row makes a claim go red
// instead of leaving a mint silently resting on a contract that moved.
//
// WHAT THIS DOES AND DOES NOT ESTABLISH. It establishes that the row this mint cites still declares
// the range the mint's admission assumes. It does NOT establish that the native realization of
// bytes_octets honours that row -- that is the row's own standing to keep, and the primitive-egress
// census is where it is judged. The claim is the JOIN between the mint's assumption and the
// declared contract, which is the half that was unrecoverable once the annotation was the only
// place the dependency existed.
//
// THIS CLAIM IS LEXICAL AND THAT IS A DECLARED WEAKNESS, NOT AN OVERSIGHT. It matches a substring
// of a prose field, so a reword or a reflow reds it while the declared range is unchanged -- loud
// and false, which is the safe direction, and the row's own annotation warns its editor. The
// structural repair is to carry the range as a modeled field on the census row so the join is
// over a value; that is ENCODING-0's (gunbc#11629, derived by category_owner_lane from the row's
// Encoding category), and its trigger is the row's own declared next observation -- the owning
// lane landing the .dag body, after which bytes_octets is no longer the divergent seam and this
// claim is superseded by a judgment over values rather than spellings.
fn bytes_octets_declared_result() -> String {
  dispositions_text_rows() |> fold(init: "", f: (acc, row) =>
    if row.identity == primitive_identity_slug(name: "bytes_octets") {
      match row.computation {
        PureComputationOverInputs { authority: _, inputs: _, result: declared, body: _ } => declared as String
        NoPureComputationHalf => acc
        ComputationUnestablished { detail: _ } => acc
      }
    } else {
      acc
    })
}

test fn w_the_bytes_octets_row_still_declares_the_range_the_mint_rests_on() -> Bool {
  string_contains(s: bytes_octets_declared_result(), pattern: "0..255")
}

// THE CONTROL THAT KEEPS THE ARM ABOVE FROM PASSING ON AN EMPTY READ. The fold answers "" when no
// row matches, and "" contains no pattern, so a lookup that silently stopped finding the row would
// already red the arm above -- but only for the right reason if the lookup is known to work at all.
// This asserts the row was actually FOUND and carries a pure-computation standing, so a green above
// cannot be a vacuous read of a renamed or restructured row.
test fn w_the_bytes_octets_row_is_found_and_carries_a_declared_result() -> Bool {
  string_length(s: bytes_octets_declared_result()) > 0
}
