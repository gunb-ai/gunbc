module test.claim.runner_service_standing_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn plan_labels(m: RunnerMaterializationStanding, e: RunnerEnablementStanding, a: RunnerActivityStanding, admitted: Bool) -> List<String> {
  match runner_service_plan(
    standing: RunnerServiceStanding { materialization: m, enablement: e, activity: a },
    activation_admitted: admitted,
  ) {
    ServiceActionsPlanned { actions: acts } =>
      map(acts, x => runner_service_action_label(a: x) as String)
    ServicePlanRefused { cause: _ } => ["REFUSED"]
  }
}

// THE TRUTH TABLE. Each row is a state systemd can actually hold, and the three axes are orthogonal,
// so the off-diagonal rows (enabled-but-inactive, disabled-but-active) are ordinary rather than
// exotic -- a single lifecycle enum could not express them at all.
test fn witness_absent_materializes_only() -> Bool {
  plan_labels(m: RunnerAbsent, e: RunnerDisabled, a: RunnerInactive, admitted: true) == ["materialize"]
}

// MATERIALIZATION NEEDS NO ADMISSION: installing files admits no work to the host.
test fn witness_absent_materializes_without_admission() -> Bool {
  plan_labels(m: RunnerAbsent, e: RunnerDisabled, a: RunnerInactive, admitted: false) == ["materialize"]
}

test fn witness_disabled_inactive_enables_then_starts() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerDisabled, a: RunnerInactive, admitted: true)
    == ["enable", "start"]
}

test fn witness_enabled_inactive_starts_only() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerEnabled, a: RunnerInactive, admitted: true) == ["start"]
}

// DISABLED-BUT-ACTIVE IS REAL: a unit started by hand and never enabled. The repair is enable alone,
// and fusing the two actions would restart a runner that is currently serving a job.
test fn witness_disabled_active_enables_only() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerDisabled, a: RunnerActive, admitted: true) == ["enable"]
}

test fn witness_enabled_active_is_converged() -> Bool {
  runner_service_plan_is_converged(
    plan: runner_service_plan(
      standing: RunnerServiceStanding {
        materialization: RunnerMaterialized, enablement: RunnerEnabled, activity: RunnerActive,
      },
      activation_admitted: true,
    ),
  )
}

// ENABLE IS NOT THE HARMLESS HALF. It declares the unit wanted persistently, so it starts again after
// a reboot -- possibly before the cache and pool prerequisites hold. It therefore consumes the same
// admission start does. RED: let EnableRunnerUnit through without admission and this goes false.
test fn witness_enable_requires_activation_admission() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerDisabled, a: RunnerActive, admitted: false) == ["REFUSED"]
}

test fn witness_start_requires_activation_admission() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerEnabled, a: RunnerInactive, admitted: false) == ["REFUSED"]
}

// AN ALREADY-CONVERGED UNIT NEEDS NO ADMISSION, because it plans no action. A gate that refused here
// would make convergence unobservable without a readiness receipt.
test fn witness_converged_needs_no_admission() -> Bool {
  runner_service_plan_is_converged(
    plan: runner_service_plan(
      standing: RunnerServiceStanding {
        materialization: RunnerMaterialized, enablement: RunnerEnabled, activity: RunnerActive,
      },
      activation_admitted: false,
    ),
  )
}

// UNOBSERVED REFUSES RATHER THAN DEFAULTING. An axis nobody measured is not a disabled unit and not
// an inactive one; rendering it as either is the empty-observation narrow -- silently uncovered
// rather than merely expensive.
test fn witness_unobserved_activity_refuses() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerEnabled, a: ActivityUnobserved, admitted: true) == ["REFUSED"]
}

test fn witness_unobserved_materialization_refuses() -> Bool {
  plan_labels(m: MaterializationUnobserved, e: RunnerEnabled, a: RunnerActive, admitted: true) == ["REFUSED"]
}

test fn witness_unobserved_enablement_refuses() -> Bool {
  plan_labels(m: RunnerMaterialized, e: EnablementUnobserved, a: RunnerInactive, admitted: true) == ["REFUSED"]
}

// A FAILED UNIT IS NOT RESTARTED BLIND. Failure has a cause the plan cannot see, so it refuses and
// reports rather than looping the unit.
test fn witness_failed_unit_refuses() -> Bool {
  plan_labels(m: RunnerMaterialized, e: RunnerEnabled, a: RunnerFailed, admitted: true) == ["REFUSED"]
}
