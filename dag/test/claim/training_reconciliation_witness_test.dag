data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn h(s: NonEmptyStr) -> ContentHash {
  content_hash_of_value(value: s)
}

fn ax<T>(v: T) -> AxisResolution<T> {
  AxisResolved { resolved: ResolvedAxis { value: v, receipt: "obs-graph" } }
}

fn dp(n: Nat) -> DropoutPermille? {
  match dropout_permille(permille: n) {
    DropoutPermilleAdmitted { value: v } => Present { value: v }
    DropoutPermilleOutOfRange { offered: _ } => none
  }
}

data fixture_requirements: ExecutionRequirements = ExecutionRequirements {
  shape: Shape {
    hard: HardRequirements { threads: hardware_thread_count(count: 8) },
    envelope: ResourceEnvelope { cpu: none, gpu: none, memory: none, storage: none, network: none },
  },
  capabilities: "linux-arm64",
  trust_domain: "fleet-owned",
  isolation: shared_kernel_sandbox_profile(),
}

fn fixture_observations(d: DropoutPermille) -> TrainingResolutionObservations {
  TrainingResolutionObservations {
    base_artifact: ax(v: h(s: "base-A")),
    dataset_manifest: ax(v: h(s: "dataset-1")),
    tokenizer: ax(v: h(s: "tok-1")),
    chat_template: ax(v: h(s: "tmpl-1")),
    trainer_closure: ax(v: h(s: "trainer-1")),
    target_modules: ax(v: h(s: "qkv")),
    optimizer_config: ax(v: h(s: "adamw-1")),
    scheduler_config: ax(v: h(s: "cosine-1")),
    learning_rate_schedule: ax(v: h(s: "lr-1")),
    rank: ax(v: 16),
    scaling: ax(v: 32),
    dropout_permille: ax(v: d),
    sequence_length: ax(v: 4096),
    packing: ax(v: NoPacking),
    loss_mask: ax(v: MaskPromptTokens),
    mixture: ax(v: h(s: "mix-1")),
    micro_batch: ax(v: 2),
    gradient_accumulation: ax(v: 8),
    numeric_format: ax(v: Bf16),
    seed: ax(v: 7),
    data_order_seed: ax(v: 99),
    checkpoint_format: ax(v: h(s: "ckpt-v1")),
    output_contract: ax(v: h(s: "adapter-out")),
  }
}

fn demand_for(work_key: NonEmptyStr) -> Demand<NonEmptyStr> {
  Demand {
    id: FabricIdentity { principal: "brian", key: "demand-1" },
    work: FabricIdentity { principal: "gunbai", key: work_key },
    origin: "gunbc.observation.training-graph",
    submitted_at: "2026-08-28T00:00:00Z",
    admission: AdmissionTerms {
      deadline: none,
      buy: BuyTerms {
        budget_account: "training",
        currency: Usd,
        reservation_price: money_amount_micro(count: 1),
        maximum_buy_order: money_amount_micro(count: 1000),
      },
    },
    satisfaction: SatisfactionRequirement {
      terminal_receipt_may_satisfy: true,
      new_attempt_required: false,
      step_reuse_permitted: true,
    },
  }
}

fn subject_fixture() -> TrainingRunSubject<NonEmptyStr>? {
  match dp(n: 50) {
    none => none
    Present { value: d } =>
      match resolve_training(observations: fixture_observations(d: d), requirements: fixture_requirements) {
        TrainingResolutionRefused { axis: _, cause: _ } => none
        TrainingResolved { resolved: r } => {
          let k = training_work_for(principal: "gunbai" as NonEmptyStr, resolved: r).id.key
          match admit_training_run_desired(demand: demand_for(work_key: k as NonEmptyStr), resolved: r) {
            TrainingRunDesiredRefused { demand_work: _, resolved_work: _ } => none
            TrainingRunDesiredAdmitted { desired: dd } => Present { value: subject_of_desired(desired: dd) }
          }
        }
      }
  }
}

fn attempt_id(k: NonEmptyStr) -> FabricIdentity<NonEmptyStr, ExecutionAttemptKey> {
  FabricIdentity { principal: "gunbai", key: k }
}

fn attempt_of(
  s: TrainingRunSubject<NonEmptyStr>,
  k: NonEmptyStr,
  lineage: ExecutionAttemptLineage<NonEmptyStr>,
) -> Attempt<NonEmptyStr> {
  Attempt { id: attempt_id(k: k), work: s.work, lineage: lineage, created_at: "2026-08-28T01:00:00Z" }
}

fn initial(s: TrainingRunSubject<NonEmptyStr>, k: NonEmptyStr) -> Attempt<NonEmptyStr> {
  attempt_of(s: s, k: k, lineage: InitialAttempt { initiating_demand: s.demand })
}

fn retry_of(
  s: TrainingRunSubject<NonEmptyStr>,
  k: NonEmptyStr,
  prior: NonEmptyStr,
) -> Attempt<NonEmptyStr> {
  attempt_of(
    s: s,
    k: k,
    lineage: InfrastructureRetry {
      prior_attempt: attempt_id(k: prior),
      cause_receipt: "gunbc.observation.loss",
    },
  )
}

fn escalation_of(
  s: TrainingRunSubject<NonEmptyStr>,
  k: NonEmptyStr,
  prior: NonEmptyStr,
) -> Attempt<NonEmptyStr> {
  attempt_of(
    s: s,
    k: k,
    lineage: CapabilityEscalation {
      prior_attempt: attempt_id(k: prior),
      cause_receipt: "gunbc.observation.exceeded",
    },
  )
}

data digest_a: NonEmptyStr = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data digest_b: NonEmptyStr = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn desired_fixture() -> TrainingRunDesired<NonEmptyStr>? {
  match dp(n: 50) {
    none => none
    Present { value: d } =>
      match resolve_training(observations: fixture_observations(d: d), requirements: fixture_requirements) {
        TrainingResolutionRefused { axis: _, cause: _ } => none
        TrainingResolved { resolved: r } => {
          let k = training_work_for(principal: "gunbai" as NonEmptyStr, resolved: r).id.key
          match admit_training_run_desired(demand: demand_for(work_key: k as NonEmptyStr), resolved: r) {
            TrainingRunDesiredRefused { demand_work: _, resolved_work: _ } => none
            TrainingRunDesiredAdmitted { desired: dd } => Present { value: dd }
          }
        }
      }
  }
}

// TWO ATTEMPTS: an initial one and an infrastructure retry of it. This is the ordinary shape the
// grain witnesses below depend on -- across these two attempts, a failure then a success is
// history, not a contradiction.
fn graph_fixture(s: TrainingRunSubject<NonEmptyStr>) -> TrainingRunAttemptGraph<NonEmptyStr>? {
  match admit_attempt_graph(
    subject: s,
    attempts: [
      Attempt {
        id: attempt_id(k: "e1"),
        work: s.work,
        lineage: InitialAttempt { initiating_demand: s.demand },
        created_at: "2026-08-28T01:00:00Z",
      },
      Attempt {
        id: attempt_id(k: "e2"),
        work: s.work,
        lineage: InfrastructureRetry {
          prior_attempt: attempt_id(k: "e1"),
          cause_receipt: "gunbc.observation.loss",
        },
        created_at: "2026-08-28T02:00:00Z",
      },
    ],
  ) {
    AttemptGraphRefused { first: _, more: _ } => none
    AttemptGraphAdmitted { graph: g } => Present { value: g }
  }
}

fn sweep(s: TrainingRunSubject<NonEmptyStr>) -> TrainingRunReadbackCut<NonEmptyStr> {
  enumerate_processes_and_seal(
    prior: enumerate_checkpoints(
      prior: enumerate_manifests(
        prior: enumerate_outputs(
          prior: enumerate_terminals(started: begin_sweep(subject: s), receipt: "obs.term"),
          receipt: "obs.out",
        ),
        receipt: "obs.manifest",
      ),
      receipt: "obs.ckpt",
    ),
    receipt: "obs.proc",
    composition: "obs.composition",
  )
}

fn observed<T>(members: List<T>, receipt: NonEmptyStr) -> TrainingPopulationObservation<T> {
  TrainingPopulationObserved { members: members, enumeration_receipt: receipt }
}

fn succeeded_at(k: NonEmptyStr) -> TrainingAttemptTerminalReceipt<NonEmptyStr> {
  TrainingAttemptTerminalReceipt {
    attempt: attempt_id(k: k),
    standing: TrainingAttemptSucceeded,
    receipt: "gunbc.observation.term-ok",
  }
}

fn failed_at(k: NonEmptyStr) -> TrainingAttemptTerminalReceipt<NonEmptyStr> {
  TrainingAttemptTerminalReceipt {
    attempt: attempt_id(k: k),
    standing: TrainingAttemptFailed { detail: "node evicted" },
    receipt: "gunbc.observation.term-bad",
  }
}

fn output_at(k: NonEmptyStr, hex: NonEmptyStr) -> TrainingOutputArtifactReceipt<NonEmptyStr> {
  TrainingOutputArtifactReceipt {
    attempt: attempt_id(k: k),
    artifact: Sha256Digest { hex: hex },
    materialization: "spark://checkpoints/adapter",
    receipt: "gunbc.observation.out",
  }
}

fn manifest_at(d: TrainingRunDesired<NonEmptyStr>, k: NonEmptyStr) -> TrainingEffectiveManifestReceipt<NonEmptyStr> {
  TrainingEffectiveManifestReceipt {
    attempt: attempt_id(k: k),
    manifest: resolved_training_manifest(resolved: d.resolved),
    receipt: "gunbc.observation.manifest",
  }
}

fn running_at(k: NonEmptyStr) -> TrainingProcessObservation<NonEmptyStr> {
  TrainingProcessObservation {
    attempt: attempt_id(k: k),
    liveness: TrainingProcessRunning,
    receipt: "gunbc.observation.proc",
  }
}

fn compose(
  d: TrainingRunDesired<NonEmptyStr>,
  processes: TrainingPopulationObservation<TrainingProcessObservation<NonEmptyStr>>,
  terminals: TrainingPopulationObservation<TrainingAttemptTerminalReceipt<NonEmptyStr>>,
  outputs: TrainingPopulationObservation<TrainingOutputArtifactReceipt<NonEmptyStr>>,
  manifests: TrainingPopulationObservation<TrainingEffectiveManifestReceipt<NonEmptyStr>>,
) -> TrainingRunEvidenceComposition<NonEmptyStr>? {
  let s = subject_of_desired(desired: d)
  match graph_fixture(s: s) {
    none => none
    Present { value: g } =>
      match bind_training_run_readback(
        desired: d,
        execution: TrainingSubjectBoundPopulation { subject: s, observation: processes },
        checkpoints: TrainingSubjectBoundPopulation {
          subject: s,
          observation: observed(members: [], receipt: "obs.ckpt"),
        },
        terminals: TrainingSubjectBoundPopulation { subject: s, observation: terminals },
        outputs: TrainingSubjectBoundPopulation { subject: s, observation: outputs },
        effective_manifests: TrainingSubjectBoundPopulation { subject: s, observation: manifests },
      ) {
        TrainingRunReadbackRefused { first: _, more: _ } => none
        TrainingRunReadbackAdmitted { readback: rb } =>
          match admit_training_evidence(desired: d, graph: g, readback: rb, cut: sweep(s: s)) {
            TrainingRunCompositionRefused { first: _, more: _ } => none
            TrainingRunEvidenceComposed { composition: c } => Present { value: c }
          }
      }
  }
}

fn blocker_name(b: TrainingRunBlocker<NonEmptyStr>) -> NonEmptyStr {
  match b {
    TrainingObservationNotAttempted { axis: _, obligation: _ } => "not-attempted"
    TrainingObservationRefused { axis: _, attempt_receipt: _, cause: _ } => "observation-refused"
    TrainingReadbackAttemptOutsideRun { axis: _, attempt: _ } => "attempt-outside-run"
    TrainingAttemptTerminalConflict { attempt: _, succeeded: _, failed: _ } => "terminal-conflict"
    TrainingAttemptOutputConflict { attempt: _, outputs: _ } => "output-conflict"
    TrainingEffectiveManifestMismatch { attempt: _, first_axis: _, more_axes: _ } => "manifest-mismatch"
    TrainingSucceededWithoutObservedOutput { attempt: _, terminal: _ } => "success-without-output"
    TrainingProcessTerminalContradiction { attempt: _, running: _, terminals: _ } => "process-terminal"
    TrainingCompletionAmbiguous { first: _, more: _ } => "completion-ambiguous"
  }
}

fn disposition_name(v: TrainingRunDisposition<NonEmptyStr>) -> NonEmptyStr {
  match v {
    TrainingRunAlreadyConverged { completion: _ } => "converged"
    TrainingRunInProgress { running: _ } => "in-progress"
    TrainingRunExecutionRequired => "execution-required"
    TrainingRunRestartAuthorizationRequired { failed: _ } => "restart-required"
    TrainingRunBlocked { first: _, more: _ } => "blocked"
  }
}

fn blocker_names(v: TrainingRunDisposition<NonEmptyStr>) -> List<NonEmptyStr> {
  match v {
    TrainingRunBlocked { first: f, more: m } =>
      [[blocker_name(b: f)], m.map(b => blocker_name(b: b))].flat_map(x => x)
    TrainingRunAlreadyConverged { completion: _ } => []
    TrainingRunInProgress { running: _ } => []
    TrainingRunExecutionRequired => []
    TrainingRunRestartAuthorizationRequired { failed: _ } => []
  }
}

fn reconcile(c: TrainingRunEvidenceComposition<NonEmptyStr>) -> TrainingRunDisposition<NonEmptyStr> {
  reconcile_training_run(composition: c).disposition
}

// THE GRAIN WITNESS, AND THE ONE AN EARLIER REVISION OF THIS MODULE GOT BACKWARDS. Attempt e1
// failed and attempt e2 succeeded. That is the ordinary local-model-to-Opus escalation history this
// programme exists to record. Reading it as a contradiction -- which a run-grain fold does -- would
// refuse exactly the evidence the escalation model is built to keep.
test fn a_failure_then_a_success_across_two_attempts_is_history_not_a_conflict() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [failed_at(k: "e1"), succeeded_at(k: "e2")], receipt: "obs.term"),
        outputs: observed(members: [output_at(k: "e2", hex: digest_a)], receipt: "obs.out"),
        manifests: observed(members: [manifest_at(d: d, k: "e2")], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } => {
          let v = reconcile(c: c)
          !blocker_names(v: v).any(n => n == "terminal-conflict") && disposition_name(v: v) == "converged"
        }
      }
  }
}

// THE SAME EVIDENCE AT ONE ATTEMPT IS A CONTRADICTION. e1 reports both success and failure: one
// producer emitted two incompatible receipts about one try, and no lineage explains it.
test fn one_attempt_reporting_success_and_failure_is_a_terminal_conflict() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [failed_at(k: "e1"), succeeded_at(k: "e1")], receipt: "obs.term"),
        outputs: observed(members: [output_at(k: "e1", hex: digest_a)], receipt: "obs.out"),
        manifests: observed(members: [manifest_at(d: d, k: "e1")], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } => blocker_names(v: reconcile(c: c)).any(n => n == "terminal-conflict")
      }
  }
}

// TWO ATTEMPTS PRODUCING DIFFERENT ARTIFACTS IS NOT A CONFLICT -- it is two attempts. It becomes
// completion ambiguity only when BOTH qualify as completions, which is a different fact with a
// different name, and the fold must not report it as an output conflict.
test fn different_attempts_with_different_digests_is_not_an_output_conflict() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [succeeded_at(k: "e1"), succeeded_at(k: "e2")], receipt: "obs.term"),
        outputs: observed(
          members: [output_at(k: "e1", hex: digest_a), output_at(k: "e2", hex: digest_b)],
          receipt: "obs.out",
        ),
        manifests: observed(
          members: [manifest_at(d: d, k: "e1"), manifest_at(d: d, k: "e2")],
          receipt: "obs.manifest",
        ),
      ) {
        none => false
        Present { value: c } => {
          let names = blocker_names(v: reconcile(c: c))
          !names.any(n => n == "output-conflict") && names.any(n => n == "completion-ambiguous")
        }
      }
  }
}

// ONE ATTEMPT WITH TWO DIFFERENT DIGESTS IS A CONFLICT, because one try produced one artifact and
// two receipts disagree about which. Same shape as the pair above, one attempt identity apart.
test fn one_attempt_with_two_digests_is_an_output_conflict() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [succeeded_at(k: "e1")], receipt: "obs.term"),
        outputs: observed(
          members: [output_at(k: "e1", hex: digest_a), output_at(k: "e1", hex: digest_b)],
          receipt: "obs.out",
        ),
        manifests: observed(members: [manifest_at(d: d, k: "e1")], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } => blocker_names(v: reconcile(c: c)).any(n => n == "output-conflict")
      }
  }
}

// FIVE SUCCESSFULLY ENUMERATED EMPTY POPULATIONS ARE NOT A CONVERGED RUN. There is no contradiction
// anywhere in this input, which is exactly why an empty blocker population cannot be the test for
// convergence: this is a run nobody has started.
test fn no_blockers_over_empty_populations_requires_execution_rather_than_converging() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [], receipt: "obs.term"),
        outputs: observed(members: [], receipt: "obs.out"),
        manifests: observed(members: [], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } => disposition_name(v: reconcile(c: c)) == "execution-required"
      }
  }
}

// A CUT FROM ANOTHER SWEEP CANNOT ORDER THESE POPULATIONS. The subject matches, the cut is
// well-formed and its sweep really happened -- and its receipts name enumerations that produced
// different populations. Without this join, three receipts agreeing about an attempt identity could
// be collectively about nothing.
test fn a_cut_naming_another_sweeps_receipts_is_refused_per_axis() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } => {
      let s = subject_of_desired(desired: d)
      match graph_fixture(s: s) {
        none => false
        Present { value: g } =>
          match bind_training_run_readback(
            desired: d,
            execution: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "other.proc") },
            checkpoints: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.ckpt") },
            terminals: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.term") },
            outputs: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "other.out") },
            effective_manifests: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.manifest") },
          ) {
            TrainingRunReadbackRefused { first: _, more: _ } => false
            TrainingRunReadbackAdmitted { readback: rb } =>
              match admit_training_evidence(desired: d, graph: g, readback: rb, cut: sweep(s: s)) {
                TrainingRunEvidenceComposed { composition: _ } => false
                TrainingRunCompositionRefused { first: f, more: m } => {
                  let all = [[f], m].flat_map(x => x)
                  all.length() == 2
                    && all.all(r =>
                         match r {
                           CompositionReceiptMismatch { axis: _, cut_receipt: _, readback_receipt: _ } => true
                           CompositionSubjectMismatch { what: _, expected: _, observed: _ } => false
                           CompositionAxisNotAttempted { axis: _ } => false
                         })
                }
              }
          }
      }
    }
  }
}

// A CUT CANNOT CLAIM A STAGE THAT NEVER RAN. An axis nobody enumerated cannot have been part of the
// sweep, so this is a producer reporting work it did not do -- a stronger defect than a receipt
// mismatch, and it gets its own refusal rather than being folded into one.
test fn a_cut_over_a_never_attempted_axis_is_refused() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } => {
      let s = subject_of_desired(desired: d)
      match graph_fixture(s: s) {
        none => false
        Present { value: g } =>
          match bind_training_run_readback(
            desired: d,
            execution: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.proc") },
            checkpoints: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.ckpt") },
            terminals: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.term") },
            outputs: TrainingSubjectBoundPopulation {
              subject: s,
              observation: TrainingPopulationNotAttempted { obligation: "output probe unscheduled" },
            },
            effective_manifests: TrainingSubjectBoundPopulation { subject: s, observation: observed(members: [], receipt: "obs.manifest") },
          ) {
            TrainingRunReadbackRefused { first: _, more: _ } => false
            TrainingRunReadbackAdmitted { readback: rb } =>
              match admit_training_evidence(desired: d, graph: g, readback: rb, cut: sweep(s: s)) {
                TrainingRunEvidenceComposed { composition: _ } => false
                TrainingRunCompositionRefused { first: f, more: _ } =>
                  match f {
                    CompositionAxisNotAttempted { axis: _ } => true
                    CompositionReceiptMismatch { axis: _, cut_receipt: _, readback_receipt: _ } => false
                    CompositionSubjectMismatch { what: _, expected: _, observed: _ } => false
                  }
              }
          }
      }
    }
  }
}

// A RUNNING PROCESS WITH NO TERMINAL IS IN PROGRESS, not a contradiction and not a failure.
test fn a_running_process_with_no_terminal_is_in_progress() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [running_at(k: "e1")], receipt: "obs.proc"),
        terminals: observed(members: [], receipt: "obs.term"),
        outputs: observed(members: [], receipt: "obs.out"),
        manifests: observed(members: [], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } => disposition_name(v: reconcile(c: c)) == "in-progress"
      }
  }
}

// A SUCCEEDED ATTEMPT WITH NO OUTPUT IS A BLOCKER, and it is reportable ONLY because the cut
// establishes that outputs were enumerated after terminals. Without that ordering this is an
// earlier read, not a missing artifact -- which is why the composition is the door.
test fn a_success_with_no_output_under_an_ordered_sweep_is_blocked() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [succeeded_at(k: "e1")], receipt: "obs.term"),
        outputs: observed(members: [], receipt: "obs.out"),
        manifests: observed(members: [manifest_at(d: d, k: "e1")], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } => blocker_names(v: reconcile(c: c)).any(n => n == "success-without-output")
      }
  }
}

// THE POSITIVE CONTROL: one completion candidate, no blockers, converged, and the completion names
// the attempt that produced it. Without this every refusal above would be satisfied by a fold that
// blocked unconditionally.
test fn a_single_clean_completion_converges_and_names_its_attempt() -> Bool {
  match desired_fixture() {
    none => false
    Present { value: d } =>
      match compose(
        d: d,
        processes: observed(members: [], receipt: "obs.proc"),
        terminals: observed(members: [succeeded_at(k: "e1")], receipt: "obs.term"),
        outputs: observed(members: [output_at(k: "e1", hex: digest_a)], receipt: "obs.out"),
        manifests: observed(members: [manifest_at(d: d, k: "e1")], receipt: "obs.manifest"),
      ) {
        none => false
        Present { value: c } =>
          match reconcile(c: c) {
            TrainingRunAlreadyConverged { completion: comp } =>
              comp.attempt.key == "e1" && comp.output.artifact.hex == digest_a
            TrainingRunBlocked { first: _, more: _ } => false
            TrainingRunInProgress { running: _ } => false
            TrainingRunExecutionRequired => false
            TrainingRunRestartAuthorizationRequired { failed: _ } => false
          }
      }
  }
}
