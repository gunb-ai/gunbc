module test.claim.infer_kernel_import_collision_witness

import extdeps.filesystem.filesystem_io
import std.types { String, Bool, Int, List, NonEmptyStr }
import std.decl_ref { decl_ref, decl_field_ref }
import std.literal_elaboration {
  KernelMintDeclaration,
  kernel_named_import_standing,
  KernelNamedImportAdmitted,
  KernelNamedImportCollides,
  KernelNamedImportMintAmbiguous,
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import tools.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  FixtureSource,
  fixture_source,
  compile_fixture,
  fixture_has_class
}
import gunbc.compile_diagnostic_census { CompileDiagnosticCensusRow }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ONE RULE: an authored import of a type that shares a kernel-mint spelling, and is not the
// mint's own declaration, REFUSES at the import (v1.compiler.resolve
// imported_type_collides_with_kernel_mint). Unifying the two lookups would still leave two
// Optional types in the closure; the kernel overlay would keep winning by name and the
// imported declaration would keep winning by interned identity. Refusal is the construction.
//
// THE RED BYTES ARE THE FILES. collision is the corpus declaration
// dag/gunbc/instruments/native_emission_controls_optional_collision.dag. The importer is
// fixtures/native_emission_controls_optional_importer.dag (not a source-root module, so the
// accepted corpus does not violate the wall). This witness reads those files and hands the
// bytes to compile_fixture, so a drift between file and claim is a failed read, not a second
// source (review 76934).

data collision_path: String = "dag/gunbc/instruments/native_emission_controls_optional_collision.dag"
data importer_path: String = "fixtures/native_emission_controls_optional_importer.dag"

fn file_text(path: String) -> String {
  filesystem_read(path: path).content
}

fn file_source(path: String) -> FixtureSource {
  fixture_source(path: path, content: file_text(path: path))
}

data non_kernel_import_source: String = "module probe_kernel_import_ok\n\nimport gunbc.instruments.native_emission_controls_optional_collision \{ collision_seven \}\n\nfn uses_fn() -> Int \{\n  collision_seven()\n\}\n"

data mint_import_source: String = "module probe_kernel_mint_import\n\nimport v2.std.optional \{ Optional \}\n\nfn uses_mint(o: Optional<Int>) -> Int \{\n  match o \{\n    Present \{ value: v \} => v\n    Absent => 0\n  \}\n\}\n"

data mint_decl_source: String = "module v2.std.optional\n\ntype Optional<T>\n  = Absent\n  | Present \{ value: T \}\n"

data collision_class: String = "ImportCollidesWithKernelName"

fn compile_importer() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      file_source(path: collision_path),
      file_source(path: importer_path)
    ],
    entry: importer_path
  })
}

fn compile_non_kernel_import() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      file_source(path: collision_path),
      fixture_source("probe_kernel_import_ok.dag", non_kernel_import_source)
    ],
    entry: "probe_kernel_import_ok.dag"
  })
}

fn compile_mint_import() -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("v2/std/optional.dag", mint_decl_source),
      fixture_source("probe_kernel_mint_import.dag", mint_import_source)
    ],
    entry: "probe_kernel_mint_import.dag"
  })
}

fn outcome_rows(o: MultiModuleCompileFixtureOutcome) -> List<CompileDiagnosticCensusRow>? {
  match o {
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } => Present { value: rows }
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } => Present { value: rows }
    FixtureInstrumentRefused { cause: _ } => none
  }
}

fn outcome_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(rows) == 0 && count(files) > 0 && n > 0,
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false,
    FixtureInstrumentRefused { cause: _ } => false
  }
}

test fn importing_a_non_mint_optional_refuses_at_the_import() -> Bool {
  match outcome_rows(o: compile_importer()) {
    Absent => false
    Present { value: rows } => fixture_has_class(rows: rows, wanted: collision_class)
  }
}

test fn importing_a_non_kernel_name_from_the_same_module_is_accepted() -> Bool {
  outcome_clean(o: compile_non_kernel_import())
}

test fn importing_the_kernel_mint_optional_is_accepted() -> Bool {
  outcome_clean(o: compile_mint_import())
}

fn owner_maybe_mint_rows() -> List<KernelMintDeclaration> {
  [KernelMintDeclaration {
    minted_name: "Optional" as NonEmptyStr,
    declaration: decl_ref(module_path: "owner", decl_name: "Maybe")
  }]
}

test fn a_mint_row_for_owner_maybe_does_not_exempt_importing_owner_optional() -> Bool {
  match kernel_named_import_standing(
    imported_name: "Optional",
    import_path: "owner",
    module_declares_type: true,
    rows: owner_maybe_mint_rows()
  ) {
    KernelNamedImportCollides { kernel_declaration_module: m } => m == "owner"
    KernelNamedImportAdmitted => false
    KernelNamedImportMintAmbiguous { row_count: _ } => false
  }
}

test fn importing_the_mint_declaration_itself_is_admitted() -> Bool {
  match kernel_named_import_standing(
    imported_name: "Optional",
    import_path: "v2.std.optional",
    module_declares_type: true,
    rows: [KernelMintDeclaration {
      minted_name: "Optional" as NonEmptyStr,
      declaration: decl_ref(module_path: "v2.std.optional", decl_name: "Optional")
    }]
  ) {
    KernelNamedImportAdmitted => true
    KernelNamedImportCollides { kernel_declaration_module: _ } => false
    KernelNamedImportMintAmbiguous { row_count: _ } => false
  }
}

test fn a_mint_row_on_a_field_does_not_exempt_the_whole_declaration() -> Bool {
  match kernel_named_import_standing(
    imported_name: "Optional",
    import_path: "owner",
    module_declares_type: true,
    rows: [KernelMintDeclaration {
      minted_name: "Optional" as NonEmptyStr,
      declaration: decl_field_ref(module_path: "owner", decl_name: "Optional", field_name: "value")
    }]
  ) {
    KernelNamedImportCollides { kernel_declaration_module: m } => m == "owner"
    KernelNamedImportAdmitted => false
    KernelNamedImportMintAmbiguous { row_count: _ } => false
  }
}

test fn an_ambiguous_mint_row_set_is_its_own_refusal() -> Bool {
  let doubled = concat(owner_maybe_mint_rows(), owner_maybe_mint_rows())
  match kernel_named_import_standing(
    imported_name: "Optional",
    import_path: "owner",
    module_declares_type: true,
    rows: doubled
  ) {
    KernelNamedImportMintAmbiguous { row_count: n } => n == 2
    KernelNamedImportAdmitted => false
    KernelNamedImportCollides { kernel_declaration_module: _ } => false
  }
}
