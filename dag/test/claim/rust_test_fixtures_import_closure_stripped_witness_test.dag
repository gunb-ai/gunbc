module test.claim.rust_test_fixtures_import_closure_stripped_witness

import extdeps.git
import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.class_b_import_closure_overlay {
  class_b_entry_rel,
  class_b_materialize_stripped_entry_overlay
}
import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  binding_refuses,
  row4_pool_coincidence_or_refuse
}
import std.types { String, Bool, List, NonEmptyStr }

data class_b_stripped_witness_note: String = "Rows 3-4 of the Class B rust_test_fixtures control (#6985). The stripped entry overlay is DERIVED from the live file at execution time (gunbc.class_b_import_closure_overlay), never checked in. Consumed by v2.workflow.class_b_import_closure_transport via source_root_ingest_gate; excluded from hermetic discovery because materialization uses live Filesystem.Read/Write and shell.Mktemp (class_b_stripped_transport_exclusion_note)."

data class_b_consumer_module: String = "v2.extdeps.languages.rust_test"
data class_b_symbol: String = "rust_selection_policy_node"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"
data class_b_overlay_template: String = "/target/class_b_stripped_XXXXXX"

fn observe_class_b_with_overlay(
  pool_roots: List<String>
) -> DeclaredImportClosureBindingObservation {
  observe_declared_import_closure_symbol_binding(
    pool_roots: pool_roots,
    entry_path: class_b_entry_rel,
    consumer_module: class_b_consumer_module,
    symbol: class_b_symbol
  )
}

func observe_class_b_with_derived_stripped_overlay(
  include_perturbation: Bool
) -> DeclaredImportClosureBindingObservation {
  let root = git.Inspect.Toplevel()
  let target = shell.Mkdir.Parents(path: concat(root.path, "/target"))
  if target.success {
    let overlay = shell.Mktemp.DirWithTemplate(
      template: concat(root.path, class_b_overlay_template)
    )
    if overlay.success {
      let materialized = class_b_materialize_stripped_entry_overlay(
        root: root.path,
        overlay_dir: overlay.path
      )
      let pool_roots = if include_perturbation {
        concat([overlay.path, class_b_perturbation_overlay_rel], witness_layer_roots)
      } else {
        concat([overlay.path], witness_layer_roots)
      }
      let observed = if materialized {
        observe_class_b_with_overlay(pool_roots: pool_roots)
      } else {
        BindingNotRunnable { cause: "class_b_materialize_stripped_entry_overlay refused" as NonEmptyStr }
      }
      let cleaned = shell.Remove.RecursiveForce(path: overlay.path)
      if cleaned.success {
        observed
      } else {
        BindingNotRunnable { cause: "class_b overlay cleanup refused" as NonEmptyStr }
      }
    } else {
      BindingNotRunnable { cause: "class_b overlay mktemp refused" as NonEmptyStr }
    }
  } else {
    BindingNotRunnable { cause: "class_b overlay target mkdir refused" as NonEmptyStr }
  }
}

test fn stripped_import_closure_refuses_binding() -> Bool {
  binding_refuses(
    obs: observe_class_b_with_derived_stripped_overlay(include_perturbation: false)
  )
}

test fn stripped_with_ambient_pool_coincidence_or_refuse() -> Bool {
  row4_pool_coincidence_or_refuse(
    obs: observe_class_b_with_derived_stripped_overlay(include_perturbation: true)
  )
}
