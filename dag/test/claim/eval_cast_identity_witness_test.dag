module test.claim.eval_cast_identity

import std.logic { Bool }
import std.types { List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn list_identity(xs: List<Int>) -> List<Int> {
  xs as List<Int>
}

fn int_identity(x: Int) -> Int {
  x as Int
}

test fn list_identity_cast_holds() -> Bool {
  list_identity([1, 2, 3]) == [1, 2, 3]
}

test fn int_identity_cast_holds() -> Bool {
  int_identity(42) == 42
}
