module test.claim.ci_compile_jobs_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

fn join_space(xs: List<String>) -> String {
  fold(xs, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, " "), p) })
}

fn jobs_count_or(d: gunbc.ci_compile_jobs.DerivedCompileJobs, default: Int) -> Int {
  match d {
    gunbc.ci_compile_jobs.CompileJobs { count: c } => c
    gunbc.ci_compile_jobs.CompileJobsRefuse { reason: _ } => default
  }
}

fn jobs_is_refuse(d: gunbc.ci_compile_jobs.DerivedCompileJobs) -> Bool {
  match d {
    gunbc.ci_compile_jobs.CompileJobsRefuse { reason: _ } => true
    gunbc.ci_compile_jobs.CompileJobs { count: _ } => false
  }
}

fn sample_measured() -> gunbc.ci_compile_measurement.CompileJobMeasurement {
  measured_with_pids(p: 4096)
}

fn measured_with_pids(p: Int) -> gunbc.ci_compile_measurement.CompileJobMeasurement {
  gunbc.ci_compile_measurement.CompileJobMeasured { per_rustc_peak: hypothetical_peak(), procs_per_job: 3, pids_budget: p }
}

fn hypothetical_peak() -> std.measure.ByteSize {
  std.measure.byte_size(2100028416)
}

fn live_derived_jobs() -> Int {
  jobs_count_or(
    gunbc.ci_compile_jobs.ci_compile_jobs(memory_budget: gunbc.ci_floor_measurement.gunbc_ci_runner_slot_memory_max_live, force_serial: false),
    0
  )
}

test fn witness_committed_measurement_derives_multi_lane() -> Bool {
  let n = live_derived_jobs()
  n >= 2 && n <= 128
}

test fn witness_committed_lanes_fit_live_slot_cap() -> Bool {
  let n = live_derived_jobs()
  match gunbc.ci_compile_measurement.gunbc_ci_compile_measurement {
    gunbc.ci_compile_measurement.CompileJobMeasured { per_rustc_peak: peak, procs_per_job: _, pids_budget: _ } =>
      n * std.measure.byte_size_count(b: peak) <= std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_runner_slot_memory_max_live)
    gunbc.ci_compile_measurement.CompileJobUnmeasured => false
  }
}

test fn witness_unmeasured_still_refuses() -> Bool {
  jobs_is_refuse(gunbc.ci_compile_jobs.ci_compile_jobs_for(
    measurement: gunbc.ci_compile_measurement.CompileJobUnmeasured,
    hardware_threads: std.measure.hardware_thread_count(128),
    memory_budget: std.measure.byte_size(137438953472),
    force_serial: false
  ))
}

test fn witness_pids_budget_binds_the_count() -> Bool {
  jobs_count_or(
    gunbc.ci_compile_jobs.ci_compile_jobs_for(
      measurement: measured_with_pids(p: 24),
      hardware_threads: std.measure.hardware_thread_count(128),
      memory_budget: std.measure.byte_size(137438953472),
      force_serial: false
    ),
    0
  ) == 8
}

test fn witness_memory_budget_binds_the_count() -> Bool {
  jobs_count_or(
    gunbc.ci_compile_jobs.ci_compile_jobs_for(
      measurement: sample_measured(),
      hardware_threads: std.measure.hardware_thread_count(128),
      memory_budget: std.measure.byte_size(6442450944),
      force_serial: false
    ),
    0
  ) == 2
}

test fn witness_force_serial_overrides_committed_row() -> Bool {
  jobs_count_or(gunbc.ci_compile_jobs.ci_compile_jobs(memory_budget: std.measure.byte_size(137438953472), force_serial: true), 0) == 1
}

test fn witness_force_serial_beats_wide_budget() -> Bool {
  jobs_count_or(
    gunbc.ci_compile_jobs.ci_compile_jobs_for(
      measurement: sample_measured(),
      hardware_threads: std.measure.hardware_thread_count(128),
      memory_budget: std.measure.byte_size(1099511627776),
      force_serial: true
    ),
    0
  ) == 1
}

test fn witness_unreadable_budget_falls_back_serial() -> Bool {
  jobs_count_or(
    gunbc.ci_compile_jobs.ci_compile_jobs_for(
      measurement: sample_measured(),
      hardware_threads: std.measure.hardware_thread_count(128),
      memory_budget: std.measure.byte_size(0),
      force_serial: false
    ),
    0
  ) == 1
}

test fn witness_nextest_flag_spelling() -> Bool {
  join_space(xs: extdeps.cargo_build.cargo_nextest_build_jobs_flag(count: 8)) == "--build-jobs 8"
}

test fn witness_build_flag_spelling() -> Bool {
  join_space(xs: extdeps.cargo_build.cargo_build_jobs_flag(count: 8)) == "--jobs 8"
}

test fn witness_count_or_serial_passes_measured_count() -> Bool {
  gunbc.ci_compile_jobs.compile_jobs_count_or_serial(jobs: gunbc.ci_compile_jobs.CompileJobs { count: 8 }) == 8
}

test fn witness_count_or_serial_refuse_falls_to_serial() -> Bool {
  gunbc.ci_compile_jobs.compile_jobs_count_or_serial(jobs: gunbc.ci_compile_jobs.CompileJobsRefuse { reason: "unmeasured" }) == 1
}

test fn witness_live_rust_gate_uses_slot_budget_lanes() -> Bool {
  let expected = concat("--build-jobs ", to_string(live_derived_jobs()))
  join_space(xs: tools.rust_gates_ci.rust_gate_build_jobs_args()) == expected
}

