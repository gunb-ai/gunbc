module test.claim.ci_compile_jobs_witness


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn join_space(xs: List<String>) -> String {
  fold(xs, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, " "), p) })
}

fn jobs_count_or(d: DerivedCompileJobs, default: Int) -> Int {
  match d {
    CompileJobs { count: c } => c
    CompileJobsRefuse { reason: _ } => default
  }
}

fn jobs_is_refuse(d: DerivedCompileJobs) -> Bool {
  match d {
    CompileJobsRefuse { reason: _ } => true
    CompileJobs { count: _ } => false
  }
}

fn sample_measured() -> CompileJobMeasurement {
  measured_with_pids(p: 4096)
}

fn measured_with_pids(p: Int) -> CompileJobMeasurement {
  CompileJobMeasured { per_rustc_peak: hypothetical_peak(), procs_per_job: 3, pids_budget: p }
}

fn hypothetical_peak() -> ByteSize {
  byte_size(2100028416)
}

fn live_derived_jobs() -> Int {
  jobs_count_or(
    ci_compile_jobs(memory_budget: gunbc_ci_runner_slot_memory_max_live, force_serial: false),
    0
  )
}

fn witness_committed_measurement_derives_multi_lane() -> Bool {
  let n = live_derived_jobs()
  n >= 2 && n <= 128
}

fn witness_committed_lanes_fit_live_slot_cap() -> Bool {
  let n = live_derived_jobs()
  match gunbc_ci_compile_measurement {
    CompileJobMeasured { per_rustc_peak: peak, procs_per_job: _, pids_budget: _ } =>
      n * byte_size_count(b: peak) <= byte_size_count(b: gunbc_ci_runner_slot_memory_max_live)
    CompileJobUnmeasured => false
  }
}

fn witness_unmeasured_still_refuses() -> Bool {
  jobs_is_refuse(ci_compile_jobs_for(
    measurement: CompileJobUnmeasured,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(137438953472),
    force_serial: false
  ))
}

fn witness_pids_budget_binds_the_count() -> Bool {
  jobs_count_or(
    ci_compile_jobs_for(
      measurement: measured_with_pids(p: 24),
      hardware_threads: hardware_thread_count(128),
      memory_budget: byte_size(137438953472),
      force_serial: false
    ),
    0
  ) == 8
}

fn witness_memory_budget_binds_the_count() -> Bool {
  jobs_count_or(
    ci_compile_jobs_for(
      measurement: sample_measured(),
      hardware_threads: hardware_thread_count(128),
      memory_budget: byte_size(6442450944),
      force_serial: false
    ),
    0
  ) == 2
}

fn witness_force_serial_overrides_committed_row() -> Bool {
  jobs_count_or(ci_compile_jobs(memory_budget: byte_size(137438953472), force_serial: true), 0) == 1
}

fn witness_force_serial_beats_wide_budget() -> Bool {
  jobs_count_or(
    ci_compile_jobs_for(
      measurement: sample_measured(),
      hardware_threads: hardware_thread_count(128),
      memory_budget: byte_size(1099511627776),
      force_serial: true
    ),
    0
  ) == 1
}

fn witness_unreadable_budget_falls_back_serial() -> Bool {
  jobs_count_or(
    ci_compile_jobs_for(
      measurement: sample_measured(),
      hardware_threads: hardware_thread_count(128),
      memory_budget: byte_size(0),
      force_serial: false
    ),
    0
  ) == 1
}

fn witness_nextest_flag_spelling() -> Bool {
  join_space(xs: cargo_nextest_build_jobs_flag(count: 8)) == "--build-jobs 8"
}

fn witness_build_flag_spelling() -> Bool {
  join_space(xs: cargo_build_jobs_flag(count: 8)) == "--jobs 8"
}

fn witness_count_or_serial_passes_measured_count() -> Bool {
  compile_jobs_count_or_serial(jobs: CompileJobs { count: 8 }) == 8
}

fn witness_count_or_serial_refuse_falls_to_serial() -> Bool {
  compile_jobs_count_or_serial(jobs: CompileJobsRefuse { reason: "unmeasured" }) == 1
}

fn witness_live_rust_gate_uses_slot_budget_lanes() -> Bool {
  let expected = concat("--build-jobs ", to_string(live_derived_jobs()))
  join_space(xs: rust_gate_build_jobs_args()) == expected
}

test fn ci_compile_jobs_witnesses() -> Bool {
  witness_committed_measurement_derives_multi_lane()
    && witness_committed_lanes_fit_live_slot_cap()
    && witness_unmeasured_still_refuses()
    && witness_pids_budget_binds_the_count()
    && witness_memory_budget_binds_the_count()
    && witness_force_serial_overrides_committed_row()
    && witness_force_serial_beats_wide_budget()
    && witness_unreadable_budget_falls_back_serial()
    && witness_nextest_flag_spelling()
    && witness_build_flag_spelling()
    && witness_count_or_serial_passes_measured_count()
    && witness_count_or_serial_refuse_falls_to_serial()
    && witness_live_rust_gate_uses_slot_budget_lanes()
}
