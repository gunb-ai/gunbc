module test.claim.uri_grounding_witness
import extdeps.uri {
  Uri,
  Https,
  uri_is_url,
  uri_wire,
}
import std.bit { Bool }
import v2.std.live_tree {
  LiveTreeDisposition,
  SubstrateInputsOnly,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_uri_requires_scheme_and_locator() -> Bool {
  let uri = Uri { scheme: Https, locator: "api.example.com" }
  uri_is_url(uri: uri)
}

test fn w_uri_wire_reconstructs_url() -> Bool {
  let uri = Uri { scheme: Https, locator: "api.github.com" }
  uri_wire(uri: uri) == "https://api.github.com"
}

test fn w_nonempty_str_html_url_holds() -> Bool {
  let url = "https://github.com/gunb-ai/gunbc/pull/1"
  string_contains(url, pattern: "github.com")
}

