module test.claim.uri_grounding_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn w_uri_requires_scheme_and_locator() -> Bool {
  let uri = extdeps.uri.Uri { scheme: extdeps.uri.Https, locator: "api.example.com" }
  extdeps.uri.uri_is_url(uri: uri)
}

test fn w_uri_wire_reconstructs_url() -> Bool {
  let uri = extdeps.uri.Uri { scheme: extdeps.uri.Https, locator: "api.github.com" }
  extdeps.uri.uri_wire(uri: uri) == "https://api.github.com"
}

test fn w_nonempty_str_html_url_holds() -> Bool {
  let url = "https://github.com/gunb-ai/gunbc/pull/1"
  string_contains(url, pattern: "github.com")
}

// Local since the falsifier witness that used to declare it was deleted with the CI wipe
// (2026-08-15). One line over one builtin: a cross-test import for this is a dependency on
// another witness's incidental helper, not on a shared authority.
fn string_contains(s: String, pattern: String) -> Bool {
  s.contains(pattern)
}
