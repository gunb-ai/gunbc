module test.claim.ci_runner_seam_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_ci_runner_spec_derives_from_fleet_offer() -> Bool {
  gunbc.runner_spec_from_offer.gunbc_ci_runner_spec() == gunbc.runner_spec_from_offer.runner_spec_from_offer(offer: gunbc.ci_fleet.gunbc_ci_fleet_offer)
}

fn witness_ci_workflow_runner_matches_selected_target() -> Bool {
  gunbc.ci_workflow.ci_workflow.jobs.first().runner == gunbc.ci_runner_target.gunbc_ci_selected_runner_spec()
}

fn witness_ci_yaml_runs_on_projects_selected_labels() -> Bool {
  let yaml = gunbc.ci_yaml_emit.expected_ci_yml()
  string_contains(s: yaml, pattern: "    runs-on: [self-hosted, linux, arm64]")
    && !string_contains(s: yaml, pattern: "    runs-on: [ubicloud-standard-16-arm]")
}

fn witness_ci_runner_spec_is_self_hosted_arm64_linux() -> Bool {
  match gunbc.runner_spec_from_offer.gunbc_ci_runner_spec() {
    extdeps.github.actions.SelfHosted { labels: ls } =>
      ls.length() == 3
        && ls.first() == "self-hosted"
        && ls.skip(n: 1).first() == "linux"
        && ls.skip(n: 2).first() == "arm64"
    _ => false
  }
}

fn witness_selected_target_is_operator_fleet_routing() -> Bool {
  gunbc.ci_runner_target.gunbc_ci_selected_runner_spec() == gunbc.runner_spec_from_offer.gunbc_ci_runner_spec()
}

test fn ci_runner_seam_holds() -> Bool {
  witness_selected_target_is_operator_fleet_routing()
    && witness_ci_runner_spec_derives_from_fleet_offer()
    && witness_ci_workflow_runner_matches_selected_target()
    && witness_ci_yaml_runs_on_projects_selected_labels()
    && witness_ci_runner_spec_is_self_hosted_arm64_linux()
}
