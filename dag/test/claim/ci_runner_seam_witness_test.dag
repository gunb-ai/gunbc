module test.claim.ci_runner_seam_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn witness_ci_runner_spec_derives_from_fleet_offer() -> Bool {
  gunbc_ci_runner_spec() == runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}

test fn witness_ci_workflow_runner_matches_selected_target() -> Bool {
  ci_workflow.jobs.first().runner == gunbc_ci_selected_runner_spec()
}

test fn witness_ci_yaml_runs_on_projects_selected_labels() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "    runs-on: [self-hosted, linux, arm64]")
    && !string_contains(s: yaml, pattern: "    runs-on: [ubicloud-standard-16-arm]")
}

test fn witness_ci_runner_spec_is_self_hosted_arm64_linux() -> Bool {
  match gunbc_ci_runner_spec() {
    SelfHosted { labels: ls } =>
      ls.length() == 3
        && ls.first() == "self-hosted"
        && ls.skip(n: 1).first() == "linux"
        && ls.skip(n: 2).first() == "arm64"
    _ => false
  }
}

test fn witness_selected_target_is_operator_fleet_routing() -> Bool {
  gunbc_ci_selected_runner_spec() == gunbc_ci_runner_spec()
}

