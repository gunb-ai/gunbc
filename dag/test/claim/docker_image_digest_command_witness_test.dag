module test.claim.docker_image_digest_command_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.exec.command { argv_words }
import extdeps.docker.cli { docker_image_digest_command, docker_image_inspect_id_command }
import gunbc.typed_argv_exec { typed_argv_shell_safe_refusal_argv }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data digest_pinned_fixture: NonEmptyStr = "example.invalid/repo:tag@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr
data tagged_fixture: NonEmptyStr = "example.invalid/repo:tag" as NonEmptyStr

fn argv_has_exact_word(words: List<String>, want: String) -> Bool {
  fold(words, init: false, f: (acc, w) => acc || w == want)
}

fn digest_listing_words(image: NonEmptyStr) -> List<String> {
  argv_words(command: docker_image_digest_command(image: image))
}

fn inspect_id_words(image: NonEmptyStr) -> List<String> {
  argv_words(command: docker_image_inspect_id_command(image: image))
}

// THE RED: a digest-pinned identity is inspect, not docker images' REPOSITORY[:TAG] match.
test fn a_digest_pinned_identity_readback_inspects_the_digest_reference() -> Bool {
  let image = digest_pinned_fixture
  let words = inspect_id_words(image: image)
  argv_has_exact_word(words: words, want: "inspect")
    && argv_has_exact_word(words: words, want: "--format")
    && argv_has_exact_word(words: words, want: image as String)
    && !argv_has_exact_word(words: words, want: "images")
    && string_contains(s: image as String, pattern: "@sha256:")
}

// THE TAGGED CONTROL: converge_vllm_image still lists; absence stays empty stdout / exit 0.
test fn a_tagged_identity_readback_still_lists() -> Bool {
  let tag = tagged_fixture
  let words = digest_listing_words(image: tag)
  argv_has_exact_word(words: words, want: "images")
    && argv_has_exact_word(words: words, want: "--quiet")
    && argv_has_exact_word(words: words, want: "--no-trunc")
    && argv_has_exact_word(words: words, want: tag as String)
    && !argv_has_exact_word(words: words, want: "inspect")
    && !string_contains(s: tag as String, pattern: "@sha256:")
    && match typed_argv_shell_safe_refusal_argv(argv: words) {
      Absent => true
      Present { value: _ } => false
    }
}

// THE DIGEST ARM IS REFUSED ON typed_argv_exec. spark_remote_run quotes and is the executing path
// (fleet-converge 34643985099). Omitting this check would cite the working transport while the
// other stayed silent (DESIGN §4b(1)).
test fn a_digest_inspect_argv_is_refused_on_typed_argv_exec() -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: inspect_id_words(image: digest_pinned_fixture)) {
    Present { value: why } => string_contains(s: why, pattern: "allowlist")
    Absent => false
  }
}
