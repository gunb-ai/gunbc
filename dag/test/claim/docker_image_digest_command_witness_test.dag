module test.claim.docker_image_digest_command_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.languages.json.emit {
  json_array, json_object, json_kv, json_string, serialize_json,
}
import extdeps.exec.command { argv_words }
import extdeps.docker.cli {
  docker_binary_path,
  docker_image_digest_command, docker_image_inspect_command,
  docker_image_inspect_id_from_stdout, DockerImageInspectId, DockerImageInspectIdUnreadable,
  docker_image_inspect_names_no_such_image,
}
import gunbc.typed_argv_exec { typed_argv_shell_safe_refusal_argv }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data digest_pinned_fixture: NonEmptyStr = "example.invalid/repo:tag@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr
data tagged_fixture: NonEmptyStr = "example.invalid/repo:tag" as NonEmptyStr
data inspect_id_fixture: NonEmptyStr = "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" as NonEmptyStr

fn argv_has_exact_word(words: List<String>, want: String) -> Bool {
  fold(words, init: false, f: (acc, w) => acc || w == want)
}

fn digest_listing_words(image: NonEmptyStr) -> List<String> {
  argv_words(command: docker_image_digest_command(image: image))
}

fn inspect_words(image: NonEmptyStr) -> List<String> {
  argv_words(command: docker_image_inspect_command(image: image))
}

fn inspect_argv_is_portable(image: NonEmptyStr) -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: inspect_words(image: image)) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE RED: a digest-pinned identity is exactly `docker image inspect <ref>` — no Go template.
test fn a_digest_pinned_identity_readback_inspects_the_digest_reference() -> Bool {
  let image = digest_pinned_fixture
  let words = inspect_words(image: image)
  words == [docker_binary_path as String, "image", "inspect", image as String]
    && inspect_argv_is_portable(image: image)
    && string_contains(s: image as String, pattern: "@sha256:")
}

// THE TAGGED CONTROL: converge_vllm_image still lists; absence stays empty stdout / exit 0.
test fn a_tagged_identity_readback_still_lists() -> Bool {
  let tag = tagged_fixture
  let words = digest_listing_words(image: tag)
  words == [docker_binary_path as String, "images", "--no-trunc", "--quiet", tag as String]
    && !string_contains(s: tag as String, pattern: "@sha256:")
    && match typed_argv_shell_safe_refusal_argv(argv: words) {
      Absent => true
      Present { value: _ } => false
    }
}

fn inspect_id_json_document() -> String {
  serialize_json(v: json_array(elements: [
    json_object(members: [json_kv(key: "Id", value: json_string(s: inspect_id_fixture as String))]),
  ]))
}

// THE Id IS READ FROM INSPECT JSON, not from a --format template.
test fn inspect_stdout_json_yields_the_unique_id() -> Bool {
  match docker_image_inspect_id_from_stdout(stdout: inspect_id_json_document()) {
    DockerImageInspectId { id: id } => id == inspect_id_fixture
    DockerImageInspectIdUnreadable { cause: _ } => false
  }
}

test fn inspect_stdout_that_is_not_one_object_is_unreadable() -> Bool {
  match docker_image_inspect_id_from_stdout(stdout: "[]") {
    DockerImageInspectIdUnreadable { cause: why } => string_contains(s: why, pattern: "one-element")
    DockerImageInspectId { id: _ } => false
  }
}

test fn inspect_stderr_no_such_image_is_the_absent_classifier() -> Bool {
  docker_image_inspect_names_no_such_image(stderr: "Error: No such image: example.invalid/repo:tag")
    && !docker_image_inspect_names_no_such_image(stderr: "Error: connection refused")
}
