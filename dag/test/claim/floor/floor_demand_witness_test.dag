module test.claim.floor_demand_witness_test

import std.types { Bool, String, List, Int }
import std.measure { byte_size, byte_size_count, gibibyte, gibibyte_to_byte_size, second, second_count }
import extdeps.toolchain.types { Aarch64, X86_64 }
import gunbc.floor_demand {
  FloorRunCgroupPeakReceipt, FloorRunCgroupPeakMeasured, FloorRunCgroupPeakUnmeasured,
  floor_peak_reading_kind, UncensoredPeak, ThrottlePin, PeakUnmeasured,
  floor_cgroup_charge_ceiling, gunbc_floor_cgroup_charge_ceiling,
  FloorNonReclaimableStanding, NonReclaimableUnmeasured, NonReclaimableMeasured, FloorNonReclaimableReceipt, FloorNonReclaimableBeat,
  floor_memory_requirement_of, gunbc_floor_non_reclaimable_standing, gunbc_floor_non_reclaimable_receipt_2026_09_19,
  gunbc_floor_uncensored_demand_receipt, gunbc_floor_throttle_pin_receipt_2026_09_19,
  gunbc_floor_measured_peak_observation, gunbc_floor_measured_peak_is_uncensored,
  floor_storage_requirement,
  StorageComponentReceipt, storage_components_total, round_up_to_gibibyte_grain,
  gunbc_floor_storage_components, gunbc_floor_job_wall_receipt_2026_09_19,
}
import gunbc.fabric_witness_run { floor_execution_requirements }
import gunbc.runner_slot_allocation { gunbc_runner_slot_desired }

fn receipt(peak: Int, high: Int) -> FloorRunCgroupPeakReceipt {
  FloorRunCgroupPeakMeasured {
    run_id: "fixture",
    runner_unit: "fixture",
    cgroup_peak: byte_size(peak),
    armed_memory_high: byte_size(high),
    floor_outcome: "FloorClean",
  }
}

// THE KIND IS DECIDED BY THE PEAK AGAINST THE LINE IT WAS TAKEN UNDER, in both directions, with
// the boundary on the pin side: a peak exactly at its line was being held there.
test fn a_peak_under_its_line_is_uncensored_and_a_peak_at_or_over_it_is_a_pin() -> Bool {
  let under = match floor_peak_reading_kind(receipt: receipt(peak: 99, high: 100)) {
    UncensoredPeak { peak: p } => byte_size_count(b: p) == 99
    _ => false
  }
  let at = match floor_peak_reading_kind(receipt: receipt(peak: 100, high: 100)) {
    ThrottlePin { peak: _, armed_line: l } => byte_size_count(b: l) == 100
    _ => false
  }
  let over = match floor_peak_reading_kind(receipt: receipt(peak: 106, high: 100)) {
    ThrottlePin { peak: p, armed_line: _ } => byte_size_count(b: p) == 106
    _ => false
  }
  let unmeasured = match floor_peak_reading_kind(receipt: FloorRunCgroupPeakUnmeasured) {
    PeakUnmeasured => true
    _ => false
  }
  under && at && over && unmeasured
}

// THE CHARGE CEILING IS THE LARGEST PEAK, PINS INCLUDED, AND AN UNMEASURED RECEIPT CONTRIBUTES
// ZERO RATHER THAN REFUSING THE FOLD: absence of a reading is not a charge.
test fn the_charge_ceiling_is_the_largest_peak_across_receipts() -> Bool {
  byte_size_count(b: floor_cgroup_charge_ceiling(receipts: [
    receipt(peak: 7, high: 100),
    FloorRunCgroupPeakUnmeasured,
    receipt(peak: 42, high: 40),
    receipt(peak: 9, high: 100),
  ])) == 42
    && byte_size_count(b: floor_cgroup_charge_ceiling(receipts: [] as List<FloorRunCgroupPeakReceipt>)) == 0
}

// THE PRODUCTION ROWS: the sizing input is the uncensored receipt's peak and is classified
// uncensored; the charge ceiling is the 2026-09-19 pin's peak, which is the larger.
test fn the_charge_ceiling_is_the_pin_and_the_sizing_input_is_the_uncensored_receipt() -> Bool {
  let sizing_input_kind = match floor_peak_reading_kind(receipt: gunbc_floor_uncensored_demand_receipt) {
    UncensoredPeak { peak: p } => byte_size_count(b: p) == byte_size_count(b: gunbc_floor_measured_peak_observation)
    _ => false
  }
  let ceiling_is_the_pin = match floor_peak_reading_kind(receipt: gunbc_floor_throttle_pin_receipt_2026_09_19) {
    ThrottlePin { peak: p, armed_line: _ } =>
      byte_size_count(b: p) == byte_size_count(b: gunbc_floor_cgroup_charge_ceiling())
        && byte_size_count(b: p) > byte_size_count(b: gunbc_floor_measured_peak_observation)
    _ => false
  }
  gunbc_floor_measured_peak_is_uncensored() && sizing_input_kind && ceiling_is_the_pin
}

// THE WORK'S MEMORY REQUIREMENT IS THE NON-RECLAIMABLE PEAK AND NOTHING WHILE THAT PEAK IS
// UNMEASURED. Both arms driven: an unmeasured standing yields no requirement, a fixture receipt
// yields its peak exactly, and the Work's envelope carries whatever the production standing
// yields -- so the route from standing to Work is executed in either state.
test fn the_work_memory_requirement_is_the_non_reclaimable_peak_or_absent() -> Bool {
  let unmeasured = match floor_memory_requirement_of(standing: NonReclaimableUnmeasured { instrument: "fixture" }) {
    Absent => true
    Present { value: _ } => false
  }
  let measured = match floor_memory_requirement_of(
    standing: NonReclaimableMeasured {
      receipt: FloorNonReclaimableReceipt {
        run_id: "fixture",
        runner_unit: "fixture",
        beat_cadence: second(count: 60),
        beats_sampled: 10,
        peak: FloorNonReclaimableBeat { beat: 2, nonreclaimable: byte_size(1000), file: byte_size(500), charge: byte_size(1500), stall_faults_per_minute: 9 },
        last_unstalled: FloorNonReclaimableBeat { beat: 1, nonreclaimable: byte_size(900), file: byte_size(700), charge: byte_size(1600), stall_faults_per_minute: 0 },
        run_completed: true,
      },
    },
  ) {
    Absent => false
    Present { value: m } => byte_size_count(b: m.min_bytes) == 1000
  }
  let work_carries_the_standing = match gunbc_floor_non_reclaimable_standing() {
    NonReclaimableUnmeasured { instrument: _ } =>
      match floor_execution_requirements().shape.envelope.memory {
        Absent => true
        Present { value: _ } => false
      }
    NonReclaimableMeasured { receipt: r } =>
      match floor_execution_requirements().shape.envelope.memory {
        Absent => false
        Present { value: m } => byte_size_count(b: m.min_bytes) == byte_size_count(b: r.peak.nonreclaimable)
      }
  }
  unmeasured && measured && work_carries_the_standing
}

// THE PRODUCTION RECEIPT IS WHAT THE INSTRUMENT SAID AND IS HONEST ABOUT ITS GRAIN: a partial run
// on the fleet's slot row, the non-reclaimable partition the whole of the charge (cache reclaimed
// to under 1 percent of it), and the partition within the cell's memory_max -- the fact that
// makes the host slot able to hold the floor at all.
test fn the_production_receipt_is_a_partial_run_whose_partition_was_the_whole_charge() -> Bool {
  let r = gunbc_floor_non_reclaimable_receipt_2026_09_19
  !r.run_completed
    && r.beats_sampled > 0
    && byte_size_count(b: r.peak.file) * 100 < byte_size_count(b: r.peak.charge)
    && byte_size_count(b: r.peak.nonreclaimable) <= byte_size_count(b: r.peak.charge)
    && byte_size_count(b: r.peak.nonreclaimable) <= byte_size_count(b: gunbc_runner_slot_desired().memory_max)
    && r.last_unstalled.beat < r.peak.beat
    && r.last_unstalled.stall_faults_per_minute == 0
    && r.peak.stall_faults_per_minute > 0
}

// THE PIN WAS TAKEN UNDER THE CURRENT ROW, which is what makes it a finding about the row rather
// than about a line that no longer exists.
test fn the_pin_receipt_was_armed_at_the_declared_throttle_line() -> Bool {
  match gunbc_floor_throttle_pin_receipt_2026_09_19 {
    FloorRunCgroupPeakMeasured { run_id: _, runner_unit: _, cgroup_peak: _, armed_memory_high: h, floor_outcome: _ } =>
      byte_size_count(b: h) == byte_size_count(b: gunbc_runner_slot_desired().memory_high)
    FloorRunCgroupPeakUnmeasured => false
  }
}

test fn gibibyte_grain_rounds_up_and_leaves_a_whole_gibibyte_alone() -> Bool {
  let g = byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 1)))
  byte_size_count(b: round_up_to_gibibyte_grain(bytes: byte_size(1))) == g
    && byte_size_count(b: round_up_to_gibibyte_grain(bytes: byte_size(g))) == g
    && byte_size_count(b: round_up_to_gibibyte_grain(bytes: byte_size(g + 1))) == 2 * g
    && byte_size_count(b: round_up_to_gibibyte_grain(bytes: byte_size(0))) == 0
}

// THE STORAGE FIGURE IS THE ROUNDED SUM OF ITS COMPONENTS, two of which are foreign-architecture
// proxies; the sum is under two gibibytes and the requirement is exactly two, which is the grain
// doing its job rather than a number chosen.
test fn the_floor_storage_requirement_is_the_rounded_component_sum() -> Bool {
  let total = storage_components_total(components: gunbc_floor_storage_components)
  let two = byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 2)))
  byte_size_count(b: floor_storage_requirement().min_bytes) == byte_size_count(b: round_up_to_gibibyte_grain(bytes: total))
    && byte_size_count(b: total) < two
    && byte_size_count(b: floor_storage_requirement().min_bytes) == two
    && any(gunbc_floor_storage_components, c => component_measured_on_x86_64(c: c))
    && any(gunbc_floor_storage_components, c => component_measured_on_aarch64(c: c))
}

fn component_measured_on_x86_64(c: StorageComponentReceipt) -> Bool {
  match c.measured_on {
    X86_64 => true
    _ => false
  }
}

fn component_measured_on_aarch64(c: StorageComponentReceipt) -> Bool {
  match c.measured_on {
    Aarch64 => true
    _ => false
  }
}

test fn the_warm_wall_receipt_is_a_warm_reading_under_the_lane_timeout() -> Bool {
  gunbc_floor_job_wall_receipt_2026_09_19.sccache_reachable
    && second_count(gunbc_floor_job_wall_receipt_2026_09_19.build_step_wall)
      < second_count(gunbc_floor_job_wall_receipt_2026_09_19.whole_job_wall)
}
