module test.claim.floor_demand_witness_test

import std.types { Bool, String, List, Int }
import std.measure { byte_size, byte_size_count, gibibyte, gibibyte_to_byte_size, second, second_count, events_per_minute, events_per_minute_count, MeasureDifference, MeasureSubtrahendExceedsMinuend, GrainRounded, GrainUnrepresentable }
import std.checked_arithmetic { int_inclusive_max, CheckedIntReady, CheckedIntOverflow }
import extdeps.toolchain.types { Aarch64, X86_64 }
import gunbc.floor_demand {
  FloorRunCgroupPeakReceipt, FloorRunCgroupPeakMeasured, FloorRunCgroupPeakUnmeasured,
  floor_peak_reading_kind, UncensoredPeak, ThrottlePin, PeakUnmeasured,
  floor_cgroup_charge_ceiling, gunbc_floor_cgroup_charge_ceiling,
  FloorHeldSetStanding, HeldSetUnmeasured, HeldSetMeasured, FloorHeldSetReceipt, FloorMemoryStatBeat,
  beat_held_set, beat_reclaimable_cache, receipt_peak_beat, receipt_last_unstalled_beat, receipt_held_set_peak,
  floor_memory_requirement_of, gunbc_floor_held_set_standing, gunbc_floor_memory_stat_receipt_2026_09_19,
  gunbc_floor_uncensored_demand_receipt, gunbc_floor_throttle_pin_receipt_2026_09_19,
  gunbc_floor_measured_peak_observation, gunbc_floor_measured_peak_is_uncensored,
  floor_storage_demand, StorageDemandStated, StorageDemandUnrepresentable, held_set_standing_of,
  HeldSetPeakAt, HeldSetPeakNoBeats, HeldSetPeakUnrepresentable,
  HeldSetReceiptUnrepresentable,
  StorageComponentReceipt, storage_components_total, round_up_to_gibibyte_grain,
  gunbc_floor_storage_components, gunbc_floor_job_wall_receipt_2026_09_19,
  FloorSeam, SeamStrictPreparation, SeamClaimEvaluationFold, SeamNotYetEntered, SeamUnrecorded,
  receipt_peak_seam, PeakAttributedTo, PeakSeamUnattributable,
  PeakUnattributableCause, PeakBeatSampledBeforeAnySeam, PeakBeatSeamUnrecorded, ReceiptHasNoBeats, ReceiptTorn,
  gunbc_floor_memory_stat_receipt_2026_09_21, receipt_peak_reading_standing, PeakReadingStanding,
  PeakIsDemand, PeakIsLowerBound, PeakUnreadable, PeakLowerBoundCause, RunDidNotComplete,
  PeakBeatWasStalling, SwapCouldAbsorbAnonymousPages, SwapPolicyIsRead,
  RunSwapPolicy, SwapMaxRead, SwapMaxDeclaredUnread, SwapDisabled,
}
import gunbc.fabric_witness_run { floor_execution_requirements }
import gunbc.runner_slot_allocation { gunbc_runner_slot_desired }

fn receipt(peak: Int, high: Int) -> FloorRunCgroupPeakReceipt {
  FloorRunCgroupPeakMeasured {
    run_id: "fixture",
    runner_unit: "fixture",
    cgroup_peak: byte_size(peak),
    armed_memory_high: byte_size(high),
    floor_outcome: "FloorClean",
  }
}

// THE KIND IS DECIDED BY THE PEAK AGAINST THE LINE IT WAS TAKEN UNDER, in both directions, with
// the boundary on the pin side: a peak exactly at its line was being held there.
test fn a_peak_under_its_line_is_uncensored_and_a_peak_at_or_over_it_is_a_pin() -> Bool {
  let under = match floor_peak_reading_kind(receipt: receipt(peak: 99, high: 100)) {
    UncensoredPeak { peak: p } => byte_size_count(b: p) == 99
    _ => false
  }
  let at = match floor_peak_reading_kind(receipt: receipt(peak: 100, high: 100)) {
    ThrottlePin { peak: _, armed_line: l } => byte_size_count(b: l) == 100
    _ => false
  }
  let over = match floor_peak_reading_kind(receipt: receipt(peak: 106, high: 100)) {
    ThrottlePin { peak: p, armed_line: _ } => byte_size_count(b: p) == 106
    _ => false
  }
  let unmeasured = match floor_peak_reading_kind(receipt: FloorRunCgroupPeakUnmeasured) {
    PeakUnmeasured => true
    _ => false
  }
  under && at && over && unmeasured
}

// THE CHARGE CEILING IS THE LARGEST PEAK, PINS INCLUDED, AND AN UNMEASURED RECEIPT CONTRIBUTES
// ZERO RATHER THAN REFUSING THE FOLD: absence of a reading is not a charge.
test fn the_charge_ceiling_is_the_largest_peak_across_receipts() -> Bool {
  byte_size_count(b: floor_cgroup_charge_ceiling(receipts: [
    receipt(peak: 7, high: 100),
    FloorRunCgroupPeakUnmeasured,
    receipt(peak: 42, high: 40),
    receipt(peak: 9, high: 100),
  ])) == 42
    && byte_size_count(b: floor_cgroup_charge_ceiling(receipts: [] as List<FloorRunCgroupPeakReceipt>)) == 0
}

// THE PRODUCTION ROWS: the sizing input is the uncensored receipt's peak and is classified
// uncensored; the charge ceiling is the 2026-09-19 pin's peak, which is the larger.
test fn the_charge_ceiling_is_the_pin_and_the_sizing_input_is_the_uncensored_receipt() -> Bool {
  let sizing_input_kind = match floor_peak_reading_kind(receipt: gunbc_floor_uncensored_demand_receipt) {
    UncensoredPeak { peak: p } => byte_size_count(b: p) == byte_size_count(b: gunbc_floor_measured_peak_observation)
    _ => false
  }
  let ceiling_is_the_pin = match floor_peak_reading_kind(receipt: gunbc_floor_throttle_pin_receipt_2026_09_19) {
    ThrottlePin { peak: p, armed_line: _ } =>
      byte_size_count(b: p) == byte_size_count(b: gunbc_floor_cgroup_charge_ceiling())
        && byte_size_count(b: p) > byte_size_count(b: gunbc_floor_measured_peak_observation)
    _ => false
  }
  gunbc_floor_measured_peak_is_uncensored() && sizing_input_kind && ceiling_is_the_pin
}

// THE WORK'S MEMORY REQUIREMENT IS THE HELD-SET PEAK AND NOTHING WHILE THAT PEAK IS
// UNMEASURED. Both arms driven: an unmeasured standing yields no requirement, a fixture receipt
// yields its peak exactly, and the Work's envelope carries whatever the production standing
// yields -- so the route from standing to Work is executed in either state.
test fn the_work_memory_requirement_is_the_held_set_peak_or_absent() -> Bool {
  let unmeasured = match floor_memory_requirement_of(standing: HeldSetUnmeasured { instrument: "fixture" }) {
    Absent => true
    Present { value: _ } => false
  }
  let measured = match floor_memory_requirement_of(
    standing: held_set_standing_of(receipt: fixture_receipt(), instrument: "fixture"),
  ) {
    Absent => false
    Present { value: m } => byte_size_count(b: m.min_bytes) == 1000
  }
  let work_carries_the_standing = match gunbc_floor_held_set_standing() {
    HeldSetUnmeasured { instrument: _ } =>
      match floor_execution_requirements().shape.envelope.memory {
        Absent => true
        Present { value: _ } => false
      }
    HeldSetReceiptUnrepresentable { cause: _ } => false
    HeldSetMeasured { receipt: _, peak: v } =>
      match floor_execution_requirements().shape.envelope.memory {
        Absent => false
        Present { value: m } => byte_size_count(b: m.min_bytes) == byte_size_count(b: v)
      }
  }
  unmeasured && measured && work_carries_the_standing
}

fn beat(n: Int, anon: Int, file: Int, shmem: Int, unevictable: Int, stall: Int) -> FloorMemoryStatBeat {
  seamed_beat(n: n, seam: SeamUnrecorded, anon: anon, file: file, shmem: shmem, unevictable: unevictable, stall: stall)
}

fn seamed_beat(n: Int, seam: FloorSeam, anon: Int, file: Int, shmem: Int, unevictable: Int, stall: Int) -> FloorMemoryStatBeat {
  FloorMemoryStatBeat {
    beat: n, seam: seam, charge: byte_size(anon + file + 10),
    anon: byte_size(anon), file: byte_size(file), shmem: byte_size(shmem), unevictable: byte_size(unevictable),
    slab_unreclaimable: byte_size(4), slab_reclaimable: byte_size(1000), kernel_stack: byte_size(3),
    pagetables: byte_size(2), percpu: byte_size(1), sock: byte_size(0), file_dirty: byte_size(0),
    stall: events_per_minute(count: stall),
  }
}

// A FIXTURE RUN OF THREE BEATS: beat 1 unstalled with a large cache, beat 2 the held-set peak and
// stalling, beat 3 falling back. Held set at beat 2 = 900 + 90 + 4 + 3 + 2 + 1 + 0 = 1000.
fn fixture_receipt() -> FloorHeldSetReceipt {
  FloorHeldSetReceipt {
    run_id: "fixture",
    runner_unit: "fixture",
    beat_cadence: second(count: 60),
    beats_sampled: 3,
    beats: [
      beat(n: 1, anon: 800, file: 700, shmem: 50, unevictable: 0, stall: 0),
      beat(n: 2, anon: 900, file: 100, shmem: 90, unevictable: 30, stall: 9),
      beat(n: 3, anon: 850, file: 120, shmem: 90, unevictable: 30, stall: 4),
    ],
    run_completed: true,
    swap_policy: SwapDisabled,
  }
}

// THE HELD-SET RULE IS NON-OVERLAPPING: shmem is added in place of file, unevictable is not a term,
// reclaimable slab is not a term. Beat 2 of the fixture carries unevictable 30 and slab_reclaimable
// 1000 precisely so a rule that summed either would red here, and the reclaimable cache is file
// less shmem.
test fn the_held_set_rule_counts_disjoint_terms_only() -> Bool {
  let b2 = beat(n: 2, anon: 900, file: 100, shmem: 90, unevictable: 30, stall: 9)
  let cache = match beat_reclaimable_cache(b: b2) {
    MeasureDifference { value: c } => byte_size_count(b: c) == 10
    MeasureSubtrahendExceedsMinuend => false
  }
  let held = match beat_held_set(b: b2) {
    CheckedIntReady { value: v } => v == 1000
    CheckedIntOverflow { cause: _ } => false
  }
  held && cache
}

// THE RED FOR THE CHECKED SUM: a torn beat whose anon alone sits at the representable bound
// overflows on the first added term, and the receipt that carries it stands as
// HeldSetReceiptUnrepresentable rather than as a small demand.
test fn a_beat_whose_held_set_cannot_be_represented_makes_the_receipt_torn() -> Bool {
  let torn = FloorMemoryStatBeat {
    beat: 1, seam: SeamUnrecorded, charge: byte_size(0),
    anon: byte_size(int_inclusive_max()), file: byte_size(0), shmem: byte_size(1), unevictable: byte_size(0),
    slab_unreclaimable: byte_size(0), slab_reclaimable: byte_size(0), kernel_stack: byte_size(0),
    pagetables: byte_size(0), percpu: byte_size(0), sock: byte_size(0), file_dirty: byte_size(0),
    stall: events_per_minute(count: 0),
  }
  let sum_refuses = match beat_held_set(b: torn) {
    CheckedIntOverflow { cause: _ } => true
    CheckedIntReady { value: _ } => false
  }
  let receipt = FloorHeldSetReceipt {
    run_id: "torn", runner_unit: "torn", beat_cadence: second(count: 60), beats_sampled: 2,
    beats: [beat(n: 0, anon: 5, file: 5, shmem: 1, unevictable: 0, stall: 0), torn], run_completed: false, swap_policy: SwapDisabled,
  }
  let standing_is_torn = match held_set_standing_of(receipt: receipt, instrument: "fixture") {
    HeldSetReceiptUnrepresentable { cause: _ } => true
    _ => false
  }
  let requirement_absent = match floor_memory_requirement_of(standing: held_set_standing_of(receipt: receipt, instrument: "fixture")) {
    Absent => true
    Present { value: _ } => false
  }
  sum_refuses && standing_is_torn && requirement_absent
}

// THE RED FOR THE TYPED SUBTRACTION: a torn line with shmem = file + 1 refuses rather than
// flooring the cache to zero, and that refusal reaches the shape as its own arm (see
// runner_microvm_witness_test a_torn_beat_with_more_shmem_than_file_refuses_the_allowance).
test fn a_beat_with_more_shmem_than_file_refuses_the_cache_subtraction() -> Bool {
  match beat_reclaimable_cache(b: beat(n: 1, anon: 800, file: 100, shmem: 101, unevictable: 0, stall: 0)) {
    MeasureSubtrahendExceedsMinuend => true
    MeasureDifference { value: _ } => false
  }
}

// THE DISTINGUISHED BEATS ARE DERIVED FROM THE LIST: the peak is the largest held set, the last
// unstalled beat is the highest zero-stall beat before it, and an empty list yields neither.
test fn the_peak_and_last_unstalled_beats_are_derived_from_the_raw_beats() -> Bool {
  let r = fixture_receipt()
  let peak = match receipt_peak_beat(r: r) {
    Absent => false
    Present { value: p } => p.beat == 2
  }
  let unstalled = match receipt_last_unstalled_beat(r: r) {
    Absent => false
    Present { value: u } => u.beat == 1
  }
  let empty = FloorHeldSetReceipt {
    run_id: "empty", runner_unit: "empty", beat_cadence: second(count: 60), beats_sampled: 0,
    beats: [] as List<FloorMemoryStatBeat>, run_completed: false, swap_policy: SwapDisabled,
  }
  let none_on_empty = match receipt_peak_beat(r: empty) {
    Absent => true
    Present { value: _ } => false
  }
  peak && unstalled && none_on_empty
}

// THE PRODUCTION RECEIPT IS WHAT THE INSTRUMENT SAID, JOINED TO THE CITED PRODUCER READINGS:
// four raw beats transcribed from run 35419304682's own lines; the derived peak is beat 14 with
// held set 26725773568 and its stall clause at 6 per minute; beat 15's clause reads 66940, the
// thrash the prose cites; the last unstalled beat is 13 with 1895120896 bytes of file. A partial
// run, the held set within the cell's memory_max, and the cache under one percent of the charge
// at the peak.
test fn the_production_receipt_joins_its_typed_beats_to_the_cited_producer_readings() -> Bool {
  let r = gunbc_floor_memory_stat_receipt_2026_09_19
  let peak_ok = match receipt_held_set_peak(r: r) {
    HeldSetPeakNoBeats => false
    HeldSetPeakUnrepresentable { cause: _ } => false
    HeldSetPeakAt { beat: p, bytes: held } =>
      p.beat == 14
        && byte_size_count(b: held) == 26725773568
        && byte_size_count(b: p.anon) == 26664632320
        && byte_size_count(b: p.file_dirty) == 0
        && events_per_minute_count(r: p.stall) == 6
        && byte_size_count(b: p.file) * 100 < byte_size_count(b: p.charge)
        && byte_size_count(b: held) <= byte_size_count(b: p.charge)
        && byte_size_count(b: held) <= byte_size_count(b: gunbc_runner_slot_desired().memory_max)
  }
  let thrash_beat_ok = any(r.beats, b => b.beat == 15 && events_per_minute_count(r: b.stall) == 66940)
  let unstalled_ok = match receipt_last_unstalled_beat(r: r) {
    Absent => false
    Present { value: u } => u.beat == 13 && byte_size_count(b: u.file) == 1895120896 && events_per_minute_count(r: u.stall) == 0
  }
  !r.run_completed && r.beats_sampled > 0 && count(r.beats) == 4 && peak_ok && thrash_beat_ok && unstalled_ok
}

// THE PIN WAS TAKEN UNDER THE CURRENT ROW, which is what makes it a finding about the row rather
// than about a line that no longer exists.
test fn the_pin_receipt_was_armed_at_the_declared_throttle_line() -> Bool {
  match gunbc_floor_throttle_pin_receipt_2026_09_19 {
    FloorRunCgroupPeakMeasured { run_id: _, runner_unit: _, cgroup_peak: _, armed_memory_high: h, floor_outcome: _ } =>
      byte_size_count(b: h) == byte_size_count(b: gunbc_runner_slot_desired().memory_high)
    FloorRunCgroupPeakUnmeasured => false
  }
}

fn grain_of(n: Int) -> Int {
  match round_up_to_gibibyte_grain(bytes: byte_size(n)) {
    GrainRounded { bytes: b } => byte_size_count(b: b)
    GrainUnrepresentable { cause: _ } => 0 - 1
  }
}

test fn gibibyte_grain_rounds_up_and_leaves_a_whole_gibibyte_alone() -> Bool {
  let g = byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 1)))
  grain_of(n: 1) == g && grain_of(n: g) == g && grain_of(n: g + 1) == 2 * g && grain_of(n: 0) == 0
}

// THE RED FOR THE CHECKED ROUND-UP: a count within grain - 1 of the representable bound has no
// representable ceiling and refuses instead of wrapping to a small multiple of the grain.
test fn a_count_at_the_representable_bound_has_no_gibibyte_ceiling() -> Bool {
  match round_up_to_gibibyte_grain(bytes: byte_size(int_inclusive_max())) {
    GrainUnrepresentable { cause: _ } => true
    GrainRounded { bytes: _ } => false
  }
}

// THE STORAGE FIGURE IS THE ROUNDED SUM OF ITS COMPONENTS, two of which are foreign-architecture
// proxies; the sum is under two gibibytes and the requirement is exactly two, which is the grain
// doing its job rather than a number chosen.
test fn the_floor_storage_requirement_is_the_rounded_component_sum() -> Bool {
  let two = byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 2)))
  let total = match storage_components_total(components: gunbc_floor_storage_components) {
    CheckedIntReady { value: v } => v
    CheckedIntOverflow { cause: _ } => 0 - 1
  }
  let stated = match floor_storage_demand() {
    StorageDemandStated { requirement: r } => byte_size_count(b: r.min_bytes) == two && grain_of(n: total) == two
    StorageDemandUnrepresentable { cause: _ } => false
  }
  stated
    && total > 0
    && total < two
    && any(gunbc_floor_storage_components, c => component_measured_on_x86_64(c: c))
    && any(gunbc_floor_storage_components, c => component_measured_on_aarch64(c: c))
}

fn component_measured_on_x86_64(c: StorageComponentReceipt) -> Bool {
  match c.measured_on {
    X86_64 => true
    _ => false
  }
}

fn component_measured_on_aarch64(c: StorageComponentReceipt) -> Bool {
  match c.measured_on {
    Aarch64 => true
    _ => false
  }
}

test fn the_warm_wall_receipt_is_a_warm_reading_under_the_lane_timeout() -> Bool {
  gunbc_floor_job_wall_receipt_2026_09_19.sccache_reachable
    && second_count(gunbc_floor_job_wall_receipt_2026_09_19.build_step_wall)
      < second_count(gunbc_floor_job_wall_receipt_2026_09_19.whole_job_wall)
}

// THE PEAK'S SEAM IS THE SEAM OF THE BEAT THAT ESTABLISHED THE PEAK, NOT OF THE FIRST OR THE LAST
// BEAT. The fixture puts the largest held set in the MIDDLE beat and gives all three DIFFERENT
// seams, so a fold that reported the first beat's seam, the last beat's seam, or the seam of the
// beat with the largest charge rather than the largest held set reds here. Beat 2 carries the
// largest anon and therefore the largest held set; beat 3 carries a larger CHARGE via its file
// bytes, which is the discriminator between the two quantities.
test fn the_peak_seam_names_the_beat_that_established_the_peak_not_the_largest_charge() -> Bool {
  let r = FloorHeldSetReceipt {
    run_id: "fixture",
    runner_unit: "fixture",
    beat_cadence: second(count: 60),
    beats_sampled: 3,
    beats: [
      seamed_beat(n: 1, seam: SeamStrictPreparation, anon: 800, file: 700, shmem: 50, unevictable: 0, stall: 0),
      seamed_beat(n: 2, seam: SeamClaimEvaluationFold, anon: 900, file: 100, shmem: 90, unevictable: 0, stall: 9),
      seamed_beat(n: 3, seam: SeamStrictPreparation, anon: 850, file: 9000, shmem: 90, unevictable: 0, stall: 4),
    ],
    run_completed: true,
    swap_policy: SwapDisabled,
  }
  match receipt_peak_seam(r: r) {
    PeakAttributedTo { seam: s, beat: b, bytes: _ } =>
      b == 2 && match s {
        SeamClaimEvaluationFold => true
        _ => false
      }
    PeakSeamUnattributable { cause: _ } => false
  }
}

// A PEAK BEAT THAT CARRIES NO SEAM REFUSES ATTRIBUTION RATHER THAN NAMING ONE. Both non-seam arms
// are exercised, because they arise for different reasons and a fold that passed either one
// through would let an un-attributed peak read as attributed -- which is the whole failure this
// carrier exists to prevent.
// EACH ARM IS ASSERTED BY IDENTITY, not merely "it refused". The three receipts below fail for
// three different reasons, and an earlier revision of this witness greened on any refusal at all
// -- so a fold that answered one cause for every case passed it (review 69719). The beat number
// is asserted too: a cause that names the wrong beat is a located diagnostic pointing at the
// wrong place, which is worse than an unlocated one.
test fn a_peak_beat_without_a_seam_refuses_rather_than_naming_a_phase() -> Bool {
  let unrecorded = FloorHeldSetReceipt {
    run_id: "fixture", runner_unit: "fixture", beat_cadence: second(count: 60), beats_sampled: 1,
    beats: [seamed_beat(n: 1, seam: SeamUnrecorded, anon: 900, file: 100, shmem: 90, unevictable: 0, stall: 0)],
    run_completed: true,
    swap_policy: SwapDisabled,
  }
  let not_yet = FloorHeldSetReceipt {
    run_id: "fixture", runner_unit: "fixture", beat_cadence: second(count: 60), beats_sampled: 1,
    beats: [seamed_beat(n: 1, seam: SeamNotYetEntered, anon: 900, file: 100, shmem: 90, unevictable: 0, stall: 0)],
    run_completed: true,
    swap_policy: SwapDisabled,
  }
  let no_beats = FloorHeldSetReceipt {
    run_id: "fixture", runner_unit: "fixture", beat_cadence: second(count: 60), beats_sampled: 0,
    beats: [], run_completed: true, swap_policy: SwapDisabled,
  }
  let a = match receipt_peak_seam(r: unrecorded) {
    PeakSeamUnattributable { cause: PeakBeatSeamUnrecorded { beat: b } } => b == 1
    _ => false
  }
  let b2 = match receipt_peak_seam(r: not_yet) {
    PeakSeamUnattributable { cause: PeakBeatSampledBeforeAnySeam { beat: b } } => b == 1
    _ => false
  }
  let c = match receipt_peak_seam(r: no_beats) {
    PeakSeamUnattributable { cause: ReceiptHasNoBeats } => true
    _ => false
  }
  a && b2 && c
}

// THE FLIP HAS HAPPENED, AND THIS IS THE REGRESSION CONTROL IT BECAME (DESIGN 4b(4)). This claim
// was written expecting RED: it asserted that the standing receipt could NOT attribute its peak,
// because every beat of the 2026-09-19 receipt was transcribed from a line printed before the
// instrument carried a seam. Its stated trigger was a dated successor taken under the
// seam-carrying instrument replacing it as gunbc_floor_held_set_standing's input. That successor
// is gunbc_floor_memory_stat_receipt_2026_09_21, and it landed, so the claim does not retire --
// it changes polarity and now asserts that the standing receipt IS attributable.
//
// WHAT MOVED, cited on the flip as 4b(4) requires: the standing's input, from the 2026-09-19
// receipt to the 2026-09-21 one, taken on CI run 35652545009.
test fn the_standing_receipt_attributes_its_peak_to_a_named_seam() -> Bool {
  match receipt_peak_seam(r: gunbc_floor_memory_stat_receipt_2026_09_21) {
    PeakAttributedTo { seam: s, beat: b, bytes: _ } =>
      b == 18 && match s {
        SeamClaimEvaluationFold => true
        _ => false
      }
    PeakSeamUnattributable { cause: _ } => false
  }
}

// THE SUPERSEDED RECEIPT STILL REFUSES, AND KEEPING THIS IS THE POINT OF RETAINING IT. The flip
// above would otherwise leave SeamUnrecorded with no executed red anywhere: the arm would still
// exist, still be reachable in principle, and nothing would run it. This claim is that execution,
// over the real 2026-09-19 rows rather than a fixture, which is what makes it evidence that a
// pre-instrument receipt cannot be read as attributed.
test fn the_superseded_2026_09_19_receipt_still_cannot_attribute_its_peak() -> Bool {
  match receipt_peak_seam(r: gunbc_floor_memory_stat_receipt_2026_09_19) {
    PeakSeamUnattributable { cause: PeakBeatSeamUnrecorded { beat: _ } } => true
    _ => false
  }
}

// NEITHER RECEIPT READS A DEMAND, AND THE STANDING SAYS WHICH REASON APPLIES TO WHICH. The
// 2026-09-19 run refused in preparation and never completed; the 2026-09-21 run completed its
// fold but its PEAK BEAT was already stalling at 11 faults/min. Two different censoring
// mechanisms, reported as two different causes, over the two real receipts -- so a reader who
// wants an uncensored figure is told what would have to change to get one rather than handed a
// number that looks like a demand.
test fn neither_standing_receipt_reads_an_uncensored_demand() -> Bool {
  let old_one = match receipt_peak_reading_standing(r: gunbc_floor_memory_stat_receipt_2026_09_19) {
    PeakIsLowerBound { cause: RunDidNotComplete } => true
    _ => false
  }
  let new_one = match receipt_peak_reading_standing(r: gunbc_floor_memory_stat_receipt_2026_09_21) {
    PeakIsLowerBound { cause: PeakBeatWasStalling { beat: b, stall: _ } } => b == 18
    _ => false
  }
  old_one && new_one
}

// THE POSITIVE CONTROL FOR PeakIsDemand, so the arm that would let a figure SIZE something is not
// a permanently unreachable decoration. A completed run whose peak beat did not stall, under a
// policy that cannot spill, reads a demand -- and no receipt in this corpus satisfies that today,
// which is precisely why the arm needs a supplied-input control to prove it is inhabitable.
test fn a_completed_unstalled_run_without_swap_reads_a_demand() -> Bool {
  let clean = FloorHeldSetReceipt {
    run_id: "fixture", runner_unit: "fixture", beat_cadence: second(count: 60), beats_sampled: 1,
    beats: [seamed_beat(n: 1, seam: SeamClaimEvaluationFold, anon: 900, file: 100, shmem: 90, unevictable: 0, stall: 0)],
    run_completed: true,
    swap_policy: SwapDisabled,
  }
  match receipt_peak_reading_standing(r: clean) {
    PeakIsDemand => true
    _ => false
  }
}
