module test.claim.floor_materialization_witness

import std.types { Bool, Int, List, String }
import std.realization_schedule { ScheduleWitnessEntry }
import gunbc.ci_gate { Gate }
import gunbc.commit_workflow { commit_gate_roster, project_ci_floor_gates, project_ci_floor_witness_entries }
import gunbc.floor_materialization {
  floor_index_build_identity,
  floor_index_build_share_provider_id,
  floor_index_build_materialization,
  floor_index_build_materialization_without_provider,
  floor_index_build_reader_count,
  floor_typecheck_store_identity,
  floor_typecheck_store_share_provider_id,
  floor_typecheck_store_materialization,
  floor_typecheck_store_materialization_without_provider,
  floor_typecheck_store_reader_count,
  floor_typecheck_store_persist_provider_id,
  floor_typecheck_store_persist_verdicts,
  floor_typecheck_store_persist_verdicts_unbounded,
  floor_typecheck_store_persist_verdicts_unobserved,
  floor_typecheck_store_persist_verdicts_process_scoped,
  floor_typecheck_store_persist_verdicts_without_provider
}
import std.materialization_ladder {
  LadderVerdict,
  value_verdict_is_shared_by_reference,
  value_verdict_is_refused_needing_reference,
  verdict_is_discharged_by,
  verdict_is_refused_retention_unbounded,
  verdict_is_refused_retention_unobserved,
  verdict_is_refused_scope_too_narrow,
  verdict_is_refused_no_provider
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn live_floor_gates() -> List<Gate> {
  project_ci_floor_gates(roster: commit_gate_roster)
}

fn live_floor_witnesses() -> List<ScheduleWitnessEntry> {
  project_ci_floor_witness_entries(roster: commit_gate_roster)
}

data floor_materialization_witness_note: String = "The value-tier ladder run against the LIVE floor consumer roster (spec gates + witness entries projected from commit_gate_roster, plus the fixed prelude), enrolled on the CI surface. Proves the in-process index-build share (process_shared_index) discharges the plural readonly reads as ValueSharedByReference — green because the share is DECLARED and covers every consumer, not because nothing looked. RED control removes the ReferenceTier provider and demands ValueRefusedNoCarrierProvider, so the witness discriminates. S2a increment C adds the process-scoped typecheck store share (process_shared_typecheck_store) with the same ladder pattern. Backing evidence, CORRECTED 2026-08-11 (gunbc#8146, review 51209) - it read 'green-by-execution (cited, run under rust_tests nextest)', which was false twice over: nextest was removed from CI 2026-07-11, and the src/v1/tests/src module below was deleted by the v1 Rust test-suite cutover. The claim_executor.rs pair is unaffected. WITHDRAWN for the deleted module, dissolve-on: re-establish the union-resolve receipts as floor witnesses. Original citation: memo_deduplicates_resolve_count + memo_warm_cold_results_are_identical (claim_executor.rs), union_view_result_equals_private_resolve_in_every_order + union_resolve_typechecks_each_node_once + cross_worker_shared_typecheck_cache_process_once_per_node + cross_worker_shared_typecheck_cache_purity (src/v1/tests/src/union_resolve_receipts_test.rs - DELETED)."

test fn floor_index_build_share_is_shared_by_reference() -> Bool {
  let gates = live_floor_gates()
  let witnesses = live_floor_witnesses()
  value_verdict_is_shared_by_reference(
    v: floor_index_build_materialization(gates: gates, witnesses: witnesses),
    identity: floor_index_build_identity,
    provider_id: floor_index_build_share_provider_id,
    reader_count: floor_index_build_reader_count(gates: gates, witnesses: witnesses)
  )
}

test fn floor_index_build_has_plural_readers() -> Bool {
  floor_index_build_reader_count(gates: live_floor_gates(), witnesses: live_floor_witnesses()) >= 2
}

test fn floor_index_build_reds_without_reference_provider() -> Bool {
  value_verdict_is_refused_needing_reference(
    v: floor_index_build_materialization_without_provider(gates: live_floor_gates(), witnesses: live_floor_witnesses()),
    identity: floor_index_build_identity
  )
}

test fn floor_typecheck_store_share_is_shared_by_reference() -> Bool {
  value_verdict_is_shared_by_reference(
    v: floor_typecheck_store_materialization(),
    identity: floor_typecheck_store_identity,
    provider_id: floor_typecheck_store_share_provider_id,
    reader_count: floor_typecheck_store_reader_count()
  )
}

test fn floor_typecheck_store_has_plural_readers() -> Bool {
  floor_typecheck_store_reader_count() >= 2
}

test fn floor_typecheck_store_reds_without_reference_provider() -> Bool {
  value_verdict_is_refused_needing_reference(
    v: floor_typecheck_store_materialization_without_provider(),
    identity: floor_typecheck_store_identity
  )
}

// C3 — the HOST-PERSISTED tier. The demand set is the two sibling PROCESSES over one corpus under
// one built binary (the witness fold and the generated-artifact drift gate), whose obligation LCA
// is the runner host. That LCA is not shared state, so the repetition is not a rewire the ladder
// would refuse; it is the isolation obligation only a store tier discharges. Four REDs follow, one
// per withdrawn obligation, each naming the DISTINCT refusal it must produce — so the green is
// green because the ladder admitted this provider, and a provider failing for another reason
// cannot pass as this one.

fn first_persist_verdict(vs: List<LadderVerdict>) -> LadderVerdict? {
  vs.first()
}

test fn floor_typecheck_store_persist_is_discharged() -> Bool {
  match first_persist_verdict(vs: floor_typecheck_store_persist_verdicts()) {
    Absent => false
    Present { value: v } =>
      verdict_is_discharged_by(
        v: v,
        identity: floor_typecheck_store_identity,
        provider_id: floor_typecheck_store_persist_provider_id
      )
  }
}

// The ladder refuses ReleasedNever with CapacityUnbounded. Without this red, a persistent provider
// with no ceiling would read as discharged and the boundedness obligation would be decoration.
test fn floor_typecheck_store_persist_reds_when_unbounded() -> Bool {
  match first_persist_verdict(vs: floor_typecheck_store_persist_verdicts_unbounded()) {
    Absent => false
    Present { value: v } =>
      verdict_is_refused_retention_unbounded(v: v, provider_id: floor_typecheck_store_persist_provider_id)
  }
}

// And refuses ReleasedNever with CapacityUnobserved: a ceiling nobody measures is not a ceiling.
test fn floor_typecheck_store_persist_reds_when_occupancy_unobserved() -> Bool {
  match first_persist_verdict(vs: floor_typecheck_store_persist_verdicts_unobserved()) {
    Absent => false
    Present { value: v } =>
      verdict_is_refused_retention_unobserved(v: v, provider_id: floor_typecheck_store_persist_provider_id)
  }
}

// The same store row scoped to ONE PROCESS, offered against a CROSS-PROCESS demand, must refuse as
// scope-too-narrow. This is the discriminating red for the whole tier: if it passed, the
// process-scoped provider would be answering a cross-process question, and C3 would be redundant
// with C2 rather than reaching a boundary C2 cannot.
test fn floor_typecheck_store_persist_reds_when_only_process_scoped() -> Bool {
  match first_persist_verdict(vs: floor_typecheck_store_persist_verdicts_process_scoped()) {
    Absent => false
    Present { value: v } =>
      verdict_is_refused_scope_too_narrow(v: v, provider_id: floor_typecheck_store_persist_provider_id)
  }
}

test fn floor_typecheck_store_persist_reds_without_any_provider() -> Bool {
  match first_persist_verdict(vs: floor_typecheck_store_persist_verdicts_without_provider()) {
    Absent => false
    Present { value: v } =>
      verdict_is_refused_no_provider(v: v, identity: floor_typecheck_store_identity)
  }
}
