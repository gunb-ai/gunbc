module test.claim.floor.floor_discovery_hand_rust_equivalence_witness

import std.dissolution { dissolution_description }

import gunbc.floor.floor_discovery_scaffold {
  floor_discovery_hand_rust_scaffold,
  floor_discovery_dissolve_trigger,
  floor_discovery_producer_entry,
  floor_discovery_equivalence_test_sidecar_misplaced,
  floor_discovery_equivalence_test_scan_wire_contract,
  floor_discovery_equivalence_test_narrowed_corpus_control,
  floor_entry_resolution_host_boundary_note,
  floor_entry_resolution_host_boundary_discriminator,
}
import v2.compiler.discovery_enumeration {
  OwnedBoolWitnessClaimInit,
  OwnedDataDeclRecord
}
import v2.workflow.floor_discovery_row { FloorDiscoveryRow, FloorMarkedSource }
import v2.workflow.floor_discovery_producer { discover_floor_corpus_rows_from_host_facts }
import v2.workflow.floor_discovery_source_authority {
  FloorDiscoveryAccepted,
  FloorDiscoveryProducerResult,
  FloorDiscoveryRefused,
  floor_discovery_content_has_wire_contract_decl,
  floor_discovery_entry_live_tree_disposition_refusal_for_content,
  floor_discovery_surface_text_scan_scaffold,
  floor_discovery_wire_contract_sidecar_refusal_for_content
}
import v2.std.algebra { length, list_head, HeadFound, HeadAbsent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.collection {
  fold_list
}
import std.optional {
  Absent,
  Optional,
  Present
}
import std.types { Bool, Int, String, List }
import std.disposition { Scaffold, SingleAuthority }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executes floor_discovery_producer.dag on fixtures: the owned-data transport projection, the
// marker supply through a real directory walk, and the file-versus-directory admission of the host's
// failure kind, plus the per-file text scans the producer still owns (wire-contract placement and
// the live-tree disposition row) with RED perturbation controls. Producer authority is exercised
// here; the Rust bridge cross-checks (discover_floor_witness_roster, scan_wire_contract_decl_names)
// are named in gunbc.floor.floor_discovery_scaffold and proven by cargo test sidecar_placement_hygiene_tests
// in cli_run.rs on the same fixture spellings.
//
// A test is a declaration carrying the authored `test` marker, and nothing else, so no fixture here
// can make a file a test by its name: the marked names are the SUPPLIED value, and each rule is
// exercised by changing what is supplied.

test fn floor_entry_resolution_host_boundary_is_declared() -> Bool {
  floor_entry_resolution_host_boundary_discriminator == "resolve_workspace_entry"
    && string_contains(
      s: floor_entry_resolution_host_boundary_note,
      pattern: "WorkspaceRootRelativeEntry",
    )
    && string_contains(
      s: floor_entry_resolution_host_boundary_note,
      pattern: "FLOOR_DISCOVERY_PRODUCER_ENTRY",
    )
    && string_contains(
      s: floor_entry_resolution_host_boundary_note,
      pattern: "v1-hand-queue-drain",
    )
}

data fixture_witness_entry: String = "dag/test/claim/floor/floor_discovery_roster_fixture.dag"
data fixture_witness_function: String = "floor_discovery_roster_fixture_witness"
data fixture_misplaced_wire_contract_entry: String = "dag/test/fixture/floor_discovery/misplaced_wire_contract.dag"
data fixture_live_tree_entry: String = "dag/test/claim/floor/floor_discovery_roster_fixture.dag"
// A real directory holding exactly one `.dag` module (the leaf declares no test; the fact is supplied).
data fixture_walk_root: String = "dag/test/fixture/floor_discovery_walk"
data fixture_walk_leaf_path: String = "dag/test/fixture/floor_discovery_walk/leaf.dag"
data fixture_walk_leaf_function: String = "floor_discovery_walk_leaf"
// A directory holding one regular file that is not a `.dag` module: listing it fails with the host's
// NotADirectory kind, which is the one failure the walk reads as "a file".
data fixture_walk_non_module_root: String = "fixtures/native_lane_malformed"
data fixture_walk_absent_root: String = "dag/test/fixture/floor_discovery_walk_absent"

fn fixture_wire_contract_coproduct_content() -> String {
  concat(
    "data foo: Coproduct",
    "WireContract = { coproduct: \"X\", encoding: UntaggedVariant }"
  )
}

fn fixture_wire_contract_variant_content() -> String {
  concat("data bar: Variant", "Encoding = llm_snake_wire_contract")
}

fn fixture_misplaced_wire_contract_content() -> String {
  concat(
    "data anthropic_chat_message_wire_contract: Coproduct",
    "WireContract = { coproduct: \"AnthropicChatMessage\", encoding: UntaggedVariant }\n"
  )
}

fn fixture_live_tree_malformed_variant_content() -> String {
  concat(
    "module m\n\ndata live_tree_disposition: LiveTreeDisposition = MaybeLive\n"
  )
}

fn fixture_live_tree_duplicate_decl_content() -> String {
  concat(
    "module m\n\ndata live_tree_disposition: LiveTreeDisposition = ReadsLiveTree\n",
    "data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly\n"
  )
}

fn fixture_live_tree_trailing_comment_content() -> String {
  concat(
    "module m\n\ndata live_tree_disposition: LiveTreeDisposition = ReadsLiveTree // was SubstrateInputsOnly\n"
  )
}

// The label of an owned-data row is its declaration name, so this name must come back whole: a
// producer that strips any prefix of it to make a label changes the row this fixture expects.
data fixture_bool_witness_decl_name: String = "unified_claim_floor_discovery_fixture"

fn fixture_bool_witness_record() -> OwnedDataDeclRecord {
  OwnedDataDeclRecord {
    entry: "dag/gunbc/floor/floor_discovery_scaffold.dag",
    module: "gunbc.floor.floor_discovery_scaffold",
    decl_name: fixture_bool_witness_decl_name,
    initializer: OwnedBoolWitnessClaimInit {
      witness_entry: fixture_witness_entry,
      witness_function: fixture_witness_function
    }
  }
}

fn fixture_bool_witness_record_empty_transport() -> OwnedDataDeclRecord {
  OwnedDataDeclRecord {
    entry: "dag/gunbc/floor/floor_discovery_scaffold.dag",
    module: "gunbc.floor.floor_discovery_scaffold",
    decl_name: "unified_claim_floor_discovery_fixture_empty",
    initializer: OwnedBoolWitnessClaimInit {
      witness_entry: "",
      witness_function: ""
    }
  }
}

fn fixture_walk_leaf_fact(marked: List<String>) -> FloorMarkedSource {
  FloorMarkedSource { repo_path: fixture_walk_leaf_path, marked: marked }
}

fn floor_discovery_rows_contain_entry_function(
  rows: List<FloorDiscoveryRow>,
  entry: String,
  function: String
) -> Bool {
  fold_list(
    xs: rows,
    empty: false,
    cons: fn(found, row) {
      if found {
        true
      } else {
        (row.entry == entry) && (row.function == function)
      }
    }
  )
}

fn floor_discovery_first_row_label(rows: List<FloorDiscoveryRow>) -> String {
  match list_head(xs: rows) {
    HeadFound { value: row } => row.label
    HeadAbsent => ""
  }
}

fn floor_discovery_first_row_reads_substrate_only(rows: List<FloorDiscoveryRow>) -> Bool {
  match list_head(xs: rows) {
    HeadFound { value: row } => row.reads_live_tree == SubstrateInputsOnly
    HeadAbsent => false
  }
}

// The refusal reason of a result, or "" for an accepted one: the red tests below assert on words.
fn floor_discovery_refusal_reason_or_empty(result: FloorDiscoveryProducerResult) -> String {
  match result {
    FloorDiscoveryAccepted { rows: _ } => ""
    FloorDiscoveryRefused { reason: reason } => reason
  }
}

fn floor_discovery_accepted_with_row_count(result: FloorDiscoveryProducerResult, count: Int) -> Bool {
  match result {
    FloorDiscoveryAccepted { rows: rows } => length(xs: rows) == count
    FloorDiscoveryRefused { reason: _ } => false
  }
}

test fn floor_discovery_hand_rust_scaffold_binds_producer_authority() -> Bool {
  match floor_discovery_hand_rust_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn floor_discovery_dissolve_trigger_names_producer_authority() -> Bool {
  string_contains(s: dissolution_description(condition: floor_discovery_dissolve_trigger), pattern: "floor_discovery_producer")
    && string_contains(s: dissolution_description(condition: floor_discovery_dissolve_trigger), pattern: "dissolve-on")
}

test fn floor_discovery_surface_text_scan_scaffold_on_carrier() -> Bool {
  match floor_discovery_surface_text_scan_scaffold {
    Scaffold {
      dissolves_to: SingleAuthority,
      bind: DeclarationRef {
        module_path: "v2.workflow.floor_discovery_source_authority",
        decl_name: "floor_discovery_content_has_wire_contract_decl",
        field: WholeDeclaration
      }
    } => true
    _ => false
  }
}

test fn floor_discovery_producer_entry_is_canonical() -> Bool {
  floor_discovery_producer_entry == "src/v2/workflow/floor_discovery_producer.dag"
}

test fn floor_discovery_producer_owned_data_row_holds() -> Bool {
  match discover_floor_corpus_rows_from_host_facts(
    source_roots: [],
    exclude_substrings: [],
    owned_data_records: [fixture_bool_witness_record()],
    marked_sources: []
  ) {
    FloorDiscoveryAccepted { rows: rows } =>
      (length(xs: rows) == 1)
        && floor_discovery_rows_contain_entry_function(
          rows: rows,
          entry: fixture_witness_entry,
          function: fixture_witness_function
        )
        && (floor_discovery_first_row_label(rows: rows) == fixture_bool_witness_decl_name)
        && floor_discovery_first_row_reads_substrate_only(rows: rows)
    FloorDiscoveryRefused { reason: _ } => false
  }
}

test fn floor_discovery_producer_empty_transport_red_control() -> Bool {
  match discover_floor_corpus_rows_from_host_facts(
    source_roots: [],
    exclude_substrings: [],
    owned_data_records: [fixture_bool_witness_record_empty_transport()],
    marked_sources: []
  ) {
    FloorDiscoveryAccepted { rows: _ } => false
    FloorDiscoveryRefused { reason: msg } =>
      string_contains(s: msg, pattern: "malformed BoolWitnessClaim witness")
  }
}

// MARKER SUPPLY, POSITIVE CONTROL: the walk reads the real directory, finds the real `.dag` file,
// takes the supplied marked name for it and enrols exactly that declaration. The leaf's bytes
// declare no test, so the row exists only because the fact was supplied.
test fn floor_discovery_producer_walk_enrols_the_supplied_marked_name() -> Bool {
  match discover_floor_corpus_rows_from_host_facts(
    source_roots: [fixture_walk_root],
    exclude_substrings: [],
    owned_data_records: [],
    marked_sources: [fixture_walk_leaf_fact(marked: [fixture_walk_leaf_function])]
  ) {
    FloorDiscoveryAccepted { rows: rows } =>
      (length(xs: rows) == 1)
        && floor_discovery_rows_contain_entry_function(
          rows: rows,
          entry: fixture_walk_leaf_path,
          function: fixture_walk_leaf_function
        )
    FloorDiscoveryRefused { reason: _ } => false
  }
}

// ...and a supplied EMPTY list is an answer too: a file the parse found no test in enrols nothing and
// refuses nothing, which is what separates it from the absent fact below.
test fn floor_discovery_producer_walk_supplied_empty_fact_enrols_nothing() -> Bool {
  floor_discovery_accepted_with_row_count(
    result: discover_floor_corpus_rows_from_host_facts(
      source_roots: [fixture_walk_root],
      exclude_substrings: [],
      owned_data_records: [],
      marked_sources: [fixture_walk_leaf_fact(marked: [])]
    ),
    count: 0
  )
}

// MARKER SUPPLY, RED: the same walk with NO fact for the file it reaches refuses, located at that
// file, instead of reading the absence as an empty list of tests.
test fn floor_discovery_producer_walk_absent_marker_fact_refuses_red_control() -> Bool {
  let reason = floor_discovery_refusal_reason_or_empty(
    result: discover_floor_corpus_rows_from_host_facts(
      source_roots: [fixture_walk_root],
      exclude_substrings: [],
      owned_data_records: [],
      marked_sources: []
    )
  )
  string_contains(s: reason, pattern: "no marker fact was supplied")
    && string_contains(s: reason, pattern: fixture_walk_leaf_path)
}

// MARKER SUPPLY, RED: two facts for one file is a supplier that disagrees with itself; the walk does
// not pick one.
test fn floor_discovery_producer_walk_duplicated_marker_fact_refuses_red_control() -> Bool {
  let reason = floor_discovery_refusal_reason_or_empty(
    result: discover_floor_corpus_rows_from_host_facts(
      source_roots: [fixture_walk_root],
      exclude_substrings: [],
      owned_data_records: [],
      marked_sources: [
        fixture_walk_leaf_fact(marked: [fixture_walk_leaf_function]),
        fixture_walk_leaf_fact(marked: [])
      ]
    )
  )
  string_contains(s: reason, pattern: "more than one marker fact was supplied")
    && string_contains(s: reason, pattern: fixture_walk_leaf_path)
}

// MARKER SUPPLY, CONTROL: an excluded path needs no fact. The red above is therefore the absence of
// the fact for a file the walk judges, not a blanket refusal of an empty supply.
test fn floor_discovery_producer_walk_excluded_path_needs_no_marker_fact() -> Bool {
  floor_discovery_accepted_with_row_count(
    result: discover_floor_corpus_rows_from_host_facts(
      source_roots: [fixture_walk_root],
      exclude_substrings: ["floor_discovery_walk/leaf"],
      owned_data_records: [],
      marked_sources: []
    ),
    count: 0
  )
}

// FILE-OR-DIRECTORY, RED: a path the host cannot list for any reason other than NotADirectory is a
// located walk failure; a vanished root is never an empty directory.
test fn floor_discovery_producer_walk_missing_root_refuses_red_control() -> Bool {
  string_contains(
    s: floor_discovery_refusal_reason_or_empty(
      result: discover_floor_corpus_rows_from_host_facts(
        source_roots: [fixture_walk_absent_root],
        exclude_substrings: [],
        owned_data_records: [],
        marked_sources: []
      )
    ),
    pattern: fixture_walk_absent_root
  )
}

// FILE-OR-DIRECTORY, CONTROL: a regular file that is not a `.dag` module, reached through a real
// directory, is listed, fails with NotADirectory, and is admitted as a file. No name says so.
test fn floor_discovery_producer_walk_admits_a_non_module_file_by_the_host_kind() -> Bool {
  floor_discovery_accepted_with_row_count(
    result: discover_floor_corpus_rows_from_host_facts(
      source_roots: [fixture_walk_non_module_root],
      exclude_substrings: [],
      owned_data_records: [],
      marked_sources: []
    ),
    count: 0
  )
}

test fn floor_discovery_equivalence_wire_contract_coproduct_scan_holds() -> Bool {
  floor_discovery_content_has_wire_contract_decl(
    content: fixture_wire_contract_coproduct_content()
  )
}

test fn floor_discovery_equivalence_wire_contract_variant_scan_holds() -> Bool {
  floor_discovery_content_has_wire_contract_decl(content: fixture_wire_contract_variant_content())
}

test fn floor_discovery_equivalence_misplaced_wire_contract_refuses_holds() -> Bool {
  match floor_discovery_wire_contract_sidecar_refusal_for_content(
    repo_path: fixture_misplaced_wire_contract_entry,
    content: fixture_misplaced_wire_contract_content()
  ) {
    Present { value: msg } =>
      string_contains(s: msg, pattern: "wire-contract decls")
        && string_contains(s: msg, pattern: "_contracts.dag")
        && string_contains(s: msg, pattern: fixture_misplaced_wire_contract_entry)
    Absent => false
  }
}

test fn floor_discovery_live_tree_malformed_variant_refuses_red_control() -> Bool {
  match floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: fixture_live_tree_malformed_variant_content()
  ) {
    Present { value: msg } => string_contains(s: msg, pattern: "unknown variant")
    Absent => false
  }
}

test fn floor_discovery_live_tree_duplicate_decl_refuses_red_control() -> Bool {
  match floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: fixture_live_tree_duplicate_decl_content()
  ) {
    Present { value: msg } => string_contains(s: msg, pattern: "more than once")
    Absent => false
  }
}

test fn floor_discovery_live_tree_trailing_comment_refuses_red_control() -> Bool {
  match floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: fixture_live_tree_trailing_comment_content()
  ) {
    Present { value: msg } => string_contains(s: msg, pattern: "unknown variant")
    Absent => false
  }
}

test fn floor_discovery_live_tree_disposition_note_sibling_not_declaration_holds() -> Bool {
  match floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: "module m\n\ndata live_tree_disposition_note: String = \"doc row\"\n"
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn floor_discovery_equivalence_rust_tests_named() -> Bool {
  string_contains(
    s: floor_discovery_equivalence_test_sidecar_misplaced,
    pattern: "misplaced_wire_contract_decl_drives_discover_to_err"
  ) && string_contains(
    s: floor_discovery_equivalence_test_scan_wire_contract,
    pattern: "scan_detects_coproduct_wire_contract_data"
  ) && string_contains(
    s: floor_discovery_equivalence_test_narrowed_corpus_control,
    pattern: "clean_dag_file_leaves_narrowed_discovery_ok"
  )
}
