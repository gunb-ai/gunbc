module test.claim.machine_intake_ethernet_witness

import std.types { Bool, String }
import extdeps.boards.types { AmpereMtCollins, AmpereMtJade }
import gunbc.machine_intake_ethernet {
  AttachmentUnobserved,
  BmcNcsi,
  EthernetFunctionBinding,
  HostData,
  PhysicalEthernetPort,
  ethernet_port_may_carry_multiple_functions,
}
import gunbc.machine_intake_power_supply {
  PowerSupplyStanding,
  power_supplies_redundant,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data jade_lower_bmc: PhysicalEthernetPort = PhysicalEthernetPort {
  panel_label: "rear lower I/O row",
  connector_label: "RJ45",
  attachment: AttachmentUnobserved {
    discriminator: "fixture: dedicated BMC jack is onboard; not a unit observation",
  },
}

data jade_upper_left: PhysicalEthernetPort = PhysicalEthernetPort {
  panel_label: "rear upper expansion module left",
  connector_label: "RJ45",
  attachment: AttachmentUnobserved {
    discriminator: "fixture: OCP 3.0 versus PCIe CEM is unobserved until lspci",
  },
}

test fn w_ampere_mt_jade_is_a_distinct_baseboard_arm() -> Bool {
  AmpereMtJade != AmpereMtCollins
}

test fn w_one_port_can_bind_host_data_and_bmc_ncsi() -> Bool {
  ethernet_port_may_carry_multiple_functions(
    a: EthernetFunctionBinding { port: jade_upper_left, function: HostData },
    b: EthernetFunctionBinding { port: jade_upper_left, function: BmcNcsi },
  )
}

test fn w_dedicated_bmc_jack_is_not_the_upper_host_module() -> Bool {
  (jade_lower_bmc.panel_label as String) != (jade_upper_left.panel_label as String)
}

test fn w_present_without_ac_is_not_redundant() -> Bool {
  let powered = PowerSupplyStanding {
    sensor_name: "PSU1",
    present: true,
    ac_input_present: true,
    output_watts: 100,
    fan_rpm: 4000,
  }
  let installed_dark = PowerSupplyStanding {
    sensor_name: "PSU2",
    present: true,
    ac_input_present: false,
    output_watts: 0,
    fan_rpm: 0,
  }
  let both_live = PowerSupplyStanding {
    sensor_name: "PSU2",
    present: true,
    ac_input_present: true,
    output_watts: 80,
    fan_rpm: 4000,
  }
  power_supplies_redundant(a: powered, b: installed_dark) == false
    && power_supplies_redundant(a: powered, b: both_live)
}
