module test.claim.harness_validate_worktree_witness

import std.types { Bool, String, FilePath }
import extdeps.languages.json.emit { json_kv, json_string, json_object }
import gunbc.harness.harness_wire { WireToolUseBlock, HarnessWireShape, AnthropicMessagesShape, OpenAiChatCompletionsShape }
import gunbc.harness.harness_tool {
  HarnessToolEnvironment, harness_tool_environment, HarnessValidationRoute, ValidationNotOffered, ValidationRoutedTo,
  HarnessToolOutcome, ToolCompleted, ToolReport, ToolJob, ToolRefused, ToolEffectRefused, ToolInputMemberMissing,
  harness_execute_tool_use, harness_validate_worktree_call,
}
import gunbc.harness.harness_turn { harness_tool_contract_wire }
import gunbc.harness.harness_cli { harness_worker_system_prompt_at }

// THE WITNESSES OF validate_worktree: a worker's build/test is a SUBMISSION made by the harness
// process, not a second compiler process booted in the worker's cgroup. The dispatch below never
// reaches gunbc.WitnessBin.Run (the only process the run_command tool spawns); the only effectful
// route is gunbc.compute.test_run, whose compute_provide reserves a ComputeBuildPool grant and runs
// the work in its own gunbc-compute-<id> unit (witnessed by gunbc.compute host_capacity and
// work_provider_local witnesses; the belt's validation calls the same compute_provide and is not
// touched by this change).

fn env_with(validation: HarnessValidationRoute) -> HarnessToolEnvironment {
  harness_tool_environment(
    working_directory: "/nonexistent/worktree" as FilePath,
    timeout_program: "/nonexistent/timeout" as FilePath,
    job_output_directory: "/nonexistent/jobs" as FilePath,
    validation: validation,
  )
}

fn call(kind: String, target: String) -> WireToolUseBlock {
  WireToolUseBlock { id: "t1", name: "validate_worktree", input: json_object(members: [
    json_kv(key: "kind", value: json_string(s: kind)),
    json_kv(key: "target", value: json_string(s: target)),
  ]) }
}

// CONTROL: a role with no routed deployment is refused by type; there is no arm that runs the work here.
test fn an_unrouted_role_is_refused_and_never_runs_the_work_itself() -> Bool {
  match harness_execute_tool_use(environment: env_with(validation: ValidationNotOffered), block: call(kind: "test", target: "//dag/test/claim/x/...")).outcome {
    ToolRefused { disposition: ToolEffectRefused { detail: _ } } => true
    ToolRefused { disposition: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolJob { id: _, text: _ } => false
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
  }
}

// RED-then-GREEN on the route: an unresolvable deployment is a typed nonzero result from the compute
// entry (no dashboard instance, so no grant could be asked for), not a fallback run in this process.
test fn a_routed_call_with_no_resolvable_deployment_fails_with_a_typed_result_and_no_fallback() -> Bool {
  match harness_execute_tool_use(environment: env_with(validation: ValidationRoutedTo { repo_root: "/nonexistent/repo" }), block: call(kind: "test", target: "//dag/test/claim/x/...")).outcome {
    ToolCompleted { text, exit_code, standing: _ } => exit_code != 0 && text.contains("no dashboard instance is rooted at /nonexistent/repo")
    ToolRefused { disposition: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolJob { id: _, text: _ } => false
  }
}

test fn an_unknown_validation_kind_is_refused_by_name() -> Bool {
  match harness_execute_tool_use(environment: env_with(validation: ValidationRoutedTo { repo_root: "/nonexistent/repo" }), block: call(kind: "bench", target: "x")).outcome {
    ToolRefused { disposition: ToolEffectRefused { detail } } => detail.contains("kind must be")
    ToolRefused { disposition: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolJob { id: _, text: _ } => false
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
  }
}

test fn a_missing_target_member_is_refused_by_name() -> Bool {
  let block = WireToolUseBlock { id: "t2", name: "validate_worktree", input: json_object(members: [json_kv(key: "kind", value: json_string(s: "test"))]) }
  match harness_execute_tool_use(environment: env_with(validation: ValidationRoutedTo { repo_root: "/nonexistent/repo" }), block: block).outcome {
    ToolRefused { disposition: ToolInputMemberMissing { tool: _, member } } => member == "target"
    ToolRefused { disposition: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolJob { id: _, text: _ } => false
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
  }
}

// THE CONTRACT OFFERS THE TOOL EXACTLY WHEN ROUTED, in both wire shapes.
test fn the_contract_offers_validate_worktree_only_when_routed() -> Bool {
  let routed = ValidationRoutedTo { repo_root: "/r" }
  harness_tool_contract_wire(shape: AnthropicMessagesShape, validation: routed).contains("validate_worktree")
    && harness_tool_contract_wire(shape: OpenAiChatCompletionsShape, validation: routed).contains("validate_worktree")
    && !harness_tool_contract_wire(shape: AnthropicMessagesShape, validation: ValidationNotOffered).contains("validate_worktree")
    && !harness_tool_contract_wire(shape: OpenAiChatCompletionsShape, validation: ValidationNotOffered).contains("validate_worktree")
    && harness_tool_contract_wire(shape: AnthropicMessagesShape, validation: ValidationNotOffered).contains("run_command")
}

// THE AGENT'S HABIT LANDS IN THE RIGHT PLACE: the worker is told to call the tool and is no longer
// handed a `gunbc run` shell command (which boots a second full compiler in its own cgroup).
test fn the_worker_prompt_names_the_tool_and_no_longer_a_gunbc_run_command() -> Bool {
  let prose = harness_worker_system_prompt_at(worktree: "/w")
  prose.contains("validate_worktree")
    && prose.contains(harness_validate_worktree_call(kind: "test", target: "//dag/test/claim/<package>/..."))
    && !prose.contains("gunbc run")
}
