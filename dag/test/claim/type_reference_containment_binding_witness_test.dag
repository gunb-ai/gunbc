module test.claim.type_reference_containment_binding_witness_test


// N2 slice 1 — THREE discriminating controls modeled on the N1a import-strip section 14.1 matrix at fixture grain, plus one API-boundary control for category inadmissibility. The kernel is resolve_type_reference_containment_binding → P2a candidate population → resolve_reference_occurrence_binding → occurrence_binding_from_candidates (OccurrenceBindingResult). No parallel fold, no production lookup_type_by_name changeover, N1a discriminator untouched. Matrix controls: (1) binds when containment exposes the type; (2) refuses when no declaration exists (row 3); (3) pool-coincidence must not bind (row 4). API control: non-TypeOccurrence reference → ReferenceBindingProjectionWrongCategory before candidate enumeration.
fn trcb_module_path(dotted: String) -> std.types.NonEmptyStr {
  dotted as std.types.NonEmptyStr
}

fn trcb_fixture_span(file: String, start: Int, end: Int) -> std.types.SourceSpan {
  std.types.SourceSpan { file: file, start: start, end: end }
}

fn trcb_fixture_path(
  ancestors: List<std.occurrence_identity.OccurrenceId>,
  terminal: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.OccurrenceContainmentPath {
  std.occurrence_identity.OccurrenceContainmentPath {
    ancestors: ancestors,
    terminal: terminal,
  }
}

fn trcb_fixture_index_entry(
  occurrence: std.occurrence_identity.OccurrenceId,
  authored_name: String,
  containment: std.occurrence_identity.OccurrenceContainmentPath
) -> std.occurrence_identity.OccurrenceIndexEntry {
  std.occurrence_identity.OccurrenceIndexEntry {
    projection: std.occurrence_identity.OccurrenceProjection {
      occurrence: occurrence,
      authored_name: authored_name,
      diagnostic_span: trcb_fixture_span(file: "fixture.dag", start: 0, end: 1),
    },
    containment: containment,
  }
}

fn trcb_fixture_declaration(
  occurrence: std.occurrence_identity.OccurrenceId,
  containment: std.occurrence_identity.OccurrenceContainmentPath,
  category: std.occurrence_identity.OccurrenceCategory
) -> std.occurrence_identity.DeclarationOccurrence {
  std.occurrence_identity.DeclarationOccurrence {
    occurrence: occurrence,
    containment: containment,
    category: category,
    diagnostic_span: trcb_fixture_span(file: "fixture.dag", start: 0, end: 1),
  }
}

fn trcb_fixture_reference(
  occurrence: std.occurrence_identity.OccurrenceId,
  containment: std.occurrence_identity.OccurrenceContainmentPath,
  category: std.occurrence_identity.OccurrenceCategory
) -> std.occurrence_identity.ReferenceOccurrence {
  std.occurrence_identity.ReferenceOccurrence {
    occurrence: occurrence,
    containment: containment,
    category: category,
    diagnostic_span: trcb_fixture_span(file: "fixture.dag", start: 0, end: 1),
  }
}

fn trcb_fixture_inputs(
  module_paths: List<std.occurrence_binding_candidates.OccurrenceModulePathRow>,
  exposure_rows: List<std.occurrence_binding_candidates.DeclarationExposureRow>,
  authored_order_rows: List<std.occurrence_binding_candidates.AuthoredOrderRow>
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
    module_paths: module_paths,
    exposure_rows: exposure_rows,
    authored_order_rows: authored_order_rows,
  }
}

fn trcb_authored_order(occurrence: std.occurrence_identity.OccurrenceId, ordinal: Int) -> std.occurrence_binding_candidates.AuthoredOrderRow {
  std.occurrence_binding_candidates.AuthoredOrderRow {
    occurrence: occurrence,
    ordinal: std.occurrence_identity.AuthoredTokenOrdinal { value: ordinal },
  }
}

fn trcb_module_exposure(occurrence: std.occurrence_identity.OccurrenceId, module: String) -> std.occurrence_binding_candidates.DeclarationExposureRow {
  std.occurrence_binding_candidates.DeclarationExposureRow {
    occurrence: occurrence,
    exposure: std.occurrence_binding_candidates.ModuleExposure { module: trcb_module_path(dotted: module) },
  }
}

fn trcb_root_exposure(occurrence: std.occurrence_identity.OccurrenceId) -> std.occurrence_binding_candidates.DeclarationExposureRow {
  std.occurrence_binding_candidates.DeclarationExposureRow {
    occurrence: occurrence,
    exposure: std.occurrence_binding_candidates.RootExposure,
  }
}

// Control 1 (binds): cross-module bare ContentHash with RootExposure on the provider type — OccurrenceBound from the single occurrence_binding_from_candidates fold, no import reachability required.
test fn control_one_containment_bind_holds() -> Bool {
  let type_decl = std.occurrence_identity.OccurrenceId { value: 10 }
  let fn_body = std.occurrence_identity.OccurrenceId { value: 20 }
  let type_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let type_path = trcb_fixture_path(ancestors: [], terminal: type_decl)
  let fn_path = trcb_fixture_path(ancestors: [], terminal: fn_body)
  let ref_path = trcb_fixture_path(ancestors: [fn_body], terminal: type_ref)
  match std.occurrence_binding_candidates.resolve_type_reference_containment_binding(
    transport: std.occurrence_identity.OccurrenceTransport {
      index: std.occurrence_identity.OccurrenceIndex {
        entries: [
          trcb_fixture_index_entry(occurrence: type_decl, authored_name: "ContentHash", containment: type_path),
          trcb_fixture_index_entry(occurrence: fn_body, authored_name: "f", containment: fn_path),
          trcb_fixture_index_entry(occurrence: type_ref, authored_name: "ContentHash", containment: ref_path),
        ],
      },
      declarations: [
        trcb_fixture_declaration(occurrence: type_decl, containment: type_path, category: std.occurrence_identity.TypeOccurrence),
        trcb_fixture_declaration(occurrence: fn_body, containment: fn_path, category: std.occurrence_identity.CallableOccurrence),
      ],
      references: [
        trcb_fixture_reference(occurrence: type_ref, containment: ref_path, category: std.occurrence_identity.TypeOccurrence),
      ],
    },
    inputs: trcb_fixture_inputs(
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: type_decl, module_path: trcb_module_path(dotted: "std.content_hash") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: fn_body, module_path: trcb_module_path(dotted: "extdeps.consumer") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: type_ref, module_path: trcb_module_path(dotted: "extdeps.consumer") },
      ],
      exposure_rows: [
        trcb_root_exposure(occurrence: type_decl),
        trcb_module_exposure(occurrence: fn_body, module: "extdeps.consumer"),
      ],
      authored_order_rows: [
        trcb_authored_order(occurrence: type_decl, ordinal: 1),
        trcb_authored_order(occurrence: fn_body, ordinal: 2),
        trcb_authored_order(occurrence: type_ref, ordinal: 3),
      ],
    ),
    reference: trcb_fixture_reference(occurrence: type_ref, containment: ref_path, category: std.occurrence_identity.TypeOccurrence),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionBound { provider: provider } =>
      provider.declaration_occurrence.value == 10
        && provider.reference_occurrence.value == 30
        && provider.provider_module == trcb_module_path(dotted: "std.content_hash")
        && provider.consumer_module == trcb_module_path(dotted: "extdeps.consumer")
    _ => false
  }
}

// Control 2 (must refuse): N1a row 3 analog — no ContentHash declaration in the transport population; candidate lookup returns empty and occurrence_binding_from_candidates yields OccurrenceUnbound.
test fn control_two_absent_must_refuse_holds() -> Bool {
  let fn_body = std.occurrence_identity.OccurrenceId { value: 20 }
  let type_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let fn_path = trcb_fixture_path(ancestors: [], terminal: fn_body)
  let ref_path = trcb_fixture_path(ancestors: [fn_body], terminal: type_ref)
  match std.occurrence_binding_candidates.resolve_type_reference_containment_binding(
    transport: std.occurrence_identity.OccurrenceTransport {
      index: std.occurrence_identity.OccurrenceIndex {
        entries: [
          trcb_fixture_index_entry(occurrence: fn_body, authored_name: "f", containment: fn_path),
          trcb_fixture_index_entry(occurrence: type_ref, authored_name: "ContentHash", containment: ref_path),
        ],
      },
      declarations: [
        trcb_fixture_declaration(occurrence: fn_body, containment: fn_path, category: std.occurrence_identity.CallableOccurrence),
      ],
      references: [
        trcb_fixture_reference(occurrence: type_ref, containment: ref_path, category: std.occurrence_identity.TypeOccurrence),
      ],
    },
    inputs: trcb_fixture_inputs(
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: fn_body, module_path: trcb_module_path(dotted: "extdeps.consumer") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: type_ref, module_path: trcb_module_path(dotted: "extdeps.consumer") },
      ],
      exposure_rows: [
        trcb_module_exposure(occurrence: fn_body, module: "extdeps.consumer"),
      ],
      authored_order_rows: [
        trcb_authored_order(occurrence: fn_body, ordinal: 1),
        trcb_authored_order(occurrence: type_ref, ordinal: 2),
      ],
    ),
    reference: trcb_fixture_reference(occurrence: type_ref, containment: ref_path, category: std.occurrence_identity.TypeOccurrence),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound { occurrence: unbound } => unbound.value == 30
    _ => false
  }
}

// Control 3 (pool coincidence must not bind): N1a row 4 analog — ContentHash declaration is pool-present (same spelling in transport, symbol_index_lookup would hit on the legacy path) but carries only ModuleExposure for std.content_hash while the reference is in extdeps.consumer with no containment bridge. Kernel must answer OccurrenceUnbound, never treat pool membership as binding authority.
test fn control_three_pool_coincidence_must_not_bind_holds() -> Bool {
  let type_decl = std.occurrence_identity.OccurrenceId { value: 10 }
  let fn_body = std.occurrence_identity.OccurrenceId { value: 20 }
  let type_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let type_path = trcb_fixture_path(ancestors: [], terminal: type_decl)
  let fn_path = trcb_fixture_path(ancestors: [], terminal: fn_body)
  let ref_path = trcb_fixture_path(ancestors: [fn_body], terminal: type_ref)
  match std.occurrence_binding_candidates.resolve_type_reference_containment_binding(
    transport: std.occurrence_identity.OccurrenceTransport {
      index: std.occurrence_identity.OccurrenceIndex {
        entries: [
          trcb_fixture_index_entry(occurrence: type_decl, authored_name: "ContentHash", containment: type_path),
          trcb_fixture_index_entry(occurrence: fn_body, authored_name: "f", containment: fn_path),
          trcb_fixture_index_entry(occurrence: type_ref, authored_name: "ContentHash", containment: ref_path),
        ],
      },
      declarations: [
        trcb_fixture_declaration(occurrence: type_decl, containment: type_path, category: std.occurrence_identity.TypeOccurrence),
        trcb_fixture_declaration(occurrence: fn_body, containment: fn_path, category: std.occurrence_identity.CallableOccurrence),
      ],
      references: [
        trcb_fixture_reference(occurrence: type_ref, containment: ref_path, category: std.occurrence_identity.TypeOccurrence),
      ],
    },
    inputs: trcb_fixture_inputs(
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: type_decl, module_path: trcb_module_path(dotted: "std.content_hash") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: fn_body, module_path: trcb_module_path(dotted: "extdeps.consumer") },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: type_ref, module_path: trcb_module_path(dotted: "extdeps.consumer") },
      ],
      exposure_rows: [
        trcb_module_exposure(occurrence: type_decl, module: "std.content_hash"),
        trcb_module_exposure(occurrence: fn_body, module: "extdeps.consumer"),
      ],
      authored_order_rows: [
        trcb_authored_order(occurrence: type_decl, ordinal: 1),
        trcb_authored_order(occurrence: fn_body, ordinal: 2),
        trcb_authored_order(occurrence: type_ref, ordinal: 3),
      ],
    ),
    reference: trcb_fixture_reference(occurrence: type_ref, containment: ref_path, category: std.occurrence_identity.TypeOccurrence),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionUnbound { occurrence: unbound } => unbound.value == 30
    _ => false
  }
}

// API-boundary control (slice 1 scope note: category inadmissibility): resolve_type_reference_containment_binding refuses a CallableOccurrence reference with ReferenceBindingProjectionWrongCategory before candidate enumeration — not a second binding fold, but the typed entry's category guard must execute.
test fn control_api_non_type_occurrence_refuses_wrong_category_holds() -> Bool {
  let call_ref = std.occurrence_identity.OccurrenceId { value: 30 }
  let ref_path = trcb_fixture_path(ancestors: [std.occurrence_identity.OccurrenceId { value: 20 }], terminal: call_ref)
  match std.occurrence_binding_candidates.resolve_type_reference_containment_binding(
    transport: std.occurrence_identity.OccurrenceTransport {
      index: std.occurrence_identity.OccurrenceIndex {
        entries: [
          trcb_fixture_index_entry(occurrence: call_ref, authored_name: "f", containment: ref_path),
        ],
      },
      declarations: [],
      references: [
        trcb_fixture_reference(occurrence: call_ref, containment: ref_path, category: std.occurrence_identity.CallableOccurrence),
      ],
    },
    inputs: trcb_fixture_inputs(
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: call_ref, module_path: trcb_module_path(dotted: "app.module") },
      ],
      exposure_rows: [],
      authored_order_rows: [
        trcb_authored_order(occurrence: call_ref, ordinal: 1),
      ],
    ),
    reference: trcb_fixture_reference(occurrence: call_ref, containment: ref_path, category: std.occurrence_identity.CallableOccurrence),
  ) {
    std.occurrence_binding_candidates.ReferenceBindingProjectionWrongCategory { occurrence: occurrence, observed: observed } =>
      occurrence.value == 30 && observed == std.occurrence_identity.CallableOccurrence
    _ => false
  }
}

test fn authority_note_names_single_kernel_fold() -> Bool {
  string_contains(s: gunbc.type_reference_containment_binding.type_reference_containment_binding_authority_note, pattern: "occurrence_binding_from_candidates")
    && string_contains(s: gunbc.type_reference_containment_binding.type_reference_containment_binding_authority_note, pattern: "lookup_type_by_name are NOT binding")
    && string_contains(s: gunbc.type_reference_containment_binding.type_reference_containment_binding_slice1_scope_note, pattern: "OUT OF SLICE")
}
