module test.claim.primitive_surface_probe

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn probe_counts() -> Bool {
  let derived = v1_interpreter_derived_arm_count()
  let declared = v1_interpreter_declared_arm_count()
  let rows = v1_interpreter_row_count()
  let sites = dispatch_site_count()
  let ids = distinct_arm_identity_count()
  let spellings = authored_spelling_count()
  println(concat("derived=", to_string(derived)))
  println(concat("declared=", to_string(declared)))
  println(concat("rows=", to_string(rows)))
  println(concat("sites=", to_string(sites)))
  println(concat("identities=", to_string(ids)))
  println(concat("spellings=", to_string(spellings)))
  true
}
