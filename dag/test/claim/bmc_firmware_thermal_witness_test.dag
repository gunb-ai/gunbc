    pre_reboot_temp_soc: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_temp_soc,
    post_reboot_temp_soc: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_temp_soc,
    pre_reboot_tachs: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_tachs,
    post_reboot_tachs: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_tachs,
    post_reboot_active_config_digest: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_active_config_digest,
    post_reboot_controller_active: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_controller_active,
    post_reboot_zone_failsafe_active: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_zone_failsafe_active,
    post_reboot_observer_exit_success: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_observer_exit_success,
    post_reboot_converge_noop_exit_success: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_converge_noop_exit_success,
    observed_at: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.observed_at,
  }
  let construction = bmc_fan_reboot_durability_evidence(receipt: relabeled_receipt)
  let classified = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: srv4_bmc_fan_converged_policy_observation },
    persistence: Present { value: srv4_bmc_config_persistence_observation },
    projection: Present { value: srv4_bmc_fan_projection_capability },
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: construction },
    durability_evidence: [],
  )
  classified.verdict == UnknownRefused
    && match classified.decision {
      Refuse { reason: reason } =>
        string_contains(s: reason, pattern: "durability evidence construction refused")
          && string_contains(
            s: reason,
            pattern: "active config digest does not match the perturbation capability projected config digest",
          )
      Noop => false
      Apply { plan: _ } => false
    }
}

test fn semantically_converged_live_digest_mismatch_refuses_noop() -> Bool {
  let digest_mismatch = extdeps.bmc.types.BmcFanPolicyObservation {
    firmware: srv4_bmc_fan_converged_policy_observation.firmware,
    evidence_scope: HistoricalEvidenceSnapshot,
    curve: fleet_quiet_temp_soc_fan_curve,
    active_config_digest: bmc_fan_witness_digest_mismatch_sentinel,
    selected_config_path: srv4_bmc_fan_converged_policy_observation.selected_config_path,
    board_config_path: srv4_bmc_fan_converged_policy_observation.board_config_path,
    controller_service: srv4_bmc_fan_converged_policy_observation.controller_service,
    controller_binary: srv4_bmc_fan_converged_policy_observation.controller_binary,
    controller_shape: srv4_bmc_fan_converged_policy_observation.controller_shape,
    observed_at: 0,
  }
  let classified = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: digest_mismatch },
    persistence: Present { value: srv4_bmc_config_persistence_observation },
    projection: Present { value: srv4_bmc_fan_projection_capability },
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  classified.verdict == std.upsert_decision.Drifted
    && match classified.decision {
      Apply { plan: _ } => true
      Noop => false
      Refuse { reason: _ } => false
    }
}

test fn drifted_policy_applies_without_prior_durability_evidence() -> Bool {
  let drifted = srv4_fan_policy_with_curve(curve: lazy_onboarding_drift_curve)
  let classified = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: Present { value: srv4_bmc_config_persistence_observation },
    projection: Present { value: srv4_bmc_fan_projection_capability },
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Absent,
    durability_evidence: [],
  )
  classified.verdict == std.upsert_decision.Drifted
    && match classified.decision {
      Apply { plan: _ } => true
      Noop => false
      Refuse { reason: _ } => false
    }
}

test fn srv4_fixture_durability_evidence_is_constructed_not_relabelled() -> Bool {
  match srv4_bmc_fan_durability_evidence_construction {
    BmcFanDurabilityEvidenceBuilt { evidence: evidence } =>
      evidence.admission == srv4_bmc_fan_durability_admission
    BmcFanDurabilityEvidenceConstructionRefused { cause: _ } => false
  }
}

test fn fleet_quiet_curve_admits_srv4_active_config_digest() -> Bool {
  match bmc_fan_admitted_config_digest(
    curve: fleet_quiet_temp_soc_fan_curve,
    intent_curve: fleet_quiet_temp_soc_fan_curve,
    projected_config_digest: Present {
      value: altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest,
    },
  ) {
    AdmittedConfigDigestKnown { digest: digest } =>
      digest == altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest
        && digest == srv4_bmc_fan_projection_capability.projected_config_digest
    AdmittedConfigDigestUnavailable => false
  }
}

test fn non_fleet_curve_admitted_config_digest_is_unavailable() -> Bool {
  match bmc_fan_admitted_config_digest(
    curve: lazy_onboarding_drift_curve,
    intent_curve: fleet_quiet_temp_soc_fan_curve,
    projected_config_digest: Present {
      value: altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest,
    },
  ) {
    AdmittedConfigDigestKnown { digest: _ } => false
    AdmittedConfigDigestUnavailable => true
  }
}

test fn absent_projected_digest_admitted_config_digest_is_unavailable() -> Bool {
  match bmc_fan_admitted_config_digest(
    curve: fleet_quiet_temp_soc_fan_curve,
    intent_curve: fleet_quiet_temp_soc_fan_curve,
    projected_config_digest: none,
  ) {
    AdmittedConfigDigestKnown { digest: _ } => false
    AdmittedConfigDigestUnavailable => true
  }
}

test fn linux_synchronized_publication_admits_commit_barrier() -> Bool {
  match linux_synchronized_rename_replace_publication {
    LinuxSynchronizedRenameReplacePublication => true
    LinuxFilePublicationProtocolUnsynchronized {
      stage_in_target_directory: _,
      staged_content_validated: _,
      replacement: _,
      synchronization: _,
    } => false
  }
    && match srv4_bmc_fan_durability_capability_version.definition_linkage {
      CallerAssertedDefinitionLinkage {
        reason: reason,
    dissolution: symbol_index_subtree_digest_dissolution,
      } =>
        reason as String == "linux synchronized rename-replace publication capability is caller-asserted until SymbolIndex subtree digest"
    }
}

test fn linux_unsynchronized_publication_refuses_commit_barrier() -> Bool {
  let protocol = extdeps.filesystem.linux.LinuxFilePublicationProtocolUnsynchronized {
    stage_in_target_directory: true,
    staged_content_validated: true,
    replacement: ReplacementAtomicityUnspecified,
    synchronization: NoExplicitFilesystemSynchronization,
  }
  match protocol {
    LinuxSynchronizedRenameReplacePublication => false
    LinuxFilePublicationProtocolUnsynchronized {
      stage_in_target_directory: _,
      staged_content_validated: _,
      replacement: _,
      synchronization: _,
    } => true
  }
}

test fn reboot_durability_evidence_refuses_non_positive_interval() -> Bool {
  let zero_duration_receipt = gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt {
    evidence_scope: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.evidence_scope,
    host: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.host,
    perturbation_receipt_id: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.perturbation_receipt_id,
    perturbation_generation: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.perturbation_generation,
    perturbation_capability: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.perturbation_capability,
    before: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.before,
    post_reboot_policy: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_policy,
    reset: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.reset,
    bmc_down_observed: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed,
    bmc_returned: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.bmc_returned,
    bmc_down_observed_at: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed_at,
    bmc_returned_at: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.reset.observed_at,
    host_power_before: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.host_power_before,
    host_power_after: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.host_power_after,
    host_os_ssh_reachable_throughout: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.host_os_ssh_reachable_throughout,
    pre_reboot_temp_soc: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_temp_soc,
    post_reboot_temp_soc: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_temp_soc,
    pre_reboot_tachs: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_tachs,
    post_reboot_tachs: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_tachs,
    post_reboot_active_config_digest: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_active_config_digest,
    post_reboot_controller_active: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_controller_active,
    post_reboot_zone_failsafe_active: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_zone_failsafe_active,
    post_reboot_observer_exit_success: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_observer_exit_success,
    post_reboot_converge_noop_exit_success: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_converge_noop_exit_success,
    observed_at: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.observed_at,
  }
  match bmc_fan_reboot_durability_evidence(
    receipt: zero_duration_receipt,
  ) {
    BmcFanDurabilityEvidenceConstructionRefused {
      cause: DurabilityReceiptNonPositiveInterval {
        cause: PositiveMeasureCountNonPositive { observed: 0 },
      },
    } => true
    BmcFanDurabilityEvidenceBuilt { evidence: _ } => false
  }
}
