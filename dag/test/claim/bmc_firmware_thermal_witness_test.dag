test fn bmc_fan_durability_refusal_reason_surfaces_generation_mismatch() -> Bool {
  let reason = gunbc.bmc_converge.bmc_fan_durability_refusal_reason(
    verdict: std.state_durability.StateDurabilityRefused {
      cause: std.state_durability.DurabilityPerturbationGenerationMismatch {
        expected: 1,
        observed: 2,
      },
    },
  )
  string_contains(s: reason, pattern: "perturbation generation mismatch")
    && string_contains(s: reason, pattern: "expected 1")
    && string_contains(s: reason, pattern: "observed 2")
    && !string_contains(
      s: reason,
      pattern: "does not satisfy the declared state lifetime",
    )
}

