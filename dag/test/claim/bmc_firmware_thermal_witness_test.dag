    post_reboot_temp_soc: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_temp_soc,
    pre_reboot_tachs: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_tachs,
    post_reboot_tachs: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_tachs,
    post_reboot_active_config_digest: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_active_config_digest,
    post_reboot_controller_active: gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt.post_reboot_controller_active,
