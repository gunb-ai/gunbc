  let stale_topology = extdeps.bmc.types.BmcFanPolicyObservation {
    firmware: asrock_altrad8ud_openbmc_3_22_00_fan_policy_observation.firmware,
    evidence_scope: HistoricalEvidenceSnapshot,
    curve: fleet_quiet_temp_soc_fan_curve,
    active_config_digest: srv4_bmc_fan_active_config_digest,
    selected_config_path: asrock_altrad8ud_openbmc_3_22_00_fan_policy_observation.selected_config_path,
    board_config_path: asrock_altrad8ud_openbmc_3_22_00_fan_policy_observation.board_config_path,
    controller_service: asrock_altrad8ud_openbmc_3_22_00_fan_policy_observation.controller_service,
    controller_binary: asrock_altrad8ud_openbmc_3_22_00_fan_policy_observation.controller_binary,
    controller_shape: asrock_altrad8ud_openbmc_3_22_00_fan_policy_observation.controller_shape,
    observed_at: 0,
  }
  let classified = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: stale_topology },
    persistence: Present { value: srv4_bmc_config_persistence_observation },
    projection: Present { value: srv4_bmc_fan_projection_capability },
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  classified.verdict == std.upsert_decision.Drifted
    && match classified.decision {
      Apply { plan: _ } => true
      Noop => false
      Refuse { reason: _ } => false
    }
}

test fn drifted_srv4_curve_builds_typed_overlay_plan_only_with_exact_projection_and_persistence() -> Bool {
  let drifted = srv4_fan_policy_with_curve(curve: lazy_onboarding_drift_curve)
  let with_storage = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: Present { value: srv4_bmc_config_persistence_observation },
    projection: Present { value: srv4_bmc_fan_projection_capability },
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  let without_storage = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: none,
    projection: Present { value: srv4_bmc_fan_projection_capability },
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  let without_projection = bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: Present { value: srv4_bmc_config_persistence_observation },
    projection: none,
    durability_generation: srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  with_storage.verdict == std.upsert_decision.Drifted
    && match with_storage.decision {
      Apply { plan: plan } =>
        plan.host == srv4_host.identity
          && plan.config_path == "/usr/share/swampd/config-asrr.json"
          && plan.controller_service == "phosphor-pid-control.service"
          && plan.desired_curve == fleet_quiet_temp_soc_fan_curve
          && plan.projection == srv4_bmc_fan_projection_capability
      Noop => false
      Refuse { reason: _ } => false
    }
    && without_storage.verdict == UnknownRefused
    && match without_storage.decision {
      Refuse { reason: _ } => true
      Noop => false
      Apply { plan: _ } => false
    }
    && without_projection.verdict == UnknownRefused
    && match without_projection.decision {
      Refuse { reason: _ } => true
      Noop => false
      Apply { plan: _ } => false
    }
}

