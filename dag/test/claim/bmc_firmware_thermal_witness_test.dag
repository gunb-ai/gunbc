test fn srv3_fan_realization_refuses_until_global_firmware_track_converges() -> Bool {
  let classified = bmc_fan_policy_classification(
    host: srv3_host.identity,
    board: srv3_baseboard.catalog.model,
    intent: fleet_bmc_valid_state,
    observation: Present {
      value: asrock_altrad8ud_openbmc_2_07_00_fan_policy_observation,
    },
    persistence: none,
    projection: none,
    durability_generation: 1,
    durability_evidence: [],
  )
  classified.verdict == Conflict
    && match classified.decision {
      Refuse { reason: _ } => true
      Noop => false
      Apply { plan: _ } => false
    }
}
