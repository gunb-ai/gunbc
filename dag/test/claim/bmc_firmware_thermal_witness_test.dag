test fn reboot_durability_evidence_refuses_relabeled_perturbation_capability_digest() -> Bool {
  let relabeled_receipt = gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt {
    evidence_scope: srv4_bmc_fan_reboot_persistence_receipt.evidence_scope,
    host: srv4_bmc_fan_reboot_persistence_receipt.host,
    perturbation_receipt_id: srv4_bmc_fan_reboot_persistence_receipt.perturbation_receipt_id,
    perturbation_generation: srv4_bmc_fan_reboot_persistence_receipt.perturbation_generation,
    perturbation_capability: gunbc.bmc_fan_projection.BmcFanPolicyProjectionCapability {
      board: srv4_bmc_fan_projection_capability.board,
      firmware: srv4_bmc_fan_projection_capability.firmware,
      projected_curve: srv4_bmc_fan_projection_capability.projected_curve,
      projected_config_digest: gunbc.bmc_fan_projection.bmc_fan_witness_digest_mismatch_sentinel,
      config_path: srv4_bmc_fan_projection_capability.config_path,
      controller_service: srv4_bmc_fan_projection_capability.controller_service,
      controller_zone_path: srv4_bmc_fan_projection_capability.controller_zone_path,
      aggregate_fan_pid_entry: srv4_bmc_fan_projection_capability.aggregate_fan_pid_entry,
      realization: srv4_bmc_fan_projection_capability.realization,
      durability_capability_version: std.state_durability.StateDurabilityCapabilityVersion {
        version: "relabelled-capability",
        definition_linkage: std.state_durability.CallerAssertedDefinitionLinkage {
          reason: "relabelled-capability-linkage" as std.types.NonEmptyStr,
    dissolution: symbol_index_subtree_digest_dissolution,
        },
      },
      publication_protocol: srv4_bmc_fan_projection_capability.publication_protocol,
      durability_boundaries: srv4_bmc_fan_projection_capability.durability_boundaries,
      required_tach_inputs: srv4_bmc_fan_projection_capability.required_tach_inputs,
    },
    before: srv4_bmc_fan_reboot_persistence_receipt.before,
    post_reboot_policy: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_policy,
    reset: srv4_bmc_fan_reboot_persistence_receipt.reset,
    bmc_down_observed: srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed,
    bmc_returned: srv4_bmc_fan_reboot_persistence_receipt.bmc_returned,
    bmc_down_observed_at: srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed_at,
    bmc_returned_at: srv4_bmc_fan_reboot_persistence_receipt.bmc_returned_at,
    host_power_before: srv4_bmc_fan_reboot_persistence_receipt.host_power_before,
    host_power_after: srv4_bmc_fan_reboot_persistence_receipt.host_power_after,
    host_os_ssh_reachable_throughout: srv4_bmc_fan_reboot_persistence_receipt.host_os_ssh_reachable_throughout,
    pre_reboot_temp_soc: srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_temp_soc,
    post_reboot_temp_soc: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_temp_soc,
    pre_reboot_tachs: srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_tachs,
    post_reboot_tachs: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_tachs,
    post_reboot_active_config_digest: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_active_config_digest,
    post_reboot_controller_active: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_controller_active,
    post_reboot_zone_failsafe_active: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_zone_failsafe_active,
    post_reboot_observer_exit_success: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_observer_exit_success,
    post_reboot_converge_noop_exit_success: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_converge_noop_exit_success,
    observed_at: srv4_bmc_fan_reboot_persistence_receipt.observed_at,
  }
  match gunbc.fleet_bmc_state.bmc_fan_reboot_durability_evidence(receipt: relabeled_receipt) {
    gunbc.fleet_bmc_state.BmcFanDurabilityEvidenceConstructionRefused {
      cause: gunbc.fleet_bmc_state.DurabilityReceiptDigestMismatch,
    } => true
    gunbc.fleet_bmc_state.BmcFanDurabilityEvidenceBuilt { evidence: _ } => false
  }
}

test fn relabeled_reboot_construction_refusal_propagates_through_classification() -> Bool {
  let relabeled_receipt = gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt {
    evidence_scope: srv4_bmc_fan_reboot_persistence_receipt.evidence_scope,
    host: srv4_bmc_fan_reboot_persistence_receipt.host,
    perturbation_receipt_id: srv4_bmc_fan_reboot_persistence_receipt.perturbation_receipt_id,
    perturbation_generation: srv4_bmc_fan_reboot_persistence_receipt.perturbation_generation,
    perturbation_capability: gunbc.bmc_fan_projection.BmcFanPolicyProjectionCapability {
      board: srv4_bmc_fan_projection_capability.board,
      firmware: srv4_bmc_fan_projection_capability.firmware,
      projected_curve: srv4_bmc_fan_projection_capability.projected_curve,
      projected_config_digest: gunbc.bmc_fan_projection.bmc_fan_witness_digest_mismatch_sentinel,
      config_path: srv4_bmc_fan_projection_capability.config_path,
      controller_service: srv4_bmc_fan_projection_capability.controller_service,
      controller_zone_path: srv4_bmc_fan_projection_capability.controller_zone_path,
      aggregate_fan_pid_entry: srv4_bmc_fan_projection_capability.aggregate_fan_pid_entry,
      realization: srv4_bmc_fan_projection_capability.realization,
      durability_capability_version: srv4_bmc_fan_projection_capability.durability_capability_version,
      publication_protocol: srv4_bmc_fan_projection_capability.publication_protocol,
      durability_boundaries: srv4_bmc_fan_projection_capability.durability_boundaries,
      required_tach_inputs: srv4_bmc_fan_projection_capability.required_tach_inputs,
    },
    before: srv4_bmc_fan_reboot_persistence_receipt.before,
    post_reboot_policy: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_policy,
    reset: srv4_bmc_fan_reboot_persistence_receipt.reset,
    bmc_down_observed: srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed,
    bmc_returned: srv4_bmc_fan_reboot_persistence_receipt.bmc_returned,
    bmc_down_observed_at: srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed_at,
    bmc_returned_at: srv4_bmc_fan_reboot_persistence_receipt.bmc_returned_at,
    host_power_before: srv4_bmc_fan_reboot_persistence_receipt.host_power_before,
    host_power_after: srv4_bmc_fan_reboot_persistence_receipt.host_power_after,
    host_os_ssh_reachable_throughout: srv4_bmc_fan_reboot_persistence_receipt.host_os_ssh_reachable_throughout,
    pre_reboot_temp_soc: srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_temp_soc,
    post_reboot_temp_soc: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_temp_soc,
    pre_reboot_tachs: srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_tachs,
    post_reboot_tachs: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_tachs,
    post_reboot_active_config_digest: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_active_config_digest,
    post_reboot_controller_active: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_controller_active,
    post_reboot_zone_failsafe_active: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_zone_failsafe_active,
    post_reboot_observer_exit_success: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_observer_exit_success,
    post_reboot_converge_noop_exit_success: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_converge_noop_exit_success,
    observed_at: srv4_bmc_fan_reboot_persistence_receipt.observed_at,
  }
  let construction = gunbc.fleet_bmc_state.bmc_fan_reboot_durability_evidence(receipt: relabeled_receipt)
  let classified = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_fan_converged_policy_observation },
    persistence: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation },
    projection: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability },
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: construction },
    durability_evidence: [],
  )
  classified.verdict == std.upsert_decision.UnknownRefused
    && match classified.decision {
      std.upsert_decision.Refuse { reason: reason } =>
        string_contains(s: reason, pattern: "durability evidence construction refused")
          && string_contains(
            s: reason,
            pattern: "active config digest does not match the perturbation capability projected config digest",
          )
      std.upsert_decision.Noop => false
      std.upsert_decision.Apply { plan: _ } => false
    }
}

test fn semantically_converged_live_digest_mismatch_refuses_noop() -> Bool {
  let digest_mismatch = extdeps.bmc.types.BmcFanPolicyObservation {
    firmware: srv4_bmc_fan_converged_policy_observation.firmware,
    evidence_scope: extdeps.bmc.capability.HistoricalEvidenceSnapshot,
    curve: gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve,
    active_config_digest: gunbc.bmc_fan_projection.bmc_fan_witness_digest_mismatch_sentinel,
    selected_config_path: srv4_bmc_fan_converged_policy_observation.selected_config_path,
    board_config_path: srv4_bmc_fan_converged_policy_observation.board_config_path,
    controller_service: srv4_bmc_fan_converged_policy_observation.controller_service,
    controller_binary: srv4_bmc_fan_converged_policy_observation.controller_binary,
    controller_shape: srv4_bmc_fan_converged_policy_observation.controller_shape,
    observed_at: 0,
  }
  let classified = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: digest_mismatch },
    persistence: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation },
    projection: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability },
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  classified.verdict == std.upsert_decision.Drifted
    && match classified.decision {
      std.upsert_decision.Apply { plan: _ } => true
      std.upsert_decision.Noop => false
      std.upsert_decision.Refuse { reason: _ } => false
    }
}

test fn drifted_policy_applies_without_prior_durability_evidence() -> Bool {
  let drifted = srv4_fan_policy_with_curve(curve: lazy_onboarding_drift_curve)
  let classified = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation },
    projection: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability },
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Absent,
    durability_evidence: [],
  )
  classified.verdict == std.upsert_decision.Drifted
    && match classified.decision {
      std.upsert_decision.Apply { plan: _ } => true
      std.upsert_decision.Noop => false
      std.upsert_decision.Refuse { reason: _ } => false
    }
}

test fn srv4_fixture_durability_evidence_is_constructed_not_relabelled() -> Bool {
  match gunbc.fleet_bmc_state.srv4_bmc_fan_durability_evidence_construction {
    gunbc.fleet_bmc_state.BmcFanDurabilityEvidenceBuilt { evidence: evidence } =>
      evidence.admission == gunbc.fleet_bmc_state.srv4_bmc_fan_durability_admission
    gunbc.fleet_bmc_state.BmcFanDurabilityEvidenceConstructionRefused { cause: _ } => false
  }
}

test fn fleet_quiet_curve_admits_srv4_active_config_digest() -> Bool {
  match gunbc.bmc_fan_projection.bmc_fan_admitted_config_digest(
    curve: gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve,
    intent_curve: gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve,
    projected_config_digest: Present {
      value: gunbc.bmc_fan_projection.altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest,
    },
  ) {
    gunbc.bmc_fan_projection.AdmittedConfigDigestKnown { digest: digest } =>
      digest == gunbc.bmc_fan_projection.altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest
        && digest == srv4_bmc_fan_projection_capability.projected_config_digest
    gunbc.bmc_fan_projection.AdmittedConfigDigestUnavailable => false
  }
}

test fn non_fleet_curve_admitted_config_digest_is_unavailable() -> Bool {
  match gunbc.bmc_fan_projection.bmc_fan_admitted_config_digest(
    curve: lazy_onboarding_drift_curve,
    intent_curve: gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve,
    projected_config_digest: Present {
      value: gunbc.bmc_fan_projection.altrad8ud_openbmc_322_fleet_quiet_temp_soc_projected_config_digest,
    },
  ) {
    gunbc.bmc_fan_projection.AdmittedConfigDigestKnown { digest: _ } => false
    gunbc.bmc_fan_projection.AdmittedConfigDigestUnavailable => true
  }
}

test fn absent_projected_digest_admitted_config_digest_is_unavailable() -> Bool {
  match gunbc.bmc_fan_projection.bmc_fan_admitted_config_digest(
    curve: gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve,
    intent_curve: gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve,
    projected_config_digest: none,
  ) {
    gunbc.bmc_fan_projection.AdmittedConfigDigestKnown { digest: _ } => false
    gunbc.bmc_fan_projection.AdmittedConfigDigestUnavailable => true
  }
}

test fn linux_synchronized_publication_admits_commit_barrier() -> Bool {
  match extdeps.filesystem.linux.linux_synchronized_rename_replace_publication {
    extdeps.filesystem.linux.LinuxSynchronizedRenameReplacePublication => true
    extdeps.filesystem.linux.LinuxFilePublicationProtocolUnsynchronized {
      stage_in_target_directory: _,
      staged_content_validated: _,
      replacement: _,
      synchronization: _,
    } => false
  }
    && match srv4_bmc_fan_durability_capability_version.definition_linkage {
      std.state_durability.CallerAssertedDefinitionLinkage {
        reason: reason,
    dissolution: symbol_index_subtree_digest_dissolution,
      } =>
        reason as String == "linux synchronized rename-replace publication capability is caller-asserted until SymbolIndex subtree digest"
    }
}

test fn linux_unsynchronized_publication_refuses_commit_barrier() -> Bool {
  let protocol = extdeps.filesystem.linux.LinuxFilePublicationProtocolUnsynchronized {
    stage_in_target_directory: true,
    staged_content_validated: true,
    replacement: extdeps.filesystem.linux.ReplacementAtomicityUnspecified,
    synchronization: extdeps.filesystem.linux.NoExplicitFilesystemSynchronization,
  }
  match protocol {
    extdeps.filesystem.linux.LinuxSynchronizedRenameReplacePublication => false
    extdeps.filesystem.linux.LinuxFilePublicationProtocolUnsynchronized {
      stage_in_target_directory: _,
      staged_content_validated: _,
      replacement: _,
      synchronization: _,
    } => true
  }
}

test fn reboot_durability_evidence_refuses_non_positive_interval() -> Bool {
  let zero_duration_receipt = gunbc.fleet_bmc_observation.BmcFanRebootPersistenceReceipt {
    evidence_scope: srv4_bmc_fan_reboot_persistence_receipt.evidence_scope,
    host: srv4_bmc_fan_reboot_persistence_receipt.host,
    perturbation_receipt_id: srv4_bmc_fan_reboot_persistence_receipt.perturbation_receipt_id,
    perturbation_generation: srv4_bmc_fan_reboot_persistence_receipt.perturbation_generation,
    perturbation_capability: srv4_bmc_fan_reboot_persistence_receipt.perturbation_capability,
    before: srv4_bmc_fan_reboot_persistence_receipt.before,
    post_reboot_policy: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_policy,
    reset: srv4_bmc_fan_reboot_persistence_receipt.reset,
    bmc_down_observed: srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed,
    bmc_returned: srv4_bmc_fan_reboot_persistence_receipt.bmc_returned,
    bmc_down_observed_at: srv4_bmc_fan_reboot_persistence_receipt.bmc_down_observed_at,
    bmc_returned_at: srv4_bmc_fan_reboot_persistence_receipt.reset.observed_at,
    host_power_before: srv4_bmc_fan_reboot_persistence_receipt.host_power_before,
    host_power_after: srv4_bmc_fan_reboot_persistence_receipt.host_power_after,
    host_os_ssh_reachable_throughout: srv4_bmc_fan_reboot_persistence_receipt.host_os_ssh_reachable_throughout,
    pre_reboot_temp_soc: srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_temp_soc,
    post_reboot_temp_soc: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_temp_soc,
    pre_reboot_tachs: srv4_bmc_fan_reboot_persistence_receipt.pre_reboot_tachs,
    post_reboot_tachs: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_tachs,
    post_reboot_active_config_digest: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_active_config_digest,
    post_reboot_controller_active: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_controller_active,
    post_reboot_zone_failsafe_active: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_zone_failsafe_active,
    post_reboot_observer_exit_success: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_observer_exit_success,
    post_reboot_converge_noop_exit_success: srv4_bmc_fan_reboot_persistence_receipt.post_reboot_converge_noop_exit_success,
    observed_at: srv4_bmc_fan_reboot_persistence_receipt.observed_at,
  }
  match gunbc.fleet_bmc_state.bmc_fan_reboot_durability_evidence(
    receipt: zero_duration_receipt,
  ) {
    gunbc.fleet_bmc_state.BmcFanDurabilityEvidenceConstructionRefused {
      cause: gunbc.fleet_bmc_state.DurabilityReceiptNonPositiveInterval {
        cause: std.measure.PositiveMeasureCountNonPositive { observed: 0 },
      },
    } => true
    gunbc.fleet_bmc_state.BmcFanDurabilityEvidenceBuilt { evidence: _ } => false
  }
}
