test fn drifted_srv4_curve_builds_typed_overlay_plan_only_with_exact_projection_and_persistence() -> Bool {
  let drifted = srv4_fan_policy_with_curve(curve: lazy_onboarding_drift_curve)
  let with_storage = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation },
    projection: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability },
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  let without_storage = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: none,
    projection: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability },
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  let without_projection = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: drifted },
    persistence: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation },
    projection: none,
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  with_storage.verdict == std.upsert_decision.Drifted
    && match with_storage.decision {
      std.upsert_decision.Apply { plan: plan } =>
        plan.host == srv4_host.identity
          && plan.config_path == "/usr/share/swampd/config-asrr.json"
          && plan.controller_service == "phosphor-pid-control.service"
          && plan.desired_curve == gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve
          && plan.projection == gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability
      std.upsert_decision.Noop => false
      std.upsert_decision.Refuse { reason: _ } => false
    }
    && without_storage.verdict == std.upsert_decision.UnknownRefused
    && match without_storage.decision {
      std.upsert_decision.Refuse { reason: _ } => true
      std.upsert_decision.Noop => false
      std.upsert_decision.Apply { plan: _ } => false
    }
    && without_projection.verdict == std.upsert_decision.UnknownRefused
    && match without_projection.decision {
      std.upsert_decision.Refuse { reason: _ } => true
      std.upsert_decision.Noop => false
      std.upsert_decision.Apply { plan: _ } => false
    }
}

