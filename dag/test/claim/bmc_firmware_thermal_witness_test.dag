test fn srv4_bmc_reboot_persistence_receipt_proves_same_config_and_noop() -> Bool {
  let receipt = gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt
  let classified = gunbc.bmc_converge.bmc_fan_policy_classification(
    host: srv4_host.identity,
    board: srv4_baseboard.catalog.model,
    intent: gunbc.bmc_intent.fleet_bmc_valid_state,
    observation: Present { value: receipt.post_reboot_policy },
    persistence: Present { value: gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation },
    projection: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_projection_capability },
    durability_generation: gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation,
    durability_evidence_construction: Present { value: gunbc.fleet_bmc_state.srv4_bmc_fan_durability_evidence_construction },
    durability_evidence: [],
  )
  receipt.reset.action_target == "/redfish/v1/Managers/bmc/Actions/Manager.Reset"
    && receipt.reset.reset_type == extdeps.bmc.types.ResetGracefulRestart
    && receipt.reset.http_status == 200
    && receipt.reset.accepted
    && receipt.bmc_down_observed
    && receipt.bmc_returned
    && receipt.bmc_returned_at - receipt.bmc_down_observed_at == 170000
    && receipt.host_power_before == extdeps.bmc.types.On
    && receipt.host_power_after == extdeps.bmc.types.On
    && receipt.host_os_ssh_reachable_throughout
    && receipt.before.active_config_digest == receipt.post_reboot_active_config_digest
    && receipt.post_reboot_policy.curve == gunbc.bmc_intent.fleet_quiet_temp_soc_fan_curve
    && receipt.post_reboot_tachs.length() == 4
    && fold(
      receipt.post_reboot_tachs,
      init: true,
      f: (healthy, tach) => healthy && std.measure.rpm_count(tach.reading) > 0,
    )
    && (std.measure.celsius_count(receipt.post_reboot_temp_soc) < std.measure.celsius_count(fleet_bmc_valid_state.fan_policy.thermal_guard.processor_rollback_temperature))
    && receipt.post_reboot_controller_active
    && !receipt.post_reboot_zone_failsafe_active
    && receipt.post_reboot_observer_exit_success
    && receipt.post_reboot_converge_noop_exit_success
    && classified.verdict == std.upsert_decision.UnknownRefused
    && match classified.decision {
      std.upsert_decision.Refuse { reason: reason } =>
        string_contains(s: reason, pattern: "caller-asserted definition linkages")
          && string_contains(s: reason, pattern: "count 6")
      std.upsert_decision.Noop => false
      std.upsert_decision.Apply { plan: _ } => false
    }
}

