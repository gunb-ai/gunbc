module test.claim.compiler_frontend_program_status_witness

import std.types { NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.witness_admission { DiscoverySelection, NoConsumer }
import gunbc.compiler_frontend_program_interlock {
  SelfHostWholeCorpusPopulationDerived,
  SelfHostRatchetObservationEnrolled,
  SelfHostEmitterProducesEveryRetainedArtifact,
  NamespaceFirstSemanticWave,
  milestone_label,
}
import gunbc.compiler_frontend_program_status {
  MilestoneStanding,
  Clear,
  Outstanding,
  NotDerivable,
  MissingInstrument,
  WholeCorpusEmissionBoard,
  NamespaceStepSubjectRoster,
  RequiredCiPhaseRoster,
  all_missing_instruments,
  InstrumentObstacle,
  NotBuilt,
  RefusedByAuthority,
  missing_instrument_obstacle,
  StandingCensus,
  standing_census,
  program_standing_census,
  milestones_awaiting,
  missing_instrument_label,
  Startability,
  StartablePrerequisitesClear,
  BlockedOnPrerequisites,
  StartabilityNotDerivable,
  observe_outstanding,
  standing_from_evidence,
  ratchet_observation_outstanding,
  milestone_status,
  milestone_startability,
  program_milestones,
  report,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHY THESE ARMS EXIST IN PAIRS. DESIGN section 4b(1) requires a discriminating RED beside an
// accepted positive control, and DESIGN section 4b's decoration rule requires asking whether the
// forbidden state is AUTHORABLE before writing a check. Both arms of every fold below are
// authorable here, and several are executed against a fixture population this file authors
// independently of the live one -- so a claim cannot be satisfied by the tree happening to be in
// one state.

fn standing_is_clear(s: MilestoneStanding) -> Bool {
  match s {
    Clear { evidence: _ } => true
    Outstanding { evidence: _ } => false
    NotDerivable { why: _, cause: _ } => false
  }
}

fn standing_is_outstanding(s: MilestoneStanding) -> Bool {
  match s {
    Clear { evidence: _ } => false
    Outstanding { evidence: _ } => true
    NotDerivable { why: _, cause: _ } => false
  }
}

fn standing_outstanding_members(s: MilestoneStanding) -> List<String> {
  match s {
    Clear { evidence: _ } => []
    Outstanding { evidence } => evidence.outstanding
    NotDerivable { why: _, cause: _ } => []
  }
}

// THE POSITIVE CONTROL FOR Clear. Without it, every live arm below could be green because the fold
// is incapable of returning Clear at all -- the permanently-red twin of a decoration.
test fn an_empty_observed_population_is_clear() -> Bool {
  standing_is_clear(
    s: standing_from_evidence(
      e: observe_outstanding(subject: "fixture" as NonEmptyStr, outstanding: [])
    )
  )
}

// THE DISCRIMINATING RED for the same fold, over a population this file authors.
test fn a_populated_observation_is_outstanding_not_clear() -> Bool {
  let s = standing_from_evidence(
    e: observe_outstanding(subject: "fixture" as NonEmptyStr, outstanding: ["planted-member"])
  )
  standing_is_outstanding(s: s)
    && count(standing_outstanding_members(s: s)) == 1
}

// THE LIVE CLAIM, at identity grain rather than by count. It reds if the arm stops reading the
// stage0 divergence roster, if it fabricates Clear, and -- this is the half a count would miss --
// if the arm is narrowed to read only ONE of the two rosters the divergent row's own restoration
// trigger names. It reds the day the emitter closes the gap, which is deliberate: that is a
// change this file must be re-read on, not one it should survive.
test fn the_emitter_artifact_milestone_reports_both_halves_of_its_population() -> Bool {
  let s = milestone_status(m: SelfHostEmitterProducesEveryRetainedArtifact)
  let members = standing_outstanding_members(s: s)
  standing_is_outstanding(s: s)
    && any(members, n => n == "stage0-divergent:main")
    && any(members, n => starts_with(s: n, prefix: "cli-emitter-gap:"))
}

// S4a, live. Today the ratchet runner declares NoConsumer, so the milestone is OUTSTANDING.
test fn the_ratchet_observation_milestone_is_outstanding_today() -> Bool {
  standing_is_outstanding(s: milestone_status(m: SelfHostRatchetObservationEnrolled))
}

// AND THE FUNCTION BEHIND IT IS NOT CONSTANT, which is what keeps the arm above from being a
// decoration: handed a cadence that HAS a scheduled route it returns the empty population.
test fn the_ratchet_observation_fold_answers_both_ways() -> Bool {
  count(ratchet_observation_outstanding(cadence: DiscoverySelection)) == 0
    && count(ratchet_observation_outstanding(cadence: NoConsumer)) == 1
}

// STARTABILITY IS FAIL-CLOSED. NamespaceFirstSemanticWave depends on SelfHostRatchetGateEnrolled,
// which is NotDerivable, so its startability must be NotDerivable -- never BlockedOnPrerequisites,
// which would report a missing instrument as ordinary pending work, and never Startable.
test fn an_unanswerable_prerequisite_makes_startability_unanswerable() -> Bool {
  match milestone_startability(m: NamespaceFirstSemanticWave) {
    StartablePrerequisitesClear => false
    BlockedOnPrerequisites { blocking: _ } => false
    StartabilityNotDerivable { unanswerable } => count(unanswerable) > 0
  }
}

// THE POSITIVE CONTROL FOR THE SAME FOLD: a milestone with no prerequisites is startable, so the
// arm above is not green merely because the fold always answers NotDerivable.
test fn a_milestone_with_no_prerequisites_is_startable() -> Bool {
  match milestone_startability(m: SelfHostWholeCorpusPopulationDerived) {
    StartablePrerequisitesClear => true
    BlockedOnPrerequisites { blocking: _ } => false
    StartabilityNotDerivable { unanswerable: _ } => false
  }
}

// THE ANTI-INFLATION CLAIM, and it is written to RED on a genuine climb rather than to survive one.
// No milestone in this program is CLEAR today. The day one is, this claim fails and whoever made it
// true must re-read this file rather than inherit a status carrier that quietly started saying DONE.
test fn no_milestone_reads_clear_today() -> Bool {
  all(program_milestones, m => !standing_is_clear(s: milestone_status(m: m)))
}

// THE ROSTER IS A COUNTED SECOND REPRESENTATION, and this claim is stated at exactly the strength
// it has rather than one step above it. `program_milestones` is authored beside the interlock's
// closed variant because `.dag` offers no way to enumerate a coproduct's inhabitants, so it can
// drift: adding a fourteenth variant to the interlock does NOT red here. What this arm does hold is
// that the roster carries fourteen DISTINCT milestones -- a duplicated entry, which would silently
// double a row in the report and inflate any population read off it, reds. The missing wall is a
// derived enumeration, and it is this module's own next-rung trigger for the roster.
test fn the_milestone_roster_entries_are_distinct() -> Bool {
  let labels = program_milestones |> map(m => milestone_label(m: m))
  count(labels) == 14
    && all(labels, l => count(labels |> filter(other => other == l)) == 1)
}

// The report renders. It is the operator-facing surface and a report that returns nothing is the
// same non-answer as a missing instrument, wearing a better name.
test fn the_report_renders() -> Bool {
  report() != ""
}

// THE LEVERAGE JOIN IS DERIVED, AND THESE TWO ARMS ARE WHAT KEEP IT FROM BEING A HAND COUNT.
// Today two instruments answer three milestones each and six answer one each -- so the twelve
// unanswerable milestones are EIGHT problems, not one and not twelve. Asserting the exact
// membership rather than the totals is the identity join DESIGN's oracle rule demands: a count
// equality would go green the moment two milestones moved in opposite directions.
test fn the_whole_corpus_board_unblocks_exactly_its_three_milestones() -> Bool {
  let waiting = milestones_awaiting(i: WholeCorpusEmissionBoard)
  count(waiting) == 3
    && any(waiting, l => l == milestone_label(m: SelfHostWholeCorpusPopulationDerived))
}

// THE DISCRIMINATING ARM FOR THE SAME JOIN: an instrument that answers ONE milestone must not
// report three, which is what a fold accidentally ignoring its predicate would produce.
test fn a_single_milestone_instrument_reports_one() -> Bool {
  count(milestones_awaiting(i: RequiredCiPhaseRoster)) == 1
    && count(milestones_awaiting(i: NamespaceStepSubjectRoster)) == 3
}

// THE INSTRUMENT ROSTER IS THE SAME COUNTED SECOND REPRESENTATION THE MILESTONE ROSTER IS, for the
// same reason -- `.dag` cannot enumerate a coproduct. What this holds is that every declared
// instrument is DISTINCT and that none is dead: an instrument no milestone waits on is either a
// stale row or an arm that stopped citing it, and both should be seen rather than carried.
test fn every_declared_instrument_is_distinct_and_awaited() -> Bool {
  let labels = all_missing_instruments |> map(i => missing_instrument_label(i: i))
  count(labels) == 8
    && all(labels, l => count(labels |> filter(other => other == l)) == 1)
    && all(all_missing_instruments, i => count(milestones_awaiting(i: i)) > 0)
}

// UNBUILT AND REFUSED ARE DIFFERENT STATES WITH DIFFERENT REMEDIES, and both arms are live today --
// which is what stops this axis from being a variant nothing ever inhabits. The whole-corpus board
// is refused by a named authority on host memory; the phase roster is genuinely absent. If the axis
// ever collapses to one arm across every instrument, this reds and someone re-reads it rather than
// carrying a distinction the data no longer makes.
test fn the_obstacle_axis_has_both_arms_inhabited_today() -> Bool {
  match missing_instrument_obstacle(i: WholeCorpusEmissionBoard) {
    NotBuilt => false
    RefusedByAuthority { authority: _, why: _ } =>
      match missing_instrument_obstacle(i: RequiredCiPhaseRoster) {
        NotBuilt => true
        RefusedByAuthority { authority: _, why: _ } => false
      }
  }
}

// A REFUSAL NAMES ITS AUTHORITY AS A CITATION, NEVER AS PROSE. This asserts the refusing row cites
// the module that actually decides -- so a rename or deletion of that authority is caught by the
// ingestion-time citation wall rather than leaving this row reading as current.
test fn the_refused_instrument_cites_the_authority_that_refuses_it() -> Bool {
  match missing_instrument_obstacle(i: WholeCorpusEmissionBoard) {
    NotBuilt => false
    RefusedByAuthority { authority, why: _ } =>
      authority.module_path == "gunbc.whole_corpus_compile_admission"
  }
}

// THE CENSUS IS CHECKED AGAINST A CONTROLLED FIXTURE, NOT AGAINST THE LIVE ROSTER. The input is two
// milestones this file names and the expected counts are authored here independently -- one
// OUTSTANDING, one NOT-DERIVABLE, no CLEAR, both startable because neither has an unanswerable
// prerequisite. Folded over the live roster instead, the only available oracle would be a
// transcription of that same roster, which is the change detector DESIGN's oracle rule rejects.
test fn the_census_counts_a_controlled_population_exactly() -> Bool {
  let c = standing_census(ms: [SelfHostEmitterProducesEveryRetainedArtifact, SelfHostCargoPhaseEnrolled])
  c.milestones == 2
    && c.clear == 0
    && c.outstanding == 1
    && c.not_derivable == 1
    && c.startable == 2
    && c.blocked == 0
    && c.startability_not_derivable == 0
}

// THE DISCRIMINATING ARM: a population whose members ARE unanswerable must not report them as
// startable. Without this, a census that ignored its startability predicate entirely would still
// pass the fixture above, since both of its members happen to be startable.
test fn the_census_separates_unanswerable_startability() -> Bool {
  let c = standing_census(ms: [NamespaceFirstSemanticWave])
  c.milestones == 1
    && c.startable == 0
    && c.blocked == 0
    && c.startability_not_derivable == 1
}

// THE CENSUS PARTITIONS ITS POPULATION EXACTLY, on both axes, over the LIVE roster. This is the arm
// that makes the printed line trustworthy as a denominator: a milestone that fell out of every
// class, or was counted in two, breaks the sum. It asserts the LAW rather than the current figures,
// so it does not go red when the program legitimately moves -- which is what distinguishes it from
// the snapshot pin DESIGN's oracle rule forbids.
test fn the_live_census_partitions_on_both_axes() -> Bool {
  let c = program_standing_census()
  c.milestones == count(program_milestones)
    && c.clear + c.outstanding + c.not_derivable == c.milestones
    && c.startable + c.blocked + c.startability_not_derivable == c.milestones
}
