module test.claim.roadmap_status


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_user: GitHubUser = { login: "gunbai-bot", id: 1, type: extdeps.access.zanzibar.User }
data witness_ref: PullRequestRef = { ref: "feature", sha: "deadbeef", label: "gunb:feature" }

data pr_5445: extdeps.github.pulls.PullRequest = {
  number: 5445,
  title: "merged witness pr",
  body: none,
  state: extdeps.github.pulls.Open,
  html_url: "https://github.com/gunb/gunbc/pull/5445",
  user: witness_user,
  head: witness_ref,
  base: witness_ref,
  created_at: "2026-06-21T00:00:00",
  updated_at: "2026-06-21T00:00:00",
  merged_at: "2026-06-20T00:00:00",
  draft: false,
}
data pr_open_9999: extdeps.github.pulls.PullRequest = {
  number: 9999,
  title: "open witness pr",
  body: none,
  state: extdeps.github.pulls.Open,
  html_url: "https://github.com/gunb/gunbc/pull/9999",
  user: witness_user,
  head: witness_ref,
  base: witness_ref,
  created_at: "2026-06-21T00:00:00",
  updated_at: "2026-06-21T00:00:00",
  merged_at: none,
  draft: false,
}

fn is_drifted(v: gunbc.roadmap_status.DriftVerdict) -> Bool {
  match v { Drifted => true  Clean => false  Underivable => false }
}
fn is_clean(v: gunbc.roadmap_status.DriftVerdict) -> Bool {
  match v { Clean => true  Drifted => false  Underivable => false }
}
fn is_underivable(v: gunbc.roadmap_status.DriftVerdict) -> Bool {
  match v { Underivable => true  Drifted => false  Clean => false }
}

fn derivable(prs: List<Int>, title: String) -> gunbc.roadmap_status.RoadmapItem {
  gunbc.roadmap_status.DerivableLine { prs: prs, title: title, description: "" }
}
fn authored(done: Bool, content: String) -> gunbc.roadmap_status.RoadmapItem {
  gunbc.roadmap_status.AuthoredLine { done: done, content: content }
}

fn witness_merged_pr_is_merged() -> Bool {
  gunbc.roadmap_status.pr_merged(pr: pr_5445)
}
fn witness_open_pr_not_merged() -> Bool {
  !gunbc.roadmap_status.pr_merged(pr: pr_open_9999)
}
fn witness_merged_numbers_projection() -> Bool {
  let nums = gunbc.roadmap_status.merged_pr_numbers(prs: [pr_5445, pr_open_9999])
  count(nums) == 1 && (nums |> v2.std.algebra.any(n => n == 5445))
}

fn witness_all_merged_derives_done() -> Bool {
  gunbc.roadmap_status.prs_all_merged(prs: [5445], merged: [5445])
}

fn witness_one_unmerged_derives_todo() -> Bool {
  !gunbc.roadmap_status.prs_all_merged(prs: [5445, 9999], merged: [5445])
}

fn witness_empty_binding_derives_todo() -> Bool {
  !gunbc.roadmap_status.prs_all_merged(prs: [], merged: [5445])
}

fn witness_derivable_done_from_merge() -> Bool {
  gunbc.roadmap_status.item_is_done(v2.test.resolve.qualified_module_projection_g1b_fixture.item: derivable(prs: [5445], title: "bound + landed"), merged: [5445])
    && !gunbc.roadmap_status.item_is_done(v2.test.resolve.qualified_module_projection_g1b_fixture.item: derivable(prs: [9999], title: "bound + open"), merged: [5445])
}

fn witness_authored_done_is_authored() -> Bool {
  gunbc.roadmap_status.item_is_done(v2.test.resolve.qualified_module_projection_g1b_fixture.item: authored(done: true, content: "hand-checked done"), merged: [])
    && !gunbc.roadmap_status.item_is_done(v2.test.resolve.qualified_module_projection_g1b_fixture.item: authored(done: false, content: "hand-checked todo, cites #5445"), merged: [5445])
}

fn witness_partial_evidence_merged_mention_stays_green() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = authored(done: false, content: "rust-gate coverage — cites merged #5445 as partial evidence, not done")
  is_underivable(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, merged: [5445]))
    && !gunbc.roadmap_status.item_drifted(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, merged: [5445])
}

fn witness_authored_done_underivable() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = authored(done: true, content: "audit done, no PR")
  is_underivable(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: true, merged: []))
}

fn witness_derivable_merged_box_todo_drifts() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = derivable(prs: [5445], title: "bound + stale")
  is_drifted(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, merged: [5445]))
    && gunbc.roadmap_status.item_drifted(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, merged: [5445])
}

fn witness_derivable_unmerged_box_done_drifts() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = derivable(prs: [9999], title: "bound + premature")
  is_drifted(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: true, merged: [5445]))
}

fn witness_derivable_merged_box_done_clean() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = derivable(prs: [5445], title: "bound + honest done")
  is_clean(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: true, merged: [5445]))
    && !gunbc.roadmap_status.item_drifted(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: true, merged: [5445])
}

fn witness_derivable_unmerged_box_todo_clean() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = derivable(prs: [9999], title: "bound + honest todo")
  is_clean(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, merged: [5445]))
}

fn witness_derivable_partial_multi_todo_clean() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = derivable(prs: [5445, 9999], title: "bound + multi partial")
  is_clean(v: gunbc.roadmap_status.status_drift(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, merged: [5445]))
}

fn item_against_prs_drifts() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = derivable(prs: [5445], title: "live-edge stale")
  gunbc.roadmap_status.item_drifts_against_prs(v2.test.resolve.qualified_module_projection_g1b_fixture.item: v2.test.resolve.qualified_module_projection_g1b_fixture.item, committed_box: false, prs: [pr_5445, pr_open_9999])
}

test fn roadmap_status_witnesses() -> Bool {
  witness_merged_pr_is_merged()
    && witness_open_pr_not_merged()
    && witness_merged_numbers_projection()
    && witness_all_merged_derives_done()
    && witness_one_unmerged_derives_todo()
    && witness_empty_binding_derives_todo()
    && witness_derivable_done_from_merge()
    && witness_authored_done_is_authored()
    && witness_partial_evidence_merged_mention_stays_green()
    && witness_authored_done_underivable()
    && witness_derivable_merged_box_todo_drifts()
    && witness_derivable_unmerged_box_done_drifts()
    && witness_derivable_merged_box_done_clean()
    && witness_derivable_unmerged_box_todo_clean()
    && witness_derivable_partial_multi_todo_clean()
    && item_against_prs_drifts()
}
