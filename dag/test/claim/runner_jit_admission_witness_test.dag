module gunbc.test.claim.runner_jit_admission_witness_test

import std.types { String, Bool, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.github.actions_jit_runner {
  JitMintName, jit_config_conflict_status, jit_config_mint_outcome,
}
import gunbc.auth.github_apps { gunbai_ci_declared }
import gunbc.runner.runner_bound_attempt_receipt { host_printed_axis_standing }
import gunbc.runner.runner_jit_admission {
  SignatureAxis, ExpiryAxis, ReplayAxis, UnitBindingAxis, BootBindingAxis, AttemptBindingAxis,
  AxisRequired, AxisDeferred, AxisDissolvedInto, AxisDissolvedIntoUpstreamMint,
  HostEnvelopeNonemptyAndFresh, GitHubMintRequestField,
  jit_admission_axis_standing, attempt_binding_admits_mint_name,
  gunbai_ci_installation_token_url, gunbai_org_generate_jitconfig_path,
  generate_jitconfig_201_expires_at_coverage, replay_runner_id_and_duplicate_name_coverage,
  encoded_jit_config_interior, axis_mint_observability, replay_signal_from_mint,
  OutsideTheModeledGuaranteeDeclaredBoundary,
  MintObservableCoverage, MintUnobservableDeclaredBoundary,
  GenerateJitconfig201ExpiresAtPresence, ReplayRunnerIdAndDuplicateName409,
  LiveCensusUnmet, LiveCensusDischarged,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn signature_and_expiry_are_required_host_envelope_checks() -> Bool {
  match jit_admission_axis_standing(axis: SignatureAxis) {
    AxisRequired { checker: HostEnvelopeNonemptyAndFresh } =>
      match jit_admission_axis_standing(axis: ExpiryAxis) {
        AxisRequired { checker: HostEnvelopeNonemptyAndFresh } => true
        _ => false
      }
    _ => false
  }
}

test fn replay_dissolves_into_the_upstream_one_shot_mint() -> Bool {
  match jit_admission_axis_standing(axis: ReplayAxis) {
    AxisDissolvedIntoUpstreamMint { reason: r } =>
      string_contains(s: r, pattern: "409") && jit_config_conflict_status == 409
    _ => false
  }
}

test fn unit_and_boot_binding_dissolve_into_attempt_binding() -> Bool {
  match jit_admission_axis_standing(axis: UnitBindingAxis) {
    AxisDissolvedInto { into: AttemptBindingAxis } =>
      match jit_admission_axis_standing(axis: BootBindingAxis) {
        AxisDissolvedInto { into: AttemptBindingAxis } => true
        _ => false
      }
    _ => false
  }
}

test fn attempt_binding_admits_only_required_mint_name_standing() -> Bool {
  match jit_admission_axis_standing(axis: AttemptBindingAxis) {
    AxisRequired { checker: GitHubMintRequestField { field: JitMintName } } =>
      attempt_binding_admits_mint_name(
        standing: jit_admission_axis_standing(axis: AttemptBindingAxis)
      )
        && !attempt_binding_admits_mint_name(standing: AxisDeferred {
          trigger: "fixture standing that must not admit a mint" as NonEmptyStr,
        })
        && !attempt_binding_admits_mint_name(standing: AxisDissolvedInto { into: ReplayAxis })
    _ => false
  }
}

test fn the_mint_surface_is_the_gunbai_ci_installation_token_then_generate_jitconfig() -> Bool {
  gunbai_ci_installation_token_url()
    == "https://api.github.com/app/installations/104134109/access_tokens"
    && gunbai_org_generate_jitconfig_path()
       == "/orgs/gunb-ai/actions/runners/generate-jitconfig"
    && (gunbai_ci_declared.slug as String) == "gunbai-ci"
}

test fn only_expiry_and_replay_are_observable_coverage() -> Bool {
  match axis_mint_observability(axis: ExpiryAxis) {
    MintObservableCoverage { question: GenerateJitconfig201ExpiresAtPresence } =>
      match axis_mint_observability(axis: ReplayAxis) {
        MintObservableCoverage { question: ReplayRunnerIdAndDuplicateName409 } =>
          match axis_mint_observability(axis: SignatureAxis) {
            MintUnobservableDeclaredBoundary =>
              match axis_mint_observability(axis: AttemptBindingAxis) {
                MintUnobservableDeclaredBoundary => true
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn encoded_jit_config_interior_is_a_declared_boundary() -> Bool {
  match encoded_jit_config_interior {
    OutsideTheModeledGuaranteeDeclaredBoundary => true
  }
}

test fn bound_attempt_receipt_reads_axis_standing_from_the_authority() -> Bool {
  match host_printed_axis_standing(axis: SignatureAxis) {
    AxisRequired { checker: HostEnvelopeNonemptyAndFresh } =>
      match host_printed_axis_standing(axis: AttemptBindingAxis) {
        AxisRequired { checker: GitHubMintRequestField { field: JitMintName } } => true
        _ => false
      }
    _ => false
  }
}

test fn expiry_and_replay_live_census_rows_are_unmet() -> Bool {
  match generate_jitconfig_201_expires_at_coverage {
    LiveCensusUnmet { question: GenerateJitconfig201ExpiresAtPresence } =>
      match replay_runner_id_and_duplicate_name_coverage {
        LiveCensusUnmet { question: ReplayRunnerIdAndDuplicateName409 } => true
        LiveCensusDischarged { question: _, receipt: _ } => false
      }
    LiveCensusDischarged { question: _, receipt: _ } => false
  }
}

test fn duplicate_name_409_is_the_replay_signal_and_422_is_not() -> Bool {
  replay_signal_from_mint(outcome: jit_config_mint_outcome(
    status: jit_config_conflict_status, encoded: "", runner_id: 0, error_body: "already exists"
  ))
    && !replay_signal_from_mint(outcome: jit_config_mint_outcome(
         status: 422, encoded: "", runner_id: 0, error_body: "validation failed"
       ))
    && !replay_signal_from_mint(outcome: jit_config_mint_outcome(
         status: 201, encoded: "eyJib2R5Ijoib3BhcXVlIn0=", runner_id: 1, error_body: ""
       ))
}
