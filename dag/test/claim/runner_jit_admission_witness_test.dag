module gunbc.test.claim.runner_jit_admission_witness_test

import std.types { String, Bool, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.github.actions_jit_runner {
  JitMintName, JitMintLabels, JitMintRunnerGroupId, JitMintWorkFolder,
  jit_config_conflict_status,
}
import gunbc.auth.github_apps { gunbai_ci_declared }
import gunbc.runner.runner_jit_admission {
  SignatureAxis, ExpiryAxis, ReplayAxis, UnitBindingAxis, BootBindingAxis, AttemptBindingAxis,
  AxisRequired, AxisDeferred, AxisDissolvedInto, AxisDissolvedIntoUpstreamMint,
  HostEnvelopeNonemptyAndFresh, GitHubMintRequestField,
  jit_admission_axis_standing, jit_admission_axis_is_deferred, axis_standing_is_deferred,
  gunbai_ci_installation_token_url, gunbai_org_generate_jitconfig_path,
  mint_field_can_carry_attempt_binding, mint_fact_needed,
  mint_surface_live_census, mint_surface_live_census_is_unmet, LiveCensusDischarged,
  GenerateJitconfig201ExpiresAtPresence, ReplayRunnerIdAndDuplicateName409,
  generate_jitconfig_201_expires_at_coverage, replay_runner_id_and_duplicate_name_coverage,
  axis_awaits_live_census, encoded_jit_config_interior,
  OutsideTheModeledGuaranteeDeclaredBoundary,
  EncodedBlobIsOpaque, InstallationHoldsRunnersWrite, JitconfigResponseHasExpiresAtField,
  DuplicateNameConflicts, JitconfigResponseCarriesRunnerId,
  RequestNameIsPersistedRunnerIdentity, RequestAdmitsLabels,
  RequestHasNoHostField, RequestHasNoBootField,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn signature_and_expiry_are_required_host_envelope_checks() -> Bool {
  match jit_admission_axis_standing(axis: SignatureAxis) {
    AxisRequired { checker: HostEnvelopeNonemptyAndFresh } =>
      match jit_admission_axis_standing(axis: ExpiryAxis) {
        AxisRequired { checker: HostEnvelopeNonemptyAndFresh } => true
        _ => false
      }
    _ => false
  }
}

test fn replay_dissolves_into_the_upstream_one_shot_mint() -> Bool {
  match jit_admission_axis_standing(axis: ReplayAxis) {
    AxisDissolvedIntoUpstreamMint { reason: r } =>
      string_contains(s: r, pattern: "409") && jit_config_conflict_status == 409
    _ => false
  }
}

test fn unit_and_boot_binding_dissolve_into_attempt_binding() -> Bool {
  match jit_admission_axis_standing(axis: UnitBindingAxis) {
    AxisDissolvedInto { into: AttemptBindingAxis } =>
      match jit_admission_axis_standing(axis: BootBindingAxis) {
        AxisDissolvedInto { into: AttemptBindingAxis } => true
        _ => false
      }
    _ => false
  }
}

test fn attempt_binding_is_required_on_the_mint_name_field() -> Bool {
  match jit_admission_axis_standing(axis: AttemptBindingAxis) {
    AxisRequired { checker: GitHubMintRequestField { field: JitMintName } } =>
      mint_field_can_carry_attempt_binding(field: JitMintName)
        && mint_field_can_carry_attempt_binding(field: JitMintLabels)
        && !mint_field_can_carry_attempt_binding(field: JitMintRunnerGroupId)
        && !mint_field_can_carry_attempt_binding(field: JitMintWorkFolder)
    _ => false
  }
}

test fn a_deferred_standing_is_the_only_deferred_arm() -> Bool {
  axis_standing_is_deferred(standing: AxisDeferred {
    trigger: "an authority defining the axis and naming which side can check it" as NonEmptyStr,
  })
    && !axis_standing_is_deferred(standing: AxisRequired { checker: HostEnvelopeNonemptyAndFresh })
}

test fn no_axis_is_deferred() -> Bool {
  !jit_admission_axis_is_deferred(axis: SignatureAxis)
    && !jit_admission_axis_is_deferred(axis: ExpiryAxis)
    && !jit_admission_axis_is_deferred(axis: ReplayAxis)
    && !jit_admission_axis_is_deferred(axis: UnitBindingAxis)
    && !jit_admission_axis_is_deferred(axis: BootBindingAxis)
    && !jit_admission_axis_is_deferred(axis: AttemptBindingAxis)
}

test fn the_mint_surface_is_the_gunbai_ci_installation_token_then_generate_jitconfig() -> Bool {
  gunbai_ci_installation_token_url()
    == "https://api.github.com/app/installations/104134109/access_tokens"
    && gunbai_org_generate_jitconfig_path()
       == "/orgs/gunb-ai/actions/runners/generate-jitconfig"
    && (gunbai_ci_declared.slug as String) == "gunbai-ci"
}

// EACH AXIS NAMES THE MINT FIELDS IT NEEDS, so a live read is a field grant. Discriminating:
// expiry needs expires_at-present-or-absent and does not need 409; replay is the reverse.
test fn mint_facts_needed_are_per_axis_not_the_whole_mint() -> Bool {
  mint_fact_needed(axis: SignatureAxis, fact: EncodedBlobIsOpaque)
    && mint_fact_needed(axis: SignatureAxis, fact: InstallationHoldsRunnersWrite)
    && !mint_fact_needed(axis: SignatureAxis, fact: JitconfigResponseHasExpiresAtField)
    && mint_fact_needed(axis: ExpiryAxis, fact: JitconfigResponseHasExpiresAtField)
    && !mint_fact_needed(axis: ExpiryAxis, fact: DuplicateNameConflicts)
    && mint_fact_needed(axis: ReplayAxis, fact: DuplicateNameConflicts)
    && mint_fact_needed(axis: ReplayAxis, fact: JitconfigResponseCarriesRunnerId)
    && !mint_fact_needed(axis: ReplayAxis, fact: JitconfigResponseHasExpiresAtField)
    && mint_fact_needed(axis: UnitBindingAxis, fact: RequestHasNoHostField)
    && mint_fact_needed(axis: UnitBindingAxis, fact: EncodedBlobIsOpaque)
    && mint_fact_needed(axis: BootBindingAxis, fact: RequestHasNoBootField)
    && !mint_fact_needed(axis: BootBindingAxis, fact: RequestHasNoHostField)
    && mint_fact_needed(axis: AttemptBindingAxis, fact: RequestNameIsPersistedRunnerIdentity)
    && mint_fact_needed(axis: AttemptBindingAxis, fact: RequestAdmitsLabels)
}

// ONLY EXPIRY AND REPLAY AWAIT A LIVE CENSUS. Signature, unit, boot and attempt hit blob opacity,
// which is a declared §4b boundary, not a probe someone should later decode to close.
test fn only_expiry_and_replay_await_a_live_census() -> Bool {
  axis_awaits_live_census(axis: ExpiryAxis)
    && axis_awaits_live_census(axis: ReplayAxis)
    && !axis_awaits_live_census(axis: SignatureAxis)
    && !axis_awaits_live_census(axis: UnitBindingAxis)
    && !axis_awaits_live_census(axis: BootBindingAxis)
    && !axis_awaits_live_census(axis: AttemptBindingAxis)
}

test fn encoded_jit_config_interior_is_a_declared_boundary() -> Bool {
  match encoded_jit_config_interior {
    OutsideTheModeledGuaranteeDeclaredBoundary => true
  }
}

test fn expiry_and_replay_live_census_is_unmet_downstream() -> Bool {
  mint_surface_live_census_is_unmet(census: mint_surface_live_census(
    question: GenerateJitconfig201ExpiresAtPresence,
  ))
    && mint_surface_live_census_is_unmet(census: mint_surface_live_census(
         question: ReplayRunnerIdAndDuplicateName409,
       ))
    && mint_surface_live_census_is_unmet(census: generate_jitconfig_201_expires_at_coverage)
    && mint_surface_live_census_is_unmet(census: replay_runner_id_and_duplicate_name_coverage)
    && !mint_surface_live_census_is_unmet(census: LiveCensusDischarged {
         question: GenerateJitconfig201ExpiresAtPresence,
         receipt: "not yet" as NonEmptyStr,
       })
}
