module test.claim.spatial_edit_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn site() -> std.coordinate_frame.CoordinateFrameIdentity { std.coordinate_frame.coordinate_frame_identity(occurrence: 1) }

// The edited world is millimetre-framed, which is what makes a cubic-millimetre volume a true
// label rather than one asserted from counts whose quantum nobody declared.
fn mm_registry() -> std.spatial_frame.SpatialFrameRegistry {
  match std.spatial_frame.register_frame(r: std.spatial_frame.empty_frame_registry(), identity: site(), length_scale: std.measure.Milli) {
    std.spatial_frame.FrameRegistered { frame: f } => std.spatial_frame.registry_with(r: std.spatial_frame.empty_frame_registry(), f: f)
    std.spatial_frame.FrameRegistrationRefused { cause: _ } => std.spatial_frame.empty_frame_registry()
  }
}

fn rect(x0: Int, y0: Int, x1: Int, y1: Int, high: Int) -> std.orthogonal_topology.EnclosedSpace? {
  match std.orthogonal_geometry.orthogonal_loop2(vertices: [
    std.affine_space.point2(frame: site(), x: x0, y: y0),
    std.affine_space.point2(frame: site(), x: x1, y: y0),
    std.affine_space.point2(frame: site(), x: x1, y: y1),
    std.affine_space.point2(frame: site(), x: x0, y: y1),
  ]) {
    std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
    std.orthogonal_geometry.OrthogonalReady { value: l } =>
      match std.orthogonal_geometry.orthogonal_prism3(footprint: l, low: 0, high: high) {
        std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
        std.orthogonal_geometry.OrthogonalReady { value: pr } => v2.std.optional.Present { value: std.orthogonal_topology.enclosed_space(shell: std.orthogonal_topology.closed_shell_of_prism(prism: pr)) }
      }
  }
}

fn placed(name: String, x0: Int, y0: Int, x1: Int, y1: Int, high: Int) -> product.spatial_world.PlacedSpace? {
  match rect(x0: x0, y0: y0, x1: x1, y1: y1, high: high) {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: s } => v2.std.optional.Present { value: product.spatial_world.PlacedSpace { identity: (name as product.placement_supply.RoomIdentity), space: s } }
  }
}

fn two_room_world() -> product.spatial_world.World? {
  match placed(name: "kitchen", x0: 0, y0: 0, x1: 3000, y1: 4000, high: 2400) {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: k } =>
      match placed(name: "hall", x0: 4000, y0: 0, x1: 6000, y1: 4000, high: 2400) {
        v2.std.optional.Absent => none
        v2.std.optional.Present { value: h } =>
          match product.spatial_world.world(rooms: [k, h]) {
            product.spatial_world.WorldRefused { cause: _ } => none
            product.spatial_world.WorldReady { value: w } => v2.std.optional.Present { value: w }
          }
      }
  }
}

fn realized(edits: List<product.spatial_edit.RoomEdit>) -> product.spatial_world.World? {
  match two_room_world() {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: base } =>
      match product.spatial_edit.apply_edits(base: base, edits: edits) {
        product.spatial_edit.EditNotCompiled { cause: _ } => none
        product.spatial_edit.EditRealized { result: r } =>
          match r {
            product.spatial_world.WorldRefused { cause: _ } => none
            product.spatial_world.WorldReady { value: w } => v2.std.optional.Present { value: w }
          }
      }
  }
}

fn compile_refusal(edits: List<product.spatial_edit.RoomEdit>) -> product.spatial_edit.EditRefusal? {
  match two_room_world() {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: base } =>
      match product.spatial_edit.edits_to_patch(base: base, edits: edits) {
        product.spatial_edit.EditReady { value: _ } => none
        product.spatial_edit.EditRefused { cause: c } => v2.std.optional.Present { value: c }
      }
  }
}

fn volume_of(w: product.spatial_world.World, name: String) -> Int {
  fold(product.spatial_world.world_rooms(w: w), init: 0 - 1, f: (acc, r) =>
    if (r.identity as String) == name {
      match std.orthogonal_topology.space_volume(registry: mm_registry(), s: r.space) {
        std.orthogonal_geometry.OrthogonalRefused { cause: _ } => 0 - 1
        std.orthogonal_geometry.OrthogonalReady { value: v } => std.measure.cubic_millimeter_count(m: v)
      }
    } else {
      acc
    })
}

// A move preserves the room's volume exactly - it is a translation, and the geometry is rebuilt
// through the same mints rather than copied with fields swapped.
test fn a_move_relocates_a_room_without_changing_its_volume() -> Bool {
  match realized(edits: [product.spatial_edit.MoveRoom { identity: ("kitchen" as product.placement_supply.RoomIdentity), east: 0, north: 5000, up: 0 }]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: w } => product.spatial_world.world_room_count(w: w) == 2 && volume_of(w: w, name: "kitchen") == 3000 * 4000 * 2400
  }
}

// A ceiling is set, so the new volume follows from the new height and the unchanged footprint.
test fn raising_a_ceiling_changes_the_volume_by_the_new_height() -> Bool {
  match realized(edits: [product.spatial_edit.SetCeilingHeight { identity: ("kitchen" as product.placement_supply.RoomIdentity), high: 2700 }]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: w } => volume_of(w: w, name: "kitchen") == 3000 * 4000 * 2700
  }
}

test fn adding_and_removing_rooms_lands_through_the_variant() -> Bool {
  match rect(x0: 0, y0: 5000, x1: 2000, y1: 7000, high: 2400) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: study } =>
      match realized(edits: [
        product.spatial_edit.AddRoom { identity: ("study" as product.placement_supply.RoomIdentity), space: study },
        product.spatial_edit.RemoveRoom { identity: ("hall" as product.placement_supply.RoomIdentity) },
      ]) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: w } => product.spatial_world.world_room_count(w: w) == 2 && volume_of(w: w, name: "hall") == (0 - 1)
      }
  }
}

// THE MOVE THAT IS WELL-FORMED AND STILL HAS NO RESULT. Sliding the kitchen east onto the hall is a
// perfectly compilable edit - the room exists, the arithmetic holds, the geometry is admissible on
// its own - and the world it would produce has two rooms in one volume. That is 4A's wall, reached
// through this band's front door, and it is reported as a REALIZATION refusal rather than an edit
// refusal because the instruction was not the thing that was wrong.
test fn an_edit_that_would_overlap_two_rooms_is_refused_at_realization() -> Bool {
  match two_room_world() {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: base } =>
      match product.spatial_edit.apply_edits(base: base, edits: [product.spatial_edit.MoveRoom { identity: ("kitchen" as product.placement_supply.RoomIdentity), east: 3500, north: 0, up: 0 }]) {
        product.spatial_edit.EditNotCompiled { cause: _ } => false
        product.spatial_edit.EditRealized { result: r } =>
          match r {
            product.spatial_world.WorldReady { value: _ } => false
            product.spatial_world.WorldRefused { cause: c } =>
              match c {
                product.spatial_world.WorldGeometryRefused { cause: g } =>
                  match g {
                    std.orthogonal_geometry.SpacesInterpenetrate => true
                    _ => false
                  }
                product.spatial_world.DuplicateRoomIdentity { identity: _ } => false
                product.spatial_world.VariantTargetMissing { identity: _ } => false
                product.spatial_world.VariantTargetAlreadyPresent { identity: _ } => false
                product.spatial_world.VariantBaseChanged { identity: _ } => false
              }
          }
      }
  }
}

// TWO EDITS TO ONE ROOM HAVE NO FAITHFUL PATCH, and both fabrications are silent: last-writer-wins
// drops an edit the caller asked for, composing them invents a state nobody described.
test fn two_edits_to_one_room_in_one_batch_refuse() -> Bool {
  match compile_refusal(edits: [
    product.spatial_edit.MoveRoom { identity: ("kitchen" as product.placement_supply.RoomIdentity), east: 0, north: 5000, up: 0 },
    product.spatial_edit.SetCeilingHeight { identity: ("kitchen" as product.placement_supply.RoomIdentity), high: 2700 },
  ]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: c } =>
      match c {
        product.spatial_edit.RoomEditedTwiceInOneBatch { identity: i } => (i as String) == "kitchen"
        _ => false
      }
  }
}

// Sequencing the same two edits IS expressible - it is two patches, not one - and this is the claim
// that keeps the refusal above from being a capability gap.
test fn the_same_two_edits_land_when_they_are_sequenced() -> Bool {
  match realized(edits: [product.spatial_edit.MoveRoom { identity: ("kitchen" as product.placement_supply.RoomIdentity), east: 0, north: 5000, up: 0 }]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: moved } =>
      match product.spatial_edit.apply_edits(base: moved, edits: [product.spatial_edit.SetCeilingHeight { identity: ("kitchen" as product.placement_supply.RoomIdentity), high: 2700 }]) {
        product.spatial_edit.EditNotCompiled { cause: _ } => false
        product.spatial_edit.EditRealized { result: r } =>
          match r {
            product.spatial_world.WorldRefused { cause: _ } => false
            product.spatial_world.WorldReady { value: w } => volume_of(w: w, name: "kitchen") == 3000 * 4000 * 2700
          }
      }
  }
}

test fn editing_a_room_the_base_does_not_have_refuses_at_compile() -> Bool {
  match compile_refusal(edits: [product.spatial_edit.MoveRoom { identity: ("cellar" as product.placement_supply.RoomIdentity), east: 100, north: 0, up: 0 }]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: c } =>
      match c {
        product.spatial_edit.EditTargetMissing { identity: i } => (i as String) == "cellar"
        _ => false
      }
  }
}

test fn adding_a_room_that_is_already_there_refuses_at_compile() -> Bool {
  match rect(x0: 0, y0: 0, x1: 3000, y1: 4000, high: 2400) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: s } =>
      match compile_refusal(edits: [product.spatial_edit.AddRoom { identity: ("kitchen" as product.placement_supply.RoomIdentity), space: s }]) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: c } =>
          match c {
            product.spatial_edit.EditTargetAlreadyPresent { identity: i } => (i as String) == "kitchen"
            _ => false
          }
      }
  }
}

// A ceiling below the floor is not a room, and the refusal comes from the geometry authority rather
// than from a height check written here - which is the point: this module never assembles a space
// that the mints would not have produced.
test fn a_ceiling_below_the_floor_refuses_at_the_geometry_authority() -> Bool {
  match compile_refusal(edits: [product.spatial_edit.SetCeilingHeight { identity: ("kitchen" as product.placement_supply.RoomIdentity), high: 0 - 100 }]) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: c } =>
      match c {
        product.spatial_edit.EditGeometryRefused { cause: _ } => true
        _ => false
      }
  }
}
