module test.claim.artifact_store_oversize_probe

import std.logic { Bool }
import std.types { ContentHash, Int, List }
import std.measure { byte_size }
import std.content_hash { content_hash_atom }
import std.artifact_store { ArtifactStore, store_put, store_bytes_used, store_get, StoreHit, StoreMiss }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn probe_store() -> ArtifactStore {
  ArtifactStore { budget: byte_size(count: 100), next_ordinal: 1, rows: [] }
}

test fn probe_oversize_put_evicts_itself() -> Bool {
  let k = content_hash_atom(value: "oversize")
  let receipt = store_put(store: probe_store(), key: k, artifact_bytes: byte_size(count: 500))
  let self_evicted = receipt.evicted |> fold(init: false, f: (acc, e) => acc || (e == k))
  let absent = match store_get(store: receipt.store, key: k) {
    StoreHit { store: _, row: _ } => false
    StoreMiss { store: _ } => true
  }
  self_evicted && absent && (receipt.store.rows.count() == 0)
}

test fn probe_oversize_put_receipt_shape() -> Bool {
  let k = content_hash_atom(value: "oversize2")
  let receipt = store_put(store: probe_store(), key: k, artifact_bytes: byte_size(count: 500))
  (receipt.evicted.count() == 1) && (store_bytes_used(store: receipt.store) == 0)
}

test fn probe_oversize_put_after_warm_store_evicts_everything() -> Bool {
  let ka = content_hash_atom(value: "warm-a")
  let kb = content_hash_atom(value: "oversize3")
  let s1 = store_put(store: probe_store(), key: ka, artifact_bytes: byte_size(count: 40)).store
  let receipt = store_put(store: s1, key: kb, artifact_bytes: byte_size(count: 500))
  (receipt.evicted.count() == 2) && (receipt.store.rows.count() == 0)
}
