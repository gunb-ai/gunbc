module test.claim.cgroup_v2_memory_stat_keys

import std.types { Bool }
import extdeps.linux.cgroup_v2_memory {
  MemoryEvents, MemoryEventsLocal, Instantaneous, CumulativeCounter,
  StatAnon, StatFile, StatKernel, StatSlab, StatShmem, StatFileMapped, StatFileDirty,
  StatFileWriteback, StatSwapCached, StatInactiveAnon, StatActiveAnon, StatInactiveFile,
  StatActiveFile, StatUnevictable, StatWorkingsetRefaultFile, StatPgmajfault,
  cgroup_memory_interface_file_name, cgroup_memory_metric_kind,
  cgroup_memory_stat_key_name, cgroup_memory_stat_key_kind, cgroup_memory_stat_value,
}

// THE TWO EVENTS FILES, AT THEIR OWN INTERFACE. cgroup-v2 gives them the same entries and moves only
// the hierarchy: memory.events is hierarchical, memory.events.local is not. A witness over both pins
// the name the kernel uses and the kind the quantity has, which is everything a consumer is allowed
// to inherit rather than re-decide.
test fn the_events_files_are_named_by_the_kernel_and_share_a_kind() -> Bool {
  cgroup_memory_interface_file_name(f: MemoryEvents) == "memory.events"
    && cgroup_memory_interface_file_name(f: MemoryEventsLocal) == "memory.events.local"
    && cgroup_memory_metric_kind(f: MemoryEvents) == CumulativeCounter
    && cgroup_memory_metric_kind(f: MemoryEventsLocal) == CumulativeCounter
}

// THE NAMES DIFFER, AND NOTHING ELSE ABOUT THE PAIR DOES. If the two names ever collapse, a witness
// that read one and printed the other becomes indistinguishable from one that read the right file --
// the silent half of charging a descendant's OOM to the level that asked.
test fn the_local_events_file_is_not_the_hierarchical_one() -> Bool {
  cgroup_memory_interface_file_name(f: MemoryEvents) != cgroup_memory_interface_file_name(f: MemoryEventsLocal)
    && cgroup_memory_metric_kind(f: MemoryEvents) == cgroup_memory_metric_kind(f: MemoryEventsLocal)
}

// EVERY MODELLED memory.stat KEY IS SPELLED AS THE KERNEL SPELS IT. These are pins on the interface,
// not a list a consumer reads: the order here means nothing, and the strings are the subject of the
// assertion rather than a print policy. A key the interface does not model cannot be named at all,
// which is what the closed type buys.
test fn the_stat_key_names_are_the_kernel_spellings() -> Bool {
  cgroup_memory_stat_key_name(k: StatAnon) == "anon"
    && cgroup_memory_stat_key_name(k: StatFile) == "file"
    && cgroup_memory_stat_key_name(k: StatKernel) == "kernel"
    && cgroup_memory_stat_key_name(k: StatSlab) == "slab"
    && cgroup_memory_stat_key_name(k: StatShmem) == "shmem"
    && cgroup_memory_stat_key_name(k: StatFileMapped) == "file_mapped"
    && cgroup_memory_stat_key_name(k: StatFileDirty) == "file_dirty"
    && cgroup_memory_stat_key_name(k: StatFileWriteback) == "file_writeback"
    && cgroup_memory_stat_key_name(k: StatSwapCached) == "swapcached"
    && cgroup_memory_stat_key_name(k: StatInactiveAnon) == "inactive_anon"
    && cgroup_memory_stat_key_name(k: StatActiveAnon) == "active_anon"
    && cgroup_memory_stat_key_name(k: StatInactiveFile) == "inactive_file"
    && cgroup_memory_stat_key_name(k: StatActiveFile) == "active_file"
    && cgroup_memory_stat_key_name(k: StatUnevictable) == "unevictable"
    && cgroup_memory_stat_key_name(k: StatWorkingsetRefaultFile) == "workingset_refault_file"
    && cgroup_memory_stat_key_name(k: StatPgmajfault) == "pgmajfault"
}

// THE KIND TRAVELS WITH THE KEY, AND IT SEPARATES LEVELS FROM COUNTERS. The fourteen residency and
// breakdown keys are byte counts of current state; workingset_refault_file and pgmajfault are counts
// of events since the cgroup was created. Printed the same way they read the same, and a counter
// sampled at two phases whose pair is never subtracted looks like a charge that grew.
test fn the_stat_key_kinds_separate_levels_from_counters() -> Bool {
  cgroup_memory_stat_key_kind(k: StatAnon) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatFile) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatKernel) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatSlab) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatShmem) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatFileMapped) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatFileDirty) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatFileWriteback) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatSwapCached) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatInactiveAnon) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatActiveAnon) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatInactiveFile) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatActiveFile) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatUnevictable) == Instantaneous
    && cgroup_memory_stat_key_kind(k: StatWorkingsetRefaultFile) == CumulativeCounter
    && cgroup_memory_stat_key_kind(k: StatPgmajfault) == CumulativeCounter
}

// THE KEY TYPE FEEDS THE FLAT READER, OVER A SUPPLIED BODY. memory.stat is documented as flat
// "key value" lines, so the reader takes the key's kernel name -- and the only honest way to hand it
// that name is to ask the interface for it. A body missing the key reads absent rather than zero: an
// absent key and a zero key are different facts.
test fn a_stat_key_names_the_key_the_flat_reader_reads() -> Bool {
  let body = "anon 4096\nfile 8192\nworkingset_refault_file 7\n"
  match cgroup_memory_stat_value(body: body, key: cgroup_memory_stat_key_name(k: StatAnon)) {
    Present { value: n } => n == 4096
    Absent => false
  } && match cgroup_memory_stat_value(body: body, key: cgroup_memory_stat_key_name(k: StatWorkingsetRefaultFile)) {
    Present { value: n } => n == 7
    Absent => false
  } && match cgroup_memory_stat_value(body: body, key: cgroup_memory_stat_key_name(k: StatUnevictable)) {
    Present { value: _ } => false
    Absent => true
  }
}
