module test.claim.fleet_capacity_control_witness_test


fn host_rows_srv3_down() -> List<gunbc.fleet_capacity_control.HostCapacityWithdrawal> {
  [gunbc.fleet_capacity_control.HostCapacityWithdrawal {
    host: gunbc.fleet_intent_network.operator_host_srv3,
    cause: gunbc.fleet_capacity_control.WithdrawnForMaintenance { detail: "memory upgrade" as std.types.NonEmptyStr },
  }]
}

fn provider_rows_codex_down() -> List<gunbc.fleet_capacity_control.ProviderCapacityWithdrawal> {
  [gunbc.fleet_capacity_control.ProviderCapacityWithdrawal {
    provider: extdeps.llm.cli_lifecycle.CodexCliProvider,
    cause: gunbc.fleet_capacity_control.WithdrawnToReduceSpend { detail: "quota exhausted" as std.types.NonEmptyStr },
  }]
}

fn admission_label(
  hosts: List<gunbc.fleet_capacity_control.HostCapacityWithdrawal>,
  providers: List<gunbc.fleet_capacity_control.ProviderCapacityWithdrawal>,
  host: product.placement_supply.HostIdentity,
  provider: extdeps.llm.cli_lifecycle.ProviderKind,
) -> String {
  match gunbc.fleet_capacity_control.fleet_capacity_admission_in(
    host_rows: hosts, provider_rows: providers, host: host, provider: provider,
  ) {
    gunbc.fleet_capacity_control.CapacityAdmitted => "admitted"
    gunbc.fleet_capacity_control.CapacityRefusedHostWithdrawn { host: _, cause: _ } => "refused-host"
    gunbc.fleet_capacity_control.CapacityRefusedProviderWithdrawn { provider: _, cause: _ } => "refused-provider"
  }
}

// THE TWO REFUSALS DO NOT COLLAPSE, WHICH IS THE WHOLE REASON THEY ARE SEPARATE ARMS.
//
// This is the discriminating control. An operator told only "unavailable" cannot tell a downed
// MACHINE from a cut RUNTIME, and the two have opposite repairs -- restoring the provider on a
// host that is down returns no capacity at all. If the coproduct were collapsed to a Bool this
// witness goes red while every admitted-path assertion stays green.
test fn a_downed_host_and_a_cut_runtime_do_not_share_one_answer() -> Bool {
  let host_down = admission_label(
    hosts: host_rows_srv3_down(), providers: [],
    host: gunbc.fleet_intent_network.operator_host_srv3, provider: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
  )
  let runtime_down = admission_label(
    hosts: [], providers: provider_rows_codex_down(),
    host: gunbc.fleet_intent_network.operator_host_srv3, provider: extdeps.llm.cli_lifecycle.CodexCliProvider,
  )
  host_down != runtime_down
    && host_down == "refused-host"
    && runtime_down == "refused-provider"
}

// WHEN BOTH ARE WITHDRAWN THE HOST WINS, AND THAT PRECEDENCE IS LOAD-BEARING RATHER THAN TIDY.
// Reporting the provider for a host that is down names a cause whose repair changes nothing.
test fn a_downed_host_dominates_a_cut_runtime() -> Bool {
  admission_label(
    hosts: host_rows_srv3_down(), providers: provider_rows_codex_down(),
    host: gunbc.fleet_intent_network.operator_host_srv3, provider: extdeps.llm.cli_lifecycle.CodexCliProvider,
  ) == "refused-host"
}

// WITHDRAWAL IS SCOPED TO ITS SUBJECT AND DOES NOT LEAK ACROSS THE AXIS.
// srv3 being down must not withdraw srv1, and Codex being cut must not cut Claude.
test fn a_withdrawal_does_not_leak_to_its_siblings() -> Bool {
  admission_label(
    hosts: host_rows_srv3_down(), providers: provider_rows_codex_down(),
    host: gunbc.fleet_intent_network.operator_host_srv1, provider: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
  ) == "admitted"
}

// A FAULT WITHDRAWAL IS NOT AUTO-RESTORABLE AND A MAINTENANCE ONE IS.
//
// The discriminating half is that these three answers are not all the same: a restorer keyed on
// reachability would flap an intermittently-failing host back into service between its failures,
// which is exactly why the cause is carried rather than being a bare withdrawn flag.
test fn only_maintenance_withdrawals_admit_automatic_restore() -> Bool {
  gunbc.fleet_capacity_control.withdrawal_admits_automatic_restore(
    cause: gunbc.fleet_capacity_control.WithdrawnForMaintenance { detail: "d" as std.types.NonEmptyStr })
    && !gunbc.fleet_capacity_control.withdrawal_admits_automatic_restore(
      cause: gunbc.fleet_capacity_control.WithdrawnForObservedFault { detail: "d" as std.types.NonEmptyStr })
    && !gunbc.fleet_capacity_control.withdrawal_admits_automatic_restore(
      cause: gunbc.fleet_capacity_control.WithdrawnToReduceSpend { detail: "d" as std.types.NonEmptyStr })
}

// THE ACCOUNT AXIS REFUSES RATHER THAN BEING ABSENT (operator ruling 2026-08-23).
//
// The control names both readings of "cut off a provider", and the unwired one answers with a
// typed not-yet-bound carrying the axis it needs. An absent control would read as "not applicable
// here" -- the not-applicable-versus-malformed conflation -- and would let an ambiguous request be
// answered by whichever reading happened to get built.
test fn the_account_axis_refuses_by_name_instead_of_being_absent() -> Bool {
  let account = gunbc.fleet_capacity_control.apply_capacity_control(request: gunbc.fleet_capacity_control.CutProviderAccountBinding {
    provider: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
    account: "work-account" as std.types.NonEmptyStr,
    cause: gunbc.fleet_capacity_control.WithdrawnToReduceSpend { detail: "rotating" as std.types.NonEmptyStr },
  })
  let runtime = gunbc.fleet_capacity_control.apply_capacity_control(request: gunbc.fleet_capacity_control.CutProviderRuntime {
    provider: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
    cause: gunbc.fleet_capacity_control.WithdrawnToReduceSpend { detail: "rotating" as std.types.NonEmptyStr },
  })
  !gunbc.fleet_capacity_control.capacity_control_is_planned(outcome: account)
    && gunbc.fleet_capacity_control.capacity_control_is_planned(outcome: runtime)
    && string_contains(s: gunbc.fleet_capacity_control.capacity_control_outcome_line(outcome: account), pattern: "account binding")
}

// THE CONTROL PLANS AND DOES NOT APPLY, AND THIS IS THE WITNESS THAT JOINS THE TWO (review 54905).
//
// This is the shape the reviewer named, and it is the one that catches the failure the earlier
// revision shipped: call the control, then READ THE ROSTER. An arm reporting "applied" while the
// roster reader still answers false is fabricated plausible output, and no amount of comparing
// outcome strings to each other can see it -- the previous witnesses compared requests against
// each other and were all green while the control lied.
//
// The assertion is deliberately that the host is STILL NOT withdrawn. Planning is what happened;
// withdrawal takes authoring a roster row and committing it, so a green here means the control is
// honest about the boundary rather than that it failed.
test fn planning_a_cut_does_not_withdraw_anything_by_itself() -> Bool {
  let outcome = gunbc.fleet_capacity_control.apply_capacity_control(request: gunbc.fleet_capacity_control.CutHost {
    host: gunbc.fleet_intent_network.operator_host_srv3,
    cause: gunbc.fleet_capacity_control.WithdrawnForMaintenance { detail: "memory upgrade" as std.types.NonEmptyStr },
  })
  gunbc.fleet_capacity_control.capacity_control_is_planned(outcome: outcome)
    && !gunbc.fleet_capacity_control.host_is_withdrawn(host: gunbc.fleet_intent_network.operator_host_srv3)
    && string_contains(s: gunbc.fleet_capacity_control.capacity_control_outcome_line(outcome: outcome), pattern: "plan:")
    && string_contains(s: gunbc.fleet_capacity_control.capacity_control_outcome_line(outcome: outcome),
                       pattern: "add to withdrawn_hosts")
}

test fn planning_a_runtime_cut_does_not_withdraw_it_by_itself() -> Bool {
  let outcome = gunbc.fleet_capacity_control.apply_capacity_control(request: gunbc.fleet_capacity_control.CutProviderRuntime {
    provider: extdeps.llm.cli_lifecycle.CodexCliProvider,
    cause: gunbc.fleet_capacity_control.WithdrawnToReduceSpend { detail: "quota" as std.types.NonEmptyStr },
  })
  gunbc.fleet_capacity_control.capacity_control_is_planned(outcome: outcome)
    && !gunbc.fleet_capacity_control.provider_is_withdrawn(provider: extdeps.llm.cli_lifecycle.CodexCliProvider)
}

// CUTTING A RUNTIME AND CUTTING A HOST ARE DIFFERENT PLANS, NOT ONE CONTROL WITH AN ARGUMENT.
test fn the_two_cut_controls_actuate_distinctly() -> Bool {
  let cut_host = gunbc.fleet_capacity_control.capacity_control_outcome_line(outcome: gunbc.fleet_capacity_control.apply_capacity_control(
    request: gunbc.fleet_capacity_control.CutHost {
      host: gunbc.fleet_intent_network.operator_host_srv3,
      cause: gunbc.fleet_capacity_control.WithdrawnForMaintenance { detail: "ram" as std.types.NonEmptyStr },
    }))
  let cut_runtime = gunbc.fleet_capacity_control.capacity_control_outcome_line(outcome: gunbc.fleet_capacity_control.apply_capacity_control(
    request: gunbc.fleet_capacity_control.CutProviderRuntime {
      provider: extdeps.llm.cli_lifecycle.CursorCliProvider,
      cause: gunbc.fleet_capacity_control.WithdrawnForMaintenance { detail: "ram" as std.types.NonEmptyStr },
    }))
  cut_host != cut_runtime
    && string_contains(s: cut_host, pattern: "srv3")
    && string_contains(s: cut_runtime, pattern: "Cursor")
}

// THE LIVE FLEET IS FULLY ACTIVE, AND THIS IS THE ASSERTION THAT A ROSTER EDIT IS DELIBERATE.
//
// The rosters are the operator's control surface; empty is the correct resting position. This
// witness goes red the moment capacity is withdrawn in a commit, which is the point -- taking a
// machine or a runtime out of service should require an author to face a red test and say so,
// rather than riding in as a data row nobody reads.
test fn the_live_rosters_withdraw_nothing() -> Bool {
  gunbc.fleet_capacity_control.active_host_count() == 4
    && gunbc.fleet_capacity_control.active_provider_count() == 3
    && (gunbc.fleet_capacity_control.withdrawn_hosts |> count) == 0
    && (gunbc.fleet_capacity_control.withdrawn_providers |> count) == 0
}
