module test.claim.github_pull_request_decode_witness

// THE PUBLISHER'S PR READ, DECODED HERMETICALLY OVER THE RECORDED BODY.
//
// THE OUTAGE THIS WAS WRITTEN FOR (2026-11-10, repo-wide). Every heal-publish publish from 08:45Z refused
// at the pull-request read with `HealPublishPreconditionUnmet: the pull request could not be read;
// refusing to publish: status 200 undecodable (cause withheld on a credential path)` (runs 42795658738 over
// PR #16238 and 42798626487 over PR #16122; the last runs that reached the read at all had succeeded at
// heads 4a4f790d8d and 6ab6e6a7cb). The cause, withheld by the publish path and so invisible in CI, was
// `NoWireContract` on the coproduct `PullRequestState`: 5e315131 ("run: realize only the declarations an
// entry can name", #16156) replaced the blanket first wave that realized every non-function declaration
// with a wave seeded only by what the entry can NAME, and `pull_request_state_wire_contract` -- the row in
// the SIBLING module extdeps.github.pulls_contracts that alone says how "open"/"closed" spell the two arms
// -- is named by nothing the publisher can name. pulls.dag IMPORTS it, and an import is not a use. With the
// row out of the realized set, the interpreter's build_coproduct_wire_contract_index
// (src/v1/stage0/src/v1_interpreter.rs) comes up empty, decode_nullary_coproduct refuses, and a body GitHub
// answered 200 for became "undecodable". The payload was never the discriminator: #16238 and the succeeding
// #16233 agree on every field the decode consults, and so do #16122 and #16220.
//
// WHAT THIS FILE IS. `test.RestReplay.PullRequestPage` serves `200 => PullRequest` verbatim from
// extdeps.github.pulls `service github.Pulls` `operation Get` -- the response carrier
// gunbc.heal_publication ensure_pull_request_open_wet reads -- so the recorded body below reaches the
// interpreter's own type-directed decode, with no credential and no live request anywhere: the answer comes
// from the witness frame's recorded fixture (the seam and its hand-authored invocation are
// test.claim.rest_exchange_replay's, and the target and input_digest there are what the probe host computes
// for a paramless, unauthenticated call to this probe service).
//
// RED WHERE, GREEN WHERE. The tests below run at the whole-closure grain (claim_batch), where every
// declaration is realized, so they are GREEN at main and at head: they pin WHAT the decode must produce.
// The regression witness is the SCOPED entry `pull_request_decode_scoped_run_witness`, which runs at the
// grain a `gunbc run --function` compiles at -- the publisher's grain:
//   target/release/gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/test/claim/github_pull_request_decode_witness.dag \
//     --function pull_request_decode_scoped_run_witness
// It exits 0 with ExitSuccess at the fixed head, and exits non-zero with the reason
// `GithubPullRequestDecodeWitnessRefused: ...` at origin/main, where the contract row is excluded. That is
// the whole witness: no credential, no token, no live GitHub, and the refusal reason names the cause the
// publish path could not print (extdeps.transports.rest RestBodyUndecodable's cause is now minted from the
// declared type only, v1_interpreter.rs rest_response_declared_cause).
//
// THE CONTROL, WHICH MUST BE GREEN AT BOTH HEADS. `the_replay_seam_still_decodes_an_ordinary_record`
// answers the probe's `Observe` operation -- a declared String with no coproduct behind it -- through the
// same frame. It does not depend on a wire-contract row being realized, so it separates "the replay seam
// and the type-directed decode work" from "this coproduct's contract row survived the demanded set".

import std.types { Bool, String }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.transports.rest { RestAnswered, RestRefused, RestResponseObserved, RestBodyRead }
import extdeps.github.github { UserType }
import extdeps.github.pulls { PullRequest, PullRequestState }
import v2.std.witness_evaluation { WitnessReturned, WitnessRefused, WitnessInterrupted, evaluate_in_witness_frame }
import test.claim.rest_exchange_replay { replay_frame, fixture_for }
import test.fixture.rest_exchange_replay_probe

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RECORDED, NOT INVENTED: the body GitHub answered 200 with for GET /repos/gunb-ai/gunbc/pulls/16238 on
// 2026-11-10, the run 42795658738 refused. Fields the PullRequest carrier does not declare are dropped and
// nothing is rewritten: every value here is the recorded value for the field it names, including the Bot
// authorship, the closed state and the sha. `state` and `user.type` are the two coproduct fields whose wire
// spelling no row of this module can name.
data live_pull_request_body: String = "{\"number\":16238,\"title\":\"Take over #16143 (#15992 re-land): resolve the main conflict, heal-publish the mirror, paired claim run\",\"body\":\"Auto-opened by session-dashboard for session `eager-crane-809`.\\nPushing to `notes/16143-fix-wip` advances this PR.\\n\\n## Worker attestation\\n\\nBefore flipping this PR to ready for review, confirm each item:\\n\\n- [ ] Title describes the change (not the session id or branch).\\n- [ ] PR body summarises *what* and *why* (replace the TODO below).\\n- [ ] Tests run: name the command (e.g. `npm test`, `cargo test`) and the result.\\n- [ ] If this closes a work item, the body contains a `Closes #N` directive.\\n- [ ] No commits on this branch are surprises (no fork/cherry-pick I did not make).\\n- [ ] No secrets / credentials / large binaries staged.\\n\\n## Summary\\n\\nTODO: replace this paragraph with one or two sentences naming the change and its motivation. Reviewers read this first.\\n\\n## Test plan\\n\\n- TODO: list the commands that ran (or \\\"no tests changed; relied on CI\\\") and the outcome.\",\"state\":\"closed\",\"html_url\":\"https://github.com/gunb-ai/gunbc/pull/16238\",\"user\":{\"login\":\"gunbai-bot[bot]\",\"id\":289086189,\"type\":\"Bot\"},\"head\":{\"ref\":\"notes/16143-fix-wip\",\"sha\":\"cfcdf23a3cdee54806d367e4adccc30f9d57f13b\",\"label\":\"gunb-ai:notes/16143-fix-wip\"},\"base\":{\"ref\":\"main\",\"sha\":\"5e3151317af650787f37c4dafeeea642653194e2\",\"label\":\"gunb-ai:main\"},\"created_at\":\"2026-11-10T09:11:39Z\",\"updated_at\":\"2026-11-10T09:15:21Z\",\"merged_at\":null,\"draft\":false,\"merge_commit_sha\":\"6c90a0a2d0ac72e943c5acafddc03f56ffd37929\"}"

// The published read is over a CLOSED pull request whose author is a Bot app: two coproduct fields, each
// spelled only by a CoproductWireContract row in a sibling _contracts module.
type PullRequestReading
  = PullRequestDecoded { pull: PullRequest }
  | PullRequestNotDecoded { detail: String }

fn decoded_pull_request() -> PullRequestReading {
  let fixtures = [
    fixture_for(operation: "PullRequestPage", observation: RestResponseObserved {
      status: 200,
      body: RestBodyRead { body: live_pull_request_body }
    })
  ]
  match evaluate_in_witness_frame(frame: replay_frame(fixtures: fixtures), subject: () => test.RestReplay.PullRequestPage()) {
    WitnessReturned { value: RestAnswered { answer: o } } => PullRequestDecoded { pull: o.pull }
    WitnessReturned { value: RestRefused { refusal: r } } => PullRequestNotDecoded { detail: "rest refused" }
    WitnessRefused { reason: reason } => PullRequestNotDecoded { detail: reason }
    WitnessInterrupted { reason: reason } => PullRequestNotDecoded { detail: reason }
  }
}

fn decoded_message_through_the_seam() -> String {
  let fixtures = [
    fixture_for(operation: "Observe", observation: RestResponseObserved {
      status: 200,
      body: RestBodyRead { body: "{\"message\":\"replay-seam-ok\"}" }
    })
  ]
  match evaluate_in_witness_frame(frame: replay_frame(fixtures: fixtures), subject: () => test.RestReplay.Observe()) {
    WitnessReturned { value: RestAnswered { answer: o } } => o.message
    WitnessReturned { value: RestRefused { refusal: r } } => "rest refused"
    WitnessRefused { reason: reason } => reason
    WitnessInterrupted { reason: reason } => reason
  }
}

test fn the_replay_seam_still_decodes_an_ordinary_record() -> Bool {
  // THE CONTROL. No coproduct behind this one, so it is green at origin/main too: it fails only if the
  // replay seam or the type-directed decode itself broke, which would make the witness above meaningless.
  decoded_message_through_the_seam() == "replay-seam-ok"
}

test fn the_recorded_pull_request_body_decodes_at_all() -> Bool {
  match decoded_pull_request() {
    PullRequestDecoded { pull: _ } => true
    PullRequestNotDecoded { detail: _ } => false
  }
}

test fn the_coproduct_state_decodes_by_its_sibling_contracts_row() -> Bool {
  // "closed" is the wire spelling; the arm is PullRequestState.Closed. Only the CoproductWireContract row
  // pull_request_state_wire_contract says the wire word is lower-case while the arm is authored as `Closed`.
  match decoded_pull_request() {
    PullRequestDecoded { pull: o } => o.state == PullRequestState.Closed
    PullRequestNotDecoded { detail: _ } => false
  }
}

test fn the_user_type_coproduct_decodes_by_its_sibling_contracts_row() -> Bool {
  // The same class one type deeper: extdeps.github.github_contracts.user_type_wire_contract names how
  // "Bot" spells UserType.Bot for GitHubUser.type. The recorded author is gunbai-bot, a Bot.
  match decoded_pull_request() {
    PullRequestDecoded { pull: o } => o.user.type == UserType.Bot
    PullRequestNotDecoded { detail: _ } => false
  }
}

test fn the_recorded_scalar_fields_survive_the_decode() -> Bool {
  match decoded_pull_request() {
    PullRequestDecoded { pull: o } =>
      o.number == 16238
      && o.draft == false
      && o.html_url == "https://github.com/gunb-ai/gunbc/pull/16238"
      && o.user.login == "gunbai-bot[bot]"
      && o.head.sha == "cfcdf23a3cdee54806d367e4adccc30f9d57f13b"
      && o.created_at == "2026-11-10T09:11:39Z"
    PullRequestNotDecoded { detail: _ } => false
  }
}

// THE REGRESSION WITNESS, RUN AT THE PUBLISHER'S OWN COMPILE GRAIN. `gunbc run --function` realizes only
// the declarations the entry can name, which is the grain heal_publication_publish_wet runs at; at
// origin/main the wire-contract rows are excluded there and this refuses. Its reason carries the cause the
// publish path could not print, because the host now mints RestBodyUndecodable's cause from the declared
// type only (v1_interpreter.rs rest_response_declared_cause).
fn pull_request_decode_scoped_run_witness() -> ProcessExit {
  match decoded_pull_request() {
    PullRequestDecoded { pull: o } =>
      if o.state == PullRequestState.Closed && o.user.type == UserType.Bot && o.number == 16238 {
        ExitSuccess
      } else {
        exit_failure(reason: "GithubPullRequestDecodeWitnessRefused: the recorded body decoded, but not into the arms its contracts declare")
      }
    PullRequestNotDecoded { detail: detail } =>
      exit_failure(reason: join(["GithubPullRequestDecodeWitnessRefused: the recorded PR body did not decode: ", detail], ""))
  }
}
