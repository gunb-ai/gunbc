module test.claim.infer_occurrence_binding_scaffold_witness_test


test fn infer_occurrence_binding_v1_adapter_scaffold_is_seed_retained() -> Bool {
  match gunbc.infer_occurrence_binding_scaffold.infer_occurrence_binding_v1_adapter_scaffold {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.SingleAuthority,
      bind: std.decl_ref.DeclarationRef {
        module_path: "std.occurrence_binding",
        decl_name: "occurrence_binding_from_candidates",
        field: std.decl_ref.WholeDeclaration
      }
    } => true
    _ => false
  }
}

test fn infer_occurrence_binding_v1_adapter_dissolve_trigger_names_authority_and_lane() -> Bool {
  string_contains(
    s: std.dissolution.dissolution_description(condition: gunbc.infer_occurrence_binding_scaffold.infer_occurrence_binding_v1_adapter_dissolve_trigger),
    pattern: "occurrence_binding_from_candidates",
  ) &&
    string_contains(
      s: std.dissolution.dissolution_description(condition: gunbc.infer_occurrence_binding_scaffold.infer_occurrence_binding_v1_adapter_dissolve_trigger),
      pattern: "namespace-binding-kernel",
    )
}

test fn infer_occurrence_binding_v1_adapter_receipt_plan_anchor_is_checkable() -> Bool {
  string_contains(
    s: gunbc.infer_occurrence_binding_scaffold.infer_occurrence_binding_v1_adapter_receipt_plan_anchor,
    pattern: "namespace-binding-kernel",
  )
}
