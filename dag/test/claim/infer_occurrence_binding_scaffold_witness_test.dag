module test.claim.infer_occurrence_binding_scaffold_witness_test

import std.disposition { Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.infer_occurrence_binding_scaffold {
  infer_occurrence_binding_v1_adapter_scaffold,
  infer_occurrence_binding_v1_adapter_dissolve_trigger,
  infer_occurrence_binding_v1_adapter_receipt_plan_anchor,
}
import std.dissolution { dissolution_description }

test fn infer_occurrence_binding_v1_adapter_scaffold_is_seed_retained() -> Bool {
  match infer_occurrence_binding_v1_adapter_scaffold {
    Scaffold {
      dissolves_to: SingleAuthority,
      bind: DeclarationRef {
        module_path: "std.occurrence_binding",
        decl_name: "occurrence_binding_from_candidates",
        field: WholeDeclaration
      }
    } => true
    _ => false
  }
}

test fn infer_occurrence_binding_v1_adapter_dissolve_trigger_names_authority_and_lane() -> Bool {
  string_contains(
    s: dissolution_description(condition: infer_occurrence_binding_v1_adapter_dissolve_trigger),
    pattern: "occurrence_binding_from_candidates",
  ) &&
    string_contains(
      s: dissolution_description(condition: infer_occurrence_binding_v1_adapter_dissolve_trigger),
      pattern: "namespace-binding-kernel",
    )
}

test fn infer_occurrence_binding_v1_adapter_receipt_plan_anchor_is_checkable() -> Bool {
  string_contains(
    s: infer_occurrence_binding_v1_adapter_receipt_plan_anchor,
    pattern: "namespace-binding-kernel",
  )
}
