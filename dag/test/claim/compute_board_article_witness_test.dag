module test.claim.compute_board_article_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// The exact decks. These are FULL EQUALITY, not substring probes: a substring oracle passes on
// a deck with an extra element, a missing element, a wrong reference node or a reordered
// netlist, which are all different circuits. An earlier revision of this witness checked three
// substrings and called the result byte-exact.
data expected_spice_deck: String = "power-good conditioning network\nVlogic_in pg_raw 0 12\nRpg_top pg_raw pg_cond 30k\nRpg_bot pg_cond 0 10k\nCpg_filt pg_cond 0 100n"

data expected_verilog_source: String = "module board_power_interlock (\n  input  wire conditioned_good,\n  input  wire fault,\n  output wire power_permit,\n  output wire reset_release\n);\n  assign power_permit = (conditioned_good & ~fault);\n  assign reset_release = (conditioned_good & power_permit);\nendmodule\n"

// ONE ARTICLE FEEDS BOTH EMISSIONS, and both receipts name it. The identity carried in the
// receipt is what makes this a claim about a shared root rather than a coincidence between two
// fixtures: without it, two unrelated articles with equal extracted fields emit indistinguishable
// output and this witness would still be green.
// THE PRODUCTION ARTICLE IS ADMITTED HERE, and that is the whole flow rather than a preamble:
// nothing constructs an AdmittedBoardPowerInterfaceArticle except admit_board_article, so this
// match is the only route by which the production article reaches either projection. A refused
// article fails the witness rather than being projected anyway.
fn admitted_production_article() -> product.compute_board.admission.AdmittedBoardPowerInterfaceArticle? {
  match product.compute_board.admission.admit_board_article(a: product.compute_board.article.power_interlock_article) {
    product.compute_board.admission.BoardArticleAdmitted { article: adm } => Present { value: adm }
    product.compute_board.admission.BoardArticleRefused { causes: _ } => none
  }
}

test fn w_the_production_article_is_admitted() -> Bool {
  match admitted_production_article() {
    Present { value: _ } => true
    Absent => false
  }
}

test fn w_one_article_feeds_both_emissions() -> Bool {
  match admitted_production_article() {
    Absent => false
    Present { value: admitted } =>
  match product.compute_board.spice_projection.project_article_to_spice(admitted: admitted) {
    product.compute_board.spice_projection.SpiceSliceProjected { receipt: sr } =>
      match product.compute_board.verilog_projection.project_article_to_verilog(
        admitted: admitted,
        bindings: product.compute_board.verilog_projection.power_interlock_verilog_bindings
      ) {
        product.compute_board.verilog_projection.VerilogModuleEmitted { receipt: vr } =>
          sr.source == expected_spice_deck
            && vr.source == expected_verilog_source
            && product.compute_board.article.article_identity_eq(a: sr.source_article, b: vr.source_article)
            && (sr.source_article.name as String) == "board power interlock"
            && (sr.source_article.revision as String) == "0"
        product.compute_board.verilog_projection.VerilogProjectionRefused { cause: _ } => false
      }
    product.compute_board.spice_projection.SpiceSliceRefused { cause: _ } => false
  }
  }
}

// THE DISCRIMINATING RED for the SPICE oracle. Perturbing exactly one typed value in the model —
// nothing else — must change the deck. If it did not, the emission would not be a function of
// the model and the byte equality above would be pinning a constant.
// The perturbation is derived from the article's OWN binding list with exactly one standing
// flipped, rather than authored as a standalone list. An authored list names components by
// literal, so when the conditioning network was rebuilt as a divider the literal named a
// component that no longer exists — and the projection still refused, for the unrelated reason
// that every real component had become unbound. The control would have stayed green while
// measuring nothing.
fn perturbed_bindings() -> List<product.compute_board.analog.ComponentModelBinding> {
  fold(power_interlock_article.model_bindings, init: [], f: fn(acc, b) {
    if product.electrical.connectivity.component_local_label(c: b.component) == "pg_top" {
      concat(acc, [product.compute_board.analog.ComponentModelBinding { component: b.component, standing: product.compute_board.analog.ElectricalModelAbsent }])
    } else {
      concat(acc, [b])
    }
  })
}

test fn w_spice_refuses_when_one_binding_is_perturbed() -> Bool {
  match product.compute_board.spice_projection.project_analog_to_spice(
    article_identity: power_interlock_article.identity,
    intent: product.compute_board.article.article_analog(a: product.compute_board.article.power_interlock_article),
    bindings: perturbed_bindings(),
    reference: power_interlock_article.reference_net
  ) {
    product.compute_board.spice_projection.SpiceSliceProjected { receipt: _ } => false
    product.compute_board.spice_projection.SpiceSliceRefused { cause: _ } => true
  }
}

// THE DISCRIMINATING RED for Verilog admission. A signal with no binding refuses; it is never
// spelled by falling back to its logical name, which is the arm that would make a missing
// binding unobservable.
test fn w_verilog_refuses_unbound_signal() -> Bool {
  match admitted_production_article() {
    Absent => false
    Present { value: admitted } =>
      match product.compute_board.verilog_projection.project_article_to_verilog(admitted: admitted, bindings: []) {
        product.compute_board.verilog_projection.VerilogModuleEmitted { receipt: _ } => false
        product.compute_board.verilog_projection.VerilogProjectionRefused { cause: _ } => true
      }
  }
}

fn bond_is_chassis(b: product.compute_board.article.ElectricalBond) -> Bool {
  match b {
    product.compute_board.article.ChassisBond { board_feature: _, chassis_feature: _, standing: _ } => true
    product.compute_board.article.PowerReturnConnection { domain: _, terminal: _ } => false
    product.compute_board.article.SignalReferenceConnection { signal_class: _, terminal: _ } => false
    product.compute_board.article.ProtectiveEarthBond { chassis_feature: _, earth_source: _, standing: _ } => false
    product.compute_board.article.ShieldTermination { shield: _, chassis_feature: _, standing: _ } => false
  }
}

fn bond_is_power_return(b: product.compute_board.article.ElectricalBond) -> Bool {
  match b {
    product.compute_board.article.PowerReturnConnection { domain: _, terminal: _ } => true
    product.compute_board.article.ChassisBond { board_feature: _, chassis_feature: _, standing: _ } => false
    product.compute_board.article.SignalReferenceConnection { signal_class: _, terminal: _ } => false
    product.compute_board.article.ProtectiveEarthBond { chassis_feature: _, earth_source: _, standing: _ } => false
    product.compute_board.article.ShieldTermination { shield: _, chassis_feature: _, standing: _ } => false
  }
}

fn bond_is_signal_reference(b: product.compute_board.article.ElectricalBond) -> Bool {
  match b {
    product.compute_board.article.SignalReferenceConnection { signal_class: _, terminal: _ } => true
    product.compute_board.article.ChassisBond { board_feature: _, chassis_feature: _, standing: _ } => false
    product.compute_board.article.PowerReturnConnection { domain: _, terminal: _ } => false
    product.compute_board.article.ProtectiveEarthBond { chassis_feature: _, earth_source: _, standing: _ } => false
    product.compute_board.article.ShieldTermination { shield: _, chassis_feature: _, standing: _ } => false
  }
}

fn bond_is_proposed_chassis(b: product.compute_board.article.ElectricalBond) -> Bool {
  match b {
    product.compute_board.article.ChassisBond { board_feature: _, chassis_feature: _, standing: st } =>
      match st {
        product.compute_board.article.ChassisBondProposed => true
        product.compute_board.article.ChassisBondObserved { observer: _ } => false
      }
    product.compute_board.article.PowerReturnConnection { domain: _, terminal: _ } => false
    product.compute_board.article.SignalReferenceConnection { signal_class: _, terminal: _ } => false
    product.compute_board.article.ProtectiveEarthBond { chassis_feature: _, earth_source: _, standing: _ } => false
    product.compute_board.article.ShieldTermination { shield: _, chassis_feature: _, standing: _ } => false
  }
}

fn count_bonds(bonds: List<product.compute_board.article.ElectricalBond>, pred: fn(product.compute_board.article.ElectricalBond) -> Bool) -> Int {
  fold(bonds, init: 0, f: fn(acc, b) { if pred(b) { acc + 1 } else { acc } })
}

// The bonds are three DIFFERENT relations, and the discriminating claim is that a power return
// and a signal reference remain distinguishable — which is exactly what a single `Ground` value
// destroys. The chassis bond is additionally PROPOSED, not observed: this board requires an
// enclosure bond and no integration has been observed providing one, so the safety-bearing fact
// is a requirement rather than a claim that a connection exists.
test fn w_electrical_references_are_not_one_ground() -> Bool {
  let bonds = power_interlock_article.bonds
  count_bonds(bonds: bonds, pred: b => bond_is_power_return(b: b)) == 1
    && count_bonds(bonds: bonds, pred: b => bond_is_signal_reference(b: b)) == 1
    && count_bonds(bonds: bonds, pred: b => bond_is_chassis(b: b)) == 1
    && count_bonds(bonds: bonds, pred: b => bond_is_proposed_chassis(b: b)) == 1
}

// The bond endpoints are identities the analog circuit also uses, so this join is decidable
// rather than a spelling coincidence between two independently authored prose fields.
test fn w_bond_endpoints_join_the_analog_circuit_by_identity() -> Bool {
  fold(power_interlock_article.bonds, init: false, f: fn(acc, b) {
    acc || match b {
      product.compute_board.article.PowerReturnConnection { domain: d, terminal: t } =>
        product.electrical.connectivity.net_local_label(n: d) == "power_return"
          && product.electrical.connectivity.component_local_label(c: t.component) == "logic_in"
          && (t.terminal as String) == "2"
      product.compute_board.article.ChassisBond { board_feature: _, chassis_feature: _, standing: _ } => false
      product.compute_board.article.SignalReferenceConnection { signal_class: _, terminal: _ } => false
      product.compute_board.article.ProtectiveEarthBond { chassis_feature: _, earth_source: _, standing: _ } => false
      product.compute_board.article.ShieldTermination { shield: _, chassis_feature: _, standing: _ } => false
    }
  })
}

// The firmware contract's load-bearing claims are about what it does NOT say: signing is
// unavailable rather than absent-and-therefore-assumed, and write protection is declared
// unmodelled rather than defaulted to protected. A contract silent on either would read as safe.
test fn w_firmware_contract_states_its_unknowns_rather_than_defaulting() -> Bool {
  match power_interlock_article.platform_firmware.production_signing {
    product.compute_board.article.ProductionSigningUnavailable { reason: r } =>
      match power_interlock_article.platform_firmware.write_protection {
        product.compute_board.article.WriteProtectionUnmodelled { reason: w } =>
          string_contains(s: r as String, pattern: "no production signing authority")
            && string_contains(s: w as String, pattern: "unmodelled")
        HardwareWriteProtect { control: _ } => false
      }
    ProductionSigningAvailable { authority: _ } => false
  }
}

// Both boundaries EXIST and both refuse, and the physical one names a TYPED cause rather than
// prose. The rung names were corrected with it: an admitted physical interface is not a realized
// board, and a selected manufacturing profile is not a manufacturable one.
test fn w_physical_and_manufacturing_boundaries_refuse_with_named_causes() -> Bool {
  !product.compute_board.article.article_physical_interface_admitted(a: product.compute_board.article.power_interlock_article)
    && !product.compute_board.article.article_manufacturing_profile_selected(a: product.compute_board.article.power_interlock_article)
    && match power_interlock_article.physical {
      product.compute_board.article.PhysicalRealizationPending { causes: cs } =>
        fold(cs, init: false, f: fn(acc, c) {
          acc || match c {
            product.compute_board.article.RequiresExactSubMillimeterCoordinateQuantum => true
            RequiresShapeAndTopology => false
            RequiresPackageFootprintAuthority => false
          }
        })
      PhysicalRealizationAdmitted { outline: _ } => false
    }
    && match power_interlock_article.manufacturing {
      product.compute_board.article.ManufacturingProfileUnselected { pending: p } =>
        string_contains(s: p as String, pattern: "no fabricator selected")
      ManufacturingProfileSelected { fabricator: _, authority: _ } => false
    }
}

// EVERY PRECONDITION SAYS WHAT ESTABLISHES IT, and the three establishment arms are all present
// in the production contract rather than one being decorative. The board's own two are signals it
// drives; the console and the recovery request belong to platform components; boot storage is
// explicitly NOT this article's, which is a claim and not an omission.
fn establishment_kind(p: product.compute_board.article.HostFirmwareStartPrecondition) -> String {
  match p.establishment {
    product.compute_board.article.EstablishedByBoardSignal { signal: _ } => "signal"
    product.compute_board.article.EstablishedByPlatformComponent { role: _ } => "component"
    product.compute_board.article.NotEstablishedByThisArticle { owner: _ } => "not-ours"
  }
}

fn establishment_count(kind: String) -> Int {
  fold(power_interlock_article.platform_firmware.start_preconditions, init: 0, f: fn(acc, p) {
    if establishment_kind(p: p) == kind { acc + 1 } else { acc }
  })
}

test fn w_every_precondition_names_what_establishes_it() -> Bool {
  establishment_count(kind: "signal") == 2
    && establishment_count(kind: "component") == 2
    && establishment_count(kind: "not-ours") == 1
}

// The two board-established preconditions name the signals the interlock actually drives, and the
// admission join is what makes that a checked fact rather than a coincidence between two lists.
// This asserts the pairing itself, so a contract that named the other output would still be
// admitted and would fail here.
fn precondition_signal_for(kind_matches: fn(product.compute_board.article.HostFirmwareStartPrecondition) -> Bool) -> String {
  fold(power_interlock_article.platform_firmware.start_preconditions, init: "", f: fn(acc, p) {
    if kind_matches(p) {
      match p.establishment {
        product.compute_board.article.EstablishedByBoardSignal { signal: s } => s as String
        product.compute_board.article.EstablishedByPlatformComponent { role: _ } => acc
        product.compute_board.article.NotEstablishedByThisArticle { owner: _ } => acc
      }
    } else {
      acc
    }
  })
}

test fn w_the_permit_and_reset_preconditions_name_their_own_signals() -> Bool {
  precondition_signal_for(kind_matches: fn(p) {
    match p.kind {
      product.compute_board.article.PowerPermitAsserted => true
      product.compute_board.article.ResetReleased => false
      product.compute_board.article.BootStorageReadable => false
      product.compute_board.article.RecoveryRequestObservable => false
      product.compute_board.article.ConsoleAvailable => false
    }
  }) == "power_permit"
    && precondition_signal_for(kind_matches: fn(p) {
      match p.kind {
        product.compute_board.article.ResetReleased => true
        product.compute_board.article.PowerPermitAsserted => false
        product.compute_board.article.BootStorageReadable => false
        product.compute_board.article.RecoveryRequestObservable => false
        product.compute_board.article.ConsoleAvailable => false
      }
    }) == "reset_release"
}

// A ROLE FILLED BY A CITED PROJECT RESOLVES TO THAT PROJECT'S SUBJECT, and the two roles with no
// upstream module say so rather than answering Absent. The distinction is the whole point: an
// Optional would make "nobody has cited this yet" indistinguishable from "there is nothing to
// cite", and only the first is an authoring gap someone can close.
fn role_is_cited(role: product.compute_board.article.PlatformFirmwareRole) -> Bool {
  match product.compute_board.article.platform_firmware_role_upstream(role: role) {
    product.compute_board.article.UpstreamCited { subject: _ } => true
    product.compute_board.article.UpstreamNotModelledHere { reason: _ } => false
  }
}

test fn w_the_three_upstream_roles_resolve_to_cited_subjects() -> Bool {
  role_is_cited(role: product.compute_board.article.TrustedFirmwareSecureBootChain)
    && role_is_cited(role: product.compute_board.article.HostUefiFirmware)
    && role_is_cited(role: product.compute_board.article.BaseboardManagementFirmware)
}

test fn w_the_two_uncited_roles_name_why_rather_than_answering_absent() -> Bool {
  match product.compute_board.article.platform_firmware_role_upstream(role: product.compute_board.article.SystemControlProcessorFirmware) {
    product.compute_board.article.UpstreamCited { subject: _ } => false
    product.compute_board.article.UpstreamNotModelledHere { reason: r } => (r as String) != ""
  }
    && match product.compute_board.article.platform_firmware_role_upstream(role: product.compute_board.article.BoardProgrammableLogic) {
      product.compute_board.article.UpstreamCited { subject: _ } => false
      product.compute_board.article.UpstreamNotModelledHere { reason: r } => (r as String) != ""
    }
}

// The cited subjects are DISTINCT modules. Three roles resolving to one subject would mean the
// decomposition bought nothing — which is the failure the split exists to avoid, and it is not
// visible from the fact that each role answers UpstreamCited.
test fn w_the_cited_roles_do_not_collapse_onto_one_subject() -> Bool {
  match product.compute_board.article.platform_firmware_role_upstream(role: product.compute_board.article.TrustedFirmwareSecureBootChain) {
    product.compute_board.article.UpstreamNotModelledHere { reason: _ } => false
    product.compute_board.article.UpstreamCited { subject: a } =>
      match product.compute_board.article.platform_firmware_role_upstream(role: product.compute_board.article.HostUefiFirmware) {
        product.compute_board.article.UpstreamNotModelledHere { reason: _ } => false
        product.compute_board.article.UpstreamCited { subject: b } =>
          match product.compute_board.article.platform_firmware_role_upstream(role: product.compute_board.article.BaseboardManagementFirmware) {
            product.compute_board.article.UpstreamNotModelledHere { reason: _ } => false
            product.compute_board.article.UpstreamCited { subject: c } =>
              a.module_path != b.module_path
                && b.module_path != c.module_path
                && a.module_path != c.module_path
          }
      }
  }
}
