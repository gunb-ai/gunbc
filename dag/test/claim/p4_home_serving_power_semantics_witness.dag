module test.claim.p4_home_serving_power_semantics_witness

import std.types { Bool, Int, List, String }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.algebra { Cons, Empty, string_contains }
import v2.std.decl_index { DeclFact, decl_facts_at }
import v2.extdeps.file_system { Filesystem }
import std.markdown { MarkdownDocument }
import gunbc.plan { Plan, plan_projects_committed_markdown }
import gunbc.plan_registry { all_plans }
import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.plans.p4_home_serving_power_semantics { p4_home_serving_power_semantics_plan }

// Guards on the P4 watt-semantics decision CARRIER. DESIGN §1: "A plan's authority is
// its `.dag` carrier; generated plan markdown whose only consumer is ProjectDocumentation
// is not a checkout artifact." This document is a decision record, so its carrier is the
// only authority and there is deliberately no docs/plans/*.md for it — the claim below
// pins that, rather than leaving it to a comment.
//
// Each claim is written so its RED is reachable on the real acceptance path (DESIGN §4b:
// "A check whose forbidden state is expressible nowhere it runs is a decoration, green by
// construction and later cited as coverage"). The body is read through the repository's
// OWN serializer, `extdeps.languages.markdown::serialize_markdown_source`, not a
// hand-written AST walk: minting a second walker beside the one that renders the document
// would be the §2 re-invention these claims exist to police, and a private walker could
// drift from the renderer with both sides staying green.

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ── The GENERAL positional-citation rule, not a list of shapes I happened to observe.
// An earlier head of this PR shipped `-- :136`, `-- :226` and `external_authority:13-16`
// while this claim was GREEN, because the guard then enumerated suffixes (`.dag:`, `.rs:`,
// `.py:`, `DESIGN.md:`) and none of those three has a file suffix — they were inside a
// fenced code sample, which the prose rewrites never touch. Enumerating shapes reproduces
// the bug; encoding the distinction does not.
//
// DESIGN §3 permits a position only BESIDE a symbol, never AS the citation. The
// distinction is measurable: in `foo:12`, `12:39Z` and `12:55:33Z`, a time or a counter
// has a DIGIT before its colon, while a citation never does. So split on `:` and flag a
// segment that begins with a digit while the segment before it does not END with one.
// Measured: flags all three shipped defects in the previous head's serialized text, and
// flags nothing in the current one — where the timestamps `12:39Z` and `12:55:33Z` (inside
// a verbatim escalation quote that must be kept) survive.
type P4PositionScan {
  index: Int
  prev_ends_in_digit: Bool
  found_positional: Bool
}

fn p4_is_digit(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789", pattern: c)
}

fn p4_last_is_digit(s: String) -> Bool {
  p4_is_digit(c: substring(s: s, start: s.length() - 1, end: s.length()))
}

fn p4_positional_step(acc: P4PositionScan, segment: String) -> P4PositionScan {
  let begins_in_digit = p4_is_digit(c: substring(s: segment, start: 0, end: 1))
  P4PositionScan {
    index: acc.index + 1,
    prev_ends_in_digit: p4_last_is_digit(s: segment),
    found_positional: acc.found_positional || (acc.index > 0 && begins_in_digit && !acc.prev_ends_in_digit)
  }
}

fn p4_has_positional_citation(t: String) -> Bool {
  fold(
    t.split(delimiter: ":"),
    init: P4PositionScan { index: 0, prev_ends_in_digit: false, found_positional: false },
    f: p4_positional_step
  ).found_positional
}

fn carrier_is_registered() -> Bool {
  fold(all_plans, init: false, f: (acc, p) => acc || p.slug == "p4-home-serving-power-semantics")
}

fn carrier_text() -> String {
  serialize_markdown_source(doc: MarkdownDocument { blocks: p4_home_serving_power_semantics_plan.body })
}

// ── DESIGN §1, and the reason the markdown was deleted rather than kept beside the
// carrier. `gunbc.plan::plan_projects_committed_markdown` answers false only for
// `PlanIsAuthorityOnly`; the generated-artifact gate then treats a committed projection of
// this plan as a stale artifact. RED: switching the projection to
// `PlanProjectsCommittedMarkdown`, or registering a second plan whose document restates
// this decision, turns this red. Registered-ness is checked through `all_plans` rather
// than from the import alone, so a carrier dropped from the registry cannot pass by the
// import still resolving.
test fn the_carrier_is_registered_and_is_the_only_authority() -> Bool {
  carrier_is_registered()
    && plan_projects_committed_markdown(p: p4_home_serving_power_semantics_plan) == false
}

// ── DESIGN §3: "Cite the symbol, not the position. A `file:line` pointer is a second,
// positional naming scheme that any edit above the line silently invalidates." This
// asserts over SERIALIZED text, so it catches a positional citation wherever it hides —
// body prose, list items, table cells, quoted blocks, and the fenced code sample alike.
// The suffix list below names the common shapes; the load-bearing part is
// `p4_has_positional_citation`, which enforces the RULE rather than a list. Both are
// asserted because each is blind to what the other catches: a bare `-- :136` has no file
// suffix to match, and `12:55:33Z` must survive a rule written too loosely. That is why the
// rule tests the character BEFORE the colon as well as after it — the carrier is required to
// quote instrument commands such as `awk -F: '$NF>1'`, and a rule keyed only on
// "digits after a colon" would forbid the instruments this document exists to name.
//
// This rule is not decorative here: one seal-check citation in an earlier draft had its
// line number drift out from under it *while this document was being written* — the check
// moved from `:17368` to `:17466` as main took other merges — which is exactly the failure
// §3 names, and the reason the symbol is cited instead.
test fn the_carrier_cites_symbols_and_never_a_line_number() -> Bool {
  let t = carrier_text()
  // Positive conjuncts FIRST. This claim's load-bearing part is a NEGATIVE assertion, and
  // a negative assertion is satisfied by an empty read: if the subject module stopped
  // resolving or the body ever became empty, every `string_contains` would return false
  // and this claim would be green while proving nothing. DESIGN §4b names that a
  // decoration. So the same claim also requires the text to be a substantive document that
  // really carries the symbols it is supposed to carry — break the read and the claim goes
  // red instead of green.
  t.length() > 4000
    && string_contains(s: t, pattern: "extdeps.gpu.types::GpuModelCatalogRow.tdp_watts")
    && string_contains(s: t, pattern: "gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit")
    && string_contains(s: t, pattern: "v1.compiler.infer::constructor_admission_diags_from_lookup")
    && !(string_contains(s: t, pattern: ".dag:")
      || string_contains(s: t, pattern: ".rs:")
      || string_contains(s: t, pattern: ".py:")
      || string_contains(s: t, pattern: "DESIGN.md:")
      // Stripped-citation DEBRIS. Deleting a `path:line` is only half an edit: the husk it
      // leaves (" ()", " at.", "at/.") is the same positional defect wearing different
      // clothes, and an earlier head of this PR shipped 12 of them. Policing the citation
      // but not its residue would be a guard that passes the bug it was written for.
      || string_contains(s: t, pattern: " ()")
      || string_contains(s: t, pattern: "at/.")
      || string_contains(s: t, pattern: " at.")
      || string_contains(s: t, pattern: "are at/")
      || string_contains(s: t, pattern: "there at/")
      // a citation deleted from INSIDE a parenthetical leaves the paren open on a comma:
      // `(`:250`, which compares ...)` lost its citation and its subject together.
      || string_contains(s: t, pattern: "(,")
      || string_contains(s: t, pattern: ",)")
      // ...and the general rule behind them, so the next shape is caught without being
      // enumerated first. This is what the suffix list above could not do.
      || p4_has_positional_citation(t: t))
}

// ── DESIGN §6: "Name the instrument, never transcribe its output ... a transcribed number
// rots unreachably." Every quantity this decision rests on must arrive as the command that
// re-derives it. The numbers in an earlier draft had already gone stale twice over (the
// dag file-count claims disagreed between two checks of the same document), which is the
// rotting this rule exists to prevent.
//
// Each conjunct pins a DIFFERENT claim's instrument, so deleting any one command from the
// carrier reddens this claim on its own rather than silently narrowing it: the applied-limit
// site list, the WarmValid construction classification, the missing-roster absence check, the
// dag file-count invariant, the "600 is a label not a measurement" split, and the
// no-watt-field-in-the-fixture reading.
// What THIS claim checks is a property of the DOCUMENT, not of the tree: a
// decision record may leave a quantity unread, but not unnamed. Where it does,
// it must hand over the command that reads it, so no number in this plan is ever
// the last word. DESIGN §6: "Name the instrument, never transcribe its output."
// The readings themselves are executed by the tree-reading claims below, not here.
test fn the_carrier_names_an_instrument_for_every_quantity_it_leaves_unread() -> Bool {
  let t = carrier_text()
  string_contains(s: t, pattern: "git grep -n applied_power_limit dag")
    && string_contains(s: t, pattern: "git grep -n WarmValid dag")
    && string_contains(s: t, pattern: "grep -c admit_callers dag/gunbc/serving/gpu_bench_warm_standing.dag")
    && string_contains(s: t, pattern: "git ls-tree -r --name-only origin/main -- dag")
    && string_contains(s: t, pattern: "grep -o \"600\"")
    && string_contains(s: t, pattern: "grep -Ei 'watt|power|tdp' fixtures/gpu_bench/pro6000ws_600w_v2/*")
}

// ── DESIGN §4d: "Do not assert as deduced what is only inferred." The ruling here was the
// escalation closing on its recommendation with no operator answer inside the window — a
// DEFAULT, not an endorsement. If the carrier ever read as though the operator had chosen
// option C, that would state a decision nobody made; and because the fleet question is still
// unanswered, the carrier must keep saying so rather than implying the choice is settled.
// Also a DOCUMENT property: the wording must keep saying the ruling is a default
// and that no card is chosen. That the fleet question is genuinely still open is
// carried by the absence check in the census claim, not by this wording check.
test fn the_carrier_records_the_ruling_as_a_default_that_is_no_card_chosen() -> Bool {
  let t = carrier_text()
  string_contains(s: t, pattern: "decided — by default, not by the operator")
    && string_contains(s: t, pattern: "licenses the shape, not a number")
    && string_contains(s: t, pattern: "Still open after this PR")
}


// ──────────────────────────────────────────────────────────────────────────────────────
// THE CITATIONS IN THIS PLAN RESOLVE IN THE TREE, NOT ONLY IN THE PLAN'S OWN SENTENCES.
//
// Review 82961 (§4d, §5) caught the reason the four claims above were insufficient: every
// one of them searches the carrier's TEXT for a string, so a citation to a module that does
// not exist is satisfied by the sentence that asserts it. A green claim of that shape is
// the §4b decoration -- "green by construction and later cited as coverage". This claim
// asks the tree instead, through `v2.std.decl_index`, the repository's own declaration
// census, using the membership idiom already established by
// `test.claim.fleet.runtime_identity_match_witness::cites`.
//
// WHY THE ROSTER IS DERIVED AND NEVER RESTATED (§2, and the precedent's own lesson: "the
// list is DERIVED from the rows, so it cannot drift from them"): `p4_citation_roster` reads
// the carrier's serialized text and takes every whitespace/backtick-delimited piece shaped
// like `module::decl` or `module::decl.field`. Add a citation to the plan and it is checked
// without touching this file; delete one and it stops being checked. Nothing here is a copy
// of the prose.
//
// AND THE CHECK THAT MAKES THAT DERIVATION UN-SILENCABLE: `p4_citation_count_is_conserved`
// requires that every `::` in the text is accounted for by the roster. Restating the list
// by hand, or narrowing the shape test until citations fall out of it, reddens that
// conjunct instead of quietly reducing the work -- which is exactly the failure mode a
// derived roster otherwise invites.
type P4Citation {
  module_path: String
  decl_name: String
  field_name: String
  has_field: Bool
}

// the pieces of the text that could be citations, split on the delimiters that surround one
fn p4_pieces(t: String) -> List<String> {
  filter(
    flat_map(t.split(delimiter: "\n"), line =>
      flat_map(line.split(delimiter: " "), word => word.split(delimiter: "`"))),
    w => w != ""
  )
}

fn p4_char_of(s: String) -> String {
  substring(s: s, start: s.length() - 1, end: s.length())
}

// the shape test. A citation is `module::decl` or `module::decl.field` and NOTHING else:
// exactly one `::` pair, no path separator, no punctuation, no whitespace. The separator is
// removed before the rejection scan because `::` itself contains a colon, which is otherwise
// a reject character -- that bug was live in the first draft of this test and rejected every
// citation, which is the kind of thing a measured roster catches and an assumed one does not.
fn p4_body_is_clean(body: String) -> Bool {
  !(string_contains(s: body, pattern: "/")
    || string_contains(s: body, pattern: "(")
    || string_contains(s: body, pattern: ")")
    || string_contains(s: body, pattern: "[")
    || string_contains(s: body, pattern: "]")
    || string_contains(s: body, pattern: "{")
    || string_contains(s: body, pattern: "}")
    || string_contains(s: body, pattern: ",")
    || string_contains(s: body, pattern: ";")
    || string_contains(s: body, pattern: "*")
    || string_contains(s: body, pattern: "?")
    || string_contains(s: body, pattern: "=")
    || string_contains(s: body, pattern: "+")
    || string_contains(s: body, pattern: "<")
    || string_contains(s: body, pattern: ">")
    || string_contains(s: body, pattern: "&")
    || string_contains(s: body, pattern: "!")
    || string_contains(s: body, pattern: "\"")
    || string_contains(s: body, pattern: "'")
    || string_contains(s: body, pattern: "~")
    || string_contains(s: body, pattern: "^")
    || string_contains(s: body, pattern: "|")
    || string_contains(s: body, pattern: "#")
    || string_contains(s: body, pattern: "\\")
    || p4_char_of(s: body) == "."
    || substring(s: body, start: 0, end: 1) == ".")
}

// The shape is matched STRUCTURALLY rather than counted: `a::b` with nothing after the
// second part is exactly one separator. Three arms' worth of `length() == 2 && parts[0]
// != "" ...` was what the first draft did, and indexing is safe-indexing here -- it hands
// back Optional, which infer caught. Matching Cons/Empty is also how the repo reads a
// split apart (`extdeps.linux.proc_pid_stat`, `test.claim.runner.runner_qemu_host_standing`).
// The separator is removed before the rejection scan because `::` itself contains a colon,
// which is otherwise a reject character -- that bug was live in the first draft and rejected
// every citation, which is what a measured roster catches and an assumed one does not.
fn p4_is_citation_shape(w: String) -> Bool {
  match w.split(delimiter: "::") {
    Cons { head: m, tail: Cons { head: d, tail: Empty } } => m != "" && d != "" && p4_body_is_clean(body: concat(m, d))
    _ => false
  }
}

// Only ever reached on a string that p4_is_citation_shape accepted, so the two-arm
// reading is total in practice; the `_` arm exists because a match must be total, and it
// yields the one thing that cannot resolve -- an empty module -- rather than a guess.
fn p4_parse(w: String) -> P4Citation {
  match w.split(delimiter: "::") {
    Cons { head: m, tail: Cons { head: rest, tail: Empty } } =>
      match rest.split(delimiter: ".") {
        Cons { head: d, tail: Cons { head: fld, tail: Empty } } =>
          P4Citation { module_path: m, decl_name: d, field_name: fld, has_field: true }
        _ => P4Citation { module_path: m, decl_name: rest, field_name: "", has_field: false }
      }
    _ => P4Citation { module_path: "", decl_name: "", field_name: "", has_field: false }
  }
}

fn p4_roster_step(acc: List<String>, w: String) -> List<String> {
  if p4_is_citation_shape(w) && !any(acc, a => a == w) { Cons { head: w, tail: acc } } else { acc }
}

fn p4_citation_roster(t: String) -> List<String> {
  fold(p4_pieces(t), init: Empty {}, f: p4_roster_step)
}

fn p4_occurrences(t: String, cite: String) -> Int {
  // n occurrences of a separator produce n+1 pieces, so occurrences = pieces - 1. The
  // obvious `filter(non-empty).length()` undercounts (two occurrences with an empty piece
  // between them give 1, not 2) -- caught by running the roster arithmetic, not by reading it.
  t.split(delimiter: cite).length() - 1
}

// THE POSITIVE CONTROL ON THE DERIVATION ITSELF. Every `::` in the text must be covered by
// the roster; if the shape test ever excludes a real citation, or the roster is narrowed to
// make the claim pass, this conjunct goes red rather than the claim going quietly green.
fn p4_citation_count_is_conserved(t: String) -> Bool {
  let roster = p4_citation_roster(t)
  let covered = fold(roster, init: 0, f: (n, cite) => n + p4_occurrences(t: t, cite: cite))
  let separators = t.split(delimiter: "::").length() - 1
  covered == separators && separators > 20
}

// A FIELD is not a declaration, so the census cannot answer for it. Checked instead against
// the declaring file's own text, read with `filesystem_read` at the `rel_path` the census row
// carries -- so the file is the census's, not one this claim guessed. Honest about its reach:
// this proves the field is written as a field line (`  name: Type`) somewhere in that file,
// which is weaker than a name-resolved field lookup, and the two citations that need it are
// `extdeps.gpu.types::GpuModelCatalogRow.tdp_watts` and
// `gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit`.
fn p4_declares_field(fact: DeclFact, field: String) -> Bool {
  let source = filesystem_read(path: fact.rel_path)
  string_contains(s: source.content, pattern: concat("  ", concat(field, ": ")))
}

// THE CENSUS READ. `v2.std.decl_index::decl_facts_at` is the keyed host-side read, not a fold
// over the whole corpus: the precedent warns that repeated full `decl_facts` calls took a
// witness "past any bound" (3.6s each measured) and this asks one question per citation.
// Pools dag AND src/v1 -- measured, not assumed: with only ["dag","src/v2"] pooled, the four
// `v1.*` citations in this plan resolve to ZERO rows. The census keys on the AUTHORED module
// name, which is why `v1.compiler.infer` resolves although its file is `src/v1/04_infer.dag`,
// a path no caller could have guessed from the name.
fn p4_citation_resolves(cite: String) -> Bool {
  let c = p4_parse(w: cite)
  let rows = decl_facts_at(pool_roots: ["dag", "src/v1", "src/v2"], qualified_name: concat(c.module_path, concat(".", c.decl_name)))
  if c.has_field {
    rows.length() >= 1 && any(rows, r => p4_declares_field(fact: r, field: c.field_name))
  } else {
    rows.length() >= 1
  }
}

test fn the_citations_in_the_plan_resolve_against_the_declaration_census() -> Bool {
  let t = carrier_text()
  let roster = p4_citation_roster(t)
  // NEGATIVE CONTROLS FIRST. A census read that came back empty would satisfy every
  // resolution check vacuously for the negative ones and fail the positives, so the
  // population and the roster size are asserted in the same breath as the citations.
  // The unmerged module is the load-bearing one: it must stay UNRESOLVED, which is what
  // makes this claim able to tell "present" from "asserted by the document".
  p4_citation_count_is_conserved(t: t)
    && roster.length() > 20
    && !p4_citation_resolves(cite: "gunbc.serving.home_serving_power_policy::HomeServingPowerAdmission")
    && all(roster, cite => p4_citation_resolves(cite: cite))
}

// ── real reads, not greps of the plan's own prose ────────────────────────────
// These claims EXECUTE. Each reads what it asserts out of the tree that
// declares it, so a change in the data reddens the claim instead of quietly
// rotting a sentence. DESIGN §5: "a typecheck and a `.contains()` grep are not
// consumers. Done means a real consumer green by execution plus a discriminating
// input that goes red when the behavior is wrong." Every reading this plan used
// to print now lives here, read from what declares it.

// The body of one `data <row>: GpuModelCatalogRow`, cut from the catalog source
// between its own header and the next row's. Empty when the row is absent, so an
// absent row fails every check that reads it rather than passing vacuously.
fn p4_catalog_row_block(text: String, row: String) -> String {
  let after = match text.split(delimiter: concat(concat("\ndata ", row), ": GpuModelCatalogRow")) {
    Cons { head: _, tail: Cons { head: a, tail: _ } } => a
    _ => ""
  }
  match after.split(delimiter: "\ndata ") {
    Cons { head: block, tail: _ } => block
    _ => ""
  }
}

data p4_frontier_acc: Rec {
  candidates: List<String>,
  references: List<String>,
  stage: Int
}

// Reads the frontier's own two lists out of the module that declares them, so the
// candidate set is not a copy of a list someone typed into a plan.
fn p4_frontier_step(acc: p4_frontier_acc, line: String) -> p4_frontier_acc {
  let trimmed = line.trim()
  let name = trimmed.replace("\"", "").replace(",", "")
  let enter_candidates = line.starts_with(prefix: "data home_serving_add_in_card_catalog_rows")
  let enter_references = line.starts_with(prefix: "data home_serving_reference_sxm_catalog_rows")
  let closes = trimmed.starts_with(prefix: "]")
  let is_entry = trimmed.starts_with(prefix: "\"")
  if acc.stage == 0 {
    if enter_candidates {
      p4_frontier_acc { candidates: acc.candidates, references: acc.references, stage: 1 }
    } else {
      acc
    }
  } else if acc.stage == 1 {
    if closes {
      p4_frontier_acc { candidates: acc.candidates, references: acc.references, stage: 2 }
    } else if is_entry {
      p4_frontier_acc { candidates: concat(acc.candidates, [name]), references: acc.references, stage: 1 }
    } else {
      acc
    }
  } else if acc.stage == 2 {
    if enter_references {
      p4_frontier_acc { candidates: acc.candidates, references: acc.references, stage: 3 }
    } else {
      acc
    }
  } else if acc.stage == 3 {
    if closes {
      p4_frontier_acc { candidates: acc.candidates, references: acc.references, stage: 4 }
    } else if is_entry {
      p4_frontier_acc { candidates: acc.candidates, references: concat(acc.references, [name]), stage: 3 }
    } else {
      acc
    }
  } else {
    acc
  }
}

fn p4_candidate_has_ceiling(catalog: String, row: String) -> Bool {
  let block = p4_catalog_row_block(text: catalog, row: row)
  block != "" && string_contains(block, "  tdp_watts: watt(count: ")
}

fn p4_reference_is_unstated(catalog: String, row: String) -> Bool {
  let block = p4_catalog_row_block(text: catalog, row: row)
  block != "" && string_contains(block, "  tdp_watts: none")
}

// The plan once printed the candidates' ceilings and named the rows that carry
// none. Both were frozen readings. Here they are read instead: the frontier's
// candidate list is parsed from the module that declares it, each name is looked
// up in the catalog source it names, and the partition must hold — a candidate
// with no stated ceiling, or an unstated ceiling on a row nobody designated a
// reference, is red. The unstated total is counted from the catalog itself and
// must equal the reference list's length, so neither list can drift alone.
test fn the_candidate_ceilings_are_read_from_the_catalog_that_declares_them() -> Bool {
  let frontier = filesystem_read(path: "dag/gunbc/serving/home_serving_accelerator_field.dag").content
  let catalog = filesystem_read(path: "dag/extdeps/gpu/nvidia.dag").content
  let rows = fold(
    frontier.split(delimiter: "\n"),
    init: p4_frontier_acc { candidates: [], references: [], stage: 0 },
    f: p4_frontier_step
  )
  let every_candidate_states_a_ceiling = all(rows.candidates, row => p4_candidate_has_ceiling(catalog, row))
  let every_reference_is_unstated = all(rows.references, row => p4_reference_is_unstated(catalog, row))
  let unstated = catalog.split(delimiter: "  tdp_watts: none").length() - 1
  rows.candidates.length() > 0
    && rows.references.length() > 0
    && every_candidate_states_a_ceiling
    && every_reference_is_unstated
    && unstated == rows.references.length()
}

// The first row the census returns for a module, or "" when it knows none — so a
// module nobody has indexed reddens the claim that reads its file.
fn p4_first_rel_path(rows: List<DeclFact>) -> String {
  match rows {
    Cons { head: d, tail: _ } => d.rel_path
    _ => ""
  }
}

fn p4_read_declared_module(pools: List<String>, qualified_name: String) -> String {
  let path = p4_first_rel_path(decl_facts_at(pool_roots: pools, qualified_name: qualified_name))
  if path == "" { "" } else { filesystem_read(path: path).content }
}

// The two `Watt?` fields are read from the file the declaration census names for
// each module — not from a path this file guesses — and the ABSENCE of any
// relation between them is read from the two modules such a rule would live in.
// This is the check that made the plan's "nothing in the tree relates them"
// statement worth anything: if either field changes type, or a rule appears, red.
test fn the_two_watt_fields_are_read_from_where_they_are_declared() -> Bool {
  let pools = ["dag", "src/v1", "src/v2"]
  let catalog_src = p4_read_declared_module(pools, "extdeps.gpu.types")
  let subject_src = p4_read_declared_module(pools, "gunbc.spark.serving_performance_subject")
  let standing_src = filesystem_read(path: "dag/gunbc/serving/gpu_bench_warm_standing.dag").content
  string_contains(catalog_src, "  tdp_watts: Watt?")
    && string_contains(subject_src, "  applied_power_limit: Watt?")
    && !string_contains(catalog_src.to_lower(), "applied_power_limit")
    && !string_contains(subject_src.to_lower(), "tdp")
    && !string_contains(standing_src.to_lower(), "tdp")
}

data p4_digit_scan: Rec {
  seen: Int,
  unexplained: Int
}

// Every line carrying the run-name digits is a label; anything else that carries
// them has to be explained, so the claim cannot be satisfied by an empty scan.
fn p4_digit_step(acc: p4_digit_scan, line: String) -> p4_digit_scan {
  if !string_contains(line, "600") {
    acc
  } else if string_contains(line, "pro6000ws") || string_contains(line, "600w") {
    p4_digit_scan { seen: acc.seen + 1, unexplained: acc.unexplained }
  } else {
    p4_digit_scan { seen: acc.seen + 1, unexplained: acc.unexplained + 1 }
  }
}

// "The fixtures carry no watt figure" was a sentence; it is now a read of every
// entry the directory actually holds, so a fixture added later with a power
// column reddens it. The device row's four columns are read from both files that
// carry it, and the run-name-label explanation of every `600` in the receipts is
// scanned line by line — the plan's `grep -o "600"` line claims nothing on its own.
test fn the_gpu_bench_fixtures_carry_no_watt_figure_and_no_measurement() -> Bool {
  let dir = "fixtures/gpu_bench/pro6000ws_600w_v2"
  let listing = Filesystem.List(path: dir, expect: ExpectSuccess)
  let nothing_reads_as_power = all(listing.entries, name => {
    let body = filesystem_read(path: concat(concat(dir, "/"), name)).content.to_lower()
    !string_contains(body, "watt")
      && !string_contains(body, "tdp")
      && !string_contains(body, "power")
      && !string_contains(body, "w /")
  })
  let auto = filesystem_read(path: concat(concat(dir, "/"), "auto.log")).content
  let receipts = filesystem_read(
    path: concat(concat(dir, "/"), "warm_ninfer_nvfp4_pro6000ws_600w.jsonl")
  ).content
  let scan = fold(
    receipts.split(delimiter: "\n"),
    init: p4_digit_scan { seen: 0, unexplained: 0 },
    f: p4_digit_step
  )
  listing.entries.length() > 0
    && nothing_reads_as_power
    && string_contains(auto, "name, memory.total")
    && !string_contains(auto.to_lower(), "w /")
    && scan.seen > 0
    && scan.unexplained == 0
}
