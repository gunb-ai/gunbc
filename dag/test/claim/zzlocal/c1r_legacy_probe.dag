module test.claim.zzlocal.c1r_legacy_probe

import std.types { String }
import gunbc.roadmap.roadmap_attempt_exit_spool {
  attempt_exit_entry_decode, AttemptExitEntryDecoded, AttemptExitEntryMalformed,
}

// C1r GATE (option-1 design, #15640 comment 6578228894): every captured srv1 exit-spool name must
// decode under the merged-B decoder. Names captured read-only 2026-11-02T13:07Z; see /tmp/srv1-entries.txt.
// Expected reds: the 5 hand-in files (no 4-part arm) and the 3 unexpanded entries. Anything else red is
// a strictness regression B introduces over main.
// cur d debt-exclusion-frontier-excludes-nothing+6ea61c671002a6d4+worker+${INVOCATION_ID}+${SERVICE_RESULT}+${EXIT_CODE}+${EXIT_STATUS}
test fn c1r_cur_000_debt_exclusion_frontier_excl() -> Bool {
  match attempt_exit_entry_decode(entry_name: "debt-exclusion-frontier-excludes-nothing+6ea61c671002a6d4+worker+$\{INVOCATION_ID}+$\{SERVICE_RESULT}+$\{EXIT_CODE}+$\{EXIT_STATUS}") {
    AttemptExitEntryDecoded { record: _ } => true
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

