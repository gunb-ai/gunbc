module test.claim.citation_cit1_witness

import extdeps.standards.rfc_8118 {
  extdeps_external_authority_anchor,
  rfc_8118_section_3_locator,
  iso_32000_2_authority,
  rfc_8118_normative_relationship_note,
  citation_cit1_witness_split_note,
  extdeps_model_scope,
  PdfOpenPage,
  OpenPage,
  ParameterConstructed,
  ParameterConstructionRefused,
  ParameterOutsideCit1SafeProfile,
  PdfParameterZoom,
  PdfParameterComment,
  SequenceConstructionRefused,
  SequenceConstructed,
  NavigableUriProjected,
  NavigableUriRefused,
  BaseLocatorAlreadyCarriesFragment,
  ParameterConstructionRefusedInSequence,
  pdf_open_page,
  pdf_open_zoom,
  pdf_open_comment,
  pdf_open_parameter_sequence,
  pdf_open_parameters_include_page,
  project_navigable_uri,
  pdf_profile_parameter_wire,
}
import extdeps.uri { Uri, Https }
import std.types { Bool, NonEmptyStr }

data witness_pdf_base_uri: Uri = Uri {
  scheme: Https,
  locator: "example.test/fixture.pdf",
}

test fn rfc_8118_anchor_cites_current_standard_not_3778() -> Bool {
  extdeps_model_scope.first_citation.uri.locator == rfc_8118_section_3_locator && string_contains(s: rfc_8118_normative_relationship_note, pattern: "OBSOLETES RFC 3778") && string_contains(s: rfc_8118_normative_relationship_note, pattern: "ISO 32000-2 controls")
}

test fn iso_32000_2_is_further_citation() -> Bool {
  extdeps_model_scope.further_citations |> any(c => c.uri.locator == iso_32000_2_authority.uri.locator)
}

test fn pdf_open_page_admits_positive_one() -> Bool {
  match pdf_open_page(page: 1) {
    ParameterConstructed(OpenPage(PdfOpenPage { page: p })) => p == 1
    _ => false
  }
}

test fn pdf_open_zoom_refuses_outside_safe_profile() -> Bool {
  match pdf_open_zoom(scale_percent: 100) {
    ParameterConstructionRefused { cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterZoom } } => true
    _ => false
  }
}

test fn pdf_open_comment_refuses_with_typed_parameter_kind() -> Bool {
  match pdf_open_comment(comment_id: "note-1" as NonEmptyStr) {
    ParameterConstructionRefused { cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterComment } } => true
    _ => false
  }
}

test fn pdf_open_parameter_sequence_refuses_only_refused_parameters() -> Bool {
  match pdf_open_parameter_sequence(constructions: [pdf_open_zoom(scale_percent: 100)]) {
    SequenceConstructionRefused { cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterZoom } } => true
    _ => false
  }
}

test fn pdf_open_parameters_include_page_holds_for_authored_page() -> Bool {
  pdf_open_parameters_include_page(
    construction: pdf_open_parameter_sequence(constructions: [pdf_open_page(page: 1)]),
    page: 1,
  )
}

test fn pdf_open_parameters_include_page_red_wrong_page() -> Bool {
  !pdf_open_parameters_include_page(
    construction: pdf_open_parameter_sequence(constructions: [pdf_open_page(page: 1)]),
    page: 99,
  )
}

test fn project_navigable_uri_appends_ordered_fragment() -> Bool {
  match project_navigable_uri(
    base: witness_pdf_base_uri,
    sequence_construction: pdf_open_parameter_sequence(constructions: [pdf_open_page(page: 1)]),
  ) {
    NavigableUriProjected { uri: u } => u.locator == "example.test/fixture.pdf#page=1"
    _ => false
  }
}

test fn project_navigable_uri_refuses_when_base_carries_fragment() -> Bool {
  match project_navigable_uri(
    base: extdeps_external_authority_anchor.uri,
    sequence_construction: pdf_open_parameter_sequence(constructions: [pdf_open_page(page: 1)]),
  ) {
    NavigableUriRefused { cause: BaseLocatorAlreadyCarriesFragment { locator: l } } =>
      l == rfc_8118_section_3_locator
    _ => false
  }
}

test fn project_navigable_uri_refuses_mixed_admitted_and_refused_parameters() -> Bool {
  match project_navigable_uri(
    base: witness_pdf_base_uri,
    sequence_construction: pdf_open_parameter_sequence(constructions: [pdf_open_page(page: 1), pdf_open_zoom(scale_percent: 100)]),
  ) {
    NavigableUriRefused { cause: ParameterConstructionRefusedInSequence { cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterZoom } } } => true
    _ => false
  }
}

test fn pdf_profile_parameter_wire_names_page() -> Bool {
  match pdf_open_page(page: 3) {
    ParameterConstructed(parameter) => pdf_profile_parameter_wire(parameter: parameter) == "page=3"
    _ => false
  }
}

test fn citation_cit1_witness_split_names_homonym_accommodation() -> Bool {
  string_contains(s: citation_cit1_witness_split_note, pattern: "decl_ref_constructor_authority_note")
    && string_contains(s: citation_cit1_witness_split_note, pattern: "namespace-only resolution")
}
