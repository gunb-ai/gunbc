module test.claim.where_refinement_seam_unit

import v1.std.core {
  Node, Conj, NoConnective, Required, make_span, make_expr_node,
  string_type, int_type, unit_type,
  expr_is_any_literal, ExprLiteral, LitInt, LitStr, LitNull, NoExprData
}
import v1.compiler.infer { kernel_value_declared_type_mismatch }
import v1.compiler.infer_env { empty_type_env }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data where_refinement_seam_unit_note: String = "gunbc dashboard node://adhoc-2ccd029d-c1d, PR #8513. Direct-call unit witnesses for the two absorbing-fallback fixes in kernel_value_declared_type_mismatch (04_infer.dag) and expr_is_any_literal (00_core.dag), replacing dag/test/claim/long/where_refinement_enforcement_witness_test.dag's compile-pipeline-driven cause-pinning specimens for the depth-2/depth-3 base-type-mismatch shape those fixes cover. That file's module (test.claim.long.where_refinement_enforcement_witness) matches long_home_prefixes() in src/v2/workflow/required_floor.dag and is therefore never discovered by CI's required floor (host-side gate confirmed in src/v1/stage0/src/cli_run.rs's witness_file_from_source: relocation into long/ does not itself discharge a claim, and required_floor.dag's own commentary forbids treating long/ placement as a remedy). Rather than admit an over-budget compiled specimen into the floor, this module calls the fixed decision functions directly against hand-built Node/TypeEnv literals -- no compile pipeline, no source text, no regenerated binary required -- crossing the exact same seam the compiled specimens exercised at a small fraction of the cost, comfortably inside required_floor_claim_budget_ms(). This module deliberately declares SubstrateInputsOnly (not ReadsLiveTree) and its module path carries no long_home_prefixes() segment, both required by required_floor.dag/witness_file_from_source for its sites to be discovered and admitted as required-floor claims. The pre-existing 38 compile-pipeline tests in the long/ file remain structurally uncovered by the required floor; that is pre-existing debt this PR discloses but does not further expand, since these new direct-call witnesses supersede only the base-type-mismatch cause-pinning specimens this PR itself introduced there."

fn string_base_ref_node() -> Node {
  Node {
    name: "String", ident: none, span: v1.std.core.kernel_span(name: "String"), ident_span: Present { value: v1.std.core.kernel_span(name: "String") },
    children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [], type_annotation: none,
    is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn s1_refined_string_node() -> Node {
  Node {
    name: "S1", ident: none, span: v1.std.core.kernel_span(name: "S1"), ident_span: Present { value: v1.std.core.kernel_span(name: "S1") },
    children: [string_base_ref_node()], connective: Conj, params: [], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [], type_annotation: Present { value: unit_type },
    is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn s2_refined_s1_node() -> Node {
  Node {
    name: "S2", ident: none, span: v1.std.core.kernel_span(name: "S2"), ident_span: Present { value: v1.std.core.kernel_span(name: "S2") },
    children: [s1_refined_string_node()], connective: Conj, params: [], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [], type_annotation: Present { value: unit_type },
    is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn s3_refined_s2_node() -> Node {
  Node {
    name: "S3", ident: none, span: v1.std.core.kernel_span(name: "S3"), ident_span: Present { value: v1.std.core.kernel_span(name: "S3") },
    children: [s2_refined_s1_node()], connective: Conj, params: [], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [], type_annotation: Present { value: unit_type },
    is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}


// fix (a): kernel_value_declared_type_mismatch must reuse the arbitrary-depth
// peel_where_refinement_base rather than its own one-level peel, so a base-type
// mismatch is still detected past depth 1.

test fn where_refinement_depth2_wrong_base_type_refuses() -> Bool {
  let env = empty_type_env()
  kernel_value_declared_type_mismatch(
    formal: s2_refined_s1_node(), actual: int_type, type_env: env, source_indices: env.source_indices
  ) == true
}

test fn where_refinement_depth2_correct_base_type_accepts() -> Bool {
  let env = empty_type_env()
  kernel_value_declared_type_mismatch(
    formal: s2_refined_s1_node(), actual: string_type, type_env: env, source_indices: env.source_indices
  ) == false
}

test fn where_refinement_depth3_wrong_base_type_refuses() -> Bool {
  let env = empty_type_env()
  kernel_value_declared_type_mismatch(
    formal: s3_refined_s2_node(), actual: int_type, type_env: env, source_indices: env.source_indices
  ) == true
}

test fn where_refinement_depth3_correct_base_type_accepts() -> Bool {
  let env = empty_type_env()
  kernel_value_declared_type_mismatch(
    formal: s3_refined_s2_node(), actual: string_type, type_env: env, source_indices: env.source_indices
  ) == false
}

// fix (b): expr_is_any_literal must distinguish "a literal of the wrong kind"
// (any real Lit* variant, including LitNull) from "genuinely not a literal" --
// LitNull is a literal shape but denotes total absence of value, so it must NOT
// be counted as "any literal" or the mismatch wall silently defers on it too.

test fn where_refinement_expr_is_any_literal_int_literal_is_literal() -> Bool {
  expr_is_any_literal(expr: make_expr_node(
    expr_data: ExprLiteral { value: LitInt { value: 5 } }, children: [], inferred: none, span: make_span(start: 0, end: 0)
  )) == true
}

test fn where_refinement_expr_is_any_literal_string_literal_is_literal() -> Bool {
  expr_is_any_literal(expr: make_expr_node(
    expr_data: ExprLiteral { value: LitStr { value: "x" } }, children: [], inferred: none, span: make_span(start: 0, end: 0)
  )) == true
}

test fn where_refinement_expr_is_any_literal_lit_null_is_not_literal() -> Bool {
  expr_is_any_literal(expr: make_expr_node(
    expr_data: ExprLiteral { value: LitNull }, children: [], inferred: none, span: make_span(start: 0, end: 0)
  )) == false
}

test fn where_refinement_expr_is_any_literal_non_literal_expr_is_not_literal() -> Bool {
  expr_is_any_literal(expr: make_expr_node(
    expr_data: NoExprData, children: [], inferred: none, span: make_span(start: 0, end: 0)
  )) == false
}
