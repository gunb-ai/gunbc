module test.claim.symbol_opaque_kernel_alias_emit

import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data emit_rust_path: String = "src/v1/05_emit_rust.dag"

fn src_has(path: String, needle: String) -> Bool {
  let r = filesystem_read(path: path)
  string_contains(s: r.content, pattern: needle)
}

fn src_lacks(path: String, needle: String) -> Bool {
  !src_has(path: path, needle: needle)
}

fn witness_symbol_in_opaque_kernel_alias_authority() -> Bool {
  src_has(path: emit_rust_path, needle: "name == \"Symbol\"")
    && src_has(path: emit_rust_path, needle: "rust_opaque_kernel_alias_type_eligible")
    && src_has(path: emit_rust_path, needle: "rust_opaque_kernel_alias_type_decl")
    && src_has(path: emit_rust_path, needle: "rust_ground_opaque_kernel_type_name")
}

fn witness_symbol_nominal_newtype_carrier_retired() -> Bool {
  src_has(path: emit_rust_path, needle: "fn rust_nominal_identity_carrier_type_eligible(type_name: String) -> Bool {\n  false")
    && src_lacks(path: emit_rust_path, needle: "type_name == \"Symbol\"")
}

test fn symbol_opaque_kernel_alias_emit_test() -> Bool {
  witness_symbol_in_opaque_kernel_alias_authority()
    && witness_symbol_nominal_newtype_carrier_retired()
}
