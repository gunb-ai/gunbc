module test.claim.approval_ntfy_retirement_witness

// THE RETIREMENT'S OWN CLAIMS: that the run asks for what it does and nothing wider, that its
// completeness is measured against the roster rather than against the legs it ran, and that each
// absence is read from the account of that member -- systemd, getent, the filesystem, tailscale --
// rather than from the exit code of the leg that was supposed to remove it.

import std.types { Bool, String, List, Int, NonEmptyStr }
import std.scoped_authorization { first_uncovered_scope, AuthorizationScope }
import std.effect_grant { Write, Execute, filesystem_position }
import std.optional { Absent, Present }
import std.list { first_where }
import std.filesystem_path_grant { absolute_path_segments }
import gunbc.fleet.approval_ntfy_retirement {
  ntfy_retire_members, member_text, ntfy_retire_legs, ntfy_retire_receipt_text,
  ntfy_retire_receipt_is_clean, ntfy_retire_verdict_text,
  RetireMemberAbsent, RetireMemberPresent, RetireMemberUnreadable, NtfyRetireVerdict,
  NtfyRetireRead, ReadPresent, ReadAbsent, ReadUnreadable,
  ntfy_retire_path_read, ntfy_retire_load_state_read, ntfy_retire_account_read, ntfy_retire_group_read,
  ntfy_retire_front_door_read, ntfy_retire_unit_read, ntfy_retire_reads_meet,
  ntfy_retire_verdict_from_read, ntfy_retire_elevation_control_argv,
  ntfy_retire_elevation_control_is_proven,
  ntfy_retire_unit_name, ntfy_retire_account_name, ntfy_retire_group_name, ntfy_retire_config_dir, ntfy_retire_state_root,
  ntfy_retire_binary_path, ntfy_retire_unit_path,
  ntfy_retire_removals, ntfy_retire_removals_are_stated, ntfy_retire_removal_target_is_stated,
  ntfy_retire_removal_argv, ntfy_retire_roster_paths,
  ntfy_retire_leg_answers_subject_absent, ntfy_retire_subject_absent_reason,
  ntfy_retire_leg_decision, LegDecisionRun, LegDecisionSkip, ntfy_retire_unreadable_members,
  NtfyRetireMember, MemberUnit, MemberFrontDoor, MemberAccount, MemberGroup,
  MemberConfigDir, MemberStateRoot, MemberBinary,
  NtfyRetireLeg, NoSubjectAbsentAnswer, SubjectAbsentExit,
}
import extdeps.ssh.session { SshSessionExecResult }
import extdeps.shadow.account_deletion {
  userdel_user_not_found_exit, groupdel_group_not_found_exit, userdel_binary_path, groupdel_binary_path,
}
import extdeps.posix.getent { getent_key_not_found_exit }
import gunbc.fleet.srv1_root_mutation_approval_run {
  srv1_root_mutation_approved_scopes, approval_ntfy_retire_root_scopes, srv1_root_removal_action,
  srv1_root_removal_scope_at,, srv1_root_account_remove_action, srv1_root_group_remove_action
}

// ── The approval the run asks for ──────────────────────────────────────────────────────────────

test fn the_retirement_scopes_are_covered_by_the_job_approval() -> Bool {
  match first_uncovered_scope(granted: srv1_root_mutation_approved_scopes, required: approval_ntfy_retire_root_scopes) {
    Absent => true
    _ => false
  }
}

// THE APPROVAL NAMES THE SAME PATHS THE LEGS REMOVE. The arm's scope list and the retirement's
// roster are two spellings of one fact in two modules, and this is what keeps them one fact: every
// rostered path appears in the scope list as a removal scope over THAT path, never over the directory
// around it. A scope over /usr/local/bin would cover the ntfy binary and every other binary in that
// directory -- including the runner's own -- and that is not what the operator is asked to approve on
// the phone.
test fn every_roster_path_has_its_own_removal_scope_in_the_approval() -> Bool {
  count(ntfy_retire_roster_paths) == 4
    && all(ntfy_retire_roster_paths, p =>
      any(approval_ntfy_retire_root_scopes, s => s == srv1_root_removal_scope_at(path: p)))
}

// A WRITE SCOPE IN THE ARM'S LIST MUST BE A REMOVAL, not an install: the arm inherits the job's
// approval, and an arm that asked for install-scoped writes would be granted them by scopes that
// exist for the OTHER arms.
test fn the_retirement_asks_removal_actions_for_its_writes() -> Bool {
  all(
    filter(approval_ntfy_retire_root_scopes, s => match s {
      AuthorizationScope { verb: Write, resource: _, action: _ } => true
      _ => false
    }),
    s => match s {
      AuthorizationScope { verb: _, resource: _, action: a } => a == srv1_root_removal_action
    },
  )
}

// ── The legs ───────────────────────────────────────────────────────────────────────────────────

// THE UNIT IS STOPPED AND DISABLED BY NAME. No leg signals a process by pattern and no leg invokes a
// package manager: the operator's ruling named the unit, and the binary was installed by hand, so it
// comes off as a file.
test fn the_legs_address_the_unit_by_name_and_never_by_pattern() -> Bool {
  let names = map(ntfy_retire_legs, leg => leg.name)
  let argv = map(ntfy_retire_legs, leg => leg.argv)
  all(names, n => n != "kill" && n != "pkill")
    && all(argv, words => !any(words, w => string_contains(s: w, pattern: "pkill")))
    && all(argv, words => !any(words, w => string_contains(s: w, pattern: "apt")))
    && any(argv, words => any(words, w => w == (ntfy_retire_unit_name as String)))
}

// THE REMOVAL TARGETS ARE ROSTER LITERALS. Every target a removal leg names is one of the four paths
// the roster states, absolute and non-empty, and the legs are built from that same list -- so the
// target checked here and the target the leg removes cannot be two different things.
test fn every_removal_target_is_a_stated_roster_path() -> Bool {
  count(ntfy_retire_removals) == 4
    && ntfy_retire_removals_are_stated()
    && count(filter(ntfy_retire_removals, r => r.recursive)) == 2
}

// RED: THE THREE TARGETS A RETIREMENT MUST NEVER NAME. Empty (the recursive removal that eats the
// host), the filesystem root, and a path DERIVED from a roster path -- the parent of the config
// directory, which is a different tree than the one the operator approved under a name the approval
// never used. A relative path is refused too: it would be read against whatever directory the leg
// happens to land in.
test fn red_an_unstated_removal_target_is_refused() -> Bool {
  !ntfy_retire_removal_target_is_stated(target: "")
    && !ntfy_retire_removal_target_is_stated(target: "/")
    && !ntfy_retire_removal_target_is_stated(target: "/etc")
    && !ntfy_retire_removal_target_is_stated(target: "gunbc-ntfy")
    && ntfy_retire_removal_target_is_stated(target: "/etc/gunbc-ntfy")
}

// THE RECURSIVE FLAG TRAVELS WITH THE TARGET: a tree is removed with -r and a file without it, so a
// leg cannot quietly turn a file removal into a tree walk.
test fn the_recursive_flag_travels_with_the_target() -> Bool {
  all(ntfy_retire_removals, r =>
    any(ntfy_retire_legs, leg => any(leg.argv, w => w == r.target)
      && (r.recursive == any(leg.argv, w => w == "-rf"))))
}

// ── A leg that finds its subject already gone ────────────────────────────────────────────────────
// userdel(8) exits 6 for "specified user doesn't exist". The retirement declares that answer on its
// account-removal leg and reads it as a DIVERGENCE FROM THE ROSTER -- the roster the run was approved
// against lists the account as installed, so a host answering otherwise has been changed by something
// outside this corpus. It is never success: an absence the run did not cause is not a retirement. And
// no other leg gets to guess one -- a leg that declares no such answer reads NO exit that way, because
// "which code would have meant missing" is exactly the plausible default DESIGN.md 5 refuses.

fn witness_leg_declares_subject_absent(leg: NtfyRetireLeg) -> Bool {
  match leg.subject_absent {
    NoSubjectAbsentAnswer => false
    SubjectAbsentExit { exit_code: _ } => true
  }
}

fn witness_declared_subject_absent_exit(leg: NtfyRetireLeg) -> Int {
  match leg.subject_absent {
    NoSubjectAbsentAnswer => -1
    SubjectAbsentExit { exit_code: code } => code
  }
}

// THE IDENTITY LEGS DECLARE THEIR NOT-THERE ANSWER, THE FILESYSTEM LEGS NEVER DO. Only userdel and
// groupdel get to say "the subject is not there" (and each declares its own program's code); a leg that
// rm -rf's a path does not, because an absent subject must be PROVEN BY THE READBACK, never by the
// removal's own exit.
test fn only_the_account_and_group_legs_declare_a_subject_absent_answer() -> Bool {
  ntfy_retire_legs.all(leg => witness_leg_declares_subject_absent(leg: leg)
    == (leg.name == "account-remove" || leg.name == "group-remove"))
    && ntfy_retire_legs.all(leg => leg.name != "account-remove"
      || witness_declared_subject_absent_exit(leg: leg) == userdel_user_not_found_exit)
    && ntfy_retire_legs.all(leg => leg.name != "group-remove"
      || witness_declared_subject_absent_exit(leg: leg) == groupdel_group_not_found_exit)
    // Success is never read as "already gone": a leg that exits 0 is followed by the readback, which
    // is the only thing in this run that proves absence.
    && ntfy_retire_legs.all(leg => !ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: 0))
}

// RED: THE ACCOUNT IS NOT ON THE HOST. userdel's 6 must refuse, naming the divergence -- the leg, the
// exit, and the roster it disagrees with -- and a DIFFERENT userdel failure (its generic exit 1) must
// not be dressed up as that divergence. A removal leg that declares no answer (the binary) never reads
// a 6 as one either.
test fn red_a_userdel_that_found_no_account_refuses_as_a_roster_divergence() -> Bool {
  match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "account-remove") {
    Absent => false
    Present { value: account_leg } =>
      match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "binary-remove") {
        Absent => false
        Present { value: binary_leg } =>
          ntfy_retire_leg_answers_subject_absent(leg: account_leg, exit_code: userdel_user_not_found_exit)
            && !ntfy_retire_leg_answers_subject_absent(leg: account_leg, exit_code: 1)
            && !ntfy_retire_leg_answers_subject_absent(leg: account_leg, exit_code: 2)
            && !ntfy_retire_leg_answers_subject_absent(leg: binary_leg, exit_code: userdel_user_not_found_exit)
            && string_contains(s: ntfy_retire_subject_absent_reason(leg: account_leg, exit_code: userdel_user_not_found_exit), pattern: "account-remove")
            && string_contains(s: ntfy_retire_subject_absent_reason(leg: account_leg, exit_code: userdel_user_not_found_exit), pattern: "6")
            && string_contains(s: ntfy_retire_subject_absent_reason(leg: account_leg, exit_code: userdel_user_not_found_exit), pattern: "roster")
      }
  }
}

// ── The readback verdicts ──────────────────────────────────────────────────────────────────────

data verdict_all_absent: List<NtfyRetireVerdict> = [
  RetireMemberAbsent { member: MemberUnit, evidence: "systemd LoadState is not-found" },
  RetireMemberAbsent { member: MemberFrontDoor, evidence: "tailscale serve status lists no route" },
  RetireMemberAbsent { member: MemberAccount, evidence: "getent passwd resolves no entry" },
  RetireMemberAbsent { member: MemberGroup, evidence: "getent group resolves no entry" },
  RetireMemberAbsent { member: MemberConfigDir, evidence: "the config path does not exist" },
  RetireMemberAbsent { member: MemberStateRoot, evidence: "the state root does not exist" },
  RetireMemberAbsent { member: MemberBinary, evidence: "the binary path does not exist" },
]

test fn the_clean_receipt_reads_every_roster_member_absent_once() -> Bool {
  ntfy_retire_receipt_is_clean(vs: verdict_all_absent)
    && count(ntfy_retire_members) == 7
    && all(ntfy_retire_members, m => string_contains(s: ntfy_retire_receipt_text(vs: verdict_all_absent), pattern: member_text(member: m)))
}

// RED: A MEMBER FOUND PRESENT. The receipt is the condition the step passes on, so a present member
// must make it unclean rather than merely a line the operator may disagree with.
test fn red_a_member_found_present_makes_the_receipt_unclean() -> Bool {
  let one_present = map(verdict_all_absent, v => match v {
    RetireMemberAbsent { member: m, evidence: e } =>
      if m == (MemberStateRoot) {
        RetireMemberPresent { member: m, evidence: e }
      } else {
        RetireMemberAbsent { member: m, evidence: e }
      }
    RetireMemberPresent { member: m, evidence: e } => RetireMemberPresent { member: m, evidence: e }
    RetireMemberUnreadable { member: m, evidence: e } => RetireMemberUnreadable { member: m, evidence: e }
  })
  !ntfy_retire_receipt_is_clean(vs: one_present)
    && string_contains(s: ntfy_retire_receipt_text(vs: one_present), pattern: "STILL PRESENT")
}

// RED: A MEMBER NEVER READ. Seven legs ran and six verdicts came back: the roster is the standard, so
// a receipt that simply omits a member is not clean coverage, it is a gap. The dropped member is the
// binary here; the group's own twin of this claim is further down, so neither of the two members added
// after the first six can become the member the receipt is allowed to forget.
test fn red_a_roster_member_never_read_makes_the_receipt_unclean() -> Bool {
  let six = filter(verdict_all_absent, v => match v {
    RetireMemberAbsent { member: m, evidence: _ } => m != (MemberBinary)
    RetireMemberPresent { member: _, evidence: _ } => true
    RetireMemberUnreadable { member: _, evidence: _ } => true
  })
  count(six) == 6 && !ntfy_retire_receipt_is_clean(vs: six)
}

// ONE READ, THREE STATES, ONE TYPE. Every prober returns the same sum, so no verdict can depend on
// the order of two Bool predicates -- which is how an unread read ends up reported as an absent one.
// These tests read the STATE the classifier produced, never a predicate about it.

fn witness_read_state(read: NtfyRetireRead) -> String {
  match read {
    ReadPresent { evidence: _ } => "present"
    ReadAbsent { evidence: _ } => "absent"
    ReadUnreadable { evidence: _ } => "unreadable"
  }
}

fn witness_verdict_state(v: NtfyRetireVerdict) -> String {
  match v {
    RetireMemberPresent { member: _, evidence: _ } => "present"
    RetireMemberAbsent { member: _, evidence: _ } => "absent"
    RetireMemberUnreadable { member: _, evidence: _ } => "unreadable"
  }
}

// THE SERVE STATUS AS THE TRANSPORT RETURNS IT. The front-door prober takes the whole read, exit code
// included, because a `tailscale serve status` that never ran prints nothing and an empty document
// parses to "no routes" -- which is exactly how a failed close could be certified as a closed door.
fn witness_serve_status(stdout: String) -> SshSessionExecResult {
  SshSessionExecResult { exit_code: 0, success: true, stdout: stdout, stderr: "" }
}

data failed_serve_status: SshSessionExecResult = SshSessionExecResult {
  exit_code: 1,
  success: false,
  stdout: "",
  stderr: "sudo: serve: command not found",
}

data serve_status_with_route: String = "{\"TCP\":{\"8443\":{\"HTTPS\":true}},\"Web\":{\"srv1.example.ts.net:8443\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:2586\"}}}}}"
data serve_status_without_route: String = "{\"TCP\":{\"443\":{\"HTTPS\":true}},\"Web\":{\"srv1.example.ts.net:443\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18789\"}}}}}"
data serve_status_unparseable: String = "{\"TCP\":{"

// THE UNIT IS READ BY TWO PROBES UNDER ONE RULE: systemd's LoadState AND the unit file's own path.
// A unit whose file is gone but which systemd still answers for is on the host; so is a unit that is
// not loaded while its file is still on disk -- exactly what a stop+disable that never removed the
// file leaves behind. Half of that is not a retirement.
test fn the_unit_absence_needs_both_of_its_reads() -> Bool {
  let load_state_gone = SshSessionExecResult { exit_code: 0, success: true, stdout: "not-found\n", stderr: "" }
  let load_state_loaded = SshSessionExecResult { exit_code: 0, success: true, stdout: "loaded\n", stderr: "" }
  let systemctl_failed = SshSessionExecResult { exit_code: 3, success: false, stdout: "not-found\n", stderr: "" }
  witness_read_state(read: ntfy_retire_unit_read(load_state: load_state_gone, unit_path_exit: 1)) == "absent"
    && witness_read_state(read: ntfy_retire_unit_read(load_state: load_state_gone, unit_path_exit: 0)) == "present"
    && witness_read_state(read: ntfy_retire_unit_read(load_state: load_state_loaded, unit_path_exit: 1)) == "present"
    && witness_read_state(read: ntfy_retire_unit_read(load_state: systemctl_failed, unit_path_exit: 1)) == "unreadable"
}

// THE LOADSTATE ANSWER IS THE VALUE, not the exit code -- and only the two values this model
// understands answer anything. A failed systemctl that happened to print "not-found" is not an absent
// unit, and a value with no rule here (masked, failed, a usage line, an empty answer) is not absence
// either: it is a read this model did not make.
test fn the_unit_load_state_is_read_from_the_value_and_only_two_values_answer() -> Bool {
  witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "not-found\n", stderr: "" })) == "absent"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "loaded\n", stderr: "" })) == "present"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "masked\n", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 1, success: false, stdout: "not-found\n", stderr: "" })) == "unreadable"
}

// THE ACCOUNT. getent's not-found exit AND no line, together: an exit code alone would read a
// transport error as an absent account, and an empty stdout at exit 0 is a read that answered nothing.
test fn the_account_absence_is_getent_not_found_and_no_line() -> Bool {
  witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "", stderr: "" })) == "absent"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "gunbc-ntfy:x:994:984::/nonexistent:/usr/sbin/nologin", stderr: "" })) == "present"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "Usage: getent [OPTION]... DATABASE", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: 1, success: false, stdout: "", stderr: "" })) == "unreadable"
}

// A PATH. test(1) exits 0 when the operand is there and 1 when it is not, and exits 2 on its OWN
// error -- and `sudo -n` exits 1 when it refuses to run at all. So only exit 1 is absence: reading
// every non-zero exit as absence is a silent widen that prints `absent:` for a read that never
// happened, which is exactly what DESIGN.md 5 refuses.
test fn a_path_probe_reads_only_exit_one_as_absent() -> Bool {
  witness_read_state(read: ntfy_retire_path_read(exit_code: 0)) == "present"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 1)) == "absent"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 2)) == "unreadable"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 127)) == "unreadable"
}

// RED: A PROBE THAT ERRORED IS NOT AN ABSENCE. exit 2 is test's own error -- a parent it cannot stat,
// an operand it cannot parse. It must land as UNREADABLE, make the receipt unclean, and above all
// never print as `absent:` for that member.
test fn red_a_probe_that_errored_is_not_read_as_absent() -> Bool {
  let errored = ntfy_retire_verdict_from_read(member: MemberBinary, read: ntfy_retire_path_read(exit_code: 2))
  let vs = concat([errored], filter(verdict_all_absent, x => match x {
    RetireMemberAbsent { member: m, evidence: _ } => m != (MemberBinary)
    RetireMemberPresent { member: _, evidence: _ } => true
    RetireMemberUnreadable { member: _, evidence: _ } => true
  }))
  witness_verdict_state(v: errored) == "unreadable"
    && !ntfy_retire_receipt_is_clean(vs: vs)
    && string_contains(s: ntfy_retire_receipt_text(vs: vs), pattern: "UNREADABLE")
    && !string_contains(s: ntfy_retire_receipt_text(vs: vs), pattern: "absent: binary")
}

// RED: A READ THAT WAS NEVER MADE NEVER BECOMES AN ABSENT VERDICT. This pins the classifiers
// themselves, not the printing: a systemctl that failed on the bus, a getent that exited 0 printing
// nothing, a getent that exited 1, a tailscale status that does not parse and a path probe that errored
// are five reads that say NOTHING about the roster, and none of them may reach a verdict as Absent.
test fn red_a_read_that_was_never_made_never_becomes_an_absent_verdict() -> Bool {
  let failed_systemctl = SshSessionExecResult { exit_code: 3, success: false, stdout: "yes", stderr: "Failed to connect to bus" }
  let hollow_getent = SshSessionExecResult { exit_code: 0, success: true, stdout: "", stderr: "" }
  let errored_getent = SshSessionExecResult { exit_code: 1, success: false, stdout: "", stderr: "" }
  witness_read_state(read: ntfy_retire_load_state_read(read: failed_systemctl)) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: hollow_getent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: errored_getent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_front_door_read(status_read: witness_serve_status(stdout: serve_status_unparseable))) == "unreadable"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 2)) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(member: MemberUnit, read: ntfy_retire_load_state_read(read: failed_systemctl))) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(member: MemberAccount, read: ntfy_retire_account_read(read: hollow_getent))) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(member: MemberFrontDoor, read: ntfy_retire_front_door_read(status_read: witness_serve_status(stdout: serve_status_unparseable)))) == "unreadable"
}

// A READ THAT HAPPENED IS CLASSIFIED BY WHAT IT ANSWERED, and one shared function is the only thing
// between a read and a verdict: the receipt built from seven real answers is clean, and each line names
// the prober that decided it rather than restating the run's intent.
test fn a_read_that_happened_is_classified_by_what_it_answered() -> Bool {
  let unit_absent = ntfy_retire_verdict_from_read(member: MemberUnit, read: ntfy_retire_unit_read(load_state: SshSessionExecResult { exit_code: 0, success: true, stdout: "not-found\n", stderr: "" }, unit_path_exit: 1))
  let door_absent = ntfy_retire_verdict_from_read(member: MemberFrontDoor, read: ntfy_retire_front_door_read(status_read: witness_serve_status(stdout: serve_status_without_route)))
  let account_absent = ntfy_retire_verdict_from_read(member: MemberAccount, read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "", stderr: "" }))
  let config_absent = ntfy_retire_verdict_from_read(member: MemberConfigDir, read: ntfy_retire_path_read(exit_code: 1))
  let state_absent = ntfy_retire_verdict_from_read(member: MemberStateRoot, read: ntfy_retire_path_read(exit_code: 1))
  let binary_absent = ntfy_retire_verdict_from_read(member: MemberBinary, read: ntfy_retire_path_read(exit_code: 1))
  let group_absent = ntfy_retire_verdict_from_read(member: MemberGroup, read: ntfy_retire_group_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "", stderr: "" }))
  // All SEVEN, not the original six: the receipt is clean only over the whole roster, so a claim that
  // quietly kept the pre-group list would be certified by a receipt that forgot a member.
  let vs = [unit_absent, door_absent, account_absent, config_absent, state_absent, binary_absent, group_absent]
  all(vs, v => witness_verdict_state(v: v) == "absent")
    && count(vs) == count(ntfy_retire_members)
    && ntfy_retire_receipt_is_clean(vs: vs)
    && string_contains(s: ntfy_retire_verdict_text(v: unit_absent), pattern: "systemd LoadState is not-found")
    && string_contains(s: ntfy_retire_verdict_text(v: account_absent), pattern: "getent passwd resolves no entry")
    && string_contains(s: ntfy_retire_verdict_text(v: group_absent), pattern: "getent group resolves no entry")
    && string_contains(s: ntfy_retire_verdict_text(v: door_absent), pattern: "tailscale serve status lists no route")
}

// TWO READS OF ONE MEMBER MEET UNDER ONE RULE, and the rule does not depend on the order they arrive:
// seen beats silence, silence beats "gone", and only a unanimous "gone" is gone.
test fn two_reads_of_one_member_meet_under_one_rule() -> Bool {
  let seen = ntfy_retire_path_read(exit_code: 0)
  let gone = ntfy_retire_path_read(exit_code: 1)
  let silent = ntfy_retire_path_read(exit_code: 2)
  witness_read_state(read: ntfy_retire_reads_meet(a: seen, b: gone)) == "present"
    && witness_read_state(read: ntfy_retire_reads_meet(a: gone, b: seen)) == "present"
    && witness_read_state(read: ntfy_retire_reads_meet(a: gone, b: silent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_reads_meet(a: silent, b: gone)) == "unreadable"
    && witness_read_state(read: ntfy_retire_reads_meet(a: silent, b: silent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_reads_meet(a: gone, b: gone)) == "absent"
}

// THE FRONT DOOR. tailscale's own status is the account of what it serves: a route on the retired port
// means the door is still standing, and a status that cannot be parsed is NOT read as absence -- a
// parse gap must not retire a listener.
test fn the_front_door_absence_is_read_from_tailscales_own_status() -> Bool {
  witness_read_state(read: ntfy_retire_front_door_read(status_read: witness_serve_status(stdout: serve_status_without_route))) == "absent"
    && witness_read_state(read: ntfy_retire_front_door_read(status_read: witness_serve_status(stdout: serve_status_with_route))) == "present"
    && witness_read_state(read: ntfy_retire_front_door_read(status_read: witness_serve_status(stdout: serve_status_unparseable))) == "unreadable"
}

// THE ROSTER PATHS ARE THE ONES THE RUN REMOVES: each member's path appears in a leg, so the roster
// and the legs cannot drift into different lists.
test fn every_roster_path_is_removed_by_a_leg() -> Bool {
  all([ntfy_retire_unit_path, ntfy_retire_config_dir, ntfy_retire_state_root, ntfy_retire_binary_path], p =>
    any(ntfy_retire_legs, leg => any(leg.argv, w => w == (p as String))))
}

// ── The legs' own decisions, and the two defects the first actuation found ─────────────────────

fn witness_first_word(argv: List<String>) -> String {
  match first_where(xs: argv, keep: w => true) {
    Absent => ""
    Present { value: w } => w
  }
}

// RED: THE CLOSE NAMES THE PROGRAM IT RUNS. The first actuation of this retirement died on exactly
// this leg: the words handed to `sudo -n --` were ["serve", "--https=8443", "off"], so sudo was asked
// to run a program called `serve`, it exited 1, and the listener stayed open on a host whose unit,
// account, directories and binary had already been removed. A close that does not name its program is
// not a close; the program now comes from extdeps.tailscale.serve, the module that owns it.
test fn red_the_front_door_close_names_the_tailscale_program() -> Bool {
  match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "front-door-off") {
    Absent => false
    Present { value: leg } =>
      witness_first_word(argv: leg.argv) == "tailscale"
        && any(leg.argv, w => w == "serve")
        && any(leg.argv, w => w == "--https=8443")
        && any(leg.argv, w => w == "off")
  }
}

// RED: A SERVE STATUS THAT NEVER RAN IS NOT A CLOSED DOOR. sudo's "command not found" and a daemon
// that is down both print an EMPTY document, and an empty document parses to "no routes". Read that
// way, the failed close above would have been certified as a closed front door by the run's own
// readback. Only an exit-0 status is a status; anything else is UNREADABLE, which fails the run.
test fn red_a_failed_serve_status_is_never_read_as_a_closed_door() -> Bool {
  witness_read_state(read: ntfy_retire_front_door_read(status_read: failed_serve_status)) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(
      member: MemberFrontDoor,
      read: ntfy_retire_front_door_read(status_read: failed_serve_status),
    )) == "unreadable"
}

fn witness_member_absent(member: NtfyRetireMember) -> NtfyRetireVerdict {
  ntfy_retire_verdict_from_read(member: member, read: ReadAbsent { evidence: "the member's own probe said not there" })
}

// RED: A RESUMED PASS SKIPS ONLY WHAT ITS OWN READS FOUND GONE. This is the state the first actuation
// left srv1 in -- everything removed except the front door -- and before this rule the run could not
// finish: `systemctl stop` of a unit systemd no longer knows exits non-zero, so the first leg refused
// and the listener could never be closed. Eight legs skip, quoting the read that justified it; the one
// leg whose member is still there runs.
test fn red_a_resumed_pass_skips_only_what_its_reads_found_gone() -> Bool {
  let vs = concat(
    [ntfy_retire_verdict_from_read(
      member: MemberFrontDoor,
      read: ReadPresent { evidence: "tailscale serve status still lists a route" },
    )],
    map([MemberUnit, MemberAccount, MemberGroup, MemberConfigDir,
         MemberStateRoot, MemberBinary], m => witness_member_absent(member: m)),
  )
  let skipped = count(filter(ntfy_retire_legs, leg => match ntfy_retire_leg_decision(leg: leg, verdicts: vs) {
    LegDecisionSkip { note: _ } => true
    LegDecisionRun { note: _ } => false
  }))
  let ran = count(filter(ntfy_retire_legs, leg => match ntfy_retire_leg_decision(leg: leg, verdicts: vs) {
    LegDecisionRun { note: _ } => true
    LegDecisionSkip { note: _ } => false
  }))
  skipped == 9
    && ran == 1
    && match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "front-door-off") {
      Absent => false
      Present { value: door } => match ntfy_retire_leg_decision(leg: door, verdicts: vs) {
        LegDecisionRun { note: note } => string_contains(s: note, pattern: "read present")
        LegDecisionSkip { note: _ } => false
      }
    }
}

// RED: NO LEG EVER SKIPS ON A READ THAT WAS NEVER MADE. An absent verdict is the ONLY thing that skips
// a leg: nothing read about a member, or a read that said nothing (unreadable), runs the removal,
// because the roster -- not the gaps in the evidence -- is the standard. A run that skipped on a gap
// would report a retired member it had never removed.
test fn red_no_leg_skips_on_a_read_that_was_never_made() -> Bool {
  let ran_when_nothing_read = count(filter(ntfy_retire_legs, leg => match ntfy_retire_leg_decision(leg: leg, verdicts: []) {
    LegDecisionRun { note: _ } => true
    LegDecisionSkip { note: _ } => false
  }))
  let blind = [ntfy_retire_verdict_from_read(
    member: MemberBinary,
    read: ReadUnreadable { evidence: "the probe could not reach the host" },
  )]
  let ran_blind = count(filter(ntfy_retire_legs, leg => match ntfy_retire_leg_decision(leg: leg, verdicts: blind) {
    LegDecisionRun { note: _ } => true
    LegDecisionSkip { note: _ } => false
  }))
  ran_when_nothing_read == count(ntfy_retire_legs) && ran_blind == count(ntfy_retire_legs)
}

// RED: AN UNREADABLE MEMBER STOPS THE RUN BEFORE IT TOUCHES THE HOST. The actuation reads the roster
// first and refuses to remove anything while a member's state is unknown; once every member has been
// read, the same predicate is what lets it proceed.
test fn red_an_unreadable_member_refuses_before_the_first_leg() -> Bool {
  let with_gap = concat(
    map([MemberUnit, MemberFrontDoor, MemberAccount, MemberGroup,
         MemberConfigDir, MemberStateRoot], m => witness_member_absent(member: m)),
    [ntfy_retire_verdict_from_read(
      member: MemberBinary,
      read: ReadUnreadable { evidence: "the probe could not reach the host" },
    )],
  )
  let all_read = map(ntfy_retire_members, m => witness_member_absent(member: m))
  count(ntfy_retire_unreadable_members(vs: with_gap)) == 1
    && count(ntfy_retire_unreadable_members(vs: all_read)) == 0
    && match first_where(xs: ntfy_retire_unreadable_members(vs: with_gap), keep: v => true) {
      // WHICH member it refuses on survives the answer; a Bool could not have said this, and the
      // operator reads exactly that sentence when the run stops.
      Absent => false
      Present { value: v } => match v {
        RetireMemberUnreadable { member: m, evidence: _ } => (m == MemberBinary)
        RetireMemberAbsent { member: _, evidence: _ } => false
        RetireMemberPresent { member: _, evidence: _ } => false
      }
    }
}

// EVERY LEG REMOVES A MEMBER THE ROSTER KNOWS. The skip rule matches a leg to a verdict by member name;
// a leg whose subject is not on the roster would never match a verdict and so would never skip -- a
// silent hole in the resume rule above. This pins the two lists to one vocabulary.
test fn every_leg_removes_a_roster_member_the_readback_attests() -> Bool {
  all(ntfy_retire_legs, leg => any(ntfy_retire_members, m => (m == leg.subject)))
}

// ── The group the account left behind ──────────────────────────────────────────────────────────
//
// userdel removes the identity; the group of the same name stays whenever it has another member, and
// this one does (srv1: `gunbc-ntfy:x:984:briansrls`, the account's own gid, the fleet administrator
// listed while the publisher ran). These claims exist so that "the account is gone" can never again be
// the state a retirement certifies as finished.

fn witness_group_probe(code: Int, line: String) -> SshSessionExecResult {
  SshSessionExecResult { exit_code: code, success: code == 0, stdout: line, stderr: "" }
}

// THE GROUP IS READ BY THE DATABASE THAT OWNS GROUPS, and every answer that is not one of getent's own
// two answers is a refusal rather than an absence: exit 2 with nothing printed is absent, exit 0 with a
// line is present, and exit 0 printing NOTHING -- or any other exit, groupdel's 8 and 10 among them --
// is unreadable, which fails the run.
test fn the_group_is_read_by_the_group_database_only() -> Bool {
  let gone = witness_read_state(read: ntfy_retire_group_read(read: witness_group_probe(code: getent_key_not_found_exit, line: "")))
  let there = witness_read_state(read: ntfy_retire_group_read(read: witness_group_probe(code: 0, line: "gunbc-ntfy:x:984:briansrls")))
  let hollow = witness_read_state(read: ntfy_retire_group_read(read: witness_group_probe(code: 0, line: "")))
  let primary_refused = witness_read_state(read: ntfy_retire_group_read(read: witness_group_probe(code: 8, line: "")))
  let verdict_there = witness_verdict_state(v: ntfy_retire_verdict_from_read(
    member: MemberGroup,
    read: ntfy_retire_group_read(read: witness_group_probe(code: 0, line: "gunbc-ntfy:x:984:briansrls")),
  ))
  gone == "absent" && there == "present" && hollow == "unreadable"
    && primary_refused == "unreadable" && verdict_there == "present"
}

// THE GROUP LEG NAMES ITS OWN PROGRAM AND ITS OWN NOT-THERE ANSWER. groupdel(8) exits 6 when the named
// group does not exist; 8 is "can't remove user's primary group" and 10 "can't update group file", and
// neither is ever success -- a retirement that read either as "already gone" would attest a group this
// model watched being refused. The leg is keyed to the roster's group member, so the resume rule can
// match it to its own verdict.
test fn the_group_leg_names_groupdel_and_its_not_there_answer() -> Bool {
  match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "group-remove") {
    Absent => false
    Present { value: leg } =>
      witness_first_word(argv: leg.argv) == "/usr/sbin/groupdel"
        && any(leg.argv, w => w == (ntfy_retire_group_name as String))
        && (leg.subject == MemberGroup)
        && ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: groupdel_group_not_found_exit)
        && !ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: 8)
        && !ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: 10)
        && !ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: 1)
        && !ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: 0)
        && string_contains(s: ntfy_retire_subject_absent_reason(leg: leg, exit_code: groupdel_group_not_found_exit), pattern: "group-remove")
        && string_contains(s: ntfy_retire_subject_absent_reason(leg: leg, exit_code: groupdel_group_not_found_exit), pattern: "roster")
  }
}

// RED: AN ABSENT ACCOUNT NEVER RETIRES THE GROUP -- the exact state srv1 is in. The account reads absent
// and the group still resolves, so the account leg skips on its own read and the GROUP LEG RUNS. A model
// that inferred the group from the account, or that stopped at six members, would skip it and certify a
// retirement with a group still installed.
test fn red_an_absent_account_never_retires_the_group() -> Bool {
  let vs = concat(
    map([MemberUnit, MemberFrontDoor, MemberAccount, MemberConfigDir,
         MemberStateRoot, MemberBinary], m => witness_member_absent(member: m)),
    [ntfy_retire_verdict_from_read(
      member: MemberGroup,
      read: ntfy_retire_group_read(read: witness_group_probe(code: 0, line: "gunbc-ntfy:x:984:briansrls")),
    )],
  )
  let ran = map(filter(ntfy_retire_legs, leg => match ntfy_retire_leg_decision(leg: leg, verdicts: vs) {
    LegDecisionRun { note: _ } => true
    LegDecisionSkip { note: _ } => false
  }), leg => leg.name)
  let account_skipped = match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "account-remove") {
    Absent => false
    Present { value: leg } => match ntfy_retire_leg_decision(leg: leg, verdicts: vs) {
      LegDecisionSkip { note: _ } => true
      LegDecisionRun { note: _ } => false
    }
  }
  count(ran) == 1
    && any(ran, w => w == "group-remove")
    && account_skipped
}

// RED: THE RECEIPT REFUSES TO CLOSE WHILE THE GROUP IS UNATTESTED. Dropping the group's attestation is
// not a smaller receipt, it is an unclean one: cleanliness is measured against the roster, so a run that
// never read the group cannot pass its own step.
test fn red_the_receipt_refuses_to_close_while_the_group_is_unattested() -> Bool {
  let without_group = filter(verdict_all_absent, v => match v {
    RetireMemberAbsent { member: MemberGroup, evidence: _ } => false
    RetireMemberAbsent { member: _, evidence: _ } => true
    RetireMemberPresent { member: _, evidence: _ } => true
    RetireMemberUnreadable { member: _, evidence: _ } => true
  })
  count(without_group) == 6 && !ntfy_retire_receipt_is_clean(vs: without_group)
    && ntfy_retire_receipt_is_clean(vs: verdict_all_absent)
}

// THE GROUP IS ON THE ROSTER UNDER ITS OWN NAME, spelled nowhere but in member_text. The account's name
// and the group's name are equal TODAY (useradd's private-group convention); saying so in a claim is
// what tells the next reader the moment that stops being true, instead of leaving it as an assumption
// inside the code. And the group comes off AFTER the account, because groupdel(8) refuses to remove the
// primary group of any existing user.
test fn the_group_is_a_roster_member_removed_after_the_account() -> Bool {
  any(ntfy_retire_members, m => (m == MemberGroup))
    && member_text(member: MemberGroup) == "group"
    && (ntfy_retire_group_name as String) == (ntfy_retire_account_name as String)
    && match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "account-remove" || leg.name == "group-remove") {
      Absent => false
      Present { value: leg } => leg.name == "account-remove"
    }
}

// THE OPERATOR IS ASKED FOR THE REMOVALS SEPARATELY, AND FOR THE PROGRAMS THE LEGS ACTUALLY RUN. The
// account and the group are two privileges with two tools and two action words: an approval that said
// "remove the account" must never be readable as consent to remove the group it leaves behind (gid 984
// still exists on srv1 with the account gone, which is exactly why the group is its own member). Each
// side is checked against the extdeps row that owns the program path -- the same row the leg's argv is
// built from -- so a scope pointing at some other binary, or an action word quietly shared between the
// two, goes red here. The paths arrive as segments because an AuthorizationScope names a filesystem
// POSITION, which is what an approver on a phone is agreeing to.
test fn the_account_and_group_removals_are_approved_apart_and_on_their_own_programs() -> Bool {
  let account = srv1_root_account_remove_action
  let group = srv1_root_group_remove_action
  let programs_are_apart = account != group
    && any(approval_ntfy_retire_root_scopes, s => match s {
      AuthorizationScope { verb: Execute, resource: r, action: a } =>
        a == account
          && r == filesystem_position(path: absolute_path_segments(path: userdel_binary_path as String))
      _ => false
    })
    && any(approval_ntfy_retire_root_scopes, s => match s {
      AuthorizationScope { verb: Execute, resource: r, action: a } =>
        a == group
          && r == filesystem_position(path: absolute_path_segments(path: groupdel_binary_path as String))
      _ => false
    })
  // And neither removal is folded into a broader directory grant: the two Execute scopes are in the
  // retirement's own list, not merely inherited from the job's wider write scopes.
  let in_the_retirement_list = count(approval_ntfy_retire_root_scopes) == 10
  programs_are_apart && in_the_retirement_list
}
