module test.claim.approval_ntfy_retirement_witness

// THE RETIREMENT'S OWN CLAIMS: that the run asks for what it does and nothing wider, that its
// completeness is measured against the roster rather than against the legs it ran, and that each
// absence is read from the account of that member -- systemd, getent, the filesystem, tailscale --
// rather than from the exit code of the leg that was supposed to remove it.

import std.types { Bool, String, List, Int, NonEmptyStr }
import std.scoped_authorization { first_uncovered_scope, AuthorizationScope }
import std.effect_grant { Write }
import std.optional { Absent, Present }
import std.list { first_where }
import gunbc.fleet.approval_ntfy_retirement {
  ntfy_retire_members, ntfy_retire_legs, ntfy_retire_receipt_text,
  ntfy_retire_receipt_is_clean, ntfy_retire_verdict_text,
  RetireMemberAbsent, RetireMemberPresent, RetireMemberUnreadable, NtfyRetireVerdict,
  NtfyRetireRead, ReadPresent, ReadAbsent, ReadUnreadable,
  ntfy_retire_path_read, ntfy_retire_load_state_read, ntfy_retire_account_read,
  ntfy_retire_front_door_read, ntfy_retire_unit_read, ntfy_retire_reads_meet,
  ntfy_retire_verdict_from_read, ntfy_retire_elevation_control_argv,
  ntfy_retire_elevation_control_is_proven,
  ntfy_retire_unit_name, ntfy_retire_account_name, ntfy_retire_config_dir, ntfy_retire_state_root,
  ntfy_retire_binary_path, ntfy_retire_unit_path,
  ntfy_retire_removals, ntfy_retire_removals_are_stated, ntfy_retire_removal_target_is_stated,
  ntfy_retire_removal_argv, ntfy_retire_roster_paths,
  ntfy_retire_leg_answers_subject_absent, ntfy_retire_subject_absent_reason,
  NtfyRetireLeg, NoSubjectAbsentAnswer, SubjectAbsentExit,
}
import extdeps.ssh.session { SshSessionExecResult }
import extdeps.shadow.account_deletion { userdel_user_not_found_exit }
import extdeps.posix.getent { getent_key_not_found_exit }
import gunbc.fleet.srv1_root_mutation_approval_run {
  srv1_root_mutation_approved_scopes, approval_ntfy_retire_root_scopes, srv1_root_removal_action,
  srv1_root_removal_scope_at,
}

// ── The approval the run asks for ──────────────────────────────────────────────────────────────

test fn the_retirement_scopes_are_covered_by_the_job_approval() -> Bool {
  match first_uncovered_scope(granted: srv1_root_mutation_approved_scopes, required: approval_ntfy_retire_root_scopes) {
    Absent => true
    _ => false
  }
}

// THE APPROVAL NAMES THE SAME PATHS THE LEGS REMOVE. The arm's scope list and the retirement's
// roster are two spellings of one fact in two modules, and this is what keeps them one fact: every
// rostered path appears in the scope list as a removal scope over THAT path, never over the directory
// around it. A scope over /usr/local/bin would cover the ntfy binary and every other binary in that
// directory -- including the runner's own -- and that is not what the operator is asked to approve on
// the phone.
test fn every_roster_path_has_its_own_removal_scope_in_the_approval() -> Bool {
  count(ntfy_retire_roster_paths) == 4
    && all(ntfy_retire_roster_paths, p =>
      any(approval_ntfy_retire_root_scopes, s => s == srv1_root_removal_scope_at(path: p)))
}

// A WRITE SCOPE IN THE ARM'S LIST MUST BE A REMOVAL, not an install: the arm inherits the job's
// approval, and an arm that asked for install-scoped writes would be granted them by scopes that
// exist for the OTHER arms.
test fn the_retirement_asks_removal_actions_for_its_writes() -> Bool {
  all(
    filter(approval_ntfy_retire_root_scopes, s => match s {
      AuthorizationScope { verb: Write, resource: _, action: _ } => true
      _ => false
    }),
    s => match s {
      AuthorizationScope { verb: _, resource: _, action: a } => a == srv1_root_removal_action
    },
  )
}

// ── The legs ───────────────────────────────────────────────────────────────────────────────────

// THE UNIT IS STOPPED AND DISABLED BY NAME. No leg signals a process by pattern and no leg invokes a
// package manager: the operator's ruling named the unit, and the binary was installed by hand, so it
// comes off as a file.
test fn the_legs_address_the_unit_by_name_and_never_by_pattern() -> Bool {
  let names = map(ntfy_retire_legs, leg => leg.name)
  let argv = map(ntfy_retire_legs, leg => leg.argv)
  all(names, n => n != "kill" && n != "pkill")
    && all(argv, words => !any(words, w => string_contains(s: w, pattern: "pkill")))
    && all(argv, words => !any(words, w => string_contains(s: w, pattern: "apt")))
    && any(argv, words => any(words, w => w == (ntfy_retire_unit_name as String)))
}

// THE REMOVAL TARGETS ARE ROSTER LITERALS. Every target a removal leg names is one of the four paths
// the roster states, absolute and non-empty, and the legs are built from that same list -- so the
// target checked here and the target the leg removes cannot be two different things.
test fn every_removal_target_is_a_stated_roster_path() -> Bool {
  count(ntfy_retire_removals) == 4
    && ntfy_retire_removals_are_stated()
    && count(filter(ntfy_retire_removals, r => r.recursive)) == 2
}

// RED: THE THREE TARGETS A RETIREMENT MUST NEVER NAME. Empty (the recursive removal that eats the
// host), the filesystem root, and a path DERIVED from a roster path -- the parent of the config
// directory, which is a different tree than the one the operator approved under a name the approval
// never used. A relative path is refused too: it would be read against whatever directory the leg
// happens to land in.
test fn red_an_unstated_removal_target_is_refused() -> Bool {
  !ntfy_retire_removal_target_is_stated(target: "")
    && !ntfy_retire_removal_target_is_stated(target: "/")
    && !ntfy_retire_removal_target_is_stated(target: "/etc")
    && !ntfy_retire_removal_target_is_stated(target: "gunbc-ntfy")
    && ntfy_retire_removal_target_is_stated(target: "/etc/gunbc-ntfy")
}

// THE RECURSIVE FLAG TRAVELS WITH THE TARGET: a tree is removed with -r and a file without it, so a
// leg cannot quietly turn a file removal into a tree walk.
test fn the_recursive_flag_travels_with_the_target() -> Bool {
  all(ntfy_retire_removals, r =>
    any(ntfy_retire_legs, leg => any(leg.argv, w => w == r.target)
      && (r.recursive == any(leg.argv, w => w == "-rf"))))
}

// ── A leg that finds its subject already gone ────────────────────────────────────────────────────
// userdel(8) exits 6 for "specified user doesn't exist". The retirement declares that answer on its
// account-removal leg and reads it as a DIVERGENCE FROM THE ROSTER -- the roster the run was approved
// against lists the account as installed, so a host answering otherwise has been changed by something
// outside this corpus. It is never success: an absence the run did not cause is not a retirement. And
// no other leg gets to guess one -- a leg that declares no such answer reads NO exit that way, because
// "which code would have meant missing" is exactly the plausible default DESIGN.md 5 refuses.

fn witness_leg_declares_subject_absent(leg: NtfyRetireLeg) -> Bool {
  match leg.subject_absent {
    NoSubjectAbsentAnswer => false
    SubjectAbsentExit { exit_code: _ } => true
  }
}

fn witness_declared_subject_absent_exit(leg: NtfyRetireLeg) -> Int {
  match leg.subject_absent {
    NoSubjectAbsentAnswer => -1
    SubjectAbsentExit { exit_code: code } => code
  }
}

test fn only_the_account_leg_declares_a_subject_absent_answer() -> Bool {
  ntfy_retire_legs.all(leg => witness_leg_declares_subject_absent(leg: leg) == (leg.name == "account-remove"))
    && ntfy_retire_legs.all(leg => leg.name != "account-remove"
      || witness_declared_subject_absent_exit(leg: leg) == userdel_user_not_found_exit)
    // Success is never read as "already gone": a leg that exits 0 is followed by the readback, which
    // is the only thing in this run that proves absence.
    && ntfy_retire_legs.all(leg => !ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: 0))
}

// RED: THE ACCOUNT IS NOT ON THE HOST. userdel's 6 must refuse, naming the divergence -- the leg, the
// exit, and the roster it disagrees with -- and a DIFFERENT userdel failure (its generic exit 1) must
// not be dressed up as that divergence. A removal leg that declares no answer (the binary) never reads
// a 6 as one either.
test fn red_a_userdel_that_found_no_account_refuses_as_a_roster_divergence() -> Bool {
  match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "account-remove") {
    Absent => false
    Present { value: account_leg } =>
      match first_where(xs: ntfy_retire_legs, keep: leg => leg.name == "binary-remove") {
        Absent => false
        Present { value: binary_leg } =>
          ntfy_retire_leg_answers_subject_absent(leg: account_leg, exit_code: userdel_user_not_found_exit)
            && !ntfy_retire_leg_answers_subject_absent(leg: account_leg, exit_code: 1)
            && !ntfy_retire_leg_answers_subject_absent(leg: account_leg, exit_code: 2)
            && !ntfy_retire_leg_answers_subject_absent(leg: binary_leg, exit_code: userdel_user_not_found_exit)
            && string_contains(s: ntfy_retire_subject_absent_reason(leg: account_leg, exit_code: userdel_user_not_found_exit), pattern: "account-remove")
            && string_contains(s: ntfy_retire_subject_absent_reason(leg: account_leg, exit_code: userdel_user_not_found_exit), pattern: "6")
            && string_contains(s: ntfy_retire_subject_absent_reason(leg: account_leg, exit_code: userdel_user_not_found_exit), pattern: "roster")
      }
  }
}

// ── The readback verdicts ──────────────────────────────────────────────────────────────────────

data verdict_all_absent: List<NtfyRetireVerdict> = [
  RetireMemberAbsent { member: "unit" as NonEmptyStr, evidence: "systemd LoadState is not-found" },
  RetireMemberAbsent { member: "front door" as NonEmptyStr, evidence: "tailscale serve status lists no route" },
  RetireMemberAbsent { member: "account" as NonEmptyStr, evidence: "getent passwd resolves no entry" },
  RetireMemberAbsent { member: "config directory" as NonEmptyStr, evidence: "the config path does not exist" },
  RetireMemberAbsent { member: "state root" as NonEmptyStr, evidence: "the state root does not exist" },
  RetireMemberAbsent { member: "binary" as NonEmptyStr, evidence: "the binary path does not exist" },
]

test fn the_clean_receipt_reads_every_roster_member_absent_once() -> Bool {
  ntfy_retire_receipt_is_clean(vs: verdict_all_absent)
    && count(ntfy_retire_members) == 6
    && all(ntfy_retire_members, m => string_contains(s: ntfy_retire_receipt_text(vs: verdict_all_absent), pattern: m as String))
}

// RED: A MEMBER FOUND PRESENT. The receipt is the condition the step passes on, so a present member
// must make it unclean rather than merely a line the operator may disagree with.
test fn red_a_member_found_present_makes_the_receipt_unclean() -> Bool {
  let one_present = map(verdict_all_absent, v => match v {
    RetireMemberAbsent { member: m, evidence: e } =>
      if m == ("state root" as NonEmptyStr) {
        RetireMemberPresent { member: m, evidence: e }
      } else {
        RetireMemberAbsent { member: m, evidence: e }
      }
    RetireMemberPresent { member: m, evidence: e } => RetireMemberPresent { member: m, evidence: e }
    RetireMemberUnreadable { member: m, evidence: e } => RetireMemberUnreadable { member: m, evidence: e }
  })
  !ntfy_retire_receipt_is_clean(vs: one_present)
    && string_contains(s: ntfy_retire_receipt_text(vs: one_present), pattern: "STILL PRESENT")
}

// RED: A MEMBER NEVER READ. Six legs ran and five verdicts came back: the roster is the standard, so
// a receipt that simply omits a member is not clean coverage, it is a gap.
test fn red_a_roster_member_never_read_makes_the_receipt_unclean() -> Bool {
  let five = filter(verdict_all_absent, v => match v {
    RetireMemberAbsent { member: m, evidence: _ } => m != ("binary" as NonEmptyStr)
    RetireMemberPresent { member: _, evidence: _ } => true
    RetireMemberUnreadable { member: _, evidence: _ } => true
  })
  count(five) == 5 && !ntfy_retire_receipt_is_clean(vs: five)
}

// ONE READ, THREE STATES, ONE TYPE. Every prober returns the same sum, so no verdict can depend on
// the order of two Bool predicates -- which is how an unread read ends up reported as an absent one.
// These tests read the STATE the classifier produced, never a predicate about it.

fn witness_read_state(read: NtfyRetireRead) -> String {
  match read {
    ReadPresent { evidence: _ } => "present"
    ReadAbsent { evidence: _ } => "absent"
    ReadUnreadable { evidence: _ } => "unreadable"
  }
}

fn witness_verdict_state(v: NtfyRetireVerdict) -> String {
  match v {
    RetireMemberPresent { member: _, evidence: _ } => "present"
    RetireMemberAbsent { member: _, evidence: _ } => "absent"
    RetireMemberUnreadable { member: _, evidence: _ } => "unreadable"
  }
}

data serve_status_with_route: String = "{\"TCP\":{\"8443\":{\"HTTPS\":true}},\"Web\":{\"srv1.example.ts.net:8443\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:2586\"}}}}}"
data serve_status_without_route: String = "{\"TCP\":{\"443\":{\"HTTPS\":true}},\"Web\":{\"srv1.example.ts.net:443\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:18789\"}}}}}"
data serve_status_unparseable: String = "{\"TCP\":{"

// THE UNIT IS READ BY TWO PROBES UNDER ONE RULE: systemd's LoadState AND the unit file's own path.
// A unit whose file is gone but which systemd still answers for is on the host; so is a unit that is
// not loaded while its file is still on disk -- exactly what a stop+disable that never removed the
// file leaves behind. Half of that is not a retirement.
test fn the_unit_absence_needs_both_of_its_reads() -> Bool {
  let load_state_gone = SshSessionExecResult { exit_code: 0, success: true, stdout: "not-found\n", stderr: "" }
  let load_state_loaded = SshSessionExecResult { exit_code: 0, success: true, stdout: "loaded\n", stderr: "" }
  let systemctl_failed = SshSessionExecResult { exit_code: 3, success: false, stdout: "not-found\n", stderr: "" }
  witness_read_state(read: ntfy_retire_unit_read(load_state: load_state_gone, unit_path_exit: 1)) == "absent"
    && witness_read_state(read: ntfy_retire_unit_read(load_state: load_state_gone, unit_path_exit: 0)) == "present"
    && witness_read_state(read: ntfy_retire_unit_read(load_state: load_state_loaded, unit_path_exit: 1)) == "present"
    && witness_read_state(read: ntfy_retire_unit_read(load_state: systemctl_failed, unit_path_exit: 1)) == "unreadable"
}

// THE LOADSTATE ANSWER IS THE VALUE, not the exit code -- and only the two values this model
// understands answer anything. A failed systemctl that happened to print "not-found" is not an absent
// unit, and a value with no rule here (masked, failed, a usage line, an empty answer) is not absence
// either: it is a read this model did not make.
test fn the_unit_load_state_is_read_from_the_value_and_only_two_values_answer() -> Bool {
  witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "not-found\n", stderr: "" })) == "absent"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "loaded\n", stderr: "" })) == "present"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "masked\n", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_load_state_read(read: SshSessionExecResult { exit_code: 1, success: false, stdout: "not-found\n", stderr: "" })) == "unreadable"
}

// THE ACCOUNT. getent's not-found exit AND no line, together: an exit code alone would read a
// transport error as an absent account, and an empty stdout at exit 0 is a read that answered nothing.
test fn the_account_absence_is_getent_not_found_and_no_line() -> Bool {
  witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "", stderr: "" })) == "absent"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "gunbc-ntfy:x:994:984::/nonexistent:/usr/sbin/nologin", stderr: "" })) == "present"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "Usage: getent [OPTION]... DATABASE", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: 0, success: true, stdout: "", stderr: "" })) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: 1, success: false, stdout: "", stderr: "" })) == "unreadable"
}

// A PATH. test(1) exits 0 when the operand is there and 1 when it is not, and exits 2 on its OWN
// error -- and `sudo -n` exits 1 when it refuses to run at all. So only exit 1 is absence: reading
// every non-zero exit as absence is a silent widen that prints `absent:` for a read that never
// happened, which is exactly what DESIGN.md 5 refuses.
test fn a_path_probe_reads_only_exit_one_as_absent() -> Bool {
  witness_read_state(read: ntfy_retire_path_read(exit_code: 0)) == "present"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 1)) == "absent"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 2)) == "unreadable"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 127)) == "unreadable"
}

// RED: A PROBE THAT ERRORED IS NOT AN ABSENCE. exit 2 is test's own error -- a parent it cannot stat,
// an operand it cannot parse. It must land as UNREADABLE, make the receipt unclean, and above all
// never print as `absent:` for that member.
test fn red_a_probe_that_errored_is_not_read_as_absent() -> Bool {
  let errored = ntfy_retire_verdict_from_read(member: "binary" as NonEmptyStr, read: ntfy_retire_path_read(exit_code: 2))
  let vs = concat([errored], filter(verdict_all_absent, x => match x {
    RetireMemberAbsent { member: m, evidence: _ } => m != ("binary" as NonEmptyStr)
    RetireMemberPresent { member: _, evidence: _ } => true
    RetireMemberUnreadable { member: _, evidence: _ } => true
  }))
  witness_verdict_state(v: errored) == "unreadable"
    && !ntfy_retire_receipt_is_clean(vs: vs)
    && string_contains(s: ntfy_retire_receipt_text(vs: vs), pattern: "UNREADABLE")
    && !string_contains(s: ntfy_retire_receipt_text(vs: vs), pattern: "absent: binary")
}

// RED: A READ THAT WAS NEVER MADE NEVER BECOMES AN ABSENT VERDICT. This pins the classifiers
// themselves, not the printing: a systemctl that failed on the bus, a getent that exited 0 printing
// nothing, a getent that exited 1, a tailscale status that does not parse and a path probe that errored
// are five reads that say NOTHING about the roster, and none of them may reach a verdict as Absent.
test fn red_a_read_that_was_never_made_never_becomes_an_absent_verdict() -> Bool {
  let failed_systemctl = SshSessionExecResult { exit_code: 3, success: false, stdout: "yes", stderr: "Failed to connect to bus" }
  let hollow_getent = SshSessionExecResult { exit_code: 0, success: true, stdout: "", stderr: "" }
  let errored_getent = SshSessionExecResult { exit_code: 1, success: false, stdout: "", stderr: "" }
  witness_read_state(read: ntfy_retire_load_state_read(read: failed_systemctl)) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: hollow_getent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_account_read(read: errored_getent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_front_door_read(status_json: serve_status_unparseable)) == "unreadable"
    && witness_read_state(read: ntfy_retire_path_read(exit_code: 2)) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(member: "unit" as NonEmptyStr, read: ntfy_retire_load_state_read(read: failed_systemctl))) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(member: "account" as NonEmptyStr, read: ntfy_retire_account_read(read: hollow_getent))) == "unreadable"
    && witness_verdict_state(v: ntfy_retire_verdict_from_read(member: "front door" as NonEmptyStr, read: ntfy_retire_front_door_read(status_json: serve_status_unparseable))) == "unreadable"
}

// A READ THAT HAPPENED IS CLASSIFIED BY WHAT IT ANSWERED, and one shared function is the only thing
// between a read and a verdict: the receipt built from six real answers is clean, and each line names
// the prober that decided it rather than restating the run's intent.
test fn a_read_that_happened_is_classified_by_what_it_answered() -> Bool {
  let unit_absent = ntfy_retire_verdict_from_read(member: "unit" as NonEmptyStr, read: ntfy_retire_unit_read(load_state: SshSessionExecResult { exit_code: 0, success: true, stdout: "not-found\n", stderr: "" }, unit_path_exit: 1))
  let door_absent = ntfy_retire_verdict_from_read(member: "front door" as NonEmptyStr, read: ntfy_retire_front_door_read(status_json: serve_status_without_route))
  let account_absent = ntfy_retire_verdict_from_read(member: "account" as NonEmptyStr, read: ntfy_retire_account_read(read: SshSessionExecResult { exit_code: getent_key_not_found_exit, success: false, stdout: "", stderr: "" }))
  let config_absent = ntfy_retire_verdict_from_read(member: "config directory" as NonEmptyStr, read: ntfy_retire_path_read(exit_code: 1))
  let state_absent = ntfy_retire_verdict_from_read(member: "state root" as NonEmptyStr, read: ntfy_retire_path_read(exit_code: 1))
  let binary_absent = ntfy_retire_verdict_from_read(member: "binary" as NonEmptyStr, read: ntfy_retire_path_read(exit_code: 1))
  let vs = [unit_absent, door_absent, account_absent, config_absent, state_absent, binary_absent]
  all(vs, v => witness_verdict_state(v: v) == "absent")
    && ntfy_retire_receipt_is_clean(vs: vs)
    && string_contains(s: ntfy_retire_verdict_text(v: unit_absent), pattern: "systemd LoadState is not-found")
    && string_contains(s: ntfy_retire_verdict_text(v: account_absent), pattern: "getent passwd resolves no entry")
    && string_contains(s: ntfy_retire_verdict_text(v: door_absent), pattern: "tailscale serve status lists no route")
}

// TWO READS OF ONE MEMBER MEET UNDER ONE RULE, and the rule does not depend on the order they arrive:
// seen beats silence, silence beats "gone", and only a unanimous "gone" is gone.
test fn two_reads_of_one_member_meet_under_one_rule() -> Bool {
  let seen = ntfy_retire_path_read(exit_code: 0)
  let gone = ntfy_retire_path_read(exit_code: 1)
  let silent = ntfy_retire_path_read(exit_code: 2)
  witness_read_state(read: ntfy_retire_reads_meet(a: seen, b: gone)) == "present"
    && witness_read_state(read: ntfy_retire_reads_meet(a: gone, b: seen)) == "present"
    && witness_read_state(read: ntfy_retire_reads_meet(a: gone, b: silent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_reads_meet(a: silent, b: gone)) == "unreadable"
    && witness_read_state(read: ntfy_retire_reads_meet(a: silent, b: silent)) == "unreadable"
    && witness_read_state(read: ntfy_retire_reads_meet(a: gone, b: gone)) == "absent"
}

// THE FRONT DOOR. tailscale's own status is the account of what it serves: a route on the retired port
// means the door is still standing, and a status that cannot be parsed is NOT read as absence -- a
// parse gap must not retire a listener.
test fn the_front_door_absence_is_read_from_tailscales_own_status() -> Bool {
  witness_read_state(read: ntfy_retire_front_door_read(status_json: serve_status_without_route)) == "absent"
    && witness_read_state(read: ntfy_retire_front_door_read(status_json: serve_status_with_route)) == "present"
    && witness_read_state(read: ntfy_retire_front_door_read(status_json: serve_status_unparseable)) == "unreadable"
}

// THE ROSTER PATHS ARE THE ONES THE RUN REMOVES: each member's path appears in a leg, so the roster
// and the legs cannot drift into different lists.
test fn every_roster_path_is_removed_by_a_leg() -> Bool {
  all([ntfy_retire_unit_path, ntfy_retire_config_dir, ntfy_retire_state_root, ntfy_retire_binary_path], p =>
    any(ntfy_retire_legs, leg => any(leg.argv, w => w == (p as String))))
}
