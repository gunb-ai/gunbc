module test.claim.os_free_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn free_output_witnesses() -> Bool {
  let memory_stats = extdeps.os.free.MemoryStats {
    total: std.measure.byte_size(count: 8192000000),
    used: std.measure.byte_size(count: 1024000000),
    free: std.measure.byte_size(count: 2048000000),
    shared: std.measure.byte_size(count: 0),
    buff_cache: std.measure.byte_size(count: 5120000000),
    available: std.measure.byte_size(count: 3072000000),
  }

  let swap_stats = extdeps.os.free.SwapStats {
    total: std.measure.byte_size(count: 2048000000),
    used: std.measure.byte_size(count: 0),
    free: std.measure.byte_size(count: 2048000000),
  }

  let output = extdeps.os.free.FreeOutput {
    memory: memory_stats,
    swap: swap_stats,
  }

  std.measure.byte_size_count(b: memory_stats.total) > 0
    && std.measure.byte_size_count(b: memory_stats.available) <= std.measure.byte_size_count(b: memory_stats.total)
    && std.measure.byte_size_count(b: memory_stats.free) <= std.measure.byte_size_count(b: memory_stats.total)
    && std.measure.byte_size_count(b: swap_stats.used) <= std.measure.byte_size_count(b: swap_stats.total)
    && std.measure.byte_size_count(b: swap_stats.free) <= std.measure.byte_size_count(b: swap_stats.total)
    && std.measure.byte_size_count(b: output.memory.total) > 0
    && std.measure.byte_size_count(b: memory_stats.available) >= std.measure.byte_size_count(b: memory_stats.free)
}
