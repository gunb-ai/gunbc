module test.claim.dag_compile_clean_shard_totality_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data live_tree_disposition_correction_note: String = "Corrected 2026-07-29: the SubstrateInputsOnly stamp was FALSE and lying_substrate_inputs_only_stamp_census caught it — this file's import closure reaches the live-read carrier home tools.dag_compile_clean_shard_roster. The stamp is file-grain but this file is two-grain: the Class C split above left the synthetic fixture-grain rows here ALONGSIDE compile_clean_shard_totality_holds_on_live_tree, which scans the real tree. One stamp cannot be true for both grains, so it must take the fail-closed value (DESIGN §5) — ReadsLiveTree restores the never-skip tooth, since a SubstrateInputsOnly row is predict-skip-eligible and a wrongly skipped live-tree row is a selection fail-open. Falsifier rehoming (note below) governs which CADENCE the row runs on; it does not make the file's live-tree reach disappear."

data class_c_shard_totality_roster_split_note: String = "Class C split (docs/plans/test-decomposition-wcf-cut.md §5, session bright-newt-31 2026-07-25, criterion 2): both rows in this file are now fixture-grain mechanism REDs — roster selection logic and totality-verdict algebra — proven on synthetic decl-facts/glob-results, never a real scan of the live tree. The corpus-totality CLAIM itself (does the real live tree's roster stay total/nonempty/duplicate-free right now) is legitimately corpus-grain and is not shrunk: it is relocated to the falsifier wet cadence as compile_clean_shard_totality_holds_on_live_tree, a typed row in gunbc.ci_layer_roots falsifier_rehomed_bin_wet_rows (batch 5, named consumer ci_floor_plan.dag), never orphaned."

test fn compile_clean_shard_roster_is_well_formed() -> Bool {
  tools.dag_compile_clean_shard_roster.witness_shard_roster_boundary_is_witness_layer_roots()
    && tools.dag_compile_clean_shard_roster.witness_roster_nonempty_on_fixture_facts()
    && tools.dag_compile_clean_shard_roster.witness_roster_build_admits_on_fixture_facts()
    && tools.dag_compile_clean_shard_roster.witness_roster_build_refuses_synthetic_duplicate_facts()
    && tools.dag_compile_clean_shard_roster.witness_roster_empty_facts_are_not_nonempty()
}

test fn compile_clean_shard_totality_algebra_holds() -> Bool {
  tools.dag_compile_clean_shard_totality.witness_totality_reds_on_synthetic_orphan()
    && tools.dag_compile_clean_shard_totality.witness_totality_reds_on_synthetic_double_claim()
    && tools.dag_compile_clean_shard_totality.witness_totality_reds_on_synthetic_surplus()
    && tools.dag_compile_clean_shard_totality.witness_totality_fails_closed_on_glob_failure()
    && tools.dag_compile_clean_shard_totality.witness_totality_green_when_glob_matches_roster()
}

data compile_clean_shard_totality_holds_on_live_tree_falsifier_note: String = "NOT a per-PR row: falsifier-rehomed (gunbc.ci_layer_roots falsifier_rehomed_bin_wet_rows) per the Class C split above. Excluded from per-PR bin_witness_wet_entries; runs on the falsifier wet cadence (batch 5, ci_floor_plan.dag) as its named consumer."

test fn compile_clean_shard_totality_holds_on_live_tree() -> Bool {
  tools.dag_compile_clean_shard_totality.witness_totality_holds_on_live_tree()
}
