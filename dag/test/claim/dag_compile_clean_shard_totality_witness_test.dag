module test.claim.dag_compile_clean_shard_totality_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn compile_clean_shard_roster_is_well_formed() -> Bool {
  tools.dag_compile_clean_shard_roster.compile_clean_shard_roster_nonempty()
    && tools.dag_compile_clean_shard_roster.compile_clean_shard_roster_paths_duplicate_free()
    && tools.dag_compile_clean_shard_roster.witness_shard_roster_boundary_is_entry_root_only()
}

test fn compile_clean_shard_totality_algebra_holds() -> Bool {
  tools.dag_compile_clean_shard_totality.witness_totality_reds_on_synthetic_orphan()
    && tools.dag_compile_clean_shard_totality.witness_totality_reds_on_synthetic_double_claim()
    && tools.dag_compile_clean_shard_totality.witness_totality_reds_on_synthetic_surplus()
    && tools.dag_compile_clean_shard_totality.witness_totality_fails_closed_on_glob_failure()
    && tools.dag_compile_clean_shard_totality.witness_totality_green_when_glob_matches_roster()
}

test fn compile_clean_shard_totality_holds_on_live_tree() -> Bool {
  tools.dag_compile_clean_shard_totality.witness_totality_holds_on_live_tree()
}
