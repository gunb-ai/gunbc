module test.claim.climbing_hold_catalog_witness

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.climbing_holds.types {
  ClimbingHoldCatalogRow, HoldFixationInterface,
  ImperialUncThread, SingleFlatMountingFace,
  VendorPageRead, SampleMeasured, SearchSummaryOnly, DimensionUnread,
  SkuResolved, SkuAmbiguous, SkuUnread,
  ShapeArtifactHeld, ShapeArtifactAbsent,
  dimension_evidence_is_spendable, hold_may_render_silhouette,
  hold_fixation_is_placeable, hold_envelope_is_spendable,
}
import extdeps.climbing_holds.atomik {
  atomik_xl_arrow_down_climb_jug, atomik_bolt_on_frame,
}

data climbing_hold_witness_note: NonEmptyStr = "These witnesses guard a refusal, which is the hardest kind of claim to test honestly. A witness that only checks 'the unverified row refuses' passes just as well when the gate is hard-wired to false, so each refusal below is paired with a control that must pass. Without the paired control the suite would be exactly the failure it exists to prevent: a check that passes while measuring nothing."

// The row's envelope came from a search summary, so it must not be spendable.
test fn witness_search_summary_envelope_is_not_spendable() -> Bool {
  !hold_envelope_is_spendable(row: atomik_xl_arrow_down_climb_jug)
}

// PAIRED CONTROL for the witness above. dimension_evidence_is_spendable must ADMIT real readings,
// otherwise the refusal proves nothing about provenance and only proves the function is constant.
// A measured sample and a vendor page both pass; the search summary and an unread field both fail.
test fn witness_dimension_spendability_discriminates_by_provenance() -> Bool {
  let vendor_authority: ExternalAuthority = ExternalAuthority {
    uri: Uri {
      scheme: Https
      locator: "www.atomikclimbingholds.com/xl-arrow-shaped-down-climb-jug"
    }
  }
  dimension_evidence_is_spendable(
    evidence: SampleMeasured { receipt: "calipered sample, three positions, recorded" },
  )
    && dimension_evidence_is_spendable(
         evidence: VendorPageRead { authority: vendor_authority, read_on: "not yet read" },
       )
    && !dimension_evidence_is_spendable(
         evidence: SearchSummaryOnly { obligation: "read the page" },
       )
    && !dimension_evidence_is_spendable(
         evidence: DimensionUnread { obligation: "read the page" },
       )
}

// No shape artifact is held, so no silhouette may be drawn.
test fn witness_absent_shape_refuses_silhouette() -> Bool {
  !hold_may_render_silhouette(row: atomik_xl_arrow_down_climb_jug)
}

// The fixation cannot yet place a fastener: neither the thread nor the mounting face has been
// read. This is the field that must NOT be filled by market convention.
test fn witness_fixation_is_not_yet_placeable() -> Bool {
  !hold_fixation_is_placeable(row: atomik_xl_arrow_down_climb_jug)
}

// PAIRED CONTROL for the witness above, and the load-bearing claim of this whole module. Supply a
// thread and a flat mounting face and the SAME row becomes placeable — while its shape stays
// absent and its envelope stays unspendable. That is the retracted inference stated as a testable
// fact: a bolt-on hold's fastener placement depends on its frame and interface, NOT on its
// silhouette. The design carrier deleted the hold because it could not be drawn; this proves
// drawability was never the blocker.
test fn witness_placeability_does_not_depend_on_shape_or_envelope() -> Bool {
  let known_fixation: HoldFixationInterface = HoldFixationInterface {
    primary_bolt_thread: ImperialUncThread { designation: "3/8-16 UNC" },
    primary_bolt_count: 1,
    anti_rotation_fixing_count: 1,
    anti_rotation_fixing_note: "hypothetical, for discrimination only",
    mounting_face: SingleFlatMountingFace,
    frame: atomik_bolt_on_frame,
  }
  let placeable_but_unknown_shape: ClimbingHoldCatalogRow = ClimbingHoldCatalogRow {
    product_name: atomik_xl_arrow_down_climb_jug.product_name,
    sku_identity: atomik_xl_arrow_down_climb_jug.sku_identity,
    material: atomik_xl_arrow_down_climb_jug.material,
    fixation: known_fixation,
    envelope: atomik_xl_arrow_down_climb_jug.envelope,
    grasp: atomik_xl_arrow_down_climb_jug.grasp,
    shape: atomik_xl_arrow_down_climb_jug.shape,
  }
  hold_fixation_is_placeable(row: placeable_but_unknown_shape)
    && !hold_may_render_silhouette(row: placeable_but_unknown_shape)
    && !hold_envelope_is_spendable(row: placeable_but_unknown_shape)
}

// A brand plus a descriptive phrase is not an identity. Two catalog paths surfaced for what may be
// one product or two, and the row must keep saying so rather than picking the prettier name.
test fn witness_sku_identity_stays_ambiguous() -> Bool {
  match atomik_xl_arrow_down_climb_jug.sku_identity {
    SkuAmbiguous { candidate_names: names, obligation: _ } => count(names) >= 2
    SkuResolved { sku_code: _, authority: _ } => false
    SkuUnread { obligation: _ } => false
  }
}
