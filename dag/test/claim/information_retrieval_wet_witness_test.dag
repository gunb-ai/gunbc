module test.claim.information_retrieval_wet_witness

import std.types { NonEmptyStr, Bool }
import std.claim_evidence { RecordedFactId, EvidenceSupports }
import extdeps.http.client
import extdeps.uri { uri_wire }
import gunbc.information_retrieval { information_retrieve_evidence }
import gunbc.information_query {
  TimeInvariant,
  SoleRetrieval,
  InformationEvidenceUnavailable,
  InformationEvidenceUnobservable,
  InformationEvidenceInferred,
}
import test.claim.information_query_witness {
  fixture_expected_hex,
  fixture_digest,
  fixture_target,
  fixture_authority,
  fixture_provenance,
}

// THE FIXTURES ARE IMPORTED, NOT COPIED. The hermetic witness module already owns this specimen --
// the same locator, subject, pin and provenance -- and a second transcription of it would be two
// authorities for one fixture (DESIGN section 2 and 3): they would drift, and a wet run would then
// be measuring a different subject than the hermetic run it is supposed to correspond to.

// THE RETRIEVAL REALIZATION IS EXERCISED AGAINST THE REAL WORLD, which is why this is a wet witness
// and not part of the hermetic set. It runs http.Client.GetBounded for real, so which arm executes
// depends on whether the network answers -- and that is the point: BOTH answers must land on
// InformationEvidenceUnavailable. A reachable fetch yields a response with no representation
// observation, because nothing can yet digest a body in memory; an unreachable one yields a
// transport failure. Neither may fabricate a receipt for bytes nobody reconciled.
//
// THE ORACLE IS THE TRANSPORT, NOT A DISJUNCTION OF THE ARMS. An earlier version returned true on
// BOTH arms the function can produce, so its false branch was unreachable and it could never go red
// -- permanently green by construction, and worse than absent because it would be cited as coverage
// (DESIGN 4b: ask whether the check\'s RED is authorable before writing the check). This runs the
// same transport independently and requires the arm to AGREE with what the network actually did, so
// swapping the two arms, or refusing a fetch that succeeded, turns it red.
test fn w_wet_retrieval_arm_matches_what_the_transport_did() -> Bool {
  match fixture_digest(hex: fixture_expected_hex) {
    Absent => false
    Present { value: expected } => {
      let target = fixture_target(expected: expected)
      let probe = http.Client.GetBounded(url: uri_wire(uri: target.expected_pin.subject.access_route))
      match information_retrieve_evidence(
        target: target,
        observed_at: 1788825000000,
        fact_id: "information-retrieval-wet-witness-fact" as RecordedFactId,
        scope: TimeInvariant,
        direction: EvidenceSupports,
        authority: fixture_authority(),
        provenance: fixture_provenance(),
        freshness_basis: "unused: no representation is reconciled on either arm" as NonEmptyStr,
        fidelity_losses: [],
        independence: SoleRetrieval,
      ) {
        InformationEvidenceUnobservable { detail: _ } => probe.success
        InformationEvidenceUnavailable { cause: _ } => !probe.success
        InformationEvidenceInferred { inference: _ } => false
      }
    }
  }
}
