module test.claim.information_retrieval_wet_witness

import std.types { NonEmptyStr, String, List, Bool }
import std.decl_ref { decl_ref }
import extdeps.uri { Uri, Https }
import extdeps.version { VersionIdentity }
import extdeps.external_authority { ExternalAuthority, ExternalSubjectRef }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import std.citation {
  citation_exact_pin,
  citation_target,
  CitationTarget,
  CitationSelector,
  CitationRetrievalRequest,
  CitationRetrievalObservation,
  RepresentationRetrieved,
  CitationUnreachable,
  ConnectionRefused,
  ObservedCitedRepresentation,
  cited_representation_identity,
  RawResponseBody,
  verify_citation_representation,
}
import extdeps.http.server { text_plain_utf8 }
import std.claim_evidence {
  RecordedFactId,
  EvidenceProvenance,
  ProvEntityId,
  ProvActivityId,
  ProvAgentId,
  EvidenceSupports,
}
import gunbc.information_retrieval { information_retrieve_evidence }
import gunbc.information_query {
  InformationTemporalScope,
  TimeInvariant,
  InformationEvidenceProbeIndependence,
  SoleRetrieval,
  information_evidence_from_verification,
}


data wet_fixture_expected_hex: String = "1111111111111111111111111111111111111111111111111111111111111111"
data wet_fixture_other_hex: String = "2222222222222222222222222222222222222222222222222222222222222222"

fn wet_fixture_locator() -> Uri {
  Uri { scheme: Https, locator: "www.rfc-editor.org/rfc/rfc8118.txt" }
}

fn wet_fixture_subject() -> ExternalSubjectRef {
  ExternalSubjectRef {
    declaration: decl_ref(
      module_path: "extdeps.standards.rfc_8118",
      decl_name: "pdf_open_fragment_selector",
    ),
  }
}

fn wet_fixture_digest(hex: String) -> Sha256Digest? {
  sha256_hex_digest(hex: hex)
}

fn wet_fixture_authority() -> ExternalAuthority {
  ExternalAuthority { uri: wet_fixture_locator() }
}

fn wet_fixture_provenance() -> EvidenceProvenance {
  EvidenceProvenance {
    entity: "information-query-witness-entity" as ProvEntityId,
    activity: "information-query-witness-retrieval" as ProvActivityId,
    agent: "information-query-witness-agent" as ProvAgentId,
  }
}

fn wet_fixture_target(expected: Sha256Digest) -> CitationTarget<CitationSelector> {
  citation_target(
    expected_pin: citation_exact_pin(
      source: wet_fixture_subject(),
      access_route: wet_fixture_locator(),
      byte_domain: RawResponseBody,
      version: "rfc8118" as VersionIdentity,
      expected_identity: expected,
    ),
    selector: none,
  )
}

fn wet_fixture_observation(observed: Sha256Digest) -> CitationRetrievalObservation {
  RepresentationRetrieved {
    request: CitationRetrievalRequest { locator: wet_fixture_locator() },
    observed_at: 1788825000000,
    http_status: 200,
    observed: ObservedCitedRepresentation {
      identity: cited_representation_identity(
        source: wet_fixture_subject(),
        access_route: wet_fixture_locator(),
        byte_domain: RawResponseBody,
      ),
      media_type: text_plain_utf8,
      observed_identity: observed,
    },
  }
}

fn wet_fixture_admissible_for(expected_hex: String, observed_hex: String) -> Bool {
  match wet_fixture_digest(hex: expected_hex) {
    Absent => false
    Present { value: expected } =>
      match wet_fixture_digest(hex: observed_hex) {
        Absent => false
        Present { value: observed } =>
          information_evidence_is_admissible(
            evidence: information_evidence_from_verification(
              fact_id: "information-query-witness-fact" as RecordedFactId,
              outcome: verify_citation_representation(
                target: wet_fixture_target(expected: expected),
                observation: wet_fixture_observation(observed: observed),
              ),
              scope: TimeInvariant,
              direction: EvidenceSupports,
              authority: wet_fixture_authority(),
              provenance: wet_fixture_provenance(),
              freshness_basis: "the cited specification text is time-invariant at this version" as NonEmptyStr,
              fidelity_losses: [],
              independence: SoleRetrieval,
            ),
          )
      }
  }
}


// THE RETRIEVAL REALIZATION IS EXERCISED AGAINST THE REAL WORLD, which is why this is a wet witness
// and not part of the hermetic set. It runs http.Client.GetBounded for real, so its outcome depends
// on whether the network answers -- and that is precisely the point: BOTH answers must land on
// InformationEvidenceUnavailable. A reachable fetch produces a response with no representation
// observation, because nothing here can digest a body in memory; an unreachable one produces a
// transport failure. Neither may fabricate a receipt for bytes nobody reconciled.
//
// It matches the ARM rather than admissibility, for the reason the hermetic unreachable witness
// does: an invented receipt routed through insufficiency would be inadmissible too, and would have
// stayed green.
test fn w_wet_retrieval_never_fabricates_a_receipt() -> Bool {
  match wet_fixture_digest(hex: wet_fixture_expected_hex) {
    Absent => false
    Present { value: expected } =>
      match information_retrieve_evidence(
        target: wet_fixture_target(expected: expected),
        observed_at: 1788825000000,
        fact_id: "information-retrieval-wet-witness-fact" as RecordedFactId,
        scope: TimeInvariant,
        direction: EvidenceSupports,
        authority: wet_fixture_authority(),
        provenance: wet_fixture_provenance(),
        freshness_basis: "unused: no representation is reconciled on either arm" as NonEmptyStr,
        fidelity_losses: [],
        independence: SoleRetrieval,
      ) {
        InformationEvidenceUnavailable { cause: _ } => true
        InformationEvidenceInferred { inference: _ } => false
      }
  }
}
