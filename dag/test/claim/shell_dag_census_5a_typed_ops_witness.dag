module test.claim.shell_dag_census_5a_typed_ops_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.dns.domain_name { DnsLabel }
import extdeps.tools.hostname {
  HostnameSetApplied,
  HostnameSetInvocation,
  hostname_set_argv,
  hostname_set_classify_observation,
  hostname_set_execute_plan,
  hostname_set_invocation_process_plan
}
import extdeps.systemd.systemctl
import extdeps.tools.id
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Hermetic witnesses for the shell->dag census §5.A finite new-op list: os.Hostname.Set,
// systemd.Systemctl.ListUnits, systemd.Systemctl.Status, extdeps.tools.id (Uid/Gid/Lookup).
// The hostname-set entry has moved past the §5.A grain: os.Hostname.Set's hand-authored
// transport row is deleted and the invocation-layer path (HostnameSetInvocation -> lowering ->
// hostnamectl.Process.Run) realizes hermetically. The other ops remain model-before-implement
// only (D1) — each op's mock_response proves the typed exit{}/output shape realizes hermetically;
// call-site migration (§5.B) is a separate, later lane. Each op cites its upstream authority in
// its home file's extdeps_external_authority_anchor.

test fn witness_hostname_set_argv_is_typed_not_concat() -> Bool {
  match hostname_set_argv(desired: "srv9" as DnsLabel) {
    Rejected { diagnostics: _ } => false
    Accepted { value: argv, diagnostics: _ } =>
      join(argv, " ") == "hostnamectl set-hostname srv9"
  }
}

test fn witness_hostname_set_realizes_hermetically() -> Bool {
  match hostname_set_invocation_process_plan(invocation: HostnameSetInvocation { desired: "srv9" as DnsLabel }) {
    Rejected { diagnostics: _ } => false
    Accepted { value: plan, diagnostics: _ } =>
      match hostname_set_classify_observation(observation: hostname_set_execute_plan(plan: plan)) {
        HostnameSetApplied => true
        _ => false
      }
  }
}

test fn witness_systemctl_list_units_realizes_hermetically() -> Bool {
  let r = systemd.Systemctl.ListUnits(pattern: "demo@*.service" as NonEmptyStr)
  r.success && r.stdout != ""
}

test fn witness_systemctl_status_realizes_hermetically() -> Bool {
  let r = systemd.Systemctl.Status(unit: "demo.service" as NonEmptyStr)
  r.success && r.stdout != ""
}

test fn witness_os_id_uid_realizes_hermetically() -> Bool {
  let r = os.Id.Uid()
  r.success && r.value == "1000"
}

test fn witness_os_id_gid_realizes_hermetically() -> Bool {
  let r = os.Id.Gid()
  r.success && r.value == "1000"
}

test fn witness_os_id_lookup_realizes_hermetically() -> Bool {
  let r = os.Id.Lookup(user: "demo" as NonEmptyStr)
  r.success && r.stdout != ""
}
