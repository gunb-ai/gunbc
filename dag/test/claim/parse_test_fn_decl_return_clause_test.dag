module test.claim.parse_test_fn_decl_return_clause

import v2.compiler.body_lowering_fold {
  body_lower_fn_decl_to_arrow,
  body_lower_outcome_is_wrapper_retained,
  body_lower_return_type_from_fn_captured,
  body_lower_unwrap_captured
}
import v2.compiler.normalize { normalize }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag {
  dag_lex,
  parse_production_emitted_identity_optional
}
import v2.std.grammar { node_atom_identity_optional }
import v2.std.diagnostic { Accepted, Diagnostic, NodeLocus, None, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Node, Symbol }
import v2.std.optional { Absent, Optional, Present, optional_present }

// ---------------------------------------------------------------------------
// THE ENROLLED REDS AND FALSIFIERS FOR THE POSITIONAL RETURN-TYPE READ.
//
// WHERE THESE EXECUTE IS PART OF WHAT THEY ARE. This file began as
// v2.test.manual.normalize_fn_body_cost_probe, the cost decomposition that located the fn-body
// normalize charge; its twelve dangling cost fns were deleted (review 70132) and what remained
// are the reds and falsifiers below. Under that name the module matched neither
// v2.workflow.required_floor `required_gate_prefixes` nor `required_gate_authored_modules`, so
// the required floor dispositioned every identity here DeclinedOutsideRequiredGate: a wall that
// never ran on the merge path. THE REPAIR IS A MOVE, NOT A ROSTER EDIT (the rosters are closed to
// growth without operator sign-off; the precedent is
// test.claim.infer_record_field_completeness_zero_field_witness_test): the module name now
// matches the admitted `test.claim.parse_test` family, whose subject -- the fn_decl production's
// spine as the parser emits it -- is the contract these claims hold for the positional reader.
// The identities were renamed with the module; nothing else cites them.
// ---------------------------------------------------------------------------

// FALSIFIERS FOR THE POSITIONAL READ ITSELF. The spine read relies on opt(generic_params)
// occupying its position when elided; a generic fn is the case where that assumption, if
// wrong, shifts every later position. The `= expr` form exercises the OTHER arm of the body
// choice at the same spine depth. A wrong read here is a regression across the corpus, not an
// edge case: generic fns and `=`-bodied fns are ordinary.
data nfbcp_generic_fn_source: String = "module m\nfn f<T>(x: T) -> T { x }\n"

data nfbcp_eq_body_fn_source: String = "module m\nfn f(x: Int) -> Int = x\n"

data nfbcp_ordinary_fn_source: String = "module m\nfn f(x: Int) -> Int { x }\n"

// ARM 1 -- a declared return type. The deleted reading met the parameter's fn-type arrow
// first and answered Int for a function declared to return Bool: a WRONG CODOMAIN on an
// otherwise ordinary lowering. This arm has natural instances in the corpus.
data nfbcp_fn_type_param_source: String = "module m\nfn g(h: fn(Int) -> Int) -> Bool { true }\n"

// ARM 2 -- NO declared return type. The production carries no arrow clause at all, so a
// positional read is Absent and the consumer must retain the wrapper. The deleted reading
// instead found the PARAMETER's arrow and minted an Arrow with Int as its codomain, so the
// defect here is a DISPOSITION FLIP, not only a wrong type.
//
// The corpus population for this arm is EMPTY today (sizing scan over 76839 fn declarations
// across dag/ and src/v2: one apparent candidate, and it is prose inside a String in
// gunbc.recurring_failure_mode.accepted_source_emits_uncompilable_target). An empty
// population is a fact about today's corpus and not about the compiler -- the first fn
// anyone writes in this shape flips -- so this arm has no natural instance protecting it
// and its red is an AUTHORED fixture. DESIGN section 4b asks whether the forbidden state is
// authorable before writing the check: it is, so declining the fixture would be
// specification-without-execution.
data nfbcp_no_return_type_source: String = "module m\nfn g(h: fn(Int) -> Int) { true }\n"

// The PREPARED grammar, not the whole language model. dag_prepared_grammar is enrolled in
// floor_cross_claim_pure_producers_warm, so the required floor fills it during strict
// preparation -- outside every per-claim budget -- and a claim here pays the lookup rather
// than the construction. Building dag_language_model() per claim instead charged ~107k eval
// steps to every probe below, which is the parse subject and not this claim's.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn nfbcp_parsed(text: String) -> Optional<Node> {
  match tokenize(text: text, file: ^nfbcp_probe_file, rules: dag_lex()) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ts, diagnostics: _ } =>
      match dag_prepared_grammar() {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: prepared, diagnostics: _ } =>
          match parse_module_prepared(tokens: ts, prepared: prepared, validation_residue: None) {
            Rejected { diagnostics: _ } => Absent
            Accepted { value: artifact, diagnostics: _ } => Present { value: artifact.tree }
          }
      }
  }
}

fn nfbcp_find_shell(root: Node, emitted: Symbol) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      if id == emitted {
        optional_present(value: root)
      } else {
        fold(root.children, init: Absent, f: fn(acc, e) {
          match acc {
            Present { value: _ } => acc
            Absent => nfbcp_find_shell(root: e.target, emitted: emitted)
          }
        })
      }
    Absent =>
      fold(root.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => nfbcp_find_shell(root: e.target, emitted: emitted)
        }
      })
  }
}

fn nfbcp_fn_decl_shell(text: String) -> Optional<Node> {
  match nfbcp_parsed(text: text) {
    Absent => Absent
    Present { value: tree } => nfbcp_find_shell(root: tree, emitted: ^dag_surface_fn_decl)
  }
}

fn nfbcp_fn_captured(text: String) -> Optional<Node> {
  match nfbcp_fn_decl_shell(text: text) {
    Absent => Absent
    Present { value: shell } => body_lower_unwrap_captured(shell: shell)
  }
}

fn nfbcp_return_atom(text: String) -> Optional<Symbol> {
  match nfbcp_fn_captured(text: text) {
    Absent => Absent
    Present { value: captured } =>
      match body_lower_return_type_from_fn_captured(captured: captured) {
        Absent => Absent
        Present { value: rt } => nfbcp_atom_identity_deep(node: rt)
      }
  }
}

fn nfbcp_atom_identity_deep(node: Node) -> Optional<Symbol> {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => optional_present(value: id)
    Absent =>
      fold(node.children, init: Absent, f: fn(acc, e) {
        match acc {
          Present { value: _ } => acc
          Absent => nfbcp_atom_identity_deep(node: e.target)
        }
      })
  }
}

// THE MARGIN HERE IS THIN, AND THAT IS A STANDING FACT ABOUT THIS FILE RATHER THAN A NUMBER.
// The most expensive claim below is the disposition arm, because it is the only one that pays
// parse AND body_lower_fn_decl_to_arrow; it sits just under the per-claim ceiling derived by
// v2.workflow.required_floor `claim_ceiling_eval_step_budget`. So enlarging a specimen or adding
// an assertion to that claim is a budget decision, not a free edit. The producer that re-derives
// the current figures is the required floor itself, which prints eval_steps per claim on every
// run -- not transcribed here, because a copied number would rot without anyone touching either
// end (DESIGN section 6).
//
// WHY THE SUPPLIED-TOKEN ROUTE IS NOT USED HERE, since it is the obvious headroom and declining
// it is a judgement rather than an oversight. v2.test.parse.supplied_token_stream_support exists
// for claims whose text route exceeds the budget BEFORE they assert anything; it converts one
// over-budget claim into TWO that must each fit (a fidelity claim costing tokenize, plus the
// supplied-route claim) and needs a hand-authored TokenStream per specimen. These claims are
// already under the ceiling, so adopting it would author four token streams and double the claim
// count to buy speculative margin -- and today it would also mean carrying a second copy of that
// module, which is the DESIGN section 3 fork. If a later edit pushes the disposition arm over,
// that is the mechanism to adopt, and the specimens here are small enough for it to work.
//
// ===========================================================================
// ENROLLED REDS for the positional-return-type repair (DESIGN section 4b(4):
// these stay enrolled as regression controls after they green; they do not retire).
// ===========================================================================

// ARM 1 RED. Fails on the deleted shape-search reading, which answered the PARAMETER
// fn-type's Int; holds on the positional read, which cannot reach a parameter at all.
test fn nfbcp_hazard_return_type_is_positional_holds() -> Bool {
  match nfbcp_return_atom(text: nfbcp_fn_type_param_source) {
    Absent => false
    Present { value: id } => id == ^bool_node_symbol
  }
}

// ARM 2 RED. With no arrow clause in the production there is no return type to read, so
// the positional read must be ABSENT. The deleted reading returned the parameter's arrow.
test fn nfbcp_hazard_no_return_type_reads_absent_holds() -> Bool {
  match nfbcp_return_atom(text: nfbcp_no_return_type_source) {
    Absent => true
    Present { value: _ } => false
  }
}

// ARM 2 RED, at the consumer. An Absent return type reaches
// `Absent => body_lower_wrapper_retained_shell`, so the member is RETAINED rather than
// lowered to an Arrow carrying a codomain the source never declared. Asserting the
// disposition and not only the type keeps this a claim about the ROUTE.
test fn nfbcp_hazard_no_return_type_retains_wrapper_holds() -> Bool {
  match nfbcp_fn_decl_shell(text: nfbcp_no_return_type_source) {
    Absent => false
    Present { value: shell } =>
      body_lower_outcome_is_wrapper_retained(o: body_lower_fn_decl_to_arrow(shell: shell))
  }
}

// POSITIVE CONTROL for the repair: an ordinary fn with a declared return type and no
// fn-typed parameter still lowers, so the positional read is not a blanket refusal.
test fn nfbcp_control_ordinary_fn_return_type_holds() -> Bool {
  match nfbcp_return_atom(text: nfbcp_ordinary_fn_source) {
    Absent => false
    Present { value: id } => id == ^dag_binding_type_int
  }
}

// FALSIFIER: a generic fn must still read its declared return type. Absent here would mean
// every generic fn in the corpus retains its wrapper instead of lowering.
test fn nfbcp_falsifier_generic_fn_return_type_holds() -> Bool {
  match nfbcp_return_atom(text: nfbcp_generic_fn_source) {
    Absent => false
    Present { value: id } => id == ^T
  }
}

// FALSIFIER: the `= expr` body arm sits at the same spine depth as the braced body, so the
// return clause must read identically through it.
test fn nfbcp_falsifier_eq_body_fn_return_type_holds() -> Bool {
  match nfbcp_return_atom(text: nfbcp_eq_body_fn_source) {
    Absent => false
    Present { value: id } => id == ^dag_binding_type_int
  }
}

test fn nfbcp_generic_fn_specimen_parses_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_generic_fn_source) {
    Absent => false
    Present { value: _ } => true
  }
}

test fn nfbcp_eq_body_specimen_parses_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_eq_body_fn_source) {
    Absent => false
    Present { value: _ } => true
  }
}

// SPECIMEN CONTROLS. Separate "no hazard" from "the specimen stopped parsing" -- without
// these, both reds above could go green by the fixture ceasing to compile.
test fn nfbcp_hazard_specimen_parses_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_fn_type_param_source) {
    Absent => false
    Present { value: _ } => true
  }
}

test fn nfbcp_no_return_type_specimen_parses_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_no_return_type_source) {
    Absent => false
    Present { value: _ } => true
  }
}

// ---------------------------------------------------------------------------
// MQ-4: THE DEEPEST RETENTION ROUTE, REFUSED AT ITS OWN LOCUS, END TO END.
//
// The retention above is minted at the deepest call site a module's normalize can reach:
// v2.compiler.normalize normalize_node_ctx -> body_lower_finish_for_normalize ->
// body_lower_after_children -> body_lower_production_emitted -> body_lower_forward_row_apply ->
// body_lower_fn_decl_to_arrow -> body_lower_fn_decl_to_arrow_admitted, whose signature arm answers
// body_lower_wrapper_retained_shell. Every frame on that chain now returns the typed BodyLowering, so
// the retention cannot be dropped by a `diagnostics: _` on the way up; normalize gathers it into its
// BodyLoweredTree and v2.compiler.normalized_tree admit_retention_free refuses it.
//
// This row runs that whole route on the real parse and asserts WHERE the refusal lands: under the
// door's cause, anchored at the fn_decl shell that was retained -- not at the module root, where the
// pre-MQ-4 door placed its single diagnostic. Deleting the door's refusal arm (admitting every tree)
// turns normalize Accepted and reds it. A door refusing everything is caught by the normalize-accepts
// rows that already run the same route (v2.test.manual.body_lowering_normalize_add
// body_lowering_normalize_accepts, v2.test.claim.body_lowering.data_initializer_fn_value
// lambda_in_fn_body_control_holds), so this row adds no second parse for a positive control.
//
// The specimen is the smallest module whose fn declaration reaches the signature arm with no return
// type -- the whole parse and normalize is this row's cost, so it carries nothing else.
data nfbcp_retention_route_source: String = "module m\nfn g() { true }\n"
fn nfbcp_retention_anchored_at_fn_decl(d: Diagnostic) -> Bool {
  match d.at {
    NodeLocus { anchor: a } =>
      match parse_production_emitted_identity_optional(node: a.at) {
        Present { value: id } => id == ^dag_surface_fn_decl
        Absent => false
      }
    _ => false
  }
}

fn nfbcp_is_door_retention(d: Diagnostic) -> Bool {
  d.reason == ^normalized_tree_reason_wrapper_retention_not_normalized
}

test fn nfbcp_retention_refuses_at_the_retained_fn_decl_through_normalize_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_retention_route_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: ne } =>
          fold(ne.tail, init: nfbcp_is_door_retention(d: ne.head) && nfbcp_retention_anchored_at_fn_decl(d: ne.head), f: fn(found, d) {
            found || (nfbcp_is_door_retention(d: d) && nfbcp_retention_anchored_at_fn_decl(d: d))
          })
      }
  }
}

// ---------------------------------------------------------------------------
// A REPEATED PARAMETER BINDING REFUSES AT THE SECOND BINDING, NOT AT THE MODULE ROOT.
//
// The Arrow domain is a Conj keyed by binding name, so a repeated binding has no well-formed domain.
// Before v2.compiler.body_lowering_fold body_lower_fn_signature_bindings_refusal the lowering built
// that Conj and normalize's recursive well_formed gate refused the module with
// normalize_reason_post_normalize_not_well_formed at the module root (gen-two census:
// std.key_relation global_key_scope_eq, provider_readiness_independence_claim). These rows run the
// real parse and normalize route and assert the cause and that the locus is the SECOND binding's
// type (B; the first is A). Answering optional_absent from the bindings arm restores the
// ill-formed domain and reds both refusal rows; the distinct-name spelling is the positive control.
// A repeated `_` is its own cause: a v2-behind-v1 frontier (v1 admits it), not an authoring error.
data nfbcp_anonymous_repeat_source: String = "module m\nfn g(_: A, _: B) -> Bool { true }\n"
data nfbcp_named_repeat_source: String = "module m\nfn g(a: A, a: B) -> Bool { true }\n"
data nfbcp_distinct_binding_source: String = "module m\nfn g(a: A, b: B) -> Bool { true }\n"

fn nfbcp_locus_is_atom(d: Diagnostic, atom: Symbol) -> Bool {
  match d.at {
    NodeLocus { anchor: a } =>
      match node_atom_identity_optional(node: a.at) {
        Present { value: id } => id == atom
        Absent => false
      }
    _ => false
  }
}

fn nfbcp_normalize_refuses_with(text: String, reason: Symbol, atom: Symbol) -> Bool {
  match nfbcp_parsed(text: text) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: ne } =>
          fold(ne.tail, init: (ne.head.reason == reason) && nfbcp_locus_is_atom(d: ne.head, atom: atom), f: fn(found, d) {
            found || ((d.reason == reason) && nfbcp_locus_is_atom(d: d, atom: atom))
          })
      }
  }
}

test fn nfbcp_repeated_anonymous_param_refuses_at_the_second_binding_holds() -> Bool {
  nfbcp_normalize_refuses_with(
    text: nfbcp_anonymous_repeat_source,
    reason: ^body_lowering_reason_arrow_domain_anonymous_param_repeated,
    atom: ^B
  )
}

test fn nfbcp_repeated_named_param_refuses_at_the_second_binding_holds() -> Bool {
  nfbcp_normalize_refuses_with(
    text: nfbcp_named_repeat_source,
    reason: ^body_lowering_reason_arrow_domain_param_binding_repeated,
    atom: ^B
  )
}

test fn nfbcp_distinct_param_bindings_normalize_positive_control_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_distinct_binding_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}

// A REPEATED DECLARATION NAME REFUSES AT THE GRAFT, AT THE SECOND DECLARATION. The module body is a
// Conj keyed by declaration name; v2.compiler.namespace_graft module_header_containment_graft now
// refuses a repeated name (gen-two census: two `data fixture_v3_tick_wire` in the roadmap launch
// witness) instead of building a body the well_formed gate refuses at the root. The locus is the
// second declaration's member Arrow, whose return type is the discriminator (B; the first is A).
data nfbcp_repeated_decl_source: String = "module m\ndata x: A = 1\ndata x: B = 2\n"

fn nfbcp_locus_is_arrow_returning(d: Diagnostic, atom: Symbol) -> Bool {
  match d.at {
    NodeLocus { anchor: a } =>
      fold(a.at.children, init: false, f: fn(found, e) {
        found || (match node_atom_identity_optional(node: e.target) {
          Present { value: id } => id == atom
          Absent => false
        })
      })
    _ => false
  }
}

test fn nfbcp_repeated_declaration_refuses_at_the_second_declaration_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_repeated_decl_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: ne } =>
          fold(ne.tail, init: (ne.head.reason == ^namespace_graft_declaration_name_repeated) && nfbcp_locus_is_arrow_returning(d: ne.head, atom: ^B), f: fn(found, d) {
            found || ((d.reason == ^namespace_graft_declaration_name_repeated) && nfbcp_locus_is_arrow_returning(d: d, atom: ^B))
          })
      }
  }
}

// AN ANONYMOUS RECORD RETURN TYPE LOWERS; IT IS NOT RETAINED. `-> { success: B }` is a type expression
// whose captured is a field_decl_block. v2.compiler.body_lowering_fold
// body_lower_anonymous_record_type_optional reads it through the record declaration's own field-block
// reader, so the signature is readable and the fn lowers to an Arrow. Before that arm the reader
// answered Absent and the whole fn_decl was retained, refused by the normalized-tree door (gen-two
// census: gunbc.tools.cron_tag upsert_tagged_cron_tab). Deleting the arm restores the retention and
// normalize refuses, which reds this row.
data nfbcp_anonymous_record_return_source: String = "module m\nfn g() -> { success: B } { h() }\n"

test fn nfbcp_anonymous_record_return_type_lowers_through_normalize_holds() -> Bool {
  match nfbcp_parsed(text: nfbcp_anonymous_record_return_source) {
    Absent => false
    Present { value: tree } =>
      match normalize(parse_tree: tree) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
  }
}
