module test.claim.network_boot_manifest_broker_witness

import std.types { Bool, Int, List, NonEmptyStr, Secret, String }
import std.content_hash { ContentHash, content_hash_of_value }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.toolchain.types { Architecture, Aarch64, Wasm32 }
import extdeps.provisioning.network_boot { UefiHttpBoot }
import extdeps.crypto.mac { MacKey, MacKeyId, HmacSha256, mac_verification_from_implementation }
import gunbc.machine_intake_subject { UnitKey, IntakeAttemptId }
import gunbc.network_boot_delivery {
  SignedBootManifestIdentity,
  SignedBootManifestVerified,
  SignedBootManifestIdentified,
  SignedBootManifestVerificationRefused,
  SignedBootManifestAbsent,
  ManifestVerificationWrongArchitecture,
  ManifestVerificationReplay,
  ManifestVerificationExpired,
  ManifestVerificationNotYetValid,
  ManifestVerificationMac,
  ManifestVerificationVerifiedKey,
  ProductionTrustedBootstrap,
  ControlledNetworkBootstrap,
  BootstrapTrustUnestablished,
  BootstrapTrustStanding,
  BootstrapTrustObservation,
  bootstrap_trust_standing,
}
import gunbc.network_boot_manifest_broker {
  SignedBootManifestClaims,
  SignedBootManifestTicket,
  BootManifestIssued,
  BootManifestIssuanceRefused,
  ManifestIssuanceTrustUnestablished,
  ManifestIssuanceWindowInverted,
  ManifestIssuanceDhcpArchUnpublished,
  SpentAttemptNonce,
  BootstrapTrustRoot,
  BootManifestExpectation,
  BootManifestAuthentic,
  BootManifestRefused,
  issue_signed_boot_manifest,
  redeem_signed_boot_manifest,
  verify_signed_boot_manifest,
  signed_boot_manifest_signing_input,
  signed_boot_manifest_standing,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data standing_obs: DeclarationRef = DeclarationRef {
  module_path: "test.claim.network_boot_manifest_broker_witness",
  decl_name: "standing_obs",
  field: WholeDeclaration,
}

data broker_key_id: MacKeyId = "boot-manifest-key-0" as MacKeyId

data broker_key: MacKey = MacKey {
  id: broker_key_id,
  suite: HmacSha256,
  material: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f" as Secret,
}

data unit: UnitKey = "BRD-PXE-FABRIC-0D" as UnitKey
data attempt: IntakeAttemptId = "intake-pxe-fabric-0d" as IntakeAttemptId

fn chainloader() -> ContentHash { content_hash_of_value(value: "ipxe-aarch64-fixture") }
fn kernel() -> ContentHash { content_hash_of_value(value: "kernel-fixture") }
fn initrd() -> ContentHash { content_hash_of_value(value: "initrd-fixture") }
fn root() -> ContentHash { content_hash_of_value(value: "root-fixture") }

fn identity_for(target: UnitKey, arch: Architecture, root_digest: ContentHash, nbf: Int, exp: Int) -> SignedBootManifestIdentity {
  SignedBootManifestIdentity {
    target_unit: target,
    attempt_id: attempt,
    nonce: "nonce-0d",
    architecture: arch,
    boot_mode: UefiHttpBoot,
    chainloader_digest: chainloader(),
    kernel_digest: kernel(),
    initrd_digest: initrd(),
    root_digest: root_digest,
    kernel_cmdline: "console=ttyAMA0",
    not_before: nbf,
    expiry: exp,
    signing_key_identity: broker_key_id as NonEmptyStr,
    callback_identity: "intake-callback-0d",
  }
}

fn claims_for(id: SignedBootManifestIdentity) -> SignedBootManifestClaims {
  SignedBootManifestClaims { identity: id }
}

fn https_obs() -> BootstrapTrustObservation {
  BootstrapTrustObservation { observation: standing_obs, observed_at: 1788000000000 }
}

fn production_trust() -> BootstrapTrustStanding {
  ProductionTrustedBootstrap {
    firmware_https: Present { value: https_obs() },
    secure_boot_chainloader: none,
  }
}

fn issued_ticket(id: SignedBootManifestIdentity) -> SignedBootManifestTicket {
  match issue_signed_boot_manifest(
    claims: claims_for(id: id),
    key: broker_key,
    trust: production_trust(),
  ) {
    BootManifestIssued { ticket: t } => t
    BootManifestIssuanceRefused { cause: _ } =>
      SignedBootManifestTicket { claims: claims_for(id: id), tag_hex: "00" }
  }
}

fn expectation_when(spent: List<SpentAttemptNonce>, at: Int) -> BootManifestExpectation {
  BootManifestExpectation {
    trust: BootstrapTrustRoot { signing_key_id: broker_key_id, standing: production_trust() },
    spent_attempt_nonces: spent,
    redeemed_at: at,
  }
}

fn expectation_at(spent: List<SpentAttemptNonce>) -> BootManifestExpectation {
  expectation_when(spent: spent, at: 1788001800000)
}

fn identity_with_attempt_and_nonce(attempt_id: IntakeAttemptId, nonce: String) -> SignedBootManifestIdentity {
  let id = good_identity()
  SignedBootManifestIdentity {
    target_unit: id.target_unit,
    attempt_id: attempt_id,
    nonce: nonce,
    architecture: id.architecture,
    boot_mode: id.boot_mode,
    chainloader_digest: id.chainloader_digest,
    kernel_digest: id.kernel_digest,
    initrd_digest: id.initrd_digest,
    root_digest: id.root_digest,
    kernel_cmdline: id.kernel_cmdline,
    not_before: id.not_before,
    expiry: id.expiry,
    signing_key_identity: id.signing_key_identity,
    callback_identity: id.callback_identity,
  }
}

// The pair collides under a separator join (attempt_id ++ US ++ nonce is
// the same text for both), so it is red for any preimage that does not
// bind field boundaries independently of field content.
test fn claims_that_collide_under_a_separator_join_have_distinct_signing_inputs() -> Bool {
  let us = from_code_point(cp: 31)
  let a = identity_with_attempt_and_nonce(attempt_id: concat("intake", concat(us, "x")) as IntakeAttemptId, nonce: "n")
  let b = identity_with_attempt_and_nonce(attempt_id: "intake" as IntakeAttemptId, nonce: concat("x", concat(us, "n")))
  let separator_joined_a = join([a.attempt_id as String, a.nonce], us)
  let separator_joined_b = join([b.attempt_id as String, b.nonce], us)
  match signed_boot_manifest_signing_input(c: claims_for(id: a)) {
    Absent => false
    Present { value: pa } =>
      match signed_boot_manifest_signing_input(c: claims_for(id: b)) {
        Absent => false
        Present { value: pb } => separator_joined_a == separator_joined_b && pa != pb
      }
  }
}

fn good_identity() -> SignedBootManifestIdentity {
  identity_for(target: unit, arch: Aarch64, root_digest: root(), nbf: 1788000000000, exp: 1788003600000)
}

test fn issued_ticket_round_trips_through_the_real_mac() -> Bool {
  match redeem_signed_boot_manifest(
    ticket: issued_ticket(id: good_identity()),
    key: broker_key,
    expectation: expectation_at(spent: []),
  ) {
    BootManifestAuthentic { claims: c } => c.identity.target_unit == unit
    BootManifestRefused { class: _ } => false
  }
}

test fn replayed_attempt_nonce_is_refused() -> Bool {
  let spent: List<SpentAttemptNonce> = [SpentAttemptNonce { attempt_id: attempt, nonce: "nonce-0d" }]
  match redeem_signed_boot_manifest(
    ticket: issued_ticket(id: good_identity()),
    key: broker_key,
    expectation: expectation_at(spent: spent),
  ) {
    BootManifestRefused { class: c } => c == ManifestVerificationReplay
    BootManifestAuthentic { claims: _ } => false
  }
}

test fn redemption_at_expiry_is_refused() -> Bool {
  match redeem_signed_boot_manifest(
    ticket: issued_ticket(id: good_identity()),
    key: broker_key,
    expectation: expectation_when(spent: [], at: 1788003600000),
  ) {
    BootManifestRefused { class: c } => c == ManifestVerificationExpired
    BootManifestAuthentic { claims: _ } => false
  }
}

test fn redemption_before_not_before_is_refused() -> Bool {
  match redeem_signed_boot_manifest(
    ticket: issued_ticket(id: good_identity()),
    key: broker_key,
    expectation: expectation_when(spent: [], at: 1787999999999),
  ) {
    BootManifestRefused { class: c } => c == ManifestVerificationNotYetValid
    BootManifestAuthentic { claims: _ } => false
  }
}

test fn bad_signature_is_refused() -> Bool {
  let good = issued_ticket(id: good_identity())
  let forged = SignedBootManifestTicket { claims: good.claims, tag_hex: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" }
  match redeem_signed_boot_manifest(
    ticket: forged,
    key: broker_key,
    expectation: expectation_at(spent: []),
  ) {
    BootManifestRefused { class: c } => c == ManifestVerificationMac
    BootManifestAuthentic { claims: _ } => false
  }
}

test fn unpublished_dhcp_architecture_refuses_issuance() -> Bool {
  match issue_signed_boot_manifest(
    claims: claims_for(id: identity_for(target: unit, arch: Wasm32, root_digest: root(), nbf: 1788000000000, exp: 1788003600000)),
    key: broker_key,
    trust: production_trust(),
  ) {
    BootManifestIssuanceRefused { cause: c } =>
      match c {
        ManifestIssuanceDhcpArchUnpublished => true
        _ => false
      }
    BootManifestIssued { ticket: _ } => false
  }
}

test fn inverted_window_refuses_issuance() -> Bool {
  match issue_signed_boot_manifest(
    claims: claims_for(id: identity_for(target: unit, arch: Aarch64, root_digest: root(), nbf: 1788003600000, exp: 1788000000000)),
    key: broker_key,
    trust: production_trust(),
  ) {
    BootManifestIssuanceRefused { cause: c } =>
      match c {
        ManifestIssuanceWindowInverted { not_before: _, expiry: _ } => true
        _ => false
      }
    BootManifestIssued { ticket: _ } => false
  }
}

test fn unestablished_trust_refuses_issuance() -> Bool {
  match issue_signed_boot_manifest(
    claims: claims_for(id: good_identity()),
    key: broker_key,
    trust: BootstrapTrustUnestablished,
  ) {
    BootManifestIssuanceRefused { cause: c } =>
      match c {
        ManifestIssuanceTrustUnestablished => true
        _ => false
      }
    BootManifestIssued { ticket: _ } => false
  }
}

test fn a_mac_verified_under_a_different_key_than_the_pinned_root_is_refused() -> Bool {
  let claims = claims_for(id: good_identity())
  let other_key_id: MacKeyId = "boot-manifest-impostor" as MacKeyId
  let ticket = SignedBootManifestTicket { claims: claims, tag_hex: "00" }
  match signed_boot_manifest_signing_input(c: claims) {
    Absent => false
    Present { value: presented } =>
      match verify_signed_boot_manifest(
        ticket: ticket,
        expectation: expectation_at(spent: []),
        mac_result: mac_verification_from_implementation(
          key_id: other_key_id,
          suite: HmacSha256,
          message: presented,
          implementation_verified: true,
        ),
      ) {
        BootManifestRefused { class: c } => c == ManifestVerificationVerifiedKey
        BootManifestAuthentic { claims: _ } => false
      }
  }
}

test fn issued_ticket_standing_is_verified() -> Bool {
  match signed_boot_manifest_standing(
    verification: redeem_signed_boot_manifest(
      ticket: issued_ticket(id: good_identity()),
      key: broker_key,
      expectation: expectation_at(spent: []),
    ),
    observation: standing_obs,
    observed_at: 1788001800000,
  ) {
    SignedBootManifestVerified { identity: id, observation: _, observed_at: _ } =>
      id.target_unit == unit
    SignedBootManifestIdentified { identity: _, observation: _, observed_at: _ } => false
    SignedBootManifestVerificationRefused { observation: _, observed_at: _, class: _ } => false
    SignedBootManifestAbsent => false
  }
}

test fn controlled_network_bootstrap_is_not_production_trust() -> Bool {
  match bootstrap_trust_standing(
    firmware_https: none,
    secure_boot_chainloader: none,
    isolated_onboarding_network: Present { value: https_obs() },
  ) {
    ControlledNetworkBootstrap { evidence: _ } =>
      match bootstrap_trust_standing(
        firmware_https: Present { value: https_obs() },
        secure_boot_chainloader: none,
        isolated_onboarding_network: Present { value: https_obs() },
      ) {
        ProductionTrustedBootstrap { firmware_https: _, secure_boot_chainloader: _ } => true
        ControlledNetworkBootstrap { evidence: _ } => false
        BootstrapTrustUnestablished => false
      }
    ProductionTrustedBootstrap { firmware_https: _, secure_boot_chainloader: _ } => false
    BootstrapTrustUnestablished => false
  }
}
