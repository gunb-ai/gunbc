module test.claim.static_resource_envelope

import std.logic { Bool }
import std.measure { byte_size, disk_size, hardware_thread_count, watt }
import std.static_resource_envelope {
  StaticPeakDemand,
  ResourceCap,
  MemoryAxis,
  ComputeAxis,
  StorageAxis,
  StaticDerived,
  Fixture,
  zero_demand,
  demand_admitted_for_production,
  derive_spawn_width,
  envelope_reconciled,
}

fn synthetic_cap_memory_binds() -> ResourceCap {
  ResourceCap {
    memory: byte_size(10000000000),
    compute: hardware_thread_count(128),
    storage: disk_size(1000000000000),
    energy: watt(0)
  }
}

fn synthetic_per_shard_memory_binds() -> StaticPeakDemand {
  StaticPeakDemand {
    memory: byte_size(3000000000),
    compute: hardware_thread_count(1),
    storage: disk_size(100000000),
    energy: watt(0),
    provenance: StaticDerived
  }
}

fn witness_memory_axis_binds_width() -> Bool {
  let verdict = derive_spawn_width(
    cap: synthetic_cap_memory_binds(),
    base: zero_demand(),
    per_shard: synthetic_per_shard_memory_binds(),
    shard_demand: 128
  )
  verdict.width == 3
}

fn witness_memory_axis_reported_as_binding() -> Bool {
  let verdict = derive_spawn_width(
    cap: synthetic_cap_memory_binds(),
    base: zero_demand(),
    per_shard: synthetic_per_shard_memory_binds(),
    shard_demand: 128
  )
  match verdict.binding_axis {
    MemoryAxis => true
    ComputeAxis => false
    StorageAxis => false
    _ => false
  }
}

fn witness_shrinking_cap_lowers_width() -> Bool {
  let wide = derive_spawn_width(
    cap: synthetic_cap_memory_binds(),
    base: zero_demand(),
    per_shard: synthetic_per_shard_memory_binds(),
    shard_demand: 128
  )
  let tight_cap = ResourceCap {
    memory: byte_size(4000000000),
    compute: hardware_thread_count(128),
    storage: disk_size(1000000000000),
    energy: watt(0)
  }
  let narrow = derive_spawn_width(
    cap: tight_cap,
    base: zero_demand(),
    per_shard: synthetic_per_shard_memory_binds(),
    shard_demand: 128
  )
  narrow.width < wide.width
}

fn witness_compute_axis_can_bind() -> Bool {
  let cap = ResourceCap {
    memory: byte_size(1000000000000),
    compute: hardware_thread_count(2),
    storage: disk_size(1000000000000),
    energy: watt(0)
  }
  let per_shard = StaticPeakDemand {
    memory: byte_size(1000000),
    compute: hardware_thread_count(1),
    storage: disk_size(1000000),
    energy: watt(0),
    provenance: StaticDerived
  }
  let verdict = derive_spawn_width(cap: cap, base: zero_demand(), per_shard: per_shard, shard_demand: 128)
  verdict.width == 2
    && match verdict.binding_axis {
      ComputeAxis => true
      _ => false
    }
}

fn witness_zero_demand_axis_is_unconstrained() -> Bool {
  let cap = ResourceCap {
    memory: byte_size(10000000000),
    compute: hardware_thread_count(128),
    storage: disk_size(1000000000000),
    energy: watt(0)
  }
  let verdict = derive_spawn_width(
    cap: cap,
    base: zero_demand(),
    per_shard: synthetic_per_shard_memory_binds(),
    shard_demand: 128
  )
  match verdict.binding_axis {
    StorageAxis => false
    _ => true
  } && verdict.width == 3
}

fn witness_nonzero_base_lowers_width() -> Bool {
  let cap = synthetic_cap_memory_binds()
  let per_shard = synthetic_per_shard_memory_binds()
  let with_zero_base = derive_spawn_width(cap: cap, base: zero_demand(), per_shard: per_shard, shard_demand: 128)
  let heavy_base = StaticPeakDemand {
    memory: byte_size(4000000000),
    compute: hardware_thread_count(0),
    storage: disk_size(0),
    energy: watt(0),
    provenance: StaticDerived
  }
  let with_heavy_base = derive_spawn_width(cap: cap, base: heavy_base, per_shard: per_shard, shard_demand: 128)
  with_heavy_base.width < with_zero_base.width
}

fn witness_reconciled_true_at_derived_width() -> Bool {
  let cap = synthetic_cap_memory_binds()
  let per_shard = synthetic_per_shard_memory_binds()
  envelope_reconciled(cap: cap, base: zero_demand(), per_shard: per_shard, scheduled_width: 3)
}

fn witness_reconciled_false_over_scheduled_width() -> Bool {
  let cap = synthetic_cap_memory_binds()
  let per_shard = synthetic_per_shard_memory_binds()
  !envelope_reconciled(cap: cap, base: zero_demand(), per_shard: per_shard, scheduled_width: 4)
}

fn witness_reconciled_flips_red_when_per_shard_inflates_at_fixed_width() -> Bool {
  let cap = synthetic_cap_memory_binds()
  let modest = synthetic_per_shard_memory_binds()
  let inflated = StaticPeakDemand {
    memory: byte_size(4000000000),
    compute: hardware_thread_count(1),
    storage: disk_size(100000000),
    energy: watt(0),
    provenance: StaticDerived
  }
  envelope_reconciled(cap: cap, base: zero_demand(), per_shard: modest, scheduled_width: 3)
    && !envelope_reconciled(cap: cap, base: zero_demand(), per_shard: inflated, scheduled_width: 3)
}

fn witness_fixture_provenance_refused_for_production() -> Bool {
  let fixture_demand = StaticPeakDemand {
    memory: byte_size(1),
    compute: hardware_thread_count(1),
    storage: disk_size(1),
    energy: watt(0),
    provenance: Fixture
  }
  demand_admitted_for_production(demand: zero_demand()) == true
    && demand_admitted_for_production(demand: fixture_demand) == false
}

test fn static_resource_envelope_holds() -> Bool {
  witness_memory_axis_binds_width()
    && witness_memory_axis_reported_as_binding()
    && witness_shrinking_cap_lowers_width()
    && witness_compute_axis_can_bind()
    && witness_zero_demand_axis_is_unconstrained()
    && witness_nonzero_base_lowers_width()
    && witness_reconciled_true_at_derived_width()
    && witness_reconciled_false_over_scheduled_width()
    && witness_reconciled_flips_red_when_per_shard_inflates_at_fixed_width()
    && witness_fixture_provenance_refused_for_production()
}
