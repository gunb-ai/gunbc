module test.claim.harness_shell_job

import std.types { Bool, String, List, FilePath, NonEmptyStr, Int, Timestamp }
import std.measure { Second, second }
import extdeps.posix.process { ProcessGroupLeader, process_group_leader }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.harness.harness_shell_job {
  HarnessShellJob, HarnessShellJobState, JobFinished, harness_job_backstop_standing, JobExitedOutcome,
  harness_kept_stdio_path, harness_stdio_move_note,
  HarnessTerminateProcessGroup, harness_kill_signal_note,
  harness_exit_is_harness_backstop, harness_command_table_exit_label,
  harness_backstop_standing, JobBackstopHit, JobOwnExit, JobBackstopUndecided,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn unknown_elapsed() -> Second? {
  none
}

fn fixture_job(state: HarnessShellJobState) -> HarnessShellJob {
  HarnessShellJob {
    id: "42",
    pid: 42,
    command: "sleep 1",
    stdout_file: "/tmp/job-42.out" as FilePath,
    stderr_file: "/tmp/job-42.err" as FilePath,
    stdio_note: "",
    started_at: "1970-01-01T00:00:00Z" as Timestamp,
    backstop: second(count: 20),
    state: state,
  }
}

test fn an_unconfirmed_kill_carries_the_terminate_stderr() -> Bool {
  harness_kill_signal_note(
    signaled: HarnessTerminateProcessGroup {
      success: false,
      stderr: "kill: (-9): Operation not permitted",
    },
  ).contains("Operation not permitted")
    && harness_kill_signal_note(
      signaled: HarnessTerminateProcessGroup { success: true, stderr: "" },
    ) == ""
}

test fn a_124_at_the_backstop_is_duration_exceeded_and_a_124_inside_it_is_not() -> Bool {
  let job = fixture_job(state: JobFinished { outcome: JobExitedOutcome { code: 124 }, elapsed_at_reap: none })
  harness_exit_is_harness_backstop(code: 124, elapsed: second(count: 20), backstop: second(count: 20))
    && !harness_exit_is_harness_backstop(code: 124, elapsed: second(count: 1), backstop: second(count: 20))
    && !harness_exit_is_harness_backstop(code: 0, elapsed: second(count: 20), backstop: second(count: 20))
    && harness_command_table_exit_label(job: job, code: 124, standing: JobBackstopHit).contains("duration exceeded")
    && !harness_command_table_exit_label(job: job, code: 124, standing: JobBackstopHit).contains("exit 124")
    && harness_command_table_exit_label(job: job, code: 124, standing: JobOwnExit).contains("exit 124")
}

test fn a_failed_stdio_rename_keeps_the_mktemp_path_and_says_so() -> Bool {
  let pending = "/tmp/pending-out" as FilePath
  let dest = "/tmp/job-9.out" as FilePath
  harness_kept_stdio_path(pending: pending, dest: dest, moved: true) == dest
    && harness_kept_stdio_path(pending: pending, dest: dest, moved: false) == pending
    && harness_stdio_move_note(
      moved_out: false,
      moved_err: true,
      pending_out: pending,
      pending_err: "/tmp/pending-err" as FilePath,
    ).contains("mktemp paths")
}

test fn a_124_whose_elapsed_time_is_unknown_is_undecided_not_guessed() -> Bool {
  let job = fixture_job(state: JobFinished { outcome: JobExitedOutcome { code: 124 }, elapsed_at_reap: none })
  (match harness_backstop_standing(code: 124, elapsed: unknown_elapsed(), backstop: second(count: 20)) {
    JobBackstopUndecided => true
    JobBackstopHit => false
    JobOwnExit => false
  })
    && harness_command_table_exit_label(job: job, code: 124, standing: JobBackstopUndecided).contains("backstop undecided")
    && (match harness_backstop_standing(code: 0, elapsed: unknown_elapsed(), backstop: second(count: 20)) {
      JobOwnExit => true
      JobBackstopHit => false
      JobBackstopUndecided => false
    })
}

fn leader_is_absent(spawned_pid: Int) -> Bool {
  match process_group_leader(spawned_pid: spawned_pid) {
    Absent => true
    Present { value: _ } => false
  }
}

// kill(2): -1 signals every process the caller may signal, 0 the caller's own group. Only a pid the
// spawn lifecycle could have minted as a group leader (above 1) becomes a ProcessGroupLeader; the
// group signal takes that type, so the unsafe pids have no route to the argv.
test fn a_group_signal_has_no_route_from_pid_1_0_or_a_negative_pid() -> Bool {
  leader_is_absent(spawned_pid: 1)
    && leader_is_absent(spawned_pid: 0)
    && leader_is_absent(spawned_pid: -5)
    && (match process_group_leader(spawned_pid: 42) {
      Present { value: leader } => leader.pgid as String == "42"
      Absent => false
    })
}

// The standing of a FINISHED job reads the elapsed time stored at reap, never the clock at render: the
// fixture's started_at is 1970, so a live read would be decades and every 124 would read as the backstop.
test fn a_finished_jobs_standing_is_the_stored_elapsed_not_the_clock_at_render() -> Bool {
  let early = fixture_job(
    state: JobFinished { outcome: JobExitedOutcome { code: 124 }, elapsed_at_reap: Present { value: second(count: 10) } },
  )
  let late = fixture_job(
    state: JobFinished { outcome: JobExitedOutcome { code: 124 }, elapsed_at_reap: Present { value: second(count: 20) } },
  )
  (match harness_job_backstop_standing(job: early, code: 124) {
    JobOwnExit => true
    JobBackstopHit => false
    JobBackstopUndecided => false
  })
    && (match harness_job_backstop_standing(job: late, code: 124) {
      JobBackstopHit => true
      JobOwnExit => false
      JobBackstopUndecided => false
    })
}
