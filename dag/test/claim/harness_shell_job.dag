module test.claim.harness_shell_job

import std.types { Bool, String, List, FilePath, NonEmptyStr, Int, Timestamp }
import std.optional { Present }
import std.measure {
  Second, second, minute, minute_count, measure_sub, MeasureDifference, MeasureSubtrahendExceedsMinuend,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.languages.json.emit { json_object, json_kv, json_string, json_int }
import gunbc.harness.harness_wire { WireToolUseBlock }
import extdeps.posix.process { ProcessReapOutcome, StillRunning, Exited }
import gunbc.harness.harness_shell_job {
  HarnessShellJob,
  harness_hand_in_blocked_by_running_jobs,
  StdioAtDestination, StdioKeptAtPending, harness_job_stdio_after_move, harness_job_stdio_path_of, harness_job_stdio_note,
  harness_kill_signal_note,
  harness_exit_is_harness_backstop, harness_command_table_exit_label,
  harness_backstop_standing, JobBackstopHit, JobOwnExit, JobBackstopUndecided,
  harness_elapsed_clock_resolution, ElapsedUnreadable, ElapsedWithinClockGrain,
}
import gunbc.harness.harness_shell_job_policy {
  WaitRequestedMinutes, WaitMalformedMinutes, WaitNonPositiveMinutes, WaitUseDefault, WaitPaceReset,
}
import gunbc.harness.harness_tool {
  harness_wait_request_from_block, harness_kill_job, harness_tool_environment,
  harness_env_with_jobs, harness_outcome_text, harness_job_output_for_state,
  harness_text_with_table, harness_job_backstop_exit_outcome,
  ToolRefused, ToolCompleted, ToolReport, ToolJob, OutputComplete,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn unknown_elapsed() -> Second? {
  none
}

fn fixture_job(reaped: ProcessReapOutcome, elapsed: Second?) -> HarnessShellJob {
  HarnessShellJob {
    id: "42",
    pid: 42,
    command: "sleep 1",
    stdout: StdioAtDestination { path: "/tmp/job-42.out" as FilePath },
    stderr: StdioAtDestination { path: "/tmp/job-42.err" as FilePath },
    started_at: "1970-01-01T00:00:00Z" as Timestamp,
    backstop: second(count: 20),
    reaped: reaped,
    elapsed: elapsed,
  }
}

fn fixture_running() -> HarnessShellJob {
  fixture_job(reaped: StillRunning, elapsed: none)
}

fn fixture_finished(code: Int, elapsed: Second?) -> HarnessShellJob {
  fixture_job(reaped: Exited { code: code }, elapsed: elapsed)
}

fn fixture_own_exit(code: Int) -> HarnessShellJob {
  fixture_finished(code: code, elapsed: Present { value: second(count: 0) })
}

test fn hand_in_refuses_while_a_job_is_running() -> Bool {
  match harness_hand_in_blocked_by_running_jobs(jobs: [fixture_running()]) {
    Absent => false
    Present { value: text } => text.contains("wait or job_kill")
  }
    && (match harness_hand_in_blocked_by_running_jobs(
      jobs: [fixture_own_exit(code: 0)],
    ) {
      Absent => true
      Present { value: _ } => false
    })
}

test fn job_kill_refuses_a_finished_job_by_name() -> Bool {
  let env = harness_tool_environment(
    working_directory: "/tmp" as FilePath,
    timeout_program: "/usr/bin/timeout" as FilePath,
    job_output_directory: "/tmp" as FilePath,
  )
  let with_job = harness_env_with_jobs(
    environment: env,
    jobs: [fixture_own_exit(code: 0)],
    wait_pace: WaitPaceReset,
  )
  let step = harness_kill_job(environment: with_job, id: "42")
  match step.outcome {
    ToolRefused { disposition: _ } => harness_outcome_text(outcome: step.outcome).contains("has finished")
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolJob { id: _, text: _ } => false
  }
}

test fn a_malformed_wait_minutes_member_keeps_the_parse_cause() -> Bool {
  match harness_wait_request_from_block(block: WireToolUseBlock {
    id: "u1",
    name: "wait",
    input: json_object([json_kv(key: "minutes", value: json_string(s: "soon"))]),
  }) {
    WaitMalformedMinutes { cause } => cause.contains("string where a number")
    WaitUseDefault => false
    WaitRequestedMinutes { minutes: _ } => false
    WaitNonPositiveMinutes { asked_wire: _ } => false
  }
}

test fn wait_minutes_from_the_wire_are_a_minute_carrier() -> Bool {
  match harness_wait_request_from_block(block: WireToolUseBlock {
    id: "u1",
    name: "wait",
    input: json_object([json_kv(key: "minutes", value: json_int(n: 5))]),
  }) {
    WaitRequestedMinutes { minutes } => minute_count(m: minutes) == 5
    WaitUseDefault => false
    WaitMalformedMinutes { cause: _ } => false
    WaitNonPositiveMinutes { asked_wire: _ } => false
  }
    && (match harness_wait_request_from_block(block: WireToolUseBlock {
      id: "u2",
      name: "wait",
      input: json_object([json_kv(key: "minutes", value: json_int(n: 0))]),
    }) {
      WaitNonPositiveMinutes { asked_wire } => asked_wire == 0
      WaitUseDefault => false
      WaitMalformedMinutes { cause: _ } => false
      WaitRequestedMinutes { minutes: _ } => false
    })
    && (match harness_wait_request_from_block(block: WireToolUseBlock {
      id: "u3",
      name: "wait",
      input: json_object([json_kv(key: "minutes", value: json_int(n: 0 - 3))]),
    }) {
      WaitNonPositiveMinutes { asked_wire } => asked_wire == 0 - 3
      WaitUseDefault => false
      WaitMalformedMinutes { cause: _ } => false
      WaitRequestedMinutes { minutes: _ } => false
    })
}

test fn an_unconfirmed_kill_carries_the_terminate_stderr() -> Bool {
  harness_kill_signal_note(success: false, stderr: "kill: (-9): Operation not permitted").contains("Operation not permitted")
    && harness_kill_signal_note(success: true, stderr: "") == ""
}

test fn job_output_of_a_finished_exit_3_job_does_not_say_exit_0() -> Bool {
  let job = fixture_own_exit(code: 3)
  let outcome = harness_job_output_for_state(job: job, jobs: [job], text: "from-job")
  let text = harness_outcome_text(outcome: outcome)
  match outcome {
    ToolCompleted { text: _, exit_code, standing: _ } =>
      exit_code == 3 && text.contains("[exit 3]") && !text.contains("[exit 0]")
    ToolRefused { disposition: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolJob { id: _, text: _ } => false
  }
}

test fn job_output_of_a_running_job_is_not_an_exit() -> Bool {
  let job = fixture_running()
  match harness_job_output_for_state(job: job, jobs: [job], text: "so-far") {
    ToolJob { id, text } => id == "42" && text.contains("so-far")
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolRefused { disposition: _ } => false
  }
}

test fn wait_result_over_a_job_that_exited_1_does_not_say_exit_0() -> Bool {
  let job = fixture_own_exit(code: 1)
  let text = harness_outcome_text(outcome: harness_text_with_table(
    text: "a job finished before the wait elapsed",
    jobs: [job],
  ))
  text.contains("exit 1") && !text.contains("[exit 0]") && !text.contains("[exit 1]")
}

test fn a_124_at_the_backstop_is_duration_exceeded_and_a_124_inside_it_is_not() -> Bool {
  let job = fixture_finished(code: 124, elapsed: Present { value: second(count: 20) })
  harness_exit_is_harness_backstop(code: 124, elapsed: second(count: 20), backstop: second(count: 20))
    && !harness_exit_is_harness_backstop(code: 124, elapsed: second(count: 1), backstop: second(count: 20))
    && !harness_exit_is_harness_backstop(code: 0, elapsed: second(count: 20), backstop: second(count: 20))
    && harness_command_table_exit_label(job: job, code: 124, standing: JobBackstopHit).contains("duration exceeded")
    && !harness_command_table_exit_label(job: job, code: 124, standing: JobBackstopHit).contains("exit 124")
    && harness_command_table_exit_label(job: job, code: 124, standing: JobOwnExit).contains("exit 124")
}

test fn a_124_whose_elapsed_time_is_unknown_refuses_rather_than_guessing() -> Bool {
  let standing = harness_backstop_standing(
    code: 124,
    elapsed: unknown_elapsed(),
    backstop: second(count: 20),
  )
  let job = fixture_finished(code: 124, elapsed: Present { value: second(count: 20) })
  let outcome = harness_job_backstop_exit_outcome(
    job: job,
    code: 124,
    standing: standing,
    completed: ToolCompleted { text: "from-job", exit_code: 124, standing: OutputComplete },
  )
  let text = harness_outcome_text(outcome: outcome)
  match standing {
    JobBackstopUndecided { cause } =>
      match cause {
        ElapsedUnreadable => true
        ElapsedWithinClockGrain => false
      }
    JobBackstopHit => false
    JobOwnExit => false
  }
    && match outcome {
      ToolRefused { disposition: _ } =>
        text.contains("could not be read") && text.contains("backstop cannot be decided")
          && !text.contains("[exit 124]") && !text.contains("exceeded the shell-job backstop")
      ToolCompleted { text: _, exit_code: _, standing: _ } => false
      ToolReport { text: _, standing: _ } => false
      ToolJob { id: _, text: _ } => false
    }
    && harness_command_table_exit_label(
      job: job,
      code: 124,
      standing: JobBackstopUndecided { cause: ElapsedUnreadable },
    ).contains("backstop undecided")
    && match harness_backstop_standing(
      code: 0,
      elapsed: unknown_elapsed(),
      backstop: second(count: 20),
    ) {
      JobOwnExit => true
      JobBackstopHit => false
      JobBackstopUndecided { cause: _ } => false
    }
}

test fn a_124_one_clock_second_shy_of_the_backstop_is_not_the_commands_own_exit() -> Bool {
  let backstop = second(count: 20)
  match measure_sub(a: backstop, b: harness_elapsed_clock_resolution) {
    MeasureSubtrahendExceedsMinuend => false
    MeasureDifference { value: shy } =>
      match harness_backstop_standing(
        code: 124,
        elapsed: Present { value: shy },
        backstop: backstop,
      ) {
        JobBackstopUndecided { cause } =>
          match cause {
            ElapsedWithinClockGrain => true
            ElapsedUnreadable => false
          }
        JobOwnExit => false
        JobBackstopHit => false
      }
        && match measure_sub(a: shy, b: harness_elapsed_clock_resolution) {
          MeasureSubtrahendExceedsMinuend => false
          MeasureDifference { value: below } =>
            match harness_backstop_standing(
              code: 124,
              elapsed: Present { value: below },
              backstop: backstop,
            ) {
              JobOwnExit => true
              JobBackstopHit => false
              JobBackstopUndecided { cause: _ } => false
            }
        }
  }
}

// A FAILED RENAME IS A TYPED LOCATION, AND THE READER FOLLOWS IT (review 80277): the kept stream's path is the
// pending one, the moved stream's is its destination, and the note is rendered from those values.
test fn a_failed_stdio_rename_keeps_the_mktemp_path_and_says_so() -> Bool {
  let pending = "/tmp/pending-out" as FilePath
  let dest = "/tmp/job-9.out" as FilePath
  let kept = harness_job_stdio_after_move(pending: pending, dest: dest, moved: false)
  let moved = harness_job_stdio_after_move(pending: "/tmp/pending-err" as FilePath, dest: "/tmp/job-9.err" as FilePath, moved: true)
  let job = HarnessShellJob {
    id: "9",
    pid: 9,
    command: "true",
    stdout: kept,
    stderr: moved,
    started_at: "1970-01-01T00:00:00Z" as Timestamp,
    backstop: second(count: 20),
    reaped: StillRunning,
    elapsed: none,
  }
  harness_job_stdio_path_of(stdio: kept) == pending
    && harness_job_stdio_path_of(stdio: moved) == ("/tmp/job-9.err" as FilePath)
    && (match kept { StdioKeptAtPending { path: _, intended: i } => i == dest  StdioAtDestination { path: _ } => false })
    && harness_job_stdio_note(job: job).contains("stdout kept at /tmp/pending-out")
    && !harness_job_stdio_note(job: job).contains("stderr")
    && harness_job_stdio_note(job: fixture_running()) == ""
}
