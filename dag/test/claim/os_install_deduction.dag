module test.claim.os_install_deduction


import extdeps.uri { Uri, Https }
import extdeps.os.ubuntu_autoinstall { NoCloudLocal, StoragePolicyDirectLayout, UbuntuAutoinstallPayload, AutoinstallSshServer, UserDataOnly, WithIdentity, AutoinstallIdentity }
import std.optional { Present, Absent }
import gunbc.os_install_deduction { AutoinstallIncompleteNotBootable, ForeignOsPresent, KvmOperatorAttestation, LoginPrompt, RequiresStoragePolicy, SubiquityStorageScreen, UnknownDiskState, fold_nbd_proxy_os_install_preflight_verdict, plan_for_os_install_preflight_verdict, runtime_verdict_from_kvm_attestation }
import gunbc.os_install_emit { autoinstall_user_data, AutoinstallUserDataRendered, AutoinstallUserDataRefused }
import std.types { Bool }
import std.live_tree { LiveTreeDisposition }
import gunbc.fleet.fleet_host_identity { operator_host_srv3 }
import gunbc.os_install { srv3_ubuntu_autoinstall, srv3_ubuntu_autoinstall_on_iso, srv4_ubuntu_autoinstall_on_iso }
import gunbc.fleet.fleet_ssh_access { fleet_authorized_keys }
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data witness_autoinstall_with_storage: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudLocal,
  fully_automated: true,
  target_distribution: srv3_ubuntu_autoinstall_on_iso.target_distribution,
  identity_posture: UserDataOnly { users: [] },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: [], password_auth: false } },
  storage_policy: StoragePolicyDirectLayout,
}

data witness_autoinstall_without_storage: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudLocal,
  fully_automated: true,
  target_distribution: srv3_ubuntu_autoinstall_on_iso.target_distribution,
  identity_posture: UserDataOnly { users: [] },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: [], password_auth: false } },
  storage_policy: StoragePolicyAbsent,
}

test fn srv3_on_iso_direct_layout_complete_for_unattended_on_foreign_disk() -> Bool {
  fold_nbd_proxy_os_install_preflight_verdict(
    payload: srv3_ubuntu_autoinstall_on_iso,
    disk: ForeignOsPresent,
  ) == CompleteForUnattended
    && match srv3_ubuntu_autoinstall_on_iso.storage_policy {
      StoragePolicyDirectLayout => true
      StoragePolicyAbsent => false
    }
}

test fn foreign_disk_without_storage_is_not_bootable() -> Bool {
  match fold_nbd_proxy_os_install_preflight_verdict(
    payload: witness_autoinstall_without_storage,
    disk: ForeignOsPresent,
  ) {
    AutoinstallIncompleteNotBootable => true
    CompleteForUnattended => false
    _ => false
  }
}

test fn unknown_disk_without_storage_needs_observation() -> Bool {
  fold_nbd_proxy_os_install_preflight_verdict(
    payload: witness_autoinstall_without_storage,
    disk: UnknownDiskState,
  ) == RequiresDiskObservation
}

test fn empty_disk_without_storage_requires_policy() -> Bool {
  fold_nbd_proxy_os_install_preflight_verdict(
    payload: witness_autoinstall_without_storage,
    disk: EmptyDisk,
  ) == RequiresStoragePolicy
}

test fn direct_layout_storage_is_complete_for_unattended() -> Bool {
  fold_nbd_proxy_os_install_preflight_verdict(
    payload: witness_autoinstall_with_storage,
    disk: ForeignOsPresent,
  ) == CompleteForUnattended
    && match witness_autoinstall_with_storage.storage_policy {
      StoragePolicyDirectLayout => true
      StoragePolicyAbsent => false
    }
}

test fn removing_storage_policy_flips_ready_to_boot_witness() -> Bool {
  match fold_nbd_proxy_os_install_preflight_verdict(
    payload: witness_autoinstall_without_storage,
    disk: ForeignOsPresent,
  ) {
    CompleteForUnattended => false
    _ => true
  }
    && match fold_nbd_proxy_os_install_preflight_verdict(
      payload: witness_autoinstall_with_storage,
      disk: ForeignOsPresent,
    ) {
      CompleteForUnattended => true
      _ => false
    }
}

test fn nocloud_net_seed_is_incomplete_for_actuator_path() -> Bool {
  let net_payload = UbuntuAutoinstallPayload {
    autoinstall_version: 1,
    delivery: NoCloudNet {
      seed_url: Uri {
        scheme: Https,
        locator: "install.srv3.lan/ubuntu-24.04/autoinstall/",
      },
    },
    fully_automated: true,
    target_distribution: srv3_ubuntu_autoinstall_on_iso.target_distribution,
    identity_posture: UserDataOnly { users: [] },
    locale: "en_US.UTF-8",
    keyboard_layout: "us",
    ssh: Present { value: AutoinstallSshServer { authorized_keys: [], password_auth: false } },
    storage_policy: StoragePolicyDirectLayout,
  }
  match fold_nbd_proxy_os_install_preflight_verdict(payload: net_payload, disk: EmptyDisk) {
    IncompleteSeedDelivery => true
    _ => false
  }
}

test fn requires_storage_policy_plans_remaster() -> Bool {
  match plan_for_os_install_preflight_verdict(
    verdict: RequiresStoragePolicy,
  ) {
    RemasterWithStoragePolicy => true
    _ => false
  }
}

test fn incomplete_not_bootable_plans_refuse_until_declared() -> Bool {
  match plan_for_os_install_preflight_verdict(
    verdict: AutoinstallIncompleteNotBootable,
  ) {
    RefuseUntilStoragePolicyDeclared => true
    _ => false
  }
}

test fn direct_layout_emits_storage_yaml() -> Bool {
  match autoinstall_user_data(payload: witness_autoinstall_with_storage) {
    AutoinstallUserDataRefused { reason: _ } => false
    AutoinstallUserDataRendered { content: ud } => ud.contains("layout:") && ud.contains("direct")
  }
}

// THE TWO KEY SPELLINGS, ONE PER ROUTE — pinned in bytes, not asserted.
// gunbc.os_install_emit writes an authorized key two ways and the ENTRY ROUTE decides, because the two routes
// ship the document somewhere with different rules: the key-only route's document is published on a public
// NoCloud volume, where the seed contract admits keytype+blob and no comment, while the identity route's goes
// to a hand-delivered volume (the Altra admin-password seed) that is never publicized. Canonicalizing the
// identity route too would have stripped the comments off documents LIVE INSTALLS consume, with nothing
// recording it (DESIGN.md §4b).
//
// THE SPLIT THIS WITNESS NOW PINS BOTH WAYS: srv3's and srv4's live autoinstalls took the key-only route when
// their committed password hashes were deleted (dashboard node adhoc-dfa3a487), so THEY must render the
// canonical spelling — an uncommented key line in their bytes is now a bug this test fails on. The identity
// route still exists for the admin-password seed, so its commented spelling stays pinned below against a local
// fixture, not against a live payload: the live documents have no identity to pin anymore. The expected lines
// are literals on purpose — a witness that calls the renderer to produce its own expectation checks nothing.
fn renders_key_line(payload: UbuntuAutoinstallPayload, line: String) -> Bool {
  match autoinstall_user_data(payload: payload) {
    AutoinstallUserDataRefused { reason: _ } => false
    AutoinstallUserDataRendered { content: ud } => ud.contains(line)
  }
}

data macbook_key_line_with_comment: String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKgumC/OBjsSgM266FLtgKJpF179Aj/MzEZHQH79QRQF macbook-m4"

data automation_key_line_with_comment: String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB5ObOQw+v/Rd5xdurhZpwI9awQNqCWNgFWbZCQsXJfN fleet-automation@gunbc"

data macbook_key_line_canonical: String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKgumC/OBjsSgM266FLtgKJpF179Aj/MzEZHQH79QRQF"

data automation_key_line_canonical: String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB5ObOQw+v/Rd5xdurhZpwI9awQNqCWNgFWbZCQsXJfN"

test fn the_live_srv3_and_srv4_documents_write_canonical_authorized_keys() -> Bool {
  renders_key_line(payload: srv3_ubuntu_autoinstall, line: macbook_key_line_canonical)
    && renders_key_line(payload: srv3_ubuntu_autoinstall, line: automation_key_line_canonical)
    && renders_key_line(payload: srv3_ubuntu_autoinstall_on_iso, line: macbook_key_line_canonical)
    && renders_key_line(payload: srv4_ubuntu_autoinstall_on_iso, line: automation_key_line_canonical)
    // The commented spelling must NOT appear in a document the public-seed contract governs: a comment that
    // wandered back in would make the very same bytes inadmissible at the edge.
    && !renders_key_line(payload: srv4_ubuntu_autoinstall_on_iso, line: automation_key_line_with_comment)
    && !renders_key_line(payload: srv3_ubuntu_autoinstall, line: macbook_key_line_with_comment)
}

// THE IDENTITY ROUTE, PINNED WHERE IT STILL LIVES. This fixture is not published anywhere and its
// hashed_password is a plainly-fake marker, never a credential: what is pinned is the KEY LINE spelling,
// which is the byte that changed for no other reason than which posture rendered it.
data witness_identity_route_payload: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudLocal,
  fully_automated: true,
  target_distribution: srv3_ubuntu_autoinstall_on_iso.target_distribution,
  identity_posture: WithIdentity {
    identity: AutoinstallIdentity {
      hostname: "witness-identity-route" as NonEmptyStr,
      username: "witness" as NonEmptyStr,
      realname: "witness fixture" as NonEmptyStr,
      hashed_password: "witness-marker-not-a-credential" as NonEmptyStr,
    },
    user_data: Absent,
  },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: fleet_authorized_keys, password_auth: false } },
  storage_policy: StoragePolicyDirectLayout,
}

test fn the_identity_route_still_writes_commented_authorized_keys() -> Bool {
  renders_key_line(payload: witness_identity_route_payload, line: macbook_key_line_with_comment)
    && renders_key_line(payload: witness_identity_route_payload, line: automation_key_line_with_comment)
}

test fn kvm_storage_screen_with_incomplete_preflight_awaits_storage() -> Bool {
  match runtime_verdict_from_kvm_attestation(
    attestation: KvmOperatorAttestation {
      target: operator_host_srv3,
      observed_screen: SubiquityStorageScreen,
      observed_at: "2026-07-02T23:00:00Z",
      attested_by: "operator" as NonEmptyStr,
    },
    preflight: AutoinstallIncompleteNotBootable,
  ) {
    InstallerAwaitingStorage => true
    _ => false
  }
}

test fn non_automated_is_not_unattended_ready() -> Bool {
  let manual_payload = UbuntuAutoinstallPayload {
    autoinstall_version: 1,
    delivery: NoCloudLocal,
    fully_automated: false,
    target_distribution: srv3_ubuntu_autoinstall_on_iso.target_distribution,
    identity_posture: UserDataOnly { users: [] },
    locale: "en_US.UTF-8",
    keyboard_layout: "us",
    ssh: Present { value: AutoinstallSshServer { authorized_keys: [], password_auth: false } },
    storage_policy: StoragePolicyDirectLayout,
  }
  match fold_nbd_proxy_os_install_preflight_verdict(payload: manual_payload, disk: EmptyDisk) {
    NotUnattendedByPolicy => true
    CompleteForUnattended => false
    _ => false
  }
}

test fn kvm_firmware_setup_is_weak_idle_observation() -> Bool {
  match runtime_verdict_from_kvm_attestation(
    attestation: KvmOperatorAttestation {
      target: operator_host_srv3,
      observed_screen: FirmwareSetup,
      observed_at: "2026-07-02T23:00:00Z",
      attested_by: "operator" as NonEmptyStr,
    },
    preflight: CompleteForUnattended,
  ) {
    KvmFirmwareIdleObserved => true
    _ => false
  }
}

test fn kvm_login_prompt_is_weak_not_os_installed() -> Bool {
  match runtime_verdict_from_kvm_attestation(
    attestation: KvmOperatorAttestation {
      target: operator_host_srv3,
      observed_screen: LoginPrompt,
      observed_at: "2026-07-02T23:00:00Z",
      attested_by: "operator" as NonEmptyStr,
    },
    preflight: CompleteForUnattended,
  ) {
    KvmSuggestsOsBooted => true
    RuntimeOsInstalled => false
    _ => false
  }
}
