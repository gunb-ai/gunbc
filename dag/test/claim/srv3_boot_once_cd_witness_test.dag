module test.claim.srv3_boot_once_cd


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn boot_cd_once_body_wires_correctly() -> Bool {
  let body = gunbc.tools.bmc_onboard.boot_override_body(target: "Cd", enabled: "Once", mode: "UEFI")
  body == "{\"Boot\": {\"BootSourceOverrideTarget\": \"Cd\", \"BootSourceOverrideEnabled\": \"Once\", \"BootSourceOverrideMode\": \"UEFI\"}}"
}

test fn force_restart_body_wires_correctly() -> Bool {
  let body = gunbc.tools.bmc_onboard.reset_body(reset_type: "ForceRestart")
  body == "{\"ResetType\": \"ForceRestart\"}"
}

test fn cd_once_and_restart_redfish_wire_labels_are_grounded() -> Bool {
  extdeps.bmc.types.redfish_boot_target_wire(t: gunbc.srv3_boot_once_cd.srv3_boot_cd_target) == "Cd"
    && extdeps.bmc.types.redfish_boot_override_enabled_wire(e: gunbc.srv3_boot_once_cd.srv3_boot_cd_enabled) == "Once"
    && extdeps.bmc.types.redfish_boot_override_mode_wire(m: gunbc.srv3_boot_once_cd.srv3_boot_cd_mode) == "UEFI"
    && gunbc.srv3_boot_once_cd.srv3_boot_cd_mode == extdeps.bmc.types.BootOverrideModeUefi
    && gunbc.srv3_boot_once_cd.srv3_boot_cd_override_mode_valid_for_arm64(mode: extdeps.bmc.types.BootOverrideModeUefi)
    && !gunbc.srv3_boot_once_cd.srv3_boot_cd_override_mode_valid_for_arm64(mode: BootOverrideModeLegacy)
    && match gunbc.srv3_boot_once_cd.srv3_boot_cd_override_mode_refusal(mode: BootOverrideModeLegacy) {
      Present { value: r } => string_contains(s: r, pattern: "Legacy refused")
      Absent => false
    }
    && match gunbc.srv3_boot_once_cd.srv3_boot_cd_override_mode_refusal(mode: extdeps.bmc.types.BootOverrideModeUefi) {
      Absent => true
      Present { value: _ } => false
    }
    && extdeps.bmc.types.redfish_reset_type_wire(r: gunbc.srv3_boot_once_cd.srv3_boot_cd_reset_type) == "ForceRestart"
}
