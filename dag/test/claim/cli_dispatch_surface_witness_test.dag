module test.claim.cli_dispatch_surface

import gunbc.cli_dispatch_surface {
  cli_dispatch_executor_candidate,
  dispatch_local_binding_names,
  fresh_cli_dispatch_executor_name
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THIS WITNESS SEPARATES, because the two halves have different oracles.
//
// The FOLD's behaviour is checked against a controlled fixture below -- rows authored here, with
// the expected gap authored beside them, so the assertion has a referent independent of the
// production population. Checking `cli_shipped_dispatch_gap_of` against the gunbc rows instead would be
// `measure() == measure()`: a transcription of the same declarations the fold reads.
//
// The LIVE rows are checked only for structural invariants that hold for any well-formed CLI --
// distinct verbs, distinct long spellings within a verb, no default on a toggle. Those are
// properties a new row can violate, so their RED is authorable, and they say nothing about which
// rows happen to exist today.

fn option_row(long: String, emission: CliSurfaceEmission) -> CliOptionRow {
  CliOptionRow {
    field: long,
    long: long,
    value: CliTextValue { text_default: none },
    arity: CliRequired,
    doc: [],
    emission: emission
  }
}

fn fixture_subcommands() -> List<CliSubcommandRow> {
  [
    CliSubcommandRow {
      verb: "alpha",
      variant: "Alpha",
      doc: [],
      operands: [],
      options: [option_row(long: "kept", emission: CarriedByGeneratedDispatch), option_row(long: "missing", emission: AbsentFromShippedDispatch)],
      realization: CliRetainedHostKernel,
      emission: CarriedByGeneratedDispatch
    },
    CliSubcommandRow {
      verb: "beta",
      variant: "Beta",
      doc: [],
      operands: [],
      options: [option_row(long: "one", emission: AbsentFromShippedDispatch), option_row(long: "two", emission: AbsentFromShippedDispatch)],
      realization: CliRetainedHostKernel,
      emission: AbsentFromShippedDispatch
    }
  ]
}

fn render_names(names: List<String>) -> String {
  fold(names, init: "", f: fn(acc, n) { if acc == "" { n } else { concat(acc, concat(",", n)) } })
}

// The fixture plants exactly one absent option under a PRESENT verb and two absent options under
// an ABSENT verb. The expected answer is authored here, not measured: the present verb
// contributes its one missing option, the absent verb contributes itself ONCE and its two options
// not at all. A fold that listed an absent verb's options beside it would answer
// "alpha.missing,beta,beta.one,beta.two" and go red here.
test fn gap_subsumes_options_under_an_absent_verb() -> Bool {
  render_names(names: cli_shipped_dispatch_gap_of(subcommands: fixture_subcommands())) == "alpha.missing,beta"
}

test fn gap_is_empty_when_every_row_is_emitted() -> Bool {
  let all_present = [
    CliSubcommandRow {
      verb: "alpha",
      variant: "Alpha",
      doc: [],
      operands: [],
      options: [option_row(long: "kept", emission: CarriedByGeneratedDispatch)],
      realization: CliRetainedHostKernel,
      emission: CarriedByGeneratedDispatch
    }
  ]
  cli_shipped_dispatch_gap_of(subcommands: all_present) |> count == 0
}

// DISCRIMINATING RED for the generated-binding collision wall. The fixture gives an authored
// field the emitter's preferred executor spelling. A fixed private spelling makes the generated
// arm shadow its executor; the bounded fresh-name construction shifts both the parameter and its
// use to the next spelling. `fresh_cli_dispatch_executor_name` constructs exactly N+1 distinct
// candidates for N fields with a forward fold, so termination is bounded by the finite population
// rather than justified by open recursion.
test fn generated_dispatch_executor_name_shifts_when_a_modeled_field_collides() -> Bool {
  let collision = cli_dispatch_executor_candidate(index: 0)
  let shifted = cli_dispatch_executor_candidate(index: 1)
  let rows = [
    CliSubcommandRow {
      verb: "fixture",
      variant: "Fixture",
      doc: [],
      operands: [],
      options: [option_row(long: collision, emission: CarriedByGeneratedDispatch)],
      realization: CliRetainedHostKernel,
      emission: CarriedByGeneratedDispatch
    }
  ]
  fresh_cli_dispatch_executor_name(blocked: dispatch_local_binding_names(rows: rows)) == Present { value: shifted }
}

test fn generated_dispatch_executor_name_is_bounded_deterministic_and_duplicate_stable() -> Bool {
  let base = cli_dispatch_executor_candidate(index: 0)
  let next = cli_dispatch_executor_candidate(index: 1)
  let third = cli_dispatch_executor_candidate(index: 2)
  fresh_cli_dispatch_executor_name(blocked: []) == Present { value: base }
    && fresh_cli_dispatch_executor_name(blocked: [base]) == Present { value: next }
    && fresh_cli_dispatch_executor_name(blocked: [base, base]) == Present { value: next }
    && fresh_cli_dispatch_executor_name(blocked: [base, next]) == Present { value: third }
    && fresh_cli_dispatch_executor_name(blocked: [next, base]) == Present { value: third }
}

// The bootstrap execution class is not an author-selectable tag over an arbitrary
// DeclarationRef. Its sole admitted identity projects to the whole product-build declaration;
// ordinary target producers have no constructor in this closed population.
test fn bootstrap_successor_admission_is_closed_over_the_product_build_operation() -> Bool {
  let operation = admitted_bootstrap_operation_declaration(identity: GunbcProductBuildBootstrapOperation {})
  operation == gunbc_build_operation_ref()
    && operation.field == WholeDeclaration
}

fn occurrences(names: List<String>, needle: String) -> Int {
  fold(names, init: 0, f: fn(acc, n) { if n == needle { acc + 1 } else { acc } })
}

fn verb_names() -> List<String> {
  gunbc_cli_subcommands() |> map(sub => sub.verb)
}

test fn live_verbs_are_distinct() -> Bool {
  verb_names() |> all(v => occurrences(names: verb_names(), needle: v) == 1)
}

test fn live_long_spellings_are_distinct_within_a_verb() -> Bool {
  gunbc_cli_subcommands() |> all(sub => {
    let longs = sub.options |> map(opt => opt.long)
    longs |> all(l => occurrences(names: longs, needle: l) == 1)
  })
}

test fn clean_version_identity_is_the_exact_commit() -> Bool {
  let commit = "0123456789abcdef0123456789abcdef01234567" as CommitSha
  gunbc_cli_version_text(
    identity: gunbc_cli_version_identity(source_commit: commit, source_dirty: false)
  )
    == commit
}

// Discriminating control for the provenance lie this surface closes: changing only the dirty
// observation must make the output cease to inhabit the 40-hex commit spelling.
test fn dirty_version_identity_cannot_impersonate_the_commit() -> Bool {
  let commit = "0123456789abcdef0123456789abcdef01234567" as CommitSha
  gunbc_cli_version_text(
    identity: gunbc_cli_version_identity(source_commit: commit, source_dirty: true)
  )
    == concat(commit, "-dirty")
}

// THE TOGGLE-DEFAULT CHECK IS DELETED, NOT MOVED.
//
// A witness here asserted that no toggle option declares a default. `CliToggleValue` now has no
// default field at all, so that state has no constructor: it is unwritable in any source a
// fixture could author, not merely absent from the live rows. A check whose RED cannot be
// produced anywhere it could run is permanently green by construction and would be cited as
// coverage while carrying no information (DESIGN section 4b). The guarantee climbed; the check
// went with the machinery it replaced, and this note is what remains of it.

// ---------------------------------------------------------------------------------------------
// THE OPERAND AXIS
// ---------------------------------------------------------------------------------------------

// THE GAP FOLD REACHES OPERANDS UNDER A PRESENT VERB, AND THE FIXTURE PLANTS ONE. Without this
// arm an operand the emitter does not render would be invisible to the one instrument that
// reports what the committed CLI carries and the emitter does not -- a hole in a census that
// exists precisely to have none.
fn fixture_subcommands_with_an_operand() -> List<CliSubcommandRow> {
  [
    CliSubcommandRow {
      verb: "alpha",
      variant: "Alpha",
      doc: [],
      operands: [
        CliOperandRow {
          field: "subject",
          placeholder: "LABEL",
          value: CliAbsoluteLabelOperand {},
          arity: CliExactlyOneOperand {},
          doc: [],
          emission: AbsentFromShippedDispatch
        }
      ],
      options: [option_row(long: "kept", emission: CarriedByGeneratedDispatch)],
      realization: CliRetainedHostKernel,
      emission: CarriedByGeneratedDispatch
    }
  ]
}

test fn gap_lists_an_unemitted_operand_under_a_present_verb() -> Bool {
  render_names(names: cli_shipped_dispatch_gap_of(subcommands: fixture_subcommands_with_an_operand()))
    == "alpha.LABEL"
}

fn test_verb_rows() -> List<CliSubcommandRow> {
  gunbc_cli_subcommands() |> filter(sub => sub.verb == "test")
}

// THE VERB DECLARES EXACTLY ONE POSITIONAL LABEL OPERAND AND NO OPTIONS. The second conjunct is
// the load-bearing one: it is what would go red if the interface were respelled as
// `gunbc test --target //...` because the row carrier happened to have an option list ready.
test fn the_test_verb_declares_one_absolute_label_operand_and_no_options() -> Bool {
  test_verb_rows() |> all(sub =>
    ((sub.operands |> count) == 1)
      && ((sub.options |> count) == 0)
      && (sub.operands |> all(operand =>
           (operand.value == CliAbsoluteLabelOperand {})
             && (operand.arity == CliExactlyOneOperand {})))
  ) && ((test_verb_rows() |> count) == 1)
}

// THE CLI AUTHORITY NAMES NO HOST FUNCTION FOR THIS VERB.
//
// `CliDelegatesToHostFn` carries an authored Rust symbol as a `String`, and a verb on that arm
// binds the model to a realization by SPELLING. The `test` verb resolves its subject through the
// target-binding registry instead, so the surface names no realization at all and the dispatch
// that selects one stays peripheral. This goes red the moment someone re-homes the verb onto the
// stringly arm -- which is the shape the architecture exists to replace, and therefore the shape
// most likely to be reached for by a later change wanting a quick hook.
test fn the_test_verb_names_no_host_function() -> Bool {
  test_verb_rows() |> all(sub => match sub.realization {
    CliInvokesBoundTargetProducer => true
    CliDelegatesToHostFn { symbol: _ } => false
    CliRetainedHostKernel => false
    CliRefusesUnwired { successor: _ } => false
    CliInvokesBootstrapDagOperation { binding: _ } => false
    CliKnownOperationNoRealization { operation: _ } => false
  })
}

// DISCRIMINATING RED FOR THE NOW-LOAD-BEARING REALIZATION AXIS. Replacing the build row's
// binding with this arm keeps the operation known and changes only realization availability;
// it must therefore name that distinction rather than collapsing into unknown program or fallback.
test fn a_known_operation_without_a_realization_refuses_as_such() -> Bool {
  match cli_realization_missing_refusal(
    realization: CliKnownOperationNoRealization { operation: gunbc_build_operation_ref() },
  ) {
    Present { value } => value == "known operation, no realization: gunbc.devboot.build.gunbc_build_cli_entry"
    Absent => false
  }
}

test fn the_live_build_operation_has_a_realization_binding() -> Bool {
  gunbc_cli_subcommands() |> filter(sub => sub.verb == "build") |> all(sub =>
    match cli_realization_missing_refusal(realization: sub.realization) {
      Present { value: _ } => false
      Absent => true
    }
  ) && ((gunbc_cli_subcommands() |> filter(sub => sub.verb == "build") |> count) == 1)
}

// THE SCM VERB'S GAP IS COUNTED, NOT SILENT -- which is the whole reason the row was declared before
// its handler exists.
//
// `gunbc scm` is declared in this surface and `AbsentFromShippedDispatch`, so the CLI authority states
// the verb while the installed generated carrier excludes it. That is only worth doing if the absence
// is OBSERVED: a declared-but-unshipped verb that no consumer counted would be the parallel-ledger failure the
// declaration exists to end -- the gap living in prose instead of on the carrier.
//
// The membership fold is INLINE rather than a top-level helper deliberately: this file's siblings
// record that two separate top-level `string_contains` definitions already exist in witness files and
// that top-level names are corpus-wide with silent duplicate selection (#8707), so a third would make
// that binding arbitrary for every module in the shared scope.
test fn the_scm_verb_is_listed_in_the_shipped_dispatch_gap() -> Bool {
  fold(gunbc_cli_shipped_dispatch_gap(), init: false, f: fn(found, entry) {
    if found { true } else { entry == "scm" }
  })
}
