module test.claim.site_gunb_ai_tokens_witness

import std.types { Bool }
import std.algebra { string_contains }
import gunbc.design.material { CssDecl }
import extdeps.languages.css.properties { CustomProperty }
import gunbc.design.gunb_ai_hues { gunb_ai_hues_admissible }
import gunbc.site.gunb_ai_tokens {
  token_binding_complete, token_contrast_floors_hold, token_root_decls,
  review_render, ReviewHtml, ReviewEmitRefused, type_scale_wires,
}

// Renders-and-checks the tokens layer (DESIGN §5: a witness goes RED when the layer
// breaks; each claim is a property of the RENDERED artifact, not of a type).
// Consumer: claim-run — `gunbc run --source-root dag --entry
// dag/test/claim/site_gunb_ai_tokens_witness.dag --claim-run`, alongside the other
// site witnesses on the compiler gate.
//
// No count is copied from the tree (§5: a count equality is a change detector, not
// completeness — completeness is the identity join in token_binding_complete). The
// claims below are all properties of what actually renders.

// 1. The hue set enters palette the way every other set must.
test fn witness_hue_set_admissible() -> Bool {
  gunb_ai_hues_admissible()
}

// 2. The binding is total as an identity join (every hue claimed, every bound swatch
//    in the set, roles well-formed and distinct) — no pinned width.
test fn witness_binding_total() -> Bool {
  token_binding_complete()
}

// 3. The rendered page carries every token as a :root declaration, compared against
//    what palette/scale themselves emit, so a hand-copied literal in the site layer
//    cannot pass (it would differ from upstream's wire).
//
//    RED control that earns this claim's keep: an earlier draft emitted the
//    declarations BARE inside <style> — no selector at all — and every declaration
//    still appeared in the text, so a "the string is present" check alone went GREEN
//    on a page that rendered with no theme. A property of CSS is checked here, not
//    mere presence: the declarations must sit INSIDE a :root block.
test fn witness_rendered_root_is_bound_output() -> Bool {
  match review_render() {
    ReviewHtml { html: h } =>
      string_contains(s: h, pattern: ":root { ")
        && all(token_root_decls(), d => string_contains(s: h, pattern: decl_wire(d: d)))
        // A modelled rule (not a string block): the body rule reads the tokens by
        // reference, so a literal colour in the site layer goes red against upstream.
        && string_contains(s: h, pattern: "body { ")
        && string_contains(s: h, pattern: "background: var(--canvas)")
        // Token references must point at THIS site's declared rows. RED control that
        // earns its keep (review 81513): the main container once read scale_var(t:
        // measure_page) — an unimported name the resolver satisfied AMBIENTLY with
        // gunbc.design.scale.measure_page (the workspace site's row, name "measure").
        // This site's :root never declared --measure, so the reference dangled: the
        // container silently lost its width cap, every other claim stayed green, and
        // the render showed nothing. A presence check cannot see a wrong-but-plausible
        // reference, so the name is asserted here and the foreign custom property
        // (closing paren included, which exempts --measure-prose) is asserted absent.
        && string_contains(s: h, pattern: "max-width: var(--gunb-measure-page)")
        && !string_contains(s: h, pattern: "max-width: var(--measure)")
    ReviewEmitRefused { reason: r } => false
  }
}

fn decl_wire(d: CssDecl) -> String {
  match d.prop {
    CustomProperty { name: n } => join(["--", n, ": ", d.value], "")
    _ => "PROPERTY-CHANNEL-MISMATCH-MUST-FAIL"
  }
}

// 4. Contrast floors hold on the night canvas (fail-closed: a refused channel is 0).
test fn witness_contrast_floors() -> Bool {
  token_contrast_floors_hold()
}

// 5. Fail closed on emit, checked through the TYPE, not a marker string: a refusal
//    is its own arm, so there is no page content a refused render could hide in.
//    The landed type scale (operator pick B, compact) must reach the page through
//    the upstream wire — display=40px comes from gunbc.design.scale.scale_value_wire
//    over the ScaleToken rows, never from a second literal list. The negative arm
//    holds the option-A magnitude (52px) out of the artifact.
test fn witness_render_and_landed_scale() -> Bool {
  match review_render() {
    ReviewHtml { html: h } =>
      starts_with(s: h, prefix: "<!DOCTYPE html>")
        && string_contains(s: h, pattern: join(type_scale_wires(), "   "))
        && string_contains(s: h, pattern: "display=40px")
        && !string_contains(s: h, pattern: "52px")
    ReviewEmitRefused { reason: r } => false
  }
}
