module test.claim.spark_serving_write_unit_operation_witness_test

import std.types { Bool, String, List }
import gunbc.spark_serving_realization {
  ServingInstallEffect,
  WriteUserUnitFile,
  EnableLingerForOwnAccount,
  PullModelArtifact,
}
import gunbc.spark_serving_converge_realize {
  SparkServingInstallRemoteCommandsVerdict,
  SparkServingInstallRemoteCommandsPresent,
  SparkServingInstallRemoteCommandsRefused,
  realize_spark_serving_install_effect_commands,
}
import gunbc.spark_serving_desired { spark_serving_automation_principal_login }
import gunbc.remote_operation {
  RemoteOperation,
  RemoteArgv,
  RemoteFileBytes,
  remote_operation_count,
  remote_operation_file_write_count,
  remote_operations_argv_only,
}
import gunbc.spark_serving_unit_render { spark_serving_desired_user_unit_text }
import gunbc.spark_serving_install_paths { spark_serving_user_unit_path }

fn realize(effects: List<ServingInstallEffect>) -> SparkServingInstallRemoteCommandsVerdict {
  realize_spark_serving_install_effect_commands(
    effects: effects,
    executor_login: spark_serving_automation_principal_login(),
  )
}

// ── The defect this closes ──────────────────────────────────────────────────────────────────────

// THE KEYSTONE. `WriteUserUnitFile` refused for as long as the realizer could only produce argv, and
// that refusal was reporting a MISSING TYPE rather than missing work: a file write is bytes, and
// bytes ride stdin, so no argv-shaped verdict could ever express it. It now realizes.
test fn write_user_unit_file_realizes_instead_of_refusing() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { operations: ops } =>
      remote_operation_count(operations: ops) == 1
        && remote_operation_file_write_count(operations: ops) == 1
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// It is a FILE WRITE, not an argv. A file write with an argv projection would mean bytes had been
// routed onto a command line, which is exactly what the typed-write module exists to prevent.
test fn the_unit_write_carries_no_argv_projection() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { operations: ops } =>
      length(remote_operations_argv_only(operations: ops)) == 0
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// The bytes are the ones the renderer produces, and the path is the modeled unit path. Asserting the
// exact content is what makes this a claim about delivering the right unit rather than delivering
// something.
test fn the_unit_write_carries_the_rendered_bytes_at_the_modeled_path() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { operations: ops } =>
      match ops.first() {
        Absent => false
        Present { value: op } =>
          match op {
            RemoteFileBytes { write: w, mode: _ } =>
              w.content == spark_serving_desired_user_unit_text()
                && (w.path as String) == (spark_serving_user_unit_path() as String)
            RemoteArgv { argv: _ } => false
          }
      }
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ── The two kinds coexist in one ordered sequence ───────────────────────────────────────────────

// Ordering is load-bearing: the unit file must exist before the manager reloads it. A mixed sequence
// must therefore keep both kinds in order rather than partitioning them, and the counts must
// disagree — one operation of each, but only one argv — which is what proves the argv projection is
// a genuine subset and not the whole population.
test fn a_mixed_sequence_keeps_both_kinds_and_their_order() -> Bool {
  match realize(effects: [WriteUserUnitFile, EnableLingerForOwnAccount]) {
    SparkServingInstallRemoteCommandsPresent { operations: ops } =>
      remote_operation_count(operations: ops) == 2
        && remote_operation_file_write_count(operations: ops) == 1
        && length(remote_operations_argv_only(operations: ops)) == 1
        && match ops.first() {
          Absent => false
          Present { value: op } =>
            match op {
              RemoteFileBytes { write: _, mode: _ } => true
              RemoteArgv { argv: _ } => false
            }
        }
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ── What still refuses, so the widening did not become an absorbing arm ─────────────────────────

// Widening the representation must not turn unimplemented effects into successes. `PullModelArtifact`
// has no realization, and a sequence containing it still refuses whole rather than silently
// realizing the part it understands.
test fn an_unrealized_effect_still_refuses_the_whole_sequence() -> Bool {
  match realize(effects: [WriteUserUnitFile, PullModelArtifact]) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => true
    SparkServingInstallRemoteCommandsPresent { operations: _ } => false
  }
}

// An argv effect is still an argv operation. The keystone above would also pass if EVERYTHING became
// a file write, so this pins the other direction.
test fn an_argv_effect_is_still_an_argv_operation() -> Bool {
  match realize(effects: [EnableLingerForOwnAccount]) {
    SparkServingInstallRemoteCommandsPresent { operations: ops } =>
      remote_operation_file_write_count(operations: ops) == 0
        && length(remote_operations_argv_only(operations: ops)) == 1
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}
