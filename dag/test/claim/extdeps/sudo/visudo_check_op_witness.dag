// WITNESS FOR THE VISUDO (SUDOERS-VALIDATE) OPERATION. The op renders two elevated argvs -- the
// syntax check and the policy check of a sudoers file -- and this module is the claim that those
// argvs are the right ones, on the boundary values the real consumers supply.
//
// THE WITNESS SUPPLIES THE BOUNDARY VALUES. DESIGN's witness rule is that a claim supplies the
// boundary it claims about, not that it reads the boundary from the world. The two boundary values
// here are the two sudoers files the three consumers actually validate: the staged drop-in, written
// to a deploy stage before install and checked there, and the installed drop-in,
// /etc/sudoers.d/gunbc-workspace-commissioning, checked after install. Both are absolute POSIX
// paths; every character in both is inside the portable argv allowlist, which is exactly the fact
// the real-route test below is about.
//
// THE INHABITANCE CLAIM ON THE REAL ROUTE. The route a consumer takes from this op to a live host is
// the typed argv transport: it calls the op for an ArgvCommand, reads the words, and hands them to
// typed_argv_exec_over_ssh, whose first act is the portability wall -- typed_argv_shell_safe_refusal
// _argv -- and which refuses any word outside the portable allowlist rather than let the remote
// shell re-interpret it. The claim here is that the op, on the supplied boundary values, renders an
// argv the wall ADMITS: every word portable. That is what makes the route inhabitant (non-empty) for
// these values -- a consumer does not have to special-case the visudo check, because its words pass
// the same wall every other typed argv does. It is pure and hermetic: the wall is a function of the
// words alone, no host, no ssh, no sudo.
//
// THE BYTE-EXACT ARGV IS THE WHOLE POINT. The op replaces a shell-text builder that spelled a
// rendered command line; a consumer swapping the builder for the op must run the identical command.
// So the claim asserts the words, one by one, against the words the shell spelled: /usr/bin/sudo,
// its -n, /usr/sbin/visudo, and the flags. The flag spelling is where the two checks differ and
// where a wrong op would bite: the syntax check is the single combined word `-cf`, and the policy
// check is the four separate words `-c -O -P -f`. Asserting them as independent literals in the
// witness -- not re-deriving them from the op's own rows -- is what makes the claim discriminate a
// re-spelled flag.
//
// THE RED IS DISCRIMINATING, NOT DECORATIVE. The portability wall exists because a file value the
// op takes by parameter could, if a caller passed one, smuggle a token the remote shell would
// re-interpret. The RED constructs exactly such a value -- a path with a shell metacharacter in it --
// and asserts the op renders an argv the wall REFUSES, and that the refusal names the offending
// token. A wall that let everything through would fail this test, and an op that quoted or laundered
// the file into a portable word would fail it too, because the op passes the file through as one
// word and does not quote: the metacharacter is in the word, and the wall sees it.

module test.claim.extdeps.sudo.visudo_check_op_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.exec.command { argv_words }
import extdeps.sudo.elevation { sudo_program, sudo_non_interactive_flag }
import extdeps.sudo.visudo {
  visudo_check_command, visudo_policy_check_command,
  visudo_binary_path, visudo_binary_name, min_visudo_version,
}
import gunbc.fleet.fleet_posix_accounts { fleet_visudo_binary_path }
import gunbc.typed_argv_exec { typed_argv_shell_safe_refusal_argv }

// THE TWO BOUNDARY VALUES THE REAL CONSUMERS VALIDATE. The staged drop-in is a deterministic deploy
// stage path -- the same shape the microVM-controller install and the deploy preamble write their
// staged file to -- and the installed drop-in is the live location sudo reads. Both are supplied
// here, per the witness rule, rather than read from a host.
data staged_dropin_path: NonEmptyStr = "/var/lib/gunbc/deploy-stages/microvm-controller/sudoers.d.gunbc-workspace-commissioning" as NonEmptyStr
data installed_dropin_path: NonEmptyStr = "/etc/sudoers.d/gunbc-workspace-commissioning" as NonEmptyStr

fn check_words(file: String) -> List<String> {
  argv_words(command: visudo_check_command(file: file))
}

fn policy_words(file: String) -> List<String> {
  argv_words(command: visudo_policy_check_command(file: file))
}

// THE REAL-ROUTE WALL, as a Bool: Absent (no refusing token) is the admit, Present is the refuse.
fn argv_admitted_by_portability_wall(argv: List<String>) -> Bool {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE BOUNDARY VALUES SUPPLIED, THE BYTE-EXACT ARGV, AND THE INHABITANCE CLAIM: on both the staged
// and the installed drop-in, the syntax check renders exactly the words the shell spelled, the
// policy check renders its four separate flag words, and BOTH argvs pass the portability wall.
test fn boundary_values_render_the_exact_argv_and_the_real_route_admits_them() -> Bool {
  let staged = staged_dropin_path as String
  let installed = installed_dropin_path as String
  let check_staged = check_words(file: staged)
  let check_installed = check_words(file: installed)
  let policy_staged = policy_words(file: staged)
  let policy_installed = policy_words(file: installed)
  // The syntax check: one combined -cf word. Byte-exact against the shell builder's spelling.
  let check_ok = check_staged == [
    sudo_program().invocation as String,
    sudo_non_interactive_flag as String,
    "/usr/sbin/visudo",
    "-cf",
    staged,
  ] && check_installed == [
    sudo_program().invocation as String,
    sudo_non_interactive_flag as String,
    "/usr/sbin/visudo",
    "-cf",
    installed,
  ]
  // The policy check: four separate flag words, -c -O -P -f, not a combined form.
  let policy_ok = policy_staged == [
    sudo_program().invocation as String,
    sudo_non_interactive_flag as String,
    "/usr/sbin/visudo",
    "-c",
    "-O",
    "-P",
    "-f",
    staged,
  ] && policy_installed == [
    sudo_program().invocation as String,
    sudo_non_interactive_flag as String,
    "/usr/sbin/visudo",
    "-c",
    "-O",
    "-P",
    "-f",
    installed,
  ]
  // The inhabitance claim on the real route: every word of every argv is portable, so the typed
  // transport's wall admits all four.
  let admitted = argv_admitted_by_portability_wall(argv: check_staged)
    && argv_admitted_by_portability_wall(argv: check_installed)
    && argv_admitted_by_portability_wall(argv: policy_staged)
    && argv_admitted_by_portability_wall(argv: policy_installed)
  check_ok && policy_ok && admitted
}

// THE BINARY PATH AGREES ACROSS THE TWO SPELLINGS. extdeps cannot import gunbc.fleet, so the op
// spells /usr/sbin/visudo itself and the fleet roster spells it in its NOPASSWD grant; this is the
// strongest coupling the dependency direction allows, and it pins the literal the byte-exact test
// above uses. If the fleet roster moves the binary, this claim breaks.
test fn binary_path_matches_the_fleet_roster_spelling() -> Bool {
  (visudo_binary_path as String) == "/usr/sbin/visudo"
    && (visudo_binary_path as String) == (fleet_visudo_binary_path as String)
    && (visudo_binary_name as String) == "visudo"
}

// THE MINIMUM VERSION IS GROUNDED, in the same way the coreutils floor is: the row is a documentary
// fact about the flag vocabulary, and the claim pins its value so it cannot drift from the man page
// it cites. The live visudo(8) page (1.8 series, through 1.8.27) documents -c, -f, -O and -P, all
// present in the 1.8-series SYNOPSIS the floor names.
test fn minimum_version_is_the_cited_floor() -> Bool {
  (min_visudo_version as String) == ">= 1.8.4"
}

// THE RED, DISCRIMINATING: a file value with a shell metacharacter in it is not portable, and the
// op does not launder it -- it passes the file through as one word, so the metacharacter is in the
// word, and the portability wall refuses the argv, naming the offending token. The syntax and
// policy checks both take the file as a parameter, so both are asserted. A wall that admitted
// everything, or an op that quoted the file into a portable word, would fail this claim: quoting
// would put the quote character (also outside the allowlist) in the word, and a permissive wall
// would return Absent where this asserts Present.
test fn a_non_portable_file_value_is_refused_by_the_wall() -> Bool {
  let hostile = "/etc/sudoers.d/x && id"
  let check_hostile = check_words(file: hostile)
  let policy_hostile = policy_words(file: hostile)
  let check_refused = match typed_argv_shell_safe_refusal_argv(argv: check_hostile) {
    Present { value: why } => string_contains(s: why, pattern: "&& id")
    Absent => false
  }
  let policy_refused = match typed_argv_shell_safe_refusal_argv(argv: policy_hostile) {
    Present { value: why } => string_contains(s: why, pattern: "&& id")
    Absent => false
  }
  // And the wall is live, not vacuously absent: a genuinely portable word is admitted, which is
  // what makes the refusal above a real refusal and not the wall refusing its own allowlist.
  let control_admitted = argv_admitted_by_portability_wall(argv: [
    sudo_program().invocation as String,
    sudo_non_interactive_flag as String,
    "/usr/sbin/visudo",
    "-cf",
    installed_dropin_path as String,
  ])
  check_refused && policy_refused && control_admitted
}
