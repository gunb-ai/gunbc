// THE PER-USER SUBSCRIPTION FACTS the views derive from: the owner stars 103, upvotes 104, and is
// cc'd on 106; the teammate stars 101 and is cc'd on 102. NOTHING about this state lives on the
// issues themselves beyond the display fields the resource carries.
data fixture_subscriptions: List<IssueSubscription> = [
  IssueSubscription { user: fixture_owner, issue: IssueRef { id: 103 }, kind: IssueSubscriptionStar },
  IssueSubscription { user: fixture_owner, issue: IssueRef { id: 104 }, kind: IssueSubscriptionUpvote },
  IssueSubscription { user: fixture_owner, issue: IssueRef { id: 106 }, kind: IssueSubscriptionCc },
  IssueSubscription { user: fixture_teammate, issue: IssueRef { id: 101 }, kind: IssueSubscriptionStar },
  IssueSubscription { user: fixture_teammate, issue: IssueRef { id: 102 }, kind: IssueSubscriptionCc },
]

fn issue_ids(issues: List<Issue>) -> List<Int> {
  issues |> map(i => i.id)
}

fn w_roster_literal() -> List<String> {
  [
    "Assigned to me",
    "Starred by me",
    "Upvoted by me",
    "CC'd to me",
    "Collaborating",
    "Reported by me",
    "To be verified",
    "Hotlists",
    "Saved searches",
    "Bookmark groups",
    "Browse components",
  ]
}

test fn w_stock_sidebar_roster_is_verbatim() -> Bool {
  let roster: List<String> = stock_sidebar_roster |> map(s => s as String)
  roster == w_roster_literal()
}

// The interface version records the latest cited session PLUS the owner-directed vocabulary
// additions (the version comment on the row says why); the 2026-09-24 bump carries the action
// vocabulary, the 2026-09-25 bump the capture-verified assignee display rule. The pin keeps the
// row from drifting back.
test fn w_interface_version_cites_capture_date() -> Bool {
  (issue_tracker_interface_version as String) == "2026-09-25"
}

test fn w_status_vocabulary_wire_labels_are_ui_spellings() -> Bool {
  (issue_status_wire(status: IssueStatusNew) == "New")
    && (issue_status_wire(status: IssueStatusAssigned) == "Assigned")
    && (issue_status_wire(status: IssueStatusAccepted) == "Accepted")
    && (issue_status_wire(status: IssueStatusFixed) == "Fixed")
    && (issue_status_wire(status: IssueStatusVerified) == "Verified")
    && (issue_status_wire(status: IssueStatusDuplicate) == "Duplicate")
}

test fn w_priority_and_severity_wire_labels_are_ui_spellings() -> Bool {
  (issue_priority_wire(priority: IssuePriorityP0) == "P0")
    && (issue_priority_wire(priority: IssuePriorityP1) == "P1")
    && (issue_priority_wire(priority: IssuePriorityP2) == "P2")
    && (issue_priority_wire(priority: IssuePriorityP3) == "P3")
    && (issue_priority_wire(priority: IssuePriorityP4) == "P4")
    && (issue_severity_wire(severity: IssueSeverityS0) == "S0")
    && (issue_severity_wire(severity: IssueSeverityS1) == "S1")
    && (issue_severity_wire(severity: IssueSeverityS2) == "S2")
    && (issue_severity_wire(severity: IssueSeverityS3) == "S3")
    && (issue_severity_wire(severity: IssueSeverityS4) == "S4")
}

test fn w_open_status_class_is_the_new_assigned_accepted_arms() -> Bool {
  issue_status_is_open(status: IssueStatusNew)
    && issue_status_is_open(status: IssueStatusAssigned)
    && issue_status_is_open(status: IssueStatusAccepted)
    && !issue_status_is_open(status: IssueStatusFixed)
    && !issue_status_is_open(status: IssueStatusVerified)
    && !issue_status_is_open(status: IssueStatusDuplicate)
}

test fn w_assigned_to_me_derives_the_exact_subset() -> Bool {
  issue_ids(issues: view_assigned_to_me(issues: fixture_issues, user: fixture_owner)) == [102, 105]
}

test fn w_starred_by_me_derives_the_exact_subset() -> Bool {
  issue_ids(
    issues: view_starred_by_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions)
  ) == [103]
}

test fn w_upvoted_by_me_derives_the_exact_subset() -> Bool {
  issue_ids(
    issues: view_upvoted_by_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions)
  ) == [104]
}

test fn w_ccd_to_me_derives_the_exact_subset() -> Bool {
  issue_ids(
    issues: view_ccd_to_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions)
  ) == [106]
}

test fn w_collaborating_derives_the_exact_subset() -> Bool {
  issue_ids(issues: view_collaborating(issues: fixture_issues, user: fixture_owner)) == [107]
}

test fn w_reported_by_me_derives_the_exact_subset() -> Bool {
  issue_ids(issues: view_reported_by_me(issues: fixture_issues, user: fixture_owner)) == [101]
}

test fn w_to_be_verified_derives_the_exact_subset() -> Bool {
  issue_ids(issues: view_to_be_verified(issues: fixture_issues)) == [108]
}

test fn w_views_take_the_user_as_a_parameter_not_a_hardcode() -> Bool {
  (issue_ids(
    issues: view_starred_by_me(issues: fixture_issues, user: fixture_teammate, subs: fixture_subscriptions)
  ) == [101])
    && (issue_ids(
      issues: view_ccd_to_me(issues: fixture_issues, user: fixture_teammate, subs: fixture_subscriptions)
    ) == [102])
    && (issue_ids(issues: view_reported_by_me(issues: fixture_issues, user: fixture_teammate)) == [
      102,
      103,
      104,
      105,
      106,
      107,
      108,
      109,
    ])
}

type CcMirrorAcc {
  ok: Bool
}

test fn w_cc_facts_mirror_issue_cc_field() -> Bool {
  let acc = fold(fixture_issues, init: CcMirrorAcc { ok: true }, f: fn(a, i) {
    CcMirrorAcc {
      ok: a.ok && (cc_subscribers(subs: fixture_subscriptions, issue_id: i.id) == i.cc),
    }
  })
  acc.ok
}

// THE OWNER'S REAL QUERY, AS THE FIXTURE-LEVEL CONTROL: `assignee:briansrls@gunb.ai status:open`
// must match exactly the open issues assigned to that user and nothing else — issue 101 is
// reported by the owner but not assigned to her; 108 is assigned to the teammate and fixed; 109
// is a duplicate. Each is a different way the naive reading of the query goes wrong.
test fn w_owner_assignee_open_query_matches_exactly_the_open_assigned_subset() -> Bool {
  let q = Query {
    terms: [
      QueryAssignee { email: "briansrls@gunb.ai" },
      QueryStatus { status: IssueStatusQueryOpen },
    ],
  }
  issue_ids(issues: query_run(issues: fixture_issues, query: q)) == [102, 105]
}

test fn w_query_standing_status_term_matches_that_status_alone() -> Bool {
  let q = Query { terms: [QueryStatus { status: IssueStatusQueryStanding { status: IssueStatusFixed } }] }
  issue_ids(issues: query_run(issues: fixture_issues, query: q)) == [108]
}

test fn w_query_text_term_matches_title() -> Bool {
  let q = Query { terms: [QueryText { text: "watchdog" }] }
  issue_ids(issues: query_run(issues: fixture_issues, query: q)) == [101]
}

test fn w_query_text_term_matches_comment_bodies() -> Bool {
  let q = Query { terms: [QueryText { text: "parallel" }] }
  issue_ids(issues: query_run(issues: fixture_issues, query: q)) == [107]
}

test fn w_query_text_term_with_no_match_derives_nothing() -> Bool {
  let q = Query { terms: [QueryText { text: "zzz-no-such-text-zzz" }] }
  list_length(items: query_run(issues: fixture_issues, query: q)) == 0
}

// SUBSCRIPTION FACTS DRIVE THE DERIVATION, NOT THE ISSUE: adding the owner's star on 101 moves
// 101 INTO Starred by me while the issue resource is untouched, and withdrawing the star on 103
// moves 103 OUT. The views read the per-user facts; the issue does not carry its own membership.
data fixture_subscriptions_owner_also_stars_101: List<IssueSubscription> = concat(
  fixture_subscriptions,
  [IssueSubscription { user: fixture_owner, issue: IssueRef { id: 101 }, kind: IssueSubscriptionStar }],
)

data fixture_subscriptions_owner_star_withdrawn: List<IssueSubscription> = [
  IssueSubscription { user: fixture_owner, issue: IssueRef { id: 104 }, kind: IssueSubscriptionUpvote },
  IssueSubscription { user: fixture_owner, issue: IssueRef { id: 106 }, kind: IssueSubscriptionCc },
  IssueSubscription { user: fixture_teammate, issue: IssueRef { id: 101 }, kind: IssueSubscriptionStar },
  IssueSubscription { user: fixture_teammate, issue: IssueRef { id: 102 }, kind: IssueSubscriptionCc },
]

test fn w_star_subscription_change_moves_issue_between_views() -> Bool {
  (issue_ids(
    issues: view_starred_by_me(
      issues: fixture_issues,
      user: fixture_owner,
      subs: fixture_subscriptions_owner_also_stars_101,
    )
  ) == [101, 103])
    && (issue_ids(
      issues: view_starred_by_me(
        issues: fixture_issues,
        user: fixture_owner,
        subs: fixture_subscriptions_owner_star_withdrawn,
      )
    ) == [])
    && (issue_ids(
      issues: view_starred_by_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions)
    ) == [103])
}

// RED CONTROL: an issue outside a view's derivation can never be satisfied into it. Issue 101 is
// not starred by the owner — not in the view — and issue 109 is a duplicate with no relation to
// the viewer at all, so it appears in NO stock view.
test fn w_red_unstarred_issue_never_appears_in_starred_by_me() -> Bool {
  !any(
    issue_ids(
      issues: view_starred_by_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions)
    ),
    id => id == 101,
  )
}

test fn w_red_duplicate_issue_appears_in_no_stock_view() -> Bool {
  let all_view_memberships: List<List<Issue>> = [
    view_assigned_to_me(issues: fixture_issues, user: fixture_owner),
    view_starred_by_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions),
    view_upvoted_by_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions),
    view_ccd_to_me(issues: fixture_issues, user: fixture_owner, subs: fixture_subscriptions),
    view_collaborating(issues: fixture_issues, user: fixture_owner),
    view_reported_by_me(issues: fixture_issues, user: fixture_owner),
    view_to_be_verified(issues: fixture_issues),
  ]
  let every_membership_id = fold(all_view_memberships, init: [], f: fn(acc, view) {
    concat(acc, issue_ids(issues: view))
  })
  !any(every_membership_id, id => id == 109)
}

test fn w_blocking_edges_are_symmetric_in_the_fixture() -> Bool {
  issue_ref_list_includes(refs: fixture_issue_101.blocked_by, id: 102)
    && issue_ref_list_includes(refs: fixture_issue_102.blocking, id: 101)
    && !issue_ref_list_includes(refs: fixture_issue_103.blocked_by, id: 101)
    && !issue_ref_list_includes(refs: fixture_issue_101.blocking, id: 102)
}

// THE ACTION VOCABULARY (owner directive 2026-09-24): the issue's actions and the product's
// button idioms, carried with the same citation discipline as the rest of the interface. The
// Assign wire label is the UI spelling our dispatch surface wears (dispatch = assignment is a
// workflow mapping, not an interface fact); Create Issue is the capture-verified shell label;
// the contained-primary / text idioms and the disabled (never hidden) unavailability idiom are
// the product's button language. The interface version row records the addition.
test fn w_issue_action_wire_labels() -> Bool {
  issue_action_wire(kind: IssueActionAssign) == "Assign"
    && issue_action_wire(kind: IssueActionCreate) == "Create Issue"
    && issue_action_wire(kind: IssueActionMarkDuplicate) == "Mark as duplicate"
}

test fn w_issue_button_idiom_wires() -> Bool {
  issue_button_idiom_wire(idiom: IssueButtonContainedPrimary) == "contained-primary"
    && issue_button_idiom_wire(idiom: IssueButtonText) == "text"
}

test fn w_issue_action_availability_wires() -> Bool {
  issue_action_availability_wire(a: IssueActionEnabled) == "enabled"
    && issue_action_availability_wire(a: IssueActionDisabled) == "disabled"
}

// THE FLEET COMPONENT TREE (owner ruling 2026-09-24): srv1..srv12 as component paths, the spark
// group A/B arms as sub-components — group A on srv5..srv8, group B on srv9..srv12 per the fleet
// observation's cages. The browse-components view derives its walk from the paths: parents before
// children, each component exactly once, sub-components at their depth.
test fn w_issue_action_start_work_wire() -> Bool {
  issue_action_wire(kind: IssueActionStartWork) == "Start Work"
}

// THE ASSIGNEE DISPLAY RULE (owner ruling 2026-09-25, "copy the UI semantics of assigned/etc from
// buganizer"): the results row's ASSIGNEE cell renders the identity as PLAIN TEXT — no chip, no
// button, no link — and an unassigned issue renders the capture-verified "--" placeholder
// (34 of the 50 saved rows in /home/briansrls/chromium-565764076/ "test - Chromium.html"; the
// populated cells did not load in the artifact, so the pin states the placeholder and the
// plain-text rule, not the populated spelling). RED CONTROL: an empty string is not the
// placeholder, and the placeholder is not an email.
test fn w_assignee_results_display_is_plain_text_with_verified_placeholder() -> Bool {
  issue_results_assignee_display(assignee: Present { value: fixture_owner }) == "briansrls@gunb.ai"
    && issue_results_assignee_display(assignee: Absent) == "--"
    && (issue_assignee_unassigned_display as String) == "--"
}

test fn w_fleet_component_tree_hosts_and_arms() -> Bool {
  count(fleet_components()) == 20
    && count(fleet_component_hosts) == 12
    && (match (filter(fleet_components(), c => c.path == ["srv11", "serving", "group-b"])).first() {
      Present { value: c } => c.id == 111
      Absent => false
    })
    && count(filter(fleet_components(), c => count(c.path) == 3)) == 8
}

test fn w_browse_components_derives_the_tree() -> Bool {
  let tree = browse_component_tree(components: fleet_components())
  count(tree) == 20
    && (match tree.first() {
      Present { value: e } => e.component.path == ["srv1"] && e.depth == 1
      Absent => false
    })
    && (match tree.skip(n: 12).first() {
      Present { value: e } => e.component.path == ["srv5", "serving", "group-a"] && e.depth == 3
      Absent => false
    })
    && (match tree.skip(n: 19).first() {
      Present { value: e } => e.component.path == ["srv12", "serving", "group-b"]
      Absent => false
    })
}

// THE RESULTS-TABLE ROSTER (owner ruling 2026-09-24, the derivation law): the column set, the
// header spellings, the row anatomy, and the grid template are DECLARED in this model and every
// surface derives from them. This pin states the served roster IS the capture's amended by the
// 2026-09-25 ruling ("the title is the link — drop the ID column"): the capture's anatomy P · TYPE
// · TITLE · ASSIGNEE · STATUS · D VIEWS · ID · LAST MODIFIED (transcribed VERBATIM from
// /home/briansrls/chromium-565764076/ "test - Chromium.html", 50 live rows, verified 2026-09-24 —
// docs/plans/buganizer-visual-contract.md §Issue-row anatomy) minus the retired ID column; the
// TITLE cell carries the detail link now.
test fn w_issue_results_roster_is_the_capture_amended_by_the_title_link_ruling() -> Bool {
  let wires = map(issue_results_columns, c =>
    join([issue_results_column_kind_wire(kind: c.kind), ":", c.header as String], ""))
  count(issue_results_columns) == 7
    && (match wires.first() { Present { value: w } => w == "priority:P", Absent => false })
    && (match wires.skip(n: 1).first() { Present { value: w } => w == "type:TYPE", Absent => false })
    && (match wires.skip(n: 2).first() { Present { value: w } => w == "title:TITLE", Absent => false })
    && (match wires.skip(n: 3).first() { Present { value: w } => w == "assignee:ASSIGNEE", Absent => false })
    && (match wires.skip(n: 4).first() { Present { value: w } => w == "status:STATUS", Absent => false })
    && (match wires.skip(n: 5).first() { Present { value: w } => w == "d-views:D VIEWS", Absent => false })
    && (match wires.skip(n: 6).first() { Present { value: w } => w == "last-modified:LAST MODIFIED", Absent => false })
}

// THE GRID TEMPLATE derives from the roster — one track per declared column, the workflow's
// actions slot last — so the header and every row share it by construction. The pin states the
// derivation's bytes; the render-side witness pins the served CSS carries exactly them. THE TRACK
// LAW rides the same string (owner rulings 2026-09-25): TITLE takes the dominant flexible share
// (minmax(0, 2fr)) against STATUS's minmax(0, 1fr), and every short column is a FIXED width (P 4ch
// from "P4", TYPE 6ch from "Task", ASSIGNEE the avatar chip's size plus a gutter, D VIEWS 6ch from
// a three-digit count, LAST MODIFIED 12ch from an ISO date, actions 24ch from the count chip's
// upper bound) — so band filtering changes which rows show and NEVER the grid geometry.
test fn w_issue_results_row_tracks_derive_from_the_roster() -> Bool {
  issue_results_row_tracks() == "4ch 6ch minmax(0, 2fr) 9ch minmax(0, 1fr) 8ch 12ch 24ch"
    && count(issue_results_columns) == 7
}

// THE FILTER-STABILITY LAW, the owner complaint's structural answer ("the size of columns is not
// stable when i click thru all -> active -> ready -> upcoming"): the template is ONE FIXED
// STRING regardless of which band population renders — the function takes no population at all,
// so no filtered row set can re-measure a track. RED DIRECTION: reintroducing a max-content
// track (or taking a population) moves this pin.
test fn w_issue_results_tracks_take_no_population_and_never_re_measures() -> Bool {
  let all = issue_results_row_tracks()
  let active_only = issue_results_row_tracks()
  let ready_only = issue_results_row_tracks()
  all == active_only
    && all == ready_only
    && !string_contains(s: all, pattern: "max-content")
    && count(split(s: all, delimiter: "minmax(0, 2fr)")) == 2
    && count(split(s: all, delimiter: "minmax(0, 1fr)")) == 2
}

// TITLE IS THE PRIMARY COLUMN: the dominant flexible share is TITLE's and TITLE's alone — the
// 2fr weight sits on the title track, the 1fr on status, in roster order.
test fn w_title_is_the_primary_column_with_the_dominant_share() -> Bool {
  let title_track = match (filter(issue_results_columns, c => issue_results_column_kind_wire(kind: c.kind) == "title")).first() {
    Present { value: c } => c.track as String
    Absent => ""
  }
  let status_track = match (filter(issue_results_columns, c => issue_results_column_kind_wire(kind: c.kind) == "status")).first() {
    Present { value: c } => c.track as String
    Absent => ""
  }
  title_track == "minmax(0, 2fr)" && status_track == "minmax(0, 1fr)"
}


// THE QUALIFIED-PRINCIPAL MODEL (owner mandate 2026-09-25, docs/plans/issue-page-architecture.md):
// email is the selector, never the durable identity; fabric@gunb.ai is the workflow endpoint with
// BOTH spellings naming ONE principal; NO MODEL NAMES in the assignment vocabulary. The fabric
// principal is kind Workflow with its service avatar resolved from its internal profile (stable,
// modeled, no external fetch) and never masquerades as human; a human principal's display name
// derives deterministically from the selector.
test fn w_qualified_principal_model_email_selector_fabric_endpoint_no_model_names() -> Bool {
  let fabric = principal_from_email(email: "fabric@gunb.ai")
  let fabric_qualified = principal_from_email(email: "worker:fabric/offered")
  let human = principal_from_email(email: "briansrls@gunb.ai")
  let refused = principal_from_email(email: "not an email")
  (match fabric { Present { value: p } =>
    (p.subject as String) == "worker:fabric/offered"
      && (p.primary_email as String) == "fabric@gunb.ai"
      && (p.display_name as String) == "Fabric"
      && (match p.kind { PrincipalKindWorkflow => true  PrincipalKindHuman => false })
      && (match p.avatar { AvatarResolved => true  AvatarAbsent => false  AvatarUnread => false })
      && (match p.avatar_source { AvatarFromInternalProfile => true  AvatarFromGoogleDirectory => false  AvatarFromCachedPrior => false  AvatarFromInitials => false })
    Absent => false })
    && (match fabric_qualified { Present { value: p } => (p.subject as String) == "worker:fabric/offered"  Absent => false })
    && (match human { Present { value: p } =>
      (p.subject as String) == "briansrls@gunb.ai"
        && (p.display_name as String) == "briansrls"
        && (match p.kind { PrincipalKindHuman => true  PrincipalKindWorkflow => false })
        && (match p.avatar { AvatarResolved => false  AvatarAbsent => true  AvatarUnread => false })
      Absent => false })
    && (match refused { Present { value: _ } => false  Absent => true })
    && principal_display_name_of(email: "ops-team@gunb.ai") == "ops-team"
}

// THE AVATAR RESOLUTION CHAIN, in its ruled order — internal profile → directory → cached →
// initials — with UNREAD degraded (initials, honestly reported) and ABSENT the all-miss floor. The
// never-blocks law: EVERY standing renders initials or an image, so assignment, comments and
// rendering never wait on a probe.
test fn w_avatar_resolution_chain_order_and_the_never_blocks_law() -> Bool {
  let from_internal = avatar_resolve(probe_internal: AvatarProbeHit, probe_directory: AvatarProbeMiss, probe_cache: AvatarProbeMiss)
  let from_directory = avatar_resolve(probe_internal: AvatarProbeMiss, probe_directory: AvatarProbeHit, probe_cache: AvatarProbeHit)
  let from_cache = avatar_resolve(probe_internal: AvatarProbeMiss, probe_directory: AvatarProbeMiss, probe_cache: AvatarProbeHit)
  let unread_beats_later_hits = avatar_resolve(probe_internal: AvatarProbeUnread, probe_directory: AvatarProbeMiss, probe_cache: AvatarProbeHit)
  let all_miss = avatar_resolve(probe_internal: AvatarProbeMiss, probe_directory: AvatarProbeMiss, probe_cache: AvatarProbeMiss)
  (match from_internal { AvatarResolution { standing: AvatarResolved, source: AvatarFromInternalProfile } => true  _ => false })
    && (match from_directory { AvatarResolution { standing: AvatarResolved, source: AvatarFromGoogleDirectory } => true  _ => false })
    && (match from_cache { AvatarResolution { standing: AvatarResolved, source: AvatarFromCachedPrior } => true  _ => false })
    && (match unread_beats_later_hits { AvatarResolution { standing: AvatarResolved, source: AvatarFromCachedPrior } => true  _ => false })
    && (match all_miss { AvatarResolution { standing: AvatarAbsent, source: AvatarFromInitials } => true  _ => false })
    && avatar_initial_fallback(a: AvatarAbsent)
    && avatar_initial_fallback(a: AvatarUnread)
    && !avatar_initial_fallback(a: AvatarResolved)
    && avatar_initials_of(display_name: "Brian Searls") == "BS"
    && avatar_initials_of(display_name: "Fabric") == "F"
    && avatar_initials_of(display_name: "ops") == "o"
}

// THE SUGGESTIONS FEED (the autocomplete's population, owner mandate: fabric pinned near top,
// recents from durable assignment history, dedupe by stable principal): the seeds are ALWAYS
// PRESENT — the viewer first, fabric pinned second — the recents follow most-recent-first, and a
// recent naming a seed's subject never repeats it. Every row carries avatar + display name +
// email + kind.
test fn w_assign_suggestions_seeds_fabric_pinned_recents_deduped_by_subject() -> Bool {
  let suggestions = issue_assign_suggestions(viewer: "briansrls@gunb.ai", recent_emails: [
    "teammate@gunb.ai",
    "fabric@gunb.ai",
    "briansrls@gunb.ai",
    "teammate@gunb.ai",
  ])
  (match suggestions.first() {
    Present { value: p } => (p.primary_email as String) == "briansrls@gunb.ai" && (match p.kind { PrincipalKindHuman => true  PrincipalKindWorkflow => false })
    Absent => false
  })
    && (match suggestions.skip(n: 1).first() {
      Present { value: p } => (p.primary_email as String) == "fabric@gunb.ai" && (match p.kind { PrincipalKindWorkflow => true  PrincipalKindHuman => false })
      Absent => false
    })
    && (match suggestions.skip(n: 2).first() { Present { value: p } => (p.primary_email as String) == "teammate@gunb.ai"  Absent => false })
    && count(suggestions) == 3
    && count(issue_assign_suggestions(viewer: "", recent_emails: [])) == 1
    && (match issue_assign_suggestions(viewer: "", recent_emails: []).first() {
      Present { value: p } => (match p.kind { PrincipalKindWorkflow => true  PrincipalKindHuman => false })
      Absent => false
    })
}

// THE ROUTE'S VALIDATION TABLE: an email spelling (one @, dotted domain, no spaces) or the fabric
// endpoint in either spelling; everything else refuses. The canonical spelling normalizes the
// fabric qualified form to the display form — one endpoint, one wire spelling.
test fn w_assignee_validation_accepts_emails_and_fabric_refuses_everything_else() -> Bool {
  issue_assignee_input_valid(s: "briansrls@gunb.ai")
    && issue_assignee_input_valid(s: "  briansrls@gunb.ai  ")
    && issue_assignee_input_valid(s: "fabric@gunb.ai")
    && issue_assignee_input_valid(s: "worker:fabric/offered")
    && !issue_assignee_input_valid(s: "")
    && !issue_assignee_input_valid(s: "not-an-email")
    && !issue_assignee_input_valid(s: "a@b")
    && !issue_assignee_input_valid(s: "@gunb.ai")
    && !issue_assignee_input_valid(s: "two@at@gunb.ai")
    && !issue_assignee_input_valid(s: "has space@gunb.ai")
    && issue_assignee_is_fabric_endpoint(s: "worker:fabric/offered")
    && !issue_assignee_is_fabric_endpoint(s: "briansrls@gunb.ai")
    && issue_assignee_canonical(s: "worker:fabric/offered") == "fabric@gunb.ai"
    && issue_assignee_canonical(s: " briansrls@gunb.ai ") == "briansrls@gunb.ai"
    && !issue_assignee_input_is_email(s: "worker:fabric/offered")
}

// THE KIND AND STANDING WIRES, the class-suffix vocabulary the stylesheet binds.
test fn w_principal_kind_and_avatar_standing_wires() -> Bool {
  issue_principal_kind_wire(k: PrincipalKindHuman) == "human"
    && issue_principal_kind_wire(k: PrincipalKindWorkflow) == "workflow"
    && issue_avatar_standing_wire(a: AvatarResolved) == "resolved"
    && issue_avatar_standing_wire(a: AvatarAbsent) == "absent"
    && issue_avatar_standing_wire(a: AvatarUnread) == "unread"
}
