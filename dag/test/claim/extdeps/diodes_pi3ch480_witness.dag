module test.claim.extdeps.diodes_pi3ch480_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String }
import extdeps.electronic_component.diodes_pi3ch480 { pi3ch480_qex }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The PI3CH480QEX row publishes DS40329's page-8 Q-package mark; the mark names the QE package code, so
// the L (TSSOP) code is a near-miss that refuses.
test fn the_pi3ch480_qex_row_publishes_the_q_package_mark() -> Bool {
  match pi3ch480_qex.top_marking {
    Present { value: m } => ((m as String) == "PI3CH / 480QE_ / ZYWXX") && ((m as String) != "PI3CH / 480LE_ / ZYWXX")
    Absent => false
  }
}
