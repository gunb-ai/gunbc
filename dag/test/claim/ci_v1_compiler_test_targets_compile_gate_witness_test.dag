module test.claim.ci_v1_compiler_test_targets_compile_gate_witness

import gunbc.ci_workflow { ci_build_job }
import extdeps.github.actions { RunStep, UsesStep }
import v2.std.effect_plan { Do, EffectPlan }
import v2.std.operation_argv {
  OperationRef,
  operation_argv_bind_text_list
}
import v2.std.orchestration { FailFast }
import v2.workflow.ci_v1_compiler_test_targets_compile_gate_emit {
  ci_v1_compiler_test_targets_compile_gate_extra_args,
  ci_v1_compiler_test_targets_compile_gate_intent,
  ci_v1_compiler_test_targets_compile_gate_package,
  ci_v1_compiler_test_targets_compile_gate_refusal_prefix,
  ci_v1_compiler_test_targets_compile_gate_render,
  ci_v1_compiler_test_targets_compile_gate_script,
  ci_v1_compiler_test_targets_compile_gate_shell_emit_dissolution_trigger,
  ci_v1_compiler_test_targets_compile_gate_shell_emit_scaffold,
}
import v2.workflow.effect_plan_bash_materialize {
  BashBoundOperationInvocation,
  EffectPlanBashMaterializationRefused,
  EffectPlanBashMaterialized,
  bash_bind_operation_invocation,
  effect_plan_bash_materialize
}
import std.disposition { Scaffold }
import std.dissolution { dissolution_description }

data witness_subject_note: String = "Pins the v1-compiler test-targets compile gate the way its siblings are pinned (test.claim.ci_stage0_partition_compile_gate_witness, test.claim.ci_v1_compiler_tests_compile_gate_witness): the emitted argv, the scaffold disposition, the dissolve marker, the exact plan-plus-marker composition, build-job enrollment, and a RED refusal. Added on review of gunbc#8191, which enrolled the gate while pinning only the backstop sum — a new enrolled gate whose emitted script nothing asserts is DESIGN 5 specification-without-execution, and the reviewer was right that the sum alone does not establish the gate emits what it claims.

WHY THE ARGV IS PINNED TOKEN-BY-TOKEN AND NOT AS ONE STRING: the three tokens carry three separable facts that can each rot independently. `check` is the compile-only operation, and losing it to `test` would silently convert this gate into the execution gate the standing nextest ruling rejects. `-p v1-compiler` is the scope, and widening it to the workspace would re-check what the partition gate already covers. `--all-targets` is the ONLY reason the gate sees test targets at all — drop it and the step still passes, still looks enrolled, and covers exactly the population that was uncovered before this gate existed. That last case is the one a single-string assertion would miss most quietly, so each token gets its own conjunct."

fn gate_materialized_render(plan: EffectPlan<BashBoundOperationInvocation>) -> String {
  ci_v1_compiler_test_targets_compile_gate_render(plan: plan)
}

fn gate_plan_refuses(plan: EffectPlan<BashBoundOperationInvocation>) -> Bool {
  match effect_plan_bash_materialize(plan: plan) {
    EffectPlanBashMaterialized { source: _ } => false
    EffectPlanBashMaterializationRefused { refusal: _ } => true
  }
}

test fn w_v1_compiler_test_targets_gate_script_carries_check_scope_and_all_targets() -> Bool {
  let script = ci_v1_compiler_test_targets_compile_gate_script()
  string_contains(s: script, pattern: "check")
    && string_contains(s: script, pattern: ci_v1_compiler_test_targets_compile_gate_package)
    && string_contains(s: script, pattern: "--all-targets")
}

test fn w_v1_compiler_test_targets_gate_extra_args_are_exactly_scope_then_all_targets() -> Bool {
  let actual = ci_v1_compiler_test_targets_compile_gate_extra_args()
  let expected = ["-p", ci_v1_compiler_test_targets_compile_gate_package, "--all-targets"]
  actual == expected
}

test fn w_v1_compiler_test_targets_gate_shell_emit_is_scaffold_holds() -> Bool {
  match ci_v1_compiler_test_targets_compile_gate_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn w_v1_compiler_test_targets_gate_emit_carries_dissolve_marker_holds() -> Bool {
  string_contains(
    s: ci_v1_compiler_test_targets_compile_gate_script(),
    pattern: "🟡 dissolve-on: ci_v1_compiler_test_targets_compile_gate_script"
  )
}

test fn w_v1_compiler_test_targets_gate_script_is_typed_plan_plus_marker() -> Bool {
  let expected = concat(
    concat(
      "# ",
      concat(dissolution_description(condition: ci_v1_compiler_test_targets_compile_gate_shell_emit_dissolution_trigger), "\n")
    ),
    concat(
      gate_materialized_render(plan: ci_v1_compiler_test_targets_compile_gate_intent()),
      "\n"
    )
  )
  ci_v1_compiler_test_targets_compile_gate_script() == expected
}

test fn w_build_job_enrolls_v1_compiler_test_targets_compile_gate_holds() -> Bool {
  fold(ci_build_job().steps, init: false, f: (acc, step) => {
    acc || match step {
      RunStep { name: _, id: _, run: cmd, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
        string_contains(s: cmd, pattern: ci_v1_compiler_test_targets_compile_gate_package)
          && string_contains(s: cmd, pattern: "--all-targets")
      UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
    }
  })
}

test fn w_v1_compiler_test_targets_gate_RED_missing_operation_refuses() -> Bool {
  let bad_step = bash_bind_operation_invocation(
    at: OperationRef {
      path: "dag/extdeps/rust/cargo_build.dag",
      service: "cargo.Build",
      operation: "NoSuchCheck"
    },
    bindings: [
      operation_argv_bind_text_list(
        name: "extra_args",
        items: ci_v1_compiler_test_targets_compile_gate_extra_args()
      )
    ]
  )
  let refused_plan = EffectPlan {
    steps: [Do { effect: bad_step }],
    on_failure: FailFast
  }
  gate_plan_refuses(plan: refused_plan)
    && string_contains(
      s: gate_materialized_render(plan: refused_plan),
      pattern: ci_v1_compiler_test_targets_compile_gate_refusal_prefix
    )
}
