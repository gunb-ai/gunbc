module test.claim.cache_purity_verdict


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn sample_violation() -> CachePurityViolation {
  CachePurityViolation {
    content_key: "deadbeefdeadbeef",
    unkeyed_axis: "session_intern_state",
    warm_digest: "1111111111111111",
    cold_digest: "2222222222222222",
  }
}

fn witness_pure_on_match() -> Bool {
  match cache_purity_verdict(warm_equals_cold: true, violation: sample_violation()) {
    Pure => true
    _ => false
  }
}

fn witness_impure_on_divergence() -> Bool {
  match cache_purity_verdict(warm_equals_cold: false, violation: sample_violation()) {
    Impure { violation: _ } => true
    _ => false
  }
}

test fn cache_purity_verdict_witnesses() -> Bool {
  witness_pure_on_match()
    && witness_impure_on_divergence()
}
