  guest_artifact_verdict, guest_artifact_verdict_admits_build, guest_artifact_verdict_text,
  runner_guest_image_name, runner_guest_image_path, runner_guest_tree_dir,
  runner_guest_agent_unit, runner_guest_agent_unit_path,
