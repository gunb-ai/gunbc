}
import extdeps.tools.sha256sum { Sha256FileDigest, Sha256FileDigestUnavailable }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn the_credential_device() -> NonEmptyStr {
  match jit_drive_guest_device() {
    JitDriveDevice { device: d } => d
    JitDriveNotAttached { cause: _ } => "/dev/credential-drive-not-attached" as NonEmptyStr
  }
}

data a_digest: NonEmptyStr = "1111111111111111111111111111111111111111111111111111111111111111" as NonEmptyStr
data b_digest: NonEmptyStr = "2222222222222222222222222222222222222222222222222222222222222222" as NonEmptyStr

fn pinned_artifact() -> GuestBaseArtifact {
  GuestBaseArtifact {
    url: "https://example.invalid/a" as NonEmptyStr,
    filename: "a" as NonEmptyStr,
    integrity: ArtifactDigestPinned {
      digest: sha256_digest(hex: a_digest),
      provenance: FirstObservedOnFetch {
        observed_from: "witness" as NonEmptyStr,
        observed_on: "2026-09-05" as NonEmptyStr,
      },
    },
  }
}

fn unpinned_artifact() -> GuestBaseArtifact {
  GuestBaseArtifact {
    url: "https://example.invalid/b" as NonEmptyStr,
    filename: "b" as NonEmptyStr,
    integrity: ArtifactDigestUnpinned { cause: "not fetched yet" },
  }
}

// THE DISCRIMINATING RED. A pin exists and the bytes disagree with it: the build must not proceed.
// This is the arm the whole integrity type exists for, and it is the one an absorbing implementation
// would have widened into "accept whatever arrived" -- so it is driven from both sides, with the
// matching digest admitted in the same test.
test fn bytes_that_contradict_a_recorded_pin_refuse_the_build() -> Bool {
  let contradicted = guest_artifact_verdict(
    artifact: pinned_artifact(),
    observed: Sha256FileDigest { digest: sha256_digest(hex: b_digest) },
  )
  let agreeing = guest_artifact_verdict(
    artifact: pinned_artifact(),
    observed: Sha256FileDigest { digest: sha256_digest(hex: a_digest) },
  )
  !guest_artifact_verdict_admits_build(verdict: contradicted)
    && guest_artifact_verdict_admits_build(verdict: agreeing)
    && (match contradicted {
      ArtifactContradictsPin { expected_hex: e, observed_hex: o } => e == a_digest as String && o == b_digest as String
      _ => false
    })
    && (match agreeing { ArtifactMatchesPin => true  _ => false })
}

// FIRST CONTACT IS NOT A MATCH AND IT IS NOT A REFUSAL, and telling those three apart is the point
// of the coproduct. An unpinned artifact reports the digest it observed so a row can be authored
// from it; a measurement that could not be TAKEN refuses, because an unreadable file is not the
// same event as a file whose bytes are new.
test fn an_unpinned_artifact_reports_first_contact_and_an_unreadable_one_refuses() -> Bool {
  let first = guest_artifact_verdict(
    artifact: unpinned_artifact(),
    observed: Sha256FileDigest { digest: sha256_digest(hex: b_digest) },
  )
  let unreadable = guest_artifact_verdict(
    artifact: unpinned_artifact(),
    observed: Sha256FileDigestUnavailable { path: "b" as NonEmptyStr, reason: "sha256sum could not read the file" },
  )
  guest_artifact_verdict_admits_build(verdict: first)
    && !guest_artifact_verdict_admits_build(verdict: unreadable)
    && (match first {
      ArtifactUnpinnedFirstContact { digest_hex: h } => h == b_digest as String
      _ => false
    })
    && (match unreadable { ArtifactNotMeasured { reason: _ } => true  _ => false })
}

// THE BUILT IMAGE IS A RECEIPT AND MUST NEVER BE ADVISED AS A PIN, and this control exists because
// the receipt said the opposite on a real run. fleet-converge run 33996923229 printed "author this
// as ArtifactDigestPinned with FirstObservedOnFetch provenance" beside the image THAT BUILD had just
// produced -- advice that, followed, pins a digest which legitimately changes whenever the tree does
// and demands byte-reproducible mke2fs output to stay green.
//
// THE RED IS AUTHORABLE AND IS THE OLD BEHAVIOUR: give the built-image artifact ArtifactDigestUnpinned
// and this goes red on both halves, because that arm is the one carrying the pin advice. The two
// halves are separate on purpose -- asserting only that the text differs would pass on any wording
// change, so the first pins the arm and the second pins what the arm must NOT tell a reader to do.
test fn the_built_image_reports_a_receipt_and_never_advises_authoring_a_pin() -> Bool {
  let v = guest_artifact_verdict(
    artifact: runner_guest_built_image_artifact,
    observed: Sha256FileDigest { digest: sha256_digest(hex: b_digest) },
  )
  let rendered = guest_artifact_verdict_text(artifact: runner_guest_built_image_artifact, verdict: v)
  (match v { ArtifactBuildReceipt { digest_hex: h } => h == b_digest as String  _ => false })
    && !string_contains(s: rendered, pattern: "ArtifactDigestPinned")
    && guest_artifact_verdict_admits_build(verdict: v)
}

// THE IMAGE PATH CARRIES THE WHOLE IDENTITY, so a runner bump cannot land on the path the previous
// release's image occupies. The red here is a second image differing ONLY in the runner release.
test fn two_images_differing_only_in_the_runner_release_do_not_share_a_path() -> Bool {
  let a = gunbc_runner_guest_image
  let b = RunnerGuestImage {
    distribution: a.distribution,
    release_series: a.release_series,
    arch: a.arch,
    runner: ActionsRunnerRelease {
      version: "0.0.0-witness" as NonEmptyStr,
      digest_aarch64: sha256_digest(hex: a_digest),
      digest_x86_64: sha256_digest(hex: b_digest),
    },
  }
  runner_guest_image_name(image: a) != runner_guest_image_name(image: b)
    && runner_guest_image_path(root: "/r", image: a) != runner_guest_image_path(root: "/r", image: b)
    && runner_guest_tree_dir(root: "/r", image: a) != runner_guest_tree_dir(root: "/r", image: b)
}

// THE POWER-OFF IS UNCONDITIONAL, AND THIS IS THE ASSERTION THAT SAYS SO IN BYTES. SuccessAction= and
// FailureAction= are the manager's own reaction to the unit ending, so they cover the arm where no
// command can be spawned at all. The red is either one missing, or the power-off regressing to a
// command line (which cannot run on the start-failed arm).
test fn the_guest_agent_powers_the_machine_off_on_every_arm() -> Bool {
  let text = serialize_systemd_unit_file(file: runner_guest_agent_unit(image: gunbc_runner_guest_image, credential_device: the_credential_device()))
  string_contains(s: text, pattern: "SuccessAction=poweroff-force")
    && string_contains(s: text, pattern: "FailureAction=poweroff-force")
    && !string_contains(s: text, pattern: "poweroff -f")
    && string_contains(s: text, pattern: "StandardOutput=journal+console")
    && string_contains(s: text, pattern: "WantedBy=multi-user.target")
}

// THE LISTENER IS THE PRINCIPAL WORKLOAD AND run.sh IS NOT, so a return code of 2 has no loop to
// re-enter: the listener's exit is the unit's exit. The red is any revision that launches run.sh (or
// run-helper.sh), or adds a restart policy, either of which keeps a spent one-job VM alive.
test fn the_listener_runs_once_with_no_relaunch_loop() -> Bool {
  let text = serialize_systemd_unit_file(file: runner_guest_agent_unit(image: gunbc_runner_guest_image, credential_device: the_credential_device()))
  string_contains(s: text, pattern: "ExecStart=/opt/actions-runner/bin/Runner.Listener run")
    && !string_contains(s: text, pattern: "run.sh")
    && !string_contains(s: text, pattern: "run-helper")
    && string_contains(s: text, pattern: "Restart=no")
    && string_contains(s: text, pattern: "Type=exec")
}

// THE CREDENTIAL IS READ FROM THE DEVICE BY systemd, NEVER PASSED ON A COMMAND LINE, and every program
// the agent runs is named absolutely (the Mt. Collins PATH lesson). The job PATH is declared.
test fn the_credential_arrives_by_environment_file_and_every_program_is_absolute() -> Bool {
  let text = serialize_systemd_unit_file(file: runner_guest_agent_unit(image: gunbc_runner_guest_image, credential_device: the_credential_device()))
  string_contains(s: text, pattern: "EnvironmentFile=-/dev/vdb")
    && !string_contains(s: text, pattern: "--jitconfig")
    && string_contains(s: text, pattern: "Environment=PATH=/usr/local/sbin:")
    && string_contains(s: text, pattern: "ExecStartPre=/usr/bin/echo gunbc-guest-observation guest-booted")
    && string_contains(s: text, pattern: "ExecStartPre=/opt/actions-runner/bin/Runner.Listener --version")
    && string_contains(s: text, pattern: "ExecStartPost=/usr/bin/echo gunbc-guest-observation runner-started")
    && string_contains(s: text, pattern: "ExecStopPost=-/usr/bin/echo gunbc-guest-observation runner-exited")
    && string_contains(s: text, pattern: join([" exit_code=", "$", "{", "EXIT_CODE", "}", " exit_status=", "$", "{", "EXIT_STATUS", "}"], ""))
}

// THE DRIVE BYTES SURVIVE A BLOCK DEVICE. Firecracker drops a partial tail sector, so the contract
// pads to a whole number of extdeps.virtualization.firecracker firecracker_block_sector_size; the red is an unpadded content (a real 4,076-byte config would lose its
// last 492 bytes). The padding must be newlines, which systemd's parser skips, and the assignment
// must be upstream's own argument variable.
test fn the_credential_drive_is_whole_sectors_of_one_assignment() -> Bool {
  let c = jit_drive_content(encoded_jit_config: "eyJhIjoiYiJ9" as NonEmptyStr)
  let sector = byte_size_count(b: firecracker_block_sector_size)
  string_length(s: c) % sector == 0
    && string_length(s: c) == sector
    && string_length(s: jit_drive_newline_sector()) == sector
    && starts_with(s: c, prefix: "ACTIONS_RUNNER_INPUT_jitconfig=eyJhIjoiYiJ9\n\n")
    && !string_contains(s: c, pattern: " ")
}

// THE HOST READS THE FOUR EVENTS OFF THE CONSOLE, and the reader is driven with the exact lines the
// unit emits -- so an edit to the emitter that the reader does not follow reds here rather than on a
// VM. RunnerListening is read from upstream's own line, and a line merely mentioning the marker
// without a known kind is not an observation.
test fn every_emitted_observation_is_read_back_as_its_own_kind() -> Bool {
  let img = gunbc_runner_guest_image
  let console = join([
    "[   3.1] ", guest_observation_line(event: GuestBooted, image: img), "\n",
    guest_observation_line(event: RunnerStarted, image: img), "\n",
    "2026-09-19 05:20:04Z: Listening for Jobs\n",
    guest_observation_line(event: RunnerExited, image: img), " exit_code=exited exit_status=0\n",
    "gunbc-guest-observation something-else image=x\n",
  ], "")
  let labels = list_map(xs: guest_console_observations(console: console), f: fn(k) { guest_observation_kind_label(kind: k) })
  labels == ["guest-booted", "runner-started", "runner-listening", "runner-exited"]
    && guest_console_carries(console: console, kind: RunnerListening)
    && !guest_console_carries(console: "Listening for nothing", kind: GuestEmitted { event: GuestBooted })
}

// THE REGRESSION CONTROL FOR THE ACTIVATION DEFECT, and it is written against the mechanism systemd
// actually reads rather than against the unit's own text.
//
// The previous witness here asserted that `WantedBy=multi-user.target` appeared in the unit and that
// a second file landed under multi-user.target.wants/. Both assertions were TRUE and the image still
// did not start its agent: systemd's dependency loader skips any entry in a .wants/ directory that is
// not a symlink, so the second file was inert. A correct assertion over the wrong subject -- it could
// never have gone red for the reason that mattered.
//
// This asserts the drop-in instead: a `<target>.d/*.conf` fragment carrying `Wants=` naming the
// service, which is merged into the target by the ordinary drop-in path and has no symlink
// requirement. The red is a build that stops emitting that fragment, or emits one that does not name
// the unit -- which is exactly the state the merged image was in.
test fn the_agent_is_pulled_in_by_a_drop_in_systemd_will_actually_read() -> Bool {
  let path = runner_guest_agent_drop_in_path(root: "/r", image: gunbc_runner_guest_image)
  let body = serialize_systemd_drop_in(drop_in: runner_guest_agent_target_drop_in())
  string_contains(s: path, pattern: "/etc/systemd/system/multi-user.target.d/")
    && string_contains(s: path, pattern: ".conf")
    && string_contains(s: body, pattern: "[Unit]")
    && string_contains(s: body, pattern: "Wants=gunbc-runner-agent.service")
    && path != runner_guest_agent_unit_path(root: "/r", image: gunbc_runner_guest_image)
}

// NOTHING IS WRITTEN INTO A .wants/ DIRECTORY ANY MORE, and this says so directly. A future author
// restoring the "just copy the unit into .wants/" shortcut reds here even if the drop-in above still
// stands, because the failure mode was an INERT file that looked like activation.
test fn no_placement_relies_on_a_regular_file_in_a_wants_directory() -> Bool {
  !string_contains(s: runner_guest_agent_drop_in_path(root: "/r", image: gunbc_runner_guest_image), pattern: ".wants/")
    && !string_contains(s: runner_guest_agent_unit_path(root: "/r", image: gunbc_runner_guest_image), pattern: ".wants/")
}

// THE mke2fs OPERAND CARRIES ITS UNIT. An unsuffixed fs-size is a BLOCK count, so a builder that
// rendered the bare number would size the image by a host-dependent heuristic. The `m` suffix is the
// whole reason the size is carried as a Mebibyte rather than an Int.
test fn the_filesystem_size_operand_is_denominated_rather_than_a_block_count() -> Bool {
  let c = mke2fs_populate_command(
    fs: runner_guest_image_filesystem,
    image_path: "/r/i.ext4",
    from_directory: "/r/t",
    size: runner_guest_image_size,
  )
  c.program as String == "mke2fs"
    && any(xs: c.arguments, predicate: fn(w) { w == "8192m" })
    && any(xs: c.arguments, predicate: fn(w) { w == "ext4" })
    && any(xs: c.arguments, predicate: fn(w) { w == "-d" })
}

// THE DEVICE THE GUEST READS IS DERIVED FROM THE DRIVE LIST, AND THE DERIVATION MATCHES WHAT A REAL
// GUEST SAW. The oracle is /dev/vdb as observed on hardware (gunbc.runner.runner_first_job_receipt:
// the Mt. Collins guest read its credential off /dev/vdb with root=/dev/vda), not a copy of a
// production row. Applied to the real runner_microvm_vm_config before and after the workspace drive,
// and to the rendered unit: prepending a drive moves the derived name, reds the hardware pin here,
// and the rendered EnvironmentFile= follows the derivation rather than a literal. Controls: root is
// /dev/vda, an unattached id has no name.
test fn the_credential_device_is_where_the_vm_config_puts_the_credential_drive() -> Bool {
  let cfg = runner_microvm_vm_config(
    rootfs_path: "/r/rootfs.ext4",
    jit_config_path: "/r/jit.img",
    kernel_path: "/r/vmlinux",
    net: GuestNetworkAbsent { cause: "witness" },
    size: gunbc_runner_microvm_declared_size,
    transport: gunbc_runner_jit_transport,
  )
  let with_work = attach_workspace_drive(config: cfg, path: "/r/work.img")
  let jit = jit_transport_drive_id(t: gunbc_runner_jit_transport)
  let observed_on_hardware = "/dev/vdb"
  let unit = serialize_systemd_unit_file(file: runner_guest_agent_unit(image: gunbc_runner_guest_image, credential_device: the_credential_device()))
  (match jit_drive_guest_device() { JitDriveDevice { device: d } => d as String == observed_on_hardware  JitDriveNotAttached { cause: _ } => false })
    && string_contains(s: unit, pattern: concat("EnvironmentFile=-", observed_on_hardware))
    && (match firecracker_drive_guest_device(drives: cfg.drives, drive_id: jit) { Present { value: d } => d == observed_on_hardware  Absent => false })
    && (match firecracker_drive_guest_device(drives: with_work.drives, drive_id: jit) { Present { value: d } => d == observed_on_hardware  Absent => false })
    && (match firecracker_drive_guest_device(drives: cfg.drives, drive_id: "rootfs" as NonEmptyStr) { Present { value: d } => d == "/dev/vda"  Absent => false })
    && (match firecracker_drive_guest_device(drives: cfg.drives, drive_id: "absent" as NonEmptyStr) { Present { value: _ } => false  Absent => true })
}
