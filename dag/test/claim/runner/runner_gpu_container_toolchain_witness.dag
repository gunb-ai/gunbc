module test.claim.runner.runner_gpu_container_toolchain_witness

// ══════════════════════════════════════════════════════════════════════════════════════════════
// THE NEVER-GREEN CONTRACT FOR THE GPU CONTAINER CAPABILITY
// ══════════════════════════════════════════════════════════════════════════════════════════════
//
// A slot that cannot run a container seeing a GPU must make the dependent instrument go red — never
// green with an empty observation. Two folds decide that, and both are pure, so both can be nailed
// here without a host under them:
//
//   * gunbc.runner.runner_gpu_container_toolchain runner_gpu_container_toolchain_ready — the
//     conjunctive four-arm gate. The container-sees-device arm is one of the four; if it is missing
//     or unobserved the gate is false even when the toolkit package, the CDI spec and the job-user
//     daemon all answer ok.
//   * gunbc.runner.runner_gpu_container_toolchain gpu_docker_labels_outcome_holds — the converge is
//     green only when the capability read back ready AND the label action was a grant. A revoke on an
//     unready host is the RIGHT action but a FAILED converge; a grant while unready is impossible and
//     is what this witness refuses.
//
// THE POSITIVE CONTROLS ARE NOT OPTIONAL. An assertion that the unready case goes red is satisfied by
// a gate that is hard-wired false; each red claim here is paired with the green case that only a
// correct gate can also admit. A test file whose every claim is a negative is a test file that passes
// on a module that does nothing.
//
// THE SUBORDINATE-RANGE CLAIMS ARE HERE TOO because a namespace collision is the failure mode that
// reads like something else (see the provisioning commentary in the module under test): a job user
// sharing a subordinate range with another account makes dockerd-rootless fail in a way that looks
// like a Docker bug. The plan fold must REFUSE, not install a broken daemon, so the refusal is pinned
// against the exact range pair srv3 shipped with (two accounts both at 100000+65536).

import std.logic { Bool }
import std.types { NonEmptyStr }
import std.algebra { trim, string_contains }

import product.host_identity { HostIdentity }

import gunbc.fleet.fleet_host_identity {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}

import gunbc.runner.runner_gpu_container_toolchain {
  GpuContainerArm,
  GpuContainerArmOk, GpuContainerArmMissing, GpuContainerArmUnobserved,
  GpuContainerToolchainReadback,
  runner_gpu_container_toolchain_ready,
  runner_gpu_container_toolchain_host_ready,
  GpuDockerLabelsOutcome,
  GpuDockerLabelsGranted, GpuDockerLabelsRevoked, GpuDockerLabelsFailed,
  gpu_docker_labels_outcome_holds,
  gpu_container_provision_nvidia_actions_for,
  gpu_container_provision_plan_has_refusal,
  gpu_container_provision_plan_step_names,
  gpu_container_provision_plan_check_count,
  gpu_container_provision_step_names_include,
  GpuContainerProvisionCheck,
  VerifyKeyringFingerprint,
  gpu_container_provision_check_verdict,
  GpuContainerProvisionStep,
  GpuContainerProvisioned, GpuContainerProvisionRefused, GpuContainerProvisionSkipped,
  gpu_container_subordinate_integrity_holds,
  gpu_container_provision_subuid_verify_step,
  gpu_container_provision_subgid_verify_step,
  GpuBrowserReadyObservation,
  BrowserReadyHeld, BrowserReadyAbsent, BrowserReadyUnobservable,
  gpu_docker_labels_resolve_browser_grant,
  GpuBrowserReadyGrant,
  BrowserGrantAllowed, BrowserGrantUndetermined,
}

import gunbc.runner.runner_registration_labels {
  runner_gpu_docker_ready_registration_labels,
  RunnerRegistrationLabelsResolution,
  RegistrationLabelsResolved, RegistrationLabelsRefused,
  gunbc_gpu_docker_label,
  gunbc_browser_ready_label,
}

import extdeps.shadow.subordinate_ids {
  SubordinateRange,
  SubordinateFileRead, SubordinateFileUnreadable,
  SubordinatePlanSteps, SubordinatePlanRefused,
  subordinate_collisions,
  plan_subordinate_file,
}

// ── THE READBACK GATE ────────────────────────────────────────────────────────────────────────

fn ok(detail: String) -> GpuContainerArm { GpuContainerArmOk { detail: detail } }
fn missing(detail: String) -> GpuContainerArm { GpuContainerArmMissing { detail: detail } }
fn unobserved(reason: String) -> GpuContainerArm { GpuContainerArmUnobserved { reason: reason } }

fn all_four_ok() -> GpuContainerToolchainReadback {
  GpuContainerToolchainReadback {
    job_user: "ghrunner" as NonEmptyStr,
    toolkit_package: ok("nvidia-container-toolkit"),
    cdi_spec: ok("nvidia.com/gpu=all"),
    job_user_daemon: ok("rootless"),
    container_sees_device: ok("GPU 0"),
  }
}

// A host that truly has the capability is ready. Without this, every red claim below is vacuous.
test fn a_host_with_all_four_arms_is_ready() -> Bool {
  runner_gpu_container_toolchain_ready(r: all_four_ok())
}

// THE DECIDING ARM: the container that sees no GPU makes the host not ready even though the package,
// the spec and the daemon all answer ok. This is the exact shape that would let a slot advertise the
// capability and the dependent instrument observe nothing — it must be unready.
test fn a_missing_container_device_arm_is_never_ready() -> Bool {
  let r = all_four_ok()
  runner_gpu_container_toolchain_ready(r: GpuContainerToolchainReadback {
    job_user: r.job_user,
    toolkit_package: r.toolkit_package,
    cdi_spec: r.cdi_spec,
    job_user_daemon: r.job_user_daemon,
    container_sees_device: missing("exited 125: no such device"),
  }) == false
}

// UNOBSERVED IS NOT OK. A leg that could not be run (transport refused, uid unknown) is a refusal to
// answer, not a green answer; the container arm in particular may never be treated as satisfied
// because it was never measured.
test fn an_unobserved_container_device_arm_is_never_ready() -> Bool {
  let r = all_four_ok()
  runner_gpu_container_toolchain_ready(r: GpuContainerToolchainReadback {
    job_user: r.job_user,
    toolkit_package: r.toolkit_package,
    cdi_spec: r.cdi_spec,
    job_user_daemon: r.job_user_daemon,
    container_sees_device: unobserved("job user uid unobserved"),
  }) == false
}

// The same refusal applied to each of the other three arms in turn: dropping any one of the four to
// missing makes the host unready, so no single arm can be silently forgotten by a later refactor.
test fn dropping_the_toolkit_arm_is_never_ready() -> Bool {
  let r = all_four_ok()
  runner_gpu_container_toolchain_ready(r: GpuContainerToolchainReadback {
    job_user: r.job_user,
    toolkit_package: missing("dpkg query empty"),
    cdi_spec: r.cdi_spec,
    job_user_daemon: r.job_user_daemon,
    container_sees_device: r.container_sees_device,
  }) == false
}

test fn dropping_the_cdi_spec_arm_is_never_ready() -> Bool {
  let r = all_four_ok()
  runner_gpu_container_toolchain_ready(r: GpuContainerToolchainReadback {
    job_user: r.job_user,
    toolkit_package: r.toolkit_package,
    cdi_spec: missing("no spec names the device"),
    job_user_daemon: r.job_user_daemon,
    container_sees_device: r.container_sees_device,
  }) == false
}

test fn dropping_the_job_user_daemon_arm_is_never_ready() -> Bool {
  let r = all_four_ok()
  runner_gpu_container_toolchain_ready(r: GpuContainerToolchainReadback {
    job_user: r.job_user,
    toolkit_package: r.toolkit_package,
    cdi_spec: r.cdi_spec,
    job_user_daemon: missing("socket silent"),
    container_sees_device: r.container_sees_device,
  }) == false
}

// ── THE LABEL ACTION GATE ────────────────────────────────────────────────────────────────────

// GRANTED AND READY is the only green pair. This is the positive control for the whole section.
test fn a_grant_on_a_ready_host_holds() -> Bool {
  gpu_docker_labels_outcome_holds(o: GpuDockerLabelsGranted, ready: true)
}

// A GRANT CANNOT BE GREEN WITHOUT THE CAPABILITY. If the readback is unready, a Granted outcome must
// not hold — otherwise a stale drop-in left by a previous converge could report green on a host that
// lost the toolkit.
test fn a_grant_on_an_unready_host_never_holds() -> Bool {
  gpu_docker_labels_outcome_holds(o: GpuDockerLabelsGranted, ready: false) == false
}

// A REVOKE ON AN UNREADY HOST IS THE RIGHT ACTION, and is still recorded correctly: holds() is true
// for the action being right, but the converge's own green test (ready && holds) is false because
// ready is false. This claim pins that the two are independent — holds() must not be collapsed into
// "is the converge green", which is what would let a revoke masquerade as success.
test fn a_revoke_on_an_unready_host_is_the_correct_action() -> Bool {
  gpu_docker_labels_outcome_holds(o: GpuDockerLabelsRevoked, ready: false)
}

// A revoke on a READY host is wrong — the host kept the capability but lost its label — so it does not
// hold, and combined with the green test it can never be reported as success.
test fn a_revoke_on_a_ready_host_does_not_hold() -> Bool {
  gpu_docker_labels_outcome_holds(o: GpuDockerLabelsRevoked, ready: true) == false
}

// A FAILURE holds on neither host, on either host: it is the one outcome with no green path.
test fn a_failed_label_action_never_holds() -> Bool {
  gpu_docker_labels_outcome_holds(o: GpuDockerLabelsFailed { cause: "refused" }, ready: true) == false
    && gpu_docker_labels_outcome_holds(o: GpuDockerLabelsFailed { cause: "refused" }, ready: false) == false
}

// THE CONVERGE'S GREEN TEST, spelled the way the wet entry spells it (ready && holds), is false for
// every unready combination — including the grant-on-stale-label shape — and true only for the one
// green pair above. This is the single line that turns the whole module on or off, so it is asserted
// as a table rather than left to the reader to re-derive.
fn converge_is_green(o: GpuDockerLabelsOutcome, ready: Bool) -> Bool {
  ready && gpu_docker_labels_outcome_holds(o: o, ready: ready)
}

test fn the_converge_is_green_only_for_a_grant_on_a_ready_host() -> Bool {
  converge_is_green(o: GpuDockerLabelsGranted, ready: true)
    && converge_is_green(o: GpuDockerLabelsGranted, ready: false) == false
    && converge_is_green(o: GpuDockerLabelsRevoked, ready: true) == false
    && converge_is_green(o: GpuDockerLabelsRevoked, ready: false) == false
    && converge_is_green(o: GpuDockerLabelsFailed { cause: "x" }, ready: true) == false
    && converge_is_green(o: GpuDockerLabelsFailed { cause: "x" }, ready: false) == false
}

// ── THE SUBORDINATE-RANGE PLAN ───────────────────────────────────────────────────────────────

// THE COLLISION SRV3 SHIPPED WITH, DETECTED. Two accounts both at 100000+65536 is exactly what srv3's
// /etc/subuid had; the collision fold must name the pair rather than pass it as a clean file.
test fn the_srv3_range_pair_is_reported_as_colliding() -> Bool {
  let a = SubordinateRange { account: "ghrunner" as NonEmptyStr, first: 100000, count: 65536 }
  let b = SubordinateRange { account: "ubuntu" as NonEmptyStr, first: 100000, count: 65536 }
  length(subordinate_collisions(rs: [a, b])) == 1
}

// A CLEAN FILE HAS NO COLLISION (the positive control for the claim above).
test fn disjoint_ranges_do_not_collide() -> Bool {
  let a = SubordinateRange { account: "ghrunner" as NonEmptyStr, first: 100000, count: 65536 }
  let b = SubordinateRange { account: "briansrls" as NonEmptyStr, first: 165536, count: 65536 }
  length(subordinate_collisions(rs: [a, b])) == 0
}

// THE PLAN REFUSES TO MOVE THE JOB USER ONTO A RANGE HELD BY AN ACCOUNT THE MODEL DID NOT NAME AS
// DISPLACEABLE. The job user is asked for 100000+65536, which the undeclared admin account "gunbc-fleet"
// already holds; the model only permits moving "briansrls". The plan must refuse rather than evict an
// account whose container store nobody has checked — moving it is the exact silent downgrade the manager's
// constraint forbids.
test fn a_plan_refuses_to_displace_an_undeclared_account() -> Bool {
  let reading = SubordinateFileRead {
    path: "/etc/subuid",
    ranges: [
      SubordinateRange { account: "ghrunner" as NonEmptyStr, first: 100000, count: 65536 },
      SubordinateRange { account: "gunbc-fleet" as NonEmptyStr, first: 100000, count: 65536 },
    ],
  }
  match plan_subordinate_file(
    path: "/etc/subuid",
    reading: reading,
    account: "ghrunner" as NonEmptyStr,
    want_first: 100000,
    want_count: 65536,
    displaceable: "briansrls" as NonEmptyStr,
    displaceable_store_free: true,
    displacee_regrant_first: 400000,
  ) {
    SubordinatePlanRefused { reason: _ } => true
    SubordinatePlanSteps { steps: _ } => false
  }
}

// THE PLAN REFUSES WHEN THE DISPLACEE CANNOT BE REGRACTED CLEARLY: moving the displacee onto a range
// that overlaps a surviving account must refuse, not create a fresh collision behind the job user's
// back. Here briansrls would be re-granted onto 165536, which gunbc-worker already holds.
test fn a_plan_refuses_when_the_regrant_would_collide() -> Bool {
  let reading = SubordinateFileRead {
    path: "/etc/subuid",
    ranges: [
      SubordinateRange { account: "ghrunner" as NonEmptyStr, first: 100000, count: 65536 },
      SubordinateRange { account: "briansrls" as NonEmptyStr, first: 100000, count: 65536 },
      SubordinateRange { account: "gunbc-worker" as NonEmptyStr, first: 165536, count: 65536 },
    ],
  }
  match plan_subordinate_file(
    path: "/etc/subuid",
    reading: reading,
    account: "ghrunner" as NonEmptyStr,
    want_first: 100000,
    want_count: 65536,
    displaceable: "briansrls" as NonEmptyStr,
    displaceable_store_free: true,
    displacee_regrant_first: 165536,
  ) {
    SubordinatePlanRefused { reason: _ } => true
    SubordinatePlanSteps { steps: _ } => false
  }
}

// AN UNREADABLE FILE REFUSES THE PLAN. It is not the same as an empty file: not-knowing is not
// permission to rewrite the file, and a plan that proceeded here could clobber ranges it never saw.
test fn an_unreadable_subordinate_file_refuses_the_plan() -> Bool {
  match plan_subordinate_file(
    path: "/etc/subgid",
    reading: SubordinateFileUnreadable { path: "/etc/subgid", cause: "EACCES" },
    account: "ghrunner" as NonEmptyStr,
    want_first: 100000,
    want_count: 65536,
    displaceable: "ubuntu" as NonEmptyStr,
    displaceable_store_free: true,
    displacee_regrant_first: 231072,
  ) {
    SubordinatePlanRefused { reason: _ } => true
    SubordinatePlanSteps { steps: _ } => false
  }
}

// THE CLEAN MOVE ON THE FILE SRV3 SHIPPED, WITH ITS MODEL-NAMED DISPLACEABLE ACCOUNT: ghrunner keeps
// 100000+65536, the admin account that collided with it is displaced and re-granted clear of everyone,
// and no account is left sharing a range. This is the case the whole collision machinery exists to
// make safe; if it refused, srv3 would never converge, so it must produce steps.
test fn the_srv3_collision_resolves_to_steps_when_the_named_account_moves() -> Bool {
  match plan_subordinate_file(
    path: "/etc/subuid",
    reading: SubordinateFileRead {
      path: "/etc/subuid",
      ranges: [
        SubordinateRange { account: "ghrunner" as NonEmptyStr, first: 100000, count: 65536 },
        SubordinateRange { account: "ubuntu" as NonEmptyStr, first: 100000, count: 65536 },
        SubordinateRange { account: "briansrls" as NonEmptyStr, first: 165536, count: 65536 },
      ],
    },
    account: "ghrunner" as NonEmptyStr,
    want_first: 100000,
    want_count: 65536,
    displaceable: "ubuntu" as NonEmptyStr,
    displaceable_store_free: true,
    displacee_regrant_first: 231072,
  ) {
    SubordinatePlanSteps { steps: _ } => true
    SubordinatePlanRefused { reason: _ } => false
  }
}

// THE SAME MOVE, BUT THE DISPLACEABLE ACCOUNT HAS A CONTAINER STORE. store_free=false is the readback
// saying "this account is running containers on the very range you want", which is the constraint the
// manager put on the re-range: a range move strands that account's images and containers owned by the
// old uids. The plan must refuse, so a converge never silently breaks a live store.
test fn the_plan_refuses_when_the_displaceable_account_has_a_store() -> Bool {
  match plan_subordinate_file(
    path: "/etc/subuid",
    reading: SubordinateFileRead {
      path: "/etc/subuid",
      ranges: [
        SubordinateRange { account: "ghrunner" as NonEmptyStr, first: 100000, count: 65536 },
        SubordinateRange { account: "ubuntu" as NonEmptyStr, first: 100000, count: 65536 },
      ],
    },
    account: "ghrunner" as NonEmptyStr,
    want_first: 100000,
    want_count: 65536,
    displaceable: "ubuntu" as NonEmptyStr,
    displaceable_store_free: false,
    displacee_regrant_first: 231072,
  ) {
    SubordinatePlanRefused { reason: _ } => true
    SubordinatePlanSteps { steps: _ } => false
  }
}

// ── THE NVIDIA REPO INSTALL IS NEVER FABRICATED ──────────────────────────────────────────────
//
// Review 86284 caught a hole of the kind a comment cannot prevent, and review 86305/86314 then removed the
// shell it lived in. The first version assembled the installer as a String and returned the empty string
// for a host with no declared row — and an empty file is a VALID shell script, `sh` reads it, runs nothing,
// exits 0, so the converge reported "nvidia repo install: ok". The fix was three-layered: the host row is
// read as typed data, absence becomes a refusal naming the host, and the executor independently refuses an
// empty body at the choke point where a body becomes a file.
//
// THE PROPERTY OUTLIVES BOTH FIXES, so it is claimed here rather than commented, and it now has a stricter
// form: an action list can be fabricated too. An empty list would reach the fold as "nothing needed doing"
// and read as success exactly as an empty script did, so a host the model does not describe must produce a
// REFUSAL, not a shorter plan. And the Desired side has to produce the steps the trust argument depends on:
// counting actions is not enough, because the step that can vanish without anything downstream noticing is
// the fingerprint check — remove it and the fetch still "succeeds", the dearmor still writes to the system
// keyring path, and the host ends up trusting unverified bytes.
//
// Both halves are needed. Asserting only "srv3 gets actions" would pass on an implementation that returned
// [] for every host. Asserting only "srv2 gets a refusal" would pass on an implementation that refused
// everyone.

// THE POSITIVE HALF: each host that declares the toolchain gets a real plan, and that plan contains the
// verification the trust argument rests on plus the sources file whose content is the model's own rendering.
test fn a_desired_host_gets_repo_actions_including_the_keyring_check() -> Bool {
  let a1 = gpu_container_provision_nvidia_actions_for(host: operator_host_srv1)
  let a3 = gpu_container_provision_nvidia_actions_for(host: operator_host_srv3)
  if length(a1) == 0 || length(a3) == 0 {
    false
  } else {
    let steps1 = gpu_container_provision_plan_step_names(actions: a1)
    let steps3 = gpu_container_provision_plan_step_names(actions: a3)
    // No refusal may hide in a Desired host's plan, and the checks must actually be there.
    !gpu_container_provision_plan_has_refusal(actions: a1)
      && !gpu_container_provision_plan_has_refusal(actions: a3)
      && gpu_container_provision_plan_check_count(actions: a1) > 0
      && gpu_container_provision_plan_check_count(actions: a3) > 0
      && gpu_container_provision_step_names_include(names: steps1, wanted: "nvidia keyring fingerprint verified")
      && gpu_container_provision_step_names_include(names: steps3, wanted: "nvidia keyring fingerprint verified")
      && gpu_container_provision_step_names_include(names: steps1, wanted: "nvidia apt sources")
      && gpu_container_provision_step_names_include(names: steps3, wanted: "apt index refresh")
  }
}

// THE NEGATIVE HALF, WHICH IS THE ORIGINAL BUG IN ITS NEW DRESSING: a host the model does not certify for
// this toolchain must answer with a REFUSAL that names the host — never an empty list (which the fold reads
// as "nothing to do", the same false green the empty script produced) and never any install step.
//
// All three non-Desired arms are exercised, because the old code collapsed them into ONE answer (`Absent`)
// and that collapse was half the defect: an unmeasured host and a host with no row at say very different
// things about what an operator should do next, and a refusal that cannot tell them apart cannot be acted
// on. srv2 and srv4 carry UNMEASURED rows (a row exists; nobody has read the host); srv9 carries no row at
// all. Each must refuse, name itself, and — the part that makes this a real refusal rather than a
// relabelled install — name no keyring, since a refusal that also describes fetching a key is a plan in
// disguise.
test fn an_uncertified_host_is_refused_by_every_non_desired_arm() -> Bool {
  match refusal_cause_for(host: operator_host_srv2) {
    Absent => false
    Present { value: c2 } =>
      if !string_contains(s: c2, pattern: "srv2") || !string_contains(s: c2, pattern: "UNMEASURED") {
        false
      } else {
        match refusal_cause_for(host: operator_host_srv9) {
          Absent => false
          Present { value: c9 } =>
            if !string_contains(s: c9, pattern: "srv9") || !string_contains(s: c9, pattern: "no GPU container toolchain row") {
              false
            } else {
              // A refusal must not smuggle in the install it is refusing.
              !string_contains(s: c2, pattern: "keyring")
                && !string_contains(s: c9, pattern: "keyring")
            }
          }
      }
  }
}

// ONE ACTION, OR NOTHING — the shape check that sits next to the wording check. A refusal is exactly one
// action of type ProvisionRefusal; anything else (an empty list, or a list carrying a leg alongside the
// refusal) is the fabrication in a different form, because the fold would then run something.
fn refusal_cause_for(host: HostIdentity) -> String? {
  let actions = gpu_container_provision_nvidia_actions_for(host: host)
  match actions.first() {
    Absent => Absent
    Present { value: ProvisionRefusal { step: _, cause: c } } =>
      if length(actions) == 1 { Present { value: c } } else { Absent }
    Present { value: _ } => Absent
  }
}

// THE FINGERPRINT DECISION ITSELF, AS DATA — the arm that replaced `… | grep -q <fingerprint> || exit 1`
// inside a shell string. Three cases, because a check that only ever sees success is not a check: the
// pinned key's real colon record (MEASURED on srv1 2026-10-25, byte-for-byte) passes; the same record with
// the fingerprint altered refuses; and output with no fpr record at all refuses. The second case is the one
// a substring shortcut would get wrong for the wrong reason, and the third is the case that would pass
// silently if "no output" were treated as "nothing to complain about".
test fn the_keyring_fingerprint_check_accepts_the_pinned_key_and_refuses_everything_else() -> Bool {
  let pinned = "C95B321B61E88C1809C4F759DDCAE044F796ECB0"
  let good = "pub:-:1024:1:0000000000000000:1600000000:::::::::\n"
    + "fpr:::::::::C95B321B61E88C1809C4F759DDCAE044F796ECB0:\n"
    + "sub:-:2048:1:1111111111111111:1600000001:::::::::\n"
    + "fpr:::::::::AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA:\n"
  let wrong = "pub:-:1024:1:0000000000000000:1600000000:::::::::\n"
    + "fpr:::::::::AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA:\n"
  let no_fpr = "pub:-:1024:1:0000000000000000:1600000000:::::::::\n"
  // The pinned key must be accepted even though it is NOT the first fpr record in the keyring: a keyring
  // holds a primary and its subkeys, and first-record-only would refuse a good key.
  match gpu_container_provision_check_verdict(check: VerifyKeyringFingerprint { keyring_path: "/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg", expected_fingerprint: pinned }, job_user: "ghrunner" as NonEmptyStr, stdout: good) {
    Absent =>
      match gpu_container_provision_check_verdict(check: VerifyKeyringFingerprint { keyring_path: "/k", expected_fingerprint: pinned }, job_user: "ghrunner" as NonEmptyStr, stdout: wrong) {
        Present { value: w } =>
          if !string_contains(s: w, pattern: "NvidiaKeyringFingerprintRefusal") {
            false
          } else {
            match gpu_container_provision_check_verdict(check: VerifyKeyringFingerprint { keyring_path: "/k", expected_fingerprint: pinned }, job_user: "ghrunner" as NonEmptyStr, stdout: no_fpr) {
              Present { value: n } => string_contains(s: n, pattern: "NvidiaKeyringFingerprintRefusal")
              Absent => false
            }
          }
        Absent => false
      }
    // The accepted key must produce NO refusal: a verdict that reports a problem with the good keyring
    // is the false-refusal direction, and it fails this witness as loudly as a false acceptance would.
    Present { value: _ } => false
  }
}

// ── SUBORDINATE INTEGRITY: THE HOST THAT PASSES EVERY PROBE AND MUST STILL BE RED ────────────
//
// Review 5644178843's finding was that `ready` could be true while the subordinate-range reconciliation
// had refused or half-applied, because the four capability arms describe the RUNNING system and none of
// them reads /etc/subuid or /etc/subgid. The shape that makes that visible is deliberately specific: the
// uid leg lands, the gid leg fails, and the dockerd that is already running — started under ranges that
// were correct when it started — answers every probe. Four ok arms, and the verdict has to be red.
//
// THE TESTS ARE WRITTEN AGAINST THE DECISION FUNCTION, not the inline expression in the converge, so the
// thing under test is the thing that runs: runner_gpu_container_toolchain_host_ready is what the wet
// converge calls, and a witness that tested a hand-copied conjunction would be certifying a copy.

fn prov(step: String) -> GpuContainerProvisionStep { GpuContainerProvisioned { step: step } }
fn refused(step: String) -> GpuContainerProvisionStep {
  GpuContainerProvisionRefused { step: step, cause: "leg refused" }
}
fn skipped(step: String) -> GpuContainerProvisionStep { GpuContainerProvisionSkipped { step: step, reason: "chain stopped" } }

// THE BASELINE WITHOUT WHICH EVERY RED CLAIM BELOW IS VACUOUS: a host that genuinely has both ranges
// verified, four ok arms, a good ensure and a good CDI generate is ready. If this fails, the gate is
// rejecting everyone and the "never green" claims pass for the wrong reason.
test fn both_ranges_verified_and_four_arms_ok_is_ready() -> Bool {
  runner_gpu_container_toolchain_host_ready(
    ensure_ok: true,
    cdi_ok: true,
    readback: all_four_ok(),
    provision_steps: [
      prov("staging directory"),
      prov("nvidia keyring fingerprint verified"),
      prov(gpu_container_provision_subuid_verify_step),
      prov(gpu_container_provision_subgid_verify_step),
    ],
  )
}

// THE DISCRIMINATING CASE, THE MID-MIGRATION HOST. uid migrated, gid refused. Every capability arm is ok
// — the daemon answers, the spec is present, nvidia-smi lists the devices — and the converge still must
// not be green. This is the case the old comment argued away by claiming a refused range meant no daemon
// and so a failed readback; on a host that already had working ranges, that inference is simply false.
test fn a_partially_migrated_host_with_four_ok_arms_is_never_ready() -> Bool {
  runner_gpu_container_toolchain_host_ready(
    ensure_ok: true,
    cdi_ok: true,
    readback: all_four_ok(),
    provision_steps: [
      prov("nvidia keyring fingerprint verified"),
      prov("nvidia apt sources"),
      prov(gpu_container_provision_subuid_verify_step),
      refused(gpu_container_provision_subgid_verify_step),
    ],
  ) == false
}

// THE SAME HOST SEEN THE OTHER WAY ROUND. Migration can stop on either file, and a gate that only
// recognises one direction is a gate that is half-built.
test fn uid_refused_with_gid_ok_is_never_ready() -> Bool {
  runner_gpu_container_toolchain_host_ready(
    ensure_ok: true,
    cdi_ok: true,
    readback: all_four_ok(),
    provision_steps: [
      refused(gpu_container_provision_subuid_verify_step),
      prov(gpu_container_provision_subgid_verify_step),
    ],
  ) == false
}

// NOT-RUN IS NOT-PASSED. When the fold stops at the first refusal the remaining steps are never emitted
// at all, so a chain that died before the verifications leaves them ABSENT. Absence must not satisfy a
// safety gate; only a step that actually ran and passed counts.
test fn absent_range_verifications_are_never_ready() -> Bool {
  runner_gpu_container_toolchain_host_ready(
    ensure_ok: true,
    cdi_ok: true,
    readback: all_four_ok(),
    provision_steps: [
      prov("staging directory"),
      prov("docker-ce repo install"),
      refused("apt index refresh"),
    ],
  ) == false
}

// SKIPPED IS NOT-PASSED EITHER. A step reported skipped is a step that did not verify anything, and a
// gate that accepted it would let a plan that decided not to check pass as a plan that checked.
test fn skipped_range_verifications_are_never_ready() -> Bool {
  runner_gpu_container_toolchain_host_ready(
    ensure_ok: true,
    cdi_ok: true,
    readback: all_four_ok(),
    provision_steps: [
      skipped(gpu_container_provision_subuid_verify_step),
      skipped(gpu_container_provision_subgid_verify_step),
    ],
  ) == false
}

// ONE VERIFICATION IS NOT BOTH. The two files are independent and the whole finding is about one of them
// moving without the other, so a gate satisfied by a single pass would reinstate the bug exactly.
test fn only_one_range_verified_is_never_ready() -> Bool {
  runner_gpu_container_toolchain_host_ready(
    ensure_ok: true,
    cdi_ok: true,
    readback: all_four_ok(),
    provision_steps: [prov(gpu_container_provision_subuid_verify_step)],
  ) == false
    && runner_gpu_container_toolchain_host_ready(
      ensure_ok: true,
      cdi_ok: true,
      readback: all_four_ok(),
      provision_steps: [prov(gpu_container_provision_subgid_verify_step)],
    ) == false
}

// A REFUSAL CAN ONLY BE SEEN AS A REFUSAL IF THE NAMES AGREE. The predicate matches on the step names,
// and the plan emits those same names from the same two rows; if a future edit renamed the row the plan
// emits while the predicate still asked for the old string, every host would fail forever (safe) — but if
// the predicate's string drifted to something the plan never emits, the gate would silently require a step
// that cannot exist and every host would be red forever, which an operator would experience as the
// capability being simply unobtainable. This pins the pair together: the rows are non-empty, distinct, and
// the predicate treats them as the two it needs.
test fn the_two_range_verifications_are_distinct_and_both_required() -> Bool {
  gpu_container_provision_subuid_verify_step != gpu_container_provision_subgid_verify_step
    && gpu_container_subordinate_integrity_holds(steps: [
      prov(gpu_container_provision_subuid_verify_step),
      prov(gpu_container_provision_subgid_verify_step),
    ])
    && !gpu_container_subordinate_integrity_holds(steps: [
      prov(gpu_container_provision_subuid_verify_step),
      prov("subgid verified (typo)"),
    ])
    // A refusal that happens to carry the right step name still must not count: the predicate asks what
    // PASSED, not what was mentioned.
    && !gpu_container_subordinate_integrity_holds(steps: [
      prov(gpu_container_provision_subuid_verify_step),
      refused(gpu_container_provision_subgid_verify_step),
    ])
}

// ── THE GPU DROP-IN NEVER RESTATES A BROWSER LABEL THE HOST NEVER EARNED ─────────────────────
//
// Review 86378's finding, in one sentence: the GPU label set was built on top of the browser-ready set, so
// the first GPU converge to succeed wrote an 86- drop-in advertising gunbc-browser-ready on a host whose
// browser converge had never certified anything — and srv1 is exactly such a host, where
// 85-browser-ready-labels.conf is absent although the browser mode has been dispatched. Browser jobs would
// have scheduled onto a host that cannot run a browser, with the browser side still reporting green.
//
// The repair is at the boundary where the derivation could not be justified: the renderer takes the
// browser half as an OBSERVATION and adds it only when observed. Three cases are asserted, because each
// one is a different way to get this wrong:
//   ABSENT must not carry the browser label — that is the fabricated capability;
//   HELD must carry it — dropping it would silently revoke a capability from a host that legitimately has
//     it, because the 86- file REPLACES the 85-'s LABELS_JSON rather than adding to it;
//   UNDETERMINED must produce no label set at all — "could not look" may not be answered either way.

fn gpu_labels_for(host: HostIdentity, browser_ready_granted: Bool) -> List<String> {
  match runner_gpu_docker_ready_registration_labels(host: host, browser_ready_granted: browser_ready_granted) {
    RegistrationLabelsResolved { labels: ls } => ls
    RegistrationLabelsRefused { host: _, cause: _ } => []
  }
}

// THE HOST THAT NEVER EARNED IT: srv1 has no browser drop-in, so the observed answer is ABSENT and the
// GPU label set must contain the host label and gunbc-gpu-docker and NOTHING browser-shaped.
test fn an_unearned_browser_label_is_never_restated_by_the_gpu_set() -> Bool {
  let ls = gpu_labels_for(host: operator_host_srv1, browser_ready_granted: false)
  length(ls) > 0
    && ls.any(l => l == gunbc_gpu_docker_label)
    && !ls.any(l => l == gunbc_browser_ready_label)
    && !ls.any(l => string_contains(s: l, pattern: "browser"))
}

// THE HOST THAT DID EARN IT: with the 85- drop-in read back carrying the token, the set must restate the
// browser label. This is not a nicety — systemd lets the later drop-in's Environment= replace the
// earlier one wholesale, so a GPU converge that omitted the browser label would revoke it from a host that
// has both toolchains, and the browser floor would stop scheduling there with nothing broken to find.
test fn an_observed_browser_label_is_restated_so_it_is_not_silently_revoked() -> Bool {
  let ls = gpu_labels_for(host: operator_host_srv1, browser_ready_granted: true)
  ls.any(l => l == gunbc_gpu_docker_label)
    && ls.any(l => l == gunbc_browser_ready_label)
}

// THE GRANT DECISION, ALL THREE ARMS. Held grants, absent declines, and an observation that could not be
// made yields NO Bool at all — so no caller can pass a guess down the same path a read would take.
test fn an_unobservable_browser_read_grants_nothing_and_offers_no_bool() -> Bool {
  match gpu_docker_labels_resolve_browser_grant(o: BrowserReadyHeld) {
    BrowserGrantAllowed { granted: g1, observed: _ } =>
      if g1 != true {
        false
      } else {
        match gpu_docker_labels_resolve_browser_grant(o: BrowserReadyAbsent) {
          BrowserGrantAllowed { granted: g2, observed: _ } =>
            if g2 != false {
              false
            } else {
              match gpu_docker_labels_resolve_browser_grant(o: BrowserReadyUnobservable { cause: "ssh refused" }) {
                BrowserGrantUndetermined { cause: c } =>
                  string_contains(s: c, pattern: "browser-ready observation failed")
                    && string_contains(s: c, pattern: "refusing to grant")
                BrowserGrantAllowed { granted: _, observed: _ } => false
              }
            }
          BrowserGrantUndetermined { cause: _ } => false
        }
      }
    BrowserGrantUndetermined { cause: _ } => false
  }
}

// THE LABEL SET IS NEVER EMPTY ON A GRANT, for either observation. An empty resolved set would reach the
// drop-in as a LABELS_JSON with no capability in it — the runner would start, register, and take nothing,
// which is the "green host, zero capacity" shape this module keeps being asked to make unrepresentable.
test fn the_gpu_label_set_always_carries_the_gpu_capability() -> Bool {
  gpu_labels_for(host: operator_host_srv1, browser_ready_granted: true).any(l => l == gunbc_gpu_docker_label)
    && gpu_labels_for(host: operator_host_srv1, browser_ready_granted: false).any(l => l == gunbc_gpu_docker_label)
    && gpu_labels_for(host: operator_host_srv3, browser_ready_granted: true).any(l => l == gunbc_gpu_docker_label)
    && gpu_labels_for(host: operator_host_srv3, browser_ready_granted: false).any(l => l == gunbc_gpu_docker_label)
}
