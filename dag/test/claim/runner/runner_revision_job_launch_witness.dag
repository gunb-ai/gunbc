module test.claim.runner.runner_revision_job_launch_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { Cons, Empty }
import std.measure { byte_size_count, hardware_thread_count, mebibyte_to_byte_size, gibibyte_to_byte_size, mebibyte, mebibyte_count }
import gunbc.runner.runner_microvm { gunbc_runner_microvm_declared_realization_allowance }
import extdeps.virtualization.firecracker { FirecrackerDrive, firecracker_block_sector_size }
import gunbc.runner.runner_microvm { jit_drive_utf8_size }
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_memory_max }
import extdeps.systemd.systemd_run { NamedUnitSetting }
import extdeps.systemd { MemoryMax }
import gunbc.runner.runner_revision_job_launch { revision_job_vm_config, revision_job_jailer_memory_property }
import gunbc.runner.runner_revision_job_guest { revision_job_guest_memory, revision_job_claim_envelope, revision_job_guest_os_allowance }
import gunbc.runner.runner_revision_job_stage { revision_job_spec_device_content }

// THE REVISION JOB'S VM, AS ITS CONFIG SAYS: no network interface, the drives in the order the guest
// unit names them with only the results and work drives writable, the spec padded to whole sectors,
// and RAM above the claims' envelope by the guest-OS allowance. The plan's authorization arm is
// cell_grant_agreement, whose refusals are claimed in runner_microvm_slot_controller_witness.

fn drive_signature(d: FirecrackerDrive) -> String {
  join([d.drive_id as String, if d.is_read_only { "ro" } else { "rw" }, if d.is_root_device { "root" } else { "" }], ":")
}

test fn the_vm_has_no_network_and_its_drives_in_the_guest_units_order() -> Bool {
  let cfg = revision_job_vm_config(vcpus: hardware_thread_count(4))
  count(cfg.network_interfaces) == 0
    && join(map(cfg.drives, d => drive_signature(d: d)), ",") == "revision-job-root:ro:root,revision-job-spec:ro:,revision-job-tree:ro:,revision-job-vendor:ro:,revision-job-results:rw:,revision-job-work:rw:"
    && cfg.machine_config.vcpu_count == 4
}

test fn the_vm_ram_exceeds_the_claim_envelope_and_the_spec_fills_whole_sectors() -> Bool {
  let sector = byte_size_count(b: firecracker_block_sector_size)
  byte_size_count(b: mebibyte_to_byte_size(m: revision_job_guest_memory())) > byte_size_count(b: revision_job_claim_envelope())
    && byte_size_count(b: jit_drive_utf8_size(text: revision_job_spec_device_content(spec_text: "GUNBC_CLAIM_SET_COMMIT=abc\n"))) % sector == 0
    && revision_job_spec_device_content(spec_text: "GUNBC_CLAIM_SET_COMMIT=abc\n").starts_with("GUNBC_CLAIM_SET_COMMIT=abc\n")
}

// THE VM FITS ITS OWN CELL: the jailer unit asks for the VM's RAM plus the realization allowance, and
// that is exactly the CI slot's row, no more -- the claims' envelope sits below the VM's RAM by the
// guest OS allowance. (Before, the VM asked for the row plus both allowances inside a cell of the row.)
fn jailer_memory_value() -> String {
  match revision_job_jailer_memory_property() {
    NamedUnitSetting { property: MemoryMax, value: v } => v as String
    _ => ""
  }
}

test fn the_jailer_unit_memory_the_plan_emits_is_exactly_the_slot_row() -> Bool {
  jailer_memory_value() == to_string(byte_size_count(b: gunbc_runner_slot_memory_max))
    && byte_size_count(b: revision_job_claim_envelope()) + byte_size_count(b: mebibyte_to_byte_size(m: revision_job_guest_os_allowance))
      == byte_size_count(b: mebibyte_to_byte_size(m: revision_job_guest_memory()))
}
