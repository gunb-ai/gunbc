module test.claim.runner.runner_microvm_lifecycle_realize_witness_test

import std.types { String, NonEmptyStr, Bool, List, Int }
import extdeps.posix.test_utility {
  PathExistenceReading, PathPresent, PathAbsentOrUnstattable, PathExistenceUnreadable,
  ContainedExistence, ContainedAbsent, ContainedPresent, ContainedUnreadable, contained_existence,
}
import gunbc.runner_microvm_lifecycle {
  CgroupSubtreeReadback, CgroupSubtreeEmpty, CgroupSubtreePopulated, CgroupSubtreeReadFailed,
  ResourceReadback, ResourceAbsent, ResourcePresent, ResourceUnreadable,
  TeardownStop, StoppedGracefully, StoppedByForce, StopFoundAlreadyQuiescent,
  ForceStopBoundExceeded, ForceNotAsked, ForceStopOutcomeUnobservable,
}
import gunbc.runner_microvm_lifecycle_realize {
  StopQuiescence, CgroupQuiet, CgroupStillHolding, CgroupNotQuiet, CgroupHoldsTasks, CgroupHoldReadFailed,
  force_stop_outcome_after_ask, absence_of_containment, parent_directory_of,
  MountTableReading, MountTableRead, MountTableUnread,
  path_is_at_or_under, attempt_owned_mount_points, mount_table_of_body, mounts_removed_readback,
}
import extdeps.linux.proc_self_mountinfo {
  mountinfo_line_parse, ProcSelfMountinfoLineParse, MountinfoLineParsed, MountinfoLineRefused,
  MountinfoLineTooFewFields, MountinfoLineMissingSeparator, MountinfoLineEmptyMountPoint,
  ProcSelfMountinfoLineRefusal,
}

// THE REALIZE MODULE'S PURE FOLDS, CLAIMED WITHOUT A HOST.
//
// This module is mostly wet, and the wet receipt in test/manual covers the producers that reach the
// host. What it could not cover is the DECIDING folds in between -- the ones that turn a reading into
// an arm -- because a wet claim exercises them only along whichever path the host happened to take.
// Two of the discriminators the side chat named for gunbc#11803 live exactly there, and neither was
// authorable anywhere until this file existed.

// --- the force-stop outcome: four inputs, and the ask is one of them ---

fn force_label(asked: Bool, q: StopQuiescence) -> String {
  match force_stop_outcome_after_ask(asked: asked, ask_detail: "writing cgroup.kill failed: EACCES", q: q) {
    StoppedByForce => "by-force"
    ForceNotAsked { reason: _ } => "not-asked"
    ForceStopBoundExceeded { survivors: _ } => "bound-exceeded"
    ForceStopOutcomeUnobservable { reason: _ } => "unobservable"
    StoppedGracefully => "gracefully"
    StopFoundAlreadyQuiescent => "already-quiescent"
  }
}

fn populated() -> StopQuiescence {
  CgroupStillHolding { holding: CgroupHoldsTasks { pids: [4242], cgroups: ["srv2-04.slice" as NonEmptyStr] } }
}

fn unreadable_subtree() -> StopQuiescence {
  CgroupStillHolding { holding: CgroupHoldReadFailed { reason: "cgroup.events: EIO" as NonEmptyStr } }
}

// A FAILED cgroup.kill FOLLOWED BY A QUIET SUBTREE IS NOT A FORCE THAT WORKED.
//
// This is the discriminator for the defect review 69117 found and for the over-correction that
// followed it. The write result and the readback are two facts and the arm needs both: asked and
// quiet is the only combination that may claim StoppedByForce, because that arm says THIS
// controller's kill ended the cell. A kill that was never asked, over a subtree that went quiet
// anyway, is ForceNotAsked -- true, weaker, and it still lets the cgroup answer the
// surviving-process fact.
test fn a_kill_that_was_never_asked_never_reads_as_stopped_by_force() -> Bool {
  force_label(asked: true, q: CgroupQuiet) == "by-force"
    && force_label(asked: false, q: CgroupQuiet) == "not-asked"
}

// AND AN UNASKED KILL OVER A POPULATED SUBTREE IS NOT AN EXCEEDED BOUND EITHER, which is the half
// that would otherwise send an operator hunting an unkillable task. ForceStopBoundExceeded means a
// task the KERNEL could not end; it is reachable only when the kernel was actually asked.
test fn an_exceeded_bound_requires_the_kill_to_have_been_asked() -> Bool {
  force_label(asked: true, q: populated()) == "bound-exceeded"
    && force_label(asked: false, q: populated()) == "not-asked"
}

// A SUBTREE THAT COULD NOT BE READ IS UNOBSERVABLE WHATEVER THE ASK DID, because the reading, not
// the ask, is what would have established the fact.
test fn an_unreadable_subtree_is_unobservable_however_the_kill_went() -> Bool {
  force_label(asked: true, q: unreadable_subtree()) == "unobservable"
    && force_label(asked: false, q: unreadable_subtree()) == "unobservable"
}

// --- absence by containment ---

fn absence_label(parent: PathExistenceReading, child: PathExistenceReading) -> String {
  match absence_of_containment(
    path: "/srv/gunbc/cells/srv1-07/attempts/w-42",
    parent: "/srv/gunbc/cells/srv1-07/attempts",
    contained: contained_existence(
      path: "/srv/gunbc/cells/srv1-07/attempts/w-42",
      parent: "/srv/gunbc/cells/srv1-07/attempts",
      parent_reading: parent,
      child_reading: child,
    ),
  ) {
    ResourceAbsent => "absent"
    ResourcePresent { detail: _ } => "present"
    ResourceUnreadable { reason: _ } => "unreadable"
  }
}

// `test -e` FALSE IS NOT ABSENCE UNLESS THE PARENT WAS READ.
//
// POSIX gives `test` exit 1 for a path that is not there AND for one that cannot be STATTED -- a
// parent without search permission, a dead mount, an I/O error -- and offers nothing to tell them
// apart. ABSENT is the answer that RELEASES A CELL, so reading a bare false as absent would let a
// directory whose parent lost +x report the previous tenant's storage as gone while the files sit
// under it. Only a PRESENT parent makes the child's false mean absent, because then the directory was
// searched and the child was not in it.
//
// THE FIRST LINE IS THE ONE THAT MUST STAY TRUE and the other three are what the repair bought: the
// same child reading, three different parents, three different answers.
test fn a_false_test_e_means_absent_only_under_a_parent_that_was_read() -> Bool {
  absence_label(parent: PathPresent, child: PathAbsentOrUnstattable) == "absent"
    && absence_label(parent: PathAbsentOrUnstattable, child: PathAbsentOrUnstattable) == "unreadable"
    && absence_label(parent: PathExistenceUnreadable { reason: "test -e exited 126" as NonEmptyStr }, child: PathAbsentOrUnstattable) == "unreadable"
}

// A PRESENT CHILD IS PRESENT WHATEVER THE PARENT SAID, and an unreadable child is unreadable -- the
// containment rule applies to the FALSE reading only, and a claim that did not pin these two would
// pass against a fold that answered "unreadable" to everything.
test fn containment_only_governs_the_false_reading() -> Bool {
  absence_label(parent: PathPresent, child: PathPresent) == "present"
    && absence_label(parent: PathAbsentOrUnstattable, child: PathPresent) == "present"
    && absence_label(parent: PathPresent, child: PathExistenceUnreadable { reason: "EIO" as NonEmptyStr }) == "unreadable"
}

// THE PARENT IS THE PATH THE CONTAINMENT RULE ASKS ABOUT, and every path this controller proves
// absent is absolute and attempt-derived, so the interesting cases are the deep one and the root.
test fn the_parent_of_an_attempt_path_is_its_directory() -> Bool {
  parent_directory_of(path: "/srv/gunbc/cells/srv1-07/attempts/w-42") == "/srv/gunbc/cells/srv1-07/attempts"
    && parent_directory_of(path: "/srv") == "/"
}


// --- the cleanup's deciding folds, claimed without a host ---

// `/run/a` IS NOT UNDER `/run/ab`, AND THIS IS THE WHOLE CLAIM. A bare `starts_with` says it is, and
// the consequence is not cosmetic in either direction the predicate is used: it decides which mount
// points this controller detaches and whether a store-recorded credential device is deleted at all.
// A sibling slot whose name extends this one's would have its mounts torn down by this attempt.
test fn a_sibling_whose_name_extends_the_root_is_not_under_it() -> Bool {
  path_is_at_or_under(path: "/srv/gunbc/attempts/w-4", root: "/srv/gunbc/attempts/w-42") == false
    && path_is_at_or_under(path: "/srv/gunbc/attempts/w-420", root: "/srv/gunbc/attempts/w-42") == false
    && path_is_at_or_under(path: "/srv/gunbc/attempts/w-42", root: "/srv/gunbc/attempts/w-42")
    && path_is_at_or_under(path: "/srv/gunbc/attempts/w-42/jail", root: "/srv/gunbc/attempts/w-42")
}

// AN EMPTY ROOT MATCHES NOTHING, because the alternative is that every path on the host is "under"
// it -- the widest possible delete set arrived at by an unset field.
test fn an_empty_attempt_root_owns_no_path() -> Bool {
  path_is_at_or_under(path: "/", root: "") == false
    && path_is_at_or_under(path: "/srv/gunbc/attempts/w-42", root: "") == false
}

fn mountinfo_fields_of(line: String) -> List<String> {
  filter(split(s: line, delimiter: " "), f => f != "")
}

fn mountinfo_mount_point_label(line: String) -> String {
  match mountinfo_line_parse(fields: mountinfo_fields_of(line: line)) {
    MountinfoLineParsed { mount_point: mp } => mp as String
    MountinfoLineRefused { cause: c } => mountinfo_refusal_label(cause: c)
  }
}

fn mountinfo_refusal_label(cause: ProcSelfMountinfoLineRefusal) -> String {
  match cause {
    MountinfoLineTooFewFields => "too-few-fields"
    MountinfoLineMissingSeparator => "missing-separator"
    MountinfoLineEmptyMountPoint => "empty-mount-point"
  }
}

// THE MOUNT POINT IS FIELD FIVE FROM THE LEFT AND THE OPTIONAL FIELDS ARE WHY THAT MATTERS. The two
// lines below differ ONLY by an optional field (`shared:1`) before the separator, and proc(5) admits
// zero or more of them. A reading that counted from the RIGHT -- which is tempting, because the
// three post-separator fields are fixed -- returns the mount point for the first line and something
// else for the second, so a claim over one line alone cannot tell the two implementations apart.
test fn the_mount_point_survives_an_optional_field() -> Bool {
  mountinfo_mount_point_label(line: "36 35 98:0 / /srv/gunbc/attempts/w-42/jail rw,noatime - ext4 /dev/root rw") == "/srv/gunbc/attempts/w-42/jail"
    && mountinfo_mount_point_label(line: "36 35 98:0 / /srv/gunbc/attempts/w-42/jail rw,noatime shared:1 - ext4 /dev/root rw") == "/srv/gunbc/attempts/w-42/jail"
}

// A LINE WITHOUT THE SEPARATOR IS REFUSED RATHER THAN READ AT THE INDEX ANYWAY. Field five exists in
// both of these -- the index would answer -- and the answer would be a mount point this model cannot
// establish is a mount point.
test fn a_line_the_model_cannot_locate_refuses() -> Bool {
  mountinfo_mount_point_label(line: "36 35 98:0 / /mnt rw ext4 /dev/root rw x") == "missing-separator"
    && mountinfo_mount_point_label(line: "36 35 98:0 / /mnt rw - ext4") == "too-few-fields"
}

fn mount_table_label(m: MountTableReading) -> String {
  match m {
    MountTableUnread { reason: _ } => "unread"
    MountTableRead { mount_points: ps } => join(["read:", to_string(i: (ps |> count))], "")
  }
}

data mountinfo_two_good_lines: String = "36 35 98:0 / /srv/gunbc/attempts/w-42/jail rw - ext4 /dev/root rw\n37 36 98:1 / /srv/gunbc/attempts/w-42/jail/run rw - tmpfs tmpfs rw\n"

// ONE LINE THIS MODEL CANNOT PARSE MAKES THE WHOLE TABLE UNREADABLE, and this is the discriminating
// case for the absorbing fallback: the obvious implementation skips the bad line and returns the two
// good ones, which reads as a SHORTER surviving mount set than the host actually has. Unreadable
// quarantines the slot; a short list releases it. The body below is the good body plus one truncated
// line, so the two claims differ by exactly that line.
test fn an_unparseable_line_makes_the_whole_table_unread() -> Bool {
  mount_table_label(m: mount_table_of_body(body: mountinfo_two_good_lines)) == "read:2"
    && mount_table_label(m: mount_table_of_body(body: join([mountinfo_two_good_lines, "38 36 98:2 /\n"], ""))) == "unread"
}

fn readback_label(r: ResourceReadback) -> String {
  match r {
    ResourceAbsent => "absent"
    ResourcePresent { detail: _ } => "present"
    ResourceUnreadable { reason: _ } => "unreadable"
  }
}

// AN UNREADABLE MOUNT TABLE IS NOT AN EMPTY ONE. Both arms have "no mount points to report" in
// common, and only one of them is evidence that no mount survived; collapsing them is the fail-open
// this readback exists to prevent.
test fn an_unread_mount_table_is_not_a_clean_one() -> Bool {
  readback_label(r: mounts_removed_readback(m: MountTableRead { mount_points: [] as List<NonEmptyStr> })) == "absent"
    && readback_label(r: mounts_removed_readback(m: MountTableUnread { reason: "/proc/self/mountinfo exited 1" as NonEmptyStr })) == "unreadable"
    && readback_label(r: mounts_removed_readback(m: MountTableRead { mount_points: ["/srv/gunbc/attempts/w-42/jail" as NonEmptyStr] })) == "present"
}

// THE ATTEMPT OWNS ITS OWN SUBTREE AND NOTHING ELSE. The host's own mounts and a SIBLING attempt's
// are both in this table, and a filter that kept either would have this controller detaching mounts
// it does not own -- the widening the cleanup's own annotation refuses.
test fn only_the_attempts_own_mounts_are_selected() -> Bool {
  (attempt_owned_mount_points(
    points: [
      "/" as NonEmptyStr,
      "/srv" as NonEmptyStr,
      "/srv/gunbc/attempts/w-4" as NonEmptyStr,
      "/srv/gunbc/attempts/w-42" as NonEmptyStr,
      "/srv/gunbc/attempts/w-42/jail" as NonEmptyStr,
    ],
    attempt_root: "/srv/gunbc/attempts/w-42",
  ) |> count) == 2
}
