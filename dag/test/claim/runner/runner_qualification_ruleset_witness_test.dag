module test.claim.runner_qualification_ruleset_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.transports.rest { RestExchangeSucceeded, RestExchangeStatusRefused }
import extdeps.github.rulesets {
  RulesetWire, RulesetSummaryWire, RulesetConditionsWire, RulesetRefNameConditionWire, RulesetRuleWire, RulesetBypassActor,
}
import extdeps.github.effect { ManageRepositoryRulesets, administration_write }
import gunbc.repository { gunbc_repository }
import gunbc.auth.github_credential { credential_authorizes }
import test.claim.github_app_registry { app_credential, observed_grant, runner_grant }
import gunbc.runner.runner_qualification_ruleset {
  qualification_ruleset_shape_refusal, qualification_ruleset_standing_of, qualification_ruleset_lookup,
  QualificationRulesetEnforced, QualificationRulesetRefused,
  RulesetFound, RulesetNotFound, RulesetAbsent, RulesetDuplicated, RulesetListUnreadable, RulesetOtherShape, RulesetReadUnreadable,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn rule(t: String) -> RulesetRuleWire { RulesetRuleWire { type: t, parameters: none } }

fn ruleset(enforcement: String, include: List<String>, rules: List<RulesetRuleWire>, bypass: List<RulesetBypassActor>?) -> RulesetWire {
  RulesetWire {
    id: 41,
    name: "runner-qualification-pins",
    target: "branch",
    enforcement: enforcement,
    current_user_can_bypass: "never",
    conditions: RulesetConditionsWire { ref_name: RulesetRefNameConditionWire { include: include, exclude: [] } },
    rules: rules,
    bypass_actors: bypass,
  }
}

data exact_rules: List<RulesetRuleWire> = [rule(t: "update"), rule(t: "non_fast_forward")]
data prefix: List<String> = ["refs/heads/qualification/**"]
data bypass_roster_not_returned: List<RulesetBypassActor>? = none

fn other_shape(r: RulesetWire) -> Bool {
  match qualification_ruleset_shape_refusal(r: r) { Present { value: _ } => true Absent => false }
}

// THE EXACT SHAPE IS THE ONLY ENFORCED ONE. Positive control: active, branch target, include exactly
// refs/heads/qualification/**, rules exactly update + non_fast_forward, bypass roster read and empty.
// REDs: evaluate-only enforcement; another include pattern; a missing update rule; an added creation or
// deletion rule (which would forbid creating or deleting a qualification branch); a bypass actor; a
// bypass roster that was not returned (an empty roster is then not established); an unreadable get.
test fn only_the_exact_ruleset_shape_is_enforced() -> Bool {
  (match qualification_ruleset_standing_of(read: RestExchangeSucceeded, ruleset: ruleset(enforcement: "active", include: prefix, rules: exact_rules, bypass: Present { value: [] })) {
    QualificationRulesetEnforced { active: a } => a.ruleset_id == 41
    QualificationRulesetRefused { refusal: _ } => false
  })
    && other_shape(r: ruleset(enforcement: "evaluate", include: prefix, rules: exact_rules, bypass: Present { value: [] }))
    && other_shape(r: ruleset(enforcement: "active", include: ["refs/heads/**"], rules: exact_rules, bypass: Present { value: [] }))
    && other_shape(r: ruleset(enforcement: "active", include: prefix, rules: [rule(t: "non_fast_forward")], bypass: Present { value: [] }))
    && other_shape(r: ruleset(enforcement: "active", include: prefix, rules: [rule(t: "update"), rule(t: "non_fast_forward"), rule(t: "creation")], bypass: Present { value: [] }))
    && other_shape(r: ruleset(enforcement: "active", include: prefix, rules: [rule(t: "update"), rule(t: "non_fast_forward"), rule(t: "deletion")], bypass: Present { value: [] }))
    && other_shape(r: ruleset(enforcement: "active", include: prefix, rules: exact_rules, bypass: Present { value: [RulesetBypassActor { actor_type: "RepositoryRole", actor_id: 5, bypass_mode: "always" }] }))
    && other_shape(r: ruleset(enforcement: "active", include: prefix, rules: exact_rules, bypass: bypass_roster_not_returned))
    && (match qualification_ruleset_standing_of(read: RestExchangeStatusRefused { status: 403, body: "fixture" }, ruleset: ruleset(enforcement: "active", include: prefix, rules: exact_rules, bypass: Present { value: [] })) {
      QualificationRulesetRefused { refusal: RulesetReadUnreadable { performance: _ } } => true
      _ => false
    })
}

fn summary(id: Int, name: String) -> RulesetSummaryWire {
  RulesetSummaryWire { id: id, name: name, target: "branch", enforcement: "active" }
}

// THE RULESET IS FOUND BY ITS EXACT NAME, ONCE. An absent name plans the create; a duplicated name or
// an unreadable listing refuses. Positive control: found once among others.
test fn the_ruleset_is_found_once_by_its_exact_name() -> Bool {
  (match qualification_ruleset_lookup(listed: RestExchangeSucceeded, rulesets: [summary(id: 7, name: "passing-ci"), summary(id: 41, name: "runner-qualification-pins")]) {
    RulesetFound { ruleset_id: id } => id == 41
    RulesetNotFound { refusal: _ } => false
  })
    && (match qualification_ruleset_lookup(listed: RestExchangeSucceeded, rulesets: [summary(id: 7, name: "passing-ci")]) {
      RulesetNotFound { refusal: RulesetAbsent } => true
      _ => false
    })
    && (match qualification_ruleset_lookup(listed: RestExchangeSucceeded, rulesets: [summary(id: 41, name: "runner-qualification-pins"), summary(id: 42, name: "runner-qualification-pins")]) {
      RulesetNotFound { refusal: RulesetDuplicated { count: c } } => c == 2
      _ => false
    })
    && (match qualification_ruleset_lookup(listed: RestExchangeStatusRefused { status: 404, body: "fixture" }, rulesets: []) {
      RulesetNotFound { refusal: RulesetListUnreadable { performance: _ } } => true
      _ => false
    })
}

// THE LIVE WRITE IS GATED ON ADMINISTRATION:WRITE. An installation whose observed grant lacks it is not
// authorized to manage rulesets (no request is sent); with it added, it is. The control-plane fixture is
// the registry witness's observed App grant.
test fn the_ruleset_write_requires_administration_write() -> Bool {
  let effect = ManageRepositoryRulesets { repository: gunbc_repository }
  !credential_authorizes(authority: app_credential, control_plane: observed_grant(perms: runner_grant), effect: effect)
    && credential_authorizes(authority: app_credential, control_plane: observed_grant(perms: concat(runner_grant, [administration_write])), effect: effect)
}
