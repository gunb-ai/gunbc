module test.claim.runner.runner_browser_toolchain_real_execution

import std.logic { Bool }
import std.types { NonEmptyStr, List, list_length }
import std.algebra { trim, list_append }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.curl { curl_download_command }
import extdeps.tools.mkdir { mkdir_parents_command }
import extdeps.tools.ldd { ldd_command }
import extdeps.exec.command { ArgvCommand }
import extdeps.tools.sha256sum { sha256sum_file_digest_via_shell, Sha256FileDigest, Sha256FileDigestUnavailable }
import extdeps.posix.test_utility { test_exists_command }
import extdeps.automation.playwright { playwright_1_62_1_npm_tarball }
import gunbc.command_runner { run_shell_command_capture, process_outcome_admitted, LocalExec }
import gunbc.verified_archive_install {
  ArchiveSha256, ArchiveNpmIntegrity, ArchiveDigestPin,
  verified_archive_install, verify_archive_digest,
  ArchiveInstalled, ArchiveDigestMismatched, ArchiveDigestMatches, ArchiveDigestMismatch,
}
import gunbc.runner_browser_toolchain {
  library_readback_wet, HostLibrariesResolved,
  RunnerBrowserToolchainLocation, runner_browser_toolchain_location_at, runner_browser_toolchain_readback_at_wet,
  tree_sha256_wet, TreeDigestObserved, TreeDigestUnobservable, TreeAdmitted, TreeContentMismatch,
  place_toolchain_wet, ToolchainAlreadyAdmitted, ToolchainPlacementRefused,
  observe_superseded_trees_wet, SupersededTreesObserved, runner_browser_toolchain_system_path, runner_browser_toolchain_ready,
}
