module test.claim.runner.runner_lost_boot_sweep_run_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused }
import gunbc.github_effect_perform { organization_runner_listing_page_merged }
import extdeps.github.actions_self_hosted_runners { OrganizationRunnerListWire, OrganizationRunnerWire }
import extdeps.uuid { uuid_of }
import std.decl_ref { decl_ref }
import gunbc.host.host_control_route { HostControlStanding }
import extdeps.github.app { GitHubAppInstallationId }
import extdeps.github.effect { GitHubOrganizationRef }
import gunbc.auth.github_apps { gunbai_ci_declared, gunbai_ci_declared_installation_id }
import gunbc.auth.github_credential { GitHubCredentialAuthority, ManagedAppInstallationCredential, GitHubCredentialProfileRef }
import gunbc.host.managed_host { ManagedHost, managed_hosts }
import gunbc.runner.runner_registration_labels { RunnerRegistrationLabelsResolution, RegistrationLabelsResolved }
import gunbc.machine_intake.host_capture_envelope { HostCaptureRunIdentity, KernelBootId }
import gunbc.runner.runner_slot_allocation { RunnerWidthDerived, RunnerWidthUnresolved, gunbc_runner_committed_width }
import gunbc.runner.runner_host_unit_slot { ServiceBootId, service_boot_id_of, service_slot_unit, current_service_population, current_service_population_over, CurrentServicePopulationRefusal, CurrentServicePopulationDerived, CurrentServicePopulationRefused, CurrentPopulationWidthUnresolved }
import gunbc.runner.runner_jit_deregistration {
  LostBootSweep, LostBootSweepSelected, LostBootSweepRefused, lost_boot_sweep, deregistration_name, deregistration_app, deregistration_installation,
  JitDeregistration, JitDeregistrationRefused, DeregistrationAuthorityForAnotherInstallation, SlotLostBoot,
}
import gunbc.runner.runner_lost_boot_sweep_run {
  LostBootCurrentInput, LostBootCurrentPresent, LostBootCurrentRefused, lost_boot_current_input,
  sweep_authority, sweep_host_standing, SweepHostBound, SweepHostNotManaged,
  sweep_report_lines, sweep_all_deregistered, deregistration_line, lost_boot_sweep_host_env_name,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data supplied_labels: RunnerRegistrationLabelsResolution = RegistrationLabelsResolved { labels: ["self-hosted", "linux", "ARM64", "gunbc-heavy", "gunbc-host-x"] }
data org: GitHubOrganizationRef = GitHubOrganizationRef { login: "gunb-ai" }

fn the_host() -> ManagedHost? { first(managed_hosts()) }

// A boot identity exists only through service_boot_id_of over a KernelBootId, so every fixture takes
// the real route; an unconstructible id reads as the empty name, which no assertion below accepts.
fn kernel_boot(id: String) -> HostCaptureRunIdentity {
  match uuid_of(text: id) {
    Present { value: u } => KernelBootId { boot_id: u }
    Absent => HistoricalAttemptOrdinal { ordinal: id as NonEmptyStr }
  }
}

data old_boot_id: String = "11111111-1111-4111-8111-111111111111"
data new_boot_id: String = "22222222-2222-4222-8222-222222222222"

fn unit(m: ManagedHost, id: String, index: Int) -> String {
  match service_boot_id_of(run: kernel_boot(id: id)) {
    Present { value: b } => service_slot_unit(host: m.host, boot: b, index: index) as String
    Absent => ""
  }
}

fn listing(names: List<String>) -> RestResult<OrganizationRunnerListWire> {
  RestAnswered { answer: OrganizationRunnerListWire {
    total_count: count(names),
    runners: names |> map(n => OrganizationRunnerWire { id: 1, name: n }),
  } }
}

// THE SUPPLIED SEALED POPULATION: a width of 2 and the supplied labels, because the host's offer is not
// yet in the fleet catalog. It supplies a width to a restricted constructor, so it is itself a boundary:
// admit_callers-restricted to run_sweep, which is restricted to the terminal claims that sweep over it.
fn supplied_population(host: HostControlStanding, id: String) -> SuppliedPopulation admit_callers: [
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "run_sweep"),
] {
  match service_boot_id_of(run: kernel_boot(id: id)) {
    Present { value: b } => SuppliedPopulationBuilt { standing: current_service_population_over(host: host, width: RunnerWidthDerived { slots: 2 }, registration_labels: supplied_labels, boot: b) }
    Absent => SuppliedPopulationMalformedBoot
  }
}

// THE CAUSE OF EACH NON-SWEEP OUTCOME IS ITS OWN ARM: a malformed current id, an unmanaged host and a
// refused population are three different facts, and none borrows another's refusal.
type SuppliedPopulation
  = SuppliedPopulationBuilt { standing: CurrentServicePopulationStanding }
  | SuppliedPopulationMalformedBoot

type SuppliedSweep
  = SuppliedSweepRan { sweep: LostBootSweep }
  | SuppliedBootMalformed
  | SuppliedHostNotManaged
  | SuppliedPopulationNotDerived { refusal: CurrentServicePopulationRefusal }

// THE SWEEP UNDER THE RUN'S OWN AUTHORITY, over a SUPPLIED listing (a witness discriminates at one
// interface): sweep_host_standing is the run's own host derivation, the labels are supplied because the
// host has no fleet offer today.
fn run_sweep(m: ManagedHost, authority: GitHubCredentialAuthority, current: String, names: List<String>) -> SuppliedSweep admit_callers: [
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "the_run_sweeps_stale_registrations_under_the_declared_installation"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "one_receipt_line_per_runner_and_any_refusal_fails_the_run"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "each_non_sweep_outcome_names_its_own_cause"),
] {
  match sweep_host_standing(host: m.host as String as NonEmptyStr) {
    SweepHostNotManaged { host: _ } => SuppliedHostNotManaged
    SweepHostBound { host: _, standing: s } =>
      match supplied_population(host: s, id: current) {
        SuppliedPopulationMalformedBoot => SuppliedBootMalformed
        SuppliedPopulationBuilt { standing: st } =>
          match st {
            CurrentServicePopulationDerived { population: p } =>
              SuppliedSweepRan { sweep: lost_boot_sweep(organization: org, population: p, authority: authority, listing: listing(names: names)) }
            CurrentServicePopulationRefused { refusal: r } => SuppliedPopulationNotDerived { refusal: r }
          }
      }
  }
}

// THE DISPATCH INPUT IS NEVER DEFAULTED. RED: an absent or blank boot id must refuse. Positive control:
// a real id is carried through unchanged.
test fn an_absent_current_boot_id_refuses_and_a_present_one_is_carried() -> Bool {
  (match lost_boot_current_input(raw: "") {
    LostBootCurrentRefused { cause: _ } => true
    LostBootCurrentPresent { boot: _ } => false
  }) && (match lost_boot_current_input(raw: new_boot_id) {
    LostBootCurrentPresent { boot: b } => (b.boot_id as String) == new_boot_id
    LostBootCurrentRefused { cause: _ } => false
  })
}

// THE HOST ENTERS ONLY THROUGH ITS managed_host ROW: a managed host binds, a name no row carries is
// not managed rather than defaulted into a standing.
test fn the_host_enters_only_through_its_managed_row() -> Bool {
  (match the_host() {
    Absent => false
    Present { value: m } => match sweep_host_standing(host: m.host as String as NonEmptyStr) {
      SweepHostBound { host: _, standing: _ } => true
      SweepHostNotManaged { host: _ } => false
    }
  }) && (match sweep_host_standing(host: "no-such-managed-host" as NonEmptyStr) {
    SweepHostNotManaged { host: h } => h == "no-such-managed-host"
    SweepHostBound { host: _, standing: _ } => false
  })
}

// STALE SELECTED, CURRENT UNTOUCHED, over the run's own authority, and the selected registration
// carries the boot id that made it stale (the SlotLostBoot payload) and the DECLARED installation --
// condition (4): an authority for another installation yields a registration for that installation,
// which ensure_jit_runner_deregistered refuses, so the declared pair is what the run must supply.
test fn the_run_sweeps_stale_registrations_under_the_declared_installation() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } => {
      let names = [unit(m: m, id: old_boot_id, index: 0), unit(m: m, id: new_boot_id, index: 0), "actions-runner@srv1-3.service"]
      (match run_sweep(m: m, authority: sweep_authority(), current: new_boot_id, names: names) {
SuppliedSweepRan { sweep: sw } => match sw {
        LostBootSweepSelected { subjects: rs, untouched: u } =>
          count(rs) == 1 && count(u) == 2
            && (match first(rs) {
              Present { value: s } => (deregistration_name(subject: s).value as String) == unit(m: m, id: old_boot_id, index: 0)
                && deregistration_installation(subject: s) == gunbai_ci_declared_installation_id
                && deregistration_app(subject: s) == gunbai_ci_declared
              Absent => false
            })
        LostBootSweepRefused { refusal: _ } => false
      }
SuppliedBootMalformed => false
SuppliedHostNotManaged => false
SuppliedPopulationNotDerived { refusal: _ } => false
}) && (match run_sweep(m: m, authority: other_installation_authority(), current: new_boot_id, names: names) {
SuppliedSweepRan { sweep: sw } => match sw {
        LostBootSweepSelected { subjects: rs, untouched: _ } =>
          (match first(rs) {
            Present { value: s } => deregistration_installation(subject: s) != gunbai_ci_declared_installation_id
            Absent => false
          })
        LostBootSweepRefused { refusal: _ } => false
      }
SuppliedBootMalformed => false
SuppliedHostNotManaged => false
SuppliedPopulationNotDerived { refusal: _ } => false
})
    }
  }
}

fn other_installation_authority() -> GitHubCredentialAuthority {
  ManagedAppInstallationCredential {
    app: gunbai_ci_declared,
    installation: GitHubAppInstallationId { value: 4242 },
    profile: GitHubCredentialProfileRef { name: "other" },
  }
}

// PER-RUNNER AGGREGATION: a refusal is a refused line naming its runner and fails the run; no
// selection (every listed name current or foreign) is a passing run whose untouched names still get
// one line each.
test fn one_receipt_line_per_runner_and_any_refusal_fails_the_run() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } => {
      let names = [unit(m: m, id: old_boot_id, index: 0), unit(m: m, id: old_boot_id, index: 1), unit(m: m, id: new_boot_id, index: 0)]
      match service_boot_id_of(run: kernel_boot(id: new_boot_id)) {
        Absent => false
        Present { value: current_boot } =>
      match run_sweep(m: m, authority: sweep_authority(), current: new_boot_id, names: names) {
SuppliedSweepRan { sweep: sw } => match sw {
        LostBootSweepRefused { refusal: _ } => false
        LostBootSweepSelected { subjects: rs, untouched: u } => {
          let refused = rs |> map(s => JitDeregistrationRefused {
            subject: s,
            exit: SlotLostBoot { superseded_by: current_boot },
            refusal: DeregistrationAuthorityForAnotherInstallation,
          })
          let lines = sweep_report_lines(outcomes: refused, untouched: u)
          count(lines) == 3
            && !sweep_all_deregistered(outcomes: refused)
            && sweep_all_deregistered(outcomes: [])
            && count(sweep_report_lines(outcomes: [], untouched: u)) == 1
            && (match first(refused) {
              Present { value: o } => deregistration_line(outcome: o) == concat("lost-boot-sweep runner=", concat(unit(m: m, id: old_boot_id, index: 0), " refused=authority-for-another-installation"))
              Absent => false
            })
        }
      }
SuppliedBootMalformed => false
SuppliedHostNotManaged => false
SuppliedPopulationNotDerived { refusal: _ } => false
}
      }
    }
  }
}

// PAIRING OBLIGATION (DESIGN 3): the witnesses above SUPPLY a population; this claim is the last execution
// of the mode's REAL route -- sweep_host_standing -> current_service_population (the host's committed
// width). The sealed population is refused at construction when the width cannot be derived, so a sweep
// cannot be called at all; the claim asserts the route's standing equals the independent
// gunbc_runner_committed_width reading, whichever arm the host is in today. RED: a route that yields a
// population while the width is unresolved (or refuses a derived one) fails this.
test fn the_real_route_population_follows_the_committed_width() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } =>
      match sweep_host_standing(host: m.host as String as NonEmptyStr) {
        SweepHostNotManaged { host: _ } => false
        SweepHostBound { host: _, standing: st } =>
          match service_boot_id_of(run: kernel_boot(id: new_boot_id)) {
            Absent => false
            Present { value: b } =>
              match gunbc_runner_committed_width(host: m.host) {
                RunnerWidthUnresolved { cause: _ } =>
                  match current_service_population(host: st, boot: b) {
                    CurrentServicePopulationRefused { refusal: CurrentPopulationWidthUnresolved { cause: _ } } => true
                    _ => false
                  }
                RunnerWidthDerived { slots: n } =>
                  match current_service_population(host: st, boot: b) {
                    CurrentServicePopulationDerived { population: p } => count(p.units) == n
                    _ => false
                  }
              }
          }
      }
  }
}

// A WRONG CAUSE MUST NOT PASS AS "REFUSED". A malformed current boot id is SuppliedBootMalformed -- not a
// host-control refusal, not an unmanaged host; a well-formed one over a controlled host yields a sweep.
// RED: any borrowed arm for the malformed id fails the first conjunct.
test fn each_non_sweep_outcome_names_its_own_cause() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } =>
      (match run_sweep(m: m, authority: sweep_authority(), current: "not-a-uuid", names: []) {
        SuppliedBootMalformed => true
        SuppliedSweepRan { sweep: _ } => false
        SuppliedHostNotManaged => false
        SuppliedPopulationNotDerived { refusal: _ } => false
      }) && (match run_sweep(m: m, authority: sweep_authority(), current: new_boot_id, names: []) {
        SuppliedSweepRan { sweep: _ } => true
        SuppliedBootMalformed => false
        SuppliedHostNotManaged => false
        SuppliedPopulationNotDerived { refusal: _ } => false
      })
  }
}

// PAGES THAT DISAGREE ON total_count DID NOT OBSERVE ONE POPULATION. RED: overwriting total_count with the
// latest page merges two populations and reads as complete. Positive control: agreeing pages merge in order.
test fn pages_disagreeing_on_total_count_refuse_and_agreeing_pages_merge() -> Bool {
  let first = OrganizationRunnerListWire { total_count: 2, runners: [OrganizationRunnerWire { id: 1, name: "a" }] }
  (match organization_runner_listing_page_merged(so_far: first, page: 2, read: OrganizationRunnerListWire { total_count: 3, runners: [OrganizationRunnerWire { id: 2, name: "b" }] }) {
    RestRefused { refusal: _ } => true
    RestAnswered { answer: _ } => false
  }) && (match organization_runner_listing_page_merged(so_far: first, page: 2, read: OrganizationRunnerListWire { total_count: 2, runners: [OrganizationRunnerWire { id: 2, name: "b" }] }) {
    RestAnswered { answer: w } => w.total_count == 2 && count(w.runners) == 2
    RestRefused { refusal: _ } => false
  })
}
