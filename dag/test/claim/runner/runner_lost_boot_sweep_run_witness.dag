data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data supplied_labels: RunnerRegistrationLabelsResolution = RegistrationLabelsResolved { labels: ["self-hosted", "linux", "ARM64", "gunbc-heavy", "gunbc-host-x"] }
data org: GitHubOrganizationRef = GitHubOrganizationRef { login: "gunb-ai" }

fn the_host() -> ManagedHost? { first(managed_hosts()) }

// A boot identity exists only through service_boot_id_of over a KernelBootId, so every fixture takes
// the real route; an unconstructible id reads as the empty name, which no assertion below accepts.
fn kernel_boot(id: String) -> HostCaptureRunIdentity {
  match uuid_of(text: id) {
    Present { value: u } => KernelBootId { boot_id: u }
    Absent => HistoricalAttemptOrdinal { ordinal: id as NonEmptyStr }
  }
}

data old_boot_id: String = "11111111-1111-4111-8111-111111111111"
data new_boot_id: String = "22222222-2222-4222-8222-222222222222"

fn unit(m: ManagedHost, id: String, index: Int) -> String {
  match service_boot_id_of(run: kernel_boot(id: id)) {
    Present { value: b } => service_slot_unit(host: m.host, boot: b, index: index) as String
    Absent => ""
  }
}

fn listing(names: List<String>) -> RestResult<OrganizationRunnerListWire> {
  RestAnswered { answer: OrganizationRunnerListWire {
    total_count: count(names),
    runners: names |> map(n => OrganizationRunnerWire { id: 1, name: n }),
  } }
}

// THE SUPPLIED SEALED POPULATION: a width of 2 and the supplied labels, because the host's offer is not
// yet in the fleet catalog. It supplies a width to a restricted constructor, so it is itself a boundary:
// admit_callers-restricted to run_sweep, which is restricted to the terminal claims that sweep over it.
fn supplied_population(host: HostControlStanding, id: String) -> SuppliedPopulation admit_callers: [
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "run_sweep"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "plan_over"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "plan_after_admission"),
] {
  match service_boot_id_of(run: kernel_boot(id: id)) {
    Present { value: b } => SuppliedPopulationBuilt { standing: current_service_population_over(host: host, width: RunnerWidthDerived { slots: 2 }, registration_labels: supplied_labels, boot: b) }
    Absent => SuppliedPopulationMalformedBoot
  }
}

// THE CAUSE OF EACH NON-SWEEP OUTCOME IS ITS OWN ARM: a malformed current id, an unmanaged host and a
// refused population are three different facts, and none borrows another's refusal.
type SuppliedPopulation
  = SuppliedPopulationBuilt { standing: CurrentServicePopulationStanding }
  | SuppliedPopulationMalformedBoot

type SuppliedSweep
  = SuppliedSweepRan { sweep: LostBootSweep }
  | SuppliedBootMalformed
  | SuppliedHostNotManaged
  | SuppliedPopulationNotDerived { refusal: CurrentServicePopulationRefusal }

// THE SWEEP UNDER THE RUN'S OWN AUTHORITY, over a SUPPLIED listing (a witness discriminates at one
// interface): sweep_host_standing is the run's own host derivation, the labels are supplied because the
// host has no fleet offer today.
fn run_sweep(m: ManagedHost, authority: GitHubCredentialAuthority, current: String, names: List<String>) -> SuppliedSweep admit_callers: [
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "the_run_sweeps_stale_registrations_under_the_declared_installation"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "one_receipt_line_per_runner_and_any_refusal_fails_the_run"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "each_non_sweep_outcome_names_its_own_cause"),
] {
  match sweep_host_standing(host: m.host as String as NonEmptyStr) {
    SweepHostNotManaged { host: _ } => SuppliedHostNotManaged
    SweepHostBound { host: _, standing: s } =>
      match supplied_population(host: s, id: current) {
        SuppliedPopulationMalformedBoot => SuppliedBootMalformed
        SuppliedPopulationBuilt { standing: st } =>
          match st {
            CurrentServicePopulationDerived { population: p } =>
              SuppliedSweepRan { sweep: lost_boot_sweep(organization: org, population: p, authority: authority, listing: listing(names: names)) }
            CurrentServicePopulationRefused { refusal: r } => SuppliedPopulationNotDerived { refusal: r }
          }
      }
  }
}

data capture_boot_id: String = "aaaaaaaa-0000-4000-8000-000000000001"

// A FIXTURE THAT SUPPLIES A READING IS A BOUNDARY: observed_on names the host's boot by assertion, so it is
// admit_callers-restricted to the terminal claims below and its one mint is admitted to it by name.
fn observed_on(host: String, id: String) -> CurrentBootObservation admit_callers: [
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "an_admitted_envelope_on_the_observed_boot_yields_exactly_that_boot"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "an_authentic_capture_of_an_earlier_boot_refuses"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "a_missing_or_foreign_current_boot_observation_refuses"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "an_envelope_that_does_not_establish_runner_host_up_refuses"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "a_missing_envelope_or_blank_input_refuses"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "a_capture_read_from_a_file_reaches_the_admission"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "an_earlier_boot_capture_admits_no_plan_over_a_live_registration"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "an_observed_boot_capture_plans_exactly_the_stale_registration"),
] {
  match service_boot_id_of(run: kernel_boot(id: id)) {
    Present { value: b } => CurrentBootObserved { evidence: mint_current_boot_evidence(host: host, boot: b) }
    Absent => CurrentBootUnobserved { cause: "unconstructible boot id" }
  }
}

// THE CAPTURE RECORDS A BOOT AND THE HOST'S OWN OBSERVATION ESTABLISHES THE CURRENT ONE (review 82195,
// then the HOLD at 82eaac6e). Positive control: a closed envelope bound to the swept host, joined to an
// observation of the same host and boot, yields exactly the boot it carries, and not new_boot_id.
test fn an_admitted_envelope_on_the_observed_boot_yields_exactly_that_boot() -> Bool {
  match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: closed(install_exit: "0", machine: "aarch64"), observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentPresent { host: h, boot: b } => (h as String) == "mtcollins1" && (b.boot_id as String) == capture_boot_id && (b.boot_id as String) != new_boot_id
    LostBootCurrentRefused { cause: _ } => false
  }
}

// RED: an authentic closed capture of boot A, the host now on boot B. The capture is not the current
// boot, so the sweep refuses and the live B registrations never become deletion subjects.
test fn an_authentic_capture_of_an_earlier_boot_refuses() -> Bool {
  match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: closed(install_exit: "0", machine: "aarch64"), observed: observed_on(host: "mtcollins1", id: new_boot_id)) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "now on boot") && string_contains(s: c, pattern: new_boot_id)
    LostBootCurrentPresent { host: _, boot: _ } => false
  }
}

// REDS: an observation of another host, an unobserved boot and the production observer (which has no
// route in a fleet-converge run) each refuse, even over an envelope that is otherwise admitted.
test fn a_missing_or_foreign_current_boot_observation_refuses() -> Bool {
  (match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: closed(install_exit: "0", machine: "aarch64"), observed: observed_on(host: "mtjade1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "not mtcollins1")
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: closed(install_exit: "0", machine: "aarch64"), observed: CurrentBootUnobserved { cause: "x" }) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "unobserved")
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: closed(install_exit: "0", machine: "aarch64"), observed: lost_boot_observe_current_boot(transport: none)) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "unobserved")
    LostBootCurrentPresent { host: _, boot: _ } => false
  })
}

// REDS: an open envelope, a failed install, an envelope bound to another machine and an empty capture
// each refuse with their own cause before any credential is read, over an observation that matches.
test fn an_envelope_that_does_not_establish_runner_host_up_refuses() -> Bool {
  (match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: begin_line, observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "not a closed envelope")
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: closed(install_exit: "1", machine: "aarch64"), observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "does not establish runner-host-up")
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_from_capture(host: "mtjade1" as NonEmptyStr, capture: closed(install_exit: "0", machine: "aarch64"), observed: observed_on(host: "mtjade1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: _ } => true
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_from_capture(host: "mtcollins1" as NonEmptyStr, capture: "", observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: _ } => true
    LostBootCurrentPresent { host: _, boot: _ } => false
  })
}

// A missing or unreadable envelope, and a blank host or path, refuse; none is defaulted.
test fn a_missing_envelope_or_blank_input_refuses() -> Bool {
  (match lost_boot_current_input(host: "mtcollins1", capture_path: "/tmp/gunbc_no_such_capture_dir/capture.txt", observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: c } => string_contains(s: c, pattern: "unreadable")
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_input(host: "mtcollins1", capture_path: "", observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: _ } => true
    LostBootCurrentPresent { host: _, boot: _ } => false
  }) && (match lost_boot_current_input(host: "", capture_path: "x", observed: observed_on(host: "mtcollins1", id: capture_boot_id)) {
    LostBootCurrentRefused { cause: _ } => true
    LostBootCurrentPresent { host: _, boot: _ } => false
  })
}

// THE PAIRING CLAIM: the real observer runs the real operation over a host-bound transport and names the
// bound host in what it reads. The hermetic FleetSsh context has no reachable mtcollins1, so the real read
// is unsuccessful and its cause names the bound host; only the dispatch over the bound transport can produce
// that cause (the no-transport arm names no host), so deleting the dispatch makes this fail. The mint over a
// successful read is the host_bound_transport_witness positive control.
test fn the_real_observer_route_reads_over_the_bound_transport_as_its_host() -> Bool {
  match mtcollins1_bound_transport() {
    Absent => false
    Present { value: b } =>
      match lost_boot_observe_current_boot(transport: Present { value: b }) {
        CurrentBootUnobserved { cause: c } => string_contains(s: c, pattern: "boot id read on mtcollins1")
        CurrentBootObserved { evidence: e } => e.host == "mtcollins1"
      }
  }
}

// The host-bound transport to mtcollins1, built the way production builds the target (fleet_locus_ssh_target)
// over the hermetic sealed context, then joined to its managed host by host_bound_transport_of.
fn mtcollins1_bound_transport() -> HostBoundTransport? admit_callers: [
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "the_real_observer_route_reads_over_the_bound_transport_as_its_host"),
] {
  match fleet_ssh_execution_context_hermetic_witness_fixture() {
    Absent => none
    Present { value: ctx } =>
      match fleet_locus_ssh_target(host: operator_host_mtcollins1) {
        SshTargetRefused { endpoint: _, refusal: _ } => none
        SshTargetResolved { target: t } =>
          match host_bound_transport_of(transport: FleetSsh { target: t, context: ctx }) {
            HostBoundTransportRefused { cause: _ } => none
            HostBoundTransportResolved { bound: b } => Present { value: b }
          }
      }
  }
}
