  NoCloudSeedArtifact, UbuntuSeededInstallMediaBuildInput, seeded_install_media_build_key,
  seeded_install_media_seed_artifact_admission, SeedArtifactsAdmitted, SeedArtifactsRefused,
  SeedArtifactNameNotABasename, SeedArtifactNameReserved, SeedArtifactNameCollidesWithSeedFile, SeedArtifactNameDuplicated,
}
