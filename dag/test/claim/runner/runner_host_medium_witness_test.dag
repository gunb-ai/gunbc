module test.claim.runner_host_medium_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.measure { kibibyte_count, hardware_thread_count_value }
import v2.std.optional { Present }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.github.actions_runner { actions_runner_release_2_337_0 }
import extdeps.provisioning.ubuntu_seeded_install_media { NoCloudSeedArtifact, UbuntuSeededInstallMediaBuildInput, seeded_install_media_build_key }
import gunbc.boot_medium { BootMedium, BootMediumRunnerHostUp, BootMediumVolumeLabel, BootMediumNoTerminal }
import gunbc.fleet_intent_network { operator_host_mtcollins1 }
import gunbc.managed_host_boot { AdmittedBootSubject, BootSubjectAdmitted, BootSubjectRefused, boot_subject_admission_for }
import gunbc.machine_intake_mtcollins1_census_image { mtcollins1_census_machine, mtcollins1_census_console_device, mtcollins1_census_console_arg }
import gunbc.machine_intake_mtcollins1_boot_run {
  MtCollins1BootTerminalVerdict, TerminalAccepted, TerminalRefused, TerminalPending,
  mtcollins1_boot_terminal_verdict, mtcollins1_boot_terminal_cause_text, mtcollins1_boot_medium_refusal,
}
import gunbc.runner.runner_host_medium {
  RunnerHostMediumHost, RunnerHostMediumImage, RunnerHostMediumImageDerived, RunnerHostMediumRunnerUnpublished, RunnerHostMediumUserDataRefused,
  RunnerHostUpReadback, RunnerHostUpPending, RunnerHostUpRefused, RunnerHostUpObserved,
  RunnerHostSectionFailed, RunnerHostMachineNotAarch64, RunnerHostSectionAbsent,
  runner_host_medium_image, runner_host_boot_medium, runner_host_up_readback, runner_host_medium_volume_id,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data mtcollins1_runner_host: RunnerHostMediumHost = RunnerHostMediumHost {
  machine: mtcollins1_census_machine,
  console_device: mtcollins1_census_console_device,
  console_kernel_arg: mtcollins1_census_console_arg,
}

data supplied_digest: NonEmptyStr = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn runner_subject() -> AdmittedBootSubject? {
  match boot_subject_admission_for(host: operator_host_mtcollins1, medium: runner_host_boot_medium(output_digest: supplied_digest), execution_revision: "0123456789abcdef0123456789abcdef01234567" as NonEmptyStr) {
    BootSubjectAdmitted { subject: s } => Present { value: s }
    BootSubjectRefused { host: _, cause: _ } => none
  }
}

fn section(name: String, argv: String, body: String, exit_code: String) -> String {
  concat("----SECTION ", name, "----\n----ARGV ", name, ": ", argv, "\n", body, "----EXIT ", name, ": ", exit_code, "\n")
}

data begin_line: String = "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000001 begin 2026-10-04T00:00:00Z=====\n"
data end_line: String = "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000001 end 2026-10-04T00:01:00Z=====\n"

data meminfo_body: String = "MemTotal:       134217728 kB\nMemFree:        130000000 kB\nMemAvailable:   131000000 kB\nBuffers:            1024 kB\nCached:          2000000 kB\nSwapTotal:             0 kB\nSwapFree:              0 kB\nHugePages_Total:       0\n"

fn sections(install_exit: String, machine: String) -> String {
  concat(
    section(name: "boot-media", argv: "test -e /dev/disk/by-label/GUNBC_RUNNER_HOST_2404_3", body: "", exit_code: "0"),
    section(name: "runner-install", argv: "(the rendered extract)", body: "", exit_code: install_exit),
    section(name: "runner-listener", argv: "test -x /opt/actions-runner/bin/Runner.Listener", body: "", exit_code: "0"),
    section(name: "systemd-manager", argv: "test -d /run/systemd/system", body: "", exit_code: "0"),
    section(name: "meminfo", argv: "cat /proc/meminfo", body: meminfo_body, exit_code: "0"),
    section(name: "nproc", argv: "nproc", body: "80\n", exit_code: "0"),
    section(name: "uname-machine", argv: "uname -m", body: concat(machine, "\n"), exit_code: "0"),
  )
}

fn closed(install_exit: String, machine: String) -> String {
  concat(begin_line, sections(install_exit: install_exit, machine: machine), end_line)
}

fn readback(capture: String) -> RunnerHostUpReadback? {
  match runner_subject() {
    Absent => none
    Present { value: s } => Present { value: runner_host_up_readback(capture: capture, subject: s) }
  }
}

// THE DERIVATION INHABITS THE SEEDED-MEDIA BUILD INPUT WITH THE RUNNER PAYLOAD: the arm64 artifact of
// the host-unit slot's release as a seed ARTIFACT under its cited arm64 digest (the boot fetches
// nothing), a seed program that verifies it off the medium and RETURNS
// (no power-off, nothing written to a disk), and the medium's own volume id.
test fn the_runner_image_derives_with_the_slot_runner_and_a_program_that_never_halts() -> Bool {
  match runner_host_medium_image(host: mtcollins1_runner_host) {
    RunnerHostMediumImageDerived { input: input, runner: runner } => {
      let program = fold(input.seed_files, init: "", f: (acc, f) => concat(acc, f.content as String))
      (runner.binary_release.version as String) == (actions_runner_release_2_337_0.version as String)
        && (input.volume_id as String) == (runner_host_medium_volume_id as String)
        && string_contains(s: program, pattern: "sha256sum -c")
        && !string_contains(s: program, pattern: "curl")
        && count(input.seed_artifacts) == 1
        && all(input.seed_artifacts, a => (a.sha256 as String) == (actions_runner_release_2_337_0.digest_aarch64.hex as String))
        && string_contains(s: program, pattern: "Runner.Listener")
        && !string_contains(s: program, pattern: "poweroff")
        && string_contains(s: input.grub_kernel_cmdline as String, pattern: mtcollins1_census_console_arg as String)
    }
    RunnerHostMediumRunnerUnpublished { binary_release: _ } => false
    RunnerHostMediumUserDataRefused { reason: _ } => false
  }
}

// THE MEDIUM IS ADMITTED BY THE REAL BOOT SUBJECT and carries the runner-host-up terminal, so the
// boot run's pre-controller medium gate does not refuse it as a terminal-less medium.
test fn the_runner_medium_is_admitted_and_names_the_runner_host_up_terminal() -> Bool {
  let medium = runner_host_boot_medium(output_digest: supplied_digest)
  (match medium.terminal {
    BootMediumRunnerHostUp { label: l } => (l as String) == (runner_host_medium_volume_id as String)
    BootMediumVolumeLabel { label: _ } => false
    BootMediumNoTerminal { reason: _ } => false
  })
    && (match mtcollins1_boot_medium_refusal(medium: medium) { Absent => true Present { value: _ } => false })
    && (match runner_subject() { Present { value: _ } => true Absent => false })
}

// A CLOSED ENVELOPE WITH EVERY SECTION HELD IS THE RUNNER HOST UP, carrying the idle readings.
test fn a_closed_envelope_with_every_section_held_reads_the_runner_host_up() -> Bool {
  match readback(capture: closed(install_exit: "0", machine: "aarch64")) {
    Present { value: RunnerHostUpObserved { up: up } } =>
      kibibyte_count(k: up.mem_total) == 134217728 && kibibyte_count(k: up.mem_available) == 131000000 && hardware_thread_count_value(t: up.threads) == 80 && (up.machine as String) == "aarch64"
    _ => false
  }
}

// THE REDS: a runner install whose digest check failed, and a host that is not aarch64, each refuse
// and BOTH are named on one boot; an open envelope whose install already failed refuses before END;
// a closed envelope missing a section refuses rather than accepting on what it has.
test fn a_failed_install_and_a_foreign_machine_both_refuse() -> Bool {
  match readback(capture: closed(install_exit: "1", machine: "x86_64")) {
    Present { value: RunnerHostUpRefused { refusals: rs } } =>
      any(rs, r => match r { RunnerHostSectionFailed { name: n, exit_code: c } => (n as String) == "runner-install" && c == "1" _ => false })
        && any(rs, r => match r { RunnerHostMachineNotAarch64 { observed: o } => o == "x86_64" _ => false })
    _ => false
  }
}

test fn an_open_envelope_refuses_early_on_a_failed_install_and_otherwise_waits() -> Bool {
  let failed_open = concat(begin_line, section(name: "runner-install", argv: "(the rendered extract)", body: "sha256sum: WARNING: 1 computed checksum did NOT match\n", exit_code: "1"))
  let held_open = concat(begin_line, section(name: "runner-install", argv: "(the rendered extract)", body: "", exit_code: "0"))
  (match readback(capture: failed_open) { Present { value: RunnerHostUpRefused { refusals: _ } } => true _ => false })
    && (match readback(capture: held_open) { Present { value: RunnerHostUpPending { reason: _ } } => true _ => false })
}

test fn a_closed_envelope_missing_the_meminfo_section_refuses() -> Bool {
  let missing = concat(begin_line, section(name: "nproc", argv: "nproc", body: "80\n", exit_code: "0"), end_line)
  match readback(capture: missing) {
    Present { value: RunnerHostUpRefused { refusals: rs } } =>
      any(rs, r => match r { RunnerHostSectionAbsent { name: n } => (n as String) == "meminfo" _ => false })
    _ => false
  }
}

// THE ROUTE: the boot run's terminal verdict, given a subject admitted with the runner medium, reaches
// runner_host_up_readback -- it accepts the held envelope and refuses the foreign machine with the
// runner-host cause, which the census predicate (it reads no uname-machine section) could not produce.
test fn the_boot_run_terminal_verdict_delegates_to_the_runner_host_up_predicate() -> Bool {
  match runner_subject() {
    Absent => false
    Present { value: s } =>
      (match mtcollins1_boot_terminal_verdict(capture: closed(install_exit: "0", machine: "aarch64"), subject: s) {
        TerminalAccepted { run: _, threads: t } => hardware_thread_count_value(t: t) == 80
        _ => false
      })
        && (match mtcollins1_boot_terminal_verdict(capture: closed(install_exit: "0", machine: "x86_64"), subject: s) {
          TerminalRefused { causes: cs } => any(cs, c => string_contains(s: mtcollins1_boot_terminal_cause_text(cause: c), pattern: "uname -m printed x86_64"))
          _ => false
        })
  }
}

fn with_artifacts(input: UbuntuSeededInstallMediaBuildInput, artifacts: List<NoCloudSeedArtifact>) -> UbuntuSeededInstallMediaBuildInput {
  UbuntuSeededInstallMediaBuildInput {
    stock_artifact: input.stock_artifact,
    nocloud_dir_on_iso: input.nocloud_dir_on_iso,
    user_data_body: input.user_data_body,
    seed_files: input.seed_files,
    seed_artifacts: artifacts,
    grub_kernel_cmdline: input.grub_kernel_cmdline,
    volume_id: input.volume_id,
    pinned_dates: input.pinned_dates,
    image_stem: input.image_stem,
    builder_revision: input.builder_revision,
  }
}

// THE ARTIFACT'S DIGEST IS IN THE BUILD KEY AND ITS URL IS NOT: a different tarball is a different
// image, the same bytes from another URL are the same image. (An input with no artifact keeps its
// pre-artifact key: the census build key claim in test.claim.mtcollins1_census_medium_readback_witness
// pins c001ac127d718e72.)
test fn the_seed_artifact_digest_keys_the_build_and_its_url_does_not() -> Bool {
  match runner_host_medium_image(host: mtcollins1_runner_host) {
    RunnerHostMediumImageDerived { input: input, runner: _ } => {
      let moved = map(input.seed_artifacts, a => NoCloudSeedArtifact { name: a.name, source_url: "https://mirror.invalid/runner.tar.gz", sha256: a.sha256 })
      let other = map(input.seed_artifacts, a => NoCloudSeedArtifact { name: a.name, source_url: a.source_url, sha256: actions_runner_release_2_337_0.digest_x86_64.hex })
      let key = seeded_install_media_build_key(input: input) as String
      key == (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: moved)) as String)
        && key != (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: other)) as String)
        && key != (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: [])) as String)
    }
    RunnerHostMediumRunnerUnpublished { binary_release: _ } => false
    RunnerHostMediumUserDataRefused { reason: _ } => false
  }
}
