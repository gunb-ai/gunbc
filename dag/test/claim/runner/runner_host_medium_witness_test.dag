data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data mtcollins1_runner_host: RunnerHostMediumHost = RunnerHostMediumHost {
  machine: mtcollins1_census_machine,
  console_device: mtcollins1_census_console_device,
  console_kernel_arg: mtcollins1_census_console_arg,
}

data supplied_digest: NonEmptyStr = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn runner_subject() -> AdmittedBootSubject? {
  subject_with(medium: runner_host_boot_medium(output_digest: supplied_digest))
}

fn subject_with(medium: BootMedium) -> AdmittedBootSubject? {
  match boot_subject_admission_for(host: operator_host_mtcollins1, medium: medium, execution_revision: "0123456789abcdef0123456789abcdef01234567" as NonEmptyStr) {
    BootSubjectAdmitted { subject: s } => Present { value: s }
    BootSubjectRefused { host: _, cause: _ } => none
  }
}

fn section(name: String, argv: String, body: String, exit_code: String) -> String {
  concat("----SECTION ", name, "----\n----ARGV ", name, ": ", argv, "\n", body, "----EXIT ", name, ": ", exit_code, "\n")
}

data begin_line: String = "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000001 begin 2026-10-04T00:00:00Z=====\n"
data end_line: String = "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000001 end 2026-10-04T00:01:00Z=====\n"

data meminfo_body: String = "MemTotal:       134217728 kB\nMemFree:        130000000 kB\nMemAvailable:   131000000 kB\nBuffers:            1024 kB\nCached:          2000000 kB\nSwapTotal:             0 kB\nSwapFree:              0 kB\nHugePages_Total:       0\n"

fn sections(install_exit: String, machine: String) -> String {
  sections_with_digest(install_exit: install_exit, machine: machine, tarball_digest: actions_runner_release_2_337_0.digest_aarch64.hex as String)
}

fn sections_with_digest(install_exit: String, machine: String, tarball_digest: String) -> String {
  concat(
    section(name: "boot-media", argv: "ls -1 /dev/disk/by-label", body: "GUNBC_RUNNER_HOST_2404_3\nEFI\n", exit_code: "0"),
    section(name: "runner-tarball-digest", argv: "sha256sum -- (the tarball on the medium)", body: concat(tarball_digest, "  /cdrom/gunbc-runner/actions-runner-linux-arm64-2.337.0.tar.gz\n"), exit_code: "0"),
    section(name: "runner-clear", argv: "rm -rf /opt/actions-runner", body: "", exit_code: "0"),
    section(name: "runner-dir", argv: "mkdir -p /opt/actions-runner", body: "", exit_code: "0"),
    section(name: "runner-extract", argv: "(the rendered extract)", body: "", exit_code: install_exit),
    section(name: "runner-listener", argv: "test -x /opt/actions-runner/bin/Runner.Listener", body: "", exit_code: "0"),
    section(name: "systemd-manager", argv: "test -d /run/systemd/system", body: "", exit_code: "0"),
    section(name: "meminfo", argv: "cat /proc/meminfo", body: meminfo_body, exit_code: "0"),
    section(name: "nproc", argv: "nproc", body: "80\n", exit_code: "0"),
    section(name: "uname-machine", argv: "uname -m", body: concat(machine, "\n"), exit_code: "0"),
  )
}

fn closed(install_exit: String, machine: String) -> String {
  concat(begin_line, sections(install_exit: install_exit, machine: machine), end_line)
}

fn readback(capture: String) -> RunnerHostUpReadback? {
  match runner_subject() {
    Absent => none
    Present { value: s } => Present { value: runner_host_up_readback(capture: capture, subject: s) }
  }
}

// THE DERIVATION INHABITS THE SEEDED-MEDIA BUILD INPUT WITH THE RUNNER PAYLOAD: the arm64 artifact of
// the host-unit slot's release as a seed ARTIFACT under its cited arm64 digest (the boot fetches
// nothing), a seed program that verifies it off the medium and RETURNS
// (no power-off, nothing written to a disk), and the medium's own volume id.
test fn the_runner_image_derives_with_the_slot_runner_and_a_program_that_never_halts() -> Bool {
  match runner_host_medium_image(host: mtcollins1_runner_host) {
    RunnerHostMediumImageDerived { input: input, runner: runner } => {
      let program = fold(input.seed_files, init: "", f: (acc, f) => concat(acc, f.content as String))
      (runner.binary_release.version as String) == (actions_runner_release_2_337_0.version as String)
        && (input.volume_id as String) == (runner_host_medium_volume_id as String)
        && string_contains(s: program, pattern: "sha256sum")
        && !string_contains(s: program, pattern: "set -e")
        && !string_contains(s: program, pattern: "curl")
        && count(input.seed_artifacts) == 1
        && all(input.seed_artifacts, a => (a.digest.hex as String) == (actions_runner_release_2_337_0.digest_aarch64.hex as String))
        && string_contains(s: program, pattern: "Runner.Listener")
        && !string_contains(s: program, pattern: "poweroff")
        && string_contains(s: input.grub_kernel_cmdline as String, pattern: mtcollins1_census_console_arg as String)
    }
    RunnerHostMediumRunnerUnpublished { binary_release: _ } => false
    RunnerHostMediumUserDataRefused { reason: _ } => false
  }
}

// THE MEDIUM IS ADMITTED BY THE REAL BOOT SUBJECT and carries the runner-host-up terminal, so the
// boot run's pre-controller medium gate does not refuse it as a terminal-less medium.
test fn the_runner_medium_is_admitted_and_names_the_runner_host_up_terminal() -> Bool {
  let medium = runner_host_boot_medium(output_digest: supplied_digest)
  (match medium.terminal {
    BootMediumRunnerHostUp { label: l } => (l as String) == (runner_host_medium_volume_id as String)
    BootMediumVolumeLabel { label: _ } => false
    BootMediumNoTerminal { reason: _ } => false
  })
    && (match mtcollins1_boot_medium_refusal(medium: medium) { Absent => true Present { value: _ } => false })
    && (match runner_subject() { Present { value: _ } => true Absent => false })
}

// A CLOSED ENVELOPE WITH EVERY SECTION HELD IS THE RUNNER HOST UP, carrying the idle readings.
test fn a_closed_envelope_with_every_section_held_reads_the_runner_host_up() -> Bool {
  match readback(capture: closed(install_exit: "0", machine: "aarch64")) {
    Present { value: RunnerHostUpObserved { up: up } } =>
      kibibyte_count(k: up.mem_total) == 134217728 && kibibyte_count(k: up.mem_available) == 131000000 && hardware_thread_count_value(t: up.threads) == 80 && (match up.machine { Aarch64 => true _ => false })
    _ => false
  }
}

// THE REDS: a runner install whose digest check failed, and a host that is not aarch64, each refuse
// and BOTH are named on one boot; an open envelope whose install already failed refuses before END;
// a closed envelope missing a section refuses rather than accepting on what it has.
test fn a_failed_install_and_a_foreign_machine_both_refuse() -> Bool {
  match readback(capture: closed(install_exit: "1", machine: "x86_64")) {
    Present { value: RunnerHostUpRefused { refusals: rs } } =>
      any(rs, r => match r { RunnerHostSectionFailed { name: n, exit_code: c } => (n as String) == "runner-extract" && c == "1" _ => false })
        && any(rs, r => match r { RunnerHostMachineNotAarch64 { observed: o } => (match o { X86_64 => true _ => false }) _ => false })
    _ => false
  }
}

test fn an_open_envelope_refuses_early_on_a_failed_install_and_otherwise_waits() -> Bool {
  let failed_open = concat(begin_line, section(name: "runner-extract", argv: "(the rendered extract)", body: "tar: Unexpected EOF in archive\n", exit_code: "2"))
  let held_open = concat(begin_line, section(name: "runner-extract", argv: "(the rendered extract)", body: "", exit_code: "0"))
  (match readback(capture: failed_open) { Present { value: RunnerHostUpRefused { refusals: _ } } => true _ => false })
    && (match readback(capture: held_open) { Present { value: RunnerHostUpPending { reason: _ } } => true _ => false })
}

test fn a_closed_envelope_missing_the_meminfo_section_refuses() -> Bool {
  let missing = concat(begin_line, section(name: "nproc", argv: "nproc", body: "80\n", exit_code: "0"), end_line)
  match readback(capture: missing) {
    Present { value: RunnerHostUpRefused { refusals: rs } } =>
      any(rs, r => match r { RunnerHostSectionAbsent { name: n } => (n as String) == "meminfo" _ => false })
    _ => false
  }
}

// THE ROUTE: the boot run's terminal verdict, given a subject admitted with the runner medium, reaches
// runner_host_up_readback -- it accepts the held envelope and refuses the foreign machine with the
// runner-host cause, which the census predicate (it reads no uname-machine section) could not produce.
// And the accepted reading survives the delegation and the watch tick WHOLE: the consumer reads the
// exact idle MemTotal, MemAvailable, thread count and machine from the one accepted boot reading.
test fn the_boot_run_terminal_verdict_delegates_and_carries_the_whole_reading() -> Bool {
  match runner_subject() {
    Absent => false
    Present { value: s } => {
      let verdict = mtcollins1_boot_terminal_verdict(capture: closed(install_exit: "0", machine: "aarch64"), subject: s)
      (match verdict {
        TerminalRunnerHostAccepted { up: up } => kibibyte_count(k: up.mem_total) == 134217728 && kibibyte_count(k: up.mem_available) == 131000000 && hardware_thread_count_value(t: up.threads) == 80 && (match up.machine { Aarch64 => true _ => false })
        _ => false
      })
        && (match watch_tick(verdict: verdict, channel: SolChannelLive) {
          WatchRunnerHostAccepted { up: up } => kibibyte_count(k: up.mem_total) == 134217728 && kibibyte_count(k: up.mem_available) == 131000000 && hardware_thread_count_value(t: up.threads) == 80 && (match up.machine { Aarch64 => true _ => false })
          _ => false
        })
        && (match mtcollins1_boot_terminal_verdict(capture: closed(install_exit: "0", machine: "x86_64"), subject: s) {
          TerminalRefused { causes: cs } => any(cs, c => string_contains(s: mtcollins1_boot_terminal_cause_text(cause: c), pattern: "uname -m read back X86_64"))
          _ => false
        })
    }
  }
}

// THE LABEL IS THE ADMITTED SUBJECT'S, NOT A MODULE CONSTANT: a subject admitted with the runner
// terminal but label OTHER is refused by a capture of this image (whose host lists
// GUNBC_RUNNER_HOST_2404_3), while the exact-label subject accepts the same capture.
test fn a_subject_admitted_with_another_label_is_refused_by_this_images_capture() -> Bool {
  let base = runner_host_boot_medium(output_digest: supplied_digest)
  let other = BootMedium { image_name: base.image_name, digest: base.digest, export: base.export, terminal: BootMediumRunnerHostUp { label: "OTHER" } }
  let capture = closed(install_exit: "0", machine: "aarch64")
  (match subject_with(medium: other) {
    Present { value: s } => match runner_host_up_readback(capture: capture, subject: s) {
      RunnerHostUpRefused { refusals: rs } => any(rs, r => match r { RunnerHostLabelAbsent { expected: e, observed: _ } => (e as String) == "OTHER" _ => false })
      _ => false
    }
    Absent => false
  })
    && (match readback(capture: capture) { Present { value: RunnerHostUpObserved { up: _ } } => true _ => false })
}

fn with_artifacts(input: UbuntuSeededInstallMediaBuildInput, artifacts: List<NoCloudSeedArtifact>) -> UbuntuSeededInstallMediaBuildInput {
  UbuntuSeededInstallMediaBuildInput {
    stock_artifact: input.stock_artifact,
    nocloud_dir_on_iso: input.nocloud_dir_on_iso,
    user_data_body: input.user_data_body,
    seed_files: input.seed_files,
    seed_artifacts: artifacts,
    grub_kernel_cmdline: input.grub_kernel_cmdline,
    volume_id: input.volume_id,
    pinned_dates: input.pinned_dates,
    image_stem: input.image_stem,
    builder_revision: input.builder_revision,
  }
}

// THE ARTIFACT'S DIGEST IS IN THE BUILD KEY AND ITS URL IS NOT: a different tarball is a different
// image, the same bytes from another URL are the same image. (An input with no artifact keeps its
// pre-artifact key: the census build key claim in test.claim.mtcollins1_census_medium_readback_witness
// pins c001ac127d718e72.)
test fn the_seed_artifact_digest_keys_the_build_and_its_url_does_not() -> Bool {
  match runner_host_medium_image(host: mtcollins1_runner_host) {
    RunnerHostMediumImageDerived { input: input, runner: _ } => {
      let moved = map(input.seed_artifacts, a => NoCloudSeedArtifact { name: a.name, source_url: "https://mirror.invalid/runner.tar.gz", digest: a.digest })
      let other = map(input.seed_artifacts, a => NoCloudSeedArtifact { name: a.name, source_url: a.source_url, digest: actions_runner_release_2_337_0.digest_x86_64 })
      let key = seeded_install_media_build_key(input: input) as String
      key == (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: moved)) as String)
        && key != (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: other)) as String)
        && key != (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: [])) as String)
    }
    RunnerHostMediumRunnerUnpublished { binary_release: _ } => false
    RunnerHostMediumUserDataRefused { reason: _ } => false
  }
}

// THE ARTIFACT NAME IS ADMITTED BEFORE ANY FETCH (the remaster's fetch takes only an
// AdmittedSeedArtifact; its real-execution control is test.claim.srv3_seeded_install_media_real_execution).
// The runner image's own tarball is admitted; an escaping path, the image's own program name, a
// NoCloud datasource name and a duplicate each refuse with their own cause.
fn admission_refuses_with(input: UbuntuSeededInstallMediaBuildInput, extra: NoCloudSeedArtifact, cause: String) -> Bool {
  match seeded_install_media_seed_artifact_admission(input: with_artifacts(input: input, artifacts: append(input.seed_artifacts, items: [extra]))) {
    SeedArtifactsAdmitted { artifacts: _ } => false
    SeedArtifactsRefused { refusals: rs } => any(rs, r => match r {
      SeedArtifactNameNotABasename { name: _ } => cause == "basename"
      SeedArtifactNameReserved { name: _ } => cause == "reserved"
      SeedArtifactNameCollidesWithSeedFile { name: _ } => cause == "collides"
      SeedArtifactNameDuplicated { name: _ } => cause == "duplicated"
    })
  }
}

fn artifact_named(n: String) -> NoCloudSeedArtifact {
  NoCloudSeedArtifact { name: n as NonEmptyStr, source_url: "https://example.invalid/x", digest: sha256_digest(hex: supplied_digest) }
}

test fn seed_artifact_names_are_admitted_only_as_fresh_basenames() -> Bool {
  match runner_host_medium_image(host: mtcollins1_runner_host) {
    RunnerHostMediumImageDerived { input: input, runner: _ } => {
      let own = map(input.seed_artifacts, a => a.name as String)
      (match seeded_install_media_seed_artifact_admission(input: input) {
        SeedArtifactsAdmitted { artifacts: admitted } => map(admitted, a => a.basename.value as String) == own
        SeedArtifactsRefused { refusals: _ } => false
      })
        && admission_refuses_with(input: input, extra: artifact_named(n: "../../boot/grub/grub.cfg"), cause: "basename")
        && admission_refuses_with(input: input, extra: artifact_named(n: ".."), cause: "basename")
        && admission_refuses_with(input: input, extra: artifact_named(n: "runner-host-up.sh"), cause: "collides")
        && admission_refuses_with(input: input, extra: artifact_named(n: "user-data"), cause: "reserved")
        && admission_refuses_with(input: input, extra: artifact_named(n: "meta-data"), cause: "reserved")
        && admission_refuses_with(input: input, extra: artifact_named(n: fold(own, init: "", f: (acc, n) => n)), cause: "duplicated")
    }
    RunnerHostMediumRunnerUnpublished { binary_release: _ } => false
    RunnerHostMediumUserDataRefused { reason: _ } => false
  }
}

fn reading_is_the_capture(up: RunnerHostUp) -> Bool {
  kibibyte_count(k: up.mem_total) == 134217728 && kibibyte_count(k: up.mem_available) == 131000000 && hardware_thread_count_value(t: up.threads) == 80 && (match up.machine { Aarch64 => true _ => false })
}

fn through(subject: AdmittedBootSubject, reading: RunnerHostUp?) -> RunnerHostUp? {
  let watch = TerminalWatch { outcome: ExitSuccess, census_ended: false, smpro_census: SmproNotTaken { reason: "supplied" }, screen_reported: [], runner_host: reading }
  let aw = actuation_watch_of(watch: watch, selection: subject.selection, at_power_on: SmproNotTaken { reason: "supplied" }, smpro_read: UptimeRefused { detail: "supplied" }, terminal_read: UptimeRefused { detail: "supplied" })
  let base = actuation_not_powered_on(outcome: aw.outcome, reason: "supplied")
  let act = actuation_after_watch(observed: aw, media: base.media, handoff_media: base.handoff_media, end_media: base.end_media, override_before: base.override_before, override_after: base.override_after, power_after: base.power_after, outcome: aw.outcome, screen: base.screen, timing: base.timing)
  let held = actuation_with_outcome(act: act, outcome: ExitSuccess)
  mtcollins1_boot_attempt_of(act: held, bmc: BmcAccessNotReached { reason: "supplied" }, configuration: attempt_configuration_not_recorded(host: "mtcollins1", attempt: "supplied", reason: "supplied")).runner_host
}

// THE READING REACHES THE COMPLETED ATTEMPT, through every real post-watch projection the production
// path calls -- actuation_watch_of, actuation_after_watch (mtcollins1_boot_actuate), actuation_with_outcome
// (mtcollins1_boot_actuate_held) and mtcollins1_boot_attempt_of -- so dropping the reading in any of them
// turns this red, and
// GuestIdleMeminfoAndNproc reads all four values off MtCollins1BootAttempt. A watch that accepted no
// runner host carries none all the way through.
test fn the_accepted_reading_reaches_the_boot_attempt_result() -> Bool {
  match runner_subject() {
    Absent => false
    Present { value: s } =>
      match watch_tick(verdict: mtcollins1_boot_terminal_verdict(capture: closed(install_exit: "0", machine: "aarch64"), subject: s), channel: SolChannelLive) {
        WatchRunnerHostAccepted { up: up } => {
          (match through(subject: s, reading: Present { value: up }) { Present { value: r } => reading_is_the_capture(up: r) Absent => false })
            && (match through(subject: s, reading: none) { Absent => true Present { value: _ } => false })
        }
        _ => false
      }
  }
}

// THE TARBALL'S DIGEST IS EVIDENCE THE PREDICATE JUDGES, NOT A SHELL GATE: a capture whose
// runner-tarball-digest section reads another sha256 (here the x86_64 tarball's) refuses with the typed
// cause naming both digests, even though every install section exited 0.
test fn a_tarball_that_reads_back_another_digest_refuses_the_terminal() -> Bool {
  let wrong = actions_runner_release_2_337_0.digest_x86_64.hex as String
  match readback(capture: concat(begin_line, sections_with_digest(install_exit: "0", machine: "aarch64", tarball_digest: wrong), end_line)) {
    Present { value: RunnerHostUpRefused { refusals: rs } } =>
      any(rs, r => match r { RunnerHostTarballDigestDiffers { expected: e, observed: o } => o == wrong && (e as String) == (actions_runner_release_2_337_0.digest_aarch64.hex as String) _ => false })
    _ => false
  }
}

// THE MACHINE IS PARSED AT THE uname BOUNDARY: a spelling the Linux projection does not cite refuses
// as unrecognized rather than being compared as a string.
test fn an_unrecognized_machine_spelling_refuses_as_unrecognized() -> Bool {
  match readback(capture: closed(install_exit: "0", machine: "arm64")) {
    Present { value: RunnerHostUpRefused { refusals: rs } } =>
      any(rs, r => match r { RunnerHostMachineUnrecognized { observed: o } => o == "arm64" _ => false })
    _ => false
  }
}

// THE PIN CARRIES ITS ALGORITHM: the same hex under Sha512 is another artifact (another build key) and
// can never satisfy the sha256sum readback, while a Sha256 pin holds only on its own hex.
test fn a_seed_artifact_pin_is_judged_with_its_algorithm_not_by_hex_alone() -> Bool {
  match runner_host_medium_image(host: mtcollins1_runner_host) {
    RunnerHostMediumImageDerived { input: input, runner: _ } => {
      let hex = actions_runner_release_2_337_0.digest_aarch64.hex
      let as_512 = map(input.seed_artifacts, a => NoCloudSeedArtifact { name: a.name, source_url: a.source_url, digest: sha512_digest(hex: hex) })
      (seeded_install_media_build_key(input: input) as String) != (seeded_install_media_build_key(input: with_artifacts(input: input, artifacts: as_512)) as String)
        && seed_artifact_readback_holds(read_back_sha256_hex: hex as String, pin: sha256_digest(hex: hex))
        && !seed_artifact_readback_holds(read_back_sha256_hex: hex as String, pin: sha512_digest(hex: hex))
        && !seed_artifact_readback_holds(read_back_sha256_hex: supplied_digest as String, pin: sha256_digest(hex: hex))
    }
    RunnerHostMediumRunnerUnpublished { binary_release: _ } => false
    RunnerHostMediumUserDataRefused { reason: _ } => false
  }
}
