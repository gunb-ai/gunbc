module test.claim.runner_password_session_tool_converge_witness

import std.logic { Bool }
import std.types { String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host_effect {
  HostEffectTransport,
  EmitArtifactThenThinRun,
  BootstrapFragment,
  ThinInvocation,
}
import gunbc.host_effect_realize {
  Srv3HostPredicate,
  Srv3PredicateHolds,
  Srv3PredicateFails,
  Srv3PredicateUnobserved,
}
import gunbc.runner_host_grants { executor_bootstrap_principal }
import gunbc.runner_password_session_tool_converge {
  PasswordSessionToolAptPackage,
  PasswordSessionToolUnacquirable,
  PasswordSessionToolOutcome,
  PasswordSessionToolSubjectAdmitted,
  PasswordSessionToolSubjectRefused,
  password_session_tool_plan,
  password_session_tool_subject,
  converge_one_password_session_tool,
  password_session_tool_receipt,
}
import extdeps.tools.sshpass { sshpass_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import extdeps.apt { package_sshpass }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv4 }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE TRANSPORT THAT CANNOT PROBE IS THE WALL THIS FILE EXISTS FOR, and it is inherited rather
// than re-derived. srv3_apt_tool_present once returned Bool, so the EmitArtifactThenThinRun arm --
// which cannot run a probe at all -- answered `false`, which is also what a host says when the tool
// is genuinely missing; srv3_ensure_apt_tool read that and ran a PRIVILEGED apt install against a
// host whose state had never been established. This module reuses that ensure precisely so it
// inherits the repair, and the row below is what proves the inheritance is real rather than
// asserted by the annotation.
data unprobeable_transport: HostEffectTransport = EmitArtifactThenThinRun {
  bootstrap: BootstrapFragment { script: "true" },
  invocation: ThinInvocation { argv: ["true"] },
}

fn verdict_is_unobserved(p: Srv3HostPredicate) -> Bool {
  match p {
    Srv3PredicateUnobserved { reason: _ } => true
    Srv3PredicateHolds => false
    Srv3PredicateFails => false
  }
}

// ── The package is read off the tool, never re-authored ──────────────────────────────────────────

test fn the_plan_reads_the_package_off_the_enrolled_tool() -> Bool {
  match password_session_tool_plan(tool: sshpass_cli_tool) {
    PasswordSessionToolAptPackage { tool: t, package: p } =>
      (t as String) == (sshpass_cli_tool.name as String)
        && (p as String) == (package_sshpass as String)
    PasswordSessionToolUnacquirable { tool: _ } => false
  }
}

// THE DISCRIMINATING HALF OF THE PLAN. websocat is installed from a GitHub release, so it has no
// apt package and the plan must say so rather than inventing one. This is the row that reddens if
// apt_package_of ever grows a default, and it is written against a LIVE tool row rather than a
// fixture so it also reddens if websocat's own declaration changes out from under the claim.
test fn a_tool_with_no_apt_source_is_unacquirable_not_guessed() -> Bool {
  match password_session_tool_plan(tool: websocat_cli_tool) {
    PasswordSessionToolUnacquirable { tool: t } =>
      (t as String) == (websocat_cli_tool.name as String)
    PasswordSessionToolAptPackage { tool: _, package: _ } => false
  }
}

// ── The unprobeable transport refuses instead of installing ──────────────────────────────────────

// THE CLASS THIS MODULE COULD MOST EASILY HAVE RE-INTRODUCED. A convergence that read a probe as
// "absent" when the probe could not run would install blind, on a privileged path, against an
// unestablished host. The assertion is Unobserved specifically -- not merely "not Holds" -- because
// Fails would mean the host answered, and the whole point is that it did not.
test fn an_unprobeable_transport_refuses_rather_than_installing() -> Bool {
  verdict_is_unobserved(
    p: converge_one_password_session_tool(
      tool: sshpass_cli_tool,
      transport: unprobeable_transport,
    ).verdict,
  )
}

// AN UNACQUIRABLE TOOL IS ALSO UNOBSERVED, and for a different reason worth keeping distinct: the
// transport here is irrelevant because the refusal happens before any host is reached. A roster
// tool with no apt source is an authoring gap in the roster, and this convergence says so rather
// than reporting it as a fact about the runner.
test fn an_unacquirable_tool_refuses_before_reaching_a_host() -> Bool {
  let outcome = converge_one_password_session_tool(
    tool: websocat_cli_tool,
    transport: unprobeable_transport,
  )
  verdict_is_unobserved(p: outcome.verdict)
    && (outcome.tool as String) == (websocat_cli_tool.name as String)
}

// ── Subject admission ────────────────────────────────────────────────────────────────────────────

// A MACHINE WITH NO RUNNER DEPLOY ROW IS UNKNOWN, NOT TYPICAL. It must refuse rather than borrow a
// neighbour's row, because an unmodeled machine carries no declared administrator principal and so
// there is no account this convergence could honestly act as.
test fn an_unmodeled_host_is_refused_as_a_subject() -> Bool {
  match password_session_tool_subject(host: "srv-not-a-runner" as HostIdentity) {
    PasswordSessionToolSubjectRefused { cause: c } =>
      string_contains(c as String, "srv-not-a-runner")
        && string_contains(c as String, "no runner deploy row")
    PasswordSessionToolSubjectAdmitted { host: _, target: _ } => false
  }
}

// THE ADMITTED SIDE, so the refusal above is discriminating rather than a one-armed assertion: a
// real runner host resolves and its target names the administrator principal, not the job user.
test fn a_rostered_runner_is_admitted_with_the_administrator_principal() -> Bool {
  match password_session_tool_subject(host: operator_host_srv4) {
    PasswordSessionToolSubjectAdmitted { host: h, target: t } =>
      (h as String) == (operator_host_srv4 as String)
        && (t.principal as String) == (executor_bootstrap_principal.login as String)
    PasswordSessionToolSubjectRefused { cause: _ } => false
  }
}

// ── The receipt is derived from the outcomes ─────────────────────────────────────────────────────

// UNOBSERVED IS RENDERED DISTINCTLY FROM ABSENT because the two have different remedies: absent
// means the host answered and the tool is still missing, unobserved means nothing was established.
// An operator who reads one as the other either chases a host that is fine or trusts a host that
// was never checked.
test fn the_receipt_distinguishes_unobserved_from_absent() -> Bool {
  let unobserved = password_session_tool_receipt(outcomes: [
    PasswordSessionToolOutcome {
      tool: sshpass_cli_tool.name,
      verdict: Srv3PredicateUnobserved { reason: "probe could not run" },
    },
  ])
  let absent = password_session_tool_receipt(outcomes: [
    PasswordSessionToolOutcome { tool: sshpass_cli_tool.name, verdict: Srv3PredicateFails },
  ])
  let present = password_session_tool_receipt(outcomes: [
    PasswordSessionToolOutcome { tool: sshpass_cli_tool.name, verdict: Srv3PredicateHolds },
  ])
  string_contains(unobserved, "sshpass=unobserved")
    && string_contains(absent, "sshpass=absent")
    && string_contains(present, "sshpass=present")
    && unobserved != absent
}
