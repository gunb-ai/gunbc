module test.claim.runner.runner_host_cap_bracket_witness

import std.types { Bool, String, List, NonEmptyStr }
import product.host_identity { HostIdentity }
import gunbc.runner.runner_host_file_converge { runner_host_file_subject, RunnerHostFileSubjectAdmitted, RunnerHostFileSubjectRefused, runner_host_fabric_member_units }
import std.optional { Absent, Present }
import std.measure { second, second_count }
import gunbc.runner.runner_disk_reclaim { SlotHasLiveWorker, SlotIdle, SlotActivityUnobserved }
import gunbc.runner.runner_slot_actuation { SlotRead, SlotReadRefused, slot_activation_plan, ActivationSteps, ActivationRefused, ActivationAlreadyActive, SlotActuationOutcome, SlotActivated, SlotActuationRefused, slot_read_outcome_of, slot_activity_of_listing }
import gunbc.runner.runner_host_cap_bracket {
  AdmissionMaskOnly,
  SlotDrainReading,
  BracketWaitStep,
  BracketDrained,
  BracketWaiting,
  BracketAdmissionNotClosed,
  BracketBoundExceeded,
  HostAdmitting,
  HostLeftState,
  HostLeftDrained,
  host_left_of_readmit,
  slot_drain_needs_worker,
  host_cap_bracket_budget,
  bracket_budget_verdict,
  BudgetCovers,
  BudgetCannotCover,
  BracketBudgetVerdict,
  slot_drain_reading_of,
  bracket_wait_step,
  host_cap_drain_ticks,
  runner_host_cap_drain_policy,
}

// THE CONTROLS FOR THE DRAIN BRACKET'S DECISIONS, over supplied readings (the boundary these claims
// discriminate at). The wet driver's route is the remote run against a fleet host.

fn u(n: String) -> NonEmptyStr { concat("actions-runner@srv3-", n, ".service") as NonEmptyStr }
fn drained(n: String) -> SlotDrainReading { SlotDrainReading { unit: u(n: n), masked: true, listener_running: false, stopping: false, activity: SlotIdle } }
fn finishing(n: String) -> SlotDrainReading { SlotDrainReading { unit: u(n: n), masked: true, listener_running: true, stopping: false, activity: SlotHasLiveWorker } }
fn idle_listener(n: String) -> SlotDrainReading { SlotDrainReading { unit: u(n: n), masked: true, listener_running: true, stopping: false, activity: SlotIdle } }
fn unreadable(n: String) -> SlotDrainReading { SlotDrainReading { unit: u(n: n), masked: true, listener_running: true, stopping: false, activity: SlotActivityUnobserved { cause: "ps exit=1" as NonEmptyStr } } }
fn unmasked(n: String) -> SlotDrainReading { SlotDrainReading { unit: u(n: n), masked: false, listener_running: false, stopping: false, activity: SlotIdle } }

fn is_drained(s: BracketWaitStep) -> Bool { match s { BracketDrained => true BracketWaiting { ticks_left: _ } => false BracketAdmissionNotClosed { listeners: _ } => false BracketBoundExceeded { busy: _, unproven: _ } => false } }
fn is_waiting(s: BracketWaitStep) -> Bool { match s { BracketWaiting { ticks_left: _ } => true BracketDrained => false BracketAdmissionNotClosed { listeners: _ } => false BracketBoundExceeded { busy: _, unproven: _ } => false } }
fn is_not_closed(s: BracketWaitStep) -> Bool { match s { BracketAdmissionNotClosed { listeners: ls } => length(ls) == 1 BracketDrained => false BracketWaiting { ticks_left: _ } => false BracketBoundExceeded { busy: _, unproven: _ } => false } }
fn exceeded(s: BracketWaitStep, busy: Int, unproven: Int) -> Bool { match s { BracketBoundExceeded { busy: b, unproven: p } => length(b) == busy && length(p) == unproven BracketDrained => false BracketWaiting { ticks_left: _ } => false BracketAdmissionNotClosed { listeners: _ } => false } }

// the bound is a declared policy row that yields a positive tick count
test fn the_declared_bound_yields_positive_ticks() -> Bool { host_cap_drain_ticks(policy: runner_host_cap_drain_policy) > 0 }

test fn every_slot_masked_stopped_and_idle_is_drained() -> Bool {
  is_drained(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [drained(n: "01"), drained(n: "02")], ticks_left: 3, time_up: false))
}

// a slot whose job is finishing holds the wait while ticks remain
test fn a_finishing_job_waits_inside_the_bound() -> Bool {
  is_waiting(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [drained(n: "01"), finishing(n: "02")], ticks_left: 3, time_up: false))
}

// RED: bound exhausted with a live job refuses, naming the busy slot
test fn the_bound_exceeded_refuses_naming_the_busy_slot() -> Bool {
  exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [drained(n: "01"), finishing(n: "02")], ticks_left: 0, time_up: false), busy: 1, unproven: 0)
}

// RED: could-not-tell is not idle, at the bound it is unproven and refuses
test fn an_unreadable_idleness_reading_is_never_drained() -> Bool {
  !is_drained(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [unreadable(n: "01")], ticks_left: 3, time_up: false))
    && exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [unreadable(n: "01")], ticks_left: 0, time_up: false), busy: 0, unproven: 1)
}

// RED: a slot that is not masked has admission open, so it is never drained
test fn an_unmasked_slot_is_never_drained() -> Bool {
  !is_drained(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [unmasked(n: "01")], ticks_left: 3, time_up: false))
}

// RED: mask-only plus an idle running listener withholds and names the unit
test fn mask_only_with_an_idle_listener_is_not_closed() -> Bool {
  is_not_closed(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [drained(n: "01"), idle_listener(n: "02")], ticks_left: 3, time_up: false))
    && is_not_closed(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [idle_listener(n: "02")], ticks_left: 0, time_up: false))
}

fn units() -> List<NonEmptyStr> { [u(n: "01"), u(n: "02")] }
fn readmitted() -> List<SlotActuationOutcome> { [SlotActivated { unit: u(n: "01") }, SlotActivated { unit: u(n: "02") }] }
fn readmit_stuck() -> List<SlotActuationOutcome> { [SlotActivated { unit: u(n: "01") }, SlotActuationRefused { unit: u(n: "02"), step: "start", reason: "x" }] }

fn admitting(l: HostLeftState) -> Bool { match l { HostAdmitting => true HostLeftDrained { units: _ } => false } }

// every slot re-admitted and read back: the host is left admitting
test fn a_fully_readmitted_host_is_left_admitting() -> Bool {
  admitting(l: host_left_of_readmit(units: units(), outcomes: readmitted()))
}

// RED: a stuck slot leaves the host DRAINED and names exactly that slot
test fn a_slot_that_does_not_readmit_leaves_the_host_drained_and_says_so() -> Bool {
  match host_left_of_readmit(units: units(), outcomes: readmit_stuck()) {
    HostLeftDrained { units: us } => length(us) == 1
    HostAdmitting => false
  }
}

// RED: a readmit list shorter than the units cannot read as admitting
test fn a_missing_readmit_reading_is_not_admitting() -> Bool {
  !admitting(l: host_left_of_readmit(units: units(), outcomes: [SlotActivated { unit: u(n: "01") }]))
}

// RED: no readmit reading at all (refusal before any re-admission ran) is not admitting
test fn no_readmit_reading_is_not_admitting() -> Bool {
  !admitting(l: host_left_of_readmit(units: units(), outcomes: []))
}

// THE REAL PROJECTION, FROM SHOW TEXT AND A PS LISTING, INTO THE BRACKET DECISION. The earlier controls
// supply a SlotDrainReading and so cannot see a loss in the projection: a deactivating unit with a live
// Runner.Worker was read as idle there. These start where the wet reader starts.
fn show_masked_with(active: String) -> String { concat("Id=", u(n: "01") as String, "\nLoadState=masked\nUnitFileState=masked\nActiveState=", active, "\n") }
fn listing_worker() -> String { concat(u(n: "01") as String, " Runner.Worker\n") }
fn listing_listener_only() -> String { concat(u(n: "01") as String, " Runner.Listener\n") }

fn projected(active: String, listing: String) -> SlotDrainReading {
  let read = slot_read_outcome_of(unit: u(n: "01"), show_stdout: show_masked_with(active: active))
  slot_drain_reading_of(unit: u(n: "01"), read: read, worker: if slot_drain_needs_worker(read: read) { slot_activity_of_listing(listing: listing, unit: u(n: "01")) } else { SlotIdle })
}

test fn a_deactivating_unit_with_a_live_worker_is_not_drained() -> Bool {
  is_waiting(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [projected(active: "deactivating", listing: listing_worker())], ticks_left: 3, time_up: false))
    && exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [projected(active: "deactivating", listing: listing_worker())], ticks_left: 0, time_up: false), busy: 1, unproven: 0)
}

// A DEACTIVATING UNIT WITH A LIVE LISTENER AND NO WORKER IS A STOP IN PROGRESS, NOT A DRAIN: it stays
// pending until the unit is stopped, and at the bound it is unproven.
test fn a_deactivating_unit_with_a_live_listener_and_no_worker_is_pending_never_drained() -> Bool {
  is_waiting(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [projected(active: "deactivating", listing: listing_listener_only())], ticks_left: 3, time_up: false))
    && exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [projected(active: "deactivating", listing: listing_listener_only())], ticks_left: 0, time_up: false), busy: 0, unproven: 1)
}

test fn a_stopped_masked_unit_is_drained_without_a_cgroup_reading() -> Bool {
  !slot_drain_needs_worker(read: slot_read_outcome_of(unit: u(n: "01"), show_stdout: show_masked_with(active: "inactive")))
    && is_drained(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [projected(active: "inactive", listing: "")], ticks_left: 3, time_up: false))
}

test fn an_unknown_or_missing_active_state_is_unproven_never_idle() -> Bool {
  let unknown = slot_drain_reading_of(unit: u(n: "01"), read: slot_read_outcome_of(unit: u(n: "01"), show_stdout: show_masked_with(active: "wedged")), worker: SlotIdle)
  let missing = slot_drain_reading_of(unit: u(n: "01"), read: slot_read_outcome_of(unit: u(n: "01"), show_stdout: concat("Id=", u(n: "01") as String, "\nLoadState=masked\nUnitFileState=masked\n")), worker: SlotIdle)
  exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [unknown], ticks_left: 0, time_up: false), busy: 0, unproven: 1)
    && exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [missing], ticks_left: 0, time_up: false), busy: 0, unproven: 1)
}

// TOTAL ELAPSED TIME BOUNDS THE WAIT AS WELL AS THE TICK COUNT: a slow pass leaves ticks but no time.
test fn time_up_exceeds_the_bound_whatever_ticks_remain() -> Bool {
  exceeded(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [finishing(n: "01")], ticks_left: 100, time_up: true), busy: 1, unproven: 0)
    && is_waiting(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [finishing(n: "01")], ticks_left: 100, time_up: false))
}

test fn a_drained_host_is_drained_even_when_time_is_up() -> Bool {
  is_drained(s: bracket_wait_step(closure: AdmissionMaskOnly, readings: [drained(n: "01")], ticks_left: 0, time_up: true))
}

// THE STEP BUDGET IS THE POLICY'S THREE FIGURES, and a smaller one refuses before anything is masked.
test fn the_budget_is_drain_plus_operations_plus_release() -> Bool {
  second_count(s: host_cap_bracket_budget(policy: runner_host_cap_drain_policy)) == 2700 + 600 + 300
}

test fn a_budget_short_of_the_bracket_refuses_before_masking() -> Bool {
  (match bracket_budget_verdict(policy: runner_host_cap_drain_policy, given: second(count: 3599)) { BudgetCannotCover { needed: n, given: g } => second_count(s: n) == 3600 && second_count(s: g) == 3599 BudgetCovers => false })
    && (match bracket_budget_verdict(policy: runner_host_cap_drain_policy, given: second(count: 3600)) { BudgetCovers => true BudgetCannotCover { needed: _, given: _ } => false })
}

// INTERRUPTION AFTER THE MASK. The driver is killed after masking; the release entry then meets a unit
// that is masked and stopped. Its plan (the real planner, from show text) must be unmask + enable +
// start, which activate_runner_slot_over runs and reads back; a refusal or an already-active verdict
// there would leave the mask in place or claim a re-admission nothing performed.
test fn a_unit_left_masked_by_an_interrupted_bracket_is_planned_back_in_service() -> Bool {
  match slot_read_outcome_of(unit: u(n: "01"), show_stdout: show_masked_with(active: "inactive")) {
    SlotReadRefused { reason: _ } => false
    SlotRead { reading: r } =>
      match slot_activation_plan(r: r) {
        ActivationSteps { steps: st } => length(st) == 3
        ActivationRefused { reason: _ } => false
        ActivationAlreadyActive => false
      }
  }
}

// THE OWNED SET EXCLUDES FABRIC SLOTS BY CONSTRUCTION: the release acts on subject.desired_units, and a
// slot the model gave to fabric (declared masked) is never among them, so release leaves it masked.
test fn a_fabric_slot_is_never_in_the_released_set() -> Bool {
  match runner_host_file_subject(host: "srv3" as HostIdentity) {
    RunnerHostFileSubjectRefused { cause: _ } => false
    RunnerHostFileSubjectAdmitted { subject: sj } =>
      length(runner_host_fabric_member_units(host: "srv3" as HostIdentity)) > 0
        && all(runner_host_fabric_member_units(host: "srv3" as HostIdentity), f => !any(sj.desired_units, d => (d as String) == (f as String)))
  }
}
