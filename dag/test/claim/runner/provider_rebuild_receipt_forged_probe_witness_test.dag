module test.claim.provider_rebuild_receipt_forged_probe_witness

import std.types { String, Bool, Int, List }
import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE FORGED REBUILD, ENROLLED AS AN EXECUTED RED (DESIGN §4b). test.probe.provider_rebuild_receipt_forged_probe
// writes a ProviderRebuildReceipt outside gunbc.runner.provider_guest_incarnation; it must refuse at
// ProviderRebuildReceipt, and a control source that only NAMES the module must refuse at nothing. A
// receipt is what would make a guest's root fresh, and until the reset loop's provider exchange mints
// one, nothing may.

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn blocking(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data control_source: String = "module probe_rebuild_receipt_harness_control\nimport std.types { Bool }\nimport gunbc.runner.provider_guest_incarnation { IncarnationStanding, IncarnationEstablished }\nfn established(s: IncarnationStanding) -> Bool { match s { IncarnationEstablished { incarnation: _ } => true _ => false } }\n"

test fn a_source_that_only_names_the_module_forges_nothing() -> Bool {
  blocking(c: census_of(source: control_source), wanted: "SoleConstructorViolation", subject: "ProviderRebuildReceipt") == 0
}

test fn a_forged_rebuild_receipt_refuses_at_its_type() -> Bool {
  blocking(
    c: census_of(source: filesystem_read(path: "dag/test/probe/provider_rebuild_receipt_forged_probe.dag").content),
    wanted: "SoleConstructorViolation",
    subject: "ProviderRebuildReceipt",
  ) >= 1
}
