  HostFileConvergedByWrite,
  HostFileWriteRefused,
  HostFileNotAttempted,
  HostFileNotAppliedObserveOnly,
  runner_host_manager_reload_owed,
  TeardownEffective,
  TeardownNotEffective,
  TeardownUnobservable,
