// Every claim here is a function of declared rows except the route test, whose every remote leg is
// answered by the hermetic ssh mock; nothing reads the live tree.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_cited_job_user_uid() -> RunnerJobUserRuntimeUidFigure {
  RunnerJobUserRuntimeUidFigure {
    uid: 4242,
    evidence: CitedToAuthority {
      authority: ExternalAuthority {
        uri: Uri {
          scheme: File,
          locator: "dag/test/claim/runner/runner_host_file_converge_witness_test.dag#fixture_cited_job_user_uid",
        },
      },
    },
  }
}

fn srv1_desired_population() -> RunnerHostFileDesiredPopulation {
  runner_host_file_desired_population_from_uid_figure(
    host: "srv1" as HostIdentity,
    figure: fixture_cited_job_user_uid(),
  )
}

// ── The bytes, against independently authored oracles ─────────────────────────────────────────────

// THE ORACLE IS WRITTEN HERE, NOT DERIVED. systemd.unit(5) drop-in grammar: a section header, one
// directive per line, a terminating newline. If the renderer and this string ever agree because both
// moved, the witness has become a restatement, so the literal stays literal.
data expected_teardown_dropin_text: String = "[Service]\nExitType=main\nKillMode=control-group\n"

test fn the_teardown_dropin_carries_the_declared_pair_and_nothing_else() -> Bool {
  gunbc_runner_unit_teardown_dropin_text() == expected_teardown_dropin_text
}

test fn the_teardown_dropin_lands_in_the_runner_template_dropin_directory() -> Bool {
  (runner_unit_teardown_dropin_path() as String) == "/etc/systemd/system/actions-runner@.service.d/70-fleet-teardown.conf"
}

// THE DISCRIMINATING RED, AS THE LIVE FLEET CARRIES IT. `KillMode=process` with systemd's default
// `ExitType=main` is what srv1 reported on 2026-09-11. Rendering that pair through the same function
// must produce different bytes, and the predicate must refuse it, or the drop-in is a decoration that
// would read green whatever the fleet did. The ExitType=cgroup drop-in this one replaces is the second
// red: it is what the fleet carries on 2026-09-18, and a revert to it must not read green.
test fn the_live_teardown_pair_renders_differently_and_can_orphan() -> Bool {
  let live = RunnerUnitLifecycleIntent { exit_type: ExitTypeMain, kill_mode: KillModeProcess }
  let exittype_cgroup_dropin = RunnerUnitLifecycleIntent { exit_type: ExitTypeCgroup, kill_mode: KillModeControlGroup }
  serialize_systemd_drop_in(drop_in: runner_unit_teardown_dropin(intent: live)) != expected_teardown_dropin_text
    && !lifecycle_intent_stops_finished_incarnation(intent: live, main_exits_when_incarnation_ends: gunbc_runner_main_exits_when_incarnation_ends)
    && !lifecycle_intent_stops_finished_incarnation(intent: exittype_cgroup_dropin, main_exits_when_incarnation_ends: gunbc_runner_main_exits_when_incarnation_ends)
    && serialize_systemd_drop_in(drop_in: runner_unit_teardown_dropin(intent: exittype_cgroup_dropin)) != expected_teardown_dropin_text
    && lifecycle_intent_stops_finished_incarnation(intent: gunbc_runner_lifecycle_intent, main_exits_when_incarnation_ends: gunbc_runner_main_exits_when_incarnation_ends)
}

// The needrestart snippet, against upstream's syntax: an assignment into the override_rc hashref,
// keyed by a start-anchored quotemeta'd prefix, valued false so the restart is deferred. Perl `die`s
// on a malformed conf.d file, so these bytes are not cosmetic.
data expected_needrestart_text: String = "$nrconf\{override_rc\}->\{qr(^actions\\-runner\\@)\} = 0;\n"

fn desired_content(subject: String) -> String {
  match srv1_desired_population() {
    RunnerHostFilesDesiredRefused { cause: _ } => ""
    RunnerHostFilesDesired { files: fs, withheld: _ } =>
      fold(fs, init: "", f: (acc, f) => if (f.subject as String) == subject { f.content } else { acc })
  }
}

fn desired_path(subject: String) -> String {
  match srv1_desired_population() {
    RunnerHostFilesDesiredRefused { cause: _ } => ""
    RunnerHostFilesDesired { files: fs, withheld: _ } =>
      fold(fs, init: "", f: (acc, f) => if (f.subject as String) == subject { f.path as String } else { acc })
  }
}

test fn the_needrestart_snippet_defers_runner_units_by_upstream_syntax() -> Bool {
  desired_content(subject: "needrestart-runner-deferral") == expected_needrestart_text
    && desired_path(subject: "needrestart-runner-deferral") == "/etc/needrestart/conf.d/50-gunbc-actions-runner.conf"
}

test fn production_desired_population_withholds_uncited_depriv_and_still_delivers_teardown() -> Bool {
  match runner_host_file_desired_population(host: "srv1" as HostIdentity) {
    RunnerHostFilesDesiredRefused { cause: _ } => false
    RunnerHostFilesDesired { files: fs, withheld: w } =>
      length(fs) == 2
        && length(w) == 2
        && any(w, x => (x.subject as String) == "runner-depriv-dropin" && string_contains(s: x.cause as String, pattern: "TranscribedUncited"))
        && any(w, x => (x.subject as String) == "runner-unit-fragment")
        && any(fs, f => (f.subject as String) == "runner-teardown-dropin")
        && any(fs, f => (f.subject as String) == "needrestart-runner-deferral")
        && !any(fs, f => (f.subject as String) == "runner-unit-fragment")
        && !any(fs, f => (f.subject as String) == "runner-depriv-dropin")
  }
}

test fn the_desired_population_is_the_two_files_and_the_dropin_is_the_rendered_one() -> Bool {
  match srv1_desired_population() {
    RunnerHostFilesDesiredRefused { cause: _ } => false
    RunnerHostFilesDesired { files: fs, withheld: w } =>
      length(fs) == 4
        && length(w) == 0
        && desired_content(subject: "runner-teardown-dropin") == expected_teardown_dropin_text
        && desired_path(subject: "runner-unit-fragment") == "/etc/systemd/system/actions-runner@.service"
        && desired_path(subject: "runner-depriv-dropin") == "/etc/systemd/system/actions-runner@.service.d/depriv.conf"
  }
}

// The deferral key is derived from the SAME prefix every slot unit name is derived from, so a rename
// of the unit family moves both or neither.
test fn every_slot_unit_name_begins_with_the_deferred_prefix() -> Bool {
  starts_with(s: runner_unit_name_of_registration(registration_name: "srv1-01" as NonEmptyStr) as String, prefix: runner_unit_prefix)
    && starts_with(s: runner_unit_name_of_registration(registration_name: "srv4-21" as NonEmptyStr) as String, prefix: runner_unit_prefix)
}

test fn quotemeta_escapes_every_non_word_character_of_the_prefix() -> Bool {
  match needrestart_unit_name_prefix(raw: "a.b-c:d_e@f") {
    NeedrestartUnitNamePrefixRefused { cause: _ } => false
    NeedrestartUnitNamePrefixAdmitted { prefix: p } =>
      needrestart_unit_name_prefix_regex(prefix: p) == "qr(^a\\.b\\-c\\:d_e\\@f)"
  }
}

// An empty prefix would match every service, and a character outside systemd's unit-name alphabet
// could only come from a caller who meant something other than a unit name. Both refuse.
test fn a_prefix_that_is_empty_or_outside_the_unit_alphabet_refuses() -> Bool {
  let empty = match needrestart_unit_name_prefix(raw: "") {
    NeedrestartUnitNamePrefixRefused { cause: _ } => true
    NeedrestartUnitNamePrefixAdmitted { prefix: _ } => false
  }
  let spaced = match needrestart_unit_name_prefix(raw: "actions runner") {
    NeedrestartUnitNamePrefixRefused { cause: _ } => true
    NeedrestartUnitNamePrefixAdmitted { prefix: _ } => false
  }
  let paren = match needrestart_unit_name_prefix(raw: "a)b") {
    NeedrestartUnitNamePrefixRefused { cause: _ } => true
    NeedrestartUnitNamePrefixAdmitted { prefix: _ } => false
  }
  empty && spaced && paren
}

// Every desired path is inside the sealed /etc scope, so the write seal admits it; a path outside
// would refuse at the seal rather than reaching a sudo leg.
test fn every_desired_file_is_admitted_by_the_etc_write_seal() -> Bool {
  match srv1_desired_population() {
    RunnerHostFilesDesiredRefused { cause: _ } => false
    RunnerHostFilesDesired { files: fs, withheld: _ } =>
      fold(fs, init: true, f: (ok, f) => ok && match runner_host_file_write_admission(file: f) {
        TypedRemoteFileWriteAdmitted { write: _ } => true
        TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
      })
  }
}

// ── The subject ──────────────────────────────────────────────────────────────────────────────────

// The subject carries EVERY desired slot unit, not a representative, and the declared administrator.
test fn a_runner_host_admits_as_the_declared_administrator_with_every_desired_slot_unit() -> Bool {
  match runner_host_file_subject(host: "srv1" as HostIdentity) {
    RunnerHostFileSubjectRefused { cause: _ } => false
    RunnerHostFileSubjectAdmitted { subject: s } =>
      (s.target.principal as String) == "ubuntu"
        && (s.target.endpoint as String) == "srv1"
        && length(s.desired_units) > 1
        && any(s.desired_units, u => (u as String) == "actions-runner@srv1-01.service")
        && any(s.desired_units, u => (u as String) == "actions-runner@srv1-02.service")
  }
}

test fn a_host_with_no_runner_deploy_row_refuses() -> Bool {
  match runner_host_file_subject(host: "srv9" as HostIdentity) {
    RunnerHostFileSubjectRefused { cause: _ } => true
    RunnerHostFileSubjectAdmitted { subject: _ } => false
  }
}

test fn an_unmodeled_host_has_no_fragment_to_deliver() -> Bool {
  match runner_host_file_desired_population(host: "srv9" as HostIdentity) {
    RunnerHostFilesDesiredRefused { cause: _ } => true
    RunnerHostFilesDesired { files: _, withheld: _ } => false
  }
}

// ── File content and metadata judgments ──────────────────────────────────────────────────────────

fn standing_is_absent(standing: RunnerHostFileStanding) -> Bool {
  match standing {
    HostFileAbsent => true
    HostFileIdentical => false
    HostFileDiffers => false
    HostFileUnobservable { reason: _ } => false
  }
}

fn standing_is_unobservable(standing: RunnerHostFileStanding) -> Bool {
  match standing {
    HostFileUnobservable { reason: _ } => true
    HostFileAbsent => false
    HostFileIdentical => false
    HostFileDiffers => false
  }
}

test fn presence_zero_continues_one_is_absent_other_is_unobservable() -> Bool {
  let continues = match classify_host_file_presence(exit_code: 0, stderr: "") {
    Absent => true
    Present { value: _ } => false
  }
  let absent = match classify_host_file_presence(exit_code: 1, stderr: "") {
    Present { value: st } => standing_is_absent(standing: st)
    Absent => false
  }
  let unobservable = match classify_host_file_presence(exit_code: 2, stderr: "test: extra argument") {
    Present { value: st } => standing_is_unobservable(standing: st)
    Absent => false
  }
  continues && absent && unobservable
}

// Every directory from the write scope down to the file's own, in order, and nothing above /etc.
test fn the_ancestors_of_a_file_are_every_directory_from_the_scope_down() -> Bool {
  runner_host_path_ancestors(path: "/etc/needrestart/conf.d/50-gunbc-actions-runner.conf")
    == ["/etc", "/etc/needrestart", "/etc/needrestart/conf.d"]
    && runner_host_path_ancestors(path: "/etc/systemd/system/actions-runner@.service.d/70-fleet-teardown.conf")
    == ["/etc", "/etc/systemd", "/etc/systemd/system", "/etc/systemd/system/actions-runner@.service.d"]
}

test fn the_root_only_predicate_is_evaluated_far_side_by_find() -> Bool {
  runner_host_root_only_find_argv(paths: ["/etc", "/etc/needrestart"], kind: "d")
    == ["find", "/etc", "/etc/needrestart", "-maxdepth", "0", "-type", "d", "-user", "root", "-group", "root", "-not", "-perm", "/022"]
}

// find prints the SAFE set; anything requested and not printed failed a clause.
test fn a_path_find_did_not_print_is_not_root_only() -> Bool {
  let all_safe = match classify_root_only_paths(requested: ["/etc", "/etc/needrestart"], exit_code: 0, stdout: "/etc\n/etc/needrestart\n", stderr: "") {
    PathsRootOnly => true
    PathsNotRootOnly { paths: _, detail: _ } => false
    PathsUnobservable { reason: _ } => false
    PathsNotApplicable => false
  }
  let one_unsafe = match classify_root_only_paths(requested: ["/etc", "/etc/needrestart"], exit_code: 0, stdout: "/etc\n", stderr: "") {
    PathsNotRootOnly { paths: ps, detail: _ } => ps == ["/etc/needrestart"]
    PathsRootOnly => false
    PathsUnobservable { reason: _ } => false
    PathsNotApplicable => false
  }
  let missing = match classify_root_only_paths(requested: ["/etc/needrestart/conf.d"], exit_code: 1, stdout: "", stderr: "find: '/etc/needrestart/conf.d': No such file or directory") {
    PathsNotRootOnly { paths: ps, detail: _ } => ps == ["/etc/needrestart/conf.d"]
    PathsRootOnly => false
    PathsUnobservable { reason: _ } => false
    PathsNotApplicable => false
  }
  all_safe && one_unsafe && missing
}

fn action_of(content: RunnerHostFileStanding, file_metadata: RunnerHostPathMetadata, ancestors: RunnerHostPathMetadata) -> RunnerHostFileAction {
  runner_host_file_action(observation: RunnerHostFileObservation { content: content, file_metadata: file_metadata, ancestors: ancestors })
}

fn is_leave(a: RunnerHostFileAction) -> Bool { match a { HostFileLeaveInPlace => true HostFileWrite => false HostFileActionRefused { reason: _ } => false } }
fn is_write(a: RunnerHostFileAction) -> Bool { match a { HostFileWrite => true HostFileLeaveInPlace => false HostFileActionRefused { reason: _ } => false } }
fn is_refused(a: RunnerHostFileAction) -> Bool { match a { HostFileActionRefused { reason: _ } => true HostFileWrite => false HostFileLeaveInPlace => false } }

data unsafe_file_metadata: RunnerHostPathMetadata = PathsNotRootOnly { paths: ["/etc/needrestart/conf.d/50-gunbc-actions-runner.conf"], detail: "owned by ghrunner" }

// THE METADATA RED. Byte-identical content that the CI user can rewrite is NOT left in place: root
// evaluates it, so it is rewritten, which replaces its owner and mode with root's.
test fn identical_bytes_with_unsafe_file_metadata_are_rewritten_not_left() -> Bool {
  is_leave(a: action_of(content: HostFileIdentical, file_metadata: PathsRootOnly, ancestors: PathsRootOnly))
    && is_write(a: action_of(content: HostFileIdentical, file_metadata: unsafe_file_metadata, ancestors: PathsRootOnly))
    && is_refused(a: action_of(content: HostFileIdentical, file_metadata: PathsUnobservable { reason: "find exit=2" }, ancestors: PathsRootOnly))
}

// A writable ancestor cannot be repaired by writing the file, and writing into it would publish
// root-evaluated bytes where a CI user can replace them, so it refuses whatever the content is.
test fn an_ancestor_that_is_not_root_only_refuses_every_action() -> Bool {
  let unsafe_dir = PathsNotRootOnly { paths: ["/etc/needrestart/conf.d"], detail: "mode 0777" }
  is_refused(a: action_of(content: HostFileIdentical, file_metadata: PathsRootOnly, ancestors: unsafe_dir))
    && is_refused(a: action_of(content: HostFileAbsent, file_metadata: PathsNotApplicable, ancestors: unsafe_dir))
    && is_refused(a: action_of(content: HostFileDiffers, file_metadata: PathsRootOnly, ancestors: PathsUnobservable { reason: "ssh refused" }))
}

// A failure to look plans no write: an unobservable file is refused, never overwritten on the strength
// of not having been read.
test fn only_a_seen_difference_or_absence_plans_a_write() -> Bool {
  is_write(a: action_of(content: HostFileDiffers, file_metadata: PathsRootOnly, ancestors: PathsRootOnly))
    && is_write(a: action_of(content: HostFileAbsent, file_metadata: PathsNotApplicable, ancestors: PathsRootOnly))
    && is_refused(a: action_of(content: HostFileUnobservable { reason: "permission denied" }, file_metadata: PathsNotApplicable, ancestors: PathsRootOnly))
}

// ── Slot unit judgments ──────────────────────────────────────────────────────────────────────────

fn reading(load: String, reload: String, kill: String, exit: String) -> RunnerSlotUnitReading {
  RunnerSlotUnitReading { unit: "actions-runner@srv1-01.service" as NonEmptyStr, load_state: load, need_daemon_reload: reload, kill_mode: kill, exit_type: exit }
}

fn standing_wire_of(st: RunnerSlotUnitStanding) -> String {
  match st {
    SlotTeardownEffective => "effective"
    SlotTeardownNotEffective { kill_mode: k, exit_type: e } => concat(concat("not-effective:", k), concat(":", e))
    SlotReloadPending => "reload-pending"
    SlotUnitNotLoaded { load_state: l } => concat("not-loaded:", l)
    SlotRetiredAsDeclared => "retired"
    SlotRetirementIncomplete { cause: _ } => "retirement-incomplete"
    SlotUnitUnread => "unread"
  }
}

test fn the_declared_pair_on_a_loaded_current_unit_is_effective() -> Bool {
  standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "loaded", reload: "no", kill: "control-group", exit: "main"), intent: gunbc_runner_lifecycle_intent)) == "effective"
}

// THE FALSE-POSITIVE RED. systemctl shows a unit it has not loaded with the manager's DEFAULTS, and the
// default KillMode is control-group; a check reading KillMode first would certify a slot that does not
// exist. LoadState is read first.
test fn a_not_loaded_unit_reporting_default_values_is_not_certified() -> Bool {
  standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "not-found", reload: "no", kill: "control-group", exit: "cgroup"), intent: gunbc_runner_lifecycle_intent)) == "not-loaded:not-found"
}

// A loaded unit whose files changed on disk still reports the OLD values; it is reload-pending, not a
// verdict on the teardown in either direction.
test fn a_unit_needing_reload_is_pending_whatever_it_reports() -> Bool {
  standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "loaded", reload: "yes", kill: "control-group", exit: "cgroup"), intent: gunbc_runner_lifecycle_intent)) == "reload-pending"
    && standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "loaded", reload: "yes", kill: "process", exit: "main"), intent: gunbc_runner_lifecycle_intent)) == "reload-pending"
}

// srv1's and srv2's live reading before the teardown drop-in (2026-09-11), the ExitType=cgroup drop-in
// that replaced it (2026-09-18), and a partial kill mode alone.
test fn the_live_reading_and_each_half_alone_are_not_effective() -> Bool {
  standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "loaded", reload: "no", kill: "process", exit: "main"), intent: gunbc_runner_lifecycle_intent)) == "not-effective:process:main"
    && standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "loaded", reload: "no", kill: "control-group", exit: "cgroup"), intent: gunbc_runner_lifecycle_intent)) == "not-effective:control-group:cgroup"
    && standing_wire_of(st: classify_runner_slot_unit_against_retirement(retirements: [], reading: reading(load: "loaded", reload: "no", kill: "mixed", exit: "main"), intent: gunbc_runner_lifecycle_intent)) == "not-effective:mixed:main"
}

// ── The slot population ──────────────────────────────────────────────────────────────────────────

data list_units_fixture: String = "actions-runner@srv1-01.service loaded active running Ephemeral GitHub Actions Runner (srv1-01)\nactions-runner@srv1-02.service loaded active running Ephemeral GitHub Actions Runner (srv1-02)\nactions-runner@srv1-38.service loaded inactive dead Ephemeral GitHub Actions Runner (srv1-38)\nssh.service loaded active running OpenBSD Secure Shell server\nxactions-runner@srv1-01.service loaded active running decoy\n"

test fn list_units_yields_only_runner_slot_unit_names() -> Bool {
  runner_slot_units_from_list_units(stdout: list_units_fixture)
    == ["actions-runner@srv1-01.service", "actions-runner@srv1-02.service", "actions-runner@srv1-38.service"]
}

// A loaded slot outside the desired roster is part of the population; a desired slot the manager does
// not hold is kept, to be read as not-loaded rather than skipped.
test fn the_population_is_desired_units_then_loaded_extras() -> Bool {
  map(
    runner_slot_population_units(
      desired: ["actions-runner@srv1-01.service" as NonEmptyStr, "actions-runner@srv1-03.service" as NonEmptyStr],
      retired: [],
      loaded: runner_slot_units_from_list_units(stdout: list_units_fixture),
    ),
    u => u as String,
  ) == ["actions-runner@srv1-01.service", "actions-runner@srv1-03.service", "actions-runner@srv1-02.service", "actions-runner@srv1-38.service"]
}

data show_fixture: String = "Id=actions-runner@srv1-01.service\nLoadState=loaded\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group\n\nId=actions-runner@srv1-02.service\nLoadState=loaded\nNeedDaemonReload=no\nExitType=main\nKillMode=process\n\nId=actions-runner@srv1-03.service\nLoadState=not-found\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group"

fn population_wires(units: List<String>) -> List<String> {
  map(
    classify_runner_slot_population(units: map(units, u => u as NonEmptyStr), retirements: [], show_stdout: show_fixture, intent: gunbc_runner_lifecycle_intent),
    r => standing_wire_of(st: r.standing),
  )
}

// Each unit is joined to the block that NAMES it -- property order within a block is not relied on --
// and a unit with no block of its own is unread, never borrowed from a neighbour.
test fn each_unit_is_judged_on_its_own_block_and_a_missing_block_is_unread() -> Bool {
  population_wires(units: ["actions-runner@srv1-02.service", "actions-runner@srv1-01.service", "actions-runner@srv1-03.service", "actions-runner@srv1-09.service"])
    == ["not-effective:process:main", "effective", "not-loaded:not-found", "unread"]
}

fn population_of(standings: List<RunnerSlotUnitStanding>) -> RunnerSlotPopulation {
  SlotPopulationObserved { units: map(standings, st => RunnerSlotUnitResult { unit: "actions-runner@srv1-01.service" as NonEmptyStr, standing: st }) }
}

// THE HOST-WIDE VERDICT IS OVER EVERY UNIT. One not-effective, not-loaded, pending or unread unit among
// effective ones is enough to deny it, and an empty population proves nothing.
test fn the_host_is_effective_only_when_every_unit_is() -> Bool {
  runner_slot_population_effective(population: population_of(standings: [SlotTeardownEffective, SlotTeardownEffective]))
    && !runner_slot_population_effective(population: population_of(standings: [SlotTeardownEffective, SlotTeardownNotEffective { kill_mode: "process", exit_type: "main" }]))
    && !runner_slot_population_effective(population: population_of(standings: [SlotTeardownEffective, SlotUnitNotLoaded { load_state: "not-found" }]))
    && !runner_slot_population_effective(population: population_of(standings: [SlotTeardownEffective, SlotReloadPending]))
    && !runner_slot_population_effective(population: population_of(standings: [SlotTeardownEffective, SlotUnitUnread]))
    && !runner_slot_population_effective(population: population_of(standings: []))
    && !runner_slot_population_effective(population: SlotPopulationUnobservable { reason: "ssh refused" })
}

// THE RETRY RED. A reload is owed whenever the manager says a unit is stale, whether or not this run
// wrote anything -- which is exactly the state a run finds after an earlier run landed the file and its
// reload failed.
test fn a_reload_is_owed_by_a_stale_unit_even_when_nothing_was_written() -> Bool {
  runner_slot_population_owes_reload(population: population_of(standings: [SlotTeardownNotEffective { kill_mode: "process", exit_type: "main" }, SlotReloadPending]))
    && !runner_slot_population_owes_reload(population: population_of(standings: [SlotTeardownNotEffective { kill_mode: "process", exit_type: "main" }]))
    && !runner_slot_population_owes_reload(population: SlotPopulationUnobservable { reason: "ssh refused" })
}

// ── Terminal ─────────────────────────────────────────────────────────────────────────────────────

fn teardown_desired() -> RunnerHostFileDesired? {
  match srv1_desired_population() {
    RunnerHostFilesDesiredRefused { cause: _ } => none
    RunnerHostFilesDesired { files: fs, withheld: _ } =>
      fold(fs, init: none, f: (acc, f) => if (f.subject as String) == "runner-teardown-dropin" { Present { value: f } } else { acc })
  }
}

fn witness_subject() -> RunnerHostFileSubject? {
  match runner_host_file_subject(host: "srv1" as HostIdentity) {
    RunnerHostFileSubjectAdmitted { subject: s } => Present { value: s }
    RunnerHostFileSubjectRefused { cause: _ } => none
  }
}

fn settled_run(mode: RunnerHostFileConvergeMode, reload: RunnerHostManagerReload, slots: RunnerSlotPopulation) -> Bool {
  match witness_subject() {
    Absent => false
    Present { value: s } =>
      match teardown_desired() {
        Absent => false
        Present { value: f } =>
          runner_host_file_run_succeeded(run: RunnerHostFileRun {
            subject: s,
            mode: mode,
            privilege: AdministratorPrivilegeAvailable,
            results: [RunnerHostFileResult {
              planned: RunnerHostFilePlanned {
                file: f,
                observation: RunnerHostFileObservation { content: HostFileIdentical, file_metadata: PathsRootOnly, ancestors: PathsRootOnly },
                action: HostFileLeaveInPlace,
              },
              outcome: match mode { RunnerHostFilesObserveOnly => HostFileNotAppliedObserveOnly RunnerHostFilesApply => HostFileLeftInPlace },
            }],
            reload: reload,
            slots: slots,
          })
      }
  }
}

// Observe succeeds on a host whose teardown is NOT yet effective -- that is what it exists to report --
// and apply does not. Apply also refuses a reload it owed and did not perform, and a population with
// any unit it could not read. run_runner_host_files is not driven here: the floor classifies that
// call as reaching shell.PosixCommandV.Check (no mock_response). Privilege, unread slots, and
// ancestor refusal stay as the classifiers; re-enroll the integration when Check has a hermetic arm.
test fn observe_reports_what_apply_refuses() -> Bool {
  let old = population_of(standings: [SlotTeardownNotEffective { kill_mode: "process", exit_type: "main" }])
  let good = population_of(standings: [SlotTeardownEffective, SlotTeardownEffective])
  settled_run(mode: RunnerHostFilesObserveOnly, reload: ManagerReloadNotOwed, slots: old)
    && !settled_run(mode: RunnerHostFilesApply, reload: ManagerReloadNotOwed, slots: old)
    && settled_run(mode: RunnerHostFilesApply, reload: ManagerReloaded, slots: good)
    && !settled_run(mode: RunnerHostFilesApply, reload: ManagerReloadRefused { reason: "exit=1" }, slots: good)
    && !settled_run(mode: RunnerHostFilesApply, reload: ManagerReloadOwedNotAttempted { reason: "privilege refused" }, slots: good)
    && !settled_run(mode: RunnerHostFilesObserveOnly, reload: ManagerReloadNotOwed, slots: population_of(standings: [SlotUnitUnread]))
}

// ── The population joined against the retirement authority ──────────────────────────────────────

// srv1's reading in run 35416072847: slots 01..12 loaded with the declared pair, 13..21 masked by
// gunbc.runner_slot_retirement. Names come from the census authority and the retired set from the
// width transition itself, so the control exercises the real join rather than a designed roster.
fn srv1_unit_names(slot: Int, limit: Int) -> List<String> {
  desired_unit_names_range(host: "srv1" as HostIdentity, slot: slot, limit: limit)
}

fn show_block_of(unit: String, load: String) -> String {
  join(["Id=", unit, "\nLoadState=", load, "\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group"], "")
}

fn srv1_show_reading(live: List<String>, masked: List<String>) -> String {
  join(concat(map(live, u => show_block_of(unit: u, load: "loaded")), map(masked, u => show_block_of(unit: u, load: "masked"))), "\n\n")
}

fn srv1_population(units: List<String>, retirements: List<RunnerRetirementStanding>, show: String) -> RunnerSlotPopulation {
  SlotPopulationObserved { units: classify_runner_slot_population(units: map(units, u => u as NonEmptyStr), retirements: retirements, show_stdout: show, intent: gunbc_runner_lifecycle_intent) }
}

// The retirement authority's own verdict over the property readings `mask --now` leaves behind, for
// every unit the real srv1 subject carries as a required retiree. The readings are the boundary; the
// fold from readings to standing is gunbc.runner_slot_retirement's, not restated here.
fn srv1_retirements(active: String, occupancy: CgroupOccupancy) -> List<RunnerRetirementStanding> {
  match witness_subject() {
    Absent => []
    Present { value: s } => map(s.retired_units, u => runner_retirement_standing(o: retirement_observation_from_readings(unit: u, unit_file_state: "masked", active_state: active, occupancy: occupancy)))
  }
}

fn srv1_drained() -> List<RunnerRetirementStanding> {
  srv1_retirements(active: "inactive", occupancy: CgroupAbsent)
}

// POSITIVE CONTROL. The 21-unit reading that refused is effective once each masked unit is joined to
// the retirement authority's COMPLETE verdict, and the route is the join: every masked unit reads
// retired, and the same reading with no retirement standing refuses.
test fn srv1_twelve_live_and_nine_retired_masked_is_effective() -> Bool {
  let units = srv1_unit_names(slot: 1, limit: 21)
  let show = srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 12), masked: srv1_unit_names(slot: 13, limit: 21))
  let pop = srv1_population(units: units, retirements: srv1_drained(), show: show)
  runner_slot_population_effective(population: pop)
    && (match pop {
      SlotPopulationUnobservable { reason: _ } => false
      SlotPopulationObserved { units: us } => length(filter(us, r => standing_wire_of(st: r.standing) == "retired")) == 9
    })
    && !runner_slot_population_effective(population: srv1_population(units: units, retirements: [], show: show))
}

// RED: masked is the inhibit, not the drain. A retiree masked while its worker still runs -- service
// active, or its cgroup still populated -- is the orphan the retirement exists to prevent, and refuses.
test fn a_masked_retiree_still_running_or_occupied_refuses() -> Bool {
  let units = srv1_unit_names(slot: 1, limit: 21)
  let show = srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 12), masked: srv1_unit_names(slot: 13, limit: 21))
  let running = srv1_population(units: units, retirements: srv1_retirements(active: "deactivating", occupancy: CgroupAbsent), show: show)
  !runner_slot_population_effective(population: running)
    && !runner_slot_population_effective(population: srv1_population(units: units, retirements: srv1_retirements(active: "inactive", occupancy: CgroupObservedPopulated), show: show))
    && (match running {
      SlotPopulationUnobservable { reason: _ } => false
      SlotPopulationObserved { units: us } => length(filter(us, r => standing_wire_of(st: r.standing) == "retirement-incomplete")) == 9
    })
}

// RED: a masked slot the authority does NOT retire is a slot masked by mistake, not a retirement.
test fn a_masked_declared_live_slot_is_not_retired_and_refuses() -> Bool {
  let pop = srv1_population(units: srv1_unit_names(slot: 1, limit: 21), retirements: srv1_drained(), show: srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 11), masked: srv1_unit_names(slot: 12, limit: 21)))
  !runner_slot_population_effective(population: pop)
    && (match pop {
      SlotPopulationUnobservable { reason: _ } => false
      SlotPopulationObserved { units: us } => any(us, r => (r.unit as String) == "actions-runner@srv1-12.service" && standing_wire_of(st: r.standing) == "not-loaded:masked")
    })
}

// RED: a declared-live slot missing from the host stays a refusal, retirement notwithstanding.
test fn a_declared_live_slot_missing_from_the_host_refuses() -> Bool {
  let missing = "Id=actions-runner@srv1-12.service\nLoadState=not-found\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group"
  let show = join([srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 11), masked: srv1_unit_names(slot: 13, limit: 21)), missing], "\n\n")
  !runner_slot_population_effective(population: srv1_population(units: srv1_unit_names(slot: 1, limit: 21), retirements: srv1_drained(), show: show))
}

// RED: a required retiree that list-units OMITS is still observed. Absence from a listing is not
// retirement, so the population is built from the real srv1 subject's desired and retired rosters
// (live 01..12, retiring 13..50 per gunbc.runner_width_transition) over a listing that names every
// slot but 21; slot 21 must still be a member, its retirement standing must still be joined, and
// forty-nine healthy units must not carry the verdict.
fn srv1_list_units_without_21() -> String {
  join(map(concat(srv1_unit_names(slot: 1, limit: 20), srv1_unit_names(slot: 22, limit: 50)), u => concat(u, " loaded active running GitHub Actions runner")), "\n")
}

fn srv1_population_over_listing(retirements: List<RunnerRetirementStanding>, show: String) -> RunnerSlotPopulation {
  match witness_subject() {
    Absent => SlotPopulationUnobservable { reason: "no srv1 subject" }
    Present { value: s } =>
      SlotPopulationObserved {
        units: classify_runner_slot_population(
          units: runner_slot_population_units(desired: s.desired_units, retired: s.retired_units, loaded: runner_slot_units_from_list_units(stdout: srv1_list_units_without_21())),
          retirements: retirements,
          show_stdout: show,
          intent: gunbc_runner_lifecycle_intent,
        ),
      }
  }
}

fn population_holds(pop: RunnerSlotPopulation, unit: String, wire: String) -> Bool {
  match pop {
    SlotPopulationUnobservable { reason: _ } => false
    SlotPopulationObserved { units: us } => any(us, r => (r.unit as String) == unit && standing_wire_of(st: r.standing) == wire)
  }
}

test fn a_required_retiree_omitted_from_list_units_is_still_observed_and_refuses() -> Bool {
  let omitted = "actions-runner@srv1-21.service"
  let healthy = srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 12), masked: srv1_unit_names(slot: 13, limit: 50))
  let still_running = map(srv1_drained(), st => if retirement_unit(s: st) == omitted {
    runner_retirement_standing(o: retirement_observation_from_readings(unit: omitted as NonEmptyStr, unit_file_state: "masked", active_state: "active", occupancy: CgroupObservedPopulated))
  } else { st })
  let running_pop = srv1_population_over_listing(retirements: still_running, show: healthy)
  population_holds(pop: running_pop, unit: omitted, wire: "retirement-incomplete")
    && !runner_slot_population_effective(population: running_pop)
}

// The other half of the same omission, split because the floor prices a claim as a whole and a
// conjunction of independent cases forces every case through one budget (DESIGN 3): the omitted
// retiree with NO reading of its own is unread, and refuses.
test fn an_unread_omitted_retiree_refuses() -> Bool {
  let unread_pop = srv1_population_over_listing(retirements: srv1_drained(), show: srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 12), masked: concat(srv1_unit_names(slot: 13, limit: 20), srv1_unit_names(slot: 22, limit: 50))))
  population_holds(pop: unread_pop, unit: "actions-runner@srv1-21.service", wire: "unread")
    && !runner_slot_population_effective(population: unread_pop)
}

// THE POSITIVE CONTROL for the two REDs above, and what makes them discriminating: the SAME listing
// that omits slot 21, with every retiree read and drained, IS effective.
test fn the_same_listing_with_every_retiree_read_and_drained_is_effective() -> Bool {
  runner_slot_population_effective(population: srv1_population_over_listing(retirements: srv1_drained(), show: srv1_show_reading(live: srv1_unit_names(slot: 1, limit: 12), masked: srv1_unit_names(slot: 13, limit: 50))))
}

// ── Every retiree read from the population's two batched reads (review 68628) ────────────────────

// A SUPPLIED THREE-RETIREE ROSTER, BECAUSE THE ROSTER IS NOT THE SUBJECT HERE (DESIGN 3). These
// claims discriminate at ONE interface -- the show block and the batched events output a retiree is
// read from -- and paying for srv1's real 38 on every one of them made the claims' cost independent
// of their assertions, which the floor refused. The real roster is not dropped: it stays the subject
// of the claims below that read witness_subject() directly, which is where its inhabitance belongs.
fn srv1_retired() -> List<NonEmptyStr> {
  match witness_subject() {
    Absent => []
    Present { value: s } => s.retired_units
  }
}

fn three_retirees() -> List<NonEmptyStr> {
  ["actions-runner@srv1-13.service" as NonEmptyStr, "actions-runner@srv1-14.service" as NonEmptyStr, "actions-runner@srv1-15.service" as NonEmptyStr]
}

// srv1's show block for a retiree after `mask --now`, carrying the retirement authority's three
// readings in the same block as the teardown pair. `cg` is the ControlGroup value systemd reports.
fn retiree_block(unit: String, active: String, cg: String) -> String {
  join(["Id=", unit, "\nLoadState=masked\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group\nUnitFileState=masked\nActiveState=", active, "\nControlGroup=", cg], "")
}

fn retiree_cg(unit: String) -> String {
  concat("/system.slice/system-actions\\x2drunner.slice/", unit)
}

fn events_line(unit: String, populated: String) -> String {
  join(["/sys/fs/cgroup", retiree_cg(unit: unit), "/cgroup.events:populated ", populated], "")
}

fn blocks_for(units: List<NonEmptyStr>, active: String, live_cgroup: Bool) -> String {
  join(map(units, u => retiree_block(unit: u as String, active: active, cg: if live_cgroup { retiree_cg(unit: u as String) } else { "" })), "\n\n")
}

fn events_for(units: List<NonEmptyStr>, populated: String) -> String {
  join(map(units, u => events_line(unit: u as String, populated: populated)), "\n")
}

fn standings_for(units: List<NonEmptyStr>, show: String, batch: CgroupEventsBatch) -> List<RunnerRetirementStanding> {
  runner_retiree_standings(readings: runner_retiree_show_readings(retired: units, show_stdout: show), batch: batch)
}

fn events_read_of(retired: List<NonEmptyStr>, show: String) -> RetireeCgroupEventsRead {
  runner_retiree_cgroup_events_read(readings: runner_retiree_show_readings(retired: retired, show_stdout: show))
}

fn argv_or_empty(o: RetireeCgroupEventsRead) -> List<String> {
  match o {
    RetireeCgroupEventsArgv { argv: a } => a
    RetireeCgroupEventsNotOwed => []
    RetireeCgroupEventsRefused { cause: _ } => []
  }
}

fn batch_cause(b: CgroupEventsBatch) -> String {
  match b {
    CgroupEventsBatchUnread { cause: c } => c
    CgroupEventsBatchRead { stdout: _, stderr: _ } => ""
  }
}

fn standings_of(sts: List<RunnerRetirementStanding>, unit: String) -> List<RunnerRetirementStanding> {
  filter(sts, st => retirement_unit(s: st) == unit)
}

// COST: the retiree read is ONE argv naming a DIRECTORY, so it does not grow with the retiree count.
// The same argv serves three retirees and one, and a population whose retirees hold no cgroup owes
// no read at all.
test fn the_retiree_cgroup_read_is_one_exec_whatever_the_retiree_count() -> Bool {
  let show = blocks_for(units: three_retirees(), active: "active", live_cgroup: true)
  let many = argv_or_empty(o: events_read_of(retired: three_retirees(), show: show))
  many == ["grep", "-r", "-H", "-F", "populated", "--include=cgroup.events", "/sys/fs/cgroup/system.slice"]
    && argv_or_empty(o: events_read_of(retired: ["actions-runner@srv1-13.service" as NonEmptyStr], show: show)) == many
    && (match events_read_of(retired: three_retirees(), show: blocks_for(units: three_retirees(), active: "inactive", live_cgroup: false)) {
      RetireeCgroupEventsNotOwed => true
      RetireeCgroupEventsArgv { argv: _ } => false
      RetireeCgroupEventsRefused { cause: _ } => false
    })
}

// THE DECIDING BOUNDARY, EXECUTED (review 68654). The events argv is run through the SAME
// gunbc.fleet_known_hosts_anchor portable_remote_words admission the production leg applies in
// gunbc.typed_argv_exec typed_argv_exec_over_fleet_ssh, and must be ADMITTED -- an argv refused there
// reads nothing, which would make SlotRetiredAsDeclared unreachable for every retiree that still
// holds a cgroup while the observation still looked like three execs.
test fn every_argv_the_population_observation_issues_is_admitted_by_the_transport() -> Bool {
  let events = argv_or_empty(o: events_read_of(retired: three_retirees(), show: blocks_for(units: three_retirees(), active: "active", live_cgroup: true)))
  let show = systemctl_show_properties_argv(units: three_retirees(), properties: runner_slot_show_properties)
  length(events) == 7
    && (match portable_remote_words(raws: events) { Absent => false Present { value: _ } => true })
    && (match portable_remote_words(raws: show) { Absent => false Present { value: _ } => true })
}

// RED: the per-retiree form this replaced. A retiree's own cgroup path carries systemd's escaped
// slice component, and the transport refuses a backslash rather than quoting it -- so an argv naming
// those paths is NOT admitted, and a claim that supplied the batch output directly could not see it.
test fn an_argv_naming_a_retirees_own_escaped_cgroup_path_is_refused_by_the_transport() -> Bool {
  let path = "/sys/fs/cgroup/system.slice/system-actions\\x2drunner.slice/actions-runner@srv1-13.service/cgroup.events"
  (match portable_remote_words(raws: ["grep", "-H", "-F", "populated", path]) { Absent => true Present { value: _ } => false })
    && (match portable_remote_words(raws: ["grep", "-r", "-H", "-F", "populated", "--include=cgroup.events", "/sys/fs/cgroup/system.slice"]) { Absent => false Present { value: _ } => true })
    && string_contains(s: retiree_cg(unit: "actions-runner@srv1-13.service"), pattern: "\\")
}

// POSITIVE ROUTE: stopped, masked retirees with no cgroup are complete from the show alone, and ones
// that still hold a cgroup are complete only on their own `populated 0` line of the batched read.
test fn batched_readings_reach_retirement_complete() -> Bool {
  let stopped = standings_for(units: three_retirees(), show: blocks_for(units: three_retirees(), active: "inactive", live_cgroup: false), batch: CgroupEventsBatchRead { stdout: "", stderr: "" })
  let drained = standings_for(units: three_retirees(), show: blocks_for(units: three_retirees(), active: "inactive", live_cgroup: true), batch: CgroupEventsBatchRead { stdout: events_for(units: three_retirees(), populated: "0"), stderr: "" })
  length(stopped) == 3 && all(stopped, st => retirement_is_complete(s: st))
    && length(drained) == 3 && all(drained, st => retirement_is_complete(s: st))
}

// RED: absence from a batched output is not retirement. A retiree whose show block is missing, or
// whose events line is missing, reads unobserved; a populated line reads pending; a refused batch
// leaves every live cgroup unobserved -- and the other retirees being complete changes none of it.
test fn a_retiree_missing_from_a_batched_read_is_unobserved_never_retired() -> Bool {
  let omitted = "actions-runner@srv1-13.service"
  let others = filter(three_retirees(), r => (r as String) != omitted)
  let show_all = blocks_for(units: three_retirees(), active: "inactive", live_cgroup: true)
  let all_drained = CgroupEventsBatchRead { stdout: events_for(units: three_retirees(), populated: "0"), stderr: "" }
  let not_shown = standings_for(units: three_retirees(), show: blocks_for(units: others, active: "inactive", live_cgroup: true), batch: all_drained)
  let not_read = standings_for(units: three_retirees(), show: show_all, batch: CgroupEventsBatchRead { stdout: events_for(units: others, populated: "0"), stderr: "" })
  let populated = standings_for(units: three_retirees(), show: show_all, batch: CgroupEventsBatchRead { stdout: events_for(units: three_retirees(), populated: "1"), stderr: "" })
  let refused = standings_for(units: three_retirees(), show: show_all, batch: CgroupEventsBatchUnread { cause: "refused" })
  all(standings_of(sts: not_shown, unit: omitted), st => retirement_is_unobserved(s: st))
    && all(standings_of(sts: not_read, unit: omitted), st => retirement_is_unobserved(s: st))
    && length(filter(not_read, st => retirement_is_complete(s: st))) == 2
    && all(populated, st => !retirement_is_complete(s: st) && !retirement_is_unobserved(s: st))
    && all(refused, st => retirement_is_unobserved(s: st))
}

// RED (review 68685): a population whose retirees sit under DISAGREEING cgroup roots is refused, and
// the refusal NAMES the roots. The collapsed optional told exactly this population -- the only one
// that ever read the cause -- that no read was owed, while the roots that identify the disagreement
// were discarded. A population that owes no read says so in its own words.
test fn disagreeing_cgroup_roots_refuse_and_name_the_roots() -> Bool {
  let retired = ["actions-runner@srv1-13.service" as NonEmptyStr, "actions-runner@srv1-14.service" as NonEmptyStr]
  let split_show = join([
    retiree_block(unit: "actions-runner@srv1-13.service", active: "active", cg: retiree_cg(unit: "actions-runner@srv1-13.service")),
    retiree_block(unit: "actions-runner@srv1-14.service", active: "active", cg: "/user.slice/user-1000.slice/actions-runner@srv1-14.service"),
  ], "\n\n")
  let refused = events_read_of(retired: retired, show: split_show)
  let cause = batch_cause(b: runner_retiree_cgroup_events_unread(read: refused))
  (match refused { RetireeCgroupEventsRefused { cause: _ } => true RetireeCgroupEventsNotOwed => false RetireeCgroupEventsArgv { argv: _ } => false })
    && string_contains(s: cause, pattern: "/sys/fs/cgroup/system.slice")
    && string_contains(s: cause, pattern: "/sys/fs/cgroup/user.slice")
    && !string_contains(s: cause, pattern: "no read was owed")
    && all(standings_for(units: retired, show: split_show, batch: runner_retiree_cgroup_events_unread(read: refused)), st => retirement_is_unobserved(s: st))
    && string_contains(s: batch_cause(b: runner_retiree_cgroup_events_unread(read: events_read_of(retired: retired, show: blocks_for(units: retired, active: "inactive", live_cgroup: false)))), pattern: "no read was owed")
}

// INHABITANCE OF THE REAL ROSTER (DESIGN 3, the pairing obligation). The claims above supply a
// three-retiree roster; this one asserts the real srv1 subject the production route carries reaches
// the same functions: gunbc.runner_width_transition obliges 38 retirees, their real ControlGroup
// paths carry systemd's escape, and one admitted argv still covers all of them.
test fn the_real_srv1_retiree_roster_reaches_one_admitted_read() -> Bool {
  let retired = srv1_retired()
  let argv = argv_or_empty(o: events_read_of(retired: retired, show: blocks_for(units: retired, active: "active", live_cgroup: true)))
  length(retired) == 38
    && argv == ["grep", "-r", "-H", "-F", "populated", "--include=cgroup.events", "/sys/fs/cgroup/system.slice"]
    && (match portable_remote_words(raws: argv) { Absent => false Present { value: _ } => true })
}
