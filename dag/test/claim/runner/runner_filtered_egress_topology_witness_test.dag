module test.claim.runner.runner_filtered_egress_topology_witness_test

import std.types { Bool }
import gunbc.runner.runner_host_filtered_egress {
  filtered_egress_topology, FilteredEgressTopologySettled,
  BridgedAttemptEstablishedGuestEgress, PointToPointTapHasNotReachedGuest,
  FilteredEgressTopologyUnsettled,
}

// THE STANDING IS THE FOLD OF THE TWO RECEIPTS, read here rather than grafted onto
// KernelConfigHolds. A .config hold answers a different question. Changing egress_outcome
// or guest_reachability so this is not Settled is the discriminating RED.
test fn filtered_egress_topology_is_settled_on_the_recorded_receipts() -> Bool {
  match filtered_egress_topology {
    FilteredEgressTopologySettled => true
    BridgedAttemptEstablishedGuestEgress => false
    PointToPointTapHasNotReachedGuest => false
    FilteredEgressTopologyUnsettled => false
  }
}
