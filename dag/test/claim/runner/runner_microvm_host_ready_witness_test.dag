module test.claim.runner_microvm_host_ready_witness

import gunbc.executor_privileged_operation { EnsureSupplementaryGroupMembership, executor_privileged_operation_argv, executor_privileged_operation_sudoers_line }
import gunbc.runner_host_grants { runner_host_privileged_operations }
import gunbc.runner_host_deploy { fleet_runner_host_deploys }
import std.types { String, Bool, List }
import extdeps.exec.command { ArgvCommand }
import extdeps.virtualization.firecracker {
  firecracker_release_aarch64, firecracker_release_download_url, firecracker_release_tarball_filename,
  firecracker_release_binary_path_in_tarball, firecracker_release_aarch64_tarball_sha256, firecracker_version_line,
}
import gunbc.runner_microvm_host_ready {
  FootprintInstrumentStanding,
  KvmDeviceStanding, KvmDeviceWritable, KvmDevicePresentNotWritable, KvmDeviceAbsent,
  FirecrackerBinaryStanding, FirecrackerInstalled, FirecrackerVersionMismatch, FirecrackerBinaryAbsent,
  FirecrackerHostStanding,
  KvmGroupEnrolment, KvmGroupEnrolled, KvmGroupNotEnrolled, KvmGroupEnrolmentUnreadable,
  kvm_standing_of, binary_standing_of, firecracker_host_ready, firecracker_host_ready_in_this_process,
  group_names_contain, firecracker_host_standing_text,
  firecracker_fetch_commands, firecracker_install_commands, firecracker_installed_binary, firecracker_install_root,
}
import extdeps.systemd.systemctl { SystemdReportsMemoryPeak, SystemdTooOldForMemoryPeak, SystemdVersionUnreadable, systemd_memory_peak_support }
import gunbc.runner_microvm_footprint_probe {
  GnuTimeMaxRss, SystemdMemoryPeak, CgroupMemoryPeak,
  InstrumentStanding, InstrumentPresent, InstrumentAbsent, InstrumentUnreadable,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn the_release_artifact_is_identified_by_version_arch_and_digest() -> Bool {
  firecracker_release_tarball_filename(rel: firecracker_release_aarch64) == "firecracker-v1.16.1-aarch64.tgz"
    && firecracker_release_download_url(rel: firecracker_release_aarch64) == "https://github.com/firecracker-microvm/firecracker/releases/download/v1.16.1/firecracker-v1.16.1-aarch64.tgz"
    && firecracker_release_binary_path_in_tarball(rel: firecracker_release_aarch64) == "release-v1.16.1-aarch64/firecracker-v1.16.1-aarch64"
    && string_length(s: firecracker_release_aarch64_tarball_sha256 as String) == 64
    && firecracker_version_line(rel: firecracker_release_aarch64) == "Firecracker v1.16.1"
}

// THE FIXTURE IS SUPPLIED AT ONE INTERFACE (DESIGN section 3): every claim below discriminates over
// firecracker_host_ready / _in_this_process / the standing renderer, so the standing is constructed
// rather than produced by running the host probes those claims are not about. The inhabitance claim
// that the real producer emits this shape is the converge itself, which runs on a host and writes
// runner-microvm-host-standing.txt; no witness can execute it and none pretends to.
data witness_instruments: FootprintInstrumentStanding = FootprintInstrumentStanding {
  instruments: [
    InstrumentStanding { instrument: GnuTimeMaxRss, observation: InstrumentAbsent },
    InstrumentStanding { instrument: CgroupMemoryPeak, observation: InstrumentAbsent },
    InstrumentStanding { instrument: SystemdMemoryPeak, observation: InstrumentUnreadable { cause: "systemctl --version produced no readable line" } },
  ],
}

data witness_installed: FirecrackerBinaryStanding = FirecrackerInstalled { binary: "/x/firecracker", version_line: "Firecracker v1.16.1" }

data witness_enrolled: KvmGroupEnrolment = KvmGroupEnrolled { login: "ghrunner" as NonEmptyStr, group: "kvm" as NonEmptyStr }

data witness_not_enrolled: KvmGroupEnrolment = KvmGroupNotEnrolled { login: "ghrunner" as NonEmptyStr, group: "kvm" as NonEmptyStr }

fn witness_standing(kvm: KvmDeviceStanding, group: KvmGroupEnrolment, binary: FirecrackerBinaryStanding) -> FirecrackerHostStanding {
  FirecrackerHostStanding { kvm: kvm, kvm_group: group, binary: binary, footprint_instruments: witness_instruments }
}

// The standing folds two facts; readiness needs both, and each refusal names what it lacks.
test fn readiness_needs_a_reachable_kvm_device_and_the_modeled_version() -> Bool {
  let ready = witness_standing(kvm: KvmDeviceWritable, group: witness_enrolled, binary: witness_installed)
  let no_kvm = witness_standing(kvm: KvmDeviceAbsent, group: witness_enrolled, binary: witness_installed)
  let unwritable = witness_standing(kvm: KvmDevicePresentNotWritable, group: witness_not_enrolled, binary: witness_installed)
  let absent = witness_standing(kvm: KvmDeviceWritable, group: witness_enrolled, binary: FirecrackerBinaryAbsent { binary: "/x/firecracker" })
  firecracker_host_ready(standing: ready)
    && !firecracker_host_ready(standing: no_kvm)
    && !firecracker_host_ready(standing: unwritable)
    && !firecracker_host_ready(standing: absent)
    && string_contains(s: firecracker_host_standing_text(s: unwritable), pattern: "kvm-group=not-enrolled")
    && string_contains(s: firecracker_host_standing_text(s: ready), pattern: "standing=ready")
}

// THE CLAIM THE WHOLE GRANT WIRING RESTS ON. A supplementary group enters a process at its exec, so
// the converge that applies the grant observes present-not-writable from its own credentials. If
// readiness required THIS process to open the device, a converged host would refuse forever and the
// mode would report failure for work it had just completed correctly. Enrolment carries it; and the
// carry is not unconditional -- an ABSENT device is not made reachable by any membership.
test fn enrolment_carries_a_host_whose_converging_process_cannot_yet_open_the_device() -> Bool {
  let mid_converge = witness_standing(kvm: KvmDevicePresentNotWritable, group: witness_enrolled, binary: witness_installed)
  let ungranted = witness_standing(kvm: KvmDevicePresentNotWritable, group: witness_not_enrolled, binary: witness_installed)
  let no_device = witness_standing(kvm: KvmDeviceAbsent, group: witness_enrolled, binary: witness_installed)
  firecracker_host_ready(standing: mid_converge)
    && !firecracker_host_ready(standing: ungranted)
    && !firecracker_host_ready(standing: no_device)
    && string_contains(s: firecracker_host_standing_text(s: mid_converge), pattern: "effective for executor incarnations started AFTER this line")
}

// UNREADABLE IS NOT NOT-ENROLLED. A probe that could not answer must not carry a host to ready, and
// must not render as a missing grant either -- the two send an operator to opposite remedies.
test fn an_unreadable_membership_neither_carries_nor_reads_as_a_missing_grant() -> Bool {
  let unreadable = witness_standing(
    kvm: KvmDevicePresentNotWritable,
    group: KvmGroupEnrolmentUnreadable { login: "ghrunner" as NonEmptyStr, cause: "id -nG exited 1: no such user" },
    binary: witness_installed,
  )
  !firecracker_host_ready(standing: unreadable)
    && string_contains(s: firecracker_host_standing_text(s: unreadable), pattern: "kvm-group=unreadable")
    && !string_contains(s: firecracker_host_standing_text(s: unreadable), pattern: "kvm-group=not-enrolled")
}

// THE BOOT PROBE ASKS A DIFFERENT QUESTION AND MUST GET A DIFFERENT ANSWER. It opens /dev/kvm in
// its own process, so an enrolment it did not inherit does not help it; gating it on converge
// readiness would make it attempt a boot it cannot perform and report a VMM failure as an IMAGE
// verdict.
test fn the_in_process_predicate_refuses_exactly_where_the_converge_predicate_carries() -> Bool {
  let mid_converge = witness_standing(kvm: KvmDevicePresentNotWritable, group: witness_enrolled, binary: witness_installed)
  let picked_up = witness_standing(kvm: KvmDeviceWritable, group: witness_enrolled, binary: witness_installed)
  firecracker_host_ready(standing: mid_converge)
    && !firecracker_host_ready_in_this_process(standing: mid_converge)
    && firecracker_host_ready_in_this_process(standing: picked_up)
    && !firecracker_host_ready_in_this_process(standing: witness_standing(kvm: KvmDeviceWritable, group: witness_enrolled, binary: FirecrackerBinaryAbsent { binary: "/x/firecracker" }))
}

// THE READBACK MATCHES WHOLE NAMES. `id -nG` prints names separated by single spaces, and a
// substring test would accept "kvm-admin" -- an unrelated group -- as evidence that the executor may
// open /dev/kvm.
test fn the_group_readback_matches_a_whole_name_and_not_a_prefix() -> Bool {
  group_names_contain(output: "ghrunner docker kvm\n", group: "kvm" as NonEmptyStr)
    && group_names_contain(output: "kvm", group: "kvm" as NonEmptyStr)
    && !group_names_contain(output: "ghrunner kvm-admin libvirt\n", group: "kvm" as NonEmptyStr)
    && !group_names_contain(output: "", group: "kvm" as NonEmptyStr)
}

// RED control: a binary that answers another version is a mismatch, never installed.
test fn a_binary_answering_another_version_is_a_mismatch() -> Bool {
  (match binary_standing_of(binary: "/x/firecracker", executable: true, version_output: "Firecracker v1.16.1\n", rel: firecracker_release_aarch64) {
    FirecrackerInstalled { binary: _, version_line: v } => v == "Firecracker v1.16.1"
    _ => false
  })
    && (match binary_standing_of(binary: "/x/firecracker", executable: true, version_output: "Firecracker v1.15.0\n", rel: firecracker_release_aarch64) {
    FirecrackerVersionMismatch { binary: _, observed: o } => o == "Firecracker v1.15.0"
    _ => false
  })
    && (match binary_standing_of(binary: "/x/firecracker", executable: false, version_output: "", rel: firecracker_release_aarch64) {
    FirecrackerBinaryAbsent { binary: b } => b == "/x/firecracker"
    _ => false
  })
    && (match kvm_standing_of(exists: true, writable: false) { KvmDevicePresentNotWritable => true  _ => false })
    && (match kvm_standing_of(exists: false, writable: false) { KvmDeviceAbsent => true  _ => false })
}

// The install is a typed command list in two halves around the digest verdict: fetch (mkdir, mkdir,
// curl), then only after Sha256Matches, install (tar, cp); the digest rides no argv; the install dir
// is executor-owned.
test fn the_install_fetches_then_verifies_then_extracts_and_never_passes_the_digest_on_argv() -> Bool {
  let root = firecracker_install_root(executor_home: "/home/x")
  let fetch = firecracker_fetch_commands(root: root, rel: firecracker_release_aarch64, scratch: "/home/x/s")
  let install = firecracker_install_commands(root: root, rel: firecracker_release_aarch64, scratch: "/home/x/s")
  map(fetch, c => c.program as String) == ["/usr/bin/mkdir", "/usr/bin/mkdir", "curl"]
    && map(install, c => c.program as String) == ["tar", "cp"]
    && !any(concat(fetch, install), c => any(c.arguments, a => string_contains(s: a, pattern: firecracker_release_aarch64_tarball_sha256 as String)))
    && firecracker_installed_binary(root: root, rel: firecracker_release_aarch64) == "/home/x/.local/share/gunbc-firecracker/v1.16.1-aarch64/firecracker"
    && starts_with(s: root, prefix: "/home/x/")
}

// THE KVM GRANT IS ONE EXACT COMMAND ON EVERY RUNNER HOST. usermod is a whole-binary sudo grant, so
// what keeps it narrow is the rendered argv: append one group to one login and nothing else, and the
// sudoers line carries exactly that argv. The srv2 deploy is the host the readiness observation
// measured the missing membership on.
test fn the_kvm_grant_appends_one_group_to_the_executor_and_nothing_else() -> Bool {
  let op = EnsureSupplementaryGroupMembership { login: "gunbc-ci" as NonEmptyStr, group: "kvm" as NonEmptyStr }
  map(executor_privileged_operation_argv(op: op), w => w as String) == ["/usr/sbin/usermod", "-aG", "kvm", "gunbc-ci"]
    && (executor_privileged_operation_sudoers_line(grantee: "gunbc-ci" as NonEmptyStr, op: op) as String) == "gunbc-ci ALL=(root) NOPASSWD: /usr/sbin/usermod -aG kvm gunbc-ci"
}

// THE NAME SAYS EVERY DEPLOY AND NOW THE CHECK DOES TOO. It sampled srv2 -- one row, chosen because
// it existed -- and asserted a property its name claims of all of them. srv2 no longer HAS a deploy
// row: its width refuses, so no operational row is constructed for it. Repointing the sample at
// another host would preserve the same gap; folding over the admitted population makes the assertion
// match its name and removes the dependence on which host happens to be listed.
test fn every_runner_host_deploy_grants_the_executor_kvm_membership() -> Bool {
  all(fleet_runner_host_deploys, d =>
    length(filter(runner_host_privileged_operations(deploy: d), op =>
      match op {
        EnsureSupplementaryGroupMembership { login: l, group: g } => (l as String) == (d.job_user as String) && (g as String) == "kvm"
        _ => false
      })) == 1)
}

// READINESS MUST NOT MOVE WITH THE INSTRUMENTS. A host that can boot a guest but carries no way to
// measure the VMM's footprint is still ready to SERVE -- the instruments decide whether the reserve
// can be retired, which is a different question. Wiring them into firecracker_host_ready would have
// made every host not-ready the moment this field landed, taking the fleet down to answer a
// measurement question.
test fn host_readiness_is_independent_of_the_footprint_instruments() -> Bool {
  let bare = FootprintInstrumentStanding {
    instruments: [
      InstrumentStanding { instrument: GnuTimeMaxRss, observation: InstrumentAbsent },
      InstrumentStanding { instrument: CgroupMemoryPeak, observation: InstrumentAbsent },
      InstrumentStanding { instrument: SystemdMemoryPeak, observation: InstrumentUnreadable { cause: "systemctl --version produced no readable line" } },
    ],
  }
  let equipped = FootprintInstrumentStanding {
    instruments: [
      InstrumentStanding { instrument: GnuTimeMaxRss, observation: InstrumentPresent },
      InstrumentStanding { instrument: CgroupMemoryPeak, observation: InstrumentPresent },
      InstrumentStanding { instrument: SystemdMemoryPeak, observation: InstrumentPresent },
    ],
  }
  let installed = FirecrackerInstalled { binary: "/x/firecracker", version_line: "Firecracker v1.16.1" }
  firecracker_host_ready(standing: FirecrackerHostStanding { kvm: KvmDeviceWritable, kvm_group: witness_enrolled, binary: installed, footprint_instruments: bare })
    && firecracker_host_ready(standing: FirecrackerHostStanding { kvm: KvmDeviceWritable, kvm_group: witness_enrolled, binary: installed, footprint_instruments: equipped })
    && !firecracker_host_ready(standing: FirecrackerHostStanding { kvm: KvmDeviceAbsent, kvm_group: witness_enrolled, binary: installed, footprint_instruments: equipped })
}

// THE VERSION GATE, WHICH NOTHING EXERCISED UNTIL NOW AND WHICH WAS WRONG THE WHOLE TIME. Before
// this control the standing reported SystemdMemoryPeak as `present` for ANY non-empty version line,
// so a host on v249 -- which cannot report MemoryPeak at all -- rendered `systemd-memory-peak=present`
// on the receipt a human reads to decide what can measure the reserve. That is a fabricated answer
// in the STRONGER direction, which is worse than the absorbing one: it does not merely lose
// information, it asserts a capability the host does not have.
//
// Three inputs because the outcome is three-valued, and the middle one is what the boolean shape
// could not express: below the threshold is a statement ABOUT THE HOST, unreadable is a statement
// about our OBSERVATION, and they must not render alike.
test fn the_systemd_instrument_reads_the_version_rather_than_its_presence() -> Bool {
  match systemd_memory_peak_support(version_line: "systemd 255 (255.4-1ubuntu8)") {
    SystemdReportsMemoryPeak { version: v } => v == 255
    SystemdTooOldForMemoryPeak { version: _ } => false
    SystemdVersionUnreadable => false
  }
    && match systemd_memory_peak_support(version_line: "systemd 249 (249.11-0ubuntu3)") {
      SystemdTooOldForMemoryPeak { version: v } => v == 249
      SystemdReportsMemoryPeak { version: _ } => false
      SystemdVersionUnreadable => false
    }
    && match systemd_memory_peak_support(version_line: "") {
      SystemdVersionUnreadable => true
      SystemdReportsMemoryPeak { version: _ } => false
      SystemdTooOldForMemoryPeak { version: _ } => false
    }
}

// THE BOUNDARY ITSELF, because 254 is the cited upstream fact and an off-by-one here reports the
// exact version that gained MemoryPeak as unable to report it.
test fn the_memory_peak_threshold_admits_254_and_refuses_253() -> Bool {
  match systemd_memory_peak_support(version_line: "systemd 254 (254.1-1)") {
    SystemdReportsMemoryPeak { version: _ } => true
    SystemdTooOldForMemoryPeak { version: _ } => false
    SystemdVersionUnreadable => false
  }
    && match systemd_memory_peak_support(version_line: "systemd 253 (253.5-1)") {
      SystemdTooOldForMemoryPeak { version: _ } => true
      SystemdReportsMemoryPeak { version: _ } => false
      SystemdVersionUnreadable => false
    }
}

// THE RECEIPT MUST SAY WHICH INSTRUMENTS EXIST, because the whole point of the observation is that a
// human reads it and decides what can measure the reserve. A standing that carried the field but
// never rendered it would be an observation nobody receives.
test fn the_standing_text_reports_the_instruments() -> Bool {
  let equipped = FirecrackerHostStanding {
    kvm: KvmDeviceWritable,
    kvm_group: witness_enrolled,
    binary: FirecrackerInstalled { binary: "/x/firecracker", version_line: "Firecracker v1.16.1" },
    footprint_instruments: FootprintInstrumentStanding {
      instruments: [
        InstrumentStanding { instrument: GnuTimeMaxRss, observation: InstrumentPresent },
        InstrumentStanding { instrument: CgroupMemoryPeak, observation: InstrumentAbsent },
        InstrumentStanding { instrument: SystemdMemoryPeak, observation: InstrumentUnreadable { cause: "not read in this fixture" } },
      ],
    },
  }
  let text = firecracker_host_standing_text(s: equipped)
  string_contains(s: text, pattern: "gnu-time-max-rss=present")
    && string_contains(s: text, pattern: "cgroup-memory-peak=absent")
    && string_contains(s: text, pattern: "systemd-memory-peak=unreadable(")
}
