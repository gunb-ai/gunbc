module test.claim.runner.runner_host_left_state_witness

import std.types { Bool, List, NonEmptyStr }
import gunbc.runner.runner_slot_actuation { SlotActuationOutcome, SlotActivated, SlotActuationRefused, SlotActuationSkippedThermal, SlotDrainedAndMasked }
import gunbc.runner.runner_host_left_state { HostAdmitting, HostAdmittingWithHeld, HostLeftDrained, HostLeftState, host_left_of_readmit, host_left_wire }
import std.algebra { string_contains }

fn u(n: NonEmptyStr) -> NonEmptyStr { n }
fn units() -> List<NonEmptyStr> { [u(n: "01"), u(n: "02"), u(n: "03")] }
fn held(n: NonEmptyStr) -> SlotActuationOutcome { SlotActuationSkippedThermal { unit: n } }
fn ok(n: NonEmptyStr) -> SlotActuationOutcome { SlotActivated { unit: n } }

// every admitted slot settled, one cooling-held: admitting-with-held, naming exactly the held slot, NOT drained
test fn settled_admitted_slots_with_a_held_slot_are_admitting_with_held() -> Bool {
  match host_left_of_readmit(units: units(), outcomes: [ok(n: "01"), ok(n: "02"), held(n: "03")]) {
    HostAdmittingWithHeld { held: hs } => length(hs) == 1
    HostAdmitting => false
    HostLeftDrained { units: _ } => false
  }
}

// RED: a refused admitted unit beside a held one is DRAINED and names only the refused unit
test fn a_refused_unit_beside_a_held_one_is_drained_naming_only_the_refused() -> Bool {
  match host_left_of_readmit(units: units(), outcomes: [ok(n: "01"), SlotActuationRefused { unit: u(n: "02"), step: "start", reason: "x" }, held(n: "03")]) {
    HostLeftDrained { units: us } => length(us) == 1
    HostAdmitting => false
    HostAdmittingWithHeld { held: _ } => false
  }
}

// RED: a missing reading (3 units, 2 outcomes incl. a held one) is not admitting even with a held slot
test fn a_missing_reading_beside_a_held_one_is_drained() -> Bool {
  match host_left_of_readmit(units: units(), outcomes: [ok(n: "01"), held(n: "03")]) {
    HostLeftDrained { units: _ } => true
    HostAdmitting => false
    HostAdmittingWithHeld { held: _ } => false
  }
}

// ALL held, none admitted: nothing serves, so DRAINED naming the held units (not a bracket success)
test fn all_units_held_with_none_admitted_is_drained_naming_the_held() -> Bool {
  match host_left_of_readmit(units: units(), outcomes: [held(n: "01"), held(n: "02"), held(n: "03")]) {
    HostLeftDrained { units: us } => length(us) == 3
    HostAdmitting => false
    HostAdmittingWithHeld { held: _ } => false
  }
}

// no held slot: unchanged, admitting
test fn no_held_slot_is_plain_admitting() -> Bool {
  match host_left_of_readmit(units: units(), outcomes: [ok(n: "01"), ok(n: "02"), SlotDrainedAndMasked { unit: u(n: "03") }]) {
    HostAdmitting => true
    HostAdmittingWithHeld { held: _ } => false
    HostLeftDrained { units: _ } => false
  }
}

// the wire never says DRAINED for held slots, and says they are not converged
test fn the_held_wire_does_not_claim_a_drain_and_says_not_converged() -> Bool {
  let w = host_left_wire(l: host_left_of_readmit(units: units(), outcomes: [ok(n: "01"), ok(n: "02"), held(n: "03")]))
  !string_contains(w, "DRAINED") && string_contains(w, "NOT converged") && string_contains(w, "03")
}
