// THE DISCRIMINATING RED FOR THE DEFECT THIS LANE WAS DISPATCHED FOR. The emitted apply.sh carried
// daemon-reload and disable and nothing else -- enable count 0, start count 0 -- so convergence
// materialized runner trees while the host's serving capacity did not move, and three separate
// widenings on 2026-08-25 were finished by a hand-run `systemctl enable --now` loop that lives in
// no authority.
//
// WHAT EACH POLE ASSERTS, because a single-poled set would not be evidence. The ADMITTED pole
// authors a readiness receipt in the fixture and asserts that the emitted script carries a separate
// enable and a separate start for every desired unit -- it goes RED the moment the emitter stops
// emitting activation, which is the exact regression the defect was. The REFUSED pole supplies the
// unobserved readiness every production caller supplies and asserts a typed, counted, located
// refusal that does NOT abort the script -- it goes RED if the refusal ever becomes silence, which
// is the state the emitter was in before this lane, or if it becomes an exit, which would withdraw
// materialization that is independently authorized.
//
// THE FUSION CONTROL IS THE THIRD POLE AND IT IS NOT REDUNDANT WITH EITHER. Asserting that enable
// and start both appear does not establish that they are two transitions: `enable --now` would
// satisfy a reader looking for the word enable and would still be the fusion. So the set separately
// asserts that no emitted line carries systemctl's --now, and pairs that with the surviving fused
// builder as a positive control -- runner_enable_command_argv DOES render it -- so the absence is a
// measurement rather than a property of the pattern never matching anything.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE READINESS FIXTURE, AUTHORED HERE RATHER THAN SHARED. test.claim.runner.runner_activation_wall carries
// the same shape and the full reasoning for the pool-declared instance; the duplication is deliberate
// for the reason that module's own note gives, and gunbc.runner.runner_service_activation's stall row gives
// the other half: on the live tree gunbc_compile_pool_placement is CompilePoolInRunnerSlots, so a
// fixture reading the production instance would assert this fleet's topology instead of this
// module's subject, and every admitted-pole witness below would red for a reason that has nothing to
// do with emission.
fn witness_pool_declared_instance(host: HostIdentity) -> BuildCacheInstance {
  let base = ci_cache_instance(host: host)
  BuildCacheInstance {
    identity: base.identity,
    implementation: base.implementation,
    endpoint: base.endpoint,
    intended_unit: base.intended_unit,
    intended_principal: base.intended_principal,
    intended_storage: base.intended_storage,
    intended_capacity: base.intended_capacity,
    intended_compile_pool: CompilePoolSliceDeclared {
      slice_unit: gunbc_managed_compile_pool_slice as String,
    },
  }
}

fn witness_ready_readiness(deploy: RunnerHostDeploy) -> RunnerActivationReadiness {
  let host = deploy.host_label as HostIdentity
  let instance = witness_pool_declared_instance(host: host)
  ActivationReadinessObserved {
    cache_ready: BuildCacheInstanceReady {
      instance: instance,
      owner: ProcessIdentity {
        boot_id: "fixture-boot" as NonEmptyStr,
        pid: 4242,
        start_time: "80000000" as NonEmptyStr,
      },
      managed_unit: instance.intended_unit,
    },
    pool_ready: HostCompilePoolReady {
      host: host,
      slice_unit: gunbc_managed_compile_pool_slice,
      pool_declared: true,
      pool_observed: true,
    },
  }
}

fn witness_plans(deploy: RunnerHostDeploy, readiness: RunnerActivationReadiness) -> List<RunnerTransitionPlan> {
  runner_activation_plans_for_deploy(
    host_admission: admit_runner_host(deploy: deploy),
    deploy: deploy,
    readiness: readiness,
    standings: runner_unit_standings_unobserved_no_transaction,
  )
}

fn witness_plans_with_standings(
  deploy: RunnerHostDeploy,
  readiness: RunnerActivationReadiness,
  standings: RunnerUnitStandings,
) -> List<RunnerTransitionPlan> {
  runner_activation_plans_for_deploy(
    host_admission: admit_runner_host(deploy: deploy),
    deploy: deploy,
    readiness: readiness,
    standings: standings,
  )
}

fn witness_standings(deploy: RunnerHostDeploy, active: Bool, enabled: Bool) -> RunnerUnitStandings {
  UnitStandingsObserved {
    units: map(
      desired_runner_slot_members(deploy: deploy),
      m => RunnerUnitStanding {
        unit: runner_unit_name_of_registration(registration_name: m.instance_name),
        active: active,
        enabled: enabled,
      },
    ),
  }
}

fn witness_request(deploy: RunnerHostDeploy, readiness: RunnerActivationReadiness) -> FleetConvergeRequest {
  FullHostConverge {
    host: deploy.host_label,
    observed_timers: [],
    observed_caps: [],
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: deploy.host_label as HostIdentity),
    observed_activation_readiness: readiness,
    observed_unit_standings: runner_unit_standings_unobserved_no_transaction,
    observed_retirement: SlotRetirementEvidenceAbsent { cause: "this fixture binds no retirement observation" },
    observed_host_grants: witness_grants_rendered(host: deploy.host_label),
  }
}

fn witness_apply_text(deploy: RunnerHostDeploy, readiness: RunnerActivationReadiness) -> String {
  fleet_converge_apply_shell(
    request: witness_request(deploy: deploy, readiness: readiness),
    terminal: witness_terminal(deploy: deploy, readiness: readiness),
  )
}

fn witness_terminal(deploy: RunnerHostDeploy, readiness: RunnerActivationReadiness) -> FleetConvergeApplyTerminal {
  fleet_converge_apply_terminal(request: witness_request(deploy: deploy, readiness: readiness))
}

fn witness_systemctl_word() -> String {
  posix_single_quote(spelling: ci_runner_sudo_binary_path(b: SudoSystemctl) as String)
}

fn witness_transition_word(verb: NonEmptyStr) -> String {
  posix_single_quote(spelling: verb as String)
}

// THE VERB PATTERN IS BUILT FROM THE SAME AUTHORITIES THE EMITTER USES, never spelled here. A literal
// "'systemctl' 'enable'" in this file would be a third authoring of two facts extdeps.systemd.systemctl
// and gunbc.fleet.fleet_posix_accounts already own, and it would rot exactly the way the sibling witness in
// test.claim.runner.runner_host_deploy_witness did when the builder started routing through an authority: the
// assertion would go red for a spelling change with no behaviour behind it.
fn witness_transition_pattern(verb: NonEmptyStr, unit: NonEmptyStr) -> String {
  concat(
    concat(witness_systemctl_word(), concat(" ", witness_transition_word(verb: verb))),
    concat(" ", posix_single_quote(spelling: unit as String)),
  )
}

fn witness_all_units_present(text: String, units: List<NonEmptyStr>, verb: NonEmptyStr) -> Bool {
  fold(
    units,
    init: true,
    f: (acc, u) => acc && string_contains(s: text, pattern: witness_transition_pattern(verb: verb, unit: u)),
  )
}

// THE EMITTED SCRIPT CARRIES ACTIVATION, AND THIS IS THE ROW THAT REDS IF IT STOPS. It asserts the
// per-unit enable AND the per-unit start over the WHOLE desired roster rather than one exemplar
// each, so a partial emission -- the first slot only, or the enable half only -- fails here rather
// than passing on a sample.
test fn emitted_apply_carries_enable_and_start_for_every_desired_unit() -> Bool {
  let d = wt_srv4_deploy()
  let units = runner_host_activation_units(deploy: d)
  let text = witness_apply_text(deploy: d, readiness: witness_ready_readiness(deploy: d))
  length(xs: units) == length(xs: desired_runner_slot_members(deploy: d))
    && length(xs: units) > 0
    && witness_all_units_present(text: text, units: units, verb: systemctl_enable_verb)
    && witness_all_units_present(text: text, units: units, verb: systemctl_start_verb)
}

// THE FUSION CONTROL, WITH ITS POSITIVE POLE BESIDE IT. The first conjunct is the property: no
// emitted activation line carries systemctl's --now. On its own that would be a pattern that might
// simply never match anything, so the second conjunct executes the surviving fused builder and
// asserts the pattern DOES match there -- the same words, one authoring away, rendered by the
// readiness-blind path this lane exists to stop being the only one.
//
// THE PROHIBITION IS ON ENABLE FUSED WITH --now, NOT ON THE FLAG. This row refused any `--now` in the
// apply text, which is broader than its subject (gunbc.design_argument::epistemic_humility, over-prohibition): #11204 (1d5c804fe6)
// added retirement inhibition, `systemctl mask --now` on an authorized surplus unit, and the runner
// family header names it, so the row went red on text that contains no activation at all. Masking
// a unit that must stop serving is exactly the case where stopping it now is the point. The pattern
// is the enable verb followed by --now, in both renderings the apply text uses, and the positive pole
// asserts the same pattern DOES match the fused builder, so it is not a pattern that matches nothing.
fn enable_now_quoted() -> String {
  join(["'", systemctl_enable_verb as String, "' '--now'"], "")
}

fn enable_now_bare() -> String {
  join([systemctl_enable_verb as String, " --now"], "")
}

test fn emitted_activation_is_never_the_fused_enable_now() -> Bool {
  let d = wt_srv4_deploy()
  let text = witness_apply_text(deploy: d, readiness: witness_ready_readiness(deploy: d))
  let fused = shell_command_render(command: runner_enable_command_argv(deploy: d))
  !string_contains(s: text, pattern: enable_now_quoted())
    && !string_contains(s: text, pattern: enable_now_bare())
    && string_contains(s: fused, pattern: enable_now_quoted())
}

// ENABLE PRECEDES START IN THE EMITTED ORDER. A unit started before it is enabled serves until the
// next boot and then silently stops being capacity, which is the failure this whole lane is about
// wearing a shorter timescale. The sequence is read off the transitions the plans name rather than
// off the shape of the list, so a plan list that grew a third member fails here rather than being
// destructured past.
test fn emitted_activation_enables_before_it_starts() -> Bool {
  let d = wt_srv4_deploy()
  let plans = witness_plans(deploy: d, readiness: witness_ready_readiness(deploy: d))
  runner_transition_sequence_label(plans: plans) == "enable,start"
    && runner_activation_refusal_count(plans: plans) == 0
    && runner_activation_admitted_operation_count(plans: plans)
         == length(xs: runner_host_activation_units(deploy: d)) * 2
}

// THE REFUSED POLE. It supplies the readiness every production caller supplies today, and asserts
// three things that are three different failures: the refusal is COUNTED (both transitions, so 2 --
// zero would mean the axis reported nothing), it is LOCATED and typed in the emitted text, and it
// does NOT abort. The no-exit conjunct is load-bearing: materialization runs under its own
// authorization, and withdrawing it because an unrelated axis was refused would trade a silent
// no-op for a loud one.
test fn unobserved_readiness_refuses_loudly_without_aborting_apply() -> Bool {
  let d = wt_srv4_deploy()
  let readiness = runner_activation_readiness_unobserved_no_transaction
  let plans = witness_plans(deploy: d, readiness: readiness)
  let text = witness_apply_text(deploy: d, readiness: readiness)
  runner_activation_refusal_count(plans: plans) == 2
    && runner_activation_admitted_operation_count(plans: plans) == 0
    && string_contains(s: text, pattern: "REFUSED-ACTIVATION host=srv4")
    && string_contains(s: text, pattern: "no host observation transaction exists yet")
    && !string_contains(s: text, pattern: witness_transition_pattern(verb: systemctl_enable_verb, unit: "actions-runner@srv4-01.service" as NonEmptyStr))
    && !witness_activation_lines_contain(plans: plans, pattern: "exit ")
    && !witness_activation_lines_contain(plans: plans, pattern: witness_systemctl_word())
}

// THE NO-EXIT CONJUNCT IS ASKED OF THE ACTIVATION LINES, NOT OF THE WHOLE SCRIPT, and the difference
// is the denominator error this repository keeps recording. The slot family emits its own `exit 1`
// for an unmodeled host and the extract scripts carry their own error handling, so a whole-script
// search for an exit would answer a question about somebody else's lines -- passing or failing for
// reasons that have nothing to do with whether an activation refusal aborts.
//
// THE NO-COMMAND CONJUNCT ASKS FOR THE QUOTED BINARY PATH, NOT FOR THE WORD "systemctl", AND THE
// FIRST DRAFT ASKED FOR THE WORD AND WENT RED. It was the assertion that was wrong rather than the
// emitter: a refusal has to NAME the command it is withholding to be a useful diagnostic, so
// `systemctl enable is not admitted on this host` is exactly what the line should say, and a witness
// forbidding that word was demanding a worse message. What must be absent is a RUNNABLE command,
// and the discriminator for that is the quoted absolute path the shell renderer emits -- which
// appears only when an operation was actually rendered, never when one was described.
fn witness_activation_lines_contain(plans: List<RunnerTransitionPlan>, pattern: String) -> Bool {
  fold(
    plans,
    init: false,
    f: (acc, p) =>
      acc || fold(
        runner_transition_apply_lines(plan: p),
        init: false,
        f: (a2, l) => a2 || string_contains(s: l, pattern: pattern),
      ),
  )
}

// THE TWO REFUSALS SAY DIFFERENT THINGS, which is what makes "separately admitted" a fact rather
// than a shape. One shared sentence over both transitions would have been the collapse that reads as
// one operation reported twice.
test fn the_two_refusals_name_their_own_stakes() -> Bool {
  let plans = witness_plans(deploy: wt_srv4_deploy(), readiness: runner_activation_readiness_unobserved_no_transaction)
  fold(
    plans,
    init: 0,
    f: (acc, p) =>
      match p {
        TransitionRefused { transition: _, host_label: _, reason: r, affected_units: _ } =>
          if string_contains(s: r as String, pattern: "durable boot intent") { acc + 1 } else { acc }
        TransitionAdmitted { transition: _, operations: _ } => acc
        TransitionConverged { transition: _, units: _ } => acc
      },
  ) == 1
}

// THE GRANT AND THE COMMAND ARE ONE FACT, ASSERTED IN THE DIRECTION THAT CAN BREAK. The sudoers match
// derived from each operation is the argv joined by spaces, so this checks that the grant a host
// installs authorizes exactly the words the emitted script runs -- and, separately, that NEITHER
// grant authorizes the fused form, which is what makes the separation enforced by sudo rather than
// by an author remembering.
test fn each_transition_grant_authorizes_its_own_command_and_not_the_fusion() -> Bool {
  let unit = "actions-runner@srv4-01.service" as NonEmptyStr
  let en = executor_privileged_operation_sudoers_command(op: SystemdEnableUnit { unit: unit })
  let st = executor_privileged_operation_sudoers_command(op: SystemdStartUnit { unit: unit })
  string_contains(s: en as String, pattern: concat(concat(" ", systemctl_enable_verb as String), concat(" ", unit as String)))
    && string_contains(s: st as String, pattern: concat(concat(" ", systemctl_start_verb as String), concat(" ", unit as String)))
    && !string_contains(s: en as String, pattern: "--now")
    && !string_contains(s: st as String, pattern: "--now")
    && (en as String) != (st as String)
}

// THE HOST'S GRANT POPULATION GAINS EXACTLY ONE TRIPLE PER DESIRED SLOT, DERIVED ON BOTH SIDES. The
// count is compared against the roster's own length rather than against a number, because a literal
// here would be a measurement of the current tree standing in for an oracle -- and this roster moved
// from 5 to 21 within the month.
//
// THE HOST'S START POPULATION ALSO CARRIES ONE SLICE START PER FABRIC CELL ON THE HOST, and that is
// gunbc.runner.runner_host_grants fabric_cell_slice_property_operations, not an activation grant: it
// re-applies a cgroup boundary's directives and enables nothing. This row compared the host's
// starts to the desired slots alone, which held only while srv4 carried no fabric slot; #11625 gave
// it two, so the row was red from that landing. The enable count, which the slices do not touch,
// still equals the desired slots exactly -- that is the conjunct that pins activation.
test fn grants_carry_one_unmask_enable_and_start_per_desired_slot() -> Bool {
  let d = wt_srv4_deploy()
  let desired = length(xs: desired_runner_slot_members(deploy: d))
  let slices = length(xs: fabric_cell_host_slots(spec: runner_host_spec_of(deploy: d)))
  let acts = runner_slot_activation_operations(members: desired_runner_slot_members(deploy: d))
  let all_ops = runner_host_privileged_operations(deploy: d)
  length(xs: acts) == desired * 3
    && fold(all_ops, init: 0, f: (acc, op) => match op { SystemdEnableUnit { unit: _ } => acc + 1  _ => acc }) == desired
    && fold(all_ops, init: 0, f: (acc, op) => match op { SystemdStartUnit { unit: _ } => acc + 1  _ => acc }) == desired + slices
}

// THE FABRIC CELL TAKES NO ACTIVATION GRANT, and this is asserted from the two hosts that differ
// rather than from a name. srv3 reserves srv3-06 for compute fabric, so its desired roster is one
// shorter than srv4's committed width and it derives one fewer transition pair. A witness naming
// srv3-06 would assert the carve's current position; this one asserts the RELATION, which is what
// would break if the activation roster ever reached past desired_runner_slot_members.
test fn the_reserved_fabric_cell_takes_no_activation_grant() -> Bool {
  let srv3_units = runner_host_activation_units(deploy: wt_srv3_deploy())
  let srv3_desired = desired_runner_slot_members(deploy: wt_srv3_deploy())
  length(xs: srv3_units) == length(xs: srv3_desired)
    && length(xs: srv3_units) < wt_srv3_deploy().runner_count
    && !fold(
         srv3_units,
         init: false,
         f: (acc, u) => acc || string_contains(s: u as String, pattern: "srv3-06"),
       )
}

// THE DECLARED STALL AND THE EXECUTED REFUSAL MUST NAME THE SAME BLOCKER, which is what keeps the
// row from being prose with a type. A GuaranteeStall nobody reads goes stale in a specific and
// silent way: the row keeps naming one cause while the refusal printed beside it in the same
// plan.txt names another, and no mechanism compares them. This row is that comparison.
//
// IT ASSERTS THE ORDER, NOT ONLY THE MEMBERSHIP. The reachability row has to name the observation
// transaction as the IMMEDIATE blocker and the pool placement as the one behind it -- an earlier
// revision named only the placement, which is the second gate, and a reader planning from it would
// do the fleet-wide topology work and measure no change. So the assertion is that the executed
// refusal's cause is the one the row leads with.
test fn the_declared_stall_agrees_with_the_executed_refusal() -> Bool {
  let plans = witness_plans(deploy: wt_srv4_deploy(), readiness: runner_activation_readiness_unobserved_no_transaction)
  let cause = fold(
    plans,
    init: "",
    f: (acc, p) =>
      match p {
        TransitionRefused { transition: _, host_label: _, reason: r, affected_units: _ } => r as String
        TransitionAdmitted { transition: _, operations: _ } => acc
        TransitionConverged { transition: _, units: _ } => acc
      },
  )
  match runner_activation_reachability_stall.blocker {
    AwaitsOneGrounding { grounding: _ } =>
      string_contains(s: runner_activation_reachability_stall.next_rung_trigger.capability, pattern: "host observation transaction")
        && string_contains(s: cause, pattern: "no host observation transaction exists")
        && !string_contains(s: cause, pattern: "CompilePoolInRunnerSlots")
    ClimbableButUnbuilt => false
  }
    && stall_is_below_ceiling(s: runner_activation_reachability_stall)
    && match runner_activation_reachability_stall.blocker {
      AwaitsOneGrounding { grounding: _ } => true
      ClimbableButUnbuilt => true
    }
}

// THE SAFETY ROW STATES A MITIGATABLE RUNG, AND THIS IS THE ROW THAT REDS IF SOMEBODY INFLATES IT.
// The host boundary is not structural: gunbc.runner.runner_host_grants installs the raw systemctl verbs for
// the job user, so the grantee can run enable and start directly, outside the admission entirely.
// Claiming StructurallyGuaranteed here would be the gunbc.design_argument::guarantee_ladder (rung honesty) inflation in the module whose job
// is to stop an unadmitted activation, so the rung is asserted rather than left to a reader's
// charity -- and asserted as an EQUALITY on the current rung, not merely as below-ceiling, because
// below-ceiling would still pass at MechanicallyPreventable.
test fn the_safety_row_does_not_claim_the_host_boundary_is_structural() -> Bool {
  match runner_activation_safety_stall.current {
    Mitigatable => true
    OutsideTheLadder => false
    _ => false
  }
    && stall_is_below_ceiling(s: runner_activation_safety_stall)
    && match runner_activation_safety_stall.blocker {
      AwaitsOneGrounding { grounding: _ } => true
      ClimbableButUnbuilt => true
    }
    && string_contains(s: runner_activation_safety_stall.next_rung_trigger.capability, pattern: "root-owned")
}

// THE REFUSAL CARRIES ITS AFFECTED POPULATION, IN BOTH MAGNITUDE AND IDENTITY. A count alone cannot
// distinguish two refusals over different rosters at equal size, and this fleet has hosts that
// differ by exactly one unit -- so the set identity is asserted to DIFFER between srv3 and srv4
// while both remain present, which a count-only rendering could not establish.
test fn the_refusal_names_how_many_units_and_which_set() -> Bool {
  let srv4_units = runner_host_activation_units(deploy: wt_srv4_deploy())
  let srv3_units = runner_host_activation_units(deploy: wt_srv3_deploy())
  let text = witness_apply_text(deploy: wt_srv4_deploy(), readiness: runner_activation_readiness_unobserved_no_transaction)
  string_contains(s: text, pattern: concat("units=", to_string(length(xs: srv4_units))))
    && string_contains(s: text, pattern: concat("unit_set=", runner_transition_affected_set_identity(units: srv4_units)))
    && runner_transition_affected_set_identity(units: srv3_units)
         != runner_transition_affected_set_identity(units: srv4_units)
}

// A REFUSED AXIS MAKES THE TERMINAL PartiallyApplied, AND AN APPLY THAT REFUSED NOTHING SAYS SO.
// Before this, the terminal a consumer read was the shell's exit status, and a script that refused
// an axis and continued exits zero -- so "converged" and "converged except for the axis nobody could
// admit" were the same terminal. Both poles are asserted because the projection is only evidence if
// it can say either.
test fn a_refused_activation_makes_the_terminal_partially_applied() -> Bool {
  let d = wt_srv4_deploy()
  let refused_line = fleet_converge_apply_terminal_line(
    terminal: witness_terminal(deploy: d, readiness: runner_activation_readiness_unobserved_no_transaction),
  )
  let admitted_line = fleet_converge_apply_terminal_line(
    terminal: witness_terminal(deploy: d, readiness: witness_ready_readiness(deploy: d)),
  )
  string_contains(s: refused_line, pattern: "PartiallyApplied")
    && string_contains(s: refused_line, pattern: "activation=2")
    && !string_contains(s: admitted_line, pattern: "activation=2")
}

// THE REFUSAL SURVIVES AN APOSTROPHE IN ITS CAUSE, and this row exists because the first version did
// not. runner_transition_apply_lines hand-wrapped the reason in single quotes, and every real
// RunnerActivationRefused cause from admit_runner_activation's host-mismatch arm contains
// single-quoted host names -- so the first observed readiness would have emitted malformed shell.
// It was dormant only because the one reason production can currently reach contains no apostrophe,
// which is what made it invisible to every other row in this file.
//
// THE FIXTURE PLANTS THE APOSTROPHE RATHER THAN WAITING FOR ONE. A witness that asserted only over
// the reachable cause would be green for the same reason the defect was invisible.
test fn a_refusal_cause_containing_an_apostrophe_stays_well_formed() -> Bool {
  let plan = TransitionRefused {
    transition: RunnerEnableTransition,
    host_label: "srv4" as NonEmptyStr,
    reason: "names host 'srv3' but activation was requested for 'srv4'" as NonEmptyStr,
    affected_units: ["actions-runner@srv4-01.service" as NonEmptyStr],
  }
  fold(
    runner_transition_apply_lines(plan: plan),
    init: false,
    f: (acc, l) => acc || string_contains(s: l, pattern: "'\\''"),
  )
}


// A HOST WHOSE UNITS ARE ALREADY ENABLED AND RUNNING PLANS NO TRANSITION AND NO REFUSAL. Readiness
// is still unobserved here, exactly as production supplies it; what changed is that the planner
// asked the host first. Before this, srv2's five running units planned two refusals.
test fn observed_converged_units_plan_no_refusal_under_unobserved_readiness() -> Bool {
  let deploy = wt_srv3_deploy()
  let plans = witness_plans_with_standings(
    deploy: deploy,
    readiness: runner_activation_readiness_unobserved_no_transaction,
    standings: witness_standings(deploy: deploy, active: true, enabled: true),
  )
  runner_activation_refusal_count(plans: plans) == 0
    && (plans |> all(p => match p {
      TransitionConverged { transition: _, units: us } => length(xs: us) == length(xs: desired_runner_slot_members(deploy: deploy))
      TransitionAdmitted { transition: _, operations: _ } => false
      TransitionRefused { transition: _, host_label: _, reason: _, affected_units: _ } => false
    }))
}

// ENABLED BUT NOT RUNNING: enable is converged, start still needs the readiness admission and is
// refused over exactly the units that need it. The refusal population is the discriminator -- a
// planner that ignored standings would refuse enable as well.
test fn observed_enabled_inactive_units_refuse_only_the_start_transition() -> Bool {
  let deploy = wt_srv3_deploy()
  let plans = witness_plans_with_standings(
    deploy: deploy,
    readiness: runner_activation_readiness_unobserved_no_transaction,
    standings: witness_standings(deploy: deploy, active: false, enabled: true),
  )
  runner_activation_refusal_count(plans: plans) == 1
    && (plans |> any(p => match p {
      TransitionConverged { transition: RunnerEnableTransition, units: _ } => true
      TransitionConverged { transition: RunnerStartTransition, units: _ } => false
      TransitionAdmitted { transition: _, operations: _ } => false
      TransitionRefused { transition: _, host_label: _, reason: _, affected_units: _ } => false
    }))
    && (plans |> any(p => match p {
      TransitionRefused { transition: RunnerStartTransition, host_label: _, reason: _, affected_units: us } =>
        length(xs: us) == length(xs: desired_runner_slot_members(deploy: deploy))
      TransitionRefused { transition: RunnerEnableTransition, host_label: _, reason: _, affected_units: _ } => false
      TransitionAdmitted { transition: _, operations: _ } => false
      TransitionConverged { transition: _, units: _ } => false
    }))
}

// UNOBSERVED STANDINGS KEEP THE OLD SHAPE: both transitions refused over every desired unit. This
// is the control that pins the degradation direction as fail-closed.
test fn unobserved_standings_refuse_both_transitions_over_every_unit() -> Bool {
  let deploy = wt_srv3_deploy()
  let plans = witness_plans(deploy: deploy, readiness: runner_activation_readiness_unobserved_no_transaction)
  runner_activation_refusal_count(plans: plans) == 2
    && (plans |> all(p => match p {
      TransitionRefused { transition: _, host_label: _, reason: _, affected_units: us } =>
        length(xs: us) == length(xs: desired_runner_slot_members(deploy: deploy))
      TransitionAdmitted { transition: _, operations: _ } => false
      TransitionConverged { transition: _, units: _ } => false
    }))
}

// THE ADMITTED ROW, ASKED FOR RATHER THAN READ. srv2 has no deploy row at all now -- its width
// refuses -- so these rows come from the admission and a test that somehow lost its host fails on the
// fixture rather than on a fabricated production value.
fn wt_missing_deploy() -> RunnerHostDeploy {
  RunnerHostDeploy {
    host_label: "wt-unadmitted",
    ssh_target: "unadmitted@invalid.example",
    runner_user: "unadmitted",
    unit_user: "unadmitted",
    job_user: "unadmitted",
    app: gunbc_ci_github_app,
    runner_count: 1,
  }
}

fn wt_srv3_deploy() -> RunnerHostDeploy {
  match admitted_deploy_for(host: operator_host_srv3) {
    Present { value: d } => d
    Absent => wt_missing_deploy()
  }
}

fn wt_srv4_deploy() -> RunnerHostDeploy {
  match admitted_deploy_for(host: operator_host_srv4) {
    Present { value: d } => d
    Absent => wt_missing_deploy()
  }
}

// ── THE ACTIVATION PLAN'S STEPS AND THE RENDERED GRANTS: THE JOIN ────────────────────────────────
//
// WHY THIS SECTION EXISTS. The rows above already hold the transition model and the grant population
// together. They could not hold THIS one, because until this change the two sides had two authors: a
// hand-list in gunbc.runner.runner_host_grants named `enable` and `start`, while the plan of
// gunbc.runner.runner_slot_actuation answered a masked unit with three elevated commands -- systemctl
// will not enable or start a unit masked to /dev/null. sudo matches the WHOLE command, so the absent
// row was not cosmetic: srv3-06/07 and srv4-06/07, masked live and committed to CI by
// gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci, stopped at `sudo: a password is required` on the
// unmask leg and no converge could reach the model's post-condition. The population is now derived from
// the steps the plan can issue, and these rows hold the two directions that derivation owes:
//
//   COVERAGE    every elevated argv the plan can issue for a Masked, Disabled or Enabled reading has
//               EXACTLY ONE rendered grant (test.
//               every_elevated_activation_step_the_plan_issues_has_exactly_one_rendered_grant);
//   CONSUMPTION no grant exists that no reading of the plan issues (test.
//               no_activation_grant_exists_that_no_reading_of_the_plan_issues), the property
//               gunbc.design_argument::consumption names;
//   and the RED (test an_ungranted_activation_step_is_reported_and_the_sudoers_route_refuses), which
//               does not merely fail a boolean: the coverage report of gunbc.runner.runner_host_grants
//               names the unit and the verb, and the sudoers route refuses the artifact.
//
// WHY THE JOIN IS WRITTEN ON WORDS AND NOT ON TYPES. What gets installed is a line of text and what sudo
// compares is the argv the executor sends. A witness that reached both sides through the same renderer
// would pass while both were wrong together. So the sudoers line expected here is REBUILT from the plan's
// own argv and the shape sudoers demands, and it is looked for in the RENDERED ARTIFACT TEXT -- the same
// bytes the artifact gate would write -- rather than recomputed from the operation list the text came from.
// The plan's words are separately held against the two authorities the command is built from (the absolute
// systemctl path of gunbc.fleet.fleet_posix_accounts and the verb data of extdeps.systemd.systemctl), and
// the elevation against the one elevation seam, so a step that changed spelling, gained a flag, or lost
// its sudo prefix goes red here rather than on a host.

// THE THREE READINGS THE ACTIVATION PLAN ANSWERS WITH STEPS, typed by the effect's OWN parser. A fixture
// word the parse refuses cannot become a reading quietly: the refused arm carries a unit name no grant can
// name, so a typo shows up as a red coverage gap instead of as an empty plan that satisfies everything.
fn activation_step_readings(unit: NonEmptyStr) -> List<SlotActuationReading> {
  [
    activation_reading(unit: unit, load: "masked", file: "masked", active: "inactive"),
    activation_reading(unit: unit, load: "loaded", file: "disabled", active: "inactive"),
    activation_reading(unit: unit, load: "loaded", file: "enabled", active: "inactive"),
  ]
}

fn activation_reading(unit: NonEmptyStr, load: String, file: String, active: String) -> SlotActuationReading {
  match slot_actuation_reading_typed(unit: unit, load_raw: load, file_raw: file, active_raw: active) {
    SlotReadingTyped { reading: r } => r
    SlotReadingUnknownWord { property: _, raw: _ } =>
      SlotActuationReading { unit: "fixture-word-refused" as NonEmptyStr, load: UnitLoadError, file: none, active: Failed }
  }
}

// THE STEPS THE PLAN ISSUES FOR ONE UNIT OVER ALL THREE READINGS: unmask, enable, start. Deduplicated by
// the assertions below rather than here -- a plan that issued a step twice would have to be granted twice
// to satisfy the EXACTLY ONE conjunct, which is the point of counting instead of setting.
fn activation_plan_steps(unit: NonEmptyStr) -> List<List<String>> {
  flat_map(activation_step_readings(unit: unit), r => match slot_activation_plan(r: r) {
    ActivationSteps { steps: ss } => ss
    ActivationAlreadyActive => []
    ActivationRefused { reason: _ } => []
  })
}

fn activation_reading_steps(unit: NonEmptyStr, load: String, file: String, active: String) -> List<List<String>> {
  match slot_activation_plan(r: activation_reading(unit: unit, load: load, file: file, active: active)) {
    ActivationSteps { steps: ss } => ss
    ActivationAlreadyActive => []
    ActivationRefused { reason: _ } => []
  }
}

// THE SUDOERS LINE AN ARGV NEEDS, REBUILT ON THE WITNESS SIDE: the job user, the root run-as, the argv
// joined by single spaces. Written here rather than imported from the renderer so that a renderer which
// began emitting something the executor could not run -- an extra flag, a reordering -- is caught against
// the text the artifact gate would have installed.
fn activation_grant_line(grantee: NonEmptyStr, argv: List<String>) -> String {
  concat(concat(grantee as String, " ALL=(root) NOPASSWD: "), join(argv, " "))
}

fn activation_line_count(content: String, line: String) -> Int {
  length(xs: filter(split(s: content, delimiter: "\n"), l => l == line))
}

// THE HOST'S RENDERED SUDOERS TEXT, from the same route the artifact gate renders through. A refused body
// yields the empty text, which every count below reads as zero rows -- a refusal is never a silent pass.
fn activation_sudoers_text(host: HostIdentity) -> String {
  match runner_host_sudoers_body(host: host, artifact_path: artifact_path(a: RunnerHostSudoersArtifact { host: host })) {
    RunnerHostSudoersBodyProduced { content: c } => c
    RunnerHostSudoersBodyRefused { reason: _ } => ""
  }
}

// EVERY ELEVATED STEP THE PLAN ISSUES HAS EXACTLY ONE RENDERED GRANT, on every executor host that takes
// fleet work. Three conjuncts per desired slot unit, none of them restate another:
//
//  1. the host's rendered sudoers text carries EXACTLY ONE line naming the command -- the artifact side;
//  2. the host's privileged population holds EXACTLY ONE operation with that argv -- the model side, which
//     catches a grant rendered from a different argv than the plan runs (the sudoers row would be present
//     and wrong, and sudo would still refuse);
//  3. the elevation is `sudo -n` and nothing else, derived from extdeps.sudo.elevation itself -- the leg
//     that actually goes over the ssh edge.
test fn every_elevated_activation_step_the_plan_issues_has_exactly_one_rendered_grant() -> Bool {
  all(
    [operator_host_srv3, operator_host_srv4, operator_host_srv1],
    host => activation_host_join_holds(host: host),
  )
}

fn activation_host_join_holds(host: HostIdentity) -> Bool {
  let d = match admitted_deploy_for(host: host) { Present { value: v } => v  Absent => wt_missing_deploy() }
  let grantee = runner_host_spec_of(deploy: d).job_user
  let body = activation_sudoers_text(host: host)
  let ops = runner_host_privileged_operations(deploy: d)
  all(
    desired_runner_slot_members(deploy: d),
    m => activation_unit_join_holds(grantee: grantee, body: body, ops: ops, unit: runner_unit_name_of_registration(registration_name: m.instance_name)),
  )
}

fn activation_unit_join_holds(grantee: NonEmptyStr, body: String, ops: List<ExecutorPrivilegedOperation>, unit: NonEmptyStr) -> Bool {
  let steps = activation_plan_steps(unit: unit)
  length(xs: steps) == 6
    && all(steps, s => activation_line_count(content: body, line: activation_grant_line(grantee: grantee, argv: s)) == 1)
    && all(steps, s => activation_operation_count(ops: ops, argv: s) == 1)
    && all(steps, s => slot_actuation_elevated(command: s) == concat(sudo_elevate_argv(command: []), s))
}

// THE MASKED READING STILL ISSUES THREE COMMANDS, spelled from the two authorities the sudoers line is
// built from and NOT from the function under test. This is the conjunct that would have gone red the day
// the unmask leg entered the plan without a grant: it holds the plan's own words against the installed
// file, and on 2026-11-09 the file carried neither of them for any slot on any host. It names srv3-06 and
// srv4-06 on purpose -- the former fabric execution slots the operator committed to CI -- because a row
// that only walks the roster would still pass if the slots the operator is waiting on were the ones the
// roster lost.
test fn the_masked_fabric_slots_plan_the_three_commands_the_grants_name() -> Bool {
  all(
    [
      runner_unit_name_of_registration(registration_name: "srv3-06" as NonEmptyStr),
      runner_unit_name_of_registration(registration_name: "srv3-07" as NonEmptyStr),
      runner_unit_name_of_registration(registration_name: "srv4-06" as NonEmptyStr),
      runner_unit_name_of_registration(registration_name: "srv4-07" as NonEmptyStr),
    ],
    unit => activation_reading_steps(unit: unit, load: "masked", file: "masked", active: "inactive")
      == [
           [ci_runner_sudo_binary_path(b: SudoSystemctl) as String, systemctl_unmask_verb as String, unit as String],
           [ci_runner_sudo_binary_path(b: SudoSystemctl) as String, systemctl_enable_verb as String, unit as String],
           [ci_runner_sudo_binary_path(b: SudoSystemctl) as String, systemctl_start_verb as String, unit as String],
         ],
  )
    && activation_line_count(
         content: activation_sudoers_text(host: wt_srv3_deploy().host_label),
         line: activation_grant_line(
           grantee: runner_host_spec_of(deploy: wt_srv3_deploy()).job_user,
           argv: [
             ci_runner_sudo_binary_path(b: SudoSystemctl) as String,
             systemctl_unmask_verb as String,
             runner_unit_name_of_registration(registration_name: "srv3-06" as NonEmptyStr) as String,
           ],
         ),
       ) == 1
    && activation_line_count(
         content: activation_sudoers_text(host: wt_srv4_deploy().host_label),
         line: activation_grant_line(
           grantee: runner_host_spec_of(deploy: wt_srv4_deploy()).job_user,
           argv: [
             ci_runner_sudo_binary_path(b: SudoSystemctl) as String,
             systemctl_unmask_verb as String,
             runner_unit_name_of_registration(registration_name: "srv4-06" as NonEmptyStr) as String,
           ],
         ),
       ) == 1
}

fn activation_operation_count(ops: List<ExecutorPrivilegedOperation>, argv: List<String>) -> Int {
  length(xs: filter(ops, op => executor_privileged_operation_argv(op: op) == argv))
}

// NO GRANT FOR A STEP NO PLAN ISSUES. The population is three rows per desired slot, and every one of
// them is a step some reading of the plan puts on the wire -- checked against the plan's own steps over
// the three readings, so a roster arm nobody reaches, or a grant list that grew an arm of its own again,
// shows up here. The lengths are compared before the membership because a population that silently grew
// a fourth row per slot would otherwise be covered only by the all-direction below.
test fn no_activation_grant_exists_that_no_reading_of_the_plan_issues() -> Bool {
  all(
    [operator_host_srv3, operator_host_srv4, operator_host_srv1],
    host => activation_host_consumption_holds(host: host),
  )
}

fn activation_host_consumption_holds(host: HostIdentity) -> Bool {
  let d = match admitted_deploy_for(host: host) { Present { value: v } => v  Absent => wt_missing_deploy() }
  let members = desired_runner_slot_members(deploy: d)
  let issued = flat_map(members, m => activation_plan_steps(unit: runner_unit_name_of_registration(registration_name: m.instance_name)))
  let granted = map(runner_slot_activation_operations(members: members), op => executor_privileged_operation_argv(op: op))
  length(xs: granted) == length(xs: issued)
    && all(granted, g => list_member(xs: issued, x: g, eq: (a, b) => a == b))
    && all(issued, i => list_member(xs: granted, x: i, eq: (a, b) => a == b))
}

// THE RED. Take the host's own rendered sudoers text, delete ONE unmask line, and the coverage report of
// gunbc.runner.runner_host_grants names that unit and that verb -- it does not silently render the file
// without it, and the sudoers route refuses the artifact rather than installing a file that cannot
// authorize the command the same build's converge will run. The duplicate arm is the same report read from
// the other side: one step, one row. And the un-tampered text reports no gap at all, which is what keeps
// this from being a red that any input satisfies.
test fn an_ungranted_activation_step_is_reported_and_the_sudoers_route_refuses() -> Bool {
  let d = wt_srv3_deploy()
  let spec = runner_host_spec_of(deploy: d)
  let members = desired_runner_slot_members(deploy: d)
  let body = activation_sudoers_text(host: operator_host_srv3)
  let unit = runner_unit_name_of_registration(registration_name: sole_member_instance_name(members: members))
  let unmask_argv = [ci_runner_sudo_binary_path(b: SudoSystemctl) as String, systemctl_unmask_verb as String, unit as String]
  let unmask_line = activation_grant_line(grantee: spec.job_user, argv: unmask_argv)
  let stripped = activation_text_without_line(content: body, line: unmask_line)
  length(xs: runner_slot_activation_grant_gaps(spec: spec, members: members, content: body)) == 0
    && activation_gap_names(gaps: runner_slot_activation_grant_gaps(spec: spec, members: members, content: stripped), unit: unit as String, step: "unmask")
    && (
         match runner_slot_activation_grant_gate(
           spec: spec,
           members: members,
           body: RunnerHostSudoersBodyProduced { content: stripped },
         ) {
           RunnerHostSudoersBodyRefused { reason: r } =>
             string_contains(s: r, pattern: "unmask") && string_contains(s: r, pattern: unit as String)
           RunnerHostSudoersBodyProduced { content: _ } => false
         }
       )
    && activation_gap_names(
         gaps: runner_slot_activation_grant_gaps(
           spec: spec,
           members: members,
           content: concat(body, concat("\n", unmask_line)),
         ),
         unit: unit as String,
         step: "unmask",
       )
}

// THE FIRST DESIRED MEMBER'S INSTANCE, by roster position rather than by name: the row doctoring one
// unit's line has to say WHICH unit it broke, and naming a literal here would let the row keep passing if
// the roster itself lost that slot.
fn sole_member_instance_name(members: List<RunnerSlotMember>) -> NonEmptyStr {
  match members.first() {
    Present { value: m } => m.instance_name
    Absent => "no-desired-slot" as NonEmptyStr
  }
}

fn activation_text_without_line(content: String, line: String) -> String {
  join(filter(split(s: content, delimiter: "\n"), l => l != line), "\n")
}

fn activation_gap_names(gaps: List<RunnerSlotActivationGrantGap>, unit: String, step: String) -> Bool {
  length(xs: filter(gaps, g => match g {
    ActivationGrantGapMissing { unit: u, step: v } => u == unit && v == step
    ActivationGrantGapDuplicated { unit: u, step: v } => u == unit && v == step
  })) == 1
}
