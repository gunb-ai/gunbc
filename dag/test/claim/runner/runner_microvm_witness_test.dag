// THE SPECIMEN CONFIGURATION IS THE FLEET'S OWN VM, BUILT THROUGH THE CONSTRUCTOR THAT HAS NO SIZE
// ARGUMENT, so the configuration every admission witness below is judged against carries the
// bounded cell's declared envelope by construction rather than by a fixture author agreeing with it.
//
// IT WAS THE srv4 MVP CONFIGURATION UNTIL THE FCI-1 RECONCILIATION LANDED, AND THAT SUBSTITUTION IS
// THE POINT. The MVP row is 4 vCPU / 4 GiB against a cell declaring 6 cores / 16 GiB, so the old
// specimen is now exactly the discriminating RED for the envelope wall -- it is kept below under
// its own name rather than deleted, because a wall whose refused input no longer exists anywhere is
// a wall nothing runs (DESIGN 4b).
//
// IT RETURNS THE RESOLUTION RATHER THAN A CONFIGURATION, AND THAT IS THE REPAIR OF A REAL DEFECT
// REVIEW 58648 CAUGHT. An earlier revision returned FirecrackerVmConfig and, on the unresolved
// arm, SUBSTITUTED two_root_config() -- which builds its own fields from the specimen, so the two
// functions called each other with no descent. Unbounded mutual recursion, in a file whose subject
// is fail-closed refusal, reached only when the envelope stops resolving.
//
// It was also a fabricated fallback on its own terms: DESIGN 5 says every path succeeds fully or
// fails with a typed located diagnostic, and substituting a deliberately malformed configuration
// so that admission would refuse for a DIFFERENT reason is exactly the absorbing arm that section
// forbids -- it converts "the envelope did not resolve" into "the VM was malformed", two states
// with different owners.
//
// So the resolution is propagated and every witness matches it. An unresolved envelope now makes
// each witness FALSE by its own arm, which is the honest red: if the cell's envelope stops
// resolving, every admission witness in this file is measuring nothing and says so.
fn specimen_resolution() -> RunnerMicroVmConfigResolution {
  gunbc_runner_microvm_vm_config(
    rootfs_path: "/var/tmp/fcmvp/rootfs.ext4",
    jit_config_path: "/var/tmp/fcmvp/jitcfg.ext4",
    kernel_path: "/var/tmp/fcmvp/vmlinux",
    tap_device: "fcmvp0",
    guest_mac: "06:00:AC:10:00:02",
  )
}

// THE srv4 MVP CONFIGURATION, RETAINED AS THE ENVELOPE WALL'S RED INPUT.
fn mvp_sized_config() -> FirecrackerVmConfig {
  runner_microvm_vm_config(
    rootfs_path: "/var/tmp/fcmvp/rootfs.ext4",
    jit_config_path: "/var/tmp/fcmvp/jitcfg.ext4",
    kernel_path: "/var/tmp/fcmvp/vmlinux",
    tap_device: "fcmvp0",
    guest_mac: "06:00:AC:10:00:02",
    size: runner_microvm_mvp_size,
    transport: gunbc_runner_jit_transport,
  )
}

fn admission_is_admitted(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmAdmitted => true
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
  }
}

fn admission_is_orphan_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
  }
}

fn admission_is_credential_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedSharedCredential { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
  }
}

fn admission_is_envelope_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
  }
}

fn admission_is_malformed_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedMalformedVm { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
  }
}

data deployed_lifecycle_intent: RunnerUnitLifecycleIntent = RunnerUnitLifecycleIntent {
  exit_type: ExitTypeMain,
  kill_mode: KillModeProcess,
}

data repaired_lifecycle_intent: RunnerUnitLifecycleIntent = RunnerUnitLifecycleIntent {
  exit_type: ExitTypeCgroup,
  kill_mode: KillModeControlGroup,
}

// THE DISCRIMINATING RED. This is the whole reason the prerequisite is a predicate and not a
// paragraph: under the lifecycle intent the fleet is ACTUALLY RUNNING today -- KillMode=process,
// ExitType=main, with a listener that is a grandchild of MainPID -- a microVM does not close the
// orphan class, it relocates the orphan to the VMM. The admission must refuse, and refuse with
// THAT cause rather than a generic no.
test fn orphanable_unit_refuses_the_microvm_migration() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_orphan_refusal(
      a: runner_microvm_admission(
        topology: VmmUnderLifecycleController,
        intent: deployed_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: c,
      ),
    )
  }
}

// THE POSITIVE CONTROL. Same VM, same transport, cgroup-reaching teardown: admitted. Without this
// arm the refusal above would be satisfied by an admission that refuses everything.
test fn cgroup_teardown_admits_the_same_microvm() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_admitted(
      a: runner_microvm_admission(
        topology: VmmUnderLifecycleController,
        intent: repaired_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: c,
      ),
    )
  }
}

// THE SHARED-DIRECTORY CARRIER IS THE MEASURED DEFECT, SO IT IS REFUSED BY NAME. Five confirmed
// specimens on srv4 all have one shape: an orphaned listener from a previous incarnation deletes
// .credentials from the slot directory a LIVE job is using. A microVM that reproduced that carrier
// would reproduce the defect inside a nicer box.
test fn shared_slot_directory_credential_is_refused() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_credential_refusal(
      a: runner_microvm_admission(
        topology: VmmUnderLifecycleController,
        intent: repaired_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigInSharedSlotDirectory { path: "/opt/actions-runner/srv4-04/.credentials" },
        config: c,
      ),
    )
  }
}

fn two_root_config() -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: mvp_sized_config().boot_source,
    drives: [
      FirecrackerDrive { drive_id: "rootfs", path_on_host: "/a", is_root_device: true, is_read_only: false },
      FirecrackerDrive { drive_id: "other", path_on_host: "/b", is_root_device: true, is_read_only: false },
    ],
    network_interfaces: mvp_sized_config().network_interfaces,
    machine_config: mvp_sized_config().machine_config,
  }
}

test fn two_root_devices_is_a_malformed_vm() -> Bool {
  admission_is_malformed_refusal(
    a: runner_microvm_admission(
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      listener_is_main_process: false,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: two_root_config(),
    ),
  )
}

// THE DERIVED CONFIGURATION IS WELL FORMED BY CONSTRUCTION, WHICH IS WHAT MAKES THE ARM ABOVE A
// PROPERTY OF HAND-AUTHORED CONFIGS RATHER THAN A HAZARD OF THIS MODULE'S OWN CONSTRUCTOR.
test fn derived_config_names_exactly_one_root() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    firecracker_config_has_single_root(config: c)
  }
}

// THE DELTA THE MIGRATION BUYS, STATED AS A COMPARISON RATHER THAN AS A CLAIM. The current slot
// profile is empty by measurement, so it fails the same requirement the microVM satisfies.
test fn microvm_provides_a_dedicated_kernel_and_the_current_slot_does_not() -> Bool {
  runner_microvm_provides_dedicated_kernel()
    && !isolation_profile_satisfies(
      required: IsolationProfile { guarantees: [DedicatedKernel] },
      provided: current_runner_slot_profile(),
    )
}

// THE ARM THE EARLIER REVISION GOT WRONG, KEPT AS A WITNESS SO IT CANNOT SILENTLY RETURN.
//
// Same orphanable lifecycle intent, same everything, ONE fact different: the unit execs the VMM
// directly, so Firecracker is MainPID. Killing MainPID destroys the guest, so no kill mode can
// leave an orphan and the guarantee is not required. A model that refused this would be refusing a
// correct design and calling it safety.
test fn direct_exec_vmm_is_admitted_under_the_same_orphanable_intent() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_admitted(
      a: runner_microvm_admission(
        topology: VmmIsMainProcess,
        intent: deployed_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: c,
      ),
    )
  }
}

// AND THE PAIR THAT MAKES THE ARM ABOVE LOAD-BEARING RATHER THAN A BLANKET PASS: under the
// controller topology the SAME intent refuses. The topology is what decides, and it decides both
// ways -- so neither arm is the constant.
test fn topology_is_what_decides_and_it_decides_both_ways() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_admitted(
      a: runner_microvm_admission(
        topology: VmmIsMainProcess,
        intent: deployed_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: c,
      ),
    ) && admission_is_orphan_refusal(
      a: runner_microvm_admission(
        topology: VmmUnderLifecycleController,
        intent: deployed_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: c,
      ),
    )
  }
}

// A DIRECT-EXEC VMM DOES NOT EXCUSE THE SHARED-CREDENTIAL CARRIER. The two gates are independent
// facts and the topology must not absorb the other one.
test fn direct_exec_still_refuses_the_shared_slot_credential() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_credential_refusal(
      a: runner_microvm_admission(
        topology: VmmIsMainProcess,
        intent: deployed_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigInSharedSlotDirectory { path: "/opt/actions-runner/srv4-04/.credentials" },
        config: c,
      ),
    )
  }
}

// THE GUEST IMAGE CARRIES THE FLEET'S OWN CITED RUNNER RELEASE, NOT A SECOND VERSION ROW.
test fn guest_image_runner_is_the_cited_fleet_release() -> Bool {
  gunbc_runner_guest_image.runner.version == actions_runner_release_2_336_0.version
}

// THE FCI-1 RECONCILIATION, STATED AS EXECUTED WITNESSES RATHER THAN AS A PARAGRAPH IN THE MODULE.

// THE CELL'S ENVELOPE RESOLVES AT ALL. Every admission witness above is judged against a
// configuration built from this resolution, so if it stopped resolving those witnesses would be
// measuring a substituted fixture instead of the fleet's VM. This is the guard that makes their
// green mean what it says, and it is asserted rather than assumed for exactly that reason.
test fn the_bounded_cell_envelope_resolves() -> Bool {
  match runner_microvm_size_from_cell_envelope() {
    MicroVmSized { size: _ } => true
    MicroVmSizeUnresolved { cause: _ } => false
  }
}

// THE DERIVED SIZE IS THE CELL'S OWN ENVELOPE ON BOTH AXES, READ BACK FROM THE AUTHORITIES THE
// CGROUP BOUNDARY READS. This is the join FCI-1 freezes as `cell-resource-envelope`: the guest's
// machine configuration and gunbc.fabric_cell_effect's slice directives are two projections of
// gunbc_runner_slot_desired, and this witness is what makes "two projections" a measured claim
// rather than an assertion. It compares against the ceiling and the core resolution DIRECTLY --
// not against a literal copied out of them, which would be a change detector (DESIGN 5).
test fn the_derived_vm_size_is_the_cell_resource_envelope() -> Bool {
  match runner_microvm_size_from_cell_envelope() {
    MicroVmSizeUnresolved { cause: _ } => false
    MicroVmSized { size: s } =>
      match gunbc_runner_cores_per_slot() {
        CoresPerSlotUnresolved { cause: _ } => false
        CoresPerSlotResolved { threads: want_threads } =>
          hardware_thread_count_value(t: s.vcpu_count) == hardware_thread_count_value(t: want_threads)
            && byte_size_count(b: mebibyte_to_byte_size(m: s.memory))
              == byte_size_count(b: gunbc_runner_slot_desired().memory_max)
      }
  }
}

// THE DISCRIMINATING RED FOR THE ENVELOPE WALL. The srv4 MVP VM -- 4 vCPU, 4 GiB -- is a real
// configuration that really booted, and it is exactly the shape the wall exists to refuse: a guest
// sized under the bounded cell's ceiling makes the same work die inside a slice that still had
// room. Refused, and refused with THAT cause rather than a generic no.
test fn the_mvp_sized_vm_is_refused_against_the_cell_envelope() -> Bool {
  admission_is_envelope_refusal(
    a: runner_microvm_admission(
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      listener_is_main_process: false,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
    ),
  )
}

// THE MVP ROW IS NOT THIS FLEET'S SIZING, ASSERTED SO THAT NOBODY MAY QUIETLY START CONSUMING IT AS
// ONE. If the MVP row ever equalled the cell envelope, the witness above would be green by
// coincidence rather than by the wall, and this is the arm that says so out loud.
test fn the_mvp_size_is_not_the_cell_envelope() -> Bool {
  match runner_microvm_size_from_cell_envelope() {
    MicroVmSizeUnresolved { cause: _ } => false
    MicroVmSized { size: want } =>
      !(hardware_thread_count_value(t: runner_microvm_mvp_size.vcpu_count)
          == hardware_thread_count_value(t: want.vcpu_count)
        && mebibyte_count(m: runner_microvm_mvp_size.memory) == mebibyte_count(m: want.memory))
  }
}

// THE FLEET CONSTRUCTOR HAS NO SIZE AXIS TO GET WRONG, AND ITS OUTPUT PASSES THE WALL IT IS NOT
// CHECKED BY. This is the positive control for construction-over-validation: the same admission
// that refuses the MVP configuration admits the derived one, so the wall is discriminating rather
// than constant, and the constructed path needs no fixing up to clear it.
test fn the_fleet_constructed_vm_carries_the_cell_envelope() -> Bool {
  match specimen_resolution() {
    MicroVmConfigUnresolved { cause: _ } => false
    MicroVmConfigResolved { config: c } =>
    admission_is_admitted(
      a: runner_microvm_admission(
        topology: VmmUnderLifecycleController,
        intent: repaired_lifecycle_intent,
        listener_is_main_process: false,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: c,
      ),
    )
  }
}
