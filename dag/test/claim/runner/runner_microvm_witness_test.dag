// THE srv4 MVP CONFIGURATION, RETAINED AS THE ENVELOPE WALL'S RED INPUT.
fn mvp_sized_config() -> FirecrackerVmConfig {
  runner_microvm_vm_config(
    rootfs_path: "/var/tmp/fcmvp/rootfs.ext4",
    jit_config_path: "/var/tmp/fcmvp/jitcfg.ext4",
    kernel_path: "/var/tmp/fcmvp/vmlinux",
    net: GuestNetworkTap { device: "fcmvp0", guest_mac: "06:00:AC:10:00:02" },
    size: gunbc_runner_microvm_declared_size,
    transport: gunbc_runner_jit_transport,
  )
}

fn admission_is_orphan_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: _ } => false
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: _ } => false
    RunnerMicroVmRecoveryRequired { bound: _ } => false
  }
}

fn admission_is_credential_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedSharedCredential { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: _ } => false
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: _ } => false
    RunnerMicroVmRecoveryRequired { bound: _ } => false
  }
}

fn admission_is_envelope_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: _ } => false
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: _ } => false
    RunnerMicroVmRecoveryRequired { bound: _ } => false
  }
}

// THE ACCEPT ARM IS RECOGNISED AGAIN, AND THAT MATTERS. The previous revision deleted this
// because RunnerMicroVmAdmitted had become unreachable -- the sizing refused, so every path ended
// in a refusal and nothing exercised the admission's success. Judging a config against a DECLARED
// reserve makes the arm reachable from a fixture, so the gate's accept path executes rather than
// shipping unexercised.
fn admission_is_admitted(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmAdmitted => true
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: _ } => false
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: _ } => false
    RunnerMicroVmRecoveryRequired { bound: _ } => false
  }
}

// THE REASON IS MATCHED, NOT DISCARDED, AND THAT IS THE POINT OF THIS RECOGNIZER.
//
// It previously accepted RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ }. That established
// the DISPOSITION and threw away the located cause, so the control stayed green under a mutation
// where the producer names the missing Firecracker reserve and the ADMISSION returns a bare
// "unresolved" -- still discriminating admit from refuse, no longer carrying the cause the source
// claims it protects. A separate witness on the producer cannot close that: it establishes what
// the producer emits, not that this path PRESERVES it.
fn admission_refuses_naming_the_missing_reserve(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: r } =>
      cause_mentions(cause: r, needle: "extdeps.virtualization.firecracker")
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedMalformedVm { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: _ } => false
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: _ } => false
    RunnerMicroVmRecoveryRequired { bound: _ } => false
  }
}

fn admission_is_malformed_refusal(a: RunnerMicroVmAdmission) -> Bool {
  match a {
    RunnerMicroVmRefusedMalformedVm { reason: _ } => true
    RunnerMicroVmAdmitted => false
    RunnerMicroVmRefusedOrphanableUnit { reason: _ } => false
    RunnerMicroVmRefusedSharedCredential { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeDisagreement { reason: _ } => false
    RunnerMicroVmRefusedEnvelopeUnresolved { reason: _ } => false
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: _ } => false
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: _ } => false
    RunnerMicroVmRecoveryRequired { bound: _ } => false
  }
}

data deployed_lifecycle_intent: RunnerUnitLifecycleIntent = RunnerUnitLifecycleIntent {
  exit_type: ExitTypeMain,
  kill_mode: KillModeProcess,
}

data repaired_lifecycle_intent: RunnerUnitLifecycleIntent = RunnerUnitLifecycleIntent {
  exit_type: ExitTypeMain,
  kill_mode: KillModeControlGroup,
}

// THE ExitType=cgroup DROP-IN THE FLEET CARRIES ON 2026-09-18, which an earlier revision of this file
// called the repaired intent. One survivor holds the unit running with no stop issued (srv2-02, 2.7
// days; srv1-03 and srv1-07, 16 days), so under a lifecycle controller an orphaned VMM would be held
// exactly the same way.
data exittype_cgroup_lifecycle_intent: RunnerUnitLifecycleIntent = RunnerUnitLifecycleIntent {
  exit_type: ExitTypeCgroup,
  kill_mode: KillModeControlGroup,
}

// THE DISCRIMINATING RED. This is the whole reason the prerequisite is a predicate and not a
// paragraph: under the lifecycle intent the fleet is ACTUALLY RUNNING today -- KillMode=process,
// ExitType=main, with a listener that is a grandchild of MainPID -- a microVM does not close the
// orphan class, it relocates the orphan to the VMM. The admission must refuse, and refuse with
// THAT cause rather than a generic no.
test fn orphanable_unit_refuses_the_microvm_migration() -> Bool {
  admission_is_orphan_refusal(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: deployed_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

// THE INCIDENT FIXTURE AS A RED: the configuration the previous revision admitted must now refuse,
// with the orphan cause, or a revert to it would read green.
test fn exittype_cgroup_unit_refuses_the_microvm_migration() -> Bool {
  admission_is_orphan_refusal(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: exittype_cgroup_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

// THE POSITIVE CONTROL. Same VM, same transport, the declared intent (ExitType=main, KillMode=control-group): admitted. Without this
// arm the refusal above would be satisfied by an admission that refuses everything.
test fn main_exit_teardown_admits_the_same_microvm() -> Bool {
  admission_is_admitted(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

// THE SHARED-DIRECTORY CARRIER IS THE MEASURED DEFECT, SO IT IS REFUSED BY NAME. Five confirmed
// specimens on srv4 all have one shape: an orphaned listener from a previous incarnation deletes
// .credentials from the slot directory a LIVE job is using. A microVM that reproduced that carrier
// would reproduce the defect inside a nicer box.
test fn shared_slot_directory_credential_is_refused() -> Bool {
  admission_is_credential_refusal(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigInSharedSlotDirectory { path: "/opt/actions-runner/srv4-04/.credentials" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

fn two_root_config() -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: mvp_sized_config().boot_source,
    drives: [
      FirecrackerDrive { drive_id: "rootfs", path_on_host: "/a", is_root_device: true, is_read_only: false },
      FirecrackerDrive { drive_id: "other", path_on_host: "/b", is_root_device: true, is_read_only: false },
    ],
    network_interfaces: mvp_sized_config().network_interfaces,
    machine_config: mvp_sized_config().machine_config,
  }
}

test fn two_root_devices_is_a_malformed_vm() -> Bool {
  admission_is_malformed_refusal(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: two_root_config(),
      reserve: witness_reserve,
    ),
  )
}

// THE DERIVED CONFIGURATION IS WELL FORMED BY CONSTRUCTION, WHICH IS WHAT MAKES THE ARM ABOVE A
// PROPERTY OF HAND-AUTHORED CONFIGS RATHER THAN A HAZARD OF THIS MODULE'S OWN CONSTRUCTOR.
test fn derived_config_names_exactly_one_root() -> Bool {
  firecracker_config_has_single_root(config: mvp_sized_config())
}

// THE DELTA THE MIGRATION BUYS, STATED AS A COMPARISON RATHER THAN AS A CLAIM. The current slot
// profile is empty by measurement, so it fails the same requirement the microVM satisfies.
test fn microvm_provides_a_dedicated_kernel_and_the_current_slot_does_not() -> Bool {
  runner_microvm_provides_dedicated_kernel()
    && !isolation_profile_satisfies(
      required: IsolationProfile { guarantees: [DedicatedKernel] },
      provided: current_runner_slot_profile(),
    )
}

// THE ARM THE EARLIER REVISION GOT WRONG, KEPT AS A WITNESS SO IT CANNOT SILENTLY RETURN.
//
// Same orphanable lifecycle intent, same everything, ONE fact different: the unit execs the VMM
// directly, so Firecracker is MainPID. Killing MainPID destroys the guest, so no kill mode can
// leave an orphan and the guarantee is not required. A model that refused this would be refusing a
// correct design and calling it safety.
test fn direct_exec_vmm_is_admitted_under_the_same_orphanable_intent() -> Bool {
  admission_is_admitted(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmIsMainProcess,
      intent: deployed_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

// AND THE PAIR THAT MAKES THE ARM ABOVE LOAD-BEARING RATHER THAN A BLANKET PASS: under the
// controller topology the SAME intent refuses. The topology is what decides, and it decides both
// ways -- so neither arm is the constant.
test fn topology_is_what_decides_and_it_decides_both_ways() -> Bool {
  admission_is_admitted(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmIsMainProcess,
      intent: deployed_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  ) && admission_is_orphan_refusal(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: deployed_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

// A DIRECT-EXEC VMM DOES NOT EXCUSE THE SHARED-CREDENTIAL CARRIER. The two gates are independent
// facts and the topology must not absorb the other one.
test fn direct_exec_still_refuses_the_shared_slot_credential() -> Bool {
  admission_is_credential_refusal(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmIsMainProcess,
      intent: deployed_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigInSharedSlotDirectory { path: "/opt/actions-runner/srv4-04/.credentials" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ),
  )
}

// THE GUEST IMAGE CARRIES A CITED RUNNER RELEASE ROW, NOT A SECOND VERSION ROW.
//
// THIS TEST USED TO ASSERT EQUALITY WITH THE FLEET'S HOST-SLOT PIN AND WAS GREEN THROUGHOUT THE
// FORK IT WAS NAMED FOR. Both sides read from the same declaration, so it compared 2.336.0 to
// itself while the artifact that actually reached GitHub was 2.337.0. What it established was that
// no version literal had been typed twice IN THE MODEL -- worth having, and not what its name
// claimed.
//
// SO IT NOW NAMES THE GUEST IMAGE'S OWN PIN. The fleet's host-slot path still installs 2.336.0 and
// gunbc.runner_microvm states why that divergence stands; asserting the two are equal would make
// this test red for a condition the model deliberately holds.
//
// AND IT STILL CANNOT SEE THE CLASS THAT BIT US. No comparison between two declarations can catch a
// model that disagrees with a RUNNING artifact -- that needs an observation, and
// gunbc.runner_microvm_boot_probe's boot_probe_verdict is the comparator that performs it. The
// Mt. Collins path never invoked it, which is the actual gap.
test fn guest_image_runner_is_the_cited_release_row() -> Bool {
  gunbc_runner_guest_image.runner.version == actions_runner_release_2_337_0.version
}

// THE FCI-1 RECONCILIATION, STATED AS EXECUTED WITNESSES RATHER THAN AS A PARAGRAPH IN THE MODULE.

// Local one-liner over the builtin rather than an import: several test files already declare their
// own string-containment helper, so a shared bare name would be ambiguous corpus-wide. This is a
// witness's incidental helper, not a shared authority, and it is named for what it reads.
fn cause_mentions(cause: String, needle: String) -> Bool {
  cause.contains(needle)
}

// WHAT THIS BLOCK DEMONSTRATES, AND WHAT IT USED TO CLAIM FALSELY.
//
// It used to assert that the fleet's VM carries the cell's resource envelope, and that the
// admission admits it. Both arms of that pair were WRONG, in opposite directions, while the pair
// looked discriminating: the accept arm admitted a guest sized at the whole cell MemoryMax, leaving
// the Firecracker VMM process nothing inside that same cell, and the refuse arm rejected a 4 GiB
// guest against a 16 GiB cell -- which FITS. What it discriminated was equality-to-the-envelope,
// which is neither the safety property nor a property the cell can enforce.
//
// The property is CONTAINMENT: guest + realization reserve <= cell envelope. A SMALLER guest must
// PASS. That is asserted below as a requirement, not tolerated as a side effect.

// THE WITNESS'S DECLARED RESERVE, and why authoring one here is legitimate where authoring one in
// production would not be. This is a controlled fixture whose only purpose is to make both fit
// polarities reachable -- DESIGN 5 sanctions a literal grounded in a fixture the test owns. The
// production reserve is gunbc_runner_microvm_realization_reserve, which REFUSES, and the witness
// below asserts that it refuses; nothing here weakens that.
data witness_reserve: RealizationReserve = ReserveDeclared { bytes: byte_size(count: 268435456) }

// AN UNMODELED RESERVE IS NOW A FIXTURE TOO. Production declares an allowance, so the arm that
// refuses for want of one is no longer reachable from the fleet's own row -- and a refusal arm with
// no way to be driven is a decoration. This is what drives it.
data witness_unmodeled_reserve: RealizationReserve = ReserveUnmodeled {
  cause: "no VMM resident footprint is cited in extdeps.virtualization.firecracker",
}

// THE SAME CONFIGURATION, JUDGED UNDER THE PRODUCTION RESERVE, IS REFUSED -- AND THIS IS THE PAIR
// THAT MATTERS MOST. The three admission witnesses above admit this exact guest under a DECLARED
// reserve. Here the only thing that changes is the reserve, and the answer flips to a refusal
// naming the missing quantity. So the admission is not admitting because it admits everything, and
// it is not refusing because it refuses everything: the reserve is what decides, which is the whole
// claim of this change.
//
// This is also the honest replacement for the witness deleted in the previous revision. That one
// returned true from its unresolved arm without reaching the admission at all, so it could not
// fail. This one reaches the admission and fails if the cause stops naming where the quantity is
// owed.
test fn the_same_guest_is_refused_under_the_production_reserve() -> Bool {
  admission_refuses_naming_the_missing_reserve(
    a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_unmodeled_reserve,
    ),
  )
}

// THE SIGNED BOUNDARY, WHICH IS WHERE THIS CHANGE WAS FAIL-OPEN.
//
// FirecrackerMachineConfig carries vcpu_count and mem_size_mib as SIGNED Int -- upstream's shape,
// faithfully modeled. Before the validation below, a config declaring mem_size_mib = -1 flowed
// into the fit comparison and satisfied -1 MiB + 256 MiB <= 16 GiB, so a hostile or corrupt value
// was ADMITTED by the very relation this module exists to enforce. These five witnesses are the
// wall; the fifth is what stops the other four being satisfied by a predicate that refuses
// everything.
fn config_with_machine(vcpus: Int, mib: Int) -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: mvp_sized_config().boot_source,
    drives: mvp_sized_config().drives,
    network_interfaces: mvp_sized_config().network_interfaces,
    machine_config: FirecrackerMachineConfig { vcpu_count: vcpus, mem_size_mib: mib },
  }
}

fn admission_of_machine(vcpus: Int, mib: Int) -> RunnerMicroVmAdmission {
  runner_microvm_admission(
    cell: witness_admitted_cell(),
    topology: VmmUnderLifecycleController,
    intent: repaired_lifecycle_intent,
    main_exits_when_incarnation_ends: true,
    transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
    config: config_with_machine(vcpus: vcpus, mib: mib),
    reserve: witness_reserve,
  )
}

// NEGATIVE MEMORY IS REFUSED. This is the authorable red: without the boundary validation this
// exact config reached GuestFitsWithinCell and then RunnerMicroVmAdmitted.
test fn a_negative_guest_memory_is_refused() -> Bool {
  admission_is_malformed_refusal(a: admission_of_machine(vcpus: 4, mib: -1))
}

// ZERO MEMORY IS REFUSED. Asserted separately from the negative case because zero is not caught by
// a sign test alone and is the value an uninitialised field most plausibly carries.
test fn a_zero_guest_memory_is_refused() -> Bool {
  admission_is_malformed_refusal(a: admission_of_machine(vcpus: 4, mib: 0))
}

// A NON-POSITIVE vCPU COUNT IS REFUSED. The admitted arm never validated it, so a guest that could
// not start was previously admissible on the memory axis alone.
test fn a_non_positive_vcpu_count_is_refused() -> Bool {
  admission_is_malformed_refusal(a: admission_of_machine(vcpus: 0, mib: 4096))
    && admission_is_malformed_refusal(a: admission_of_machine(vcpus: -2, mib: 4096))
}

// THE VMM'S OWN vCPU RANGE IS APPLIED AT THE HAND-AUTHORED CONFIG ENTRY TOO, so a configuration
// that bypasses the shape cannot carry a count Firecracker refuses before boot: 32 is admitted,
// 33 is the boundary refusal, 64 refuses harder. The range is the pinned release's row
// (extdeps.virtualization.firecracker firecracker_vcpu_range_v1_16_1), not a literal here.
test fn a_vcpu_count_the_pinned_firecracker_refuses_is_a_malformed_vm() -> Bool {
  admission_is_admitted(a: admission_of_machine(vcpus: hardware_thread_count_value(t: firecracker_vcpu_range_v1_16_1.maximum), mib: 4096))
    && admission_is_malformed_refusal(a: admission_of_machine(vcpus: hardware_thread_count_value(t: firecracker_vcpu_range_v1_16_1.maximum) + 1, mib: 4096))
    && admission_is_malformed_refusal(a: admission_of_machine(vcpus: 64, mib: 4096))
    && hardware_thread_count_value(t: firecracker_vcpu_range_v1_16_1.maximum) == 32
    && hardware_thread_count_value(t: firecracker_vcpu_range_v1_16_1.minimum) == 1
}

// AN UNREPRESENTABLE MEMORY SIZE IS REFUSED RATHER THAN WRAPPED. mebibyte_to_byte_size multiplies
// by 2^20, so beyond this bound the byte magnitude does not fit the realization's i64 and the
// comparison would be performed on a wrapped value -- answering the wrong question silently, which
// is worse than refusing.
test fn an_unrepresentable_guest_memory_is_refused() -> Bool {
  admission_is_malformed_refusal(a: admission_of_machine(vcpus: 4, mib: 9007199254740992))
}

// THE NON-DEGENERATE CONTROL, AND IT IS NOT OPTIONAL. Without it the four refusals above are all
// satisfied by an admission that refuses everything. A small positive guest, well inside the cell
// beside its reserve, is still ADMITTED -- so the wall rejects bad magnitudes rather than rejecting
// magnitudes.
test fn a_small_positive_guest_is_still_admitted() -> Bool {
  admission_is_admitted(a: admission_of_machine(vcpus: 2, mib: 1024))
}

// ARM ONE OF THE FIT PAIR -- SMALLER PASSES. The 4 GiB MVP guest plus a 256 MiB reserve against a
// 16 GiB cell fits with room to spare. The withdrawn control REFUSED exactly this configuration.
test fn a_guest_smaller_than_the_cell_envelope_fits() -> Bool {
  match guest_memory_fits(
    guest: GuestMemoryRequest { bytes: byte_size(count: 4294967296) },
    reserve: witness_reserve,
    envelope: CellMemoryEnvelope { bytes: byte_size(count: 17179869184) },
  ) {
    GuestFitsWithinCell => true
    GuestExceedsCell { detail: _ } => false
    MemoryFitUnresolved { cause: _ } => false
  }
}

// ARM TWO -- THE GUEST SIZED AT THE WHOLE ENVELOPE IS REFUSED, WHICH IS THE MEASURED DEFECT ITSELF.
// A guest equal to the cell's MemoryMax leaves nothing for the VMM process that lives in that cell,
// so any nonzero reserve puts the pair over. This is the configuration the withdrawn derivation
// produced and the withdrawn control ADMITTED.
test fn a_guest_sized_at_the_whole_envelope_is_refused() -> Bool {
  match guest_memory_fits(
    guest: GuestMemoryRequest { bytes: byte_size(count: 17179869184) },
    reserve: witness_reserve,
    envelope: CellMemoryEnvelope { bytes: byte_size(count: 17179869184) },
  ) {
    GuestExceedsCell { detail: _ } => true
    GuestFitsWithinCell => false
    MemoryFitUnresolved { cause: _ } => false
  }
}

// THE BOUNDARY IS INCLUSIVE AND IT IS ASSERTED, because "fits" and "exactly fills" are one
// comparison apart and an off-by-one here silently re-admits the defect above.
test fn a_guest_exactly_filling_the_envelope_with_its_reserve_fits() -> Bool {
  match guest_memory_fits(
    guest: GuestMemoryRequest { bytes: byte_size(count: 16911433728) },
    reserve: witness_reserve,
    envelope: CellMemoryEnvelope { bytes: byte_size(count: 17179869184) },
  ) {
    GuestFitsWithinCell => true
    GuestExceedsCell { detail: _ } => false
    MemoryFitUnresolved { cause: _ } => false
  }
}

// THE SPLIT THAT MAKES THE OVERFLOW IMPOSSIBLE IS ITSELF LOAD-BEARING, SO IT IS ASSERTED HERE.
// guest_memory_fits compares by subtraction precisely so the comparison cannot overflow, and that
// is only sound while the reserve-exceeds-envelope case is taken FIRST -- otherwise the subtraction
// runs below zero and the impossibility claim is false. This witness is the reason that branch may
// not be refactored away as a redundant guard: delete it and the arm below stops being reachable,
// and the structural guarantee quietly degrades into a wrapping comparison.
test fn a_reserve_larger_than_the_whole_envelope_admits_no_guest() -> Bool {
  match guest_memory_fits(
    guest: GuestMemoryRequest { bytes: byte_size(count: 1048576) },
    reserve: ReserveDeclared { bytes: byte_size(count: 34359738368) },
    envelope: CellMemoryEnvelope { bytes: byte_size(count: 17179869184) },
  ) {
    GuestExceedsCell { detail: _ } => true
    GuestFitsWithinCell => false
    MemoryFitUnresolved { cause: _ } => false
  }
}

// PRODUCTION REFUSES, AND THE REFUSAL NAMES THE MISSING THING. This is the honest form of the
// witness deleted in the previous revision: that one returned true from its unresolved arm without
// reaching anything, so it could not fail. This one fails if the cause stops naming the authority
// that owes the quantity.
// PRODUCTION NOW DECLARES AN ALLOWANCE, AND THIS IS THE REGRESSION CONTROL FOR THAT CLIMB. It
// previously asserted the reserve was unmodeled; that was an expecting-red probe whose wall landed,
// so per DESIGN 4b(4) it flips rather than retires. It pins the VALUE, because an allowance that
// silently became zero would still be ReserveDeclared and would admit a guest with nothing set
// aside for the VMM -- the exact state the reserve exists to prevent.
test fn the_production_reserve_is_the_declared_allowance() -> Bool {
  match gunbc_runner_microvm_realization_reserve() {
    ReserveUnmodeled { cause: _ } => false
    ReserveDeclared { bytes: b } =>
      byte_size_count(b: b) == byte_size_count(b: gibibyte_to_byte_size(gunbc_runner_microvm_declared_realization_allowance))
        && byte_size_count(b: b) > 0
  }
}

// THE PRODUCTION RESERVE LETS THE DECLARED CONFIGURATION REACH ADMISSION, AND THE NAME IS THIS LONG
// BECAUSE THE SHORTER ONES ALL CLAIMED MORE THAN THIS ROW EXECUTES.
//
// WHAT IS PRODUCTION HERE: the sizing policy behind gunbc_runner_microvm_vm_config, and the reserve
// gunbc_runner_microvm_admission injects. Those are the fleet's own rows, and the reserve is the
// subject of this change. Every other admitted-arm control in this file substitutes witness_reserve
// for that -- deliberate, since the reserve is a parameter precisely so the accept arm stays
// executed while production refused -- so none of them could say whether the FLEET's reserve reaches
// the arm. Until this change it did not: sizing resolved, then admission refused on an unmodeled
// reserve.
//
// WHAT IS AUTHORED HERE, STATED PLAINLY BECAUSE AN EARLIER REVISION OF THIS COMMENT CLAIMED IT
// SUBSTITUTED NOTHING, WHICH WAS FALSE BY INSPECTION: the three image paths, the absent guest
// network, and the VMM topology are all authored by this row. They are not read from a fleet row,
// because none exists to read -- no production binding selects a VmmProcessTopology and nothing in
// production calls gunbc_runner_microvm_admission at all. A launch binding that does is separate
// work, and this row must not be read as evidence that one exists.
//
// It judges MODEL admission -- whether such a row is one this repository would accept -- and boots
// nothing; no Firecracker process is involved at any step.
// PRODUCTION SIZING NOW DERIVES, AND WHAT IT ANSWERS IS DECIDED BY THE FLOOR'S DEMAND STANDING.
// While the held-set demand is unmeasured the Work states no memory and the shape must
// refuse on exactly that absence -- not on the charge ceiling, which includes reclaimable cache
// and is a bet. Once a receipt stands, the shape must resolve iff the stated requirement fits the
// cell's remainder beside the reserve, and refuse with both figures otherwise. Both arms are
// written so the witness is discriminating in whichever state production is in, rather than a
// probe that has to be rewritten the day the receipt lands.
test fn the_production_shape_answers_according_to_the_floor_demand_standing() -> Bool {
  let remainder = byte_size_count(b: gunbc_runner_slot_desired().memory_max) - byte_size_count(b: gibibyte_to_byte_size(gunbc_runner_microvm_declared_realization_allowance))
  match floor_memory_requirement() {
    Absent =>
      match gunbc_runner_microvm_shape() {
        MicroVmShapeResolved { shape: _ } => false
        MicroVmShapeRefused { refusal: r } =>
          match r {
            ShapeRefusedWorkMemoryUnstated => true
            _ => false
          }
      }
    Present { value: need } =>
      match gunbc_runner_microvm_guest_cache_allowance() {
        AllowanceUnderivable { cause: _ } =>
          match gunbc_runner_microvm_shape() {
            MicroVmShapeResolved { shape: _ } => false
            MicroVmShapeRefused { refusal: r } =>
              match r {
                ShapeRefusedCacheAllowanceUnderivable { cause: _ } => true
                _ => false
              }
          }
        AllowanceDerived { bytes: allowance_bytes } =>
      if byte_size_count(b: need.min_bytes) + byte_size_count(b: allowance_bytes) <= remainder {
        match gunbc_runner_microvm_shape() {
          MicroVmShapeResolved { shape: s } =>
            mebibyte_count(m: s.size.memory) == remainder / (1024 * 1024)
              && hardware_thread_count_value(t: s.size.vcpu_count) == 8
          MicroVmShapeRefused { refusal: _ } => false
        }
      } else {
        match gunbc_runner_microvm_shape() {
          MicroVmShapeResolved { shape: _ } => false
          MicroVmShapeRefused { refusal: r } =>
            match r {
              ShapeRefusedWorkMemoryExceedsCellRemainder { required: n, allowance: a, remainder: m } =>
                byte_size_count(b: n) == byte_size_count(b: need.min_bytes)
                  && byte_size_count(b: a) == byte_size_count(b: allowance_bytes)
                  && byte_size_count(b: m) == remainder
              _ => false
            }
        }
      }
      }
  }
}

// THE EXPECTING-RED PROBE PINNED TO TODAY (DESIGN 4b(4); review 68307). The either-state witness
// above cannot record WHICH state production is in, so this one does: at the 2026-09-19 receipt
// and the 26 GiB cell row, the production shape refuses on the memory remainder, and the refusal
// carries the floor's stated demand, the derived allowance and the cell's remainder. The day the
// cell row or the demand receipt moves so the sum fits, this reds -- and it is then FLIPPED to
// assert resolution, citing what moved, rather than deleted. The stall it evidences is
// gunbc.guarantee_stall.runner_microvm_floor_fit_stall.
test fn the_production_shape_refuses_today_on_the_memory_remainder_with_all_three_figures() -> Bool {
  match floor_memory_requirement() {
    Absent => false
    Present { value: need } =>
      match gunbc_runner_microvm_shape() {
        MicroVmShapeResolved { shape: _ } => false
        MicroVmShapeRefused { refusal: r } =>
          match r {
            ShapeRefusedWorkMemoryExceedsCellRemainder { required: n, allowance: a, remainder: m } =>
              byte_size_count(b: n) == byte_size_count(b: need.min_bytes)
                && allowance_is(bytes: a)
                && byte_size_count(b: m) == byte_size_count(b: gunbc_runner_slot_desired().memory_max) - byte_size_count(b: gibibyte_to_byte_size(gunbc_runner_microvm_declared_realization_allowance))
                && byte_size_count(b: n) + byte_size_count(b: a) > byte_size_count(b: m)
            _ => false
          }
      }
  }
}

fn allowance_is(bytes: ByteSize) -> Bool {
  match gunbc_runner_microvm_guest_cache_allowance() {
    AllowanceDerived { bytes: b } => byte_size_count(b: b) == byte_size_count(b: bytes)
    AllowanceUnderivable { cause: _ } => false
  }
}

// THE TASK CEILING IS APPLIED WHERE THE FLOOR'S PROCESSES LIVE: the guest agent unit's own
// TasksMax= line carries the same value the shape states, both read from one cell row through
// gunbc_runner_microvm_task_ceiling. The join is on the SERIALIZED unit, so a unit that dropped the
// directive, or a shape that read a different row, reds here. What this does not establish is
// pids.max as applied inside a booted guest -- that readback is the first guest attempt's.
test fn the_task_ceiling_is_applied_as_the_guest_units_tasks_max() -> Bool {
  let unit = serialize_systemd_unit_file(file: runner_guest_agent_unit(image: gunbc_runner_guest_image, credential_device: "/dev/vdb" as NonEmptyStr))
  string_contains(s: unit, pattern: join(["TasksMax=", to_string(gunbc_runner_microvm_task_ceiling())], ""))
    && gunbc_runner_microvm_task_ceiling() == gunbc_runner_slot_desired().tasks_max
    && match shape_of(
      work: floor_like_work(),
      storage: fixture_storage(),
      cpu: fixture_entitlement(),
      envelope: fixture_cell(),
      reserve: fixture_reserve(),
    ) {
      MicroVmShapeResolved { shape: s } => s.task_ceiling == 16384
      MicroVmShapeRefused { refusal: _ } => false
    }
}

// THE ALLOWANCE IS THE LAST UNSTALLED BEAT'S RECLAIMABLE CACHE AT GIBIBYTE GRAIN, READ FROM THE
// RECEIPT, and underivable rather than zero while nothing is measured -- so a change to the receipt
// moves the allowance without anyone editing a literal, and an absent receipt cannot read as "no
// cache needed".
test fn the_guest_cache_allowance_derives_from_the_receipts_last_unstalled_beat() -> Bool {
  match gunbc_floor_held_set_standing() {
    HeldSetUnmeasured { instrument: _ } =>
      match gunbc_runner_microvm_guest_cache_allowance() {
        AllowanceUnderivable { cause: _ } => true
        AllowanceDerived { bytes: _ } => false
      }
    HeldSetReceiptUnrepresentable { cause: _ } => false
    HeldSetMeasured { receipt: r, peak: _ } =>
      match receipt_last_unstalled_beat(r: r) {
        Absent => false
        Present { value: b } =>
          match beat_reclaimable_cache(b: b) {
            MeasureSubtrahendExceedsMinuend => false
            MeasureDifference { value: cache } =>
              match round_up_to_gibibyte_grain(bytes: cache) {
                GrainUnrepresentable { cause: _ } => false
                GrainRounded { bytes: g } => allowance_is(bytes: g) && events_per_minute_count(r: b.stall) == 0
              }
          }
      }
  }
}

// THE RED FOR THE TYPED CACHE SUBTRACTION, CARRIED THROUGH TO THE SHAPE: a supplied allowance that
// refused (as a torn beat with shmem = file + 1 would make it) refuses the shape on its own arm,
// after the reserve is judged and before any remainder is compared -- a zero here would have
// admitted a guest with no cache and reported it as a fit.
test fn a_torn_beat_with_more_shmem_than_file_refuses_the_allowance_and_the_shape() -> Bool {
  match runner_microvm_shape(
    work: floor_like_work(),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
    cache_allowance: AllowanceUnderivable { cause: "fixture: shmem exceeds file" },
    task_ceiling: 16384,
    workspace: runner_microvm_workspace_grant,
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedCacheAllowanceUnderivable { cause: c } => cause_mentions(cause: c, needle: "fixture")
        _ => false
      }
  }
}

// THE FLEET VM CONFIG CARRIES THE SHAPE'S ANSWER AND NOT A DEFAULT: unresolved exactly when the
// shape refuses, with the refusal's text, and resolved exactly when it resolves.
test fn the_production_vm_config_mirrors_the_shape_resolution() -> Bool {
  let config = gunbc_runner_microvm_vm_config(
    rootfs_path: "/var/lib/gunbc/cell/rootfs.ext4",
    jit_config_path: "/var/lib/gunbc/cell/jitcfg.ext4",
    kernel_path: "/var/lib/gunbc/cell/vmlinux",
    net: GuestNetworkAbsent { cause: "this control judges sizing, not the per-slot tap" },
  )
  match gunbc_runner_microvm_shape() {
    MicroVmShapeResolved { shape: s } =>
      match config {
        MicroVmConfigResolved { config: c } => c.machine_config.mem_size_mib == mebibyte_count(m: s.size.memory)
        MicroVmConfigUnresolved { cause: _ } => false
      }
    MicroVmShapeRefused { refusal: r } =>
      match config {
        MicroVmConfigResolved { config: _ } => false
        MicroVmConfigUnresolved { cause: c } => c == runner_microvm_shape_refusal_text(r: r)
      }
  }
}

// THE DECLARED GUEST PLUS ITS ALLOWANCE SITS UNDER THE CELL'S THROTTLE POINT, not merely under its
// ceiling. MemoryMax is the hard limit but MemoryHigh is where reclaim begins, so a sum that clears
// the ceiling and not the throttle point puts the cell under reclaim pressure at its declared size
// rather than only when something goes wrong. It does not follow that such a guest is throttled
// from its first instant -- reclaim responds to actual usage, and neither the guest nor the VMM
// touches its whole allocation on arrival.
test fn the_declared_guest_plus_allowance_sits_under_the_cell_throttle() -> Bool {
  let guest = byte_size_count(b: mebibyte_to_byte_size(m: gunbc_runner_microvm_declared_size.memory))
  let allowance = byte_size_count(b: gibibyte_to_byte_size(gunbc_runner_microvm_declared_realization_allowance))
  guest + allowance <= byte_size_count(b: gunbc_runner_slot_desired().memory_high)
}

// THE CELL'S ENTITLEMENT IS THE SLOT ROW'S QUOTA SEEN FROM THE GUEST, ARM FOR ARM. A resolved
// quota is an Absolute entitlement of the same thread count; the unbounded quota (the 2026-09-19
// policy, and the production row) is RelativeOnly with a cause that names that policy. If either
// arm ever maps to the other, the slice quota and the guest-sizing entitlement have forked.
test fn the_cell_entitlement_is_the_slot_quota_arm_for_arm() -> Bool {
  match gunbc_runner_slot_desired().cpu_quota {
    CpuQuotaResolved { threads: want } =>
      match gunbc_runner_microvm_cell_cpu_entitlement() {
        CpuEntitlementRelativeOnly { cause: _ } => false
        CpuEntitlementAbsolute { threads: got } =>
          hardware_thread_count_value(t: want) == hardware_thread_count_value(t: got)
      }
    SlotCpuQuotaUnbounded =>
      match gunbc_runner_microvm_cell_cpu_entitlement() {
        CpuEntitlementAbsolute { threads: _ } => false
        CpuEntitlementRelativeOnly { cause: c } => cause_mentions(cause: c, needle: "2026-09-19")
      }
  }
}

// THE SIZING AXIS, WHICH REMAINS UNRESOLVED ON BOTH HALVES. Until this change these witnesses
// asserted that the fleet's VM carries the cell's resource envelope on both axes, and that the
// admission admits it. That claim was FALSE, and false in the direction that looks correct: the
// derived guest RAM was the cell's entire MemoryMax, leaving nothing inside the same cell for the
// Firecracker VMM process itself. The witnesses were green over a guest that would OOM the slice
// it was supposed to be bounded by. They are replaced, not repaired, because the thing they
// demonstrated is not true.
//
// WHAT IS DEMONSTRATED NOW IS SMALLER AND IT IS TRUE: that an underivable guest size REFUSES, and
// that the refusal names WHICH fact is missing rather than refusing uniformly. That distinction is
// invisible from outside unless both arms execute, which is what the pair below is for.

// THE WITNESS THAT STOOD HERE WAS DELETED, NOT REPAIRED, AND THE DELETION IS THE POINT.
//
// no_fleet_constructed_vm_is_admissible_while_the_footprint_is_unmodeled asserted that the
// fleet-constructed VM is not admitted while sizing refuses. Its unresolved arm returned TRUE, so
// it returned true WITHOUT EVER REACHING runner_microvm_admission -- the fleet constructor derives
// the size, so an unresolved sizing makes the config unresolved, and the witness took that arm
// every time. It could not fail. It passed the floor and two approvals in exactly that state,
// standing in a PR body as the replacement for five witnesses withdrawn for demonstrating a FALSE
// claim, which is the worst possible place for one that demonstrates NOTHING.
//
// A witness whose refusal arm returns true is not a control; it is a restatement of the refusal.
//
// It is deleted rather than repaired because the asymmetry decides it: a MISSING witness costs
// nothing while it waits for the redesign, while a GREEN one that cannot fail is active
// misinformation for as long as it exists and gets cited as coverage (DESIGN 4b). Repairing it
// here would be work against a block being rewritten wholesale; deleting it removes a false claim
// and forecloses nothing, because the redesign authors the honest form regardless.
//
// THE HONEST FORM, for whoever writes it: assert that the resolution IS unresolved AND that its
// cause NAMES the missing footprint. That has an authorable red -- a cause that stops naming the
// footprint fails it -- where "an unresolved config cannot be admitted" has none.

// ── the shape derivation, driven with supplied inputs on both polarities ───────────────────────
//
// THE FIXTURE CELL IS 28 GiB WITH A 1 GiB RESERVE, so the remainder (27 GiB) holds the floor's real
// demand and the accept arm executes against the PRODUCTION Work and storage figures -- the
// inhabitance claim DESIGN 3 asks for. Every refusal control below moves exactly one input off
// this fixture and expects exactly one arm, so an implementation that refused uniformly, or that
// took a later arm before an earlier one, reds on the arm name rather than on a Bool.
fn fixture_cell() -> CellMemoryEnvelope {
  CellMemoryEnvelope { bytes: gibibyte_to_byte_size(gibibyte(count: 28)) }
}

fn fixture_reserve() -> RealizationReserve {
  ReserveDeclared { bytes: gibibyte_to_byte_size(gibibyte(count: 1)) }
}

fn fixture_entitlement() -> CellCpuEntitlement {
  CpuEntitlementAbsolute { threads: hardware_thread_count(count: 10) }
}

fn work_with(threads: Int, envelope: ResourceEnvelope) -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: threads) }, envelope: envelope },
    capabilities: "gunbc.capabilities.linux-rust-toolchain",
    trust_domain: "gunbc.trust.internal-fleet",
    isolation: IsolationProfile { guarantees: [] },
  }
}

// A WORK SHAPED LIKE THE FLOOR'S -- eight threads, a 25 GiB memory minimum -- SUPPLIED rather than
// read from gunbc.fabric_witness_run, because the production Work states memory only once the
// memory.stat receipt stands (gunbc.floor_demand) and these controls are about the fold's
// arms, not about that standing. The production route is judged by
// the_production_shape_answers_according_to_the_floor_demand_standing.
// THE FLOOR'S STORAGE DEMAND AS A SUPPLIED REQUIREMENT: two gibibytes, the figure
// gunbc.floor_demand states today, so these controls judge the fold's arms and not the demand's
// representability (which floor_demand_witness_test judges).
fn fixture_storage() -> StorageRequirement {
  StorageRequirement { min_bytes: gibibyte_to_byte_size(gibibyte(count: 2)), persistence: Ephemeral }
}

fn floor_like_work() -> ExecutionRequirements {
  work_with(threads: 8, envelope: memory_envelope(min_bytes: gibibyte_to_byte_size(gibibyte(count: 25))))
}

fn shape_of(
  work: ExecutionRequirements,
  storage: StorageRequirement,
  cpu: CellCpuEntitlement,
  envelope: CellMemoryEnvelope,
  reserve: RealizationReserve,
) -> RunnerMicroVmShapeResolution {
  runner_microvm_shape(
    work: work,
    storage: storage,
    cpu: cpu,
    envelope: envelope,
    reserve: reserve,
    cache_allowance: AllowanceDerived { bytes: gibibyte_to_byte_size(gibibyte(count: 1)) },
    task_ceiling: 16384,
    workspace: runner_microvm_workspace_grant,
  )
}

// THE ACCEPT ARM: eight vCPUs from the Work's thread row, 27 GiB of guest
// memory as the whole remainder in MiB, the workspace grant, and the cell's task row.
test fn the_floor_work_resolves_to_a_shape_inside_a_cell_that_holds_it() -> Bool {
  match shape_of(
    work: floor_like_work(),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeRefused { refusal: _ } => false
    MicroVmShapeResolved { shape: s } =>
      hardware_thread_count_value(t: s.size.vcpu_count) == 8
        && mebibyte_count(m: s.size.memory) == 27 * 1024
        && mebibyte_count(m: s.workspace) == mebibyte_count(m: runner_microvm_workspace_grant)
        && s.task_ceiling == 16384
  }
}

// THE DERIVED GUEST FITS BY CONSTRUCTION: floor division to MiB never rounds the remainder up, so
// the existing containment law admits it with the same reserve and envelope it was derived from.
test fn the_derived_guest_satisfies_the_containment_law_it_was_derived_under() -> Bool {
  match shape_of(
    work: floor_like_work(),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeRefused { refusal: _ } => false
    MicroVmShapeResolved { shape: s } =>
      match guest_memory_fits(
        guest: GuestMemoryRequest { bytes: mebibyte_to_byte_size(m: s.size.memory) },
        reserve: fixture_reserve(),
        envelope: fixture_cell(),
      ) {
        GuestFitsWithinCell => true
        GuestExceedsCell { detail: _ } => false
        MemoryFitUnresolved { cause: _ } => false
      }
  }
}

// A RELATIVE-ONLY ENTITLEMENT BOUNDS NOTHING ON THE CELL'S CPU AXIS, SO THE WORK'S THREADS STAND
// -- WITHIN THE VMM'S OWN RANGE. Under the 2026-09-19 no-ceiling ruling this is the production
// arm: the slot carries CPUWeight and no ceiling, and a relative share can refuse no count. What
// still refuses is the pinned Firecracker release's range, which no cell policy lifts: 8 and 32
// resolve, 33 is the boundary refusal and 64 refuses, each carrying the requested count and the
// range. The count is never clamped to the maximum -- that would be a false admission.
fn relative_only_shape(threads: Int) -> RunnerMicroVmShapeResolution {
  shape_of(
    work: work_with(threads: threads, envelope: memory_envelope(min_bytes: gibibyte_to_byte_size(gibibyte(count: 8)))),
    storage: fixture_storage(),
    cpu: CpuEntitlementRelativeOnly { cause: "fixture: relative share only" },
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  )
}

fn relative_only_resolves_with(threads: Int) -> Bool {
  match relative_only_shape(threads: threads) {
    MicroVmShapeRefused { refusal: _ } => false
    MicroVmShapeResolved { shape: s } => hardware_thread_count_value(t: s.size.vcpu_count) == threads
  }
}

fn relative_only_refuses_unsupported(threads: Int) -> Bool {
  match relative_only_shape(threads: threads) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedVcpuCountUnsupported { requested: q, minimum: lo, maximum: hi } =>
          hardware_thread_count_value(t: q) == threads && hardware_thread_count_value(t: lo) == 1 && hardware_thread_count_value(t: hi) == 32
        _ => false
      }
  }
}

test fn a_relative_only_entitlement_admits_the_works_threads_within_the_vmm_range() -> Bool {
  relative_only_resolves_with(threads: 8) && relative_only_resolves_with(threads: 32)
}

test fn a_thread_count_past_the_pinned_firecracker_range_refuses_the_shape() -> Bool {
  relative_only_refuses_unsupported(threads: 33) && relative_only_refuses_unsupported(threads: 64)
}

test fn a_work_wanting_more_threads_than_the_cell_entitles_is_refused_with_both_counts() -> Bool {
  match shape_of(
    work: work_with(threads: 12, envelope: memory_envelope(min_bytes: gibibyte_to_byte_size(gibibyte(count: 8)))),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedWorkThreadsExceedEntitlement { required: n, entitled: e } =>
          hardware_thread_count_value(t: n) == 12 && hardware_thread_count_value(t: e) == 10
        _ => false
      }
  }
}

// A WORK THAT STATES NO MEMORY IS REFUSED, WHICH IS WHAT MAKES STATING THE FLOOR'S DEMAND
// LOAD-BEARING: the envelope field gunbc.fabric_witness_run filled on 2026-09-19 is the one this
// arm reads, so removing it takes the production shape to this refusal rather than to a guest
// sized against nothing.
test fn a_work_with_an_unstated_memory_demand_cannot_be_given_a_shape() -> Bool {
  match shape_of(
    work: work_with(threads: 8, envelope: unstated_envelope()),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedWorkMemoryUnstated => true
        _ => false
      }
  }
}

test fn a_work_demanding_more_than_the_cell_remainder_is_refused_with_all_three_figures() -> Bool {
  match shape_of(
    work: work_with(threads: 8, envelope: memory_envelope(min_bytes: gibibyte_to_byte_size(gibibyte(count: 28)))),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedWorkMemoryExceedsCellRemainder { required: n, allowance: a, remainder: m } =>
          byte_size_count(b: n) == byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 28)))
            && byte_size_count(b: a) == byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 1)))
            && byte_size_count(b: m) == byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 27)))
        _ => false
      }
  }
}

// THE BOUNDARY, WITH THE ALLOWANCE COUNTED: a demand of 26 GiB plus the fixture's 1 GiB allowance
// equals the 27 GiB remainder and is admitted; 27 GiB plus the allowance is one gibibyte over and
// refuses. A fold that forgot the allowance would admit the second, and one that used a strict
// comparison would refuse the first.
test fn a_work_whose_demand_plus_allowance_exactly_fills_the_remainder_is_admitted_and_one_over_is_not() -> Bool {
  let exact = match shape_of(
    work: work_with(threads: 8, envelope: memory_envelope(min_bytes: gibibyte_to_byte_size(gibibyte(count: 26)))),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeRefused { refusal: _ } => false
    MicroVmShapeResolved { shape: s } => mebibyte_count(m: s.size.memory) == 27 * 1024
  }
  let over = match shape_of(
    work: work_with(threads: 8, envelope: memory_envelope(min_bytes: gibibyte_to_byte_size(gibibyte(count: 27)))),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedWorkMemoryExceedsCellRemainder { required: _, allowance: _, remainder: _ } => true
        _ => false
      }
  }
  exact && over
}


test fn a_reserve_larger_than_the_cell_refuses_the_shape_before_any_remainder() -> Bool {
  match shape_of(
    work: floor_like_work(),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: CellMemoryEnvelope { bytes: byte_size(count: 1) },
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedReserveExceedsCell { reserve: _, envelope: e } => byte_size_count(b: e) == 1
        _ => false
      }
  }
}

test fn an_unmodeled_reserve_refuses_the_shape_naming_its_cause() -> Bool {
  match shape_of(
    work: floor_like_work(),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: ReserveUnmodeled { cause: "fixture: no footprint" },
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedReserveUnmodeled { cause: c } => cause_mentions(cause: c, needle: "fixture")
        _ => false
      }
  }
}

test fn a_storage_demand_the_workspace_grant_does_not_hold_is_refused() -> Bool {
  match shape_of(
    work: floor_like_work(),
    storage: StorageRequirement { min_bytes: gibibyte_to_byte_size(gibibyte(count: 5)), persistence: Ephemeral },
    cpu: fixture_entitlement(),
    envelope: fixture_cell(),
    reserve: fixture_reserve(),
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedWorkStorageExceedsWorkspace { required: n, workspace: w } =>
          byte_size_count(b: n) == byte_size_count(b: gibibyte_to_byte_size(gibibyte(count: 5)))
            && byte_size_count(b: w) == byte_size_count(b: mebibyte_to_byte_size(m: runner_microvm_workspace_grant))
        _ => false
      }
  }
}

// THE FLOOR'S OWN STORAGE DEMAND FITS THE GRANT, stated as a control rather than assumed: the
// measured components in gunbc.floor_demand round to 2 GiB against a 4 GiB workspace.
test fn the_floor_storage_demand_fits_the_workspace_grant() -> Bool {
  match floor_storage_demand() {
    StorageDemandUnrepresentable { cause: _ } => false
    StorageDemandStated { requirement: r } =>
      byte_size_count(b: r.min_bytes) <= byte_size_count(b: mebibyte_to_byte_size(m: runner_microvm_workspace_grant))
  }
}

// THE RED FOR THE FIT ARITHMETIC (review by side-chat at f35ce9db): a demand at the representable
// bound with a one-byte allowance against a remainder at the bound. A sum would wrap negative and
// admit; the subtraction form refuses with the three figures. The cell is the bound plus the 1 GiB
// fixture reserve less one... which is itself unrepresentable, so the control supplies the
// remainder directly through a zero reserve: envelope = int_inclusive_max, reserve = 0.
test fn a_demand_at_the_representable_bound_with_a_one_byte_allowance_refuses_rather_than_wrapping() -> Bool {
  match runner_microvm_shape(
    work: work_with(threads: 8, envelope: memory_envelope(min_bytes: byte_size(int_inclusive_max()))),
    storage: fixture_storage(),
    cpu: fixture_entitlement(),
    envelope: CellMemoryEnvelope { bytes: byte_size(int_inclusive_max()) },
    reserve: ReserveDeclared { bytes: byte_size(0) },
    cache_allowance: AllowanceDerived { bytes: byte_size(1) },
    task_ceiling: 16384,
    workspace: runner_microvm_workspace_grant,
  ) {
    MicroVmShapeResolved { shape: _ } => false
    MicroVmShapeRefused { refusal: r } =>
      match r {
        ShapeRefusedWorkMemoryExceedsCellRemainder { required: n, allowance: a, remainder: m } =>
          byte_size_count(b: n) == int_inclusive_max() && byte_size_count(b: a) == 1 && byte_size_count(b: m) == int_inclusive_max()
        _ => false
      }
  }
}

// A GUEST WITH NO INTERFACE IS EXPRESSIBLE, AND A GUEST WITH ONE STILL CARRIES IT. The boot smoke
// has no tap because the per-slot network is a later slice; before this coproduct the only way to
// express that guest was to name a device that does not exist. Both arms are driven so the empty
// list is a MODELED absence rather than a builder that quietly dropped an interface.
test fn a_guest_without_a_tap_carries_no_interface_and_one_with_a_tap_does() -> Bool {
  let without = runner_microvm_vm_config(
    rootfs_path: "/var/tmp/fcmvp/rootfs.ext4",
    jit_config_path: "/var/tmp/fcmvp/jitcfg.ext4",
    kernel_path: "/var/tmp/fcmvp/vmlinux",
    net: GuestNetworkAbsent { cause: "the boot smoke has no per-slot tap; this guest cannot register" },
    size: gunbc_runner_microvm_declared_size,
    transport: gunbc_runner_jit_transport,
  )
  count(without.network_interfaces) == 0
    && count(mvp_sized_config().network_interfaces) == 1
}

// THE CORE COUNT IS A POLICY AND IT IS POSITIVE. cores_per_slot no longer resolves or refuses --
// it is authored (gunbc_runner_cores_per_slot_policy) -- so the only thing left to keep true is
// that the policy is not zero, which would admit every core against no slot at all.
test fn the_cell_core_count_is_a_positive_policy() -> Bool {
  hardware_thread_count_value(t: gunbc_runner_cores_per_slot()) > 0
}

// THE CELL ADMISSION EVERY OTHER CONTROL HERE RUNS UNDER, OBTAINED THROUGH THE REAL JOIN rather than
// constructed: a store holding a settled Ready at generation 0, asked for allocation generation 1.
fn witness_store(cell: String, readiness_ready: Bool) -> CellReadinessStoreRead {
  StoreRead {
    ownership: StoreRootOwned,
    records: [
      CellSettled {
        cell: cell as CellId,
        generation: 0,
        readiness: if readiness_ready {
          CellReady { cell: cell as CellId }
        } else {
          CellQuarantined { cell: cell as CellId, unproven: [FactNotObserved { fact: CgroupEmpty }] }
        },
      },
    ],
  }
}

fn witness_admitted_cell() -> CellIncarnationAdmission {
  cell_incarnation_admission(store: witness_store(cell: "srv1-01", readiness_ready: true), cell: "srv1-01" as CellId, allocation_generation: 1)
}

// A QUARANTINED CELL REFUSES AN OTHERWISE ADMISSIBLE VM, AND REFUSES WITH THE CELL'S CAUSE. The
// VM, intent and reserve are exactly those of the admitted controls, so the only thing this varies
// is the readiness the admission consumes -- the frontier #11662 declared here, now closed.
test fn a_quarantined_cell_refuses_an_otherwise_admissible_microvm() -> Bool {
  let quarantined = runner_microvm_admission(
    cell: cell_incarnation_admission(store: witness_store(cell: "srv1-01", readiness_ready: false), cell: "srv1-01" as CellId, allocation_generation: 1),
    topology: VmmUnderLifecycleController,
    intent: repaired_lifecycle_intent,
    main_exits_when_incarnation_ends: true,
    transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
    config: mvp_sized_config(),
    reserve: witness_reserve,
  )
  let refused_with_cause = match quarantined {
    RunnerMicroVmRefusedCellWithdrawn { cell: _, withdrawal: CellQuarantinedAt { generation: 0, unproven: _ } } => true
    _ => false
  }
  refused_with_cause
    && admission_is_admitted(a: runner_microvm_admission(
      cell: witness_admitted_cell(),
      topology: VmmUnderLifecycleController,
      intent: repaired_lifecycle_intent,
      main_exits_when_incarnation_ends: true,
      transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
      config: mvp_sized_config(),
      reserve: witness_reserve,
    ))
}

// THE THREE NON-ADMITTING ARMS STAY DISTINCT THROUGH THE ADMISSION (review 68119): an unreadable
// store is a HOST refusal, an in-flight record is RECOVERY REQUIRED, and neither is the quarantine arm
// above. A collapse into one refusal would still pass the quarantine witness and fail this one.
test fn host_withdrawal_and_recovery_required_are_not_a_cell_refusal() -> Bool {
  let host = match runner_microvm_admission(
    cell: cell_incarnation_admission(store: StoreUnreadable { reason: "EACCES" as NonEmptyStr }, cell: "srv1-01" as CellId, allocation_generation: 1),
    topology: VmmUnderLifecycleController,
    intent: repaired_lifecycle_intent,
    main_exits_when_incarnation_ends: true,
    transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
    config: mvp_sized_config(),
    reserve: witness_reserve,
  ) {
    RunnerMicroVmRefusedHostWithdrawn { withdrawal: HostStoreUnreadable { reason: _ } } => true
    _ => false
  }
  let lost_slot = RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
  let lost_cell = runner_slot_instance_name(slot: lost_slot) as CellId
  let recovery = match microvm_attempt(slot: lost_slot, attempt_id: "lost-0") {
    MicroVmAttemptAccepted { attempt: lost } =>
      match runner_microvm_admission(
        cell: cell_incarnation_admission(
          store: StoreRead {
            ownership: StoreRootOwned,
            records: [CellAttemptInFlight {
              cell: lost_cell,
              generation: 0,
              attempt: InFlightAttempt { attempt: lost, invocation_id: "inv-lost" as NonEmptyStr, jit_registration_id: "reg-lost" as NonEmptyStr },
            }],
          },
          cell: lost_cell,
          allocation_generation: 1,
        ),
        topology: VmmUnderLifecycleController,
        intent: repaired_lifecycle_intent,
        main_exits_when_incarnation_ends: true,
        transport: JitConfigOnReadOnlyDrive { drive_id: "jitcfg" },
        config: mvp_sized_config(),
        reserve: witness_reserve,
      ) {
        RunnerMicroVmRecoveryRequired { bound: _ } => true
        _ => false
      }
    _ => false
  }
  host && recovery
}
