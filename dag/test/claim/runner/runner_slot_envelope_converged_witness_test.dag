module test.claim.runner.runner_slot_envelope_converged_witness_test

import std.types { Bool, String, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.measure { byte_size }
import gunbc.cutover_receipt {
  CutoverReceipt, ByteReading, SlotSwapMax, ReceiptUnrecorded, ReceiptRecorded,
  cutover_receipt_is_recorded, cutover_receipt_is_unrecorded_or_names_its_run,
  cutover_receipt_swap_free, fleet_slot_envelope_readback
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Green over supplied values. The readback is `systemctl show -p MemoryMax,MemoryHigh,MemorySwapMax`
// per EXISTING slot unit per host; the live row stays ReceiptUnrecorded until a converge run is
// named, and roadmap readiness reads the node unaccepted until then.

test fn the_live_readback_is_unrecorded_or_names_its_run() -> Bool {
  cutover_receipt_is_unrecorded_or_names_its_run(r: fleet_slot_envelope_readback)
}

data swapping_readback: CutoverReceipt = ReceiptRecorded {
  run_ids: ["converge-1"], host: "h",
  readings: [ByteReading { kind: SlotSwapMax, bytes: byte_size(count: 1) }]
}

data swap_free_readback: CutoverReceipt = ReceiptRecorded {
  run_ids: ["converge-1"], host: "h",
  readings: [ByteReading { kind: SlotSwapMax, bytes: byte_size(count: 0) }]
}

// CONTROL: a readback whose swap cap is not zero refuses the host.
test fn a_readback_with_swap_refuses_the_host() -> Bool {
  !cutover_receipt_swap_free(r: swapping_readback) && cutover_receipt_swap_free(r: swap_free_readback)
    && !cutover_receipt_swap_free(r: ReceiptUnrecorded)
}

// CONTROL: an unrecorded readback is not a host that matches its row.
test fn every_fleet_host_readback_matches_the_row() -> Bool {
  !cutover_receipt_is_recorded(r: ReceiptUnrecorded)
}
