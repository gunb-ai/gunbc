module test.claim.runner.srv14_runner_capacity_witness

// BUTCH (srv14) JOINS RUNNER CAPACITY ON MEASURED FACTS ALONE (B3b, continued past the 2026-11-24 discharge).
// Each claim below pins a fact the B3a fold spends for butch and NOTHING ELSE -- no hand width, no borrowed
// bound, no session charge. Butch USED to join while it was ALREADY SERVING, so its fixed-overhead bound had to
// EXCLUDE the resident bytes its serving engines held -- the same money B4a then reserved as each engine's
// cgroup MemoryMax (a double-count). That era CLOSED on 2026-11-24: the operator hand-retired
// strata-pool@a/@b and strata-expert-lock (boot states
// gunbc.serving.serving_reservation::srv14_serving_unit_boot_states), the quiescent peer re-read landed (run
// 45321352046: MemTotal 262937528 kB, MemAvailable 259550704 kB), and the operator ruled the 192 GiB serving
// reservation released verbatim ("yes you can retire the 192gib serving reservation", gunbc.design_ruling::
// srv14_serving_memory_charge_retirement_operator_approved_2026_11_24). With
// srv14_strata_engine_residency_at_read EMPTY, the overhead IS the whole post-retirement quiescent resident,
// 3_468_107_776 bytes, and the fourth claim REDS the OPPOSITE direction now: re-introducing the retired
// engines' residency would saturate the bound to 0 and hand the pool RAM the host still uses.
//
// WHY THESE AND NOT "the width is N": the width is derived by gunbc.runner.runner_slot_allocation
// gunbc_runner_committed_width over every axes, and butch's committed width is the ruled zero
// (gunbc.test.claim.runner.runner_ci_width_ruled_zero_witness). The B4b era that pinned the two engine
// ceilings -- read UNCAPPED at 2026-11-12T03:29:30Z, then capped by hand drop-in 60-memory-cap.conf (operator
// decision msg_5b61137b) at MemoryMax=96G -- retired WITH the engines: gunbc.serving.serving_host_memory no
// longer carries butch_a/b_strata_engine_memory at all. Pinning a width in THIS witness would be a hand width
// wearing a derived name. What must not move regardless: butch's own MemTotal, butch's overhead pinned to the
// post-retirement pair, the engine-residency subtraction staying EMPTY (the RED), no session charge (the
// operator ruled butch CI-only), and butch standing in the fleet's own offer catalog.

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Optional, Present, Absent }
import std.measure { byte_size, byte_size_count }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv14, operator_host_srv1 }
import gunbc.host.host_memory_carrier { HostUsableRam, HostUsableRamMeasured, HostFixedOverhead, HostFixedOverheadMeasured }
import gunbc.host.host_memory_observation {
  gunbc_ci_host_usable_ram_for, gunbc_ci_host_fixed_overhead_for,
  srv14_memavailable_quiescent_read, srv14_strata_engine_residency_at_read,
  host_overhead_upper_bound_excluding_serving, HostMemAvailableQuiescentRead, ServingEngineCgroupResidency,
}
import gunbc.session_residency { SessionResidency, NoInteractiveSessions, host_session_residency }
import gunbc.session_reservation_policy { SessionReservationBytesResolution, ReservationBytesNotApplicable, session_reservation_bytes }
import gunbc.ci.ci_fleet { fleet_compute_offer_for, ComputeOffer }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn butch_usable_ram_bytes() -> Int {
  match gunbc_ci_host_usable_ram_for(host: operator_host_srv14) {
    HostUsableRamMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    _ => 0
  }
}

fn butch_fixed_overhead_bytes() -> Int {
  match gunbc_ci_host_fixed_overhead_for(host: operator_host_srv14) {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    _ => 0
  }
}

// BUTCH'S USABLE RAM IS ITS OWN KERNEL'S ANSWER, not B1's 256 GiB inventory nominal: 262937528 kB,
// read from /proc/meminfo over SSH by the B3b bring-up. An unmeasured host yields 0 here (the refused
// arms), which this claim separates from the measurement on purpose.
test fn butch_usable_ram_is_its_own_memtotal_read() -> Bool {
  butch_usable_ram_bytes() == 269248028672
}

// BUTCH'S OVERHEAD IS THE WHOLE QUIESCENT RESIDENT NOW: 3468107776 bytes (~3.23 GiB) = the post-retirement
// same-instant pair (MemTotal 262937528 kB minus MemAvailable 259550704 kB, peer read run 45321352046), with
// NOTHING subtracted -- srv14_strata_engine_residency_at_read has been empty since the engines were
// hand-retired. It is a measurement, not an allowance.
test fn butch_fixed_overhead_is_base_residency_measured() -> Bool {
  butch_fixed_overhead_bytes() == 3468107776
}

// THE LOAD-BEARING RED, RE-TURNED BY THE RETIREMENT. The committed shape must stay 3468107776: the residency
// list is EMPTY, so the fold's engine subtraction has nothing to take off -- with_engines and without_engines
// are the SAME call now, and if anyone restores a row in srv14_strata_engine_residency_at_read the first arm
// moves by itself. Handing the fold the retired engines' 2026-11-12 anon+shmem (2 x 40400416768 bytes) against
// a resident of only 3468107776 bytes SATURATES the bound to 0 -- the pool would be offered every byte of RAM
// the host is using. That saturation is also why an over-stated engine sum still yields 0 rather than wrapping:
// a read that contradicts itself cannot mint negative overhead.
test fn butch_retired_engines_must_stay_out_of_the_subtraction_RED() -> Bool {
  let with_engines = host_overhead_upper_bound_excluding_serving(
    read: srv14_memavailable_quiescent_read,
    engines: srv14_strata_engine_residency_at_read,
  )
  let without_engines = host_overhead_upper_bound_excluding_serving(
    read: srv14_memavailable_quiescent_read,
    engines: [] as List<ServingEngineCgroupResidency>,
  )
  let re_added_engines = host_overhead_upper_bound_excluding_serving(
    read: srv14_memavailable_quiescent_read,
    engines: [
      ServingEngineCgroupResidency { unit: "strata-pool@a.service", anon: byte_size(20200208384), shmem: byte_size(20200208384) },
      ServingEngineCgroupResidency { unit: "strata-pool@b.service", anon: byte_size(20200208384), shmem: byte_size(20200208384) },
    ],
  )
  let overstated_engines = [
    ServingEngineCgroupResidency { unit: "strata-pool@a.service", anon: byte_size(40000000000), shmem: byte_size(40000000000) },
  ]
  let contradicted = host_overhead_upper_bound_excluding_serving(
    read: srv14_memavailable_quiescent_read,
    engines: overstated_engines,
  )
  srv14_strata_engine_residency_at_read.length() == 0
    && byte_size_count(b: with_engines) == 3468107776
    && byte_size_count(b: without_engines) == 3468107776
    && byte_size_count(b: re_added_engines) == 0
    && byte_size_count(b: contradicted) == 0
}

// BUTCH IS CI-ONLY BY OPERATOR RULING, and the ruling is carried as declared-absent residency: the
// session axis charges NOTHING (NotApplicable), rather than borrowing some session bound. srv1 keeps
// charging its sessions (the negative control: an interactive host does NOT come out NotApplicable).
test fn butch_is_ci_only_and_charges_no_session_reservation() -> Bool {
  match host_session_residency(host: operator_host_srv14) {
    NoInteractiveSessions =>
      match session_reservation_bytes(host: operator_host_srv14) {
        ReservationBytesNotApplicable =>
          match session_reservation_bytes(host: operator_host_srv1) {
            ReservationBytesNotApplicable => false
            _ => true
          }
        _ => false
      }
    _ => false
  }
}

// BUTCH STANDS IN THE FLEET'S OWN OFFER CATALOG (the B3a fold iterates fleet_intent_offers, which
// filters the catalog by ci_runner enrollment): no offer, no fold entry, no capacity -- and the offer
// carries no hand slot cap, so the only width butch can ever have is the derived one.
test fn butch_offer_is_in_the_fleet_catalog() -> Bool {
  match fleet_compute_offer_for(host: operator_host_srv14) {
    Present { value: o } =>
      (o.provider as String) == "gunbc-operator-srv14"
        && (o.supply.physical.identity as String) == (operator_host_srv14 as String)
    Absent => false
  }
}
