module test.claim.runner.runner_slot_cap_observe_probe_witness

// STAGED PROBE for test.claim.runner.runner_slot_cap_observe_route_witness: its 12 controls all
// return a SILENT Bool false (no runtime error, no refusal line -- witness eval answered in 248ms),
// which means a body is short-circuiting through an early Absent branch. Each claim here asks ONE
// stage of the same pipeline and answers one bit; the stages are the witness's own helper chain, so
// the first false names the stage that dies:
//   admitted? -> featured unit? -> context seals? -> frame run returns?
//     -> ledger non-empty? -> grep leg fires? -> standings present? -> standing AtDesired?
// The end-cause claims name which CapRunEnded branch fired, by comparing the cause string against
// the two KNOWN causes (subject, context) -- elimination pins the stage even when a claim's polarity
// is ambiguous. This is dispatch scaffolding for one run; it is NOT a fold claim and its claims are
// named probe_* so they are never mistaken for the controls.

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.algebra { string_contains }
import std.measure { Second, byte_size_count, second }
import std.materialization_ladder { Frame, SharedStateFrame }
import std.effect_grant { Read, Write, ServiceOpTree, NamespacePosition, ModeledRealization, LifecycleByConstruction, Grant, Envelope }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.operation_argv { InputTextList }
import v2.std.operation_realization {
  OperationRealization, OperationBinding, OperationStep, OperationObserved, OperationCall,
  ShellObserved, DispatchRecord, virtual_clock_origin,
}
import v2.std.witness_evaluation {
  WitnessEvaluationFrame, WitnessReturned, WitnessRefused, WitnessInterrupted,
  evaluate_in_witness_frame, witness_diagnostic_rendered_reason,
}
import extdeps.transports.shell { ShellExchangeObservation, ShellProcessExited, ShellProcessSpawnRefused }
import gunbc.host_command_model { ssh_session_exec_portable_words_operation }
import gunbc.fleet.fleet_known_hosts_anchor { FleetSshExecutionContext }
import product.host_identity { HostIdentity }
import gunbc.runner.runner_host_file_converge {
  RunnerHostFileSubject, RunnerHostFileSubjectAdmitted, RunnerHostFileSubjectRefused,
  runner_host_file_subject,
  RunnerHostPrivilegeStanding, AdministratorPrivilegeAvailable,
  RunnerSlotPopulation, SlotPopulationObserved, RunnerSlotUnitResult, SlotTeardownEffective,
  SlotReloadNotPending,
  RunnerHostCapPhase, CapPhaseObserved,
  runner_host_cap_phase_settled, runner_host_cap_phase_text,
  run_runner_host_cap_phase,
  RunnerHostFilesObserveOnly,
}
import gunbc.runner.runner_slot_cap_converge {
  SlotCapsAtDesired,
  slot_cap_show_properties, slot_cap_cgroup_files,
}
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_desired }
import gunbc.runner.runner_slot_retirement { retirement_cgroup_unescaped_root }
import extdeps.systemd.systemctl { systemctl_show_properties_argv }
import extdeps.tools.grep { grep_nonempty_lines_in_tree_argv }
import extdeps.linux.cgroup_v2 { cgroup_v2_mount_point }
import test.claim.typed_remote_file_write_fleet_ssh_fixture {
  fleet_ssh_execution_context_hermetic_witness_fixture,
}

data probe_live_tree: LiveTreeDisposition = SubstrateInputsOnly

fn probe_desired_memory_text() -> String { to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_max)) }
fn probe_desired_swap_text() -> String { to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_swap_max)) }
fn probe_desired_high_text() -> String { to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_high)) }
fn probe_desired_tasks_text() -> String { to_string(gunbc_runner_slot_desired().tasks_max) }

fn probe_subject() -> RunnerHostFileSubject? {
  match runner_host_file_subject(host: "srv1" as HostIdentity) {
    RunnerHostFileSubjectAdmitted { subject: s } => Present { value: s }
    RunnerHostFileSubjectRefused { cause: _ } => none
  }
}

fn probe_featured_unit() -> NonEmptyStr? {
  match probe_subject() {
    Absent => none
    Present { value: s } => match first(s.desired_units) { Present { value: u } => Present { value: u } Absent => none }
  }
}

fn probe_context() -> FleetSshExecutionContext? {
  fleet_ssh_execution_context_hermetic_witness_fixture()
}

// ---------- scenario (the at-desired world, production argv builders) ----------

type ProbeScriptedCommand {
  remote_command: String
  answer: ShellExchangeObservation
}

type ProbeRun
  = ProbeRunReturned { phase: RunnerHostCapPhase, legs: List<String> }
  | ProbeRunEnded { cause: String }

fn probe_identity() -> NonEmptyStr { "cap-route-probe" as NonEmptyStr }

fn probe_shell_ok(stdout: String) -> ShellExchangeObservation {
  ShellProcessExited { exit_code: 0, stdout: stdout, stderr: "" }
}

fn probe_remote_command_of(call: OperationCall) -> String {
  match first(filter(call.invocation.bindings, b => (b.name as String) == "client_args")) {
    Absent => ""
    Present { value: b } => match b.value {
      InputTextList { items: i } => match last(i) { Present { value: w } => w Absent => "" }
      _ => ""
    }
  }
}

fn probe_show_command(unit: NonEmptyStr) -> String {
  join(systemctl_show_properties_argv(units: [unit], properties: slot_cap_show_properties), " ")
}

fn probe_grep_command(control_group: String) -> String {
  join(grep_nonempty_lines_in_tree_argv(file_names: slot_cap_cgroup_files, root: retirement_cgroup_unescaped_root(control_group: control_group) as NonEmptyStr), " ")
}

fn probe_show_block(control_group: String) -> String {
  join([
    join(["MemoryMax=", probe_desired_memory_text()], ""),
    join(["MemorySwapMax=", probe_desired_swap_text()], ""),
    join(["MemoryHigh=", probe_desired_high_text()], ""),
    join(["TasksMax=", probe_desired_tasks_text()], ""),
    join(["ControlGroup=", control_group], ""),
  ], "\n")
}

fn probe_grep_rows(control_group: String) -> String {
  let base = join([cgroup_v2_mount_point as String, control_group], "")
  join([
    join([base, "/memory.max:", probe_desired_memory_text()], ""),
    join([base, "/memory.swap.max:", probe_desired_swap_text()], ""),
  ], "\n")
}

fn probe_cgroup(unit: NonEmptyStr) -> String {
  join(["/system.slice/", unit as String], "")
}

fn probe_at_desired_legs(unit: NonEmptyStr, control_group: String) -> List<ProbeScriptedCommand> {
  [
    ProbeScriptedCommand {
      remote_command: probe_show_command(unit: unit),
      answer: probe_shell_ok(stdout: probe_show_block(control_group: control_group)),
    },
    ProbeScriptedCommand {
      remote_command: probe_grep_command(control_group: control_group),
      answer: probe_shell_ok(stdout: probe_grep_rows(control_group: control_group)),
    },
  ]
}

// ---------- frame ----------

fn probe_grant(verb: std.effect_grant.Verb) -> Grant {
  Grant {
    verb: verb,
    root: NamespacePosition { tree: ServiceOpTree { service: "ssh.Session" }, path: [] }
    binding: ModeledRealization { realization: probe_identity() }
    lifecycle: LifecycleByConstruction
  }
}

fn probe_realization(legs: List<ProbeScriptedCommand>) -> OperationRealization<Int> {
  OperationRealization {
    identity: probe_identity(),
    initial: 0,
    epoch: virtual_clock_origin(),
    bindings: [
      OperationBinding {
        at: ssh_session_exec_portable_words_operation,
        handler: fn(state, call) {
          let cmd = probe_remote_command_of(call: call)
          match first(filter(legs, l => l.remote_command == cmd)) {
            Present { value: m } =>
              OperationObserved {
                observation: ShellObserved { observation: m.answer },
                state: state + 1,
                elapsed: second(count: 1),
              }
            Absent => OperationObserved {
              observation: ShellObserved {
                observation: ShellProcessSpawnRefused {
                  program: "ssh" as NonEmptyStr,
                  cause: "the probe scenario has no answer for this command" as NonEmptyStr,
                },
              },
              state: state + 1,
              elapsed: second(count: 1),
            }
          }
        },
      },
    ],
    advance: fn(state, _now) { state },
  }
}

fn probe_frame(legs: List<ProbeScriptedCommand>) -> WitnessEvaluationFrame<Int> {
  WitnessEvaluationFrame {
    envelope: Envelope {
      frame: Frame { name: "cap-route-probe" as NonEmptyStr, kind: SharedStateFrame }
      grants: [probe_grant(verb: Read), probe_grant(verb: Write)]
    }
    rest_fixtures: []
    realization: Present { value: probe_realization(legs: legs) }
  }
}

fn probe_legs_of_route(route: List<DispatchRecord>) -> List<String> {
  map(route, r => match first(filter(r.invocation.bindings, b => (b.name as String) == "client_args")) {
    Present { value: b } => match b.value {
      InputTextList { items: i } => match last(i) { Present { value: w } => w Absent => "" }
      _ => ""
    }
    Absent => ""
  })
}

fn probe_run(legs: List<ProbeScriptedCommand>) -> ProbeRun {
  match probe_subject() {
    Absent => ProbeRunEnded { cause: "subject-absent" }
    Present { value: subject } => match probe_context() {
      Absent => ProbeRunEnded { cause: "context-unsealable" }
      Present { value: context } => match evaluate_in_witness_frame(
        frame: probe_frame(legs: legs),
        subject: fn(_scope) {
          run_runner_host_cap_phase(
            subject: subject,
            context: context,
            mode: RunnerHostFilesObserveOnly,
            privilege: AdministratorPrivilegeAvailable,
            population: match probe_featured_unit() {
              Absent => SlotPopulationObserved { units: [] }
              Present { value: u } => SlotPopulationObserved {
                units: [RunnerSlotUnitResult { unit: u, standing: SlotTeardownEffective, reload: SlotReloadNotPending }],
              }
            },
          )
        },
      ) {
        WitnessReturned { value: v, route: route, state: _ } => ProbeRunReturned { phase: v, legs: probe_legs_of_route(route: route) }
        WitnessRefused { diagnostic: d, route: _, state: _ } => ProbeRunEnded { cause: witness_diagnostic_rendered_reason(diagnostic: d) }
        WitnessInterrupted { at: _, route: _, state: _, now: _ } => ProbeRunEnded { cause: "worker-interrupted" }
      }
    }
  }
}

// THE AT-DESIRED WORLD RUN, built once for the whole stage ladder.
fn probe_world() -> ProbeRun {
  match probe_featured_unit() {
    Absent => ProbeRunEnded { cause: "no-featured-unit" }
    Present { value: unit } => probe_run(legs: probe_at_desired_legs(unit: unit, control_group: probe_cgroup(unit: unit)))
  }
}

// ---------- the stages ----------

// STAGE 1: srv1 is an admitted subject (the witness's first gate).
test fn probe_stage_subject_admitted() -> Bool {
  match probe_subject() {
    Absent => false
    Present { value: _ } => true
  }
}

// STAGE 2: the subject carries at least one desired unit (the featured slot exists).
test fn probe_stage_featured_unit_present() -> Bool {
  match probe_featured_unit() {
    Absent => false
    // NonEmptyStr is non-empty by type; the fact under test is that srv1's admitted subject
    // carries at least one desired unit at all (production data, not witness-supplied).
    Present { value: _ } => true
  }
}

// STAGE 3: the shared hermetic fixture seals the fleet context (the admit_callers registration holds).
test fn probe_stage_context_seals() -> Bool {
  match probe_context() {
    Absent => false
    Present { value: _ } => true
  }
}

// STAGE 4: the frame run RETURNS a verdict (no refusal, no interruption, no early Absent upstream).
test fn probe_stage_run_returns() -> Bool {
  match probe_world() {
    ProbeRunReturned { phase: _, legs: _ } => true
    ProbeRunEnded { cause: _ } => false
  }
}

// STAGE 4b/4c: WHICH end branch fired, by cause equality -- elimination across the ladder.
test fn probe_stage_not_blocked_at_subject_or_context_or_frame() -> Bool {
  match probe_world() {
    ProbeRunReturned { phase: _, legs: _ } => true
    ProbeRunEnded { cause: c } => !(c == "subject-absent" || c == "context-unsealable" || c == "no-featured-unit" || c == "worker-interrupted")
  }
}

// STAGE 5: the dispatcher's ledger is NON-EMPTY (observe issued legs at all; a frame whose
// realization is never consulted, or an observe that short-circuits, answers zero).
test fn probe_stage_ledger_nonempty() -> Bool {
  match probe_world() {
    // Non-emptiness in the witness's own idiom (any/all over the ledger -- no len builtin here).
    ProbeRunReturned { phase: _, legs: l } => any(l, _ => true)
    ProbeRunEnded { cause: _ } => false
  }
}

// STAGE 6: the grep leg for the FEATURED slot's cgroup fired (both read legs, not just shows).
test fn probe_stage_grep_leg_fires() -> Bool {
  match probe_featured_unit() {
    Absent => false
    Present { value: unit } => match probe_world() {
      ProbeRunReturned { phase: _, legs: l } => any(l, c => string_contains(s: c, pattern: probe_grep_command(control_group: probe_cgroup(unit: unit))))
      ProbeRunEnded { cause: _ } => false
    }
  }
}

// STAGE 7: the phase is CapPhaseObserved carrying a reading for the FEATURED slot (production
// routing: ObserveOnly reaches the read legs and reports standings).
test fn probe_stage_standings_present() -> Bool {
  match probe_featured_unit() {
    Absent => false
    Present { value: unit } => match probe_world() {
      ProbeRunReturned { phase: p, legs: _ } => match p {
        CapPhaseObserved { readings: rs } => any(rs, x => (x.unit as String) == (unit as String))
        _ => false
      }
      ProbeRunEnded { cause: _ } => false
    }
  }
}

// STAGE 8: the featured slot's standing is AtDesired (the fold maps the scripted at-desired text
// through the real readers). False here while 7 is true = keying/fold defect, not routing.
test fn probe_stage_standing_at_desired() -> Bool {
  match probe_featured_unit() {
    Absent => false
    Present { value: unit } => match probe_world() {
      ProbeRunReturned { phase: p, legs: _ } => match p {
        CapPhaseObserved { readings: rs } => match first(filter(rs, x => (x.unit as String) == (unit as String))) {
          Present { value: x } => match x.standing {
            SlotCapsAtDesired => true
            _ => false
          }
          Absent => false
        }
        _ => false
      }
      ProbeRunEnded { cause: _ } => false
    }
  }
}

// THE RECEIPT SPEAKS (control): the phase text names the featured unit (per-slot readings render).
test fn probe_stage_receipt_names_the_unit() -> Bool {
  match probe_featured_unit() {
    Absent => false
    Present { value: unit } => {
      let text = match probe_world() {
        ProbeRunReturned { phase: p, legs: _ } => runner_host_cap_phase_text(phase: p)
        ProbeRunEnded { cause: _ } => ""
      }
      string_contains(s: text, pattern: unit as String)
    }
  }
}
