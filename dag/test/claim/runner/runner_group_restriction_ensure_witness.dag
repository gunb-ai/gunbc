module test.claim.runner.runner_group_restriction_ensure_witness

import std.types { Bool, String, List, Int, NonEmptyStr }
import gunbc.fleet.org_actions_inspection { runner_groups_of_rest_read, RunnerGroupListDecode }
import extdeps.github.org_actions { OrgRunnerGroupWire, OrgRunnerGroupListWire }
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestStatusRefused }
import gunbc.runner.runner_group_restriction_observation { microvm_shakedown_selected_workflow, microvm_shakedown_runner_group_name }
import gunbc.runner.runner_group_restriction_ensure {
  RunnerGroupEnsurePlan, GroupAlreadyRestricted, GroupCreateRequired, GroupEnsureRefused,
  CreatedGroupRestricted, CreatedGroupNotRestricted,
  plan_runner_group_ensure, readback_after_create, microvm_runner_group_create_subject,
  runner_group_create_subject_text, private_heal_publisher_runner_group_subject,
  private_heal_publisher_runner_group_name, restricted_runner_groups,
}
import gunbc.runner.runner_group_restriction_observation { observe_runner_group_restriction }
import gunbc.ci.deploy_slot_tenancy {
  deploy_slot_runner_group_name, deploy_slot_job_user, deploy_slot_selected_workflow,
  DeploySlotReading, deploy_slot_observed_tenancy, DeploySlotPrivacy, DeploySlotPathsPrivate, DeploySlotPathReachable, DeploySlotPrivacyNotYetObserved,
}
import gunbc.runner.runner_slot_job_role { srv1_modeled_deploy_slot_reading }
import gunbc.ci.deploy_route_requirement { srv1_deploy_route_requirement, deploy_route_switch_admitted }
import gunbc.auth.heal_publisher_federation { private_heal_publisher_federation, heal_publisher_federation_workflow_ref }

// THE PLAN'S SUBJECT IS ONE INTERFACE: the organization's runner-groups wire body as GitHub's REST
// read returns it, projected by the one production fold, in; which of three things to do, out.

fn group_wire(id: Int, name: String, restricted: Bool, selected: List<String>) -> OrgRunnerGroupWire {
  OrgRunnerGroupWire {
    id: id,
    name: name,
    visibility: "selected",
    allows_public_repositories: false,
    restricted_to_workflows: restricted,
    selected_workflows: selected,
    workflow_restrictions_read_only: false,
  }
}

fn listed(groups: List<OrgRunnerGroupWire>) -> RunnerGroupListDecode {
  runner_groups_of_rest_read(outcome: RestAnswered { answer: OrgRunnerGroupListWire { total_count: count(groups), runner_groups: groups } })
}

fn default_group() -> OrgRunnerGroupWire { group_wire(id: 1, name: "Default", restricted: false, selected: []) }

fn ours(id: Int, restricted: Bool, selected: List<String>) -> OrgRunnerGroupWire {
  group_wire(id: id, name: microvm_shakedown_runner_group_name as String, restricted: restricted, selected: selected)
}

fn planned_over(read: RunnerGroupListDecode) -> RunnerGroupEnsurePlan {
  plan_runner_group_ensure(subject: microvm_runner_group_create_subject(), listed: read)
}

fn shakedown() -> String { microvm_shakedown_selected_workflow() as String }

// An organization with only the Default group needs the create -- the unrestricted Default group
// is never mistaken for ours.
test fn witness_ensure_requires_the_create_when_only_default_exists() -> Bool {
  match planned_over(read: listed(groups: [default_group()])) {
    GroupCreateRequired { subject: s } => (s.name as String) == "microvm-shakedown" && s.restricted_to_workflows && !s.allows_public_repositories
    _ => false
  }
}

// ALREADY RESTRICTED IS A NOOP, carrying the observer's restriction -- no create is planned, so no
// operator is asked to approve an effect that would change nothing.
test fn witness_ensure_is_a_noop_when_the_group_is_already_restricted() -> Bool {
  match planned_over(read: listed(groups: [default_group(), ours(id: 9, restricted: true, selected: [shakedown()])])) {
    GroupAlreadyRestricted { restriction: r } => r.group.value == 9
    _ => false
  }
}

// A group holding our name with any other restriction is refused, not edited.
test fn witness_ensure_refuses_our_name_held_by_an_unrestricted_group() -> Bool {
  match planned_over(read: listed(groups: [ours(id: 9, restricted: false, selected: [])])) {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupNotEnsurable") && string_contains(s: c as String, pattern: "RunnerGroupNotRestrictedToWorkflows")
    _ => false
  }
}

test fn witness_ensure_refuses_two_groups_with_our_name() -> Bool {
  match planned_over(read: listed(groups: [ours(id: 9, restricted: true, selected: [shakedown()]), ours(id: 10, restricted: true, selected: [shakedown()])])) {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupDuplicated")
    _ => false
  }
}

test fn witness_ensure_refuses_an_unreadable_list() -> Bool {
  match planned_over(read: runner_groups_of_rest_read(outcome: RestRefused { refusal: RestStatusRefused { status: 403, body: "Resource not accessible by integration" } })) {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupListUnreadable")
    _ => false
  }
}

// A 201 FOLLOWED BY A READ THAT LACKS THE GROUP IS A REFUSAL, not a success.
test fn witness_readback_after_create_refuses_when_the_group_is_absent() -> Bool {
  match readback_after_create(subject: microvm_runner_group_create_subject(), listed: listed(groups: [default_group()])) {
    CreatedGroupNotRestricted { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupAbsentAfterCreate")
    CreatedGroupRestricted { restriction: _ } => false
  }
}

test fn witness_readback_after_create_holds_the_restriction() -> Bool {
  match readback_after_create(subject: microvm_runner_group_create_subject(), listed: listed(groups: [default_group(), ours(id: 11, restricted: true, selected: [shakedown()])])) {
    CreatedGroupRestricted { restriction: r } => r.group.value == 11
    CreatedGroupNotRestricted { cause: _ } => false
  }
}

// The text the operator reads names every member of the body, so an approval of it is an approval
// of the exact group.
test fn witness_create_subject_text_names_every_member() -> Bool {
  let t = runner_group_create_subject_text(s: microvm_runner_group_create_subject())
  string_contains(s: t, pattern: "visibility=selected")
    && string_contains(s: t, pattern: "allows_public_repositories=false")
    && string_contains(s: t, pattern: "restricted_to_workflows=true")
    && string_contains(s: t, pattern: shakedown())
    && string_contains(s: t, pattern: "repository_id=1143718943")
}

// ── gunbc-private's heal publisher group: the same three walls, its own workflow ──────────────

fn private_publisher_workflow() -> String {
  heal_publisher_federation_workflow_ref(f: private_heal_publisher_federation())
}

fn private_group(id: Int, selected: List<String>) -> OrgRunnerGroupWire {
  group_wire(id: id, name: private_heal_publisher_runner_group_name as String, restricted: true, selected: selected)
}

// THE GROUP AND THE IDENTITY NAME ONE FILE. The group's selected workflow is the federation's
// workflow_ref, so the only workflow that may run on the group is the only one that may federate.
test fn witness_private_publisher_group_selects_the_federations_workflow() -> Bool {
  let s = private_heal_publisher_runner_group_subject()
  (s.selected_workflow as String) == private_publisher_workflow()
    && private_publisher_workflow() == "gunb-ai/gunbc-private/.github/workflows/heal-publish.yml@refs/heads/main"
    && s.selected_repository_id == private_heal_publisher_federation().numeric_identity.repository_id
    && s.restricted_to_workflows && !s.allows_public_repositories
    && count(filter(restricted_runner_groups(), g => g.name == private_heal_publisher_runner_group_name)) == 1
}

// ADMITTED ONLY FOR ITS OWN WORKFLOW: the same group restricted to the shakedown workflow is
// refused for the publisher. The observer compares against the subject's workflow, not a constant.
test fn witness_private_publisher_group_is_admitted_for_its_workflow_and_refused_for_another() -> Bool {
  let admitted = match plan_runner_group_ensure(subject: private_heal_publisher_runner_group_subject(), listed: listed(groups: [default_group(), private_group(id: 21, selected: [private_publisher_workflow()])])) {
    GroupAlreadyRestricted { restriction: r } => r.group.value == 21 && (r.selected_workflow as String) == private_publisher_workflow()
    _ => false
  }
  let refused = match plan_runner_group_ensure(subject: private_heal_publisher_runner_group_subject(), listed: listed(groups: [private_group(id: 21, selected: [shakedown()])])) {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupSelectsOtherWorkflows") && string_contains(s: c as String, pattern: private_publisher_workflow())
    _ => false
  }
  admitted && refused
}

fn deploy_group(id: Int, selected: List<String>) -> OrgRunnerGroupWire {
  group_wire(id: id, name: deploy_slot_runner_group_name as String, restricted: true, selected: selected)
}

fn deploy_reading_with(groups: List<OrgRunnerGroupWire>, user: NonEmptyStr, privacy: DeploySlotPrivacy) -> DeploySlotReading {
  DeploySlotReading {
    group: observe_runner_group_restriction(name: deploy_slot_runner_group_name, selected_workflow: deploy_slot_selected_workflow(), listed: listed(groups: groups)),
    deploy_slot_job_user: user,
    other_slot_job_users: ["ghrunner" as NonEmptyStr],
    privacy: privacy,
  }
}

fn deploy_reading(groups: List<OrgRunnerGroupWire>, user: NonEmptyStr) -> DeploySlotReading {
  deploy_reading_with(groups: groups, user: user, privacy: DeploySlotPathsPrivate)
}

// RED TODAY, GREEN WITH THE MODEL. srv1 as read today (no deploy group, one shared uid) leaves the
// deploy route's switch refused; a deploy group restricted to fleet-converge at main, a uid no other
// slot runs as, and paths no other uid reaches admit it. Each wall alone still refuses, so none is
// decoration: the last two rows hold the group and the uid and break only the confidentiality wall.
test fn witness_deploy_slot_admits_the_route_switch_only_when_group_uid_and_privacy_all_hold() -> Bool {
  let wf = deploy_slot_selected_workflow()
  let restricted = [default_group(), deploy_group(id: 31, selected: [wf as String])]
  let admit = r => deploy_route_switch_admitted(r: srv1_deploy_route_requirement, observed: deploy_slot_observed_tenancy(reading: r))
  (wf as String) == "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/main"
    && !admit(srv1_modeled_deploy_slot_reading())
    && admit(deploy_reading(groups: restricted, user: deploy_slot_job_user))
    && !admit(deploy_reading(groups: restricted, user: "ghrunner" as NonEmptyStr))
    && !admit(deploy_reading(groups: [default_group()], user: deploy_slot_job_user))
    && !admit(deploy_reading(groups: [default_group(), group_wire(id: 31, name: deploy_slot_runner_group_name as String, restricted: false, selected: [])], user: deploy_slot_job_user))
    && !admit(deploy_reading(groups: [default_group(), deploy_group(id: 31, selected: ["gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main"])], user: deploy_slot_job_user))
    && !admit(deploy_reading_with(groups: restricted, user: deploy_slot_job_user, privacy: DeploySlotPathReachable { path: "/opt/actions-runner/srv1-02/.credentials_rsaparams" as NonEmptyStr, user: "ghrunner" as NonEmptyStr }))
    && !admit(deploy_reading_with(groups: restricted, user: deploy_slot_job_user, privacy: DeploySlotPrivacyNotYetObserved))
    && count(filter(restricted_runner_groups(), g => g.name == deploy_slot_runner_group_name)) == 1
}
