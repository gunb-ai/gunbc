data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE DEPLOY SLOT'S ROLE IS A FACT OF THE SLOT. Each claim supplies a slot or a host at the boundary
// it exercises and asks one question of the production fold; none re-derives the population. The
// RED on main is that no role, user selection, label split, drop-in or account exists at all
// (the module does not resolve); the controls below keep the CI population byte-for-byte what it was.

fn ci_slot() -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
}

fn committed_srv1() -> Int {
  match gunbc_runner_committed_width(host: operator_host_srv1) {
    RunnerWidthDerived { slots: n } => n
    RunnerWidthUnresolved { cause: _ } => 0
  }
}

fn labels_of(slot: RunnerSlotIdentity) -> List<String> {
  match runner_declared_slot_registration_labels(slot: slot) {
    RegistrationLabelsResolved { labels: ls } => ls
    RegistrationLabelsRefused { host: _, cause: _ } => []
  }
}

fn has(labels: List<String>, l: String) -> Bool {
  count(filter(labels, x => x == l)) > 0
}

// The role selects the user with no default arm; the CI slot keeps the host's user, the deploy slot
// is the distinct account, and only the deploy slot is without containers.
test fn witness_role_selects_the_job_user_and_only_the_deploy_slot_is_containerless() -> Bool {
  let ci = "ghrunner" as NonEmptyStr
  runner_slot_job_role(slot: srv1_deploy_slot()) == DeployJobSlot
    && runner_slot_job_role(slot: ci_slot()) == CiJobSlot
    && (runner_slot_job_user(role: DeployJobSlot, ci_job_user: ci) as String) == "ghdeploy"
    && (runner_slot_job_user(role: CiJobSlot, ci_job_user: ci) as String) == "ghrunner"
    && !runner_slot_job_role_runs_containers(role: DeployJobSlot)
    && runner_slot_job_role_runs_containers(role: CiJobSlot)
    && runner_instance_job_role(host: operator_host_srv1, instance_name: "srv1-02" as NonEmptyStr) == DeployJobSlot
    && runner_instance_job_role(host: operator_host_srv1, instance_name: "srv1-01" as NonEmptyStr) == CiJobSlot
}

// WIDTH ARITHMETIC. The deploy slot is one of the committed members the width instrument already
// counts, so repurposing it moves a member between roles and the committed width is unchanged: the
// GitHub members split into one CI slot and one deploy slot, and the fabric members are the other two
// of the same four.
test fn witness_srv1_population_at_committed_width_is_one_ci_one_deploy_two_fabric() -> Bool {
  let n = committed_srv1()
  n == 4
    && count(host_committed_github_members(host: operator_host_srv1, committed: n)) == 2
    && count(host_committed_deploy_members(host: operator_host_srv1, committed: n)) == 1
    && identity_in_list(identity: srv1_deploy_slot(), members: host_committed_deploy_members(host: operator_host_srv1, committed: n))
    && runner_host_has_deploy_slot(host: operator_host_srv1)
    && !runner_host_has_deploy_slot(host: operator_host_srv3)
}

// The deploy slot carries the group label and NOT the CI class label; the CI slot keeps its labels
// exactly. A readiness label on the deploy slot is a divergence and on the CI slot is still admitted.
test fn witness_deploy_slot_labels_exclude_the_ci_class_and_the_ci_slot_is_unchanged() -> Bool {
  let d = labels_of(srv1_deploy_slot())
  let c = labels_of(ci_slot())
  has(d, deploy_slot_runner_group_name as String)
    && !has(d, "gunbc-heavy")
    && has(c, "gunbc-heavy")
    && !has(c, deploy_slot_runner_group_name as String)
    && has(d, "srv1") == has(c, "srv1")
    && runner_slot_labels_conform(receipt: ReceiptAbsent, slot: srv1_deploy_slot(), observed: d) == RegistrationLabelsConform
    && runner_slot_labels_conform(receipt: ReceiptAbsent, slot: srv1_deploy_slot(), observed: c) == RegistrationLabelsDiverge
    && runner_slot_labels_conform(receipt: ReceiptAbsent, slot: srv1_deploy_slot(), observed: concat(d, [gunbc_browser_ready_label])) == RegistrationLabelsDiverge
    && runner_slot_labels_conform(receipt: ReceiptAbsent, slot: ci_slot(), observed: concat(c, [gunbc_browser_ready_label])) == RegistrationLabelsConform
}

fn dropin_text(slot: RunnerSlotIdentity) -> String? {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy: d } =>
      match runner_unit_slot_role_dropin_text(deploy: d, slot: slot) {
        Present { value: RunnerUnitText { text: t } } => Present { value: t }
        _ => Absent
      }
    _ => Absent
  }
}

// The instance drop-in names the deploy account, the deploy labels, and CLEARS DOCKER_HOST so the
// slot cannot inherit the CI user's rootless socket. A CI slot has no such file.
test fn witness_deploy_instance_dropin_sets_user_labels_and_clears_the_docker_socket() -> Bool {
  let deploy_ok = match dropin_text(slot: srv1_deploy_slot()) {
    Absent => false
    Present { value: t } =>
      string_contains(s: t, pattern: "CTRL_RUNNER_JOB_USER=ghdeploy")
        && string_contains(s: t, pattern: "RUNNER_GROUP_ID=10")
        && string_contains(s: t, pattern: "gunbc-deploy")
        && !string_contains(s: t, pattern: "gunbc-heavy")
        && string_contains(s: t, pattern: "DOCKER_HOST=")
        && !string_contains(s: t, pattern: "unix:///run/user")
        && !string_contains(s: t, pattern: "ghrunner")
        && string_contains(s: t, pattern: "UMask=0077")
  }
  let ci_none = match dropin_text(slot: ci_slot()) {
    Absent => true
    Present { value: _ } => false
  }
  deploy_ok && ci_none
}

// The deploy account's grants are per-unit only: the sudoers carries the ghdeploy block with the
// retirement mask lines and none of the whole-binary entries the CI user holds through gunbc-deploy.
test fn witness_deploy_account_holds_per_unit_grants_and_no_whole_binary_entry() -> Bool {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy: d } => {
      let body = runner_host_sudoers_content(deploy: d, artifact_path: "x")
      let block = executor_privileged_operations_sudoers_body(grantee: deploy_slot_job_user, ops: deploy_slot_privileged_operations(deploy: d))
      count(deploy_slot_privileged_operations(deploy: d)) > 0
        && string_contains(s: body, pattern: block)
        && string_contains(s: block, pattern: "ghdeploy")
        && string_contains(s: block, pattern: "/usr/bin/systemctl mask --now")
        && !string_contains(s: block, pattern: "/usr/sbin/visudo")
        && !string_contains(s: block, pattern: "/usr/bin/apt-get")
        && !string_contains(s: block, pattern: "/usr/bin/systemctl\n")
        && !string_contains(s: block, pattern: "/usr/bin/install\n")
    }
    _ => false
  }
}

// EACH SLOT DIRECTORY'S GRANT CARRIES ITS ROLE'S MODE: the deploy slot's tree is created owner-only and a CI
// slot's keeps 0755 (gunbc.runner.runner_slot_job_role runner_slot_job_role_tree_mode). The sudoers line and
// the provisioner's install command are one operation, so the grant is the command that runs. RED: the one
// executor mode for every slot, which left srv1-02's runner key readable by ghrunner.
test fn witness_each_slot_directory_is_granted_at_its_roles_mode() -> Bool {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy: d } => {
      let body = runner_host_sudoers_content(deploy: d, artifact_path: "x")
      string_contains(s: body, pattern: "/usr/bin/install -d -m 00700 -o ghdeploy -g ghdeploy /opt/actions-runner/srv1-02\n")
        && string_contains(s: body, pattern: "/usr/bin/install -d -m 00755 -o ghrunner -g ghrunner /opt/actions-runner/srv1-01\n")
        && !string_contains(s: body, pattern: "/usr/bin/install -d -m 00755 -o ghdeploy")
    }
    _ => false
  }
}

// ── THE CONFIDENTIALITY WALL, JUDGED OVER SUPPLIED READINGS ──────────────────────────────────────
// Readings are what `ls -l -n` shows at each path; ghrunner is uid 999 in group 987, ghdeploy 990/982.
fn mode(octal: String) -> FileMode {
  match file_mode_of_octal_text(text: octal) { Present { value: m } => m Absent => mode(octal: "0") }
}
fn at(path: String, dir: Bool, uid: Int, gid: Int, octal: String) -> DeploySlotPathReading {
  DeploySlotPathRead { path: path as NonEmptyStr, directory: dir, ownership: FileOwnership { uid: uid, gid: gid }, mode: mode(octal: octal) }
}
fn slot_root() -> String { "/opt/actions-runner/srv1-02" }
fn private_paths() -> List<NonEmptyStr> {
  map([slot_root(), concat(slot_root(), "/.runner"), concat(slot_root(), "/.credentials"), concat(slot_root(), "/.credentials_rsaparams"), concat(slot_root(), "/_work"), concat(slot_root(), "/_diag")], p => p as NonEmptyStr)
}
fn ancestors() -> List<DeploySlotPathReading> {
  [at(path: "/opt", dir: true, uid: 0, gid: 0, octal: "755"), at(path: "/opt/actions-runner", dir: true, uid: 1000, gid: 1000, octal: "755")]
}
fn slot_readings(root: String, files: String) -> List<DeploySlotPathReading> {
  concat(ancestors(), [
    at(path: slot_root(), dir: true, uid: 990, gid: 982, octal: root),
    at(path: concat(slot_root(), "/.runner"), dir: false, uid: 990, gid: 982, octal: files),
    at(path: concat(slot_root(), "/.credentials"), dir: false, uid: 990, gid: 982, octal: files),
    at(path: concat(slot_root(), "/.credentials_rsaparams"), dir: false, uid: 990, gid: 982, octal: files),
    at(path: concat(slot_root(), "/_work"), dir: true, uid: 990, gid: 982, octal: root),
    at(path: concat(slot_root(), "/_diag"), dir: true, uid: 990, gid: 982, octal: root),
  ])
}
fn ghrunner() -> DeploySlotJobUserIdentity { DeploySlotJobUserRead { user: "ghrunner" as NonEmptyStr, uid: 999, gids: [987] } }
fn privacy_wire(p: DeploySlotPrivacy) -> String {
  match p {
    DeploySlotPathsPrivate => "private"
    DeploySlotPathReachable { path, user } => join(["reachable ", path as String, " ", user as String], "")
    DeploySlotPrivacyUnread { subject, reason: _ } => concat("unread ", subject as String)
    _ => "other"
  }
}
fn judged(readings: List<DeploySlotPathReading>, others: List<DeploySlotJobUserIdentity>) -> String {
  privacy_wire(p: deploy_slot_privacy(private_paths: private_paths(), readings: readings, others: others))
}

// RED, srv1 AS READ ON 2026-10-30: the tree 0755 and the registration 0644 -- reachable by ghrunner, named
// at the first private path that is. Converged: the tree 0700 and its files 0600 are private; and the
// per-path read, not the tree's mode, decides: 0644 files inside a 0700 tree are private (the tree stops
// the walk), while the same files inside a re-widened tree are reachable at the tree itself.
test fn witness_the_slot_as_read_is_reachable_and_the_converged_slot_is_private() -> Bool {
  judged(readings: slot_readings(root: "755", files: "644"), others: [ghrunner()]) == "reachable /opt/actions-runner/srv1-02 ghrunner"
    && judged(readings: slot_readings(root: "700", files: "600"), others: [ghrunner()]) == "private"
    && judged(readings: slot_readings(root: "700", files: "644"), others: [ghrunner()]) == "private"
    && judged(readings: slot_readings(root: "711", files: "644"), others: [ghrunner()]) == "reachable /opt/actions-runner/srv1-02 ghrunner"
}

// THE CLASS RULE, NOT THE OTHER BITS ALONE: a tree whose group is one the other account holds is reachable
// through the group bits; root reaches everything; with no other runnable slot nothing is reachable.
test fn witness_group_membership_and_root_reach_what_other_bits_do_not() -> Bool {
  let shared_group = concat(ancestors(), [
    at(path: slot_root(), dir: true, uid: 990, gid: 987, octal: "750"),
    at(path: concat(slot_root(), "/.runner"), dir: false, uid: 990, gid: 987, octal: "640"),
    at(path: concat(slot_root(), "/.credentials"), dir: false, uid: 990, gid: 987, octal: "640"),
    at(path: concat(slot_root(), "/.credentials_rsaparams"), dir: false, uid: 990, gid: 987, octal: "640"),
    at(path: concat(slot_root(), "/_work"), dir: true, uid: 990, gid: 987, octal: "750"),
    at(path: concat(slot_root(), "/_diag"), dir: true, uid: 990, gid: 987, octal: "750"),
  ])
  judged(readings: shared_group, others: [ghrunner()]) == "reachable /opt/actions-runner/srv1-02 ghrunner"
    && judged(readings: shared_group, others: [DeploySlotJobUserRead { user: "other" as NonEmptyStr, uid: 1001, gids: [1001] }]) == "private"
    && judged(readings: slot_readings(root: "700", files: "600"), others: [DeploySlotJobUserRead { user: "root" as NonEmptyStr, uid: 0, gids: [0] }]) == "reachable /opt/actions-runner/srv1-02 root"
    && judged(readings: slot_readings(root: "755", files: "644"), others: []) == "private"
}

// ABSENCE IS PRIVATE ONLY WHEN OBSERVED: a state file the listing did not carry is private; a path with no
// reading, or an account whose groups were not read, refuses by name rather than reading private.
test fn witness_an_unread_path_or_account_refuses_and_only_an_observed_absence_is_private() -> Bool {
  let without_key = filter(slot_readings(root: "700", files: "600"), r => match r { DeploySlotPathRead { path: p, directory: _, ownership: _, mode: _ } => (p as String) != concat(slot_root(), "/.credentials_rsaparams") _ => true })
  judged(readings: concat(without_key, [DeploySlotPathAbsent { path: concat(slot_root(), "/.credentials_rsaparams") as NonEmptyStr }]), others: [ghrunner()]) == "private"
    && judged(readings: without_key, others: [ghrunner()]) == "unread /opt/actions-runner/srv1-02/.credentials_rsaparams"
    && judged(readings: concat(without_key, [DeploySlotPathUnread { path: concat(slot_root(), "/.credentials_rsaparams") as NonEmptyStr, reason: "ls refused" }]), others: [ghrunner()]) == "unread /opt/actions-runner/srv1-02/.credentials_rsaparams"
    && judged(readings: slot_readings(root: "700", files: "600"), others: [DeploySlotJobUserUnread { user: "ghrunner" as NonEmptyStr, reason: "id failed" }]) == "unread ghrunner"
}

test fn witness_deploy_job_account_is_declared_with_no_binary_grants() -> Bool {
  match fleet_principal_intent(key: FleetAccountDeployJob) {
    FleetPrincipalIntent { principal: _, login_policy: _, name_requirements: _, sudo_grants: gs } => count(gs) == 0
  }
}

// THE ROUTE SWITCHES PER JOB. The host-pinned selector carries no deploy label, so dashboard-deploy
// and the other jobs whose root writes still run under the job user's grants keep srv1's host runner;
// the microVM controller install, whose root writes all run over the administrator edge, selects the
// deploy label, and only when the dispatch names srv1.
fn runs_on_text(spec: RunnerSpec) -> String {
  match spec {
    RunsOnExpression { expression: e } => e
    _ => ""
  }
}

test fn witness_only_the_administrator_edge_job_selects_the_deploy_slot() -> Bool {
  let host_pinned = runs_on_text(spec: fleet_converge_host_pinned_runner_spec())
  let install = runs_on_text(spec: fleet_converge_microvm_controller_install_job().runner)
  host_pinned != ""
    && !string_contains(s: host_pinned, pattern: deploy_slot_runner_group_name as String)
    && runs_on_text(spec: fleet_converge_dashboard_deploy_job().runner) == host_pinned
    && string_contains(s: install, pattern: "github.event.inputs.host == 'srv1'")
    && string_contains(s: install, pattern: concat("\"", concat(deploy_slot_runner_group_name as String, "\"")))
    && string_contains(s: install, pattern: "|| fromJSON(format('[\"self-hosted\",\"linux\",\"arm64\",\"{0}\"]', github.event.inputs.host))")
}

// THE INSTALL STEP CAN MINT THE TOKEN ITS TENANCY READ NEEDS. The step runs the roster reader's mint,
// down-scoped to organization_self_hosted_runners read, and that mint reads the app key with the job's
// workload-identity token, so the step's environment must carry it. The RED is the step as it stood
// before this route: no environment, so the mint would read an empty bearer and the install would
// refuse every run at its admission.
fn install_step_run_and_wif_env(st: Step) -> Bool {
  match st {
    RunStep { name: _, id: _, run: r, shell: _, env: e, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      string_contains(s: r, pattern: "\"organization_self_hosted_runners\": \"read\"")
        && string_contains(s: r, pattern: "export GUNBC_ORG_ADMIN_TOKEN")
        && match e {
          Present { value: kvs } => any(kvs, x => x.key == workload_identity_token_env as String
            && match x.value { YamlString { value: v } => v == "${{ steps.wif_auth.outputs.access_token }}" _ => false })
          Absent => false
        }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

test fn witness_the_install_step_mints_a_read_only_roster_token_with_its_workload_identity() -> Bool {
  install_step_run_and_wif_env(st: fleet_converge_microvm_controller_install_step())
}

fn id_of(x: RunnerGroupEnsureReceipt) -> Int {
  match deploy_slot_runner_group_id(receipt: x) {
    Absent => 0 - 1
    Present { value: g } => g.value
  }
}

// THE GROUP ID IS THE ENSURE RUN'S RECEIPT ONLY FOR THIS GROUP AND WORKFLOW. The committed receipt
// yields its id; the same receipt naming another group, or the deploy group restricted to another
// workflow, yields none, so the drop-in refuses rather than registering the slot into it.
test fn witness_the_deploy_group_id_comes_only_from_a_receipt_for_this_group_and_workflow() -> Bool {
  let r = deploy_slot_runner_group_ensure_receipt
  id_of(x: r) == 10
    && id_of(x: RunnerGroupEnsureReceipt { run_id: r.run_id, observed_at: r.observed_at, name: "heal-publisher-private", group: JitRunnerGroupId { value: 9 }, selected_workflow: r.selected_workflow }) == 0 - 1
    && id_of(x: RunnerGroupEnsureReceipt { run_id: r.run_id, observed_at: r.observed_at, name: r.name, group: r.group, selected_workflow: "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main" }) == 0 - 1
}
