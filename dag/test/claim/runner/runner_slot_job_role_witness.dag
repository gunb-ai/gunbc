import gunbc.runner.runner_host_deploy { runner_host_deploy_for, RunnerHostDeployFound }
import gunbc.runner.runner_host_grants { runner_host_sudoers_content, deploy_slot_privileged_operations }
import gunbc.fleet.fleet_posix_accounts { fleet_principal_intent, FleetAccountDeployJob, FleetAccountCiRunner, FleetPrincipalIntent }
import gunbc.fleet.fleet_converge_workflow { fleet_converge_host_pinned_runner_spec }
import extdeps.github.actions { RunsOnExpression }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE DEPLOY SLOT'S ROLE IS A FACT OF THE SLOT. Each claim supplies a slot or a host at the boundary
// it exercises and asks one question of the production fold; none re-derives the population. The
// RED on main is that no role, user selection, label split, drop-in or account exists at all
// (the module does not resolve); the controls below keep the CI population byte-for-byte what it was.

fn ci_slot() -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv1, slot_index: 1 }
}

fn committed_srv1() -> Int {
  match gunbc_runner_committed_width(host: operator_host_srv1) {
    RunnerWidthDerived { slots: n } => n
    RunnerWidthUnresolved { cause: _ } => 0
  }
}

fn labels_of(slot: RunnerSlotIdentity) -> List<String> {
  match runner_declared_slot_registration_labels(slot: slot) {
    RegistrationLabelsResolved { labels: ls } => ls
    RegistrationLabelsRefused { host: _, cause: _ } => []
  }
}

fn has(labels: List<String>, l: String) -> Bool {
  count(filter(labels, x => x == l)) > 0
}

// The role selects the user with no default arm; the CI slot keeps the host's user, the deploy slot
// is the distinct account, and only the deploy slot is without containers.
test fn witness_role_selects_the_job_user_and_only_the_deploy_slot_is_containerless() -> Bool {
  let ci = "ghrunner" as NonEmptyStr
  runner_slot_job_role(slot: srv1_deploy_slot()) == DeployJobSlot
    && runner_slot_job_role(slot: ci_slot()) == CiJobSlot
    && (runner_slot_job_user(role: DeployJobSlot, ci_job_user: ci) as String) == "ghdeploy"
    && (runner_slot_job_user(role: CiJobSlot, ci_job_user: ci) as String) == "ghrunner"
    && !runner_slot_job_role_runs_containers(role: DeployJobSlot)
    && runner_slot_job_role_runs_containers(role: CiJobSlot)
    && runner_instance_job_role(host: operator_host_srv1, instance_name: "srv1-02" as NonEmptyStr) == DeployJobSlot
    && runner_instance_job_role(host: operator_host_srv1, instance_name: "srv1-01" as NonEmptyStr) == CiJobSlot
}

// WIDTH ARITHMETIC. The deploy slot is one of the committed members the width instrument already
// counts, so repurposing it moves a member between roles and the committed width is unchanged: the
// GitHub members split into one CI slot and one deploy slot, and the fabric members are the other two
// of the same four.
test fn witness_srv1_population_at_committed_width_is_one_ci_one_deploy_two_fabric() -> Bool {
  let n = committed_srv1()
  n == 4
    && count(host_committed_github_members(host: operator_host_srv1, committed: n)) == 2
    && count(host_committed_ci_job_members(host: operator_host_srv1, committed: n)) == 1
    && count(host_committed_deploy_members(host: operator_host_srv1, committed: n)) == 1
    && identity_in_list(identity: srv1_deploy_slot(), members: host_committed_deploy_members(host: operator_host_srv1, committed: n))
    && !identity_in_list(identity: srv1_deploy_slot(), members: host_committed_ci_job_members(host: operator_host_srv1, committed: n))
    && runner_host_has_deploy_slot(host: operator_host_srv1)
    && !runner_host_has_deploy_slot(host: operator_host_srv3)
}

// The deploy slot carries the group label and NOT the CI class label; the CI slot keeps its labels
// exactly. A readiness label on the deploy slot is a divergence and on the CI slot is still admitted.
test fn witness_deploy_slot_labels_exclude_the_ci_class_and_the_ci_slot_is_unchanged() -> Bool {
  let d = labels_of(srv1_deploy_slot())
  let c = labels_of(ci_slot())
  has(d, deploy_slot_runner_group_name as String)
    && !has(d, "gunbc-heavy")
    && has(c, "gunbc-heavy")
    && !has(c, deploy_slot_runner_group_name as String)
    && has(d, "srv1") == has(c, "srv1")
    && runner_slot_labels_conform(slot: srv1_deploy_slot(), observed: d) == RegistrationLabelsConform
    && runner_slot_labels_conform(slot: srv1_deploy_slot(), observed: c) == RegistrationLabelsDiverge
    && runner_slot_labels_conform(slot: srv1_deploy_slot(), observed: concat(d, [gunbc_browser_ready_label])) == RegistrationLabelsDiverge
    && runner_slot_labels_conform(slot: ci_slot(), observed: concat(c, [gunbc_browser_ready_label])) == RegistrationLabelsConform
}

fn dropin_text(slot: RunnerSlotIdentity) -> String? {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy: d } =>
      match runner_unit_slot_role_dropin_text(deploy: d, slot: slot) {
        Present { value: RunnerUnitText { text: t } } => Present { value: t }
        _ => Absent
      }
    _ => Absent
  }
}

// The instance drop-in names the deploy account, the deploy labels, and CLEARS DOCKER_HOST so the
// slot cannot inherit the CI user's rootless socket. A CI slot has no such file.
test fn witness_deploy_instance_dropin_sets_user_labels_and_clears_the_docker_socket() -> Bool {
  let deploy_ok = match dropin_text(slot: srv1_deploy_slot()) {
    Absent => false
    Present { value: t } =>
      string_contains(s: t, pattern: "CTRL_RUNNER_JOB_USER=ghdeploy")
        && string_contains(s: t, pattern: "RUNNER_GROUP_ID=10")
        && string_contains(s: t, pattern: "gunbc-deploy")
        && !string_contains(s: t, pattern: "gunbc-heavy")
        && string_contains(s: t, pattern: "DOCKER_HOST=")
        && !string_contains(s: t, pattern: "unix:///run/user")
        && !string_contains(s: t, pattern: "ghrunner")
  }
  let ci_none = match dropin_text(slot: ci_slot()) {
    Absent => true
    Present { value: _ } => false
  }
  deploy_ok && ci_none
}

// The deploy account's grants are per-unit only: the sudoers carries the ghdeploy block with the
// retirement mask lines and none of the whole-binary entries the CI user holds through gunbc-deploy.
test fn witness_deploy_account_holds_per_unit_grants_and_no_whole_binary_entry() -> Bool {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy: d } => {
      let body = runner_host_sudoers_content(deploy: d, artifact_path: "x")
      let block = executor_privileged_operations_sudoers_body(grantee: deploy_slot_job_user, ops: deploy_slot_privileged_operations(deploy: d))
      count(deploy_slot_privileged_operations(deploy: d)) > 0
        && string_contains(s: body, pattern: block)
        && string_contains(s: block, pattern: "ghdeploy")
        && string_contains(s: block, pattern: "/usr/bin/systemctl mask --now")
        && !string_contains(s: block, pattern: "/usr/sbin/visudo")
        && !string_contains(s: block, pattern: "/usr/bin/apt-get")
        && !string_contains(s: block, pattern: "/usr/bin/systemctl\n")
        && !string_contains(s: block, pattern: "/usr/bin/install\n")
    }
    _ => false
  }
}

test fn witness_deploy_job_account_is_declared_with_no_binary_grants() -> Bool {
  match fleet_principal_intent(key: FleetAccountDeployJob) {
    FleetPrincipalIntent { principal: _, login_policy: _, name_requirements: _, sudo_grants: gs } => count(gs) == 0
  }
}

// THE ROUTE FOLLOWS THE ROOT SWITCH. With the group unobserved the modeled reading is shared, the
// gate refuses, and fleet-converge keeps today's selector (no deploy label); a switch that admitted
// would select the deploy label for srv1 only.
test fn witness_fleet_converge_keeps_its_selector_until_the_readback_admits_the_switch() -> Bool {
  let admitted = deploy_route_switch_admitted(r: srv1_deploy_route_requirement, observed: deploy_slot_observed_tenancy(reading: srv1_modeled_deploy_slot_reading()))
  !admitted
    && match fleet_converge_host_pinned_runner_spec() {
      RunsOnExpression { expression: e } => !string_contains(s: e, pattern: deploy_slot_runner_group_name as String)
      _ => false
    }
}

fn id_of(x: RunnerGroupEnsureReceipt) -> Int {
  match deploy_slot_runner_group_id(receipt: x) {
    Absent => 0 - 1
    Present { value: g } => g.value
  }
}

// THE GROUP ID IS THE ENSURE RUN'S RECEIPT ONLY FOR THIS GROUP AND WORKFLOW. The committed receipt
// yields its id; the same receipt naming another group, or the deploy group restricted to another
// workflow, yields none, so the drop-in refuses rather than registering the slot into it.
test fn witness_the_deploy_group_id_comes_only_from_a_receipt_for_this_group_and_workflow() -> Bool {
  let r = deploy_slot_runner_group_ensure_receipt
  id_of(x: r) == 10
    && id_of(x: RunnerGroupEnsureReceipt { run_id: r.run_id, observed_at: r.observed_at, name: "heal-publisher-private", group: JitRunnerGroupId { value: 9 }, selected_workflow: r.selected_workflow }) == 0 - 1
    && id_of(x: RunnerGroupEnsureReceipt { run_id: r.run_id, observed_at: r.observed_at, name: r.name, group: r.group, selected_workflow: "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main" }) == 0 - 1
}
