import std.optional { Absent, Present }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.host_identity { HostIdentity }
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv3 }
import gunbc.ci.deploy_slot_tenancy {
  deploy_slot_job_user, deploy_slot_runner_group_name, deploy_slot_observed_tenancy,
  RunnerGroupEnsureReceipt, deploy_slot_runner_group_id, deploy_slot_runner_group_ensure_receipt,
}
import extdeps.github.actions_jit_runner { JitRunnerGroupId }
import gunbc.ci.deploy_route_requirement { srv1_deploy_route_requirement, deploy_route_switch_admitted }
import gunbc.runner.runner_slot_allocation { identity_in_list, gunbc_runner_committed_width, RunnerWidthDerived, RunnerWidthUnresolved }
import gunbc.runner.runner_slot_job_role {
  CiJobSlot, DeployJobSlot, runner_slot_job_role, runner_slot_job_user, runner_slot_job_role_runs_containers,
  runner_instance_job_role, srv1_deploy_slot, host_committed_ci_job_members, host_committed_deploy_members,
  host_committed_github_members, srv1_modeled_deploy_slot_reading, runner_host_has_deploy_slot,
}
import gunbc.runner.runner_registration_labels {
  runner_declared_slot_registration_labels, runner_slot_labels_conform, RegistrationLabelsResolved, RegistrationLabelsRefused,
  RegistrationLabelsConform, RegistrationLabelsDiverge, gunbc_browser_ready_label,
}
