data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INPUTS ARE SUPPLIED AT THE INTERFACE (DESIGN section 3, a witness discriminates at one
// interface). The selection is a fixture the fleet would have made; the observed runs are minted
// through `observed_run` -- the one door the sealed record has -- from readings in the shape the
// route's collect stage will produce. No run executes here. The pairing obligation is the producer
// frontier, asserted unbound below rather than faked with a fixture run. A DIRECTLY AUTHORED
// ADMITTED DISPOSITION IS NOT WRITABLE: `RunnerThroughputAssessment` is sole_constructor, so a
// literal in this module is a compile refusal (v1_compiler sole_constructor_violation_outside_module),
// and every assessment below reaches the fabric through `assess_runner_throughput` and nothing else.

data pin_revision: String = "43643bad4f0000000000000000000000000000ab"
data attempt: NonEmptyStr = "mtcollins1-qual-1" as NonEmptyStr
data run_a: WorkflowRunId = "35447067113" as WorkflowRunId
data run_b: WorkflowRunId = "35447067114" as WorkflowRunId

fn pinned_rate() -> Int {
  calibration_rate(calibration: floor_eval_step_calibration)
}

fn specimen_steps() -> EvalStepCount {
  calibration_specimen_eval_steps(calibration: floor_eval_step_calibration)
}

fn specimen_identity() -> NonEmptyStr {
  calibration_specimen_identity(calibration: floor_eval_step_calibration)
}

fn pin() -> FloorWorkloadPin {
  FloorWorkloadPin {
    program: "gunbc.claim_executor --required-ci" as NonEmptyStr,
    revision: pin_revision,
    specimen: specimen_identity(),
  }
}

// THE HOST FIXTURE IS CONTROLLED; THE SLOT SHAPE IS LIVE. The selected plan is the fleet's own
// fold over sound inputs (oomd verified, the cited jobserver knobs, headroom at the oomd floor),
// and every expected width below is derived through that plan and the live slot rather than
// written as a number (reviews 68620, 68731).
fn fixture_host_total() -> Int {
  268435456000
}

fn fixture_host_available_idle() -> Int {
  263066746880
}

fn sound_plan() -> FleetHostPlan {
  let total = byte_size(count: fixture_host_total())
  fleet_host_plan_for(
    name: "mtcollins1",
    host: total,
    overhead: byte_size(count: fixture_host_total() - fixture_host_available_idle()),
    nproc: hardware_thread_count(count: 160),
    runner: gha_runner_container,
    session_slice: byte_size(count: 0),
    citation: jobserver_config,
    policy: HeadroomSet { bytes: oomd_actuation_floor(host: total) },
    oomd: OomdEnforced,
  )
}

fn expected_width() -> Int {
  match sound_plan() {
    FleetHostPlanUnsound { reason: _ } => 0
    FleetHostPlanDerived {
      name: _, tree: _, runner_slice_cap: slice, effective_build_tokens: _,
      effective_runner_cpu_cap: cap, build_step: _,
    } => {
      let by_memory = byte_size_count(b: slice) / byte_size_count(b: gunbc_runner_slot_desired().memory_max)
      let by_cpu = hardware_thread_count_value(t: cap) / hardware_thread_count_value(t: gunbc_runner_cores_per_slot())
      if by_cpu < by_memory { by_cpu } else { by_memory }
    }
  }
}

fn owned_route() -> ProviderRoute {
  ProviderRoute {
    provider: decl_ref(module_path: "gunbc.fleet_intent_network", decl_name: "operator_host_mtcollins1"),
    service: decl_ref(module_path: "gunbc.floor_demand", decl_name: "floor_execution_requirements"),
    region: decl_ref(module_path: "gunbc.hostname_allocation", decl_name: "gunbc_fleet_hostname_allocations"),
  }
}

// THE SELECTED OFFER IS AN INPUT. Nothing here derives it from a measurement; it is what the fleet
// selected to be assessed, and the assessment is bound to its identity.
fn selected_offer(key: String) -> SupplierOffer<HostIdentity> {
  selected_offer_stating(key: key, architecture: Present { value: Aarch64 })
}

fn selected_offer_stating(key: String, architecture: Architecture?) -> SupplierOffer<HostIdentity> {
  SupplierOffer {
    id: FabricIdentity { principal: "mtcollins1", key: key },
    executor: "mtcollins1",
    route: owned_route(),
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(count: 160) },
      envelope: cpu_memory_envelope(
        min_threads: hardware_thread_count(count: 160),
        architecture: architecture,
        min_bytes: gunbc_runner_slot_desired().memory_max,
      ),
    },
    capabilities: "gunbc.capabilities.linux-rust-toolchain",
    trust_domain: "gunbc.trust.internal-fleet",
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: expected_width(),
    ready_at: "2026-09-19T12:00:00Z",
    quote: QuotedPerSecond(MoneyPerSecond { amount: money_amount_micro(count: 0), currency: Usd }),
    billing_quantum: second(count: 0),
    evidence: ObservedSupply { observed_at: "2026-09-19T12:00:00Z", receipt: "gunbc.runner_throughput_qualification fixture" },
  }
}

fn slot_unit() -> NonEmptyStr {
  ephemeral_slot_unit(host: "mtcollins1", attempt: attempt)
}

fn control_plane_sanction() -> ExecutorSanction {
  ExecutorSanctioned { executor: "mtcollins1" as NonEmptyStr, sanctioned: ControlPlaneCapacity }
}

// THE SELECTION IS MADE BY THE FLEET'S SELECTION FOLD from the fleet's own authorities -- the live
// slot shape, the plan fold, the conservation verdict -- never assembled by hand here.
// THE SELECTED RUNTIME, and the observed run below reads the same row, so a join failure on either
// runtime axis is the variation a claim introduced and never a spelling drift between two literals.
data fixture_runtime: SelectedRunnerRuntime = SelectedRunnerRuntime {
  image_digest: "sha256:fixture-image" as NonEmptyStr,
  runtime_closure: "gunbc.toolchain.rust-1.93.0+clippy+rustfmt" as NonEmptyStr,
}

fn inputs_with(sampling: SamplingPolicy, ceilings: PhaseCeilings, plan: FleetHostPlan, allocation: HostAllocationVerdict) -> RunnerQualificationInputs<HostIdentity> {
  inputs_offered(offer: selected_offer(key: "offer-mtcollins1-qual-1"), sampling: sampling, ceilings: ceilings, plan: plan, allocation: allocation)
}

fn inputs_offered(offer: SupplierOffer<HostIdentity>, sampling: SamplingPolicy, ceilings: PhaseCeilings, plan: FleetHostPlan, allocation: HostAllocationVerdict) -> RunnerQualificationInputs<HostIdentity> {
  select_runner_qualification(
    offer: offer,
    host: "mtcollins1",
    executor_sanction: control_plane_sanction(),
    requirements: floor_execution_requirements(),
    workload: pin(),
    runtime: fixture_runtime,
    plan: plan,
    allocation: allocation,
    slot: gunbc_runner_slot_desired(),
    unit: slot_unit(),
    workspace: mtcollins1_qualification_workspace_backing,
    calibration: floor_eval_step_calibration,
    sampling: sampling,
    phase_ceilings: ceilings,
  )
}

fn selection_with(sampling: SamplingPolicy, ceilings: PhaseCeilings, plan: FleetHostPlan, allocation: HostAllocationVerdict) -> SelectedRunnerQualification<HostIdentity> {
  inputs_with(sampling: sampling, ceilings: ceilings, plan: plan, allocation: allocation).selection
}

fn selection() -> SelectedRunnerQualification<HostIdentity> {
  selection_with(sampling: ConservativePerAxis { minimum_runs: 1 }, ceilings: NoPhaseCeilings, plan: sound_plan(), allocation: HostAllocationConserves)
}

// ── observed runs, minted through the sealed record's one door ────────────────────────────────

fn slot_high() -> ByteSize {
  gunbc_runner_slot_desired().memory_high
}

fn cgroup_level() -> NonEmptyStr {
  concat("/sys/fs/cgroup/system.slice/", slot_unit() as String) as NonEmptyStr
}

fn resolved_bound_with_peak(bytes: ByteSize, peak: ByteSize) -> CgroupMemoryReading {
  CgroupMemoryRead {
    level: cgroup_level(),
    bound: HostBudgetResolved {
      effective_bytes: bytes,
      requested_bytes: none,
      observation: HostBudgetObserved { source: BudgetSourceCgroupMemoryHigh { cgroup_dir: cgroup_level() }, bytes: bytes },
    },
    peak: peak,
  }
}

fn clean_peak() -> ByteSize {
  byte_size(count: byte_size_count(b: slot_high()) - 5368709120)
}

fn resolved_bound(bytes: ByteSize) -> CgroupMemoryReading {
  resolved_bound_with_peak(bytes: bytes, peak: clean_peak())
}

fn complete_roster(wall: Millisecond) -> List<PhaseWall> {
  map(required_ci_phases, p => PhaseWall { phase: p, wall: wall })
}

fn effective_as_selected() -> EffectiveSlotProperties {
  let d = gunbc_runner_slot_desired()
  EffectiveSlotProperties { memory_max: d.memory_max, memory_high: d.memory_high, tasks_max: d.tasks_max, cpu_quota_threads: slot_quota_threads(quota: d.cpu_quota) }
}

fn effective_with_high(high: ByteSize) -> EffectiveSlotProperties {
  let d = gunbc_runner_slot_desired()
  EffectiveSlotProperties { memory_max: d.memory_max, memory_high: high, tasks_max: d.tasks_max, cpu_quota_threads: slot_quota_threads(quota: d.cpu_quota) }
}

// THE PARAMETERS ARE THE AXES THE CLAIMS VARY, one at a time, from a run that joins on every axis
// and meets every standing: the pinned specimen in 50 ms, a peak 5 GiB under the high, the
// complete phase roster, the selected unit's effective properties, tmpfs on the subject.
fn run_with(
  id: WorkflowRunId,
  host: HostIdentity,
  specimen: NonEmptyStr,
  effective: EffectiveSlotProperties,
  workspace: WorkspaceBytesLocus,
  cpu: Millisecond,
  memory: CgroupMemoryReading,
  phases: List<PhaseWall>,
) -> ObservedRunnerQualificationRun {
  observed_run(
    run: id,
    attempt_label: attempt,
    observed_at: "2026-09-19T12:00:00Z",
    host: host,
    program: "gunbc.claim_executor --required-ci" as NonEmptyStr,
    revision: pin_revision,
    specimen: specimen,
    image_digest: fixture_runtime.image_digest,
    runtime_closure: fixture_runtime.runtime_closure,
    slot_unit: slot_unit(),
    incarnation: "1" as NonEmptyStr,
    effective: effective,
    host_threads: hardware_thread_count(count: 160),
    host_architecture: Aarch64,
    workspace: workspace,
    phase_wall: phases,
    floor_eval_steps: eval_step_count(count: 900000000),
    rate_specimen: RateSpecimenRead { eval_steps: specimen_steps(), cpu: cpu },
    memory: memory,
  )
}

fn good_run(id: WorkflowRunId) -> ObservedRunnerQualificationRun {
  run_with(
    id: id, host: "mtcollins1", specimen: specimen_identity(), effective: effective_as_selected(),
    workspace: OnSubjectChargedToSlot, cpu: millisecond(count: 50),
    memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)),
  )
}

fn varied_run(id: WorkflowRunId, cpu: Millisecond, memory: CgroupMemoryReading, phases: List<PhaseWall>) -> ObservedRunnerQualificationRun {
  run_with(
    id: id, host: "mtcollins1", specimen: specimen_identity(), effective: effective_as_selected(),
    workspace: OnSubjectChargedToSlot, cpu: cpu, memory: memory, phases: phases,
  )
}

fn first_join_axis(refusals: List<ThroughputRefusal>) -> String {
  fold(refusals, init: "", f: (acc, r) =>
    if acc != "" { acc } else {
      match r {
        SubjectJoinDidNotHold { join: j } =>
          match j {
            SubjectJoinRefused { run: _, axis: a, selected: _, observed: _ } => subject_join_axis_wire(a: a)
            SubjectJoined => ""
          }
        _ => ""
      }
    }
  )
}

// COVERAGE IS AN IDENTITY JOIN, NOT A COUNT (DESIGN section 5; review 68995): the assessed facts
// must be exactly the named arms, each once.
fn fact_is(a: AssessedFact, b: AssessedFact) -> Bool {
  match a {
    InterpreterRateAgainstPin => match b { InterpreterRateAgainstPin => true _ => false }
    SlotMemoryEnvelope => match b { SlotMemoryEnvelope => true _ => false }
    PhaseWallsAgainstSuppliedCeilings => match b { PhaseWallsAgainstSuppliedCeilings => true _ => false }
    ConcurrentCohortAtWidth => match b { ConcurrentCohortAtWidth => true _ => false }
  }
}

fn has_fact_once(facts: List<AssessedFact>, want: AssessedFact) -> Bool {
  (facts |> filter(f => fact_is(a: f, b: want))).length() == 1
}

fn covers_rate_memory_and_cohort(facts: List<AssessedFact>) -> Bool {
  facts.length() == 3 && has_fact_once(facts: facts, want: InterpreterRateAgainstPin) && has_fact_once(facts: facts, want: SlotMemoryEnvelope)
    && has_fact_once(facts: facts, want: ConcurrentCohortAtWidth)
}

fn covers_rate_memory_walls_and_cohort(facts: List<AssessedFact>) -> Bool {
  facts.length() == 4 && has_fact_once(facts: facts, want: InterpreterRateAgainstPin)
    && has_fact_once(facts: facts, want: SlotMemoryEnvelope) && has_fact_once(facts: facts, want: PhaseWallsAgainstSuppliedCeilings)
    && has_fact_once(facts: facts, want: ConcurrentCohortAtWidth)
}

// ── the concurrent cohort ─────────────────────────────────────────────────────────────────────
//
// A DELIVERING ASSESSMENT NEEDS A SEALED COHORT AT THE DERIVED WIDTH, so the delivering claims below
// run through assess_at_width: the claim's own runs PLUS one good run per seat, and a cohort of exactly
// expected_width() seats, all active over [20, 40], each seat one of those assessed runs. The seats are
// good runs, so the throughput and memory aggregates the claims read are the good run's either way.
// Claims about a refusal on some other axis run through assess_unobserved, where the missing cohort is
// one more refusal beside the one the claim reads.
fn t(n: Nat) -> ObservationInstant { ObservationInstant { domain: SharedMonotonic { origin: "mtcollins1-boot" as NonEmptyStr }, basis: WallClock, since_origin: nanosecond(count: n) } }

fn seat_ids(n: Int) -> List<WorkflowRunId> {
  map(nat_range_inclusive(lo: 1, hi: n), i => concat("cohort-seat-", i as String) as WorkflowRunId)
}

fn seat_reading(id: WorkflowRunId, settlement: SeatSettlement) -> CohortSeatReading<WorkflowRunId> {
  CohortSeatReading {
    seat: id, source: OccurrenceId { attempt: "cohort-1" as NonEmptyStr, id: id as NonEmptyStr },
    ready_at: t(n: 5), started_at: t(n: 20), ended_at: t(n: 40), settlement: settlement,
  }
}

fn cohort_of(seats: List<CohortSeatReading<WorkflowRunId>>) -> RunnerCohortEvidence {
  CohortObserved {
    seal: seal_cohort(
      reading: CohortReading {
        roster: map(seats, s => s.seat), barrier_released_at: t(n: 10), host_window_from: t(n: 0), host_window_to: t(n: 100),
        host_source: OccurrenceId { attempt: "cohort-1" as NonEmptyStr, id: "host" as NonEmptyStr }, seats: seats,
      },
      seat_key: run_key,
    ),
  }
}

fn cohort_runs(ids: List<WorkflowRunId>) -> List<ObservedRunnerQualificationRun> {
  map(ids, id => good_run(id: id))
}

fn assess_at_width(selection: SelectedRunnerQualification<HostIdentity>, runs: List<ObservedRunnerQualificationRun>) -> RunnerThroughputAssessment<HostIdentity> {
  let ids = seat_ids(n: expected_width())
  assess_runner_throughput(selection: selection, runs: concat(runs, cohort_runs(ids: ids)), cohort: cohort_of(seats: map(ids, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded }))))
}

fn assess_unobserved(selection: SelectedRunnerQualification<HostIdentity>, runs: List<ObservedRunnerQualificationRun>) -> RunnerThroughputAssessment<HostIdentity> {
  assess_runner_throughput(selection: selection, runs: runs, cohort: NoCohortObserved)
}

fn concurrency_is(a: RunnerThroughputAssessment<HostIdentity>, want: String) -> Bool {
  !assessment_holds(a: a) && string_contains(s: assessment_wire(a: a) as String, pattern: want)
}

fn sampling_refused(a: RunnerThroughputAssessment<HostIdentity>) -> Bool {
  a.refusals |> any(r => match r { SamplingDidNotHold { policy: _, observed_runs: _ } => true _ => false })
}

// ── the positive control ──────────────────────────────────────────────────────────────────────

test fn a_joining_run_meeting_every_axis_makes_the_offer_deliver() -> Bool {
  let a = assess_at_width(selection: selection(), runs: [good_run(id: run_a)])
  assessment_holds(a: a)
    && (match a.throughput {
      ThroughputMeetsPin { measured: m, pinned: p } =>
        eval_steps_per_millisecond_count(r: m) == eval_step_count_value(s: specimen_steps()) / 50
          && eval_steps_per_millisecond_count(r: p) == pinned_rate()
      _ => false
    })
    && (match a.slot_width {
      SlotWidthDerived { by_memory: _, by_cpu: _, slots: n } => n == expected_width() && n >= 1
      SlotWidthUnderivable { cause: _ } => false
    })
    && covers_rate_memory_and_cohort(facts: a.assessed_facts)
}

// ── the subject join REDs (operator hold, item 2) ─────────────────────────────────────────────

test fn a_run_from_another_host_is_refused_on_the_host_axis() -> Bool {
  let r = run_with(
    id: run_a, host: "srv3", specimen: specimen_identity(), effective: effective_as_selected(),
    workspace: OnSubjectChargedToSlot, cpu: millisecond(count: 50),
    memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)),
  )
  let a = assess_unobserved(selection: selection(), runs: [r])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == "host"
    && (match a.phase_roster { PhaseRosterNotAssessed { because: _ } => true _ => false })
    && a.assessed_facts.length() == 0
}

// THE GOOD RUN WITH ONLY ITS RUNTIME AND HOST FACTS REPLACED, so each claim below varies exactly one.
fn good_run_in(image_digest: NonEmptyStr, runtime_closure: NonEmptyStr, host_threads: HardwareThreadCount, host_architecture: Architecture) -> ObservedRunnerQualificationRun {
  let g = good_run(id: run_a)
  observed_run(
    run: g.run, attempt_label: g.attempt_label, observed_at: g.observed_at, host: g.host,
    program: g.program, revision: g.revision, specimen: g.specimen,
    image_digest: image_digest, runtime_closure: runtime_closure,
    slot_unit: g.slot_unit, incarnation: g.incarnation, effective: g.effective,
    host_threads: host_threads, host_architecture: host_architecture, workspace: g.workspace,
    phase_wall: g.phase_wall, floor_eval_steps: g.floor_eval_steps,
    rate_specimen: g.rate_specimen, memory: g.memory,
  )
}

fn refused_on(selection: SelectedRunnerQualification<HostIdentity>, run: ObservedRunnerQualificationRun, axis: String) -> Bool {
  let a = assess_unobserved(selection: selection, runs: [run])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == axis && a.assessed_facts.length() == 0
}

// THE RUNTIME AND HOST FACTS WERE OBSERVED AND NEVER JOINED; NOW EACH ONE REFUSES ALONE. Every run
// below is the good run with one fact changed, and the good run itself still joins, so a claim that
// passes here is about that axis and nothing else.
test fn a_run_in_another_image_or_toolchain_is_refused_on_its_runtime_axis() -> Bool {
  let t = hardware_thread_count(count: 160)
  assessment_holds(a: assess_at_width(selection: selection(), runs: [good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: fixture_runtime.runtime_closure, host_threads: t, host_architecture: Aarch64)]))
    && refused_on(selection: selection(), run: good_run_in(image_digest: "sha256:another-image" as NonEmptyStr, runtime_closure: fixture_runtime.runtime_closure, host_threads: t, host_architecture: Aarch64), axis: "image digest")
    && refused_on(selection: selection(), run: good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: "gunbc.toolchain.rust-1.92.0" as NonEmptyStr, host_threads: t, host_architecture: Aarch64), axis: "runtime closure")
}

test fn a_run_on_another_host_shape_is_refused_on_its_host_axis() -> Bool {
  refused_on(selection: selection(), run: good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: fixture_runtime.runtime_closure, host_threads: hardware_thread_count(count: 80), host_architecture: Aarch64), axis: "host threads")
    && refused_on(selection: selection(), run: good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: fixture_runtime.runtime_closure, host_threads: hardware_thread_count(count: 160), host_architecture: X86_64), axis: "host architecture")
}

// AN OFFER THAT STATES NO ARCHITECTURE ADMITS NONE: the good run, unchanged, refuses on the axis.
test fn an_offer_stating_no_architecture_refuses_the_architecture_join() -> Bool {
  let s = inputs_offered(
    offer: selected_offer_stating(key: "offer-mtcollins1-qual-1", architecture: Absent),
    sampling: ConservativePerAxis { minimum_runs: 1 }, ceilings: NoPhaseCeilings, plan: sound_plan(), allocation: HostAllocationConserves,
  ).selection
  refused_on(selection: s, run: good_run(id: run_a), axis: "host architecture")
}

// THE SAME STEP COUNT ON A DIFFERENT SPECIMEN IS A DIFFERENT PROGRAM: the identity is joined, not
// only the count.
test fn a_run_of_another_specimen_with_the_same_step_count_is_refused_on_the_specimen_axis() -> Bool {
  let r = run_with(
    id: run_a, host: "mtcollins1", specimen: "test.claim.some_other_specimen" as NonEmptyStr, effective: effective_as_selected(),
    workspace: OnSubjectChargedToSlot, cpu: millisecond(count: 50),
    memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)),
  )
  let a = assess_unobserved(selection: selection(), runs: [r])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == "specimen"
}

test fn a_unit_whose_effective_high_is_not_the_selected_high_is_refused() -> Bool {
  let other = byte_size(count: byte_size_count(b: slot_high()) + 1073741824)
  let r = run_with(
    id: run_a, host: "mtcollins1", specimen: specimen_identity(), effective: effective_with_high(high: other),
    workspace: OnSubjectChargedToSlot, cpu: millisecond(count: 50),
    memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)),
  )
  let a = assess_unobserved(selection: selection(), runs: [r])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == "effective MemoryHigh"
}

// A READABLE PEAK UNDER A BOUND THAT DID NOT RESOLVE TO THE SUBJECT'S IS NOT THE SUBJECT'S PEAK.
test fn a_cgroup_bound_that_is_unreadable_or_another_number_is_refused_on_the_bound_axis() -> Bool {
  let unreadable = varied_run(
    id: run_a, cpu: millisecond(count: 50),
    memory: CgroupMemoryUnreadable { reason: "no cgroup memory.high or memory.max binds this process" as NonEmptyStr },
    phases: complete_roster(wall: millisecond(count: 1000)),
  )
  let other = varied_run(
    id: run_b, cpu: millisecond(count: 50),
    memory: resolved_bound(bytes: byte_size(count: byte_size_count(b: slot_high()) - 1)),
    phases: complete_roster(wall: millisecond(count: 1000)),
  )
  let a1 = assess_unobserved(selection: selection(), runs: [unreadable])
  let a2 = assess_unobserved(selection: selection(), runs: [other])
  first_join_axis(refusals: a1.refusals) == "cgroup bound" && first_join_axis(refusals: a2.refusals) == "cgroup bound"
}

test fn a_workspace_read_off_the_subject_is_refused_on_the_workspace_axis() -> Bool {
  let r = run_with(
    id: run_a, host: "mtcollins1", specimen: specimen_identity(), effective: effective_as_selected(),
    workspace: OnSubjectUncharged, cpu: millisecond(count: 50),
    memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)),
  )
  let a = assess_unobserved(selection: selection(), runs: [r])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == "workspace locus"
    && (match workspace_bytes_locus(backing: PeerScratchExport { peer: "srv2" }) { OffSubject { peer: p } => (p as String) == "srv2" _ => false })
}

// ── aggregation REDs (operator hold, item 3) ──────────────────────────────────────────────────

// RUN A IS THE SLOWEST AND PASSES MEMORY; RUN B IS FASTER BUT REACHES memory.high. The host must
// not deliver: throughput takes the minimum (A), memory takes the maximum peak (B).
test fn a_faster_run_that_pinned_the_high_line_is_not_hidden_by_a_slower_clean_run() -> Bool {
  let slow_clean = varied_run(id: run_a, cpu: millisecond(count: 70), memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)))
  let fast_pinned = varied_run(id: run_b, cpu: millisecond(count: 40), memory: resolved_bound_with_peak(bytes: slot_high(), peak: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)))
  let a = assess_unobserved(selection: selection(), runs: [slow_clean, fast_pinned])
  !assessment_holds(a: a)
    && (match a.memory { PeakExceedsSlotHigh { peak: p, high: h } => byte_size_count(b: p) == byte_size_count(b: h) _ => false })
    && (match a.throughput {
      ThroughputMeetsPin { measured: m, pinned: _ } => eval_steps_per_millisecond_count(r: m) == eval_step_count_value(s: specimen_steps()) / 70
      _ => false
    })
}

test fn the_sampling_policy_refuses_a_sample_of_the_wrong_size() -> Bool {
  let one = selection_with(sampling: ExactlyOneReconciledRun, ceilings: NoPhaseCeilings, plan: sound_plan(), allocation: HostAllocationConserves)
  let two = assess_unobserved(selection: one, runs: [good_run(id: run_a), good_run(id: run_b)])
  let zero = assess_unobserved(selection: selection(), runs: [])
  sampling_refused(a: two) && sampling_refused(a: zero) && !assessment_holds(a: zero)
}

// ── the phase roster and ceilings (operator hold, item 5) ─────────────────────────────────────

fn roster_without(phase: RequiredCiPhase) -> List<PhaseWall> {
  complete_roster(wall: millisecond(count: 1000)) |> filter(w => !required_ci_phase_is(a: w.phase, b: phase))
}

test fn a_missing_or_duplicated_required_phase_refuses() -> Bool {
  let missing = varied_run(id: run_a, cpu: millisecond(count: 50), memory: resolved_bound(bytes: slot_high()), phases: roster_without(phase: FloorPhase))
  let duplicated = varied_run(
    id: run_b, cpu: millisecond(count: 50), memory: resolved_bound(bytes: slot_high()),
    phases: concat(complete_roster(wall: millisecond(count: 1000)), [PhaseWall { phase: ParsePhase, wall: millisecond(count: 5) }]),
  )
  let am = assess_unobserved(selection: selection(), runs: [missing])
  let ad = assess_unobserved(selection: selection(), runs: [duplicated])
  (match am.phase_roster { PhaseMissing { phase: p } => required_ci_phase_is(a: p, b: FloorPhase) _ => false })
    && (match ad.phase_roster { PhaseDuplicated { phase: p } => required_ci_phase_is(a: p, b: ParsePhase) _ => false })
    && !assessment_holds(a: am) && !assessment_holds(a: ad)
}

// WITHOUT CEILINGS THE WALLS ARE OBSERVATION AND THE CLAIM SAYS SO; WITH THEM THEY ARE ASSESSED.
test fn phase_walls_are_assessed_only_against_supplied_ceilings() -> Bool {
  let loose = selection_with(
    sampling: ConservativePerAxis { minimum_runs: 1 },
    ceilings: PhaseCeilingsDeclared { ceilings: [PhaseWall { phase: FloorPhase, wall: millisecond(count: 2000) }] },
    plan: sound_plan(), allocation: HostAllocationConserves,
  )
  let tight = selection_with(
    sampling: ConservativePerAxis { minimum_runs: 1 },
    ceilings: PhaseCeilingsDeclared { ceilings: [PhaseWall { phase: FloorPhase, wall: millisecond(count: 500) }] },
    plan: sound_plan(), allocation: HostAllocationConserves,
  )
  let al = assess_at_width(selection: loose, runs: [good_run(id: run_a)])
  let at = assess_at_width(selection: tight, runs: [good_run(id: run_a)])
  let an = assess_at_width(selection: selection(), runs: [good_run(id: run_a)])
  assessment_holds(a: al) && covers_rate_memory_walls_and_cohort(facts: al.assessed_facts)
    && !assessment_holds(a: at)
    && (match at.phase_walls { PhaseWallExceedsCeiling { phase: _, wall: _, ceiling: _ } => true _ => false })
    && (match an.phase_walls { PhaseWallsNotAssessed => true _ => false })
}

// THE WIDTH IS OBSERVED, NOT ONLY DIVIDED. Every run below is the good run; what varies is the cohort.
// No cohort, a cohort one seat short of the width, a seat that failed, a seat that is not one of the
// assessed runs, and a cohort whose seats were never all active each refuse delivery by name, while
// assess_at_width -- the same runs and a full cohort -- delivers (the positive control above).
test fn delivery_needs_a_sealed_concurrent_cohort_at_the_derived_width() -> Bool {
  let w = expected_width()
  let ids = seat_ids(n: w)
  let runs = cohort_runs(ids: ids)
  let short = seat_ids(n: w - 1)
  let failed = map(ids, id => if (id as String) == "cohort-seat-1" { seat_reading(id: id, settlement: SeatSettledAs { settled: SeatFailed { cause: "floor phase refused" as NonEmptyStr } }) } else { seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded }) })
  let stranger = concat(map(short, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded })), [seat_reading(id: "not-an-assessed-run" as WorkflowRunId, settlement: SeatSettledAs { settled: SeatSucceeded })])
  let apart = map(ids, id => if (id as String) == "cohort-seat-1" { CohortSeatReading { seat: id, source: OccurrenceId { attempt: "cohort-1" as NonEmptyStr, id: id as NonEmptyStr }, ready_at: t(n: 5), started_at: t(n: 50), ended_at: t(n: 60), settlement: SeatSettledAs { settled: SeatSucceeded } } } else { seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded }) })
  w >= 2
    && concurrency_is(a: assess_unobserved(selection: selection(), runs: runs), want: "no concurrent cohort was observed")
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, cohort: cohort_of(seats: map(short, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded })))), want: join(["the cohort ran ", (w - 1) as String, " seats but the derived width is ", w as String], ""))
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, cohort: cohort_of(seats: failed)), want: "cohort seat cohort-seat-1 failed: floor phase refused")
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, cohort: cohort_of(seats: stranger)), want: "a cohort seat is not one of the assessed runs: not-an-assessed-run")
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, cohort: cohort_of(seats: apart)), want: "the seats were never all active at once")
    && assessment_holds(a: assess_runner_throughput(selection: selection(), runs: runs, cohort: cohort_of(seats: map(ids, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded })))))
}

// ── throughput and width REDs ─────────────────────────────────────────────────────────────────

test fn throughput_below_the_pinned_rate_does_not_deliver_and_carries_the_number() -> Bool {
  let slow = varied_run(id: run_a, cpu: millisecond(count: 110), memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)))
  let a = assess_unobserved(selection: selection(), runs: [slow])
  let expected = eval_step_count_value(s: specimen_steps()) / 110
  !assessment_holds(a: a)
    && expected < pinned_rate()
    && string_contains(
      s: assessment_wire(a: a) as String,
      pattern: join(["throughput ", expected as String, " steps/ms is below the pin ", pinned_rate() as String], ""),
    )
}

// THE WIDTH IS READ OFF THE SELECTED PLAN AND ALLOCATION (operator hold, item 4): an oversubscribed
// allocation or a plan the fleet refused derives no width and no delivery.
test fn a_refused_or_oversubscribed_selected_allocation_derives_no_width() -> Bool {
  let oversubscribed = selection_with(sampling: ConservativePerAxis { minimum_runs: 1 }, ceilings: NoPhaseCeilings, plan: sound_plan(), allocation: HostAllocationOversubscribed)
  let unsound = selection_with(sampling: ConservativePerAxis { minimum_runs: 1 }, ceilings: NoPhaseCeilings, plan: FleetHostPlanUnsound { reason: "oomd enforcement unverified" }, allocation: HostAllocationConserves)
  ([oversubscribed, unsound] |> all(sel => {
    let a = assess_unobserved(selection: sel, runs: [good_run(id: run_a)])
    !assessment_holds(a: a) && (match a.slot_width { SlotWidthUnderivable { cause: _ } => true _ => false })
  }))
    && (match selected_host_allocation(plan: sound_plan(), allocation: HostAllocationConserves) {
      HostAllocationAdmitted { runner_slice_cap: _, effective_runner_cpu_cap: _ } => true
      HostAllocationRefused { cause: _ } => false
    })
}

// ── the join into the fabric (operator hold, item 1) ──────────────────────────────────────────

// THE SANCTION IS AN INPUT THE FABRIC ADMITS ON, NEVER A CONCLUSION OF THIS MODULE: the same
// delivering assessment beside a customer sanction is refused by admit_executor_capacity for
// the floor, and nothing in the qualification module can mint a sanction from an assessment.
test fn the_selected_sanction_not_the_assessment_decides_the_class() -> Bool {
  let inputs = inputs_with(sampling: ConservativePerAxis { minimum_runs: 1 }, ceilings: NoPhaseCeilings, plan: sound_plan(), allocation: HostAllocationConserves)
  let s = inputs.selection
  let control = admit_executor_capacity(requirements: s.requirements, roster: [inputs.executor_sanction], executor: "mtcollins1" as NonEmptyStr)
  let customer = admit_executor_capacity(
    requirements: s.requirements,
    roster: [ExecutorSanctioned { executor: "mtcollins1" as NonEmptyStr, sanctioned: CustomerExecutableCapacity }],
    executor: "mtcollins1" as NonEmptyStr,
  )
  let unclassified = admit_executor_capacity(requirements: s.requirements, roster: [], executor: "mtcollins1" as NonEmptyStr)
  (match control { CapacityClassAdmitted { executor: _, class: _ } => true _ => false })
    && (match customer { CapacityClassRefused { executor: _, required: _, sanctioned: _ } => true _ => false })
    && (match unclassified { ExecutorNotClassified { executor: _ } => true _ => false })
}

// THE DELIVERY CLAIM IS THE FABRIC'S OWN CARRIER: claimed_delivery_check dispatches the runner arm,
// holds for a delivering assessment bound to the claimed offer, refuses an assessment that does not
// deliver with RunnerThroughputDidNotHold, and refuses a claim riding another offer.
test fn the_fabric_delivery_claim_holds_refuses_and_catches_another_offer() -> Bool {
  let s = selection()
  let good = assess_at_width(selection: s, runs: [good_run(id: run_a)])
  let slow = assess_unobserved(selection: s, runs: [varied_run(id: run_a, cpu: millisecond(count: 110), memory: resolved_bound(bytes: slot_high()), phases: complete_roster(wall: millisecond(count: 1000)))])
  let holds = match claimed_delivery_check(claim: OfferClaimsRunnerDelivery { offer: s.offer.id, assessment: good }) {
    ClaimedDeliveryHolds => true
    _ => false
  }
  let refused = match claimed_delivery_check(claim: OfferClaimsRunnerDelivery { offer: s.offer.id, assessment: slow }) {
    ClaimedDeliveryUnqualified { refusals: rs } =>
      rs |> any(r => match r { RunnerThroughputDidNotHold { refusals: inner } => inner.length() >= 1 _ => false })
    _ => false
  }
  let mismatch = match claimed_delivery_check(claim: OfferClaimsRunnerDelivery { offer: selected_offer(key: "offer-other").id, assessment: good }) {
    ClaimedDeliveryOfferMismatch { claim_names: _, receipt_names: _ } => true
    _ => false
  }
  holds && refused && mismatch
}

// ── the route (operator hold, item 6) ─────────────────────────────────────────────────────────

fn route() -> List<QualificationStage> {
  mtcollins1_qualification_route(attempt: attempt, workload: pin())
}

// FOUR EFFECTFUL STAGES AT TWO GRAINS: one BMC write under the approval gate, three GitHub
// control-plane writes; the collect stage alone is observation.
test fn the_route_classifies_every_mutation_at_its_grain() -> Bool {
  route_effectful_stage_count(route: route()) == 4
    && route_bmc_write_count(route: route()) == 1
    && route_control_plane_write_count(route: route()) == 3
    && route_bmc_writes_are_gated(route: route())
    && (route() |> all(s =>
      match s {
        RegisterEphemeralRunnerSlot { unit: _, labels: _, workspace: _, registration: _ } =>
          match stage_effect(stage: s) { GitHubControlPlaneWrite { authority: _ } => true _ => false }
        DispatchFloorToSlot { workload: _, selector: _, dispatch: _ } =>
          match stage_effect(stage: s) { GitHubControlPlaneWrite { authority: _ } => true _ => false }
        DeregisterRunnerSlot { unit: _, deregistration: _ } =>
          match stage_effect(stage: s) { GitHubControlPlaneWrite { authority: _ } => true _ => false }
        CollectInstruments { instruments: _ } =>
          match stage_effect(stage: s) { ObservationOnly => true _ => false }
        BootHostUnderApprovalGate { host: _, boot: _, image: _ } =>
          match stage_effect(stage: s) { BmcWrite { gate: _, boot: _, image: _ } => true _ => false }
      }
    ))
}

// THE ROUTE IS NOT EXECUTABLE TODAY, AND THE CLAIM SAYS SO: no effectful leg is wired yet and the dispatch leg is still a
// declared frontier. This flips to the regression control that the bindings stay when they land.
test fn the_route_is_not_executable_while_any_effectful_leg_is_unbound() -> Bool {
  !route_is_executable(route: route()) && !leg_is_wired(leg: qualification_run_producer_frontier)
}

// THE IMAGE AND BOOT LEGS HAVE IMPLEMENTED RUNNER-OWNED AUTHORITIES AND ARE NOT WIRED. Wiring either
// before a production caller boots the runner image, or pointing either at another declaration
// (the census-only boot run among them), turns this red.
test fn the_image_and_boot_legs_are_implemented_by_the_runner_medium_and_not_wired() -> Bool {
  leg_names(leg: mtcollins1_route_legs.image, module_path: "gunbc.runner.runner_host_medium", decl_name: "runner_host_medium_image")
    && !leg_is_wired(leg: mtcollins1_route_legs.image)
    && leg_names(leg: mtcollins1_route_legs.boot, module_path: "gunbc.runner.runner_host_medium", decl_name: "runner_host_up_readback")
    && !leg_is_wired(leg: mtcollins1_route_legs.boot)
}

// REGISTRATION AND DEREGISTRATION HAVE IMPLEMENTED AUTHORITIES AND ARE NOT WIRED -- by declaration
// identity, so pointing either leg at some other declaration, or promoting either to LegWired while
// nothing on the route calls it, turns this red -- and the route stays unexecutable.
fn leg_names(leg: RouteLegStanding, module_path: String, decl_name: String) -> Bool {
  match leg {
    LegAuthorityImplemented { authority: a, wiring_owed: _ } => (a.module_path as String) == module_path && (a.decl_name as String) == decl_name
    _ => false
  }
}

test fn the_registration_and_deregistration_legs_are_implemented_not_wired_and_the_route_is_not_executable() -> Bool {
  leg_names(leg: mtcollins1_route_legs.registration, module_path: "gunbc.runner.runner_jit_perform", decl_name: "dispatch_jit_mint")
    && leg_names(leg: mtcollins1_route_legs.deregistration, module_path: "gunbc.runner.runner_jit_deregistration", decl_name: "ensure_jit_runner_deregistered")
    && !leg_is_wired(leg: mtcollins1_route_legs.registration)
    && !leg_is_wired(leg: mtcollins1_route_legs.deregistration)
    && !leg_is_wired(leg: mtcollins1_route_legs.boot)
    && !leg_is_wired(leg: mtcollins1_route_legs.dispatch)
    && !route_is_executable(route: route())
}

test fn the_route_registers_one_slot_deregisters_it_and_dispatches_to_the_attempt() -> Bool {
  route_registers_one_slot(route: route())
    && route_deregisters_what_it_registered(route: route())
    && route_dispatch_selector_names_the_attempt(route: route(), attempt: attempt)
}

test fn only_the_runner_stages_open_the_network_and_only_default_drop() -> Bool {
  route() |> all(s =>
    match stage_egress(stage: s) {
      Absent =>
        match s {
          BootHostUnderApprovalGate { host: _, boot: _, image: _ } => true
          CollectInstruments { instruments: _ } => true
          _ => false
        }
      Present { value: policy } =>
        (match policy.host.forward { HostChainDefaultDrop => true TapScopedFinalDrop { chain_policy_reason: _ } => false })
          && (match s {
            RegisterEphemeralRunnerSlot { unit: _, labels: _, workspace: _, registration: _ } => true
            DispatchFloorToSlot { workload: _, selector: _, dispatch: _ } => true
            DeregisterRunnerSlot { unit: _, deregistration: _ } => true
            _ => false
          })
    }
  )
}

// THE COHORT IS OWED BY THE ROUTE, NOT ONLY ASSESSED: the collect stage lists the concurrent-cohort seat
// windows and cites product.capacity.cohort_observation seal_cohort as their producer, and the one
// collect-stage frontier stays unbound until the stage that seals a real cohort lands.
test fn the_collect_stage_owes_a_sealed_concurrent_cohort() -> Bool {
  !leg_is_wired(leg: qualification_run_producer_frontier)
    && (route() |> any(s =>
      match s {
        CollectInstruments { instruments: is } =>
          is |> any(i =>
            match i {
              ConcurrentCohortSeatWindows => {
                let p = qualification_instrument_producer(i: i)
                (p.module_path as String) == "product.capacity.cohort_observation" && (p.decl_name as String) == "seal_cohort"
              }
              _ => false
            }
          )
        _ => false
      }
    ))
}

test fn the_collect_stage_owes_the_rate_specimen_and_the_cgroup_rows() -> Bool {
  route() |> any(s =>
    match s {
      CollectInstruments { instruments: is } =>
        (is |> any(i =>
          match i {
            CalibrationSpecimenWitnessLine => {
              let p = qualification_instrument_producer(i: i)
              (p.module_path as String) == "v2.workflow.floor_eval_step_calibration" && (p.decl_name as String) == "floor_eval_step_calibration"
            }
            _ => false
          }
        ))
          && (is |> any(i =>
            match i {
              FloorCgroupRows => {
                let p = qualification_instrument_producer(i: i)
                (p.module_path as String) == "gunbc.host_budget_source" && (p.decl_name as String) == "HostBudgetResolution"
              }
              _ => false
            }
          ))
          && (is |> all(i => {
            let p = qualification_instrument_producer(i: i)
            string_contains(s: qualification_instrument_wire(i: i) as String, pattern: p.decl_name as String)
          }))
      _ => false
    }
  )
}

// THE EPHEMERAL SLOT CARRIES THE FLEET SLOT SHAPE, spelled through the systemd-run authority; under
// SlotCpuQuotaUnbounded no CPUQuota word is emitted, which is the transient unit's own "no ceiling".
test fn the_ephemeral_slot_argv_carries_the_fleet_memory_max() -> Bool {
  let argv = ephemeral_slot_argv(unit: slot_unit(), desired: gunbc_runner_slot_desired(), command_argv: ["/mnt/runner/run.sh"])
  let has_quota_word = argv |> any(w => string_contains(s: w, pattern: "--property=CPUQuota="))
  (argv |> any(w => w == concat("--property=MemoryMax=", byte_size_count(b: gunbc_runner_slot_desired().memory_max) as String)))
    && (match gunbc_runner_slot_desired().cpu_quota {
      SlotCpuQuotaUnbounded => !has_quota_word
      CpuQuotaResolved { threads: t } =>
        argv |> any(w => w == concat("--property=CPUQuota=", concat((hardware_thread_count_value(t: t) * 100) as String, "%")))
    })
}

// THE CLASS LABEL IS READ OFF THE SLOT AUTHORITY, not written here (review 68972 -- the class this
// PR's own failure-mode row names, caught a fourth time in this file). The host and attempt are
// fixture inputs.
test fn the_ephemeral_slot_labels_carry_class_host_and_attempt() -> Bool {
  let labels = ephemeral_slot_labels(host: "mtcollins1", attempt: attempt)
  let class_labels = gunbc_runner_slot_desired().labels.github_labels
  class_labels.length() >= 1
    && (class_labels |> all(c => labels |> any(l => l == c)))
    && (labels |> any(l => l == "mtcollins1")) && (labels |> any(l => l == (attempt as String)))
}

// THE INHABITANCE CLAIMS FOR THE SUPPLIED SELECTION: the fleet's plan fold derives a sound plan
// for the fixture host, and the cores-per-slot policy is a positive width.
test fn the_fixture_selection_is_derived_by_the_fleet_folds() -> Bool {
  (match sound_plan() { FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_build_tokens: _, effective_runner_cpu_cap: _, build_step: _ } => true FleetHostPlanUnsound { reason: _ } => false })
    && hardware_thread_count_value(t: gunbc_runner_cores_per_slot()) >= 1
    && expected_width() >= 1
}
