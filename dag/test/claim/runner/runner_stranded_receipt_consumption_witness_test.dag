module test.claim.runner.runner_stranded_receipt_consumption_witness_test

import std.types { Bool }
import gunbc.runner.runner_host_filtered_egress {
  bridged_topology_rejected_because_it_failed,
  kernel_rebuild_owes_cfs_bandwidth,
  routed_attachment_already_carries_the_guest,
}
import gunbc.runner.runner_cpu_bandwidth_receipt {
  cpu_max_write_previously_refused,
  placement_established_from_both_ends,
  memory_current_at_placement_bytes,
  memory_max_at_placement_bytes,
}

// THE THREE STRANDED RECEIPTS REACH EXECUTION THROUGH THE MODULES THAT USED TO NAME THEM ONLY IN
// ANNOTATIONS. A typecheck of those imports is not this test; reading the folds is.

test fn the_three_stranded_receipts_are_consumed_by_execution() -> Bool {
  bridged_topology_rejected_because_it_failed
    && kernel_rebuild_owes_cfs_bandwidth
    && routed_attachment_already_carries_the_guest
    && cpu_max_write_previously_refused
    && placement_established_from_both_ends
    && memory_current_at_placement_bytes > 0
    && memory_max_at_placement_bytes > memory_current_at_placement_bytes
}
