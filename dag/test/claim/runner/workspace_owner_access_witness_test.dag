module test.claim.runner.workspace_owner_access_witness_test

import std.types { Bool, NonEmptyStr, List }
import v2.std.optional { Absent, Present }
import extdeps.ssh { ssh_public_key_line }
import gunbc.fleet_ssh_access { operator_ssh_principal }
import gunbc.principal_projection { PrincipalRef }
import gunbc.workspace_allocation_admission {
  WorkspaceAuthorizationPolicy, WorkspaceEnrollmentRoster, WorkspaceOwnerEnrollment, WorkspacePublicKeyCatalogRow,
  WorkspacePolicyAdmitted, WorkspacePolicyRefused, workspace_policy_admit,
}
import gunbc.workspace_allocation_policy { workspace_installed_policy, workspace_operator_principal, workspace_operator_public_key_ref }
import gunbc.workspace_microvm { workspace_owner_public_key, WorkspacePublicKeyAdmitted, WorkspacePublicKeyNotAdmitted }

fn alice() -> PrincipalRef { PrincipalRef { authority: "google-oidc", namespace: "accounts", subject: "alice-test" } }
fn bob() -> PrincipalRef { PrincipalRef { authority: "google-oidc", namespace: "accounts", subject: "bob-test" } }

fn alice_row() -> WorkspacePublicKeyCatalogRow { WorkspacePublicKeyCatalogRow { reference: "alice-key", line: "ssh-ed25519 AAAAALICE alice" } }
fn bob_row() -> WorkspacePublicKeyCatalogRow { WorkspacePublicKeyCatalogRow { reference: "bob-key", line: "ssh-ed25519 AAAABOB bob" } }

fn admits(roster: List<WorkspaceOwnerEnrollment>, catalog: List<WorkspacePublicKeyCatalogRow>) -> Bool {
  match workspace_policy_admit(roster: WorkspaceEnrollmentRoster { enrollments: roster }, catalog: catalog) {
    WorkspacePolicyAdmitted { policy: _ } => true
    WorkspacePolicyRefused { reason: _ } => false
  }
}

fn two_owner_policy() -> WorkspaceAuthorizationPolicy? {
  match workspace_policy_admit(roster: WorkspaceEnrollmentRoster { enrollments: [
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" },
    WorkspaceOwnerEnrollment { principal: bob(), public_key_ref: "bob-key" },
  ] }, catalog: [alice_row(), bob_row()]) {
    WorkspacePolicyAdmitted { policy } => Present { value: policy }
    WorkspacePolicyRefused { reason: _ } => none
  }
}

// One enrolled owner with the shared witness reference, admitted through the production join.
// Consumers of this helper match Absent as a failed claim, never as a permissive default.
fn witness_single_owner_policy(owner: PrincipalRef) -> WorkspaceAuthorizationPolicy? {
  match workspace_policy_admit(roster: WorkspaceEnrollmentRoster { enrollments: [WorkspaceOwnerEnrollment { principal: owner, public_key_ref: "witness-key" }] },
    catalog: [WorkspacePublicKeyCatalogRow { reference: "witness-key", line: "ssh-ed25519 AAAAWITNESS witness" }]) {
    WorkspacePolicyAdmitted { policy } => Present { value: policy }
    WorkspacePolicyRefused { reason: _ } => none
  }
}

fn witness_empty_policy() -> WorkspaceAuthorizationPolicy? {
  match workspace_policy_admit(roster: WorkspaceEnrollmentRoster { enrollments: [] }, catalog: []) {
    WorkspacePolicyAdmitted { policy } => Present { value: policy }
    WorkspacePolicyRefused { reason: _ } => none
  }
}

// REDs at the policy join: no list order may decide which enrollment or key line wins.
test fn an_ambiguous_enrollment_roster_is_refused_at_admission() -> Bool {
  let shared_ref = !admits(roster: [
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" },
    WorkspaceOwnerEnrollment { principal: bob(), public_key_ref: "alice-key" },
  ], catalog: [alice_row()])
  let two_refs = !admits(roster: [
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" },
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "bob-key" },
  ], catalog: [alice_row(), bob_row()])
  let duplicate_rows = !admits(roster: [
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" },
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" },
  ], catalog: [alice_row()])
  let dangling_ref = !admits(roster: [WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" }], catalog: [bob_row()])
  let unused_line = !admits(roster: [WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" }], catalog: [alice_row(), bob_row()])
  let two_lines = !admits(roster: [WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" }],
    catalog: [alice_row(), WorkspacePublicKeyCatalogRow { reference: "alice-key", line: "ssh-ed25519 AAAAOTHER other" }])
  let shared_bytes = !admits(roster: [
    WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" },
    WorkspaceOwnerEnrollment { principal: bob(), public_key_ref: "bob-key" },
  ], catalog: [alice_row(), WorkspacePublicKeyCatalogRow { reference: "bob-key", line: "ssh-ed25519 AAAAALICE alice" }])
  shared_ref && two_refs && duplicate_rows && dangling_ref && unused_line && two_lines && shared_bytes
}

// Positive control: two owners with distinct keys admit, and each guest receives its own line.
test fn each_owner_guest_receives_its_own_enrolled_key() -> Bool {
  match two_owner_policy() {
    Absent => false
    Present { value: policy } =>
      (match workspace_owner_public_key(policy: policy, owner: alice(), reference: "alice-key") {
        WorkspacePublicKeyAdmitted { key: k } => (k.line as String) == "ssh-ed25519 AAAAALICE alice"
        WorkspacePublicKeyNotAdmitted { reason: _ } => false
      }) && (match workspace_owner_public_key(policy: policy, owner: bob(), reference: "bob-key") {
        WorkspacePublicKeyAdmitted { key: k } => (k.line as String) == "ssh-ed25519 AAAABOB bob"
        WorkspacePublicKeyNotAdmitted { reason: _ } => false
      })
  }
}

// Discriminating RED: a slot whose incarnation N belonged to alice is reused as N+1 for bob.
// A launch carrying alice's reference for bob's reservation is refused, so the key that reached
// N cannot be installed into N+1; an unenrolled owner and an optioned catalog line refuse too.
test fn a_stale_or_foreign_key_reference_cannot_reach_another_owners_guest() -> Bool {
  match two_owner_policy() {
    Absent => false
    Present { value: policy } => {
      let stale = match workspace_owner_public_key(policy: policy, owner: bob(), reference: "alice-key") {
        WorkspacePublicKeyNotAdmitted { reason: _ } => true
        WorkspacePublicKeyAdmitted { key: _ } => false
      }
      let unenrolled = match workspace_owner_public_key(policy: policy, owner: workspace_operator_principal(), reference: "alice-key") {
        WorkspacePublicKeyNotAdmitted { reason: _ } => true
        WorkspacePublicKeyAdmitted { key: _ } => false
      }
      let optioned = match workspace_policy_admit(roster: WorkspaceEnrollmentRoster { enrollments: [WorkspaceOwnerEnrollment { principal: alice(), public_key_ref: "alice-key" }] },
        catalog: [WorkspacePublicKeyCatalogRow { reference: "alice-key", line: "command=\"sh\" ssh-ed25519 AAAAALICE" }]) {
        WorkspacePolicyRefused { reason: _ } => false
        WorkspacePolicyAdmitted { policy: optioned_policy } => match workspace_owner_public_key(policy: optioned_policy, owner: alice(), reference: "alice-key") {
          WorkspacePublicKeyNotAdmitted { reason: _ } => true
          WorkspacePublicKeyAdmitted { key: _ } => false
        }
      }
      stale && unenrolled && optioned
    }
  }
}

// Inhabitance of the installed route: the shipped roster and catalog admit, and the controller's
// resolver gives the operator exactly the fleet operator key line written into authorized_keys.
test fn installed_policy_resolves_the_operator_enrollment() -> Bool {
  match workspace_installed_policy() {
    WorkspacePolicyRefused { reason: _ } => false
    WorkspacePolicyAdmitted { policy } => match workspace_owner_public_key(policy: policy,
      owner: workspace_operator_principal(), reference: workspace_operator_public_key_ref) {
      WorkspacePublicKeyAdmitted { key: k } => (k.reference as String) == (workspace_operator_public_key_ref as String)
        && (k.line as String) == (ssh_public_key_line(k: operator_ssh_principal.public_key) as String)
      WorkspacePublicKeyNotAdmitted { reason: _ } => false
    }
  }
}
