module test.claim.runner.revision_request_worker_witness

import extdeps.shell
import std.types { Bool, NonEmptyStr }
import std.error_primitives { Result, Ok, Err }
import std.durable_exclusive_hold { DurableHoldOwnerRef }
import product.fabric.identity { FabricIdentity, DemandKey }
import gunbc.host_state_root { isolated_host_state_tree }
import gunbc.runner.runner_revision_request_context { revision_request_context }
import gunbc.runner.runner_revision_request_worker { revision_request_claim, revision_request_claim_is_current, revision_request_claim_wire }
import gunbc.durable_cas_file_store { admit_cas_attempt_for_derived_payload, DerivedPayloadAdmitted, DerivedPayloadKeyNotSlotAddressable, file_compare_and_set, OwnerOnlyCreateOnly }
import std.durable_compare_and_set { ExpectSlotGeneration, CasCommitted }
import gunbc.durable_handoff_host { host_request_submit, HostRequestAccepted }
import test.claim.durable_handoff_request_witness { request_api_key_fixture_prepare_in }
import std.process { ProcessExit }
import gunbc.compile_census_probe { blocking_subject_census, census_verdict, census_exit }

test fn one_durable_acceptance_allows_only_one_worker_claim() -> Bool {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc-worker-claim.XXXXXX").path
  if dir == "" { return false }
  let tree = isolated_host_state_tree(dir: dir as NonEmptyStr)
  if !request_api_key_fixture_prepare_in(tree: tree) { return false }
  let context = match revision_request_context(tree: tree) {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let request = match host_request_submit(root: context.request_root,
    identity: FabricIdentity { principal: "alice", key: "claim-a" as NonEmptyStr as DemandKey }, payload: "accepted-payload") {
    HostRequestAccepted { request: value } => value _ => { return false }
  }
  let worker = "worker-a" as NonEmptyStr as DurableHoldOwnerRef
  let held = match revision_request_claim(context: context, request: request, worker: worker) {
    Err { value: _ } => { return false } Ok { value: value } => value
  }
  let fresh = revision_request_claim_is_current(context: context, claim: held) == Ok { value: true }
  let same = revision_request_claim(context: context, request: request, worker: worker)
  let other = revision_request_claim(context: context, request: request, worker: "worker-b" as NonEmptyStr as DurableHoldOwnerRef)
  // Same payload at a successor generation still invalidates the old claim.
  let verified = match admit_cas_attempt_for_derived_payload(key: held.key,
    expected: ExpectSlotGeneration { generation: held.generation },
    proposed: revision_request_claim_wire(request: request, worker: worker)) {
    DerivedPayloadKeyNotSlotAddressable { key: _ } => { return false }
    DerivedPayloadAdmitted { verified: value } => value
  }
  let advanced = match file_compare_and_set(root: request.root, publication: OwnerOnlyCreateOnly, verified: verified) {
    CasCommitted { committed: _ } => true _ => false
  }
  let stale = match revision_request_claim_is_current(context: context, claim: held) {
    Err { value: _ } => true Ok { value: _ } => false
  }
  fresh && advanced && stale && held.request == request
    && (match same { Err { value: _ } => true Ok { value: _ } => false })
    && (match other { Err { value: _ } => true Ok { value: _ } => false })
}

test fn a_foreign_literal_cannot_mint_a_worker_claim() -> ProcessExit {
  let source = "module probe_revision_request_claim\nimport gunbc.runner.runner_revision_request_worker { RevisionRequestClaim }\nfn f(a: RevisionRequestClaim) -> RevisionRequestClaim { RevisionRequestClaim { request: a.request, worker: a.worker, key: a.key, generation: a.generation } }\n"
  census_exit(census_verdict(census: blocking_subject_census(source: source,
    wanted_class: "SoleConstructorViolation", wanted_subject: "RevisionRequestClaim"), holds: fn(n) { n == 1 }))
}
