module test.claim.runner.runner_user_session_witness

import std.types { Bool, String, List, NonEmptyStr, Int }
import std.algebra { string_contains }
import extdeps.exec.command { argv_words }
import extdeps.systemd.loginctl { loginctl_enable_linger_argv }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv3, operator_host_srv4 }
import gunbc.runner.runner_host_deploy { runner_job_user_session_on, runner_job_user_session_hosts, srv1_runner_host_spec, srv4_runner_host_spec }
import gunbc.runner.runner_registration_labels {
  runner_registration_labels, runner_registration_labels_of_class, RegistrationLabelsResolved, RegistrationLabelsRefused, gunbc_user_session_label,
}
import gunbc.runner.runner_user_session {
  UserSessionAnswer, UserSessionAnswered, UserSessionNotAnswered, user_session_answer_of, user_session_answer_holds,
  UserSessionHostAdmission, UserSessionHostAdmitted, UserSessionHostRefused, user_session_host_admission,
  user_session_enable_linger_command, user_session_readback_command,
}

// THE ROW, THE LABEL AND THE CONVERGE'S ADMISSION READ ONE FACT (gunbc.runner.runner_host_deploy
// runner_job_user_session_hosts). Each control below is paired: the host the row names, and a host it does not.

fn labels_have(labels: List<String>, want: String) -> Bool {
  any(labels, l => l == want)
}

test fn the_user_session_row_names_srv4_and_not_srv1() -> Bool {
  runner_job_user_session_on(host: operator_host_srv4)
    && !runner_job_user_session_on(host: operator_host_srv1)
    && !runner_job_user_session_on(host: operator_host_srv3)
    && runner_job_user_session_hosts.length() == 1
}

test fn the_capability_label_is_derived_for_exactly_the_rows_hosts() -> Bool {
  let on_srv4 = match runner_registration_labels(host: operator_host_srv4) {
    RegistrationLabelsResolved { labels } => labels_have(labels: labels, want: gunbc_user_session_label)
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
  let off_srv1 = match runner_registration_labels(host: operator_host_srv1) {
    RegistrationLabelsResolved { labels } => !labels_have(labels: labels, want: gunbc_user_session_label)
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
  on_srv4 && off_srv1
}

// The deploy slot's class is its runner group's label alone; the capability belongs to the CI job account.
test fn the_deploy_slot_class_does_not_carry_the_capability_label() -> Bool {
  match runner_registration_labels_of_class(host: operator_host_srv4, class_labels: ["gunbc-deploy"]) {
    RegistrationLabelsResolved { labels } => !labels_have(labels: labels, want: gunbc_user_session_label)
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
}

test fn the_converge_admits_a_row_host_and_refuses_any_other() -> Bool {
  let admitted = match user_session_host_admission(host: "srv4" as NonEmptyStr, spec: srv4_runner_host_spec) {
    UserSessionHostAdmitted { job_user: u } => (u as String) == "ghrunner"
    UserSessionHostRefused { cause: _ } => false
  }
  let refused = match user_session_host_admission(host: "srv1" as NonEmptyStr, spec: srv1_runner_host_spec) {
    UserSessionHostAdmitted { job_user: _ } => false
    UserSessionHostRefused { cause: c } => string_contains(s: c, pattern: "runner_job_user_session_hosts")
  }
  admitted && refused
}

// The effect is loginctl_enable_linger_argv over the job user, elevated; no second spelling of the verb.
test fn the_linger_effect_is_the_loginctl_row_elevated() -> Bool {
  let words = argv_words(command: user_session_enable_linger_command(job_user: "ghrunner" as NonEmptyStr))
  let linger = loginctl_enable_linger_argv(subject: "ghrunner" as NonEmptyStr)
  words.length() == linger.length() + 2
    && string_contains(s: join(words, " "), pattern: join(linger, " "))
    && string_contains(s: join(words, " "), pattern: "sudo -n")
}

// The readback is the job's own route: as the job user, the bus bound to /run/user/<uid>.
test fn the_readback_runs_as_the_job_user_over_its_runtime_bus() -> Bool {
  let line = join(argv_words(command: user_session_readback_command(job_user: "ghrunner" as NonEmptyStr, uid: 1001)), " ")
  string_contains(s: line, pattern: "-u ghrunner")
    && string_contains(s: line, pattern: "XDG_RUNTIME_DIR=/run/user/1001")
    && string_contains(s: line, pattern: "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus")
    && string_contains(s: line, pattern: "systemctl --user show-environment")
}

test fn a_manager_reached_over_the_bus_holds() -> Bool {
  user_session_answer_holds(a: user_session_answer_of(exit_code: 0, stderr: ""))
}

// The refusal the fleet runner gave before this converge (instrument-dispatch run 40176427408) is not an answer.
test fn a_client_that_reaches_no_bus_is_not_converged() -> Bool {
  match user_session_answer_of(exit_code: 1, stderr: "Failed to connect to bus: No medium found") {
    UserSessionAnswered => false
    UserSessionNotAnswered { cause: c } => string_contains(s: c, pattern: "No medium found")
  }
}
