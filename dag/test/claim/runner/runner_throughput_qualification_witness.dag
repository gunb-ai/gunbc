data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE INPUTS ARE SUPPLIED AT THE INTERFACE (DESIGN section 3, a witness discriminates at one
// interface). The selection is a fixture the fleet would have made; the observed runs and the
// fleet baseline are minted through `observed_run` and `observed_baseline` -- the one door each
// sealed record has -- from SUBJECT READINGS DECODED FROM A RECORDED REQUIRED RUN
// (test.fixture.recorded_v2_bootstrap_receipts: run 40509253563 on srv3). The baseline is that run as
// recorded; the subject run is the same receipts re-bounded to the attempt's unit, so its walls and
// peak are a real floor's, and every claim below varies one fact of it. No run executes here. The
// pairing obligation is the producer frontier, asserted unbound below rather than faked with a fixture
// run. A DIRECTLY AUTHORED ADMITTED DISPOSITION IS NOT WRITABLE: `RunnerThroughputAssessment` is
// sole_constructor, so every assessment below reaches the fabric through `assess_runner_throughput`.

data pin_revision: String = recorded_v2_bootstrap_head_sha
data attempt: NonEmptyStr = "mtcollins1-qual-1" as NonEmptyStr
data run_a: GitHubWorkflowRunId = GitHubWorkflowRunId { value: 35447067113 }
data run_b: GitHubWorkflowRunId = GitHubWorkflowRunId { value: 35447067114 }

fn pin() -> FloorWorkloadPin {
  FloorWorkloadPin {
    program: "gunbc.witness.compiler_gate_workflow v2-bootstrap" as NonEmptyStr,
    revision: pin_revision,
  }
}

// THE HOST FIXTURE IS CONTROLLED; THE SLOT SHAPE IS LIVE. The selected plan is the fleet's own
// fold over sound inputs (oomd verified, headroom at the oomd floor),
// and every expected width below is derived through that plan and the live slot rather than
// written as a number (reviews 68620, 68731).
fn fixture_host_total() -> Int {
  268435456000
}

fn fixture_host_available_idle() -> Int {
  263066746880
}

fn sound_plan() -> FleetHostPlan {
  let total = byte_size(count: fixture_host_total())
  fleet_host_plan_for(
    name: "mtcollins1",
    host: total,
    overhead: byte_size(count: fixture_host_total() - fixture_host_available_idle()),
    nproc: hardware_thread_count(count: 160),
    runner: gha_runner_container,
    session_slice: byte_size(count: 0),
    policy: HeadroomSet { bytes: oomd_actuation_floor(host: total) },
    oomd: OomdEnforced,
  )
}

fn expected_width() -> Int {
  match sound_plan() {
    FleetHostPlanUnsound { reason: _ } => 0
    FleetHostPlanDerived {
      name: _, tree: _, runner_slice_cap: slice,
      effective_runner_cpu_cap: cap,
    } => {
      let by_memory = byte_size_count(b: slice) / byte_size_count(b: gunbc_runner_slot_desired().memory_max)
      let by_cpu = hardware_thread_count_value(t: cap) / hardware_thread_count_value(t: gunbc_runner_cores_per_slot())
      if by_cpu < by_memory { by_cpu } else { by_memory }
    }
  }
}

fn owned_route() -> ProviderRoute {
  ProviderRoute {
    provider: decl_ref(module_path: "gunbc.fleet.fleet_host_identity", decl_name: "operator_host_mtcollins1"),
    service: decl_ref(module_path: "gunbc.floor.floor_demand", decl_name: "floor_execution_requirements"),
    region: decl_ref(module_path: "gunbc.hostname_allocation", decl_name: "gunbc_fleet_hostname_allocations"),
  }
}

// THE SELECTED OFFER IS AN INPUT. Nothing here derives it from a measurement; it is what the fleet
// selected to be assessed, and the assessment is bound to its identity.
fn selected_offer(key: String) -> SupplierOffer<HostIdentity> {
  selected_offer_stating(key: key, architecture: Present { value: Aarch64 })
}

fn selected_offer_stating(key: String, architecture: Architecture?) -> SupplierOffer<HostIdentity> {
  SupplierOffer {
    id: FabricIdentity { principal: "mtcollins1", key: key },
    executor: "mtcollins1",
    route: owned_route(),
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(count: 160) },
      envelope: cpu_memory_envelope(
        min_threads: hardware_thread_count(count: 160),
        architecture: architecture,
        min_bytes: gunbc_runner_slot_desired().memory_max,
      ),
    },
    capabilities: "gunbc.capabilities.linux-rust-toolchain",
    trust_domain: "gunbc.trust.internal-fleet",
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: expected_width(),
    ready_at: "2026-09-19T12:00:00Z",
    quote: QuotedPerSecond(MoneyPerSecond { amount: money_amount_micro(count: 0), currency: Usd }),
    billing_quantum: second(count: 0),
    evidence: ObservedSupply { observed_at: "2026-09-19T12:00:00Z", receipt: "gunbc.runner.runner_throughput_qualification fixture" },
  }
}

fn slot_unit() -> NonEmptyStr {
  ephemeral_slot_unit(host: "mtcollins1", attempt: attempt)
}

fn control_plane_sanction() -> ExecutorSanction {
  ExecutorSanctioned { executor: "mtcollins1" as NonEmptyStr, sanctioned: ControlPlaneCapacity }
}


// THE SELECTION IS MADE BY THE FLEET'S SELECTION FOLD from the fleet's own authorities -- the live
// slot shape, the plan fold, the conservation verdict -- never assembled by hand here.
// THE SELECTED RUNTIME, and the observed run below reads the same row, so a join failure on either
// runtime axis is the variation a claim introduced and never a spelling drift between two literals.
data fixture_runtime: SelectedRunnerRuntime = SelectedRunnerRuntime {
  image_digest: "sha256:fixture-image" as NonEmptyStr,
  runtime_closure: "gunbc.toolchain.rust-1.93.0+clippy+rustfmt" as NonEmptyStr,
}

// THE WALL ALLOWANCE IS A POLICY INPUT THE SELECTION SUPPLIES, a ratio and never a wall: a subject step may take at
// most 5/4 of the same step's wall on the baseline host.
data fixture_wall_allowance: BaselineWallAllowance = BaselineWallAllowance { numerator: 5, denominator: 4 }

fn inputs_with(sampling: SamplingPolicy, plan: FleetHostPlan, allocation: HostAllocationVerdict) -> RunnerQualificationInputs<HostIdentity> {
  inputs_offered(offer: selected_offer(key: "offer-mtcollins1-qual-1"), sampling: sampling, plan: plan, allocation: allocation)
}

fn inputs_offered(offer: SupplierOffer<HostIdentity>, sampling: SamplingPolicy, plan: FleetHostPlan, allocation: HostAllocationVerdict) -> RunnerQualificationInputs<HostIdentity> {
  select_runner_qualification(
    offer: offer,
    host: "mtcollins1",
    executor_sanction: control_plane_sanction(),
    requirements: floor_execution_requirements(),
    workload: pin(),
    runtime: fixture_runtime,
    plan: plan,
    allocation: allocation,
    slot: gunbc_runner_slot_desired(),
    unit: slot_unit(),
    workspace: mtcollins1_qualification_workspace_backing,
    sampling: sampling,
    wall_allowance: fixture_wall_allowance,
  )
}

fn selection_with(sampling: SamplingPolicy, plan: FleetHostPlan, allocation: HostAllocationVerdict) -> SelectedRunnerQualification<HostIdentity> {
  inputs_with(sampling: sampling, plan: plan, allocation: allocation).selection
}

fn selection() -> SelectedRunnerQualification<HostIdentity> {
  selection_with(sampling: ConservativePerAxis { minimum_runs: 1 }, plan: sound_plan(), allocation: HostAllocationConserves)
}

// ── subject readings, decoded from the recorded run ───────────────────────────────────────────

fn recorded_job() -> WorkflowJobRun {
  WorkflowJobRun {
    id: 122206492701, run_id: 40509253563, run_attempt: 1, name: "v2-bootstrap", status: Completed,
    conclusion: Present { value: Success }, labels: [], runner_id: none, runner_name: none,
    created_at: none, started_at: none, completed_at: none, steps: Present { value: recorded_v2_bootstrap_subject_steps },
  }
}

// A LOG THAT DOES NOT DECODE READS AS NO SUBJECT STEP, which the bound axis refuses by name, so a fixture that stopped
// decoding turns the positive control red rather than passing vacuously.
fn readings_of(log: String, unit: NonEmptyStr) -> List<SubjectStepReading> {
  match subject_readings_of(job: recorded_job(), log: log, slot_unit: unit, rows: emitted_subject_build_rows()) {
    SubjectReadingsRead { readings: rs } => rs
    SubjectReadingsRefused { refusal: _ } => []
  }
}

// THE RECORDED RECEIPTS, RE-BOUNDED TO THE ATTEMPT'S UNIT: the only edit is the unit at the tail of each cgroup path.
fn attempt_log() -> String {
  replace(s: recorded_v2_bootstrap_receipt_log, from: concat("/", recorded_v2_bootstrap_slot_unit), to: concat("/", slot_unit() as String))
}

fn attempt_log_with(from: String, to: String) -> String {
  replace(s: attempt_log(), from: from, to: to)
}

fn subject_readings() -> List<SubjectStepReading> {
  readings_of(log: attempt_log(), unit: slot_unit())
}

fn with_wall(r: SubjectStepReading, seconds: Int) -> SubjectStepReading {
  SubjectStepReading { row: r.row, wall: second(count: seconds), receipt: r.receipt }
}

fn label_of(r: SubjectStepReading) -> String {
  emitted_subject_build_label_text(row: r.row)
}

fn first_label() -> String {
  match subject_readings().first() {
    Present { value: r } => label_of(r: r)
    Absent => ""
  }
}

// THE BASELINE: the recorded run itself, on srv3 at its own slot, at the pinned revision.
fn baseline_at(host: HostIdentity, revision: String, subjects: List<SubjectStepReading>) -> FleetBaselineRun {
  observed_baseline(
    run: GitHubWorkflowRunId { value: 40509253563 }, host: host, revision: revision,
    slot_unit: recorded_v2_bootstrap_slot_unit as NonEmptyStr, subjects: subjects,
  )
}

fn baseline_readings() -> List<SubjectStepReading> {
  readings_of(log: recorded_v2_bootstrap_receipt_log, unit: recorded_v2_bootstrap_slot_unit as NonEmptyStr)
}

fn baseline() -> FleetBaselineRun {
  baseline_at(host: "srv3", revision: pin_revision, subjects: baseline_readings())
}

// ── observed runs, minted through the sealed record's one door ────────────────────────────────

fn slot_high() -> ByteSize {
  gunbc_runner_slot_desired().memory_high
}

fn effective_as_selected() -> EffectiveSlotProperties {
  let d = gunbc_runner_slot_desired()
  EffectiveSlotProperties { memory_max: d.memory_max, memory_high: d.memory_high, tasks_max: d.tasks_max, cpu_quota_threads: slot_quota_threads(quota: d.cpu_quota) }
}

fn effective_with_high(high: ByteSize) -> EffectiveSlotProperties {
  let d = gunbc_runner_slot_desired()
  EffectiveSlotProperties { memory_max: d.memory_max, memory_high: high, tasks_max: d.tasks_max, cpu_quota_threads: slot_quota_threads(quota: d.cpu_quota) }
}

// THE PARAMETERS ARE THE AXES THE CLAIMS VARY, one at a time, from a run that joins on every axis
// and meets every standing: the recorded floor's subject steps at the attempt's unit, the selected
// unit's effective properties, tmpfs on the subject.
fn run_with(
  id: GitHubWorkflowRunId,
  host: HostIdentity,
  effective: EffectiveSlotProperties,
  workspace: WorkspaceBytesLocus,
  subjects: List<SubjectStepReading>,
) -> ObservedRunnerQualificationRun {
  observed_run(
    run: id,
    attempt_label: attempt,
    observed_at: "2026-10-27T13:39:43Z",
    host: host,
    program: pin().program,
    revision: pin_revision,
    image_digest: fixture_runtime.image_digest,
    runtime_closure: fixture_runtime.runtime_closure,
    slot_unit: slot_unit(),
    incarnation: "1" as NonEmptyStr,
    effective: effective,
    host_threads: hardware_thread_count(count: 160),
    host_architecture: Aarch64,
    workspace: workspace,
    subjects: subjects,
  )
}

fn good_run(id: GitHubWorkflowRunId) -> ObservedRunnerQualificationRun {
  varied_run(id: id, subjects: subject_readings())
}

fn varied_run(id: GitHubWorkflowRunId, subjects: List<SubjectStepReading>) -> ObservedRunnerQualificationRun {
  run_with(id: id, host: "mtcollins1", effective: effective_as_selected(), workspace: OnSubjectChargedToSlot, subjects: subjects)
}

fn first_join_axis(refusals: List<ThroughputRefusal>) -> String {
  fold(refusals, init: "", f: (acc, r) =>
    if acc != "" { acc } else {
      match r {
        SubjectJoinDidNotHold { join: j } =>
          match j {
            SubjectJoinRefused { run: _, axis: a, selected: _, observed: _ } => subject_join_axis_wire(a: a)
            SubjectJoined => ""
          }
        _ => ""
      }
    }
  )
}

// COVERAGE IS AN IDENTITY JOIN, NOT A COUNT (DESIGN section 5; review 68995): the assessed facts
// must be exactly the named arms, each once.
fn fact_is(a: AssessedFact, b: AssessedFact) -> Bool {
  match a {
    SlotMemoryEnvelope => match b { SlotMemoryEnvelope => true _ => false }
    SubjectWallsAgainstFleetBaseline => match b { SubjectWallsAgainstFleetBaseline => true _ => false }
    ConcurrentCohortAtWidth => match b { ConcurrentCohortAtWidth => true _ => false }
  }
}

fn has_fact_once(facts: List<AssessedFact>, want: AssessedFact) -> Bool {
  (facts |> filter(f => fact_is(a: f, b: want))).length() == 1
}

fn covers_memory_walls_and_cohort(facts: List<AssessedFact>) -> Bool {
  facts.length() == 3 && has_fact_once(facts: facts, want: SlotMemoryEnvelope)
    && has_fact_once(facts: facts, want: SubjectWallsAgainstFleetBaseline) && has_fact_once(facts: facts, want: ConcurrentCohortAtWidth)
}

// ── the concurrent cohort ─────────────────────────────────────────────────────────────────────
//
// A DELIVERING ASSESSMENT NEEDS A SEALED COHORT AT THE DERIVED WIDTH, so the delivering claims below
// run through assess_at_width: the claim's own runs PLUS one good run per seat, and a cohort of exactly
// expected_width() seats, all active over [20, 40], each seat one of those assessed runs. The seats are
// good runs, so the memory and wall aggregates the claims read are the good run's either way.
// Claims about a refusal on some other axis run through assess_unobserved, where the missing cohort is
// one more refusal beside the one the claim reads.
fn t(n: Nat) -> ObservationInstant { ObservationInstant { domain: SharedMonotonic { origin: "mtcollins1-boot" as NonEmptyStr }, basis: WallClock, since_origin: nanosecond(count: n) } }

fn seat_ids(n: Int) -> List<GitHubWorkflowRunId> {
  map(nat_range_inclusive(lo: 1, hi: n), i => GitHubWorkflowRunId { value: 35447067200 + i })
}

fn seat_reading(id: GitHubWorkflowRunId, settlement: SeatSettlement) -> CohortSeatReading<GitHubWorkflowRunId> {
  CohortSeatReading {
    seat: id, source: AttemptOccurrenceId { attempt: "cohort-1" as NonEmptyStr, id: github_workflow_run_id_wire_text(id: id) as NonEmptyStr },
    ready_at: t(n: 5), started_at: t(n: 20), ended_at: t(n: 40), settlement: settlement,
  }
}

fn cohort_of(seats: List<CohortSeatReading<GitHubWorkflowRunId>>) -> RunnerCohortEvidence {
  CohortObserved {
    seal: seal_cohort(
      reading: CohortReading {
        roster: map(seats, s => s.seat), barrier_released_at: t(n: 10), host_window_from: t(n: 0), host_window_to: t(n: 100),
        host_source: AttemptOccurrenceId { attempt: "cohort-1" as NonEmptyStr, id: "host" as NonEmptyStr }, seats: seats,
      },
      seat_key: run_key,
    ),
  }
}

fn cohort_runs(ids: List<GitHubWorkflowRunId>) -> List<ObservedRunnerQualificationRun> {
  map(ids, id => good_run(id: id))
}


fn assess_at_width(selection: SelectedRunnerQualification<HostIdentity>, runs: List<ObservedRunnerQualificationRun>) -> RunnerThroughputAssessment<HostIdentity> {
  let ids = seat_ids(n: expected_width())
  assess_runner_throughput(selection: selection, runs: concat(runs, cohort_runs(ids: ids)), baseline: baseline(), cohort: cohort_of(seats: map(ids, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded }))))
}

fn assess_unobserved(selection: SelectedRunnerQualification<HostIdentity>, runs: List<ObservedRunnerQualificationRun>) -> RunnerThroughputAssessment<HostIdentity> {
  assess_runner_throughput(selection: selection, runs: runs, baseline: baseline(), cohort: NoCohortObserved)
}

fn assess_against(baseline: FleetBaselineRun, runs: List<ObservedRunnerQualificationRun>) -> RunnerThroughputAssessment<HostIdentity> {
  assess_runner_throughput(selection: selection(), runs: runs, baseline: baseline, cohort: NoCohortObserved)
}

fn concurrency_is(a: RunnerThroughputAssessment<HostIdentity>, want: String) -> Bool {
  !assessment_holds(a: a) && string_contains(s: assessment_wire(a: a) as String, pattern: want)
}

fn sampling_refused(a: RunnerThroughputAssessment<HostIdentity>) -> Bool {
  a.refusals |> any(r => match r { SamplingDidNotHold { policy: _, observed_runs: _ } => true _ => false })
}

// ── the fixtures are the recorded floor's ─────────────────────────────────────────────────────

// THE FIXTURES ARE NOT VACUOUS: the subject run and the baseline each decode one reading per subject row of today's
// gate, and the subject's are the baseline's at the attempt's unit -- the same walls (813 s, 870 s) and the same peak.
test fn the_subject_and_baseline_readings_decode_from_the_recorded_run() -> Bool {
  let s = subject_readings()
  let b = baseline_readings()
  count(s) == count(emitted_subject_build_rows()) && count(b) == count(s) && count(s) >= 1
    && join(map(s, r => second_count(r.wall) as String), ",") == join(map(b, r => second_count(r.wall) as String), ",")
    && (s |> all(r => string_contains(s: r.receipt.cgroup as String, pattern: slot_unit() as String)))
}

// ── the positive control ──────────────────────────────────────────────────────────────────────

test fn a_joining_run_meeting_every_axis_makes_the_offer_deliver() -> Bool {
  let a = assess_at_width(selection: selection(), runs: [good_run(id: run_a)])
  assessment_holds(a: a)
    && (match a.memory {
      PeakWithinSlotHigh { peak: p, high: h } => byte_size_count(b: p) == 14481920000 && byte_size_count(b: h) == byte_size_count(b: slot_high())
      _ => false
    })
    && (match a.subject_walls { SubjectWallsWithinBaseline => true _ => false })
    && (match a.subject_roster { SubjectRosterComplete => true _ => false })
    && (match a.slot_width {
      SlotWidthDerived { by_memory: _, by_cpu: _, slots: n } => n == expected_width() && n >= 1
      SlotWidthUnderivable { cause: _ } => false
    })
    && covers_memory_walls_and_cohort(facts: a.assessed_facts)
}

// ── the subject join REDs (operator hold, item 2) ─────────────────────────────────────────────

test fn a_run_from_another_host_is_refused_on_the_host_axis() -> Bool {
  let r = run_with(id: run_a, host: "srv3", effective: effective_as_selected(), workspace: OnSubjectChargedToSlot, subjects: subject_readings())
  let a = assess_unobserved(selection: selection(), runs: [r])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == "host"
    && (match a.memory { MemoryUnread { reason: _ } => true _ => false })
    && a.assessed_facts.length() == 0
}

// THE GOOD RUN WITH ONLY ITS RUNTIME AND HOST FACTS REPLACED, so each claim below varies exactly one.
fn good_run_in(image_digest: NonEmptyStr, runtime_closure: NonEmptyStr, host_threads: HardwareThreadCount, host_architecture: Architecture) -> ObservedRunnerQualificationRun {
  let g = good_run(id: run_a)
  observed_run(
    run: g.run, attempt_label: g.attempt_label, observed_at: g.observed_at, host: g.host,
    program: g.program, revision: g.revision,
    image_digest: image_digest, runtime_closure: runtime_closure,
    slot_unit: g.slot_unit, incarnation: g.incarnation, effective: g.effective,
    host_threads: host_threads, host_architecture: host_architecture, workspace: g.workspace,
    subjects: g.subjects,
  )
}

fn refused_on(selection: SelectedRunnerQualification<HostIdentity>, run: ObservedRunnerQualificationRun, axis: String) -> Bool {
  let a = assess_unobserved(selection: selection, runs: [run])
  !assessment_holds(a: a) && first_join_axis(refusals: a.refusals) == axis && a.assessed_facts.length() == 0
}

// THE RUNTIME AND HOST FACTS EACH REFUSE ALONE. Every run below is the good run with one fact changed, and the good
// run itself still joins, so a claim that passes here is about that axis and nothing else.
test fn a_run_in_another_image_or_toolchain_is_refused_on_its_runtime_axis() -> Bool {
  let t = hardware_thread_count(count: 160)
  assessment_holds(a: assess_at_width(selection: selection(), runs: [good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: fixture_runtime.runtime_closure, host_threads: t, host_architecture: Aarch64)]))
    && refused_on(selection: selection(), run: good_run_in(image_digest: "sha256:another-image" as NonEmptyStr, runtime_closure: fixture_runtime.runtime_closure, host_threads: t, host_architecture: Aarch64), axis: "image digest")
    && refused_on(selection: selection(), run: good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: "gunbc.toolchain.rust-1.92.0" as NonEmptyStr, host_threads: t, host_architecture: Aarch64), axis: "runtime closure")
}

test fn a_run_on_another_host_shape_is_refused_on_its_host_axis() -> Bool {
  refused_on(selection: selection(), run: good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: fixture_runtime.runtime_closure, host_threads: hardware_thread_count(count: 80), host_architecture: Aarch64), axis: "host threads")
    && refused_on(selection: selection(), run: good_run_in(image_digest: fixture_runtime.image_digest, runtime_closure: fixture_runtime.runtime_closure, host_threads: hardware_thread_count(count: 160), host_architecture: X86_64), axis: "host architecture")
}

// AN OFFER THAT STATES NO ARCHITECTURE ADMITS NONE: the good run, unchanged, refuses on the axis.
test fn an_offer_stating_no_architecture_refuses_the_architecture_join() -> Bool {
  let s = inputs_offered(
    offer: selected_offer_stating(key: "offer-mtcollins1-qual-1", architecture: Absent),
    sampling: ConservativePerAxis { minimum_runs: 1 }, plan: sound_plan(), allocation: HostAllocationConserves,
  ).selection
  refused_on(selection: s, run: good_run(id: run_a), axis: "host architecture")
}

test fn a_unit_whose_effective_high_is_not_the_selected_high_is_refused() -> Bool {
  let other = byte_size(count: byte_size_count(b: slot_high()) + 1073741824)
  let r = run_with(id: run_a, host: "mtcollins1", effective: effective_with_high(high: other), workspace: OnSubjectChargedToSlot, subjects: subject_readings())
  refused_on(selection: selection(), run: r, axis: "effective MemoryHigh")
}

// A RECEIPT BOUNDED BY ANOTHER HIGH MEASURED ANOTHER ENVELOPE, and a run with no subject step read carries no receipt
// at all: both refuse on the bound axis, never as a run with no memory.
test fn a_receipt_under_another_high_or_no_receipt_is_refused_on_the_bound_axis() -> Bool {
  let want = byte_size_count(b: slot_high()) as String
  let other = readings_of(log: attempt_log_with(from: concat("limit_high=", want), to: "limit_high=21474836480"), unit: slot_unit())
  let unlimited = readings_of(log: attempt_log_with(from: concat("limit_high=", want), to: "limit_high=max"), unit: slot_unit())
  count(other) == count(subject_readings()) && count(unlimited) == count(subject_readings())
    && refused_on(selection: selection(), run: varied_run(id: run_a, subjects: other), axis: "cgroup bound")
    && refused_on(selection: selection(), run: varied_run(id: run_a, subjects: unlimited), axis: "cgroup bound")
    && refused_on(selection: selection(), run: varied_run(id: run_a, subjects: []), axis: "cgroup bound")
}

test fn a_workspace_read_off_the_subject_is_refused_on_the_workspace_axis() -> Bool {
  let r = run_with(id: run_a, host: "mtcollins1", effective: effective_as_selected(), workspace: OnSubjectUncharged, subjects: subject_readings())
  refused_on(selection: selection(), run: r, axis: "workspace locus")
    && (match workspace_bytes_locus(backing: PeerScratchExport { peer: "srv2" }) { OffSubject { peer: p } => (p as String) == "srv2" _ => false })
}

// ── the memory envelope (operator decision A, condition 2) ────────────────────────────────────

// RED: AN OOM KILL OR RESIDENT SWAP, PRINTED WITH ITS SENTENCE, REFUSES THE QUALIFICATION as a violated envelope naming
// the subject and carrying the envelope verdict; the unmutated receipts (the positive control) hold.
data violated_sentence: String = "gunbc test: MEMORY ENVELOPE VIOLATED cause=MemoryEnvelopeViolated -- see the receipt. gunbc test: MEMORY RECEIPT"

fn assessed_with(log: String) -> RunnerThroughputAssessment<HostIdentity> {
  assess_at_width(selection: selection(), runs: [varied_run(id: run_a, subjects: readings_of(log: log, unit: slot_unit()))])
}

fn printed_violation(from: String, to: String) -> String {
  replace(s: attempt_log_with(from: from, to: to), from: "gunbc test: MEMORY RECEIPT", to: violated_sentence)
}

fn violated_by(from: String, to: String) -> Bool {
  let a = assessed_with(log: printed_violation(from: from, to: to))
  !assessment_holds(a: a)
    && (match a.memory { MemoryEnvelopeViolatedAt { subject: s, verdict: _ } => (s as String) == first_label() _ => false })
}

test fn an_oom_kill_or_resident_swap_refuses_the_qualification() -> Bool {
  violated_by(from: "oom_kills_delta=0", to: "oom_kills_delta=1")
    && violated_by(from: "swap_current_bytes=0", to: "swap_current_bytes=4096")
}

// A RECEIPT THAT DISAGREES WITH ITS OWN NUMBERS IS ITS OWN FINDING (review 86993), never folded into a violation: numbers
// that violate with no sentence, and a sentence over clean numbers, each refuse as MemoryReceiptDisagreesAt with the
// side that was printed.
test fn a_receipt_disagreeing_with_its_numbers_refuses_as_its_own_finding() -> Bool {
  let unprinted = assessed_with(log: attempt_log_with(from: "oom_kills_delta=0", to: "oom_kills_delta=1"))
  let unfounded = assessed_with(log: replace(s: attempt_log(), from: "gunbc test: MEMORY RECEIPT", to: violated_sentence))
  !assessment_holds(a: unprinted) && !assessment_holds(a: unfounded)
    && (match unprinted.memory { MemoryReceiptDisagreesAt { subject: s, printed_violated: p, verdict: _ } => (s as String) == first_label() && !p _ => false })
    && (match unfounded.memory { MemoryReceiptDisagreesAt { subject: _, printed_violated: p, verdict: _ } => p _ => false })
}

// RED: A SUBJECT WHOSE RECEIPT IS MISSING IS NEVER A RUN. The decoder refuses the job (one receipt for two subjects),
// so no observed run is minted from it; a run carrying only one subject's reading refuses on the roster.
test fn a_missing_receipt_refuses_the_qualification() -> Bool {
  let first_line = match split(s: attempt_log(), delimiter: "\n").first() { Present { value: l } => l Absent => "" }
  let decoded = subject_readings_of(job: recorded_job(), log: first_line, slot_unit: slot_unit(), rows: emitted_subject_build_rows())
  let one = subject_readings() |> filter(r => label_of(r: r) == first_label())
  let a = assess_at_width(selection: selection(), runs: [varied_run(id: run_a, subjects: one)])
  (match decoded { SubjectReadingsRefused { refusal: SubjectReceiptCountDiffers { receipts: 1, subjects: _ } } => true _ => false })
    && count(one) == 1 && count(subject_readings()) >= 2
    && !assessment_holds(a: a)
    && (match a.subject_roster { SubjectMissing { subject: _ } => true _ => false })
}

test fn a_subject_read_twice_refuses_the_roster() -> Bool {
  let twice = concat(subject_readings(), subject_readings() |> filter(r => label_of(r: r) == first_label()))
  let a = assess_at_width(selection: selection(), runs: [varied_run(id: run_a, subjects: twice)])
  !assessment_holds(a: a) && (match a.subject_roster { SubjectDuplicated { subject: s } => (s as String) == first_label() _ => false })
}

// ── aggregation REDs (operator hold, item 3) ──────────────────────────────────────────────────

// RUN B'S PEAK REACHES memory.high; RUN A IS THE RECORDED CLEAN RUN. The host must not deliver: memory takes the
// maximum peak over every subject step of every run, so the clean run cannot hide the pinned one.
test fn a_run_that_pinned_the_high_line_is_not_hidden_by_a_clean_run() -> Bool {
  let high = byte_size_count(b: slot_high()) as String
  let pinned = readings_of(log: attempt_log_with(from: "peak_bytes=14481920000", to: concat("peak_bytes=", high)), unit: slot_unit())
  let a = assess_unobserved(selection: selection(), runs: [good_run(id: run_a), varied_run(id: run_b, subjects: pinned)])
  count(pinned) == count(subject_readings()) && !assessment_holds(a: a)
    && (match a.memory { PeakExceedsSlotHigh { peak: p, high: h } => byte_size_count(b: p) == byte_size_count(b: h) _ => false })
}

test fn the_sampling_policy_refuses_a_sample_of_the_wrong_size() -> Bool {
  let one = selection_with(sampling: ExactlyOneReconciledRun, plan: sound_plan(), allocation: HostAllocationConserves)
  let two = assess_unobserved(selection: one, runs: [good_run(id: run_a), good_run(id: run_b)])
  let zero = assess_unobserved(selection: selection(), runs: [])
  sampling_refused(a: two) && sampling_refused(a: zero) && !assessment_holds(a: zero)
}

// ── subject walls against the fleet baseline (operator decision A, condition 1) ──────────────

// THE ALLOWANCE IS A RATIO OVER TWO OBSERVED WALLS: the first subject's baseline wall is the recorded one, so the
// subject may take at most 5/4 of it. At the bound it holds; one second over, it refuses and carries both walls.
fn first_scaled(n: Int) -> List<SubjectStepReading> {
  subject_readings() |> map(r => if label_of(r: r) == first_label() { with_wall(r: r, seconds: n) } else { r })
}

fn first_baseline_wall() -> Int {
  match baseline_readings() |> filter(r => label_of(r: r) == first_label()) |> first() {
    Present { value: r } => second_count(r.wall) as Int
    Absent => 0
  }
}

test fn a_subject_wall_over_the_baseline_allowance_refuses_and_at_the_bound_holds() -> Bool {
  let b = first_baseline_wall()
  let bound = b * 5 / 4
  let at = assess_at_width(selection: selection(), runs: [varied_run(id: run_a, subjects: first_scaled(n: bound))])
  let over = assess_at_width(selection: selection(), runs: [varied_run(id: run_a, subjects: first_scaled(n: bound + 1))])
  b == 813 && assessment_holds(a: at)
    && !assessment_holds(a: over)
    && (match over.subject_walls {
      SubjectWallExceedsBaseline { subject: s, wall: w, baseline: bw, allowance: _ } =>
        (s as String) == first_label() && (second_count(w) as Int) == bound + 1 && (second_count(bw) as Int) == b
      _ => false
    })
}

// A BASELINE THAT IS NOT ABOUT THE SAME WORK ON ANOTHER HOST IS NOT A BASELINE: one taken on the subject host itself,
// at another revision, or missing a subject each refuses by name, though the subject run is the good run.
test fn a_baseline_on_the_subject_host_at_another_revision_or_missing_a_subject_refuses() -> Bool {
  let on_subject = assess_against(baseline: baseline_at(host: "mtcollins1", revision: pin_revision, subjects: baseline_readings()), runs: [good_run(id: run_a)])
  let other_rev = assess_against(baseline: baseline_at(host: "srv3", revision: "43643bad4f0000000000000000000000000000ab", subjects: baseline_readings()), runs: [good_run(id: run_a)])
  let partial = assess_against(baseline: baseline_at(host: "srv3", revision: pin_revision, subjects: baseline_readings() |> filter(r => label_of(r: r) != first_label())), runs: [good_run(id: run_a)])
  (match on_subject.subject_walls { BaselineOnTheSubjectHost { host: h } => (h as String) == "mtcollins1" _ => false })
    && (match other_rev.subject_walls { BaselineAtAnotherRevision { selected: _, baseline: _ } => true _ => false })
    && (match partial.subject_walls { BaselineMissingSubject { subject: s } => (s as String) == first_label() _ => false })
    && !assessment_holds(a: on_subject) && !assessment_holds(a: other_rev) && !assessment_holds(a: partial)
}

// THE WIDTH IS OBSERVED, NOT ONLY DIVIDED. Every run below is the good run; what varies is the cohort.
// No cohort, a cohort one seat short of the width, a seat that failed, a seat that is not one of the
// assessed runs, and a cohort whose seats were never all active each refuse delivery by name, while
// assess_at_width -- the same runs and a full cohort -- delivers (the positive control above).
test fn delivery_needs_a_sealed_concurrent_cohort_at_the_derived_width() -> Bool {
  let w = expected_width()
  let ids = seat_ids(n: w)
  let runs = cohort_runs(ids: ids)
  let short = seat_ids(n: w - 1)
  let failed = map(ids, id => if id.value == 35447067201 { seat_reading(id: id, settlement: SeatSettledAs { settled: SeatFailed { cause: "floor phase refused" as NonEmptyStr } }) } else { seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded }) })
  let stranger = concat(map(short, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded })), [seat_reading(id: GitHubWorkflowRunId { value: 35447099999 }, settlement: SeatSettledAs { settled: SeatSucceeded })])
  let apart = map(ids, id => if id.value == 35447067201 { CohortSeatReading { seat: id, source: AttemptOccurrenceId { attempt: "cohort-1" as NonEmptyStr, id: github_workflow_run_id_wire_text(id: id) as NonEmptyStr }, ready_at: t(n: 5), started_at: t(n: 50), ended_at: t(n: 60), settlement: SeatSettledAs { settled: SeatSucceeded } } } else { seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded }) })
  w >= 2
    && concurrency_is(a: assess_unobserved(selection: selection(), runs: runs), want: "no concurrent cohort was observed")
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, baseline: baseline(), cohort: cohort_of(seats: map(short, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded })))), want: join(["the cohort ran ", (w - 1) as String, " seats but the derived width is ", w as String], ""))
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, baseline: baseline(), cohort: cohort_of(seats: failed)), want: "cohort seat 35447067201 failed: floor phase refused")
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, baseline: baseline(), cohort: cohort_of(seats: stranger)), want: "a cohort seat is not one of the assessed runs: 35447099999")
    && concurrency_is(a: assess_runner_throughput(selection: selection(), runs: runs, baseline: baseline(), cohort: cohort_of(seats: apart)), want: "the seats were never all active at once")
    && assessment_holds(a: assess_runner_throughput(selection: selection(), runs: runs, baseline: baseline(), cohort: cohort_of(seats: map(ids, id => seat_reading(id: id, settlement: SeatSettledAs { settled: SeatSucceeded })))))
}

// THE WIDTH IS READ OFF THE SELECTED PLAN AND ALLOCATION (operator hold, item 4): an oversubscribed
// allocation or a plan the fleet refused derives no width and no delivery.
test fn a_refused_or_oversubscribed_selected_allocation_derives_no_width() -> Bool {
  let oversubscribed = selection_with(sampling: ConservativePerAxis { minimum_runs: 1 }, plan: sound_plan(), allocation: HostAllocationOversubscribed)
  let unsound = selection_with(sampling: ConservativePerAxis { minimum_runs: 1 }, plan: FleetHostPlanUnsound { reason: "oomd enforcement unverified" }, allocation: HostAllocationConserves)
  ([oversubscribed, unsound] |> all(sel => {
    let a = assess_unobserved(selection: sel, runs: [good_run(id: run_a)])
    !assessment_holds(a: a) && (match a.slot_width { SlotWidthUnderivable { cause: _ } => true _ => false })
  }))
    && (match selected_host_allocation(plan: sound_plan(), allocation: HostAllocationConserves) {
      HostAllocationAdmitted { runner_slice_cap: _, effective_runner_cpu_cap: _ } => true
      HostAllocationRefused { cause: _ } => false
    })
}

// ── the join into the fabric (operator hold, item 1) ──────────────────────────────────────────

// THE SANCTION IS AN INPUT THE FABRIC ADMITS ON, NEVER A CONCLUSION OF THIS MODULE: the same
// delivering assessment beside a customer sanction is refused by admit_executor_capacity for
// the floor, and nothing in the qualification module can mint a sanction from an assessment.
test fn the_selected_sanction_not_the_assessment_decides_the_class() -> Bool {
  let inputs = inputs_with(sampling: ConservativePerAxis { minimum_runs: 1 }, plan: sound_plan(), allocation: HostAllocationConserves)
  let s = inputs.selection
  let control = admit_executor_capacity(requirements: s.requirements, roster: [inputs.executor_sanction], executor: "mtcollins1" as NonEmptyStr)
  let customer = admit_executor_capacity(
    requirements: s.requirements,
    roster: [ExecutorSanctioned { executor: "mtcollins1" as NonEmptyStr, sanctioned: CustomerExecutableCapacity }],
    executor: "mtcollins1" as NonEmptyStr,
  )
  let unclassified = admit_executor_capacity(requirements: s.requirements, roster: [], executor: "mtcollins1" as NonEmptyStr)
  (match control { CapacityClassAdmitted { executor: _, class: _ } => true _ => false })
    && (match customer { CapacityClassRefused { executor: _, required: _, sanctioned: _ } => true _ => false })
    && (match unclassified { ExecutorNotClassified { executor: _ } => true _ => false })
}

// THE DELIVERY CLAIM IS THE FABRIC'S OWN CARRIER: claimed_delivery_check dispatches the runner arm,
// holds for a delivering assessment bound to the claimed offer, refuses an assessment that does not
// deliver with RunnerThroughputDidNotHold, and refuses a claim riding another offer.
test fn the_fabric_delivery_claim_holds_refuses_and_catches_another_offer() -> Bool {
  let s = selection()
  let good = assess_at_width(selection: s, runs: [good_run(id: run_a)])
  let slow = assess_unobserved(selection: s, runs: [varied_run(id: run_a, subjects: first_scaled(n: first_baseline_wall() * 2))])
  let holds = match claimed_delivery_check(claim: OfferClaimsRunnerDelivery { offer: s.offer.id, assessment: good }) {
    ClaimedDeliveryHolds => true
    _ => false
  }
  let refused = match claimed_delivery_check(claim: OfferClaimsRunnerDelivery { offer: s.offer.id, assessment: slow }) {
    ClaimedDeliveryUnqualified { refusals: rs } =>
      rs |> any(r => match r { RunnerThroughputDidNotHold { refusals: inner } => inner.length() >= 1 _ => false })
    _ => false
  }
  let mismatch = match claimed_delivery_check(claim: OfferClaimsRunnerDelivery { offer: selected_offer(key: "offer-other").id, assessment: good }) {
    ClaimedDeliveryOfferMismatch { claim_names: _, receipt_names: _ } => true
    _ => false
  }
  holds && refused && mismatch
}

// ── the route (operator hold, item 6) ─────────────────────────────────────────────────────────

fn route() -> List<QualificationStage> {
  mtcollins1_qualification_route(attempt: attempt, workload: pin())
}

// FOUR EFFECTFUL STAGES AT TWO GRAINS: one BMC write under the approval gate, three GitHub
// control-plane writes; the collect stage alone is observation.
test fn the_route_classifies_every_mutation_at_its_grain() -> Bool {
  route_effectful_stage_count(route: route()) == 4
    && route_bmc_write_count(route: route()) == 1
    && route_control_plane_write_count(route: route()) == 3
    && route_bmc_writes_are_gated(route: route())
    && (route() |> all(s =>
      match s {
        RegisterEphemeralRunnerSlot { unit: _, labels: _, workspace: _, registration: _ } =>
          match stage_effect(stage: s) { GitHubControlPlaneWrite { authority: _ } => true _ => false }
        DispatchFloorToSlot { workload: _, selector: _, dispatch: _ } =>
          match stage_effect(stage: s) { GitHubControlPlaneWrite { authority: _ } => true _ => false }
        DeregisterRunnerSlot { unit: _, deregistration: _ } =>
          match stage_effect(stage: s) { GitHubControlPlaneWrite { authority: _ } => true _ => false }
        CollectInstruments { instruments: _, collection: _ } =>
          match stage_effect(stage: s) { ObservationOnly { collection: _ } => true _ => false }
        BootHostUnderApprovalGate { host: _, boot: _, image: _ } =>
          match stage_effect(stage: s) { BmcWrite { gate: _, boot: _, image: _ } => true _ => false }
      }
    ))
}

// THE ROUTE IS NOT EXECUTABLE TODAY, AND THE CLAIM SAYS SO: the registration, dispatch and deregistration
// authorities are implemented but not wired. This flips to the regression control that the bindings stay when they land.
test fn the_route_is_not_executable_while_any_effectful_leg_is_unbound() -> Bool {
  !route_is_executable(route: route()) && !leg_is_wired(leg: qualification_run_producer_frontier)
}

// THE IMAGE LEG IS WIRED TO ITS PUBLISH CALLER AND THE BOOT LEG TO THE BOOT RUN'S SELECTED MEDIUM. Pointing
// either leg at another declaration (the census medium among them), or demoting it, turns this red.
fn leg_wired_to(leg: RouteLegStanding, module_path: String, decl_name: String) -> Bool {
  leg_is_wired(leg: leg)
    && (match leg_authority(leg: leg) {
      Present { value: a } => (a.module_path as String) == module_path && (a.decl_name as String) == decl_name
      Absent => false
    })
}

test fn the_image_leg_and_the_boot_leg_are_wired_to_their_production_callers() -> Bool {
  leg_wired_to(leg: mtcollins1_route_legs.image, module_path: "gunbc.runner.runner_host_medium_publish", decl_name: "mtcollins1_runner_image_publish_wet")
    && leg_wired_to(leg: mtcollins1_route_legs.boot, module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_medium")
}

// REGISTRATION, DISPATCH AND DEREGISTRATION HAVE IMPLEMENTED AUTHORITIES AND ARE NOT WIRED -- by
// declaration identity, so pointing any leg at some other declaration, or promoting one to LegWired
// while nothing on the route calls it, turns this red -- and the route stays unexecutable.
fn leg_names(leg: RouteLegStanding, module_path: String, decl_name: String) -> Bool {
  match leg {
    LegAuthorityImplemented { authority: a, wiring_owed: _ } => (a.module_path as String) == module_path && (a.decl_name as String) == decl_name
    _ => false
  }
}

test fn the_registration_dispatch_and_deregistration_legs_are_implemented_not_wired_and_the_route_is_not_executable() -> Bool {
  leg_names(leg: mtcollins1_route_legs.registration, module_path: "gunbc.runner.runner_jit_perform", decl_name: "dispatch_jit_mint")
    && leg_names(leg: mtcollins1_route_legs.dispatch, module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "dispatch_qualification_floor")
    && leg_names(leg: mtcollins1_route_legs.deregistration, module_path: "gunbc.runner.runner_jit_deregistration", decl_name: "ensure_jit_runner_deregistered")
    && !leg_is_wired(leg: mtcollins1_route_legs.registration)
    && !leg_is_wired(leg: mtcollins1_route_legs.deregistration)
    && !leg_is_wired(leg: mtcollins1_route_legs.dispatch)
    && leg_names(leg: mtcollins1_route_legs.collect, module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "collect_qualification_instruments")
    && !leg_is_wired(leg: mtcollins1_route_legs.collect)
    && !route_is_executable(route: route())
}

test fn the_route_registers_one_slot_deregisters_it_and_dispatches_to_the_attempt() -> Bool {
  route_registers_one_slot(route: route())
    && route_deregisters_what_it_registered(route: route())
    && route_dispatch_selector_names_the_attempt(route: route(), attempt: attempt)
}

test fn only_the_runner_stages_open_the_network_and_only_default_drop() -> Bool {
  route() |> all(s =>
    match stage_egress(stage: s) {
      Absent =>
        match s {
          BootHostUnderApprovalGate { host: _, boot: _, image: _ } => true
          CollectInstruments { instruments: _, collection: _ } => true
          _ => false
        }
      Present { value: policy } =>
        (match policy.host.forward { HostChainDefaultDrop => true TapScopedFinalDrop { chain_policy_reason: _ } => false })
          && (match s {
            RegisterEphemeralRunnerSlot { unit: _, labels: _, workspace: _, registration: _ } => true
            DispatchFloorToSlot { workload: _, selector: _, dispatch: _ } => true
            DeregisterRunnerSlot { unit: _, deregistration: _ } => true
            _ => false
          })
    }
  )
}

// THE COHORT IS OWED BY THE ROUTE, NOT ONLY ASSESSED: the collect stage lists the concurrent-cohort seat
// windows and cites product.capacity.cohort_observation seal_cohort as their producer, and the one
// collect-stage frontier stays unbound until the stage that seals a real cohort lands.
test fn the_collect_stage_owes_a_sealed_concurrent_cohort() -> Bool {
  !leg_is_wired(leg: qualification_run_producer_frontier)
    && (route() |> any(s =>
      match s {
        CollectInstruments { instruments: ins, collection: _ } =>
          ins |> any(i =>
            match i {
              ConcurrentCohortSeatWindows => {
                let p = qualification_instrument_producer(i: i)
                (p.module_path as String) == "product.capacity.cohort_observation" && (p.decl_name as String) == "seal_cohort"
              }
              _ => false
            }
          )
        _ => false
      }
    ))
}

// THE COLLECT STAGE OWES TODAY'S FLOOR'S OWN READINGS: each subject step's memory receipt, read by the receipt
// decoder, and each subject step's wall, denominated by the Jobs API step record -- and every instrument's wire names
// its producer.
test fn the_collect_stage_owes_the_subject_receipts_and_walls() -> Bool {
  route() |> any(s =>
    match s {
      CollectInstruments { instruments: ins, collection: _ } =>
        (ins |> any(i =>
          match i {
            SubjectMemoryReceipts => {
              let p = qualification_instrument_producer(i: i)
              (p.module_path as String) == "gunbc.host.memory_envelope_receipt_reading" && (p.decl_name as String) == "memory_receipt_line"
            }
            _ => false
          }
        ))
          && (ins |> any(i =>
            match i {
              SubjectStepWalls => {
                let p = qualification_instrument_producer(i: i)
                (p.module_path as String) == "extdeps.github.workflow_runs" && (p.decl_name as String) == "WorkflowJobStep"
              }
              _ => false
            }
          ))
          && (ins |> all(i => {
            let p = qualification_instrument_producer(i: i)
            string_contains(s: qualification_instrument_wire(i: i) as String, pattern: p.decl_name as String)
          }))
      _ => false
    }
  )
}

// THE EPHEMERAL SLOT CARRIES THE FLEET SLOT SHAPE, spelled through the systemd-run authority; under
// SlotCpuQuotaUnbounded no CPUQuota word is emitted, which is the transient unit's own "no ceiling".
test fn the_ephemeral_slot_argv_carries_the_fleet_memory_max() -> Bool {
  let reading = ephemeral_slot_command(unit: slot_unit(), desired: gunbc_runner_slot_desired(), command_argv: ["/mnt/runner/run.sh"])
  ephemeral_slot_words_carry_fleet_shape(reading: reading)
}

fn ephemeral_slot_words_carry_fleet_shape(reading: SystemdRunCommandReading) -> Bool {
  match reading {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command: command } => {
      let argv = argv_words(command: command)
      let has_quota_word = argv |> any(w => string_contains(s: w, pattern: "--property=CPUQuota="))
      (argv |> any(w => w == concat("--property=MemoryMax=", byte_size_count(b: gunbc_runner_slot_desired().memory_max) as String)))
        && (match gunbc_runner_slot_desired().cpu_quota {
          SlotCpuQuotaUnbounded => !has_quota_word
          CpuQuotaResolved { threads: t } =>
            argv |> any(w => w == concat("--property=CPUQuota=", concat((hardware_thread_count_value(t: t) * 100) as String, "%")))
        })
    }
  }
}

// THE CLASS LABEL IS READ OFF THE SLOT AUTHORITY, not written here (review 68972 -- the class this
// PR's own failure-mode row names, caught a fourth time in this file). The host and attempt are
// fixture inputs.
test fn the_ephemeral_slot_labels_carry_class_host_and_attempt() -> Bool {
  let labels = ephemeral_slot_labels(host: "mtcollins1", attempt: attempt)
  let class_labels = gunbc_runner_slot_desired().labels.github_labels
  class_labels.length() >= 1
    && (class_labels |> all(c => labels |> any(l => l == c)))
    && (labels |> any(l => l == "mtcollins1")) && (labels |> any(l => l == (attempt as String)))
}

// THE INHABITANCE CLAIMS FOR THE SUPPLIED SELECTION: the fleet's plan fold derives a sound plan
// for the fixture host, and the cores-per-slot policy is a positive width.
test fn the_fixture_selection_is_derived_by_the_fleet_folds() -> Bool {
  (match sound_plan() { FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_runner_cpu_cap: _ } => true FleetHostPlanUnsound { reason: _ } => false })
    && hardware_thread_count_value(t: gunbc_runner_cores_per_slot()) >= 1
    && expected_width() >= 1
}
