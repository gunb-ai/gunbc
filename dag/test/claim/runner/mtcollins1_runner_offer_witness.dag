fn census_envelope(meminfo_body: String) -> BoundHostCaptureEnvelope {
  BoundHostCaptureEnvelope {
    machine: "mtcollins1",
    run: KernelBootId { boot_id: "aaaaaaaa-0000-4000-8000-000000000004" },
    sections: [HostCaptureBoundSection { name: "meminfo", body: meminfo_body }],
  }
}

data meminfo_argv: String = "----ARGV meminfo: grep -E 'MemTotal|MemAvailable' /proc/meminfo\n"

fn measured_bytes(a: ObservationAttempt<HostUsableRam, CensusMeminfoUnread>) -> Int {
  match a {
    ObservationRefused { cause: _ } => 0 - 1
    ObservationEstablished { observed: r } =>
      match r {
        HostUsableRamMeasured { bytes: b, provenance: _ } => byte_size_count(b: b) as Int
        HostUsableRamConservativeLowerBound { bytes: _, basis: _ } => 0 - 1
        HostUsableRamUnmeasured { reason: _ } => 0 - 1
      }
  }
}

fn measured_provenance_names(a: ObservationAttempt<HostUsableRam, CensusMeminfoUnread>, pattern: String) -> Bool {
  match a {
    ObservationRefused { cause: _ } => false
    ObservationEstablished { observed: r } =>
      match r {
        HostUsableRamMeasured { bytes: _, provenance: p } => string_contains(s: p as String, pattern: pattern)
        HostUsableRamConservativeLowerBound { bytes: _, basis: _ } => false
        HostUsableRamUnmeasured { reason: _ } => false
      }
  }
}

test fn census_meminfo_receipt_reads_as_measured_usable_ram() -> Bool {
  let a = host_usable_ram_from_capture(envelope: census_envelope(meminfo_body: concat(meminfo_argv,
    "MemTotal:       131000000 kB\nMemAvailable:   127000000 kB\n----EXIT meminfo: 0\n")))
  measured_bytes(a: a) == 131000000 * 1024
    && measured_provenance_names(a: a, pattern: "mtcollins1")
    && measured_provenance_names(a: a, pattern: "aaaaaaaa-0000-4000-8000-000000000004")
}

fn refusal_is(a: ObservationAttempt<HostUsableRam, CensusMeminfoUnread>, expected: String) -> Bool {
  match a {
    ObservationEstablished { observed: _ } => false
    ObservationRefused { cause: c } =>
      match c {
        CensusMeminfoSectionAbsent => expected == "absent"
        CensusMeminfoSectionPending => expected == "pending"
        CensusMeminfoSectionMalformed { reason: _ } => expected == "malformed"
        CensusMeminfoExitNonzero { exit_code: _ } => expected == "exit"
        CensusMeminfoUnparsed { cause: _ } => expected == "unparsed"
        CensusMeminfoReceiptUnreadable { error: _ } => expected == "unreadable"
        CensusMeminfoEnvelopeOpen => expected == "open"
        CensusMeminfoEnvelopeNotBegun => expected == "notbegun"
        CensusMeminfoCaptureUnbound { reason: _ } => expected == "unbound"
      }
  }
}

test fn census_meminfo_RED_non_reads_refuse_by_cause() -> Bool {
  refusal_is(a: host_usable_ram_from_capture(envelope: BoundHostCaptureEnvelope {
      machine: "mtcollins1", run: KernelBootId { boot_id: "aaaaaaaa-0000-4000-8000-000000000004" }, sections: [],
    }), expected: "absent")
    && refusal_is(a: host_usable_ram_from_capture(envelope: census_envelope(meminfo_body: concat(meminfo_argv,
      "MemTotal:       131000000 kB\n"))), expected: "pending")
    && refusal_is(a: host_usable_ram_from_capture(envelope: census_envelope(meminfo_body: concat(meminfo_argv,
      "MemTotal:       131000000 kB\nMemAvailable:   127000000 kB\n----EXIT meminfo: 1\n"))), expected: "exit")
    && refusal_is(a: host_usable_ram_from_capture(envelope: census_envelope(meminfo_body: concat(meminfo_argv,
      "MemAvailable:   127000000 kB\n----EXIT meminfo: 0\n"))), expected: "unparsed")
}

test fn mtcollins1_RED_nominal_dram_total_reaches_neither_offer_nor_reader() -> Bool {
  byte_size_count(b: compute_host_ram_bytes_total(host: mtcollins1_offer.supply.physical)) == 0
    && refusal_is(a: host_usable_ram_from_capture(envelope: census_envelope(meminfo_body: concat(meminfo_argv,
      "dram_total: 134217728 kB\n----EXIT meminfo: 0\n"))), expected: "unparsed")
}

fn one_socket_boot_reads_width(b: MtCollins1Socket1InvestigationBoot, width: Int) -> Bool {
  match b.host {
    Absent => true
    Present { value: h } => h.sockets == 1 && (h.cpus as Int) == width
  }
}

test fn mtcollins1_socket0_cpu_part_is_observed_by_the_census_capture() -> Bool {
  match mtcollins1_socket0_cpu_part_standing() {
    ObservedByReceipt { observed: o } =>
      (observed_receipt_ref(observed: o).decl_name as String) == "mtcollins1_census_cpu_bios_model"
    _ => false
  }
}

test fn mtcollins1_RED_a_bios_line_naming_another_part_keeps_no_citation() -> Bool {
  cpu_bios_line_names_part(line: "BIOS Model name:      Ampere(R) Altra(R) Processor Q80-30 CPU @ 3.0GHz", model_number: "Q80-30")
    && cpu_bios_line_names_part(line: "BIOS Model name:      Ampere(R) Altra(R) Processor Q64-30 CPU @ 3.0GHz", model_number: "Q80-30") == false
    && cpu_bios_line_names_part(line: "BIOS Model name:      Ampere(R) Altra(R) Processor Q80-30X CPU", model_number: "Q80-30") == false
}

test fn mtcollins1_RED_missing_lscpu_refuses_the_cpu_reading_with_its_own_cause_while_ram_stays_measured() -> Bool {
  let e = census_envelope(meminfo_body: concat(meminfo_argv, "MemTotal: 134217728 kB\nMemAvailable: 130000000 kB\n----EXIT meminfo: 0\n"))
  let ram_ok = measured_bytes(a: host_usable_ram_from_capture(envelope: e)) > 0
  let cpu_cause_ok = match census_cpu_bios_model_reading(envelope: e) {
    ObservationRefused { cause: c } =>
      match c {
        CensusLscpuSectionAbsent => true
        CensusLscpuSectionPending => false
        CensusLscpuSectionMalformed { reason: _ } => false
        CensusLscpuExitNonzero { exit_code: _ } => false
        CensusLscpuNoBiosModelLine => false
        CensusLscpuAmbiguousBiosModelLines => false
        CensusLscpuCaptureUnread { cause: _ } => false
      }
    ObservationEstablished { observed: _ } => false
  }
  ram_ok && cpu_cause_ok
}

test fn mtcollins1_offer_cpu_width_equals_the_measured_one_socket_reading() -> Bool {
  let width = compute_host_cpu_admitted_width(host: mtcollins1_offer.supply.physical)
  (mtcollins1_offer.supply.physical.identity as String) == (operator_host_mtcollins1 as String)
    && mtcollins1_offer.supply.physical.processors.length() == 1
    && width == 80
    && all(mtcollins1_socket1_investigation_boots, b => one_socket_boot_reads_width(b: b, width: width))
}

test fn mtcollins1_RED_both_sockets_disagrees_with_the_measured_reading() -> Bool {
  let both = ComputeHost {
    identity: mtcollins1_runner_host.identity,
    baseboard: mtcollins1_runner_host.baseboard,
    bmc_intent: mtcollins1_runner_host.bmc_intent,
    processors: [CpuProcessor { cpu: mtcollins1_socket0_cpu }, CpuProcessor { cpu: mtcollins1_socket0_cpu }],
    memory: mtcollins1_runner_host.memory,
    storage: mtcollins1_runner_host.storage,
    network_interfaces: mtcollins1_runner_host.network_interfaces,
  }
  let width = compute_host_cpu_admitted_width(host: both)
  width == 160
    && all(mtcollins1_socket1_investigation_boots, b => match b.host {
      Absent => true
      Present { value: _ } => one_socket_boot_reads_width(b: b, width: width) == false
    })
}

test fn mtcollins1_carries_no_sessions_and_owes_no_reservation() -> Bool {
  let residency_ok = match host_session_residency(host: operator_host_mtcollins1) {
    NoInteractiveSessions => true
    HostsInteractiveSessions => false
  }
  residency_ok
    && match host_session_reservation_outcome(host: operator_host_mtcollins1) {
      SessionReservationNotApplicable { residency_evidence: _ } => true
      _ => false
    }
}

test fn mtcollins1_census_capture_file_is_the_committed_receipt() -> Bool {
  let read = Filesystem.Read(path: mtcollins1_census_boot_capture_path())
  read.success
    && string_contains(s: mtcollins1_census_boot_capture_path(), pattern: "39010930690")
    && string_contains(s: read.content, pattern: "MemTotal:")
}

test fn mtcollins1_production_usable_ram_is_the_census_capture_reading() -> Bool {
  let production = gunbc_ci_host_usable_ram_for(host: operator_host_mtcollins1)
  match mtcollins1_census_envelope_attempt() {
    ObservationRefused { cause: _ } => false
    ObservationEstablished { observed: e } =>
      match host_usable_ram_from_capture(envelope: e) {
        ObservationRefused { cause: _ } => false
        ObservationEstablished { observed: r } =>
          match r {
            HostUsableRamMeasured { bytes: b, provenance: p } =>
              match production {
                HostUsableRamMeasured { bytes: pb, provenance: pp } =>
                  byte_size_count(b: b) == byte_size_count(b: pb)
                    && (p as String) == (pp as String)
                    && string_contains(s: p as String, pattern: "292ec1bf-b85c-4a76-81db-cb1247c98370")
                    && string_contains(s: p as String, pattern: "census_meminfo_reading")
                _ => false
              }
            _ => false
          }
      }
  }
}

test fn mtcollins1_production_overhead_is_the_census_capture_reading() -> Bool {
  let production = gunbc_ci_host_fixed_overhead_for(host: operator_host_mtcollins1)
  match mtcollins1_census_envelope_attempt() {
    ObservationRefused { cause: _ } => false
    ObservationEstablished { observed: e } =>
      match host_fixed_overhead_from_capture(envelope: e) {
        ObservationRefused { cause: _ } => false
        ObservationEstablished { observed: o } =>
          match o {
            HostFixedOverheadMeasured { bytes: b, provenance: p } =>
              match production {
                HostFixedOverheadMeasured { bytes: pb, provenance: pp } =>
                  byte_size_count(b: b) == byte_size_count(b: pb)
                    && (p as String) == (pp as String)
                    && string_contains(s: p as String, pattern: "292ec1bf-b85c-4a76-81db-cb1247c98370")
                    && string_contains(s: p as String, pattern: "quiescent census boot")
                _ => false
              }
            _ => false
          }
      }
  }
}

data open_complete_meminfo_capture: String = join([
  "=====GUNBC-HOST-CAPTURE mtcollins1 boot-id=aaaaaaaa-0000-4000-8000-000000000005 begin 2026-10-15T00:00:00Z=====\n",
  "----SECTION meminfo----\n",
  "----ARGV meminfo: grep -E 'MemTotal|MemAvailable' /proc/meminfo\n",
  "MemTotal:       131000000 kB\n",
  "MemAvailable:   127000000 kB\n",
  "----EXIT meminfo: 0\n",
], "")

test fn mtcollins1_RED_open_envelope_does_not_mint_measured_ram_or_overhead() -> Bool {
  match census_envelope_from_capture_text(capture: open_complete_meminfo_capture, machine: operator_host_mtcollins1 as NonEmptyStr) {
    ObservationRefused { cause: CensusMeminfoEnvelopeOpen } => true
    _ => false
  }
}

test fn mtcollins1_RED_unread_receipt_is_not_an_unbegun_capture() -> Bool {
  match census_envelope_from_read(success: false, content: "", error: "No such file", machine: operator_host_mtcollins1 as NonEmptyStr) {
    ObservationRefused { cause: CensusMeminfoReceiptUnreadable { error: e } } =>
      e == "No such file"
        && match census_envelope_from_capture_text(capture: "", machine: operator_host_mtcollins1 as NonEmptyStr) {
          ObservationRefused { cause: CensusMeminfoEnvelopeNotBegun } => true
          _ => false
        }
    _ => false
  }
}

// Through fleet_intent_offers, with no supplied offer: enrolling the host is what moved its committed width
// off WidthComputeOfferAbsent. The figure is the one mtcollins1_committed_width_over_offer_cpu_and_census_ram_is_five_slots
// derives from supplied values; this is its pairing inhabitance claim over the production route.
test fn mtcollins1_production_committed_width_is_derived_through_the_enrolled_offer() -> Bool {
  match gunbc_runner_committed_width(host: operator_host_mtcollins1) {
    RunnerWidthDerived { slots: n } => n == 5
    RunnerWidthUnresolved { cause: _ } => false
  }
}

test fn mtcollins1_census_usable_ram_holds_at_least_one_declared_slot() -> Bool {
  match gunbc_ci_host_usable_ram_for(host: operator_host_mtcollins1) {
    HostUsableRamMeasured { bytes: u, provenance: _ } =>
      (byte_size_count(b: u) as Int) >= gunbc_runner_slot_memory_max_bytes
    _ => false
  }
}

fn supplied_ram(meminfo_body: String) -> HostUsableRam {
  match host_usable_ram_from_capture(envelope: census_envelope(meminfo_body: meminfo_body)) {
    ObservationEstablished { observed: r } => r
    ObservationRefused { cause: _ } => HostUsableRamUnmeasured { reason: "designed supplied meminfo unread" as NonEmptyStr }
  }
}

fn supplied_overhead(meminfo_body: String) -> HostFixedOverhead {
  match host_fixed_overhead_from_capture(envelope: census_envelope(meminfo_body: meminfo_body)) {
    ObservationEstablished { observed: o } => o
    ObservationRefused { cause: _ } => HostFixedOverheadUnmeasured { reason: "designed supplied meminfo unread" as NonEmptyStr }
  }
}

fn mtcollins1_supplied_facts(ram: HostUsableRam, overhead: HostFixedOverhead) -> HostWidthFacts {
  let real = host_width_facts(host: operator_host_mtcollins1)
  HostWidthFacts {
    host: real.host,
    cpu: CpuWidthDerived { slots: compute_host_cpu_admitted_width(host: mtcollins1_offer.supply.physical) },
    usable_ram: ram,
    fixed_overhead: overhead,
    session: real.session,
    control_plane: real.control_plane,
    served_deployment: real.served_deployment,
    disk: real.disk,
    authored_slots: real.authored_slots,
  }
}

test fn mtcollins1_committed_width_over_offer_cpu_and_census_ram_is_five_slots() -> Bool {
  let real = host_width_facts(host: operator_host_mtcollins1)
  match committed_width_of(f: mtcollins1_supplied_facts(ram: real.usable_ram, overhead: real.fixed_overhead)) {
    RunnerWidthDerived { slots: n } => n == 5
    RunnerWidthUnresolved { cause: _ } => false
  }
}

data designed_one_socket_meminfo: String = "----ARGV meminfo: grep -E 'MemTotal|MemAvailable' /proc/meminfo\nMemTotal:       131000000 kB\nMemAvailable:   127000000 kB\n----EXIT meminfo: 0\n"

data designed_half_meminfo: String = "----ARGV meminfo: grep -E 'MemTotal|MemAvailable' /proc/meminfo\nMemTotal:        65500000 kB\nMemAvailable:    61500000 kB\n----EXIT meminfo: 0\n"

fn derived_runner_count(facts: HostWidthFacts) -> Int {
  match host_deployment_standing_given(
    offer: mtcollins1_offer,
    facts: facts,
    control_plane_placement: fabric_control_plane_placement,
  ) {
    HostRunnerDeploymentDerived { deployment: d } => d.runner_count
    HostRunnerDeploymentRefused { refusal: _ } => 0 - 1
  }
}

test fn mtcollins1_placement_accepts_the_offer_over_supplied_one_socket_facts() -> Bool {
  match host_deployment_standing_given(
    offer: mtcollins1_offer,
    facts: mtcollins1_supplied_facts(
      ram: supplied_ram(meminfo_body: designed_one_socket_meminfo),
      overhead: supplied_overhead(meminfo_body: designed_one_socket_meminfo),
    ),
    control_plane_placement: fabric_control_plane_placement,
  ) {
    HostRunnerDeploymentDerived { deployment: d } =>
      (d.identity as String) == (operator_host_mtcollins1 as String) && d.runner_count > 0
    HostRunnerDeploymentRefused { refusal: _ } => false
  }
}

test fn mtcollins1_RED_placement_refuses_until_usable_ram_is_measured() -> Bool {
  match host_deployment_standing_given(
    offer: mtcollins1_offer,
    facts: mtcollins1_supplied_facts(
      ram: HostUsableRamUnmeasured { reason: "designed unmeasured" as NonEmptyStr },
      overhead: supplied_overhead(meminfo_body: designed_one_socket_meminfo),
    ),
    control_plane_placement: fabric_control_plane_placement,
  ) {
    HostRunnerDeploymentDerived { deployment: _ } => false
    HostRunnerDeploymentRefused { refusal: r } =>
      match r.cause {
        UsableRamUnavailable { cause: _ } => true
        _ => false
      }
  }
}

test fn mtcollins1_derived_width_moves_with_the_census_meminfo_and_the_slot_row() -> Bool {
  let full = derived_runner_count(facts: mtcollins1_supplied_facts(
    ram: supplied_ram(meminfo_body: designed_one_socket_meminfo),
    overhead: supplied_overhead(meminfo_body: designed_one_socket_meminfo),
  ))
  let half = derived_runner_count(facts: mtcollins1_supplied_facts(
    ram: supplied_ram(meminfo_body: designed_half_meminfo),
    overhead: supplied_overhead(meminfo_body: designed_half_meminfo),
  ))
  full > 0 && half > 0 && half < full
}

test fn census_meminfo_receipt_reads_as_measured_fixed_overhead() -> Bool {
  match supplied_overhead(meminfo_body: designed_one_socket_meminfo) {
    HostFixedOverheadMeasured { bytes: b, provenance: p } =>
      (byte_size_count(b: b) as Int) == 4000000 * 1024 && string_contains(s: p as String, pattern: "quiescent census boot")
    _ => false
  }
}

fn mtcollins1_supplied_standing_text() -> String {
  match host_deployment_standing_given(
    offer: mtcollins1_offer,
    facts: mtcollins1_supplied_facts(
      ram: supplied_ram(meminfo_body: designed_one_socket_meminfo),
      overhead: supplied_overhead(meminfo_body: designed_one_socket_meminfo),
    ),
    control_plane_placement: fabric_control_plane_placement,
  ) {
    HostRunnerDeploymentDerived { deployment: d } => concat("derived runner_count=", to_string(d.runner_count))
    HostRunnerDeploymentRefused { refusal: r } => host_deployment_refusal_text(c: r.cause)
  }
}

test fn mtcollins1_eight_rdimm_attestation_contradicts_the_firmware_reading() -> Bool {
  !mtcollins1_eight_rdimm_attestation_matches_firmware
    && mtcollins1_eight_rdimm_firmware_read_module_count
      == mtcollins1_eight_rdimm_one_rank_module_count + mtcollins1_eight_rdimm_two_rank_module_count
    && mtcollins1_eight_rdimm_firmware_read_module_count == 8
    && mtcollins1_eight_rdimm_trained_megatransfers == 2133
}

// RED: THE PLAN AND THE POLICY PARTITION BY HOW THE HOST IS REALIZED. A RamImageBoot host in
// fleet_intent_offers emits no converge target and emits an image-baked entry; mutating the partition so
// the converge-applied arm takes it reds the first two conjuncts. Control: a converge-delivered host is a
// converge target and not image-baked.
test fn ram_image_boot_host_is_image_baked_and_never_a_converge_target() -> Bool {
  match fleet_converge_policy_from(plan: runner_deployment_plan(), image_baked: runner_image_baked_deployment_plan()) {
    ConvergePolicyDerived { hosts: applied, image_baked: baked } =>
      !any(applied, h => (h.identity as String) == (operator_host_mtcollins1 as String))
        && any(baked, h => (h.identity as String) == (operator_host_mtcollins1 as String))
        && !any(baked, h => (h.identity as String) == (operator_host_srv3 as String))
        && any(applied, h => (h.identity as String) == (operator_host_srv3 as String))
    ConvergePolicyUnsound { reason: _ } => false
  }
}

test fn the_converge_applied_plan_does_not_name_a_ram_image_host() -> Bool {
  match runner_host_deployment_for(p: runner_deployment_plan(), host: operator_host_mtcollins1) {
    HostRunnerDeploymentRefused { refusal: RefusedHostDeployment { host: _, cause: HostRealizedByImage } } => true
    _ => false
  }
}

// An enrolled image-baked host is not "not enrolled": the refusal names how it is realized. Control: a host
// the fleet never enrolled keeps HostNotEnrolledInFleet.
test fn an_unenrolled_host_still_refuses_as_not_enrolled() -> Bool {
  match runner_host_deployment_for(p: runner_deployment_plan(), host: "not-a-fleet-host" as HostIdentity) {
    HostRunnerDeploymentRefused { refusal: RefusedHostDeployment { host: _, cause: HostNotEnrolledInFleet } } => true
    _ => false
  }
}

// The capacity plan keeps mtcollins1: CI capacity readers do not drop an image-baked host.
test fn the_fleet_capacity_plan_carries_the_ram_image_host() -> Bool {
  match runner_host_deployment_for(p: runner_fleet_capacity_plan(), host: operator_host_mtcollins1) {
    HostRunnerDeploymentDerived { deployment: d } => d.runner_count == 5
    _ => false
  }
}
