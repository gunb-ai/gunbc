module test.claim.runner_attempt_launch_witness

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.nat { Nat }
import std.measure { byte_size, byte_size_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.exec.command { argv_words }
import extdeps.virtualization.firecracker {
  firecracker_requires_kvm_device,
  jailer_cgroup_version_flag_places_the_process,
}
import test.claim.fabric_grant_issuance_witness {
  issue, subject_work, first_attempt, funded_account, exhausted_account,
  admitted_offer, thread_appropriation, money_request,
}
import product.fabric.grant_issue { GrantCommitted, GrantRefused }
import product.fabric.execution { ExecutionGrant }
import product.fabric.budget { MoneyAccount }
import gunbc.build_cache_instance { RunnerSlotIdentity }
import gunbc.fleet_intent_network { operator_host_srv2 }
import gunbc.runner_microvm_attempt {
  MicroVmAttempt, MicroVmAttemptAccepted, MicroVmAttemptRefused, microvm_attempt,
  runner_microvm_attempt_workspace_path, runner_microvm_attempt_dir,
}
import gunbc.runner_microvm_network {
  runner_slot_tap_device_name, runner_microvm_nft_ruleset_text,
}
import std.dissolution { dissolution_description, dissolution_is_bound }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable, OutsideTheLadder, StructurallyGuaranteed, StructurallyImpossible }
import gunbc.runner_attempt_launch {
  AttemptLaunchPlan, LaunchAuthorized, LaunchRefusedUnauthorized,
  LaunchRefusedEnvelope, LaunchRefusedPriorResources,
  LaunchRefusedConfigUnresolved,
  AttemptGround, GroundClear, GroundOccupied,
  EnvelopeStanding, EnvelopeAdmitted, EnvelopeAbsent, EnvelopeMalformed,
  EnvelopeSignatureRejected, EnvelopeBoundToDifferentUnit, EnvelopeBoundToDifferentBoot,
  EnvelopeNonceMismatch, EnvelopeBoundToDifferentAttempt, EnvelopePayloadDigestMismatch,
  EnvelopePayloadBelowFloor, EnvelopePayloadAboveCeiling,
  plan_attempt_launch, planned_jailer_launches,
  work_standing_from_vmm_exit, vmm_exit_establishes_work,
  jailer_cgroup_flag_is_not_placement, placement_is_cgroup_join_then_exec,
  production_may_dispatch_attempt_launch,
  recovered_host_image_source_dissolution_satisfied,
  reported_attempt_launch_rung,
  host_boot_cutover_frontier, jit_mint_http_realization_frontier,
  host_pid1_refusal_is_outside_this_planner,
  NoBootSecretArrived, Stage2RootTransitionRefused,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data issued_money_generation: Int = money_request.generation

type IssuedPair {
  grant: ExecutionGrant<NonEmptyStr>
  account: MoneyAccount
}

fn issued_pairs() -> List<IssuedPair> {
  match issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  ) {
    GrantCommitted { grant: g, account: a, ledger: _ } =>
      [IssuedPair { grant: g, account: a }]
    GrantRefused { refusal: _ } => []
  }
}

fn slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv2, slot_index: i }
}

fn accepted_attempt(i: Nat, id: String) -> List<MicroVmAttempt> {
  match microvm_attempt(slot: slot(i: i), attempt_id: id) {
    MicroVmAttemptAccepted { attempt: a } => [a]
    MicroVmAttemptRefused { refusal: _ } => []
  }
}

fn plan_for(
  pair: IssuedPair,
  account: MoneyAccount,
  attempt: MicroVmAttempt,
  envelope: EnvelopeStanding,
  ground: AttemptGround,
) -> AttemptLaunchPlan {
  plan_attempt_launch(
    grant: pair.grant,
    account: account,
    money_generation: issued_money_generation,
    work: pair.grant.context.work,
    demand: pair.grant.context.demand,
    offer: pair.grant.object.offer,
    attempt: attempt,
    envelope: envelope,
    ground: ground,
    jailer_binary: "/bin/jailer",
    firecracker_binary: "/bin/firecracker",
  )
}

fn admitted(n: Nat) -> EnvelopeStanding {
  EnvelopeAdmitted { bytes: byte_size(count: n) }
}

fn launches_for(
  pair: IssuedPair,
  account: MoneyAccount,
  attempt: MicroVmAttempt,
  envelope: EnvelopeStanding,
  ground: AttemptGround,
) -> Int {
  planned_jailer_launches(plan: plan_for(
    pair: pair, account: account, attempt: attempt, envelope: envelope, ground: ground,
  ))
}

test fn a_zero_byte_credential_does_not_start_the_vmm() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 1, id: "cred0") {
        Cons { head: a, tail: _ } =>
          match plan_for(pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 0), ground: GroundClear) {
            LaunchRefusedEnvelope { standing: s } =>
              match s {
                EnvelopePayloadBelowFloor { bytes: n } =>
                  byte_size_count(b: n) == 0 && launches_for(
                    pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 0), ground: GroundClear,
                  ) == 0
                EnvelopeAdmitted { bytes: _ } => false
                EnvelopeAbsent => false
                EnvelopeMalformed => false
                EnvelopeSignatureRejected => false
                EnvelopeBoundToDifferentUnit => false
                EnvelopeBoundToDifferentBoot => false
                EnvelopeNonceMismatch => false
                EnvelopeBoundToDifferentAttempt => false
                EnvelopePayloadDigestMismatch => false
                EnvelopePayloadAboveCeiling { bytes: _ } => false
              }
            LaunchRefusedUnauthorized { authorization: _ } => false
            LaunchRefusedPriorResources => false
            LaunchRefusedConfigUnresolved { cause: _ } => false
            LaunchAuthorized {
              authorization: _,
              tap_device: _,
              guest_ip_boot_arg: _,
              nft_ruleset: _,
              slice: _,
              workspace_path: _,
              workspace_format: _,
              kvm_device: _,
              vm_config: _,
              jailer: _,
              placement: _,
            } => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn an_unauthorized_grant_yields_zero_jailer_launches() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 2, id: "unauth") {
        Cons { head: a, tail: _ } =>
          match plan_for(
            pair: pair, account: exhausted_account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
          ) {
            LaunchRefusedUnauthorized { authorization: _ } =>
              launches_for(
                pair: pair, account: exhausted_account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
              ) == 0
            _ => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn prior_resources_refuse_rather_than_reuse() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 3, id: "prior") {
        Cons { head: a, tail: _ } =>
          match plan_for(
            pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundOccupied,
          ) {
            LaunchRefusedPriorResources => launches_for(
              pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundOccupied,
            ) == 0
            _ => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn an_authorized_launch_consumes_network_slice_workspace_and_jailer() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 4, id: "ok1") {
        Cons { head: a, tail: _ } =>
          match plan_for(
            pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
          ) {
            LaunchAuthorized {
              authorization: _,
              tap_device: tap,
              guest_ip_boot_arg: ip,
              nft_ruleset: nft,
              slice: _,
              workspace_path: ws,
              workspace_format: fmt,
              kvm_device: kvm,
              vm_config: cfg,
              jailer: jailer,
              placement: place,
            } => {
              let words = join(argv_words(command: jailer), " ")
              placement_is_cgroup_join_then_exec(p: place)
                && (tap as String) == (runner_slot_tap_device_name(slot: a.slot) as String)
                && nft == runner_microvm_nft_ruleset_text()
                && string_contains(s: ws, pattern: runner_microvm_attempt_dir(attempt: a))
                && (kvm as String) == (firecracker_requires_kvm_device as String)
                && string_contains(s: ip, pattern: "ip=")
                && string_contains(s: words, pattern: "--exec-file")
                && string_contains(s: words, pattern: "--no-api")
                && string_contains(s: words, pattern: "--chroot-base-dir")
                && string_contains(s: words, pattern: "--cgroup-version")
                && string_contains(s: words, pattern: "/bin/jailer")
                && (fmt.program as String) == "mke2fs"
                && count(cfg.drives) == 3
                && planned_jailer_launches(plan: plan_for(
                  pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
                )) == 1
            }
            LaunchRefusedUnauthorized { authorization: _ } => false
            LaunchRefusedEnvelope { standing: _ } => false
            LaunchRefusedPriorResources => false
            LaunchRefusedConfigUnresolved { cause: _ } => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn a_clean_vmm_exit_is_not_evidence_that_work_ran() -> Bool {
  !vmm_exit_establishes_work(standing: work_standing_from_vmm_exit(exit_code: 0))
    && !vmm_exit_establishes_work(standing: work_standing_from_vmm_exit(exit_code: 1))
}

test fn the_jailer_cgroup_flag_does_not_place_the_process() -> Bool {
  jailer_cgroup_flag_is_not_placement() && !jailer_cgroup_version_flag_places_the_process()
}

test fn production_does_not_dispatch_the_shadow_planner() -> Bool {
  !production_may_dispatch_attempt_launch()
}

test fn recovered_dissolution_is_not_satisfied_by_y_beside_x() -> Bool {
  !recovered_host_image_source_dissolution_satisfied()
}

test fn reported_rung_is_the_minimum_across_paths_and_is_mitigatable() -> Bool {
  match reported_attempt_launch_rung() {
    Mitigatable => true
    OutsideTheLadder => false
    MechanicallyPreventable => false
    StructurallyGuaranteed => false
    StructurallyImpossible => false
  }
}

test fn the_cutover_frontier_names_the_capability_and_is_unbound() -> Bool {
  let d = dissolution_description(condition: host_boot_cutover_frontier)
  !dissolution_is_bound(condition: host_boot_cutover_frontier)
    && string_contains(s: d, pattern: "Y execs at host boot")
    && string_contains(s: d, pattern: "host image is built from Y")
    && string_contains(s: d, pattern: "NOT satisfied by this planner compiling")
}

test fn the_mint_frontier_names_github_pr_10923() -> Bool {
  let d = dissolution_description(condition: jit_mint_http_realization_frontier)
  !dissolution_is_bound(condition: jit_mint_http_realization_frontier)
    && string_contains(s: d, pattern: "10923")
    && string_contains(s: d, pattern: "github_effect_perform")
}

test fn host_pid1_refusals_are_outside_the_per_attempt_planner() -> Bool {
  host_pid1_refusal_is_outside_this_planner(r: NoBootSecretArrived)
    && host_pid1_refusal_is_outside_this_planner(r: Stage2RootTransitionRefused)
}

test fn every_x_envelope_refusal_arm_yields_zero_jailer_launches() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 5, id: "envx") {
        Cons { head: a, tail: _ } =>
          launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeAbsent, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeMalformed, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeSignatureRejected, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeBoundToDifferentUnit, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeBoundToDifferentBoot, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeNonceMismatch, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeBoundToDifferentAttempt, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopePayloadDigestMismatch, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopePayloadBelowFloor { bytes: byte_size(count: 100) }, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopePayloadAboveCeiling { bytes: byte_size(count: 70000) }, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 70000), ground: GroundClear) == 0
        Empty {} => false
      }
    Empty {} => false
  }
}

