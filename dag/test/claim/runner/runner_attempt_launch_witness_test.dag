data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data issued_money_generation: Int = money_request.generation

type IssuedPair {
  grant: ExecutionGrant<NonEmptyStr>
  account: MoneyAccount
}

fn issued_pairs() -> List<IssuedPair> {
  match issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  ) {
    Cons { head: o, tail: _ } =>
      match o {
        GrantCommitted { grant: g, account: a, ledger: _ } =>
          [IssuedPair { grant: g, account: a }]
        GrantRefused { refusal: _ } => []
      }
    Empty {} => []
  }
}

fn slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv2, slot_index: i }
}

fn accepted_attempt(i: Nat, id: String) -> List<MicroVmAttempt> {
  match microvm_attempt(slot: slot(i: i), attempt_id: id) {
    MicroVmAttemptAccepted { attempt: a } => [a]
    MicroVmAttemptRefused { refusal: _ } => []
  }
}

// THE CREDENTIAL FIXTURE IS BUILT THROUGH jit_config_mint_outcome, the one authority that turns a
// 201 body into an EncodedJitConfig, so the witnesses below are fed the same carrier a real mint
// produces rather than a second constructor of it. Lengths are made by doubling so the floor
// (512) and ceiling (65536) are straddled without spelling kilobytes of literal.
fn doubled(s: String, k: Int) -> String {
  if k <= 0 { s } else { doubled(s: concat(s, s), k: k - 1) }
}

data registration_fixture_id: Int = 4242

fn minted_credential(encoded: String) -> List<EncodedJitConfig> {
  match jit_config_mint_outcome(status: 201, encoded: encoded, runner_id: registration_fixture_id, error_body: "") {
    JitConfigMinted { config: c, runner_id: _ } => [c]
    _ => []
  }
}

// 20 characters: GitHub never mints this short, and it is the fail-open receipt's shape --
// something that is not a whole credential, handed on as if it were.
data short_blob: String = "ZmFrZS1qaXQtY29uZmln"

fn received_for(attempt: MicroVmAttempt, encoded: String) -> JitMintPerformance {
  match minted_credential(encoded: encoded) {
    Cons { head: c, tail: _ } =>
      JitMintReceived {
        delivery: JitCredentialBoundToAttempt { attempt: attempt, credential: c, runner_id: registration_fixture_id },
      }
    Empty {} => JitMintAppJwtUnsigned { detail: "fixture: credential fixture did not mint" }
  }
}

fn live_grant(attempt: MicroVmAttempt) -> JitMintPerformance {
  received_for(attempt: attempt, encoded: doubled(s: "A", k: 10))
}

fn plan_for(
  pair: IssuedPair,
  account: MoneyAccount,
  attempt: MicroVmAttempt,
  mint: JitMintPerformance,
  ground: AttemptGround,
) -> AttemptLaunchPlan {
  plan_attempt_launch(
    grant: pair.grant,
    account: account,
    money_generation: issued_money_generation,
    work: pair.grant.context.work,
    demand: pair.grant.context.demand,
    offer: pair.grant.object.offer,
    attempt: attempt,
    mint: mint,
    ground: ground,
    jailer_binary: "/bin/jailer",
    firecracker_binary: "/bin/firecracker",
    kernel_source: "/stage/vmlinux",
    rootfs_source: "/stage/rootfs.squashfs",
    guest_size: gunbc_runner_microvm_declared_size,
  )
}

fn refusal_of(plan: AttemptLaunchPlan) -> List<JitDeviceRefusal> {
  match plan {
    LaunchRefusedJitCredential { refusal: r } => [r]
    _ => []
  }
}

// NEITHER A DEVICE NOR A VMM. The device and the jailer are fields of the one LaunchAuthorized arm,
// so the law is carried by the plan's shape: zero launches IS zero devices. This helper counts
// launches and says nothing more; a second count read off the same arm would be green by
// construction (DESIGN §4b).
fn no_device_no_vmm(plan: AttemptLaunchPlan) -> Bool {
  planned_jailer_launches(plan: plan) == 0
}

// THE RECEIPTED FAIL-OPEN, AS A RED. X staged whatever bytes it had and launched. A credential below
// the floor must yield no device and no VMM, and the refusal must say it was the floor.
test fn a_below_floor_credential_stages_no_device_and_starts_no_vmm() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 1, id: "cred0") {
        Cons { head: a, tail: _ } => {
          let plan = plan_for(pair: pair, account: pair.account, attempt: a, mint: received_for(attempt: a, encoded: short_blob), ground: GroundClear)
          no_device_no_vmm(plan: plan)
            && match refusal_of(plan: plan) {
              Cons { head: JitCredentialBelowFloor { bytes: n }, tail: _ } => byte_size_count(b: n) == 20
              _ => false
            }
        }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn an_above_ceiling_credential_stages_no_device_and_starts_no_vmm() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 1, id: "credbig") {
        Cons { head: a, tail: _ } => {
          let plan = plan_for(pair: pair, account: pair.account, attempt: a, mint: received_for(attempt: a, encoded: doubled(s: "A", k: 17)), ground: GroundClear)
          no_device_no_vmm(plan: plan)
            && match refusal_of(plan: plan) {
              Cons { head: JitCredentialAboveCeiling { bytes: _ }, tail: _ } => true
              _ => false
            }
        }
        Empty {} => false
      }
    Empty {} => false
  }
}

// A CREDENTIAL IS THE ATTEMPT'S OR IT IS NOBODY'S. A live credential bound to a sibling attempt on
// the same slot must not become this attempt's device -- that is the segment race inside one host.
test fn a_credential_bound_to_another_attempt_stages_no_device() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 6, id: "mine") {
        Cons { head: a, tail: _ } =>
          match accepted_attempt(i: 6, id: "theirs") {
            Cons { head: b, tail: _ } => {
              let plan = plan_for(pair: pair, account: pair.account, attempt: a, mint: live_grant(attempt: b), ground: GroundClear)
              no_device_no_vmm(plan: plan)
                && match refusal_of(plan: plan) {
                  Cons { head: JitCredentialBoundToDifferentAttempt { bound_to: other }, tail: _ } => other == b
                  _ => false
                }
            }
            Empty {} => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

// EVERY NON-DELIVERY ARM OF THE MINT -- an unsigned App JWT, a commit-ambiguous generate step, and a
// GitHub refusal that created nothing -- yields no device and no VMM, and each is carried as ITS
// OWN refusal rather than collapsed into one "no credential".
test fn a_mint_that_delivered_nothing_stages_no_device_and_starts_no_vmm() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 5, id: "nomint") {
        Cons { head: a, tail: _ } => {
          let unsigned = plan_for(pair: pair, account: pair.account, attempt: a,
            mint: JitMintAppJwtUnsigned { detail: "fixture: openssl refused the key" }, ground: GroundClear)
          let ambiguous = plan_for(pair: pair, account: pair.account, attempt: a,
            mint: JitMintStepNotSucceeded {
              step: GenerateJitConfigStep,
              performance: RestExchangeCommitAmbiguous { detail: "fixture: no response to the generate POST" },
            }, ground: GroundClear)
          let refused = plan_for(pair: pair, account: pair.account, attempt: a,
            mint: JitMintReceived {
              delivery: JitCredentialMintNotCreated {
                outcome: jit_config_mint_outcome(status: 409, encoded: "", runner_id: 0, error_body: "fixture: name taken"),
              },
            }, ground: GroundClear)
          no_device_no_vmm(plan: unsigned) && no_device_no_vmm(plan: ambiguous) && no_device_no_vmm(plan: refused)
            && match refusal_of(plan: unsigned) {
              Cons { head: JitMintNotReceived { performance: _ }, tail: _ } => true
              _ => false
            }
            && match refusal_of(plan: ambiguous) {
              Cons { head: JitMintNotReceived { performance: _ }, tail: _ } => true
              _ => false
            }
            && match refusal_of(plan: refused) {
              Cons { head: JitCredentialNotDelivered { delivery: _ }, tail: _ } => true
              _ => false
            }
        }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn an_unauthorized_grant_yields_zero_jailer_launches() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 2, id: "unauth") {
        Cons { head: a, tail: _ } =>
          match plan_for(pair: pair, account: exhausted_account, attempt: a, mint: live_grant(attempt: a), ground: GroundClear) {
            LaunchRefusedUnauthorized { authorization: _ } =>
              no_device_no_vmm(plan: plan_for(pair: pair, account: exhausted_account, attempt: a, mint: live_grant(attempt: a), ground: GroundClear))
            _ => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn prior_resources_refuse_rather_than_reuse() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 3, id: "prior") {
        Cons { head: a, tail: _ } =>
          match plan_for(pair: pair, account: pair.account, attempt: a, mint: live_grant(attempt: a), ground: GroundOccupied) {
            LaunchRefusedPriorResources =>
              no_device_no_vmm(plan: plan_for(pair: pair, account: pair.account, attempt: a, mint: live_grant(attempt: a), ground: GroundOccupied))
            _ => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

fn jit_drive_is_read_only_at(cfg_drives: List<FirecrackerDrive>, path: String) -> Bool {
  fold(cfg_drives, init: false, f: (acc, d) =>
    acc || ((d.path_on_host as String) == path && d.is_read_only))
}

// THE POSITIVE CONTROL. Without it every red above is satisfied by a planner that refuses
// unconditionally. A live grant yields EXACTLY ONE staged device and one launch; the device is the
// attempt's jail /jit.bin, created 0400 and owned by the uid the jailer drops to BEFORE any byte is
// written, padded to whole sectors, carrying the minted credential unchanged; the VM sees it only
// as a read-only drive; and the registration id and runner name are recorded on the launch.
test fn a_live_grant_stages_exactly_one_device_and_records_the_registration() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 4, id: "ok1") {
        Cons { head: a, tail: _ } => {
          let plan = plan_for(pair: pair, account: pair.account, attempt: a, mint: live_grant(attempt: a), ground: GroundClear)
          planned_jailer_launches(plan: plan) == 1
            && match plan {
              LaunchAuthorized {
                authorization: _,
                jit_runner_name: name,
                jit_registration_id: reg,
                jit_device: device,
                tap_device: tap,
                guest_ip_boot_arg: ip,
                nft_ruleset: nft,
                slice: _,
                jail_root: jail_root,
                stage_jail_root: stage_root,
                stage_kernel: stage_k,
                stage_rootfs: stage_r,
                workspace_path: ws,
                workspace_create: create,
                workspace_format: fmt,
                kvm_device: kvm,
                vm_config: cfg,
                jailer: jailer,
              } => {
                let words = join(argv_words(command: jailer), " ")
                let create_words = join(argv_words(command: create), " ")
                let device_create = join(argv_words(command: device.create), " ")
                let device_pad = join(argv_words(command: device.pad), " ")
                reg == registration_fixture_id
                  && (name.value as String) == (runner_microvm_attempt_unit_name(attempt: a) as String)
                  && device.host_path == concat(jail_root, jail_jit_path as String)
                  && (device.create.program as String) == "install"
                  && string_contains(s: device_create, pattern: "-m 0400 -o 1000 -g 1000 /dev/null")
                  && string_contains(s: device_create, pattern: device.host_path)
                  && (device.pad.program as String) == "truncate"
                  && string_contains(s: device_pad, pattern: "-s 65536")
                  && (device.credential.encoded as String) == doubled(s: "A", k: 10)
                  && jit_drive_is_read_only_at(cfg_drives: cfg.drives, path: jail_jit_path as String)
                  && (tap as String) == (runner_slot_tap_device_name(slot: a.slot) as String)
                  && nft == runner_microvm_nft_ruleset_text()
                  && jail_root == attempt_jail_chroot_root(attempt: a, firecracker_binary: "/bin/firecracker")
                  && (stage_root.program as String) == (mkdir_binary_path as String)
                  && (stage_k.program as String) == "cp"
                  && (stage_r.program as String) == "cp"
                  && string_contains(s: ws, pattern: runner_microvm_attempt_jail_base(attempt: a))
                  && string_contains(s: ws, pattern: jail_workspace_path as String)
                  && string_contains(s: create_words, pattern: concat("of=", ws))
                  && workspace_drive_path_on_host(config: cfg) == (jail_workspace_path as String)
                  && (kvm as String) == (firecracker_requires_kvm_device as String)
                  && string_contains(s: ip, pattern: "ip=")
                  && string_contains(s: words, pattern: "--exec-file")
                  && string_contains(s: words, pattern: "--no-api")
                  && string_contains(s: words, pattern: "--chroot-base-dir")
                  && string_contains(s: words, pattern: "--cgroup-version")
                  && string_contains(s: words, pattern: "/bin/jailer")
                  && (fmt.program as String) == "mke2fs"
                  && (create.program as String) == "/bin/busybox"
                  && string_contains(s: create_words, pattern: "count=0")
                  && string_contains(s: create_words, pattern: "seek=4096")
                  && count(cfg.drives) == 3
              }
              _ => false
            }
        }
        Empty {} => false
      }
    Empty {} => false
  }
}

// THE READBACK DECIDES ON WHAT THE HOST REPORTS. Each of the three facts refuses on its own -- a
// root-owned device (unreadable to the dropped uid), a group-readable one, a short one -- and the
// exact triple the staging should produce is the only one that admits.
test fn staging_readback_refuses_each_wrong_fact_and_admits_the_right_one() -> Bool {
  let refused_owner = match jit_device_readback(uid: "0", mode: "400", size: "65536") {
    Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: _ } } => true
    _ => false
  }
  let refused_mode = match jit_device_readback(uid: "1000", mode: "440", size: "65536") {
    Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: _ } } => true
    _ => false
  }
  let refused_size = match jit_device_readback(uid: "1000", mode: "400", size: "1024") {
    Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: _ } } => true
    _ => false
  }
  let admitted = match jit_device_readback(uid: "1000", mode: "400", size: "65536") {
    Absent => true
    Present { value: _ } => false
  }
  refused_owner && refused_mode && refused_size && admitted
}

test fn a_clean_vmm_exit_is_not_evidence_that_work_ran() -> Bool {
  match work_standing_from_vmm_exit(exit_code: 0) {
    WorkNotEstablished { vmm_exit: z } =>
      match work_standing_from_vmm_exit(exit_code: 1) {
        WorkNotEstablished { vmm_exit: o } => z == 0 && o == 1
      }
  }
}

test fn reported_rung_is_the_minimum_across_paths_and_is_mitigatable() -> Bool {
  match reported_attempt_launch_rung() {
    Mitigatable => true
    OutsideTheLadder => false
    MechanicallyPreventable => false
    StructurallyGuaranteed => false
    StructurallyImpossible => false
  }
}

test fn the_cutover_frontier_is_unbound() -> Bool {
  match host_boot_cutover_frontier {
    UnboundDissolution { description: _ } => true
    BoundDissolution { trigger: _ } => false
  }
}
