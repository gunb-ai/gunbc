data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data issued_money_generation: Int = money_request.generation

type IssuedPair {
  grant: ExecutionGrant<NonEmptyStr>
  account: MoneyAccount
}

fn issued_pairs() -> List<IssuedPair> {
  match issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  ) {
    Cons { head: o, tail: _ } =>
      match o {
        GrantCommitted { grant: g, account: a, ledger: _ } =>
          [IssuedPair { grant: g, account: a }]
        GrantRefused { refusal: _ } => []
      }
    Empty {} => []
  }
}

fn slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv2, slot_index: i }
}

fn accepted_attempt(i: Nat, id: String) -> List<MicroVmAttempt> {
  match microvm_attempt(slot: slot(i: i), attempt_id: id) {
    MicroVmAttemptAccepted { attempt: a } => [a]
    MicroVmAttemptRefused { refusal: _ } => []
  }
}

fn plan_for(
  pair: IssuedPair,
  account: MoneyAccount,
  attempt: MicroVmAttempt,
  envelope: EnvelopeStanding,
  ground: AttemptGround,
) -> AttemptLaunchPlan {
  plan_attempt_launch(
    grant: pair.grant,
    account: account,
    money_generation: issued_money_generation,
    work: pair.grant.context.work,
    demand: pair.grant.context.demand,
    offer: pair.grant.object.offer,
    attempt: attempt,
    envelope: envelope,
    ground: ground,
    jailer_binary: "/bin/jailer",
    firecracker_binary: "/bin/firecracker",
    kernel_source: "/stage/vmlinux",
    rootfs_source: "/stage/rootfs.squashfs",
    guest_size: gunbc_runner_microvm_declared_size,
  )
}

fn admitted(n: Nat) -> EnvelopeStanding {
  EnvelopeAdmitted { bytes: byte_size(count: n) }
}

fn launches_for(
  pair: IssuedPair,
  account: MoneyAccount,
  attempt: MicroVmAttempt,
  envelope: EnvelopeStanding,
  ground: AttemptGround,
) -> Int {
  planned_jailer_launches(plan: plan_for(
    pair: pair, account: account, attempt: attempt, envelope: envelope, ground: ground,
  ))
}

test fn a_zero_byte_credential_does_not_start_the_vmm() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 1, id: "cred0") {
        Cons { head: a, tail: _ } =>
          match plan_for(pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 0), ground: GroundClear) {
            LaunchRefusedEnvelope { standing: s } =>
              match s {
                EnvelopePayloadBelowFloor { bytes: n } =>
                  byte_size_count(b: n) == 0 && launches_for(
                    pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 0), ground: GroundClear,
                  ) == 0
                EnvelopeAdmitted { bytes: _ } => false
                EnvelopeAbsent => false
                EnvelopeMalformed => false
                EnvelopeSignatureRejected => false
                EnvelopeBoundToDifferentUnit => false
                EnvelopeBoundToDifferentBoot => false
                EnvelopeNonceMismatch => false
                EnvelopeBoundToDifferentAttempt => false
                EnvelopePayloadDigestMismatch => false
                EnvelopePayloadAboveCeiling { bytes: _ } => false
                EnvelopeAdmissionAxisNotRequired => false
              }
            LaunchRefusedUnauthorized { authorization: _ } => false
            LaunchRefusedPriorResources => false
            LaunchAuthorized {
              authorization: _,
              tap_device: _,
              guest_ip_boot_arg: _,
              nft_ruleset: _,
              slice: _,
              jail_root: _,
              stage_jail_root: _,
              stage_kernel: _,
              stage_rootfs: _,
              workspace_path: _,
              workspace_create: _,
              workspace_format: _,
              kvm_device: _,
              vm_config: _,
              jailer: _,
            } => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn an_unauthorized_grant_yields_zero_jailer_launches() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 2, id: "unauth") {
        Cons { head: a, tail: _ } =>
          match plan_for(
            pair: pair, account: exhausted_account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
          ) {
            LaunchRefusedUnauthorized { authorization: _ } =>
              launches_for(
                pair: pair, account: exhausted_account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
              ) == 0
            _ => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn prior_resources_refuse_rather_than_reuse() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 3, id: "prior") {
        Cons { head: a, tail: _ } =>
          match plan_for(
            pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundOccupied,
          ) {
            LaunchRefusedPriorResources => launches_for(
              pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundOccupied,
            ) == 0
            _ => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn an_authorized_plan_carries_network_slice_workspace_and_jailer_command() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 4, id: "ok1") {
        Cons { head: a, tail: _ } =>
          match plan_for(
            pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
          ) {
            LaunchAuthorized {
              authorization: _,
              tap_device: tap,
              guest_ip_boot_arg: ip,
              nft_ruleset: nft,
              slice: _,
              jail_root: jail_root,
              stage_jail_root: stage_root,
              stage_kernel: stage_k,
              stage_rootfs: stage_r,
              workspace_path: ws,
              workspace_create: create,
              workspace_format: fmt,
              kvm_device: kvm,
              vm_config: cfg,
              jailer: jailer,
            } => {
              let words = join(argv_words(command: jailer), " ")
              let create_words = join(argv_words(command: create), " ")
              (tap as String) == (runner_slot_tap_device_name(slot: a.slot) as String)
                && nft == runner_microvm_nft_ruleset_text()
                && jail_root == attempt_jail_chroot_root(attempt: a, firecracker_binary: "/bin/firecracker")
                && (stage_root.program as String) == (mkdir_binary_path as String)
                && (stage_k.program as String) == "cp"
                && (stage_r.program as String) == "cp"
                && string_contains(s: ws, pattern: runner_microvm_attempt_jail_base(attempt: a))
                && string_contains(s: ws, pattern: jail_workspace_path as String)
                && string_contains(s: create_words, pattern: concat("of=", ws))
                && workspace_drive_path_on_host(config: cfg) == (jail_workspace_path as String)
                && (kvm as String) == (firecracker_requires_kvm_device as String)
                && string_contains(s: ip, pattern: "ip=")
                && string_contains(s: words, pattern: "--exec-file")
                && string_contains(s: words, pattern: "--no-api")
                && string_contains(s: words, pattern: "--chroot-base-dir")
                && string_contains(s: words, pattern: "--cgroup-version")
                && string_contains(s: words, pattern: "/bin/jailer")
                && (fmt.program as String) == "mke2fs"
                && (create.program as String) == "/bin/busybox"
                && string_contains(s: join(argv_words(command: create), " "), pattern: "count=0")
                && string_contains(s: join(argv_words(command: create), " "), pattern: "seek=4096")
                && count(cfg.drives) == 3
                && planned_jailer_launches(plan: plan_for(
                  pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: GroundClear,
                )) == 1
            }
            LaunchRefusedUnauthorized { authorization: _ } => false
            LaunchRefusedEnvelope { standing: _ } => false
            LaunchRefusedPriorResources => false
          }
        Empty {} => false
      }
    Empty {} => false
  }
}

test fn a_clean_vmm_exit_is_not_evidence_that_work_ran() -> Bool {
  match work_standing_from_vmm_exit(exit_code: 0) {
    WorkNotEstablished { vmm_exit: z } =>
      match work_standing_from_vmm_exit(exit_code: 1) {
        WorkNotEstablished { vmm_exit: o } => z == 0 && o == 1
      }
  }
}

test fn reported_rung_is_the_minimum_across_paths_and_is_mitigatable() -> Bool {
  match reported_attempt_launch_rung() {
    Mitigatable => true
    OutsideTheLadder => false
    MechanicallyPreventable => false
    StructurallyGuaranteed => false
    StructurallyImpossible => false
  }
}

test fn the_cutover_and_mint_frontiers_are_unbound() -> Bool {
  match host_boot_cutover_frontier {
    UnboundDissolution { description: _ } =>
      match jit_mint_http_realization_frontier {
        UnboundDissolution { description: _ } =>
          match jail_jit_device_staging_frontier {
            UnboundDissolution { description: _ } => true
            BoundDissolution { trigger: _ } => false
          }
        BoundDissolution { trigger: _ } => false
      }
    BoundDissolution { trigger: _ } => false
  }
}

test fn every_x_envelope_refusal_arm_yields_zero_jailer_launches() -> Bool {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 5, id: "envx") {
        Cons { head: a, tail: _ } =>
          launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeAbsent, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeMalformed, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeSignatureRejected, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeBoundToDifferentUnit, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeBoundToDifferentBoot, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeNonceMismatch, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeBoundToDifferentAttempt, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopePayloadDigestMismatch, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopePayloadBelowFloor { bytes: byte_size(count: 100) }, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopePayloadAboveCeiling { bytes: byte_size(count: 70000) }, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: EnvelopeAdmissionAxisNotRequired, ground: GroundClear) == 0
            && launches_for(pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 70000), ground: GroundClear) == 0
        Empty {} => false
      }
    Empty {} => false
  }
}


fn good_workspace() -> WorkspaceStagingObservation {
  WorkspaceStagingObservation {
    create_exit: 0,
    format_exit: 0,
    readback: WorkspaceSuperblockRead { ext_magic: true, bytes: runner_attempt_workspace_bytes() },
  }
}

fn staging_label(v: AttemptStagingVerdict) -> String {
  match v {
    StagingAdmitsJailer { jailer: _ } => "admit"
    StagingNotAuthorized => "unauthorized"
    StagingRefusedWorkspace { standing: s } => match s {
      WorkspaceReady => "ready-refused"
      WorkspaceCreateFailed { exit: _ } => "create"
      WorkspaceFormatFailed { exit: _ } => "format"
      WorkspaceNotExtFilesystem => "not-ext"
      WorkspaceSizeMismatch { observed: _, expected: _ } => "size"
      WorkspaceUnreadable { reason: _ } => "unreadable"
    }
  }
}

fn staging_for(obs: WorkspaceStagingObservation, ground: AttemptGround) -> String {
  match issued_pairs() {
    Cons { head: pair, tail: _ } =>
      match accepted_attempt(i: 2, id: "ws1") {
        Cons { head: a, tail: _ } => staging_label(v: staging_verdict(
          plan: plan_for(pair: pair, account: pair.account, attempt: a, envelope: admitted(n: 4096), ground: ground),
          obs: obs,
        ))
        Empty {} => "no-attempt"
      }
    Empty {} => "no-grant"
  }
}

// THE JAILER IS REACHED ONLY THROUGH A READ-BACK WORKSPACE. The positive control admits; each
// failure refuses under its own name, and the earliest failure is the one named -- a failed create
// with a failed format reports the create. The red is any arm that launches onto a workspace the
// host did not read back as an ext filesystem of the planned size.
test fn the_jailer_is_admitted_only_onto_a_read_back_workspace() -> Bool {
  staging_for(obs: good_workspace(), ground: GroundClear) == "admit"
    && staging_for(obs: WorkspaceStagingObservation {
      create_exit: 1, format_exit: 1, readback: WorkspaceReadbackFailed { reason: "absent" as NonEmptyStr },
    }, ground: GroundClear) == "create"
    && staging_for(obs: WorkspaceStagingObservation {
      create_exit: 0, format_exit: 1, readback: WorkspaceSuperblockRead { ext_magic: true, bytes: runner_attempt_workspace_bytes() },
    }, ground: GroundClear) == "format"
    && staging_for(obs: WorkspaceStagingObservation {
      create_exit: 0, format_exit: 0, readback: WorkspaceSuperblockRead { ext_magic: false, bytes: runner_attempt_workspace_bytes() },
    }, ground: GroundClear) == "not-ext"
    && staging_for(obs: WorkspaceStagingObservation {
      create_exit: 0, format_exit: 0, readback: WorkspaceSuperblockRead { ext_magic: true, bytes: byte_size(count: 1048576) },
    }, ground: GroundClear) == "size"
    && staging_for(obs: WorkspaceStagingObservation {
      create_exit: 0, format_exit: 0, readback: WorkspaceReadbackFailed { reason: "dumpe2fs exited 1" as NonEmptyStr },
    }, ground: GroundClear) == "unreadable"
}

// A GOOD WORKSPACE CANNOT BUY A LAUNCH THE PLAN REFUSED. The red is a staging gate that reads only
// the observation: occupied ground would then launch because the image happened to format.
test fn a_good_workspace_does_not_admit_a_refused_plan() -> Bool {
  staging_for(obs: good_workspace(), ground: GroundOccupied) == "unauthorized"
}

// THE READBACK READS THE PLANNED IMAGE'S SUPERBLOCK, AND ITS CONSUMER IS STILL A FRONTIER. The red
// for the first half is a readback of any path but the one the plan formatted.
test fn the_workspace_readback_reads_the_planned_image_and_its_consumer_is_a_frontier() -> Bool {
  argv_words(command: workspace_readback_command(workspace_path: "/jail/work.img")) == ["dumpe2fs", "-h", "/jail/work.img"]
    && match workspace_staging_consumer_frontier {
      UnboundDissolution { description: _ } => true
      BoundDissolution { trigger: _ } => false
    }
}
