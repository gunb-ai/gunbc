module test.claim.runner.runner_slot_retire_route_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import std.types { NonEmptyStr, String, list_length }
import gunbc.fleet_intent_network { operator_host_srv2, operator_host_srv4 }
import gunbc.runner_slot_retire_run {
  RetirementRouteAdmitted,
  RetirementRouteRefused,
  retirement_route_admission,
  RetirementDispatchNotThisMode,
  RetirementDispatchAdmitted,
  RetirementDispatchUnnamed,
  admit_retirement_dispatch,
  runner_slot_retire_dispatch_mode_wire,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── THE EXECUTOR IS NOT THE TARGET ───────────────────────────────────────────────────────────

// THE POSITIVE CONTROL. A retained executor reaching a declared retirement target is admitted, and
// the subject it produces names the TARGET -- not the machine the process is running on.
test fn a_retained_executor_reaching_a_declared_target_is_admitted() -> Bool {
  match retirement_route_admission(executor_raw: "srv1", target_raw: "srv2") {
    RetirementRouteAdmitted { subject: s } =>
      (s.target as String) == (operator_host_srv2 as String) && (s.executor as String) == "srv1"
    RetirementRouteRefused { cause: _ } => false
  }
}

// THE DISCRIMINATING RED, AND IT IS THE REQUEST'S OWN SENTENCE: the run must not select its own
// execution slot. A form with two boxes admits the same value in both, so the refusal is an equality
// between the carried values rather than an assumption that two fields hold two machines.
test fn a_run_may_not_select_its_own_execution_slot() -> Bool {
  match retirement_route_admission(executor_raw: "srv2", target_raw: "srv2") {
    RetirementRouteRefused { cause: _ } => true
    RetirementRouteAdmitted { subject: _ } => false
  }
}

// A TARGET NOBODY DECLARED RETIRING IS REFUSED, which keeps this route from becoming a general
// purpose remote systemctl pointed at whatever host an operator typed.
test fn a_target_with_no_declared_retirement_is_refused() -> Bool {
  match retirement_route_admission(executor_raw: "srv1", target_raw: "srv4") {
    RetirementRouteRefused { cause: _ } => true
    RetirementRouteAdmitted { subject: _ } => false
  }
}

test fn an_empty_executor_is_refused() -> Bool {
  match retirement_route_admission(executor_raw: "", target_raw: "srv2") {
    RetirementRouteRefused { cause: _ } => true
    RetirementRouteAdmitted { subject: _ } => false
  }
}

test fn an_empty_target_is_refused() -> Bool {
  match retirement_route_admission(executor_raw: "srv1", target_raw: "") {
    RetirementRouteRefused { cause: _ } => true
    RetirementRouteAdmitted { subject: _ } => false
  }
}

// ── THE DISPATCH ADMISSION, WHICH HAS TO FIRE BEFORE ANY RUNNER IS ASKED FOR ─────────────────

// THE SILENT-STALL CLASS. An omitted executor interpolates into runs-on as an empty label, which no
// machine carries, so the job queues until its backstop with no receipt and the entry's own refusal
// is never reached. This gate runs in the always-schedulable build job.
test fn an_unnamed_executor_refuses_at_dispatch() -> Bool {
  match admit_retirement_dispatch(mode: runner_slot_retire_dispatch_mode_wire, executor: "", target: "srv2") {
    RetirementDispatchUnnamed { cause: _ } => true
    RetirementDispatchAdmitted { executor: _, target: _ } => false
    RetirementDispatchNotThisMode { mode: _ } => false
  }
}

test fn a_self_targeting_dispatch_refuses_before_anything_is_scheduled() -> Bool {
  match admit_retirement_dispatch(mode: runner_slot_retire_dispatch_mode_wire, executor: "srv2", target: "srv2") {
    RetirementDispatchUnnamed { cause: _ } => true
    RetirementDispatchAdmitted { executor: _, target: _ } => false
    RetirementDispatchNotThisMode { mode: _ } => false
  }
}

// ANOTHER MODE'S DISPATCH IS NOT THIS GATE'S BUSINESS, and it exits SUCCESSFULLY rather than
// skipping -- a gate that silently declines to run reads as a pass to anyone looking at the job list.
test fn another_mode_passes_the_retirement_dispatch_gate() -> Bool {
  match admit_retirement_dispatch(mode: "apply", executor: "", target: "") {
    RetirementDispatchNotThisMode { mode: _ } => true
    RetirementDispatchUnnamed { cause: _ } => false
    RetirementDispatchAdmitted { executor: _, target: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE GATE, without which every refusal above is satisfied by a gate that
// admits nothing.
test fn a_well_formed_retirement_dispatch_is_admitted() -> Bool {
  match admit_retirement_dispatch(mode: runner_slot_retire_dispatch_mode_wire, executor: "srv1", target: "srv2") {
    RetirementDispatchAdmitted { executor: e, target: t } => e == "srv1" && t == "srv2"
    RetirementDispatchUnnamed { cause: _ } => false
    RetirementDispatchNotThisMode { mode: _ } => false
  }
}
