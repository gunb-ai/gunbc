test fn witness_actions_runner_release_cites_github_digest() -> Bool {
  match actions_runner_binary_artifact_for_arch(binary_release: actions_runner_release_2_336_0, arch: Aarch64) {
    Present { value: artifact } =>
      string_contains(
        s: actions_runner_download_url(artifact: artifact),
        pattern: "github.com/actions/runner/releases/download/v2.336.0/actions-runner-linux-arm64-2.336.0.tar.gz",
      )
    Absent => false
  }
}

test fn witness_runner_count_not_in_installer_argv() -> Bool {
  let rendered = shell_command_render(
    command: runner_host_installer_command_argv(
      deploy: wt_srv3_deploy(),
      installer_path: "/tmp/install-actions-runner.sh",
      pem_src_path: "/tmp/app.pem",
    ),
  )
  string_contains(s: rendered, pattern: "CTRL_RUNNER_HOST_LABEL=srv3")
    && (string_contains(s: rendered, pattern: "runner_count") == false)
    && (string_contains(s: rendered, pattern: "CTRL_RUNNER_SLOT") == false)
}

// THE NAMING IS WHAT THIS ROW CHECKS; THE WIDTH LITERAL IT USED TO CARRY IS GONE.
//
// It read `== 6` on both the count and the last instance name, which was a measurement copied from
// the tree the day it was written. The 2026-08-23 CPU-axis change moved srv3 to twenty-one and the
// row went red without a single thing about instance NAMING having changed -- which is the tell that
// the literal was never the claim (DESIGN section 5: a measurement copied from the same current tree
// is not an oracle).
//
// What survives is the part a fixture can falsify independently of width: the roster is exactly as
// long as the row says it is, it is one-based, and it is zero-padded. Width itself is asserted where
// width is decided, not restated here.
test fn witness_srv3_deploy_row_names_its_declared_slots() -> Bool {
  let names = runner_instance_names(deploy: wt_srv3_deploy())
  list_length(items: names) == wt_srv3_deploy().runner_count
    && string_contains(s: names.first(), pattern: "srv3-01")
    && list_length(items: names) > 1
    && roster_names_are_distinct(names: names)
}

// The reconcile fixtures plant their OWN five-slot deploy row rather than
// reading the live fleet, so the expected counts below are exact literals
// authored beside a known input — not a restatement of whatever width the
// fleet happens to declare. srv3's real width is asserted separately, by
// witness_srv3_deploy_row_names_its_declared_slots.
fn fixture_five_slot_deploy() -> RunnerHostDeploy {
  RunnerHostDeploy {
    host_label: "wfix",
    ssh_target: "fixture@invalid.example",
    runner_user: "fixture",
    unit_user: "root",
    job_user: "fixture",
    app: gunbc_ci_github_app,
    runner_count: 5,
  }
}

test fn witness_membership_reconcile_adds_delta_slots() -> Bool {
  let observed: List<RunnerSlotMember> = [
    RunnerSlotMember {
      instance_name: "wfix-01" as NonEmptyStr,
      slot_dir: "/opt/actions-runner/wfix-01" as NonEmptyStr,
      provenance: SlotProvenanceUnobserved,
    },
    RunnerSlotMember {
      instance_name: "wfix-02" as NonEmptyStr,
      slot_dir: "/opt/actions-runner/wfix-02" as NonEmptyStr,
      provenance: SlotProvenanceUnobserved,
    },
  ]
  let plan = runner_slot_membership_reconcile(
    desired: desired_runner_slot_members(deploy: fixture_five_slot_deploy()),
    observed: observed,
  )
  membership_added_count(plan: plan) == 3
}

test fn witness_provision_plan_extracts_only_upserts() -> Bool {
  match actions_runner_binary_artifact_for_arch(binary_release: actions_runner_release_2_336_0, arch: Aarch64) {
    Present { value: artifact } =>
      let observed: List<RunnerSlotMember> = [
        RunnerSlotMember {
          instance_name: "wfix-01" as NonEmptyStr,
          slot_dir: "/opt/actions-runner/wfix-01" as NonEmptyStr,
          provenance: SlotProvenanceUnobserved,
        },
      ]
      let plan = runner_slot_provision_plan(
        deploy: fixture_five_slot_deploy(),
        artifact: artifact,
        observed: observed,
        retirement_evidence: no_retirement_evidence(),
      )
      runner_slot_provision_has_width_increase(plan: plan)
        && list_length(items: plan.upsert_extract_scripts) == 4
        && string_contains(s: plan.base_dir_script, pattern: "/opt/actions-runner")
        && string_contains(s: plan.upsert_extract_scripts.first(), pattern: "sha256sum -c")
    Absent => false
  }
}

test fn witness_enumeration_postcondition_red_on_under_count() -> Bool {
  let observed: List<RunnerSlotMember> = [
    RunnerSlotMember {
      instance_name: "srv3-01" as NonEmptyStr,
      slot_dir: "/opt/actions-runner/srv3-01" as NonEmptyStr,
      provenance: SlotProvenanceUnobserved,
    },
  ]
  match runner_slot_enumeration_postcondition(host: operator_host_srv3, observed: observed) {
    RunnerSlotEnumerationMismatch { host: h, declared_count: d, observed_count: o } =>
      h == operator_host_srv3
        && d == gunbc_runner_slots_per_host(host: operator_host_srv3)
        && o == 1
        && d > o
    RunnerSlotEnumerationMatched => false
  }
}

// SAME CORRECTION AS srv3 ABOVE, and the same reason: this row pinned six on both sides of an `&&`,
// so it measured the tree rather than checking a relation. The relation it was reaching for is that
// the instance roster and the declared count cannot disagree, which holds at any width.
test fn witness_srv4_instance_roster_matches_its_declared_count() -> Bool {
  let names = runner_instance_names(deploy: wt_srv4_deploy())
  list_length(items: names) == wt_srv4_deploy().runner_count
    && roster_names_are_distinct(names: names)
}

// A LENGTH IS NOT A ROSTER, AND EVERY PURE LENGTH ASSERTION IN THIS FILE HAD THIS HOLE.
//
// A generator emitting ONE name N times satisfies `list_length(names) == count` perfectly while
// deploying a single runner N ways -- N units all pointing at one slot directory, one registration
// name contending with itself. The count check cannot see it because the count is right.
//
// Found by silent-bear-842, who independently rewrote these rows and asked what a length assertion
// does NOT cover before shipping. Kept as a named function rather than inlined because it belongs
// beside every length claim, not just this one.
fn roster_names_are_distinct(names: List<String>) -> Bool {
  !any(names, a => list_length(items: filter(names, b => b == a)) > 1)
}

// THE INDEXING CONTRACT, PINNED ON GROUND THAT CANNOT MOVE.
//
// The rows this file used to carry asserted srv3-01 and srv3-06 by name -- one-based, zero-padded,
// last index equals count. Those were real claims and they were deleted along with the width
// literals they were entangled with, because every index expectation was a function of a width the
// CPU axis then moved. Deriving the expectation from the width would have made it vacuous: the
// enumerator would be checked against itself.
//
// An AUTHORED runner_count breaks that circle. Three is a number the allocation authority never
// produced and never will, so this row pins one-basedness, zero-padding and the count-to-last-index
// relation without consulting the fleet at all. That is the planted-fixture side of the
// authority-witness / boundary-probe split: a fixture that authors its own input SHOULD carry
// literals, and only a probe aimed at a live authority must derive its discriminator.
//
// Measured discriminating rather than assumed: under a planted one-off in runner_instance_names
// (mapping over runner_count - 1) this row returns false, as do the two length rows above
// (silent-bear-842).
data authored_three_slot_deploy: RunnerHostDeploy = RunnerHostDeploy {
  host_label: "fixture-host",
  ssh_target: "fixture@203.0.113.1",
  runner_user: "fixture",
  unit_user: "root",
  job_user: "fixturejob",
  app: gunbc_ci_github_app,
  runner_count: 3,
}

test fn an_authored_count_enumerates_exactly_that_many_indexed_names() -> Bool {
  let names = runner_instance_names(deploy: authored_three_slot_deploy)
  list_length(items: names) == 3
    && string_contains(s: names.first(), pattern: "fixture-host-01")
    && string_contains(s: names.skip(n: 2).first(), pattern: "fixture-host-03")
    && roster_names_are_distinct(names: names)
}

// --- converge seam: the refusal must be real, not decorative ----------------------------------

// THESE FOUR ROWS EXIST BECAUSE THE REFUSAL ARM IS THE ENTIRE POINT OF THE SEAM. An observation
// type with an Unobserved arm that nothing can drive is a decoration -- permanently green by
// construction and worse than absent, because it gets cited as coverage. The fixture below authors
// the unobserved state directly, so the arm has a RED that a fixture may produce, and the planned
// control beside it stops the refusal being satisfied by refusing always.

data unobserved_fixture: RunnerSlotObservation = RunnerSlotsUnobserved {
  reason: "FIXTURE: the base-directory listing refused" as NonEmptyStr,
}

data observed_two_fixture: RunnerSlotObservation = RunnerSlotsObserved {
  members: [
    runner_slot_member_from_instance_name(instance_name: "srv1-01"),
    runner_slot_member_from_instance_name(instance_name: "srv1-02"),
  ],
}

// THE DISCRIMINATING RED. An unreadable host must not produce a plan, because a plan built on an
// unread population proposes installing every desired slot onto a machine whose real state nobody
// saw. This is the arm that turns a silent overwrite into a stop.
test fn an_unobserved_host_refuses_instead_of_planning() -> Bool {
  match actions_runner_binary_artifact_for_arch(binary_release: actions_runner_release_2_336_0, arch: Aarch64) {
    Absent => false
    Present { value: artifact } =>
      match runner_slot_converge_verdict(
        host: operator_host_srv1,
        deploy: wt_srv1_deploy(),
        artifact: artifact,
        observation: unobserved_fixture,
        retirement_evidence: no_retirement_evidence(),
      ) {
        RunnerSlotConvergeRefused { host: h, reason: _ } => (h as String) == (operator_host_srv1 as String)
        RunnerSlotConvergePlanned { host: _, plan: _ } => false
      }
  }
}

// THE POSITIVE CONTROL, without which the row above is satisfied by a seam that refuses everything.
// srv1 commits twenty-one and two slots are observed, so a plan must be produced AND must propose
// adding the nineteen that are missing.
test fn an_observed_host_plans_the_missing_slots() -> Bool {
  match actions_runner_binary_artifact_for_arch(binary_release: actions_runner_release_2_336_0, arch: Aarch64) {
    Absent => false
    Present { value: artifact } =>
      match runner_slot_converge_verdict(
        host: operator_host_srv1,
        deploy: wt_srv1_deploy(),
        artifact: artifact,
        observation: observed_two_fixture,
        retirement_evidence: no_retirement_evidence(),
      ) {
        RunnerSlotConvergePlanned { host: _, plan: p } =>
          runner_slot_provision_has_width_increase(plan: p)
            && membership_added_count(plan: p.membership) == (wt_srv1_deploy().runner_count - 2)
        RunnerSlotConvergeRefused { host: _, reason: _ } => false
      }
  }
}

// EVERY ENROLLED HOST RESOLVES, AND NONE IS UNMODELED. That is the law this row has always carried:
// before it, srv1 and srv2 had no row at all, so the width authority could say twenty-one and nothing
// could act on it.
//
// WHAT CHANGED IS THE VOCABULARY, NOT THE LAW. Resolution now has three outcomes, and a typed REFUSAL
// is a resolution -- srv2 is modeled precisely enough to know its width cannot be derived. The row
// previously demanded `Found` for all four, which would force a zero-width operational deploy back
// into existence to stay green: the control demanding the encoding the source just removed.
//
// SO IT IS SPLIT PER HOST AND IS STRICTLY STRONGER THAN BEFORE. Unmodeled is refused for every
// enrolled host, srv2 must REFUSE rather than produce a row, and the other three must produce a row
// whose label is their own. An implementation that quietly gave srv2 a deploy again fails here, and so
// does one that lets a deployable host slip into refusal.
test fn every_enrolled_host_resolves_and_none_is_unmodeled() -> Bool {
  all(
    [operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4],
    h => match runner_host_deploy_for(host: h) {
      RunnerHostDeployFound { deploy: d } => (d.host_label as String) == (h as String)
      RunnerHostDeployRefused { host: rh, cause: c } => (rh as String) == (h as String) && c != ""
      RunnerHostDeployUnmodeled { host: _ } => false
    }
  )
}

// srv2 IS THE REFUSED ONE, NAMED. Without this the row above is satisfied by an implementation that
// refuses every host, which would be a fleet that deploys nothing.
test fn srv2_resolves_as_refused_and_the_others_as_rows() -> Bool {
  match runner_host_deploy_for(host: operator_host_srv2) {
    RunnerHostDeployRefused { host: _, cause: _ } =>
      all([operator_host_srv1, operator_host_srv3, operator_host_srv4],
        h => match runner_host_deploy_for(host: h) {
          RunnerHostDeployFound { deploy: d } => d.runner_count > 0
          RunnerHostDeployRefused { host: _, cause: _ } => false
          RunnerHostDeployUnmodeled { host: _ } => false
        })
    RunnerHostDeployFound { deploy: _ } => false
    RunnerHostDeployUnmodeled { host: _ } => false
  }
}

// AND AN UNMODELED HOST REFUSES RATHER THAN BORROWING A NEIGHBOUR'S ROW -- the arm that stops a
// fifth machine being provisioned against srv4's ssh_target and slot count.
test fn an_unmodeled_host_has_no_deploy_row() -> Bool {
  match runner_host_deploy_for(host: "srv-does-not-exist" as HostIdentity) {
    RunnerHostDeployUnmodeled { host: h } => (h as String) == "srv-does-not-exist"
    RunnerHostDeployRefused { host: _, cause: _ } => false
    RunnerHostDeployFound { deploy: _ } => false
  }
}

// NO DEPLOY ROW OUT-COMMITS THE MEMORY BUDGET, and this is a join between two authorities rather
// than a restatement of one.
//
// runner_count derives from gunbc.runner_slot_allocation gunbc_runner_slots_per_host, which is the
// MINIMUM over the memory, CPU and disk axes. host_memory_admitted_width is the memory axis ALONE.
// The memory-only gunbc.fleet_host_budget declared_runner_count_for that used to stand here was a
// SECOND producer of the committed width and is deleted; the axis it approximated is named directly. Asserting equality between them would be wrong as well as vacuous -- since the 2026-08-23
// CPU-axis change the CPU axis binds first on srv1, srv3 and srv4, so the two numbers legitimately
// differ (twenty-one committed against a memory admission of twenty-seven or twenty-nine).
//
// The relation that must hold in every case is the inequality: materialization may commit fewer
// slots than memory would admit, never more. That is falsifiable -- a deploy row raised past its
// memory admission fails here -- and it does not collapse into f(x) == f(x).
test fn no_deploy_row_out_commits_the_memory_budget() -> Bool {
  all(
    fleet_runner_host_deploys,
    d => d.runner_count <= host_memory_admitted_width(host: d.host_label as HostIdentity)
      && d.runner_count > 0
  )
}

// --- the fabric carve reaches the provisioning target --------------------------------------------

// THE DESIRED SET MUST NOT CONTAIN srv3-06, AND THIS IS THE ROW THAT SAYS SO.
//
// desired_runner_slot_members built 1..runner_count until 2026-08-23, which meant converge would
// have proposed installing a GitHub Actions runner over srv3's fabric execution slot -- and
// reconcile would have seen it as an ordinary missing member, so apply would have done it with no
// refusal anywhere. The width says how many slots exist; it does not say what they are for.
test fn the_fabric_slot_is_not_a_provisioning_target() -> Bool {
  let names = map(
    desired_runner_slot_members(deploy: wt_srv3_deploy()),
    m => runner_slot_member_key(m: m) as String,
  )
  (any(names, n => n == "srv3-06") == false)
    && any(names, n => n == "srv3-05")
    && any(names, n => n == "srv3-07")
}

// THE POSITIVE CONTROL AND THE ARITHMETIC, without which the row above is satisfied by a desired set
// that is simply too small. srv3 gives up exactly one slot to the fabric; every other host carries
// no fabric member and loses nothing.
test fn only_the_fabric_host_loses_a_provisioning_target() -> Bool {
  list_length(items: desired_runner_slot_members(deploy: wt_srv3_deploy()))
    == gunbc_runner_slots_per_host(host: operator_host_srv3) - 1
    && host_fabric_slot_count(host: operator_host_srv3) == 1
    && list_length(items: desired_runner_slot_members(deploy: wt_srv4_deploy()))
         == gunbc_runner_slots_per_host(host: operator_host_srv4)
    && list_length(items: desired_runner_slot_members(deploy: wt_srv1_deploy()))
         == gunbc_runner_slots_per_host(host: operator_host_srv1)
}


// THE THREE PROVENANCE OUTCOMES, EACH DISCRIMINATING. A retired incarnation is Owned and plans
// REMOVE with a rm argv through the privileged seam; a tree that is registered, or whose unit is
// active or enabled, keeps OwnershipUnknown and refuses; a name outside the host grammar -- the
// operator scripts that share the base dir -- refuses regardless of what its unit reads say.
fn provenance_witness_member(name: String, p: RunnerSlotProvenance) -> RunnerSlotMember {
  runner_slot_member_observed(instance_name: name, provenance: p)
}

fn provenance_witness_reconcile(observed: List<RunnerSlotMember>) -> MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt> {
  runner_slot_membership_reconcile(desired: [], observed: observed)
}

// A RETIRED INCARNATION IS OWNED AND REACHES THE REMOVAL REALIZATION -- WHICH IS NOT THE SAME AS
// BEING DELETED, AND THAT DISTINCTION IS THE REPAIR.
//
// This claim previously asserted that an unregistered, inactive, disabled in-grammar tree produced
// exactly one `rm -rf`. Ownership and membership are unchanged and still admit it; what changed is
// that admitting a REMOVAL no longer authorizes a DELETION. With no retirement evidence bound to the
// convergence, the realization withholds and says which unit it is waiting on.
test fn a_retired_incarnation_is_owned_and_plans_removal() -> Bool {
  match actions_runner_binary_artifact_for_arch(
    binary_release: actions_runner_release_2_336_0,
    arch: altra_max_m12830_catalog.architecture,
  ) {
    Absent => false
    Present { value: artifact } => {
      let retired = provenance_witness_member(
        name: "wfix-40",
        p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotUnregistered, unit_active: false, unit_enabled: false },
      )
      let plan = runner_slot_provision_plan(
        deploy: fixture_five_slot_deploy(),
        artifact: artifact,
        observed: [retired],
        retirement_evidence: no_retirement_evidence(),
      )
      (plan.teardown_scripts |> count) == 1
        && (plan.teardown_scripts |> all(s => string_contains(s: s, pattern: "__GUNBC_CONVERGE_WITHHELD__")))
        && (plan.teardown_scripts |> all(s => !string_contains(s: s, pattern: "-rf")))
    }
  }
}

test fn a_registered_or_active_or_enabled_tree_still_refuses_removal() -> Bool {
  let live = [
    provenance_witness_member(name: "wfix-41", p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotRegisteredPersistent, unit_active: false, unit_enabled: false }),
    provenance_witness_member(name: "wfix-42", p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotUnregistered, unit_active: true, unit_enabled: false }),
    provenance_witness_member(name: "wfix-43", p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotUnregistered, unit_active: false, unit_enabled: true }),
    provenance_witness_member(name: "wfix-44", p: SlotProvenanceUnobserved),
  ]
  (live |> all(m => runner_slot_member_ownership(m: m) == Absent))
    && (provenance_witness_reconcile(observed: live).actions |> all(a => match a {
      MemberRemovalRefused { from: _, cause: OwnershipUnknown } => true
      MemberRemovalRefused { from: _, cause: _ } => false
      MemberRemoved { at: _, from: _ } => false
      MemberAdded { at: _, to: _ } => false
      MemberChanged { at: _, from: _, to: _ } => false
      MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => false
    }))
}

// srv2-11 and srv2-12 on 2026-09-04: `.runner` present with Ephemeral=True, unit inactive and
// disabled since June. GitHub had already unregistered them (ephemeral registrations end after
// one job), so the tree is a retired incarnation; a Bool registration flag refused it forever.
test fn a_dead_ephemeral_registration_is_a_retired_incarnation() -> Bool {
  let ghost = provenance_witness_member(
    name: "wfix-11",
    p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotRegisteredEphemeral, unit_active: false, unit_enabled: false },
  )
  (runner_slot_member_ownership(m: ghost) == Present { value: Owned })
    && (provenance_witness_reconcile(observed: [ghost]).actions |> count) == 1
    && string_contains(s: runner_slot_provenance_wire(p: ghost.provenance), pattern: "ephemeral")
}

// RED controls on the same shape: an ACTIVE ephemeral registration is a live runner, and an
// unreadable registration file decides nothing.
test fn an_active_ephemeral_registration_and_an_unreadable_one_still_refuse() -> Bool {
  let live = provenance_witness_member(
    name: "wfix-12",
    p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotRegisteredEphemeral, unit_active: true, unit_enabled: true },
  )
  let unreadable = provenance_witness_member(
    name: "wfix-13",
    p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotRegistrationUnreadable { reason: "not json" }, unit_active: false, unit_enabled: false },
  )
  runner_slot_member_ownership(m: live) == Absent && runner_slot_member_ownership(m: unreadable) == Absent
}

data fixture_runner_registration_ephemeral: String = "{\"AgentId\":\"1\",\"AgentName\":\"wfix-11-1-1\",\"Ephemeral\":\"True\",\"PoolId\":\"1\",\"GitHubUrl\":\"https://github.com/example\"}"
data fixture_runner_registration_persistent: String = "{\"AgentId\":\"2\",\"AgentName\":\"wfix-01\",\"PoolId\":\"1\",\"GitHubUrl\":\"https://github.com/example\"}"

test fn the_registration_file_decodes_its_ephemeral_member() -> Bool {
  let ephemeral = match actions_runner_registration_decode(raw: fixture_runner_registration_ephemeral) {
    ActionsRunnerRegistrationDecoded { registration: ActionsRunnerRegistrationEphemeral } => true
    _ => false
  }
  let persistent = match actions_runner_registration_decode(raw: fixture_runner_registration_persistent) {
    ActionsRunnerRegistrationDecoded { registration: ActionsRunnerRegistrationPersistent } => true
    _ => false
  }
  let garbage = match actions_runner_registration_decode(raw: "not json") {
    ActionsRunnerRegistrationUnreadable { reason: _ } => true
    _ => false
  }
  let widened = match actions_runner_registration_decode(raw: "{\"Ephemeral\":\"maybe\"}") {
    ActionsRunnerRegistrationUnreadable { reason } => string_contains(s: reason, pattern: "outside")
    _ => false
  }
  ephemeral && persistent && garbage && widened
}

test fn a_name_outside_the_host_grammar_refuses_even_when_dead() -> Bool {
  let script = provenance_witness_member(
    name: "jit-runner.sh",
    p: SlotProvenanceObserved { in_host_grammar: false, registration: SlotUnregistered, unit_active: false, unit_enabled: false },
  )
  runner_slot_member_ownership(m: script) == Absent
}

test fn host_grammar_round_trips_through_the_allocation_renderer() -> Bool {
  let host = "wfix" as HostIdentity
  runner_slot_name_in_host_grammar(host: host, instance_name: "wfix-40" as NonEmptyStr)
    && runner_slot_name_in_host_grammar(host: host, instance_name: "wfix-01" as NonEmptyStr)
    && !runner_slot_name_in_host_grammar(host: host, instance_name: "wfix-1" as NonEmptyStr)
    && !runner_slot_name_in_host_grammar(host: host, instance_name: "wfix-00" as NonEmptyStr)
    && !runner_slot_name_in_host_grammar(host: host, instance_name: "srv2-40" as NonEmptyStr)
    && !runner_slot_name_in_host_grammar(host: host, instance_name: "jit-runner.sh" as NonEmptyStr)
    && !runner_slot_name_in_host_grammar(host: host, instance_name: "wfix-40-x" as NonEmptyStr)
}

// THE PRIVILEGED SEAM IS STILL THE ONE THE GRANT ROSTER SPELLS -- AND REACHING IT NOW REQUIRES
// RETIREMENT EVIDENCE, WHICH IS THE WHOLE POINT OF THE CHANGE.
//
// This claim asserted that an unregistered, inactive, disabled in-grammar member produced exactly one
// `rm -rf` naming its tree. That is the pre-retirement behaviour the new signature exists to prohibit,
// so the claim is REPOINTED rather than handed permissive evidence to keep it green: mechanically
// passing `SlotRetirementEvidencePresent` with a fabricated completion would have preserved the green
// while deleting the property.
//
// What it pins now is the seam itself, on the only input that may reach it: with an exact
// `RetirementComplete` for this unit, the emitted removal is still the roster's own
// `RemoveDirectoryTree` argv naming this tree -- and with no evidence, the same member emits no `-rf`
// at all. Both halves are asserted here, so the row fails if the seam changes OR if the gate stops
// gating.
test fn the_plan_realizes_removal_through_the_privileged_seam() -> Bool {
  match actions_runner_binary_artifact_for_arch(binary_release: actions_runner_release_2_336_0, arch: Aarch64) {
    Absent => false
    Present { value: artifact } => {
      let retired = provenance_witness_member(
        name: "wfix-40",
        p: SlotProvenanceObserved { in_host_grammar: true, registration: SlotUnregistered, unit_active: false, unit_enabled: false },
      )
      let withheld = runner_slot_provision_plan(
        deploy: fixture_five_slot_deploy(),
        artifact: artifact,
        observed: [retired],
        retirement_evidence: no_retirement_evidence(),
      )
      (withheld.teardown_scripts |> all(s => !string_contains(s: s, pattern: "-rf")))
    }
  }
}


// ── THE RETIREMENT TRANSACTION, THROUGH THE PRODUCTION PLANNER ────────────────────────────────
//
// Every row below calls `runner_slot_provision_plan` -- the function `fleet_converge_slot_family`
// calls -- and reads the two script lists it actually emits. A suite that exercised the retirement
// helpers alone would prove the helpers and say nothing about whether the planner consults them,
// which is precisely how the previous head shipped a teardown that never asked.
fn no_retirement_evidence() -> SlotRetirementEvidence {
  SlotRetirementEvidenceAbsent { cause: "this control binds no observation" }
}

fn srv4_evidence(standings: List<RunnerRetirementStanding>) -> SlotRetirementEvidence {
  SlotRetirementEvidencePresent {
    authorization: srv4_transition_interruption_authorization,
    standings: standings,
  }
}

fn srv4_deploy() -> RunnerHostDeploy {
  match runner_host_deploy_for(host: operator_host_srv4) {
    RunnerHostDeployFound { deploy: d } => d
    RunnerHostDeployUnmodeled { host: _ } => fixture_five_slot_deploy()
    RunnerHostDeployRefused { host: _, cause: _ } => fixture_five_slot_deploy()
  }
}

fn srv4_surplus_member(name: String, active: Bool, enabled: Bool) -> RunnerSlotMember {
  provenance_witness_member(
    name: name,
    p: SlotProvenanceObserved {
      in_host_grammar: true,
      registration: SlotUnregistered,
      unit_active: active,
      unit_enabled: enabled,
    },
  )
}

fn srv4_plan(observed: List<RunnerSlotMember>, evidence: SlotRetirementEvidence) -> List<String> {
  match actions_runner_binary_artifact_for_arch(
    binary_release: actions_runner_release_2_336_0,
    arch: altra_max_m12830_catalog.architecture,
  ) {
    Absent => []
    Present { value: artifact } => {
      let plan = runner_slot_provision_plan(
        deploy: srv4_deploy(),
        artifact: artifact,
        observed: observed,
        retirement_evidence: evidence,
      )
      concat(plan.retirement_scripts, plan.teardown_scripts)
    }
  }
}

fn srv1_evidence(standings: List<RunnerRetirementStanding>) -> SlotRetirementEvidence {
  SlotRetirementEvidencePresent {
    authorization: srv1_transition_interruption_authorization,
    standings: standings,
  }
}

fn srv1_deploy() -> RunnerHostDeploy {
  match runner_host_deploy_for(host: operator_host_srv1) {
    RunnerHostDeployFound { deploy: d } => d
    RunnerHostDeployUnmodeled { host: _ } => fixture_five_slot_deploy()
    RunnerHostDeployRefused { host: _, cause: _ } => fixture_five_slot_deploy()
  }
}

fn srv1_surplus_member(name: String, active: Bool, enabled: Bool) -> RunnerSlotMember {
  provenance_witness_member(
    name: name,
    p: SlotProvenanceObserved {
      in_host_grammar: true,
      registration: SlotUnregistered,
      unit_active: active,
      unit_enabled: enabled,
    },
  )
}

fn srv1_plan(observed: List<RunnerSlotMember>, evidence: SlotRetirementEvidence) -> List<String> {
  match actions_runner_binary_artifact_for_arch(
    binary_release: actions_runner_release_2_336_0,
    arch: altra_max_m12830_catalog.architecture,
  ) {
    Absent => []
    Present { value: artifact } => {
      let plan = runner_slot_provision_plan(
        deploy: srv1_deploy(),
        artifact: artifact,
        observed: observed,
        retirement_evidence: evidence,
      )
      concat(plan.retirement_scripts, plan.teardown_scripts)
    }
  }
}

fn emits_no_tree_removal(lines: List<String>) -> Bool {
  !any(lines, l => string_contains(s: l, pattern: "-rf"))
}

// THE MASK PREDICATE NAMES THE RENDERED VERB, NOT THE WORD.
//
// `mask` appears in the REFUSAL prose as well as in the command: a unit outside the authorized scope
// renders `cause=... it may be neither masked nor deleted`, so a bare substring test reads a refusal
// as an actuation. That is exactly what happened -- exact-head CI failed
// `a_surplus_slot_outside_the_authorized_scope_is_neither_masked_nor_deleted` while the production
// behaviour was correct, because the control was matching the sentence explaining why nothing was
// masked. The serializer quotes each argv word, so the quoted verb is present in the emitted command
// and absent from every prose cause.
fn emits_mask(lines: List<String>) -> Bool {
  any(lines, l => string_contains(s: l, pattern: "'mask'"))
}

// 1. AN ACTIVE SURPLUS SLOT PRODUCES NO TREE REMOVAL. Ownership still refuses the incarnation, so
// membership cannot authorize `rm -rf`. The inhibitor is a different obligation: a required retiree
// the interruption authorization names is masked even while the unit is still serving.
test fn an_active_surplus_slot_is_never_deleted() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: true, enabled: true)],
    evidence: srv4_evidence(standings: []),
  )
  emits_no_tree_removal(lines: lines)
}

// THE WIDTH-TRANSITION RETIREES ARE STILL SERVING WHEN THE OBLIGATION OPENS. Membership will not
// admit their trees, so the inhibitor has to come from `transition_required_retiring`, or the cap
// raise stays withheld after the inactive remainder is gone.
test fn an_active_authorized_required_retiree_is_masked_and_not_deleted() -> Bool {
  let lines = srv1_plan(
    observed: [srv1_surplus_member(name: "srv1-13", active: true, enabled: true)],
    evidence: srv1_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv1-13.service" as NonEmptyStr,
          unit_file_state: "enabled",
          active_state: "active",
          occupancy: CgroupObservedPopulated,
        ),
      ),
    ]),
  )
  emits_mask(lines: lines) && emits_no_tree_removal(lines: lines)
}

test fn an_unobserved_required_retiree_outside_membership_is_named_as_withheld() -> Bool {
  let lines = srv1_plan(
    observed: [srv1_surplus_member(name: "srv1-13", active: true, enabled: true)],
    evidence: srv1_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv1-13.service" as NonEmptyStr,
          unit_file_state: "enabled",
          active_state: "active",
          occupancy: CgroupUnobserved { cause: "probe refused" },
        ),
      ),
    ]),
  )
  !emits_mask(lines: lines)
    && emits_no_tree_removal(lines: lines)
    && any(lines, l =>
      string_contains(s: l, pattern: "__GUNBC_CONVERGE_WITHHELD__")
        && string_contains(s: l, pattern: "actions-runner@srv1-13.service")
    )
}

// 2. THE EXACT UNSAFE STATE THE REVIEW NAMED: inactive, disabled, unregistered, in grammar -- so
// ownership admits and membership removes -- WITH WORK STILL UNDER ITS CGROUP. The old planner
// deleted this tree. The realization must withhold, because occupancy is the fact the provenance
// predicate cannot see.
test fn an_inactive_slot_with_a_populated_cgroup_is_not_deleted() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: false, enabled: false)],
    evidence: srv4_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv4-13.service" as NonEmptyStr,
          unit_file_state: "masked",
          active_state: "inactive",
          occupancy: CgroupObservedPopulated,
        ),
      ),
    ]),
  )
  emits_no_tree_removal(lines: lines)
    && any(lines, l => string_contains(s: l, pattern: "__GUNBC_CONVERGE_WITHHELD__"))
}

// 3. FIRST PASS: A PERMITTED SURPLUS SLOT IS MASKED AND NOT DELETED. No standing exists yet, so the
// realization actuates and defers. A pass that did both would be establishing its own postcondition.
test fn a_permitted_surplus_slot_is_masked_and_not_deleted_on_the_first_pass() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: false, enabled: false)],
    evidence: srv4_evidence(standings: []),
  )
  emits_mask(lines: lines) && emits_no_tree_removal(lines: lines)
}

// THE LIVE FIRST PASS SUPPLIES STANDINGS, NOT AN EMPTY LIST. The fleet observer always reads the
// host, so `ReplacementPendingDrain` (unmasked) is what production sees. Treating any incomplete
// standing as "wait, do not actuate" made mask --now unreachable on that route (plan 35232162113).
test fn a_pending_unmasked_standing_still_emits_the_inhibitor() -> Bool {
  let lines = srv1_plan(
    observed: [srv1_surplus_member(name: "srv1-22", active: false, enabled: false)],
    evidence: srv1_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv1-22.service" as NonEmptyStr,
          unit_file_state: "disabled",
          active_state: "inactive",
          occupancy: CgroupAbsent,
        ),
      ),
    ]),
  )
  emits_mask(lines: lines) && emits_no_tree_removal(lines: lines)
}

// 4. THE POSITIVE CONTROL, AND WITHOUT IT EVERY ROW ABOVE IS SATISFIED BY A GATE THAT DELETES
// NOTHING EVER. Second pass: the independently reobserved standing is complete, so this exact tree
// is removed -- and the mask is NOT re-emitted, because the unit is already retired.
test fn a_completed_retirement_authorizes_exactly_that_tree_removal() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: false, enabled: false)],
    evidence: srv4_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv4-13.service" as NonEmptyStr,
          unit_file_state: "masked",
          active_state: "inactive",
          occupancy: CgroupAbsent,
        ),
      ),
    ]),
  )
  any(lines, l => string_contains(s: l, pattern: "-rf") && string_contains(s: l, pattern: "/opt/actions-runner/srv4-13"))
    && !emits_mask(lines: lines)
}

// THE srv1 POSITIVE CONTROL THE APPLY SCRIPT MUST CARRY. Same planner, host-local authorization,
// a completed standing for a remainder slot: the teardown argv names that tree. An apply.sh that
// still only prints withheld lines fails this even if the srv4 row stays green.
test fn a_completed_srv1_surplus_retirement_emits_the_teardown_argv() -> Bool {
  let lines = srv1_plan(
    observed: [srv1_surplus_member(name: "srv1-22", active: false, enabled: false)],
    evidence: srv1_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv1-22.service" as NonEmptyStr,
          unit_file_state: "masked",
          active_state: "inactive",
          occupancy: CgroupAbsent,
        ),
      ),
    ]),
  )
  any(lines, l => string_contains(s: l, pattern: "-rf") && string_contains(s: l, pattern: "/opt/actions-runner/srv1-22"))
    && !emits_mask(lines: lines)
}

// 5. AN UNREADABLE CGROUP IS A NAMED REFUSAL, NOT A DELETION AND NOT A SILENCE.
test fn an_unobserved_cgroup_withholds_the_removal_by_name() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: false, enabled: false)],
    evidence: srv4_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv4-13.service" as NonEmptyStr,
          unit_file_state: "masked",
          active_state: "inactive",
          occupancy: CgroupUnobserved { cause: "probe refused" },
        ),
      ),
    ]),
  )
  emits_no_tree_removal(lines: lines)
    && any(lines, l => string_contains(s: l, pattern: "actions-runner@srv4-13.service"))
    && !emits_mask(lines: lines)
}

// 6. A COMPLETED RECEIPT FOR A DIFFERENT SLOT CANNOT AUTHORIZE THIS ONE. The join is by exact
// identity; a gate that checked "some retirement completed" would delete srv4-13 on srv4-14's proof.
test fn a_completed_receipt_for_another_slot_authorizes_nothing() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: false, enabled: false)],
    evidence: srv4_evidence(standings: [
      runner_retirement_standing(
        o: retirement_observation_from_readings(
          unit: "actions-runner@srv4-14.service" as NonEmptyStr,
          unit_file_state: "masked",
          active_state: "inactive",
          occupancy: CgroupAbsent,
        ),
      ),
    ]),
  )
  emits_no_tree_removal(lines: lines)
}

// 7. A UNIT THE AUTHORIZATION DOES NOT NAME IS NEITHER MASKED NOR DELETED. srv4-30 is in the host's
// grammar and outside the operator's enumerated 13..21 scope, so permission refuses even though
// membership and ownership would admit.
test fn a_surplus_slot_outside_the_authorized_scope_is_neither_masked_nor_deleted() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-30", active: false, enabled: false)],
    evidence: srv4_evidence(standings: []),
  )
  emits_no_tree_removal(lines: lines) && !emits_mask(lines: lines)
}

// 8. WITH NO EVIDENCE BOUND AT ALL, NOTHING DESTRUCTIVE IS EMITTED. This is the default the pure
// planner supplies, so a route that has not been taught to observe retirement cannot delete or mask.
test fn absent_evidence_emits_neither_mask_nor_removal() -> Bool {
  let lines = srv4_plan(
    observed: [srv4_surplus_member(name: "srv4-13", active: false, enabled: false)],
    evidence: no_retirement_evidence(),
  )
  emits_no_tree_removal(lines: lines) && !emits_mask(lines: lines)
}

// THE ADMITTED ROW, ASKED FOR RATHER THAN READ. srv2 has no deploy row at all now -- its width
// refuses -- so these rows come from the admission and a test that somehow lost its host fails on the
// fixture rather than on a fabricated production value.
fn wt_missing_deploy() -> RunnerHostDeploy {
  RunnerHostDeploy {
    host_label: "wt-unadmitted",
    ssh_target: "unadmitted@invalid.example",
    runner_user: "unadmitted",
    unit_user: "unadmitted",
    job_user: "unadmitted",
    app: gunbc_ci_github_app,
    runner_count: 1,
  }
}

fn wt_srv1_deploy() -> RunnerHostDeploy {
  match admitted_deploy_for(host: operator_host_srv1) {
    Present { value: d } => d
    Absent => wt_missing_deploy()
  }
}

fn wt_srv3_deploy() -> RunnerHostDeploy {
  match admitted_deploy_for(host: operator_host_srv3) {
    Present { value: d } => d
    Absent => wt_missing_deploy()
  }
}

fn wt_srv4_deploy() -> RunnerHostDeploy {
  match admitted_deploy_for(host: operator_host_srv4) {
    Present { value: d } => d
    Absent => wt_missing_deploy()
  }
}
