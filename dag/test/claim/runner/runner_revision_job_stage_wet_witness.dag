module test.claim.runner.runner_revision_job_stage_wet_witness

import extdeps.shell
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.algebra { FreeSemigroup, trim }
import std.measure { ByteSize, byte_size }
import extdeps.exec.command { ArgvCommand, LocalExec }
import extdeps.shell.exec { ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.mkdir { mkdir_parents_command }
import extdeps.git {
  git_init_quiet_command, git_add_all_force_command, git_commit_snapshot_command, git_rev_parse_head_command,
  git_rev_parse_tree_command,
}
import extdeps.git.object_store { git_sha1_object_id }
import extdeps.rust.cargo_build { cargo_vendor_command, cargo_vendor_command_from }
import gunbc.command_runner { process_outcome_admitted }
import gunbc.command_runner { run_shell_command_capture }
import gunbc.instrument_targets { self_host_label }
import gunbc.runner.runner_revision_job_stage {
  RevisionJobStage, RevisionJobStageReady, RevisionJobStageRefused, StageTreeMismatch, StageToolchainMismatch,
  stage_revision_job,
}

// THE HOST STAGING, RUN FOR REAL OVER A LOCAL FIXTURE REPOSITORY. The "remote" is a directory, so
// the fetch needs no network; the fixture crate has no dependencies, so `cargo vendor` produces an
// empty vendor set offline. What runs is exactly the production staging: fetch the commit by id,
// read its tree back and verify it, read rust-toolchain.toml and Cargo.lock from the commit, vendor,
// archive reproducibly, digest, and write the spec and the zeroed results drive.

fn out(c: ArgvCommand) -> String {
  match run_shell_command_capture(command: c, transport: LocalExec) {
    ProcessOutputPresent { text: t } => trim(s: t)
    ProcessOutputAbsent => ""
    ProcessRefused { exit_code: _, stderr: _ } => ""
  }
}

fn fixture_repo(root: String, toolchain: String) -> Bool {
  let src = concat(root, "/origin")
  out(c: mkdir_parents_command(path: concat(src, "/src"))) == ""
    && Filesystem.Write(path: concat(src, "/Cargo.toml"), content: "[package]\nname = \"fixture\"\nversion = \"0.1.0\"\nedition = \"2021\"\n").success
    && Filesystem.Write(path: concat(src, "/Cargo.lock"), content: "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"fixture\"\nversion = \"0.1.0\"\n").success
    && Filesystem.Write(path: concat(src, "/src/lib.rs"), content: "pub fn f() {}\n").success
    && Filesystem.Write(path: concat(src, "/rust-toolchain.toml"), content: concat(concat("[toolchain]\nchannel = \"", toolchain), "\"\n")).success
    && out(c: git_init_quiet_command(repository_dir: src)) == ""
    && out(c: git_add_all_force_command(repository_dir: src)) == ""
    && out(c: git_commit_snapshot_command(repository_dir: src, identity_name: "w", identity_email: "w@w.invalid", message: "fixture")) == ""
}

fn stage(root: String, tree_hex: String, image_toolchain: NonEmptyStr, run: String) -> RevisionJobStage {
  let origin = concat(root, "/origin")
  let commit_hex = out(c: git_rev_parse_head_command(repository_dir: origin))
  match git_sha1_object_id(hex: commit_hex) {
    Absent => RevisionJobStageRefused { refusal: StageTreeMismatch { commit: "none", admitted_tree: "none", observed_tree: "" } }
    Present { value: commit } => match git_sha1_object_id(hex: tree_hex) {
      Absent => RevisionJobStageRefused { refusal: StageTreeMismatch { commit: "none", admitted_tree: "none", observed_tree: "" } }
      Present { value: tree } => stage_revision_job(
        cache_repo: concat(root, "/cache"), vendor_cache: concat(root, "/vendor-cache"), staging_dir: concat(root, run),
        repository_url: origin, commit: commit, admitted_tree: tree, image_toolchain: image_toolchain,
        claims: FreeSemigroup { head: self_host_label(), tail: [] }, results_device: "/dev/vde", results_bytes: byte_size(count: 4096),
      )
    }
  }
}

test fn an_admitted_revision_stages_with_its_digests_by_real_execution() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_stage.XXXXXX").path
  let made = fixture_repo(root: root, toolchain: "1.83.0")
  let tree = out(c: git_rev_parse_tree_command(repository_dir: concat(root, "/origin"), revision: "HEAD"))
  let ok = match stage(root: root, tree_hex: tree, image_toolchain: "1.83.0", run: "/run1") {
    RevisionJobStageReady { staged: s } =>
      (s.digests.tree as String) == tree && length(s.digests.vendor_set as String) == 64
        && Filesystem.Read(path: s.spec).content.starts_with("GUNBC_CLAIM_SET_COMMIT=")
    RevisionJobStageRefused { refusal: _ } => false
  }
  let removed = shell.Remove.RecursiveForce(path: root)
  made && ok && removed.success
}

test fn another_tree_or_another_toolchain_refuses_before_staging_by_real_execution() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_stage.XXXXXX").path
  let made = fixture_repo(root: root, toolchain: "1.83.0")
  let tree = out(c: git_rev_parse_tree_command(repository_dir: concat(root, "/origin"), revision: "HEAD"))
  let wrong_tree = match stage(root: root, tree_hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", image_toolchain: "1.83.0", run: "/run1") {
    RevisionJobStageRefused { refusal: StageTreeMismatch { commit: _, admitted_tree: _, observed_tree: o } } => o == tree
    _ => false
  }
  let wrong_toolchain = match stage(root: root, tree_hex: tree, image_toolchain: "1.82.0", run: "/run2") {
    RevisionJobStageRefused { refusal: StageToolchainMismatch { tree_toolchain: t, image_toolchain: _ } } => t == "1.83.0"
    _ => false
  }
  let removed = shell.Remove.RecursiveForce(path: root)
  made && wrong_tree && wrong_toolchain && removed.success
}

// THE VENDOR STEP DOES NOT READ THE UNTRUSTED TREE'S CARGO CONFIGURATION. Cargo parses every config file
// it discovers at startup, so an unparseable .cargo/config.toml in the tree is the exact "was it read"
// detector (it needs no dependency and no network; a source replacement would never be consulted by a
// dependency-free tree). The production command (working directory `/`, fresh CARGO_HOME) must still
// vendor; the CONTROL, the same argv with the tree as working directory, must refuse, or the fixture
// does not discriminate.
fn hostile_vendor_tree(base: String) -> Bool {
  let tree = concat(base, "/tree")
  out(c: mkdir_parents_command(path: concat(tree, "/src"))) == ""
    && out(c: mkdir_parents_command(path: concat(tree, "/.cargo"))) == ""
    && Filesystem.Write(path: concat(tree, "/Cargo.toml"), content: "[package]\nname = \"fixture\"\nversion = \"0.1.0\"\nedition = \"2021\"\n").success
    && Filesystem.Write(path: concat(tree, "/Cargo.lock"), content: "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"fixture\"\nversion = \"0.1.0\"\n").success
    && Filesystem.Write(path: concat(tree, "/src/lib.rs"), content: "pub fn f() {}\n").success
    && Filesystem.Write(path: concat(tree, "/.cargo/config.toml"), content: "this is not toml [[[\n").success
}

fn vendor_base() -> String {
  match shell.Env.Get(name: "TMPDIR").value { Present { value: v } => concat(v, "/rj-vendor-hostile") Absent => "/tmp/rj-vendor-hostile" }
}

test fn the_vendor_step_ignores_the_trees_cargo_configuration_by_real_execution() -> Bool {
  let base = vendor_base()
  hostile_vendor_tree(base: base)
    && process_outcome_admitted(outcome: run_shell_command_capture(
      command: cargo_vendor_command(manifest_path: concat(base, "/tree/Cargo.toml"), output_dir: concat(base, "/vendor"), cargo_home: concat(base, "/cargo-home")),
      transport: LocalExec))
}

test fn the_same_vendor_argv_run_from_the_tree_refuses_on_its_configuration() -> Bool {
  let base = concat(vendor_base(), "-control")
  hostile_vendor_tree(base: base)
    && !process_outcome_admitted(outcome: run_shell_command_capture(
      command: cargo_vendor_command_from(directory: concat(base, "/tree"), manifest_path: concat(base, "/tree/Cargo.toml"), output_dir: concat(base, "/vendor"), cargo_home: concat(base, "/cargo-home")),
      transport: LocalExec))
}
