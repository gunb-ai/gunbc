module test.claim.runner.runner_jit_listed_registration_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestTransportRefused }
import extdeps.github.actions_self_hosted_runners { OrganizationRunnerListWire, OrganizationRunnerWire }
import extdeps.github.app { GitHubAppInstallationId }
import extdeps.github.effect { GitHubOrganizationRef }
import product.host_identity { HostIdentity }
import gunbc.auth.github_apps { gunbai_ci_declared }
import gunbc.auth.github_credential { GitHubCredentialAuthority, ManagedAppInstallationCredential, GitHubCredentialProfileRef }
import gunbc.ci.ci_fleet { fleet_compute_offer_for }
import gunbc.host.managed_host { ManagedHost, managed_hosts, managed_host_binding }
import gunbc.host.host_control_route { HostControlStanding, bmc_controlled_host }
import gunbc.machine_intake.host_capture_envelope { HostCaptureRunIdentity, KernelBootId, HistoricalAttemptOrdinal }
import gunbc.runner.runner_slot_allocation { RunnerWidthDerived, RunnerWidthUnresolved, WidthComputeOfferAbsent, gunbc_runner_committed_width }
import gunbc.runner.runner_registration_labels { RunnerRegistrationLabelsResolution, RegistrationLabelsResolved, RegistrationLabelsRefused, runner_registration_labels }
import gunbc.runner.runner_throughput_qualification_route { ephemeral_slot_unit, ephemeral_slot_labels }
import gunbc.runner.runner_host_unit_slot {
  AttemptSlot, ServiceSlot, HostUnitSlotBound, HostUnitSlotRefused, HostUnitSlotRegistrationLabelsRefused,
  ServiceSlotsDerived, ServiceSlotsWidthUnresolved, host_unit_slot_for, host_unit_slot_over, service_slot_unit, service_slot_name_parse,
  service_slot_population, service_slot_population_over, service_boot_id_of, service_slot_selected_workflow,
}
import gunbc.runner.runner_jit_deregistration {
  ListedRegistrationAdmitted, ListedRegistrationRefused, ListedNameOutsideServiceGrammar, ListedNameDoesNotRoundTrip,
  ListedSlotRefused, ListedAuthorityNamesNoInstallation,
  LostBootSweepSelected, LostBootSweepRefused, SweepListingUnreadable, SweepRegistrationRefused,
  LostBootSweep, ListedRegistrationStanding, jit_registration_of_listed, lost_boot_sweep,
}
import gunbc.runner.runner_jit_deregistration { JitListingPageIncomplete }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn has_offer(m: ManagedHost) -> Bool {
  match fleet_compute_offer_for(host: m.host) { Present { value: _ } => true Absent => false }
}

// THE ONE MANAGED HOST. Its fleet compute offer is not in the catalog today, so its own registration
// labels refuse; the success path is witnessed by SUPPLYING a resolved label set, and the real
// producer's answer for the host is the inhabitance claim below.
fn the_host() -> ManagedHost? { first(managed_hosts()) }

fn controlled(m: ManagedHost) -> HostControlStanding { bmc_controlled_host(standing: managed_host_binding(host: m)) }

data supplied_labels: RunnerRegistrationLabelsResolution = RegistrationLabelsResolved { labels: ["self-hosted", "linux", "ARM64", "gunbc-heavy", "gunbc-host-x"] }

data org: GitHubOrganizationRef = GitHubOrganizationRef { login: "gunb-ai" }
data installation: GitHubAppInstallationId = GitHubAppInstallationId { value: 4242 }
data authority: GitHubCredentialAuthority = ManagedAppInstallationCredential {
  app: gunbai_ci_declared, installation: installation, profile: GitHubCredentialProfileRef { name: "fleet-converge" },
}

fn boot(id: String) -> NonEmptyStr { id as NonEmptyStr }

fn unit(m: ManagedHost, id: String, index: Int) -> String { service_slot_unit(host: m.host, boot_id: boot(id: id), index: index) as String }

fn listing(names: List<String>, total: Int) -> RestResult<OrganizationRunnerListWire> {
  RestAnswered { answer: OrganizationRunnerListWire {
    total_count: total,
    runners: names |> map(n => OrganizationRunnerWire { id: 1, name: n }),
  } }
}

fn sweep(m: ManagedHost, current: String, names: List<String>, total: Int) -> LostBootSweep {
  lost_boot_sweep(organization: org, host: controlled(m: m), host_identity: m.host, current: boot(id: current), authority: authority,
    registration_labels: supplied_labels, listing: listing(names: names, total: total))
}

// THE QUALIFICATION PATH IS ONE ARM OF THE SAME FOLD: an attempt slot's unit and labels are still the
// route's own derivations, so generalizing the fold did not fork or change them.
test fn the_attempt_arm_is_the_qualification_routes_own_spelling() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } =>
      match host_unit_slot_for(host: controlled(m: m), purpose: AttemptSlot { attempt: "q-1" }, workflow: service_slot_selected_workflow()) {
        HostUnitSlotBound { slot: s } =>
          (s.unit as String) == (ephemeral_slot_unit(host: m.host, attempt: "q-1") as String)
            && s.labels == ephemeral_slot_labels(host: m.host, attempt: "q-1")
        HostUnitSlotRefused { refusal: _ } => false
      }
  }
}

// A SERVICE SLOT DIFFERS IN ITS NAME AND ITS LABELS ONLY. Over supplied labels the slot is bound with
// the incarnation-and-index name and those labels. Over the host's OWN labels (the real producer) a
// host with no fleet offer refuses with the labels refusal carried unchanged, while its attempt slot
// still binds -- so the refusal is the labels' and not the host's.
test fn a_service_slot_takes_the_registration_labels_and_an_unoffered_host_refuses() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } =>
      (match host_unit_slot_over(host: controlled(m: m), purpose: ServiceSlot { boot_id: boot(id: "b-1"), index: 3 }, workflow: service_slot_selected_workflow(), registration_labels: supplied_labels) {
        HostUnitSlotBound { slot: s } =>
          (s.unit as String) == unit(m: m, id: "b-1", index: 3) && s.labels == ["self-hosted", "linux", "ARM64", "gunbc-heavy", "gunbc-host-x"]
        HostUnitSlotRefused { refusal: _ } => false
      }) && (has_offer(m: m) || (match host_unit_slot_for(host: controlled(m: m), purpose: ServiceSlot { boot_id: boot(id: "b-1"), index: 0 }, workflow: service_slot_selected_workflow()) {
        HostUnitSlotRefused { refusal: HostUnitSlotRegistrationLabelsRefused { host: h, cause: _ } } => h == m.host
        _ => false
      })) && (match host_unit_slot_for(host: controlled(m: m), purpose: ServiceSlot { boot_id: boot(id: "b-1"), index: 0 }, workflow: service_slot_selected_workflow()) {
        HostUnitSlotBound { slot: _ } => has_offer(m: m)
        HostUnitSlotRefused { refusal: HostUnitSlotRegistrationLabelsRefused { host: _, cause: _ } } => !has_offer(m: m)
        HostUnitSlotRefused { refusal: _ } => false
      }) && (match host_unit_slot_for(host: controlled(m: m), purpose: AttemptSlot { attempt: "q-1" }, workflow: service_slot_selected_workflow()) {
        HostUnitSlotBound { slot: _ } => true
        HostUnitSlotRefused { refusal: _ } => false
      })
  }
}

// N COMES FROM THE WIDTH THE OFFER DERIVES. Supplying a different width changes the population; an
// unresolved width is carried and never read as zero; the real route's population is exactly the
// committed width for the host, or the same unresolved cause.
test fn the_population_follows_the_width() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } => {
      let c = controlled(m: m)
      (match service_slot_population_over(host: c, width: RunnerWidthDerived { slots: 5 }, registration_labels: supplied_labels, boot_id: boot(id: "b-1")) {
        ServiceSlotsDerived { slots: ss } => count(ss) == 5 && all(ss, s => match s { HostUnitSlotBound { slot: _ } => true _ => false })
        _ => false
      }) && (match service_slot_population_over(host: c, width: RunnerWidthDerived { slots: 3 }, registration_labels: supplied_labels, boot_id: boot(id: "b-1")) {
        ServiceSlotsDerived { slots: ss } => count(ss) == 3
        _ => false
      }) && (match service_slot_population_over(host: c, width: RunnerWidthUnresolved { cause: WidthComputeOfferAbsent { host: m.host } }, registration_labels: supplied_labels, boot_id: boot(id: "b-1")) {
        ServiceSlotsWidthUnresolved { cause: _ } => true
        _ => false
      }) && (match service_slot_population(host: c, boot_id: boot(id: "b-1")) {
        ServiceSlotsDerived { slots: ss } =>
          match gunbc_runner_committed_width(host: m.host) {
            RunnerWidthDerived { slots: n } => count(ss) == n
            RunnerWidthUnresolved { cause: _ } => false
          }
        ServiceSlotsWidthUnresolved { cause: _ } =>
          match gunbc_runner_committed_width(host: m.host) {
            RunnerWidthDerived { slots: _ } => false
            RunnerWidthUnresolved { cause: _ } => true
          }
        ServiceSlotsHostNotControlled { refusal: _ } => false
      })
    }
  }
}

fn reg(m: ManagedHost, listed: String) -> ListedRegistrationStanding {
  jit_registration_of_listed(organization: org, host: controlled(m: m), host_identity: m.host, listed: listed, authority: authority, registration_labels: supplied_labels)
}

fn prefix(m: ManagedHost) -> String { concat("gunbc-service-", m.host as String, "-") }

fn is_outside_grammar(m: ManagedHost, listed: String) -> Bool {
  match reg(m: m, listed: listed) { ListedRegistrationRefused { refusal: ListedNameOutsideServiceGrammar { listed: _ } } => true _ => false }
}

fn is_no_round_trip(m: ManagedHost, listed: String) -> Bool {
  match reg(m: m, listed: listed) { ListedRegistrationRefused { refusal: ListedNameDoesNotRoundTrip { listed: _, rebuilt: _ } } => true _ => false }
}

// A LISTED NAME IS ADMITTED ONLY BY EXACT ROUND TRIP through the rebuilt slot. The name the fold mints
// re-derives; a near miss (leading zero, trailing text, another host, non-decimal index) or a foreign
// runner has no registration; a host whose labels refuse admits nothing.
test fn a_listed_name_is_admitted_only_by_exact_round_trip() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } => {
      let good = unit(m: m, id: "boot-7f-a", index: 12)
      (match reg(m: m, listed: good) {
        ListedRegistrationAdmitted { registration: r, boot_id: i } =>
          r.installation == installation && (i as String) == "boot-7f-a"
        _ => false
      })
        && is_no_round_trip(m: m, listed: concat(prefix(m: m), "boot-7f-a-012.service"))
        && all(["actions-runner@srv1-3.service", concat(good, ".bak"), "gunbc-service-other-host-boot-1-2.service",
                concat(prefix(m: m), "boot-x2.service"), concat(prefix(m: m), "boot-+2.service"), concat(prefix(m: m), "-2.service"), ""],
               n => is_outside_grammar(m: m, listed: n))
        && (match jit_registration_of_listed(organization: org, host: controlled(m: m), host_identity: m.host, listed: good, authority: authority,
              registration_labels: RegistrationLabelsRefused { host: m.host, cause: "no offer" as NonEmptyStr }) {
          ListedRegistrationRefused { refusal: ListedSlotRefused { refusal: HostUnitSlotRegistrationLabelsRefused { host: _, cause: _ } } } => true
          _ => false
        })
    }
  }
}

// THE SWEEP SELECTS ONLY A STALE INCARNATION: current-boot runners and foreign names are untouched,
// and an incomplete page refuses rather than reading as absent.
test fn the_sweep_selects_stale_incarnations_only() -> Bool {
  match the_host() {
    Absent => false
    Present { value: m } => {
      let names = [unit(m: m, id: "old", index: 0), unit(m: m, id: "old", index: 1), unit(m: m, id: "new", index: 0), "actions-runner@srv1-3.service"]
      (match sweep(m: m, current: "new", names: names, total: 4) {
        LostBootSweepSelected { registrations: rs, untouched: u } => count(rs) == 2 && count(u) == 2
        _ => false
      }) && (match sweep(m: m, current: "old", names: names, total: 4) {
        LostBootSweepSelected { registrations: rs, untouched: u } => count(rs) == 1 && count(u) == 3
        _ => false
      }) && (match sweep(m: m, current: "new", names: names, total: 9) {
        LostBootSweepRefused { refusal: SweepListingUnreadable { reason: JitListingPageIncomplete { listed: _, total: _ }, cause: _ } } => true
        _ => false
      })
    }
  }
}

// A SERVICE SLOT CARRIES A BOOT ID, NEVER A HISTORICAL ATTEMPT. Only the kernel-boot arm of a capture's
// run identity yields the slot's incarnation; the attempt-ordinal arm yields nothing, so a name built
// from one cannot exist and the parse has nothing to fabricate.
test fn only_a_kernel_boot_id_becomes_a_service_incarnation() -> Bool {
  (match service_boot_id_of(run: KernelBootId { boot_id: "boot-7f-a" as NonEmptyStr }) {
    Present { value: b } => (b as String) == "boot-7f-a"
    Absent => false
  }) && (match service_boot_id_of(run: HistoricalAttemptOrdinal { ordinal: "4" as NonEmptyStr }) {
    Present { value: _ } => false
    Absent => true
  })
}
