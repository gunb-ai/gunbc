module test.claim.runner.runner_capacity_realize_witness

import gunbc.runner.runner_user_session_receipt { ReceiptAbsent }

import std.logic { Bool }
import gunbc.fleet.fleet_host_identity { operator_host_srv3, operator_host_srv4 }
import gunbc.runner.runner_capacity_plan {
  runner_capacity_plan,
  runner_capacity_add_count,
  RunnerCapacityPlan, RunnerSlotAdd,
  PlanReady,
  PlanRefused,
}
import gunbc.fleet.fleet_runner_connectivity {
  incident_2026_08_06_managed_roster_fixture,
  organization_runner_roster_materialized_slots_online_evidence,
}
import gunbc.runner.runner_capacity_realize {
  runner_capacity_apply_plan,
  runner_capacity_reapply_plans_zero_additions,
  runner_capacity_host_apply_receipt,
  RunnerCapacityApplyRefused,
  RunnerCapacityApplyCompleted,
  HostApplyRefused,
  HostApplySucceeded,
}
import gunbc.runner.runner_slot_allocation {
  committed_slot_identities,
  CommittedSlotPopulation, CommittedPopulationDerived, CommittedPopulationWidthUnresolved,
  identity_is_fabric_execution_member, RunnerSlotIdentity,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FIXTURE SUPPLIES A POPULATION AND THE AUTHORITY IS WHERE IT COMES FROM, so an unresolved host
// yields the empty list HERE -- in a fixture, where an empty observation is a legitimate input and
// the row that reads it (a_population_with_one_member_missing_is_not_a_no_op) says what it means.
// srv3 and srv4 both resolve, so neither row below is reached through this arm.
fn derived_members_of(host: HostIdentity) -> List<RunnerSlotIdentity> {
  match committed_slot_identities(host: host) {
    CommittedPopulationDerived { members: m } => m
    CommittedPopulationWidthUnresolved { host: _, cause: _ } => []
  }
}

// THE WIDTH THESE TWO ROWS ASK THE PLANNER FOR: one past the highest slot index either managed host has
// ever been OBSERVED holding -- {01,02,04,05} in the incident fixture, {01..05} in the materialized-online
// one -- so the plan is forced to reach a slot nobody has reported. It is a scenario parameter, not a model
// claim: the committed width is asserted where it belongs, in runner_slot_allocation_witness, and nothing
// here restates it.
//
// IT USED TO BE DERIVED, AND THE DERIVATION IS WHAT BROKE. This read `last_fabric_member_index() + 1`,
// correct while these hosts carried the fabric carve at 06 and 07 (width 8).
// gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci (2026-11-09) moved the roster's members to srv1,
// so the same fold produced 15 -- a width with no relation to the scenario, and this row went red asserting
// an addition count that only that number could have produced. The note here used to promise the helper
// "degrades loudly, not quietly, if the population empties": that reasoning covered the roster EMPTYING
// (width 1, refused) and missed it MOVING to another host (width 15, quietly wrong). A width that has to
// mean something about the hosts cannot come from a roster that is no longer about these hosts.
fn managed_pair_width_beyond_the_observed_slots() -> Int {
  6
}

// DID THE PLANNER ITSELF STEP ONTO THIS SLOT? Read off the plan's OWN actions rather than re-derived
// from the allocation model: a row that only counts additions stays green when the enumerator starts
// stepping onto different slots, which is exactly the drift this ruling could have hidden -- the count at
// this width is 2 before the ruling and 2 after it, for DIFFERENT slots. A refused plan contributes
// nothing, so a refusal cannot satisfy an inclusion.
fn plan_added_index(plan: RunnerCapacityPlan, host: HostIdentity, want: Int) -> Bool {
  match plan {
    PlanRefused { reason: _ } => false
    PlanReady { hosts: hs, refusals: _ } => fold(hs, init: false, f: (acc, h) => acc || (
      (h.host as String) == (host as String)
        && fold(h.actions, init: false, f: (a, act) => a || match act {
          RunnerSlotAdd { to: id } => id.slot_index == want
          _ => false
        })
    ))
  }
}

// THIS ASKED FOR TWO ADDITIONS PER HOST AT REQUESTED 7 AND WAS THE THIRD COPY OF ONE FALSE CLAIM.
// Slots 06 AND 07 on hosts whose committed width is 6 -- a seventh slot on a six-wide host, the
// same 14GiB-era assertion that stood in runner_capacity_plan_witness_test and in the enumerator
// itself. It stayed green because the admission ceiling was a hardcoded 7 that nobody moved when
// the 16GiB ruling took the managed hosts to 6, so three independent places agreed with each other
// and none of them agreed with the fleet.
//
// THE SEAM'S ACTUAL SUBJECT IS PRESERVED: a plan with real additions still reaches apply, and the
// count is still a POSTCONDITION rather than a refusal. Only the width moved, to one the hosts can
// actually carry. srv4 contributes the addition (slot 06, no fabric slot); srv3 contributes none
// (slot 06 is its compute-fabric slot), so this also exercises the seam on a host pair that
// DISAGREES rather than one where both sides happen to match.
// THE NUMBERS MOVED BECAUSE THE OBSERVATION BECAME REAL, NOT BECAUSE THE SEAM CHANGED. This row's
// claim is unchanged -- width six reaches the apply seam and is planned rather than refused. What
// moved is what the planner SEES: the observation is now decoded from the roster instead of
// synthesized as a dense prefix, and the roster the production path carries is missing slot 03 on
// both managed hosts. So srv3 plans one addition where it previously planned none, and srv4 plans
// two where it planned one. Those extra actions are not new work invented by this change; they are
// work that was always outstanding and that a synthesized observation could not see.
//
// THE IDENTITY-LEVEL ASSERTION LIVES IN runner_capacity_plan_witness at_the_committed_width_...,
// which pins WHICH slots these are. Counts are load-bearing here only for the seam's own question,
// and a count alone could not have caught the dense-prefix subtraction defect -- which is stated
// here so a future reader does not mistake this row for coverage of that class.
//
// THE ROSTER IS NOW THE MANAGED-PAIR SLICE OF THE 2026-08-06 CORPUS, SUPPLIED AT THE INTERFACE.
// The whole-org corpus stopped planning on 2026-09-15 (#11204): srv2's commitment became
// unestablished, its registrations resolve to no committed slot, and the planner refuses the
// org corpus before this seam is reached -- correctly, and
// test.claim.runner.runner_capacity_plan_witness the_whole_org_corpus_is_refused_while_srv2_holds_unaccounted_registrations
// is the claim that runs the real producer and asserts that. This row's subject is the seam on the
// managed pair; the slice carries the same holes and nothing about srv2.
//
// THE HOSTS AGREE, AND NOW FOR THE RIGHT REASON. The paragraph above says srv4 "contributes the addition
// (slot 06, no fabric slot)" while srv3 contributes none -- true until gunbc#11625 gave the fabric a second
// execution host, and false again since 2026-11-09: neither managed host has a fabric member, so BOTH step
// onto 06. What the pair plans at this width is the same two additions on each side -- 03 from the incident
// roster's hole and 06, the slot the 2026-08-21/2026-09-18 rulings had taken for fabric execution and the
// 2026-11-09 ruling returned to Actions. The count is the same number the row asserted before, which is
// exactly why the identity assertions below were added: a count alone would have stayed green through the
// ruling by silently meaning {03, 08} instead of {03, 06}. The DISAGREEING pair the older paragraph wanted
// is asserted by apply_seam_preserves_sibling_host_receipt_when_one_refuses below, which still has one.
test fn apply_seam_plans_additions_at_the_committed_width_not_count_refusal() -> Bool {
  let plan = runner_capacity_plan(
    roster: incident_2026_08_06_managed_roster_fixture(),
    receipt_for: _ => ReceiptAbsent,
  )
  match plan {
    PlanReady { hosts: _, refusals: _ } =>
      runner_capacity_add_count(plan: plan, host: operator_host_srv3) > 0
        && runner_capacity_add_count(plan: plan, host: operator_host_srv4) > 0
        // WHICH slots, not just how many: the hole at 03 and the slot the ruling returned at 06.
        && plan_added_index(plan: plan, host: operator_host_srv3, want: 3)
        && plan_added_index(plan: plan, host: operator_host_srv3, want: 6)
        && plan_added_index(plan: plan, host: operator_host_srv4, want: 3)
        && plan_added_index(plan: plan, host: operator_host_srv4, want: 6)
        // And 06 is an addition because the authority says it is not a fabric member any more -- the
        // planner is not being asked to agree with a comment here.
        && !identity_is_fabric_execution_member(identity: RunnerSlotIdentity { host: operator_host_srv3, slot_index: 6 })
        && !identity_is_fabric_execution_member(identity: RunnerSlotIdentity { host: operator_host_srv4, slot_index: 6 })
    PlanRefused { reason: _ } => false
  }
}

// RETARGETED FROM srv3 TO srv4, AND THE REASON IS STRUCTURAL RATHER THAN COSMETIC. This exercises
// the disk preflight, which runs only on a host that has ADD actions to apply -- so the row's
// requested width is load-bearing in a way a width usually is not: at a width that yields no
// additions the seam reaches HostApplySucceeded and the refusal this row is named for never
// executes. A green here would then mean nothing at all.
//
// THAT IS PRECISELY HOW IT BROKE, AND THE RETARGETING ARGUMENT ABOVE IS THE PART THAT DIED.
// It said srv4 "has no fabric slot, gains slot 06 at the committed width". gunbc#11625 gave the
// fabric a second execution host: srv4-06 and srv4-07 are fabric members, so at a request of six
// srv4's desired GitHub population is {01..05}, the materialized-online roster already holds all
// five, and srv4 plans ZERO additions -- the host was chosen for a property it had stopped having,
// and the row went red asserting a refusal that could no longer be reached.
//
// THE WIDTH MOVED WITH THE RULING, FOR THE SAME REASON AS THE ROW ABOVE. At width 6 the online roster
// holds {01..05} on srv4 and the desired GitHub population is {01..06}, so srv4 plans exactly one
// addition -- slot 06, the returned fabric slot -- the preflight runs, and the refusal this row is named
// for is reachable again. Before the 2026-11-09 ruling the host planned nothing at that width on the
// fabric side and the row leaned on 08 instead; the reason it now runs at 6 is that the fleet gave 06
// back, which is the point of the ruling read through the seam.
//
// The "not width 5" clause is the original point of the row and is untouched: the refusal must name
// the real requested width rather than silently reporting the retired srv4 five-slot disk row-pin.
// The width it must name is now read from the same authority the request was built from, so the two
// cannot drift apart the way a hand-written pair of numbers can.
test fn apply_seam_refuses_unobservable_disk_per_host_not_width_five() -> Bool {
  let width = managed_pair_width_beyond_the_observed_slots()
  let plan = runner_capacity_plan(
    roster: organization_runner_roster_materialized_slots_online_evidence(),
    receipt_for: _ => ReceiptAbsent,
  )
  match runner_capacity_apply_plan(plan: plan) {
    RunnerCapacityApplyCompleted { hosts: _ } =>
      match runner_capacity_host_apply_receipt(
        outcome: runner_capacity_apply_plan(plan: plan),
        host: operator_host_srv4,
      ) {
        Present { value: r } =>
          match r.outcome {
            HostApplyRefused { reason: reason } =>
              string_contains(s: reason, pattern: "disk unobservable")
                && string_contains(s: reason, pattern: to_string(width))
                && string_contains(s: reason, pattern: "srv4")
                && (string_contains(s: reason, pattern: "width 5") == false)
            HostApplySucceeded { add_actions_executed: _ } => false
          }
        Absent => false
      }
    RunnerCapacityApplyRefused { reason: _ } => false
  }
}

// WIDTH MOVED FROM 7 TO 6; THE REFUSAL MECHANISM HERE IS NOT THE WIDTH AND I CHECKED RATHER THAN
// ASSUMING. Both hosts refuse because this roster carries connectivity repairs, so
// host_plan_non_add_refusal fires on RunnerIncarnationReplace before any add logic runs -- measured,
// not inferred: the receipt reads "RunnerIncarnationReplace outside runner-capacity apply" on both
// srv3 and srv4. So both receipts are still present and both still refuse at the committed width,
// and this row is unchanged in substance.
//
// AN EARLIER REVISION OF THIS COMMENT CLAIMED srv3 NOW SUCCEEDS WITH ZERO ADDS because its sixth
// slot is the fabric slot. That is false and a probe caught it: the non-add refusal preempts the
// add path entirely, so the fabric slot never enters this row's outcome. The claim is recorded as
// wrong rather than quietly deleted, because it is the plausible story and the next reader will
// reach for it too.
//
// SAME ROSTER MOVE AS apply_seam_plans_additions_at_the_committed_width_not_count_refusal: the
// managed-pair slice, so the plan reaches apply instead of refusing on srv2 upstream of the seam.
test fn apply_seam_preserves_sibling_host_receipt_when_one_refuses() -> Bool {
  let outcome = runner_capacity_apply_plan(
    plan: runner_capacity_plan(
      roster: incident_2026_08_06_managed_roster_fixture(),
      receipt_for: _ => ReceiptAbsent,
    ),
  )
  match outcome {
    RunnerCapacityApplyCompleted { hosts: hs } =>
      hs.length() >= 2
        && match runner_capacity_host_apply_receipt(outcome: outcome, host: operator_host_srv3) {
          Present { value: srv3 } =>
            match runner_capacity_host_apply_receipt(outcome: outcome, host: operator_host_srv4) {
              Present { value: srv4 } =>
                match srv3.outcome {
                  HostApplyRefused { reason: _ } => true
                  HostApplySucceeded { add_actions_executed: _ } => false
                }
                  && match srv4.outcome {
                    HostApplyRefused { reason: _ } => true
                    HostApplySucceeded { add_actions_executed: _ } => false
                  }
              Absent => false
            }
          Absent => false
        }
    RunnerCapacityApplyRefused { reason: _ } => false
  }
}

// RENAMED FROM ...observed_width_satisfies_request BECAUSE A WIDTH NO LONGER SATISFIES ANYTHING.
// The claim is that re-applying a CONVERGED population plans nothing, and convergence is set
// equality rather than a count reaching a number -- a host holding {01,02,04,05} has count four and
// is not converged at width five. The fixture now hands whole populations.
test fn replay_apply_is_a_no_op_on_a_converged_population() -> Bool {
  runner_capacity_reapply_plans_zero_additions(
    hosts: [operator_host_srv3, operator_host_srv4],
    width: 5,
    observed_for: h => derived_members_of(host: h),
  )
}

// THE NON-VACUITY CONTROL, without which the row above is satisfied by a planner that never plans
// anything. One member removed from srv3's population must produce work.
test fn a_population_with_one_member_missing_is_not_a_no_op() -> Bool {
  !runner_capacity_reapply_plans_zero_additions(
    hosts: [operator_host_srv3, operator_host_srv4],
    width: 5,
    observed_for: h => if (h as String) == "srv3" { [] } else { derived_members_of(host: h) },
  )
}

// MOVED OFF THE SEVEN-WIDE FIXTURE, AND WHERE IT LANDED TOOK TWO TRIES WORTH RECORDING. Seven is not
// a width any host is admitted to carry, and once registrations are decoded rather than counted,
// srv3-07 resolves to no committed slot -- so the old fixture made the planner refuse, correctly,
// and this row was asserting convergence against a fleet that cannot exist.
//
// I FIRST REPLACED IT WITH A CONVERGED-SIX ROSTER AND THAT WAS ALSO WRONG, for a reason worth more
// than the fix. A six-wide GitHub roster puts srv4-06 in the observation, and there is no LOCAL
// incarnation for it: local_incarnations_for_host is bounded by materialized_width_for_host, which
// is a hardcoded FIVE on every host. So the planner refused with an unaccounted registration, and it
// was right again. Convergence is not a property of the GitHub roster alone -- it is agreement
// between the desired population, the GitHub population AND the local one, and the local side is
// still a synthesized constant. A converged fleet at six is therefore not representable today, and
// authoring a fixture that claimed otherwise would have been asserting a state the fleet cannot be in.
//
// AND THE FIXTURE I NEEDED ALREADY EXISTED. organization_runner_roster_materialized_slots_online_evidence
// is exactly this: both managed hosts registered 01-05 and online, converged at the materialized
// width. Minting converged_six_* beside it was a second name for one concept, which is the fork this
// module's own authority note forbids -- caught by trying to make it green rather than by review.
test fn converged_roster_plans_zero_additions_and_apply_succeeds() -> Bool {
  let plan = runner_capacity_plan(
    roster: organization_runner_roster_materialized_slots_online_evidence(),
    receipt_for: _ => ReceiptAbsent,
  )
  match plan {
    PlanReady { hosts: _, refusals: _ } =>
      // The fixture holds slots 01-05; the committed width is 18, so additions exist for 06+.
      // The apply seam either succeeds (disk observable and sufficient) or refuses by disk
      // preflight -- both are valid outcomes for a host whose disk state is not in the corpus.
      runner_capacity_add_count(plan: plan, host: operator_host_srv3) > 0
        && runner_capacity_add_count(plan: plan, host: operator_host_srv4) > 0
        && match runner_capacity_apply_plan(plan: plan) {
          RunnerCapacityApplyCompleted { hosts: hs } =>
            hs.length() >= 2
              && match runner_capacity_host_apply_receipt(outcome: runner_capacity_apply_plan(plan: plan), host: operator_host_srv3) {
                Present { value: r } =>
                  match r.outcome {
                    HostApplySucceeded { add_actions_executed: n } => n > 0
                    HostApplyRefused { reason: reason } => string_contains(s: reason, pattern: "disk")
                  }
                Absent => false
              }
              && match runner_capacity_host_apply_receipt(outcome: runner_capacity_apply_plan(plan: plan), host: operator_host_srv4) {
                Present { value: r } =>
                  match r.outcome {
                    HostApplySucceeded { add_actions_executed: n } => n > 0
                    HostApplyRefused { reason: reason } => string_contains(s: reason, pattern: "disk")
                  }
                Absent => false
              }
          RunnerCapacityApplyRefused { reason: _ } => false
        }
    PlanRefused { reason: _ } => false
  }
}
