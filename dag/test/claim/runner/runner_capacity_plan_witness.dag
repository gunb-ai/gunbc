data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THIS REPLACES A WITNESS THAT ASSERTED TWO ADDITIONS PER HOST AT REQUESTED 7, AND THE OLD
// ASSERTION WAS WRONG IN A WAY ITS GREEN CONCEALED. It required slots 06 AND 07 on hosts whose
// committed width is 6, so it demanded a SEVENTH slot on a six-wide host -- an artifact of the
// 14GiB era, when the managed hosts admitted 7. The 2026-08-17 16GiB ruling moved them to 6 and
// this witness was never re-derived, so CI was affirming a false statement about the fleet.
//
// SEVEN IS NOW REFUSED RATHER THAN QUIETLY UNFULFILLED. The admission ceiling derives from the
// committed width instead of restating it as a literal 7, so a request no host has been admitted
// to carry stops at the wall with a typed cause rather than being admitted and then producing
// nothing. Both hosts plan zero actions and both carry a WidthRefused admission -- the difference
// from the old behaviour is that the refusal is now VISIBLE in the plan.
// THE REQUESTED WIDTH IS DERIVED FROM THE CEILING, BECAUSE A LITERAL SEVEN STOPPED BEING ABOVE IT.
//
// This row asked for width 7 when the committed ceiling was 6, so the plan refused to add and
// add_count was 0. The 2026-08-23 CPU-axis change moved srv3 and srv4 to twenty-one, and 7 became
// an ordinary in-range request that the plan quite correctly fulfils -- so the row went red without
// the ceiling behaviour it names having changed at all.
//
// Retyping 7 as 22 puts the same landmine one width further out. Asking for committed + 1 keeps the
// request above the ceiling by construction, so this stays a check on the refusal arm rather than
// on whatever number the fleet happened to commit the day it was written.
//
// THE ROSTER IS THE MANAGED-PAIR SLICE, SUPPLIED AT THE INTERFACE, AND IT USED TO BE THE WHOLE ORG.
// This row went red on 2026-09-15 (#11204) without the ceiling arm changing: that change deleted
// srv2's held width, so the whole-org corpus's srv2-01/02/05 stopped resolving to a committed slot
// and the planner refused the plan before admission was ever consulted -- correctly, and
// the_whole_org_corpus_is_refused_while_srv2_holds_unaccounted_registrations now asserts exactly
// that. This row's subject is the admission ceiling on srv3 and srv4; srv2's standing is not in it,
// and consuming the org corpus here gave the row the union of every host's subject (gunbc.design_argument::single_authority, a
// witness discriminates at one interface). The slice is the same corpus rows projected, not a copy.
fn committed_width_of(host: HostIdentity) -> Int {
  match gunbc_runner_committed_width(host: host) {
    RunnerWidthUnresolved { cause: _ } => 0 - 1
    RunnerWidthDerived { slots: n } => n
  }
}

fn committed_members_of(host: HostIdentity) -> List<RunnerSlotIdentity> {
  match committed_slot_identities(host: host) {
    CommittedPopulationDerived { members: m } => m
    CommittedPopulationWidthUnresolved { host: _, cause: _ } => []
  }
}

// THE REQUESTED WIDTH IS READ FROM THE CARVE, FOR THE SAME REASON THE ROW ABOVE READS IT FROM THE
// CEILING. Four rows in this file asked for a literal SIX, which was the committed width on
// 2026-08-17 and has not been since; it is 17 on both managed hosts today. A literal that was once
// a derived number is the landmine a_width_above_the_committed_ceiling_is_refused_not_silently_unfulfilled
// already had removed from its own end of the range -- "retyping 7 as 22 puts the same landmine one
// width further out" -- and these rows kept it.
//
// WHAT THESE ROWS ACTUALLY NEED IS NOT THE COMMITTED WIDTH AT ALL. Their subject is that the
// enumeration steps OVER the fabric members rather than counting through them, so the request must
// reach the first GitHub slot on the far side of the carve. That is one above the last fabric index,
// and the helper below reads it off the roster -- so if the carve moves, this width moves with it, and
// no number here needs editing. If the committed width ever falls BELOW the carve, admission refuses
// and every row consuming this goes red naming the width, which is the loud direction.
// THE CARVE MOVED HOSTS ON 2026-11-09, SO THE AUTHORITY IS THE POPULATION RATHER THAN AN INDEX
// LITERAL. This read gunbc.runner.runner_slot_allocation fabric_second_slot_index, a literal authored
// when srv3 and srv4 each gave slots 06 and 07 to the fabric; gunbc.design_ruling::
// srv3_srv4_fabric_slots_serve_ci deleted that pair with the slots themselves, and the surviving
// members are srv1's (the microVM shakedown at 13 and the revision job at 14). Reading the greatest
// member index off the roster keeps the property the literal was replaced by in the first place --
// when the carve moves, this width moves with it and nobody has to remember to re-type a number.
//
// IT DEGRADES LOUDLY, NOT QUIETLY, IF THE POPULATION EMPTIES. With no members anywhere the fold yields
// zero and the requested width is 1, which is below every row's committed width; those rows then ask
// for a fleet with nothing beyond a carve that does not exist, and the addition-set assertions below
// go red rather than passing on an empty enumeration. A fleet with no fabric execution members is an
// operator decision away and would be recorded as a gunbc.design_ruling row -- the rows here are then
// re-written against whatever the replacement discriminator is, which is what this note is for.
fn last_fabric_member_index() -> Int {
  // The accumulator is Int and the roster's field is Nat, so the branch that takes a member's index
  // climbs it and the seed stays Int: both branches are Int, which is what the join requires.
  fold(fabric_execution_slot_identities(), init: 0, f: (acc, s) =>
    if s.slot_index > acc { s.slot_index as Int } else { acc })
}

fn first_width_above_the_fabric_carve() -> Int {
  last_fabric_member_index() + 1
}

test fn a_width_above_the_committed_ceiling_is_refused_not_silently_unfulfilled() -> Bool {
  let outcome = plan_runner_capacity_host(
    host: operator_host_srv3,
    requested_width: committed_width_of(host: operator_host_srv3) + 1,
    roster: incident_2026_08_06_managed_roster_fixture(),
    receipt: ReceiptAbsent,
  )
  match outcome {
    HostCapacityPlanReady { plan: p } =>
      match p.admission {
        WidthRefused { requested: _, cause: _ } => true
        WidthAdmitted { width: _ } => false
      }
    HostCapacityPlanRefused { host: _, reason: _ } => false
  }
}

// ADDED SLOTS ARE REPORTED AS IDENTITIES, WHICH IS WHAT LETS THE ROWS BELOW SEPARATE PURPOSE FROM
// COUNT. A count cannot tell a plan that steps over the fabric members from one that enumerates
// through them when both happen to propose the same number of actions, and on a fleet where the
// carve sits mid-range they routinely do.
//
// AN EARLIER FORM OF THIS NOTE EXPLAINED THE POINT WITH A CONTRAST BETWEEN srv3 AND srv4, both six
// wide, one carved and one not. Neither half of that sentence survives: gunbc#11625 carved srv4 as
// well, and the committed width of both is 17. The proposition was never about those numbers, so it
// is stated here without them and the rows below read the carve from its authority.
fn added_indices(actions: List<RunnerCapacityAction>) -> List<Int> {
  fold(
    actions,
    init: [],
    f: (acc, a) =>
      match a {
        RunnerSlotAdd { to: id } => concat(acc, [id.slot_index])
        RunnerSlotChange { from: _, to: _ } => acc
        RunnerSlotRemove { from: _ } => acc
        RunnerIncarnationReplace { slot: _, cause: _ } => acc
      }
  )
}

// THIS ROW ASSERTS WHICH SLOTS ARE ADDED, AND IT USED TO ASSERT HOW MANY. The change is not
// cosmetic: against the roster the planner consumes, the COUNTS are identical before and after the
// repair that made addition_actions a set difference -- while the identities are completely
// different. The count-shaped version of this row passed the broken planner and would have passed
// the fixed one, flickering at neither.
//
// WHAT THE BROKEN PLANNER ACTUALLY PROPOSED, measured: srv3 add 05, which is ALREADY REGISTERED,
// while 03, the slot genuinely missing from the roster, was never planned at any width. That is the
// dense-prefix comparison surviving in the subtraction after both populations had become sets, and
// decoding the observation is what made it harmful -- a real roster has holes and a count cannot see
// them.
//
// THE PAIR THIS ROW USED TO DISCRIMINATE WITH NO LONGER EXISTS, AND SAYING SO IS THE REPAIR RATHER
// THAN RETYPING THE EXPECTATION. It asserted srv3 [3] against srv4 [3, 6] and explained the
// difference as "srv4 must additionally add 06 because it has no fabric member". gunbc#11625 gave
// the fabric a SECOND EXECUTION HOST: fabric_execution_slot_identities now carries srv3-06, srv3-07,
// srv4-06 and srv4-07, so the two managed hosts are symmetric and no request can make them differ.
// That change re-derived the allocation, provision and retirement witnesses and did not reach this
// file, which is why this row and five beside it were asserting a fleet that had stopped existing.
//
// THE NAMED PROPOSITION SURVIVES INTACT AND NOW FIRES ON BOTH HOSTS AT ONCE, which is a stronger
// check than the asymmetry it replaces. Asking for the first width above the carve, the planner must
// STEP OVER both fabric members to reach 08: the desired GitHub set is {01..05, 08}, the roster holds
// {01,02,04,05}, so the additions are exactly [3, 8]. A count-keyed planner at the same request would
// propose [3, 6, 7, 8] -- it would enumerate straight through the carve -- so the row still separates
// purpose from count, and it does so on the production path rather than on a helper.
//
// SAME ROSTER MOVE AS THE ROW ABOVE: the managed-pair slice of the 2026-08-06 corpus, which carries
// the holes this row is about ({01,02,04,05} on both hosts) and nothing about srv2.

test fn at_the_committed_width_additions_follow_purpose_not_count() -> Bool {
  let roster = incident_2026_08_06_managed_roster_fixture()
  // WHERE A CARVE STILL IS. srv1 is the host whose committed population holds fabric execution members
  // today, so this is where the property has to be shown rather than where it was convenient to show
  // it: at srv1's own committed width the additions are the GitHub identities and nothing else -- not
  // srv1-13/srv1-14, whose purpose is fabric execution, and not a count-fill up to the width, because
  // the plan enumerates the committed identities by index. A planner keyed on the observed count instead
  // of the committed indices would produce something else here, which is the whole reason the row was
  // written when a fabric member first appeared inside a host's committed range.
  added_indices(actions: addition_actions(
    members: committed_members_of(host: operator_host_srv1),
    requested_width: committed_width_of(host: operator_host_srv1),
    observed: []
  )) == [1, 2, 3, 4, 5, 6]
    // srv1's committed GitHub identities are 01..06 since gunbc.design_ruling::srv1_microvm_slot_charge_waits_for_realization
    // released srv1-13/14's charge while they are read not realized (width 8 = 01..06 + 13 + 14); before it
    // they were 01..02. The proposition is unchanged: the additions are exactly the GitHub identities, and the
    // two fabric-purpose members inside the committed range are never among them.
    && !added_indices_contains(
      added_indices(actions: addition_actions(
        members: committed_members_of(host: operator_host_srv1),
        requested_width: committed_width_of(host: operator_host_srv1),
        observed: []
      )), v: 13)
    // WHERE THE CARVE USED TO SIT ON THESE TWO HOSTS. The same planner, over a managed host at its own
    // committed width, now steps ONTO indices 6 and 7 -- the slots the superseded roster of 2026-08-21 /
    // 2026-09-18 held for fabric execution (gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci
    // returned them). Under that roster these two assertions were false, so the row is not being retyped
    // to match a number: the planner's behaviour, not this file, is what moved.
    && added_indices_contains(
      added_indices(actions: addition_actions(
        members: committed_members_of(host: operator_host_srv3),
        requested_width: committed_width_of(host: operator_host_srv3),
        observed: observed_prefix_from_roster(host: operator_host_srv3, roster: roster)
      )), v: 6)
    && added_indices_contains(
      added_indices(actions: addition_actions(
        members: committed_members_of(host: operator_host_srv4),
        requested_width: committed_width_of(host: operator_host_srv4),
        observed: observed_prefix_from_roster(host: operator_host_srv4, roster: roster)
      )), v: 7)
    // AND IT IS A PLAN, NOT A HELPER CALLED IN ISOLATION: the same widths the assertions above read must
    // be widths the apply boundary is willing to emit.
    && match runner_capacity_plan(
      roster: roster,
      receipt_for: _ => ReceiptAbsent,
    ) {
      PlanReady { hosts: _, refusals: _ } => true
      PlanRefused { reason: _ } => false
    }
}

// THE WHOLE 2026-08-06 CORPUS, AND WHAT IT ESTABLISHES IS A REFUSAL -- BUT NOT THE ONE THIS ROW
// USED TO ASSERT. incident_2026_08_06_roster_fixture was what gunbc.apply and
// gunbc.runner.runner_capacity_realize handed the planner until they moved to the live read
// (gunbc.fleet.organization_runner_roster_read). Against the fleet as committed today the planner
// still REFUSES this corpus and still names srv2-01, and the refusal is still correct -- what
// changed is WHY, and the why is the whole subject of this row.
//
// WHAT IT ASSERTED AND WHY THAT WAS WRONG. It required the refusal to read "resolves to no
// committed fleet slot": the decoder found srv2-01 in no host's committed population and called it
// a registration this fleet never provisioned. srv2's population was not small, it was
// UNDERIVABLE -- its session reservation is unestablished, so its width does not resolve and it
// contributes no members to compare against. The old sentence turned that missing denominator into
// a positive claim about a registration that is very probably ours, and the previous revision of
// this comment called those registrations "unaccounted", which is the same claim in prose.
//
// WHAT IT ASSERTS NOW. The refusal must name the HOST and the CAUSE, and must NOT call the
// registration surplus. RED in both directions: a planner that went back to calling srv2-01
// foreign fails the second conjunct, and a planner that stopped refusing at all fails the first.
//
// WHEN srv2'S COMMITMENT IS RE-ESTABLISHED THIS ROW GOES RED, AND THAT IS STILL ITS JOB: the corpus
// then resolves and the row is re-derived by the change that re-establishes srv2, not by editing the
// 2026-08-06 rows to fit the fleet of the day.
test fn the_whole_org_corpus_is_refused_because_srv2_has_no_derivable_width() -> Bool {
  match runner_capacity_plan(roster: incident_2026_08_06_roster_fixture(), receipt_for: _ => ReceiptAbsent) {
    PlanReady { hosts: _, refusals: rs } =>
      fold(rs, init: false, f: (acc, r) =>
        acc || match r {
          HostCapacityPlanRefused { host: rh, reason: rr } =>
            (rh as String) == "srv2"
              && string_contains(s: rr, pattern: "committed width unresolved")
              && string_contains(s: rr, pattern: "UNRESOLVED, not zero")
              && string_contains(s: rr, pattern: srv2_reservation_policy_cause_fragment)
          HostCapacityPlanReady { plan: _ } => false
        }
      )
    PlanRefused { reason: _ } => false
  }
}

// THE POLICY'S OWN SENTENCE MUST SURVIVE THE WHOLE ROUTE, and without this conjunct it need not.
// A renderer that dropped the cause suffix while keeping "is UNRESOLVED, not zero" satisfies every
// other conjunct above -- the refusal would still read as a typed refusal and would no longer say
// WHY, which is the half an operator acts on. This fragment is authored in
// gunbc.session_reservation_policy srv2_session_reservation_sizing and is quoted rather than
// re-derived deliberately: a witness that computed it from the policy would agree with the policy
// by construction and could not see the renderer dropping it.
data srv2_reservation_policy_cause_fragment: String = "the managed-slice peak cannot be read as a whole-host aggregate"

fn observed_prefix_from_roster(host: HostIdentity, roster: OrganizationRunnerRosterEvidence) -> List<RunnerSlotIdentity> {
  match observed_github_slot_identities(host: host, roster: roster) {
    GitHubSlotPopulationObserved { identities: ids } => ids
    GitHubSlotPopulationUnreadable { reason: _ } => []
    GitHubSlotPopulationDuplicateRegistration { slot: _ } => []
    GitHubSlotPopulationForeignRegistration { registration_name: _ } => []
    GitHubSlotPopulationHostWidthUnresolved { registration_name: _, host: _, cause: _ } => []
  }
}

// ENROLLED REGRESSION CONTROL FOR THE EMPTY-OBSERVATION NARROW
// (gunbc.runner.runner_capacity_plan slot_enumeration_narrow_class_note).
//
// IT ASSERTS THE PRODUCTION PATH, NOT A HELPER. An earlier revision of this row asserted
// desired_slot_indices and addition_slot_indices directly; the set-difference planner removed the
// last consumer of both, so those rows would have been testing functions nothing runs -- coverage
// by illusion, one rung up from the blindness they were enrolled to prevent. They are deleted and
// this asserts nat_range_inclusive, which committed_slot_identities really consumes, and
// addition_actions, which the planner really calls.
//
// THE TRANSITIONS ARE A SET BECAUSE ONE OF THEM IS NOT A CHECK. A row asserting only the 5-to-6
// widening would go green against a planner that special-cased slot 6 -- the bucket rebuilt under a
// new name. Asking for three different spans, including one from zero, leaves no single special
// case that satisfies them all. And they assert IDENTITIES and counts of real actions, never a bare
// length: a length cannot tell [6] from [7], so a planner producing the right NUMBER of the WRONG
// slots would pass.
// A DENSE PREFIX IS A LEGITIMATE FIXTURE HERE AND WAS AN ILLEGITIMATE PRODUCTION OBSERVATION, which
// is the same shape appearing on both sides of the change. These rows exercise the addition
// arithmetic directly and are entitled to hand it any population they like, including a hole-free
// one. What was wrong was the PLANNER deriving that shape from a width instead of reading it.
fn observed_prefix(host: HostIdentity, n: Int) -> List<RunnerSlotIdentity> {
  fold(
    committed_members_of(host: host),
    init: [],
    f: (acc, id) => if id.slot_index > n { acc } else { concat(acc, [id]) }
  )
}

// THE ADDITION-RUN CASES MOVED FROM srv4 TO srv1, BECAUSE srv4 STOPPED BEING A HOST THAT CAN
// ANSWER THIS QUESTION. The three transitions below are about the RUN -- does the enumeration span
// every width, including from zero, and does a converged host produce nothing -- so they need a host
// whose GitHub population is its whole committed population. srv4 was that host when these lines
// were written; gunbc#11625 made it an execution host carrying srv4-06 and srv4-07, so a request of
// six now yields five and the counts below stopped measuring the run at all.
//
// srv1 IS UNCARVED BY A DECISION AND NOT BY ACCIDENT, which is what makes it the right substitute
// rather than a host that happens to be convenient today. gunbc.runner.runner_slot_allocation holds it out
// of fabric_execution_slot_identities so the control plane has a host it can still land on -- a
// relation between two placements, recorded there with the reason to revisit it. If srv1 is ever
// carved, these counts go red and the row beside them is where the purpose difference is asserted.
test fn the_additions_run_is_general_across_transitions() -> Bool {
  nat_range_inclusive(lo: 6, hi: 6) == [6]
    && nat_range_inclusive(lo: 6, hi: 7) == [6, 7]
    && nat_range_inclusive(lo: 1, hi: 3) == [1, 2, 3]
    && nat_range_inclusive(lo: 6, hi: 5) == []
    && addition_actions(members: committed_members_of(host: operator_host_srv1), requested_width: 6, observed: observed_prefix(host: operator_host_srv1, n: 0)).length() == 6
    && addition_actions(members: committed_members_of(host: operator_host_srv1), requested_width: 3, observed: observed_prefix(host: operator_host_srv1, n: 0)).length() == 3
    && addition_actions(members: committed_members_of(host: operator_host_srv1), requested_width: 6, observed: observed_prefix(host: operator_host_srv1, n: 6)).length() == 0
}

// THE DESIRED GitHub SET SKIPS THE FABRIC MEMBERS WHEREVER THEY SIT, which is the assumption the
// count-and-dense-prefix form could not express. THERE ARE TWO OF THEM PER EXECUTION HOST NOW, not
// one: gunbc#11625 widened the canary from a single slot on a single host to srv3-06, srv3-07,
// srv4-06 and srv4-07, and this row still described the one-slot fleet -- it asserted that srv4
// "has no carve and desires all six", which is the sentence that made it red.
//
// THE FOUR CASES ARE CHOSEN SO THAT EACH ONE FAILS FOR ITS OWN REASON. A request that spans the
// whole carve loses exactly two members on an execution host (17 committed, 8 requested, 6 desired);
// the SAME request on the uncarved host loses none, so a version of desired_github_identities that
// ignored purpose would pass the first pair and fail the third; and a request that stops BELOW the
// carve loses nothing even on a carved host, so a version that subtracted a fixed count rather than
// testing membership would pass the first three and fail the fourth. The width is read from the
// carve rather than written down, for the reason first_width_above_the_fabric_carve records.

test fn the_desired_github_set_excludes_the_fabric_member() -> Bool {
  // EVERY COMMITTED SLOT ON srv3 AND srv4 IS SERVED. These two clauses are the operator ruling of
  // 2026-11-09 (gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci) read at the plan layer: the
  // desired GitHub set at a host's own committed width IS its committed population, because nothing
  // on those hosts is carved any more. Under the superseded roster of 2026-08-21 / 2026-09-18 each of
  // these was width minus two, which is the only reason the row exists.
  desired_github_identities(members: committed_members_of(host: operator_host_srv3),
    requested_width: committed_width_of(host: operator_host_srv3)).length()
    == committed_width_of(host: operator_host_srv3)
    && desired_github_identities(members: committed_members_of(host: operator_host_srv4),
      requested_width: committed_width_of(host: operator_host_srv4)).length()
      == committed_width_of(host: operator_host_srv4)
    // THE EXCLUSION ITSELF STILL FIRES, ON THE HOST THAT STILL HAS THE CARVE. The members are handed to
    // desired_github_identities straight from gunbc.runner.runner_slot_allocation
    // fabric_execution_slot_identities rather than filtered out of a committed population, and that is
    // deliberate: srv1's two members sit above srv1's committed width, so a clause over
    // committed_members_of(srv1) would be satisfied by their ABSENCE rather than by the purpose filter
    // -- the green-by-construction this file's own note at the top condemns. The clause beside it is
    // the control a zero alone cannot give: the same width over a GitHub-purpose identity of the same
    // shape yields that identity, so zero above is the purpose and not the shape, the host, or the index.
    && desired_github_identities(members: fabric_execution_slot_identities(),
      requested_width: last_fabric_member_index()).length() == 0
    && desired_github_identities(members: [srv3_slot(i: srv1_revision_job_slot().slot_index)],
      requested_width: last_fabric_member_index()).length() == 1
}

// THE FLIP ROW AND THE NON-FLIP ROW, AND THE SECOND ONE IS THE TRAP. One host at the 5-to-6
// widening plans ONE addition -- slot 06 is an ordinary GitHub slot there, so the transition is
// expressible and is expressed. It goes red the moment a planner stops being able to spell a
// transition, which is the defect this row was enrolled for.
//
// THE OTHER HOST AT THE SAME TRANSITION PLANS ZERO, AND THAT IS WHY IT IS ENROLLED. Zero is the
// answer both a working planner and a broken one give, for entirely different reasons: the broken
// bucket could not spell 6, and the working planner withholds 06 because it is a fabric member and
// is not in the desired GitHub set. Same value, same transition, same index, different mechanism.
// Enrolled alone it would have stayed green straight through the defect AND the fix while silently
// changing meaning. It is only a check when read against the flip row beside it, and a future reader
// who deletes it as redundant removes the half that discriminates.
//
// THE PAIR IS srv1-AGAINST-srv3 AND IT USED TO BE srv4-AGAINST-srv3. It was named for "two six-wide
// hosts" and rested on srv4 having no carve; gunbc#11625 gave the fabric a second execution host, so
// srv4 now carries srv4-06 and srv4-07 and answers ZERO at this transition exactly as srv3 does.
// Two hosts that agree cannot discriminate anything, so the row could not be repaired by moving a
// number -- the contrast had to be re-derived. srv1 is the host that still differs, and it differs
// BY A DECISION: gunbc.runner.runner_slot_allocation holds it out of the execution population so the
// control plane keeps a host it can land on. The name moves with the subject rather than keeping a
// width in it that was never what the row was about.

// WAS: the_same_widening_differs_by_purpose_across_a_carved_and_an_uncarved_host, which widened srv1
// and srv3 to the SAME width over the SAME observed prefix and asserted they needed DIFFERENT numbers
// of additions -- one on the uncarved host, zero on the carved one, because index 6 was a fabric
// member there. gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci deleted the difference between
// those two hosts, so the row keeps its shape and asserts the absence it now has to assert; the
// purpose half of the contrast moved to the_desired_github_set_excludes_the_fabric_member, which can
// exercise it without needing one host carved and one not.
test fn the_two_managed_hosts_widen_alike_now_that_no_carve_sits_between_them() -> Bool {
  let width = 6
  addition_actions(members: committed_members_of(host: operator_host_srv3), requested_width: width,
    observed: observed_prefix(host: operator_host_srv3, n: width - 1)).length() == 1
    && addition_actions(members: committed_members_of(host: operator_host_srv4), requested_width: width,
      observed: observed_prefix(host: operator_host_srv4, n: width - 1)).length() == 1
    // NOT "always one": at its own width a host that already has every member adds nothing, so the two
    // clauses above are the missing slot and not a constant.
    && addition_actions(members: committed_members_of(host: operator_host_srv3), requested_width: width,
      observed: observed_prefix(host: operator_host_srv3, n: width)).length() == 0
}

test fn roster_unavailable_refuses_runner_capacity_plan() -> Bool {
  match runner_capacity_plan(roster: RosterReadUnavailable { reason: "503" }, receipt_for: _ => ReceiptAbsent) {
    PlanRefused { reason: _ } => false
    PlanReady { hosts: hs, refusals: rs } =>
      hs.length() == 0 && rs.length() > 0
  }
}

test fn satisfied_observed_width_plans_zero_additions() -> Bool {
  addition_actions(members: committed_members_of(host: operator_host_srv3), requested_width: 5, observed: observed_prefix(host: operator_host_srv3, n: 5)).length() == 0
    && addition_actions(members: committed_members_of(host: operator_host_srv3), requested_width: 7, observed: observed_prefix(host: operator_host_srv3, n: 7)).length() == 0
}

// Does the added-index list contain this index. Folded over Bool, so no Nat/Int join is asked of the
// compiler: the accumulator and both branches are Bool.
fn added_indices_contains(indices: List<Int>, v: Int) -> Bool {
  fold(indices, init: false, f: (acc, x) => if x == v { true } else { acc })
}

fn population_is_refused(v: SlotPopulationVerdict) -> Bool {
  match v {
    SlotPopulationRefused { reason: _ } => true
    SlotPopulationReconciled => false
  }
}


fn srv3_slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv3, slot_index: i }
}

fn srv1_slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv1, slot_index: i }
}

// A GitHub RUNNER SITTING IN THE FABRIC'S SLOT MUST NOT READ AS CONVERGED, AND THE THIRD ROW IS THE
// ONE THAT MATTERS. The first two are the unequal-count cases an Int-shaped reconciler could already
// catch. The third is the case it could not: observed GitHub {1,2,3,4,6} against expected
// {1,2,3,4,5} counts FIVE ON BOTH SIDES, so every count-shaped comparison reconciles, while slot 06
// -- the fabric member -- is occupied by an actions-runner and a legitimate GitHub member is missing.
// That is exactly the proposition this module asserts counts cannot establish, and an earlier
// revision of reconcile_slot_population took an observed_width Int while its own annotation claimed
// it compared populations.
//
// THE srv1 ROWS ARE THE CONTROL AND WITHOUT THEM THIS PROVES NOTHING. srv1 has no fabric slot, so
// its full committed population is a reconciled observation and must NOT refuse; an identity beyond
// its width must. A verdict that refused every non-empty roster would satisfy the srv3 rows by
// being broken everywhere.
// THE SUBJECT IS BOUND: AN IDENTITY ADMISSIBLE FOR ANOTHER HOST CANNOT ANSWER FOR THIS ONE. The
// host parameter was declared and never read, so this accepted srv4-01 when asked about srv3 --
// srv4-01 is a perfectly good slot, just not one of srv3's, and accepting it would let a foreign
// member stand in for a missing local one while every other arm stayed satisfied.
//
// THE SECOND ROW IS THE CONTROL. The same identity asked about its OWN host must pass, or the
// refusal is just a broken function rather than a subject binding.
test fn an_identity_from_another_host_cannot_answer_for_this_one() -> Bool {
  population_is_refused(v: validate_observed_github_slot_members(
    host: operator_host_srv3,
    observed: [srv3_slot(i: 1), RunnerSlotIdentity { host: operator_host_srv4, slot_index: 1 }],
  ))
    && !population_is_refused(v: validate_observed_github_slot_members(
      host: operator_host_srv4,
      observed: [RunnerSlotIdentity { host: operator_host_srv4, slot_index: 1 }],
    ))
}

// THE srv1 CLAUSE NOW DERIVES ITS OUT-OF-RANGE INDEX; THE srv3 CLAUSES NEEDED NOTHING.
//
// The last clause observed srv1 slots [1, 6] and required a refusal. Six was outside srv1's
// five-wide population when this was written; at twenty-one it is an ordinary committed member, so
// the refusal correctly did not fire and only this fixture was wrong. It now asks for committed + 1.
//
// Every srv3 clause is untouched and that is the informative half: srv3-06 refuses because it is
// the AUTHORED fabric identity, not because of where it sits relative to a width. The width moved
// from six to twenty-one underneath these clauses and they did not notice -- which is the property
// runner_slot_allocation was built to have, observed rather than asserted.


// WAS a five-clause row whose clauses had four different subjects. It is split in two below, because a
// conjunction spanning a ruling inversion, a prefix hole and two srv1 clauses cannot tell you which of
// its halves died -- and one of those halves is exactly the kind that dies quietly.
//
// DELETED WITH REASON, not stubbed: the clauses that observed a GitHub runner INSIDE a fabric slot and
// demanded a refusal. That mechanism needs an observed list that is a contiguous prefix of the host's
// committed GitHub identities AND contains a fabric identity. srv1 is the only host with fabric members
// and its committed indices are [1, 2, 13, 14], so any list naming srv1-13 or srv1-14 is a hole in the
// prefix, and the refusal it produces comes from the hole rather than from the slot's purpose -- a row
// that passes because the check it tests is not the check it fires. The property is not lost: it lives
// at the plan layer in a_github_registration_on_the_fabric_slot_now_refuses_the_plan, with its control
// the_same_roster_without_the_fabric_slot_is_not_refused, both green, both firing on a roster where the
// named slot is outside the requested width rather than inside a prefix. The above-the-ceiling clause
// is likewise not duplicated here; a_width_above_the_committed_ceiling_is_refused_not_silently_unfulfilled
// owns it, reading the ceiling from the model.
//
// AND A THIRD DELETION, WITH THE MEASUREMENT THAT FORCED IT. The old row had a clause observing
// [srv3-01..04, srv3-06] -- a skip over 05 -- and commented that it refused "because a hole is a hole".
// Split out on its own it is FALSE: validate_observed_github_slot_members accepts it. On main it was
// true only because index 6 was a fabric execution member, so the refusal came from the slot's purpose
// and not from any prefix rule -- the validator checks that each observed identity is a committed GitHub
// member of this host (a_registration_naming_no_committed_slot_refuses_instead_of_being_dropped, green)
// and does not require the observed set to be an initial segment. Keeping the clause would have left a
// row that read as a hole-check while testing something else, and after this PR it tests nothing at all.
// If the fleet wants an initial-segment rule, it belongs in
// gunbc.runner.runner_capacity_plan::validate_observed_github_slot_members as a new verdict, not as a
// comment on a row that cannot fire.
test fn the_returned_slot_reads_converged_rather_than_refusing() -> Bool {
  // srv3-06 was the subject of the clause this row opened with, demanding a REFUSAL: a runner observed
  // in a fabric execution slot is a slot serving the wrong purpose. gunbc.design_ruling::
  // srv3_srv4_fabric_slots_serve_ci made it a GitHub slot, so the same observation must now read
  // CONVERGED -- a validator that still refused it would be enforcing the superseded roster. The clause
  // stays in the row that carried the old expectation rather than being deleted with it.
  !population_is_refused(v: validate_observed_github_slot_members(
    host: operator_host_srv3,
    observed: [srv3_slot(i: 1), srv3_slot(i: 2), srv3_slot(i: 3), srv3_slot(i: 4), srv3_slot(i: 5), srv3_slot(i: 6)],
  ))
}


fn width_parses_to(value: String, expected: Int) -> Bool {
  match parse_positive_width(value: value) {
    Absent => false
    Present { value: n } => n == expected
  }
}

fn width_refuses(value: String) -> Bool {
  match parse_positive_width(value: value) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE COMMITTED WIDTH MUST BE SPELLABLE AT THE ENTRY POINT THAT ACTUATES IT, and before this change
// it was not: parse_positive_width recognized "7", "5" and "0" and nothing else, so gunbc.apply
// could not request the six that srv3 and srv4 are committed to. Every repair in this module was
// unreachable from the only caller that drives it.
//
// "6" IS THE ROW THAT WOULD HAVE BEEN RED. The others are here so that a future bucket cannot pass:
// a parser that enumerated {5,6,7} would satisfy the six alone. Zero and negatives refuse because
// the function is named for a POSITIVE width and its caller reports "must be a positive integer" --
// an accepted zero made that message false at the layer that printed it.
test fn every_positive_width_is_spellable_at_the_apply_boundary() -> Bool {
  width_parses_to(value: "6", expected: 6)
    && width_parses_to(value: "5", expected: 5)
    && width_parses_to(value: "7", expected: 7)
    && width_parses_to(value: "1", expected: 1)
    && width_parses_to(value: "12", expected: 12)
    && width_refuses(value: "0")
    && width_refuses(value: "-3")
    && width_refuses(value: "")
    && width_refuses(value: "six")
}

// THESE FOUR WITNESSES EXIST BECAUSE THE REFUSAL ABOVE COULD NOT FIRE, AND THE REASON IT COULD NOT
// FIRE WAS NOT STALENESS. observed_slot_identities measured LOCAL SYSTEMD INCARNATIONS and handed
// them to validate_observed_github_slot_members, which decides a question about GITHUB REGISTRATIONS.
// Two different populations wearing one name, and neither the type nor the check could tell them
// apart because both are lists of slot identities.
//
// THE NUMBERS BELOW ARE ABOUT A FIXTURE AND NOT ABOUT THE FLEET, AND AN EARLIER REVISION OF THIS
// BLOCK SAID OTHERWISE. Measured by execution against what the production path currently supplies:
// srv1 synthesized 5 / decoded 5, srv2 5 / 3, srv3 5 / 4, srv4 5 / 4, twenty against sixteen. What
// it supplied was the pinned 2026-08-06 incident corpus, now the dated witness fixture
// incident_2026_08_06_roster_fixture, so this decodes a constant. The earlier revision also
// called the incident note's fifteen-offline-of-sixteen line an INDEPENDENT corroboration; it is the
// prose describing the same fixture, so the two agreements are one source agreeing with itself.
// That makes this a consistency check on the decoder, which is worth having, and it is not evidence
// about today's fleet -- the production path now reads gunbc.fleet.organization_runner_roster_read instead.
//
// WHAT IS TRUE AGAINST ANY ROSTER, AND IS THE HALF THAT MATTERS: the category error is a fact about
// the wiring rather than the data, and the direction of the error is fixed -- addition_actions
// derives additions from observed_width, so OVER-counting the observed population plans FEWER
// additions than convergence needs. A host short of registrations reads as converged with nothing
// to plan, whatever roster it is handed.
fn one_registration(name: String, id: Nat) -> GitHubSelfHostedRunnerRegistration {
  GitHubSelfHostedRunnerRegistration {
    id: id,
    name: name as NonEmptyStr,
    status: GitHubRunnerOnline,
    busy: false,
    ephemeral: Present { value: true },
    version: Present { value: "2.334.0" as NonEmptyStr },
    os: "Linux" as NonEmptyStr,
    labels: [],
  }
}

fn roster_of(names: List<String>) -> OrganizationRunnerRosterEvidence {
  RosterObserved {
    observed_on: "witness-fixture" as NonEmptyStr,
    registrations: fold(
      names,
      init: [],
      f: (acc, n) => concat(acc, [one_registration(name: n, id: 1)])
    ),
  }
}

fn plan_is_refused(host: HostIdentity, width: Int, roster: OrganizationRunnerRosterEvidence) -> Bool {
  match plan_runner_capacity_host(receipt: ReceiptAbsent, host: host, requested_width: width, roster: roster) {
    HostCapacityPlanRefused { host: _, reason: _ } => true
    HostCapacityPlanReady { plan: _ } => false
  }
}

// THE DISCRIMINATING PAIR IS THE WITNESS, NOT THE REFUSAL. A lone refusing row cannot distinguish
// "the fabric slot was detected" from "this planner refuses every roster I hand it", which is
// exactly how the previous version stayed green while its subject was unreachable. The two rosters
// differ in ONE element, srv3-06, and they must disagree.
test fn a_github_registration_on_the_fabric_slot_now_refuses_the_plan() -> Bool {
  plan_is_refused(
    host: operator_host_srv3,
    width: 5,
    roster: roster_of(names: ["srv3-01", "srv3-02", "srv3-03", "srv3-04", "srv3-05", "srv3-06"]),
  )
}

test fn the_same_roster_without_the_fabric_slot_is_not_refused() -> Bool {
  !plan_is_refused(
    host: operator_host_srv3,
    width: 5,
    roster: roster_of(names: ["srv3-01", "srv3-02", "srv3-03", "srv3-04", "srv3-05"]),
  )
}

// A NAME THE FLEET CANNOT ACCOUNT FOR REFUSES RATHER THAN BEING SKIPPED. Skipping it and folding on
// is the empty-observation narrow one layer inside the fix: a dropped member is an under-count, and
// an under-count reads as a host with slots missing, so the planner would propose adding a slot
// GitHub already holds.
test fn a_registration_naming_no_committed_slot_refuses_instead_of_being_dropped() -> Bool {
  plan_is_refused(
    host: operator_host_srv3,
    width: 5,
    roster: roster_of(names: ["srv3-01", "srv3-02", "srv3-03", "srv3-04", "srv3-05", "srv9-01"]),
  )
}

// THE OBSERVATION IS THE ROSTER'S, NOT THIS HOST'S DENSE PREFIX. Handed a roster made entirely of
// another host's registrations, srv3 must observe ZERO. The synthesized form could not express this
// at all -- it never read the roster, so it answered materialized_width_for_host regardless of what
// GitHub held, and would have said five.
test fn another_hosts_registrations_do_not_widen_this_host() -> Bool {
  // THE THREE NAMES ARE srv1's COMMITTED SLOTS, not three numbers that happen to look like a prefix.
  // gunbc.runner.runner_capacity_plan accumulate_decoded_registration drops a registration whose slot
  // is committed on ANOTHER host and refuses outright when a name matches no committed slot at all, so
  // a name srv1 has not committed turns this roster into the foreign-name case the row below belongs
  // to -- and the row read red for a reason that has nothing to do with what it names. The three below
  // are committed on srv1 under either standing of srv1's width, so the roster is what the row's name
  // says it is: another host's registrations, handed to this host. The discriminator is untouched --
  // an observation built from this host's dense prefix would still return three srv3 identities here.
  match observed_github_slot_identities(
    host: operator_host_srv3,
    roster: roster_of(names: ["srv1-01", "srv1-02", "srv1-13"]),
  ) {
    GitHubSlotPopulationObserved { identities: ids } => length(ids) == 0
    GitHubSlotPopulationUnreadable { reason: _ } => false
    GitHubSlotPopulationDuplicateRegistration { slot: _ } => false
    GitHubSlotPopulationForeignRegistration { registration_name: _ } => false
    GitHubSlotPopulationHostWidthUnresolved { registration_name: _, host: _, cause: _ } => false
  }
}

// A POPULATION IS A SET AND A FOLD OVER A LIST IS NOT ONE UNLESS IT SAYS SO. Two registrations
// decoding to the same identity -- reachable on GitHub after a re-register -- would otherwise count
// twice, and the count is exactly what addition_actions derives additions from. So a duplicate
// inflates the observed width and plans one fewer addition than convergence needs: the same
// over-counting this whole change removes, arriving by a second route. The control below it is the
// same roster with the duplicate collapsed, which must NOT refuse.
test fn a_duplicate_registration_refuses_because_the_observed_population_is_a_set() -> Bool {
  plan_is_refused(
    host: operator_host_srv3,
    width: 5,
    roster: roster_of(names: ["srv3-01", "srv3-02", "srv3-02", "srv3-03", "srv3-04", "srv3-05"]),
  )
}

test fn the_same_roster_without_the_duplicate_is_not_refused() -> Bool {
  !plan_is_refused(
    host: operator_host_srv3,
    width: 5,
    roster: roster_of(names: ["srv3-01", "srv3-02", "srv3-03", "srv3-04", "srv3-05"]),
  )
}

// THE REGISTRATION-WITHOUT-A-LOCAL-UNIT CASE, WHICH WENT FROM UNSAYABLE TO SAYABLE-AND-DROPPED
// BEFORE IT WAS REFUSED. connectivity_actions_for_observed asks find_local_incarnation_for_slot,
// which searches a dense local prefix bounded by materialized_width_for_host. While the observation
// was synthesized FROM that prefix, every observed slot had a local incarnation by construction and
// an Absent could only mean "healthy, nothing to do". Decoding the roster broke that identity:
// measured, srv4 observed six GitHub registrations against five local incarnations and the fold
// returned ZERO actions -- srv4-06 registered, no local unit, planner silent.
//
// THAT IS STRICTLY WORSE THAN THE GAP IT CAME FROM. A case with no representation is a modeling
// gap; the same case dropped inside a fold is an answer that is wrong, and the fold's own caller
// cannot tell the two apart. The arm refuses now, and this pair is what proves the refusal is about
// the unaccounted registration rather than about the planner disliking every roster.
test fn a_github_registration_with_no_local_incarnation_refuses_instead_of_being_dropped() -> Bool {
  plan_is_refused(
    host: operator_host_srv4,
    width: 5,
    roster: roster_of(names: ["srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05", "srv4-06"]),
  )
}

test fn the_same_roster_within_the_materialized_width_is_not_refused() -> Bool {
  !plan_is_refused(
    host: operator_host_srv4,
    width: 5,
    roster: roster_of(names: ["srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05"]),
  )
}

// THE FOLD COVERS EVERY ENROLLED HOST, NOT A HAND LIST. A fifth enrolled fixture host would
// appear in the plan without any code change to the planner: the fold iterates
// runner_executor_hosts(), and every host in that population gets either a plan entry or a
// typed refusal. This witness proves the structural property by checking that the plan's
// hosts + refusals cover the full runner-executor population.
test fn plan_covers_all_runner_executor_hosts_not_just_a_fixed_pair() -> Bool {
  let plan = runner_capacity_plan(
    roster: incident_2026_08_06_managed_roster_fixture(),
    receipt_for: _ => ReceiptAbsent,
  )
  match plan {
    PlanReady { hosts: hs, refusals: rs } =>
      fold(
        runner_executor_hosts(),
        init: true,
        f: (acc, h) =>
          acc && fold(
            concat(
              map(hs, p => p.host as String),
              flat_map(rs, r => match r {
                HostCapacityPlanRefused { host: rh, reason: _ } => [rh as String]
                HostCapacityPlanReady { plan: _ } => []
              }),
            ),
            init: false,
            f: (found, name) => found || name == (h as String),
          ),
      )
    PlanRefused { reason: _ } => false
  }
}
