module test.claim.runner.runner_host_baked_release_build_wet_witness

import std.types { Bool, NonEmptyStr, String, List, CommitSha }
import std.optional { Optional, Present, Absent }
import std.algebra { trim, list_map }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.gnu_coreutils { mktemp_directory_command, mkdir_parents_command, ln_symbolic_force_command, cp_command, rm_recursive_force_command, ls_one_per_line_command }
import extdeps.tools.tar { tar_list_sizes_command }
import gunbc.host_command_binding { LocalCommandHost, HostCommandOutcome, HostCommandDone, host_command }
import gunbc.host.host_effect { LocalShell }
import gunbc.host.host_effect_realize {
  tree_install_in_realm, TreeInstallStaged, TreeInstallElevated, ApprovalBrokerTreeInstallVerdict, TreeInstallRefused, TreeInstallConverged,
  TreeStepInstallDirectory, one_transport_route, tree_install_realm_admits,
  observe_tree_entry_metadata, TreeMetadataObserved, TreeMetadataObservationFailed, TreeMetadataEntry,
  tree_installed_expectation, tree_metadata_lines, tree_archive_member_of_line, TreeArchiveMemberRead, TreeArchiveMemberUnread,
}
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission, approval_broker_helper_root_principal, release_locus_tree_subdirs }
import gunbc.runner.runner_host_medium { runner_host_baked_release_name }
import gunbc.runner.runner_host_medium_publish {
  BakedReleaseBuildPlan, BakedReleaseBuild, BakedReleaseBuilt, BakedReleaseNotBuilt, baked_release_build_over, baked_release_staged_locus,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE BAKED RELEASE BUILD AT ITS REAL PRODUCER (gunbc.runner.runner_host_medium_publish baked_release_build_over): the
// staged tree install, the reproducible pack, the archive readback, the local measurement and the export host's
// readback all run for real here, over this host's own processes, against a small source tree this witness writes.
// The one supplied value is the COPY: the wet path copies with scp over the fleet context
// (gunbc.fleet.fleet_known_hosts_anchor fleet_scp_upload_command), which needs a fleet host; here the export host is
// this host and the copy is cp, so the readback that follows the copy is still the export host's own sha256sum.
//
// WET: every claim makes a mktemp directory, writes a source tree into it and runs real processes there (install,
// cp, tar, sha256sum) through gunbc.host_command_binding host_command over LocalCommandHost, the route the publish
// itself stages through. That route reaches shell RunArgvOutcome, which has no mock_response, so the hermetic
// envelope refuses these claims. They are excluded from discovery (gunbc.ci.ci_layer_roots) and scheduled in
// v2.workflow.local_repo_wet_terminal local_repo_wet_schedule. No network, no remote host, no sudo, nothing outside
// the directory each claim created and removes. The archive readback's REDs over supplied listings are hermetic and
// live in test.claim.runner.runner_host_baked_release_build_witness.

data revision: CommitSha = "0123456789abcdef0123456789abcdef01234567"

// A FRESH DIRECTORY FOR ONE CLAIM (mktemp -d), or "" when none was made -- every claim below then fails on its first
// read rather than writing somewhere shared.
fn fresh_dir() -> String {
  match host_command(host: LocalCommandHost, command: mktemp_directory_command(template: "/tmp/gunbc-baked-release-witness.XXXXXXXX")) {
    HostCommandDone { stdout: out } => trim(s: out)
    _ => ""
  }
}

fn done(o: HostCommandOutcome) -> Bool {
  match o {
    HostCommandDone { stdout: _ } => true
    _ => false
  }
}

// THE SOURCE MANIFEST: two corpus files (one a directory down), a symbolic link among them, a src/v2 file, and the
// release binary where cargo puts it. Written with the modes this host's umask gives, which the install normalizes.
fn write_source(root: String) -> Bool {
  done(o: host_command(host: LocalCommandHost, command: mkdir_parents_command(path: concat(root, "/dag/sub"))))
    && done(o: host_command(host: LocalCommandHost, command: mkdir_parents_command(path: concat(root, "/src/v2"))))
    && done(o: host_command(host: LocalCommandHost, command: mkdir_parents_command(path: concat(root, "/target/release"))))
    && Filesystem.Write(path: concat(root, "/dag/a.dag"), content: "module a\n").success
    && Filesystem.Write(path: concat(root, "/dag/sub/b.dag"), content: "module sub.b\n").success
    && Filesystem.Write(path: concat(root, "/src/v2/c.dag"), content: "module v2.c\n").success
    && Filesystem.Write(path: concat(root, "/target/release/gunbc"), content: "not really an aarch64 binary\n").success
    && done(o: host_command(host: LocalCommandHost, command: ln_symbolic_force_command(target: "a.dag", link_name: concat(root, "/dag/link"))))
}

fn plan_in(dir: String) -> BakedReleaseBuildPlan {
  BakedReleaseBuildPlan {
    revision: revision,
    source_root: concat(dir, "/src"),
    stage_root: concat(dir, "/stage") as NonEmptyStr,
    archive: concat(dir, "/release.tar") as NonEmptyStr,
  }
}

fn cp_copy() -> fn(NonEmptyStr, NonEmptyStr) -> HostCommandOutcome {
  (local, remote) => host_command(host: LocalCommandHost, command: cp_command(source: local as String, destination: remote as String))
}

fn build_in(dir: String, copy: fn(NonEmptyStr, NonEmptyStr) -> HostCommandOutcome) -> BakedReleaseBuild {
  if dir == "" || !write_source(root: concat(dir, "/src")) || !done(o: host_command(host: LocalCommandHost, command: mkdir_parents_command(path: concat(dir, "/export")))) {
    BakedReleaseNotBuilt { reason: "the witness could not write its source tree" }
  } else {
    baked_release_build_over(plan: plan_in(dir: dir), export_host: LocalCommandHost, export_dir: concat(dir, "/export") as NonEmptyStr, copy: copy)
  }
}

fn cleanup(dir: String) -> Bool {
  dir == "" || done(o: host_command(host: LocalCommandHost, command: rm_recursive_force_command(path: dir)))
}

// POSITIVE CONTROL, THE WHOLE ROUTE: the staged install converges with no elevation, the archive declares the
// elevated install's tree (else the pack refuses), the copy lands in the export directory under the release's
// revision-derived name, and the export host's sha256 of it equals the packed digest -- so the build is
// BakedReleaseBuilt, naming that copy as the staged path the image reads.
test fn the_baked_release_is_staged_unelevated_packed_and_read_back_on_the_export_host() -> Bool {
  let dir = fresh_dir()
  let ok = match build_in(dir: dir, copy: cp_copy()) {
    BakedReleaseBuilt { baked: b } =>
      (b.staged_path as String) == join([dir, "/export/", runner_host_baked_release_name(revision: revision) as String], "")
        && (b.revision as String) == (revision as String)
        && string_length(s: b.digest.hex as String) == 64
    BakedReleaseNotBuilt { reason: _r } => false
  }
  ok && cleanup(dir: dir)
}

// CONDITION 2 (merry-fox-82, decision B): THE EXTRACTED TREE'S OWNER AND MODES EQUAL WHAT THE SUDO INSTALL WOULD HAVE
// PRODUCED, FOR THE SAME MANIFEST. The source's own entries are read; the elevated install's expectation over them,
// under root, is tree_installed_expectation (the function the sudo install's readback and receipt use). The archive
// the build produced is listed -- what a root extract restores -- and its members under the tree subdirectories, read
// as entries, carry exactly those lines: same kinds, link targets, modes, and owner, and every member is 0/0.
// RED control: pack without --owner=0/--group=0 (or install with -m 0664) and the lines differ.
test fn the_archive_carries_the_elevated_install_tree_for_the_same_manifest() -> Bool {
  let dir = fresh_dir()
  let built = build_in(dir: dir, copy: cp_copy())
  let route = one_transport_route(transport: LocalShell)
  let ok = match built {
    BakedReleaseNotBuilt { reason: _r } => false
    BakedReleaseBuilt { baked: _b } =>
      match observe_tree_entry_metadata(root: concat(dir, "/src"), subs: release_locus_tree_subdirs, transport: route) {
        TreeMetadataObservationFailed { reason: _r } => false
        TreeMetadataObserved { entries: manifest } =>
          match tree_installed_expectation(entries: manifest, owner: approval_broker_helper_root_principal) {
            Absent => false
            Present { value: elevated } =>
              match host_command(host: LocalCommandHost, command: tar_list_sizes_command(archive: concat(dir, "/release.tar"))) {
                HostCommandDone { stdout: listing } => {
                  let members = archive_tree_members(listing: listing)
                  count(members) == count(manifest)
                    && tree_metadata_lines(entries: members) == tree_metadata_lines(entries: elevated)
                    && string_contains(s: tree_metadata_lines(entries: members), pattern: "dag/link|l|0777|root|root|a.dag")
                    && string_contains(s: tree_metadata_lines(entries: members), pattern: "dag/sub|d|0755|root|root")
                    && string_contains(s: tree_metadata_lines(entries: members), pattern: "src/v2/c.dag|f|0644|root|root")
                    && all(filter(split(s: listing, delimiter: "\n"), l => trim(s: l) != ""), l => string_contains(s: l, pattern: " 0/0 "))
                }
                _ => false
              }
          }
      }
  }
  ok && cleanup(dir: dir)
}

fn archive_tree_members(listing: String) -> List<TreeMetadataEntry> {
  fold(filter(split(s: listing, delimiter: "\n"), l => trim(s: l) != ""), init: [], f: (acc, l) =>
    match tree_archive_member_of_line(line: l, archive_owner: approval_broker_helper_root_principal) {
      TreeArchiveMemberRead { entry: e, owner_ids: _ids } => if any(release_locus_tree_subdirs, sub => starts_with(s: e.path, prefix: concat(sub, "/"))) { acc.append(e) } else { acc }
      TreeArchiveMemberUnread { line: _l } => acc
    })
}

// CONDITION 3, RED: THE STAGED ROUTE REFUSES A TARGET OUTSIDE ITS STAGING ROOT. The real install is asked to stage
// into a spine beside its root; it refuses at the first directory write, naming the path, and that directory was
// never created (the refusal is before the write, not a failed write). The confinement itself: the root and paths
// beneath it are admitted; a sibling sharing the root as a text prefix, a `..` climb, and an absolute elsewhere are not.
test fn the_staged_route_refuses_a_target_outside_its_staging_root() -> Bool {
  let dir = fresh_dir()
  let wrote = dir != "" && write_source(root: concat(dir, "/src"))
  let realm = TreeInstallStaged { staging_root: concat(dir, "/stage") as NonEmptyStr, archive_owner: approval_broker_helper_root_principal }
  let refused = match tree_install_in_realm(
    realm: realm,
    spine: [concat(dir, "/elsewhere")],
    locus: concat(dir, "/elsewhere/release"),
    source_root: concat(dir, "/src"),
    revision: RevisionBoundAtEmission { revision: revision },
    executables: ["gunbc"],
    transport: one_transport_route(transport: LocalShell),
  ) {
    TreeInstallRefused { step: s, reason: r } =>
      s == TreeStepInstallDirectory && string_contains(s: r, pattern: concat(dir, "/elsewhere")) && string_contains(s: r, pattern: "outside the staging root")
    TreeInstallConverged { installed_digest: _d, files_installed: _n } => false
  }
  let never_created = !done(o: host_command(host: LocalCommandHost, command: ls_one_per_line_command(path: concat(dir, "/elsewhere"))))
  let confined = tree_install_realm_admits(realm: realm, path: concat(dir, "/stage"))
    && tree_install_realm_admits(realm: realm, path: concat(dir, "/stage/release/dag/a.dag"))
    && !tree_install_realm_admits(realm: realm, path: concat(dir, "/stage-sibling/x"))
    && !tree_install_realm_admits(realm: realm, path: concat(dir, "/stage/../elsewhere"))
    && !tree_install_realm_admits(realm: realm, path: "/etc/sudoers.d/x")
    && tree_install_realm_admits(realm: TreeInstallElevated { owner: "gunbc" as NonEmptyStr }, path: "/opt/gunbc/releases/x")
  let ok = wrote && refused && never_created && confined
  ok && cleanup(dir: dir)
}

// CONDITION 5, RED: THE EXPORT HOST'S READBACK IS WHAT ADMITS THE COPY. A copy that reports success but lands other
// bytes (here: the source binary instead of the archive) is read back on the export host, differs from the packed
// digest, and nothing is built.
test fn a_copy_whose_bytes_differ_on_the_export_host_builds_nothing() -> Bool {
  let dir = fresh_dir()
  let wrong = (local, remote) => host_command(host: LocalCommandHost, command: cp_command(source: concat(dir, "/src/target/release/gunbc"), destination: remote as String))
  let ok = match build_in(dir: dir, copy: wrong) {
    BakedReleaseNotBuilt { reason: r } => string_contains(s: r, pattern: "reads back as") && string_contains(s: r, pattern: "not the packed")
    BakedReleaseBuilt { baked: _b } => false
  }
  ok && cleanup(dir: dir)
}

