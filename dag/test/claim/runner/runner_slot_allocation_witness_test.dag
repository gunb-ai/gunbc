data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE WIDTH IS A RESOLUTION AND THESE ROWS TAKE ITS FAIL-CLOSED SIDE. A row that needs the number
// for a host it knows resolves reaches it through with_derived_width and is FALSE if that host ever
// stops resolving; a row about srv2 asserts the unresolved arm by name. Nothing here turns an
// unresolved width into an Int.
fn with_derived_width(host: HostIdentity, k: fn(Int) -> Bool) -> Bool {
  match gunbc_runner_slots_per_host(host: host) {
    RunnerWidthDerived { slots: w } => k(w)
    RunnerWidthUnresolved { host: _, cause: _ } => false
  }
}

fn width_is_unresolved(host: HostIdentity) -> Bool {
  match gunbc_runner_slots_per_host(host: host) {
    RunnerWidthDerived { slots: _ } => false
    RunnerWidthUnresolved { host: h, cause: c } =>
      (h as String) == (host as String) && string_contains(s: c, pattern: "session reservation is unestablished")
  }
}

fn with_committed_identities(host: HostIdentity, k: fn(List<RunnerSlotIdentity>) -> Bool) -> Bool {
  match committed_slot_identities(host: host) {
    CommittedSlotsEnumerated { identities: ids } => k(ids)
    CommittedSlotsUnresolved { host: _, cause: _ } => false
  }
}

fn standing_host(standing: HostRunnerSlotAllocationStanding) -> HostIdentity {
  match standing {
    HostRunnerSlotAllocated { allocation: a } => a.host
    HostRunnerSlotAllocationUnresolved { host: h, cause: _ } => h
  }
}

test fn runner_slot_allocation_wall_holds() -> Bool {
  gunbc_runner_slot_allocation_wall_holds()
}

// THE BOUNDARY IS EXACT ON EVERY ALLOCATED ROW, AND THE UNRESOLVED ROW IS NOT SKIPPED -- IT IS
// ASSERTED TO BE srv2. A fold that answered true for unresolved rows without naming them would let
// a second host go unresolved and this row stay green over one fewer boundary than it claims.
test fn runner_slot_allocation_oversubscription_boundary_exact() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  all(
    gunbc_committed_runner_slot_allocations(),
    standing =>
      match standing {
        HostRunnerSlotAllocationUnresolved { host: h, cause: _ } => (h as String) == (operator_host_srv2 as String)
        HostRunnerSlotAllocated { allocation: a } =>
          gunbc_runner_slot_oversubscription_within_slice(
            slots: a.slots_per_host,
            per_slot: per_slot.memory_max,
            slice_cap: gunbc_runner_slice_cap_for_width(slots: a.slots_per_host)
          )
      }
  )
}

fn committed_allocation_for(host: HostIdentity) -> Int {
  fold(
    gunbc_committed_runner_slot_allocations(),
    init: 0,
    f: (n, a) => if (standing_host(standing: a) as String) == (host as String) { n + 1 } else { n }
  )
}

test fn runner_slot_allocation_committed_hosts_cover_the_fleet_exactly_once() -> Bool {
  committed_allocation_for(host: operator_host_srv1) == 1
    && committed_allocation_for(host: operator_host_srv2) == 1
    && committed_allocation_for(host: operator_host_srv3) == 1
    && committed_allocation_for(host: operator_host_srv4) == 1
    && committed_allocation_for(host: "srv-does-not-exist") == 0
}

// MEMORY ADMISSIONS AND COMMITTED WIDTHS ARE PINNED SEPARATELY, AND AS OF 2026-08-23 THEY FINALLY
// DISAGREE. The two rows below asserted the same four numbers twice for this module's entire
// history, because memory bound every host and the minimum had nothing else to choose from. That
// made the separation look like ceremony. It was not: the 2026-08-22 DIMM upgrade plus the CPU axis
// separated them, and the host-keyed session reservation then separated them further -- memory
// admission now reads 25 on srv1, 29 on srv3 and srv4, and NO WIDTH AT ALL on srv2, whose session
// denominator is unestablished so its axis is AxisUnmeasured rather than a number, while committed
// width is 21/5/21/21, and a single row pinning only one of them would now be silently blind to the
// other.
//
// WHICH IS THE POINT THIS PAIR WAS MAKING ALL ALONG. Asserting only committed width would miss a
// reintroduced disk pin or a memory regression hidden behind a CPU ceiling; asserting only memory
// admission would miss provisioning that skips the apply gate. srv4's historical disk row-pin stays
// retired and disk binding stays at apply-time gunbc.runner_lifecycle runner_width_disk_preflight.

// srv1 MOVED 27 -> 25 AND srv2 NO LONGER STATES A MEMORY ADMISSION AT ALL. The first is the
// synchronization of a derived literal after its input changed: srv1's ungrounded 20 GiB fleet-wide
// session figure was replaced by an evidence-backed 52 GiB allowance, which removes three slots.
// The second is the larger change -- srv2's session denominator is unestablished, so the memory
// subtraction cannot run, and its axis is AxisUnmeasured rather than a number. Its committed width
// is RunnerWidthUnresolved, asserted below on its own terms.
test fn runner_slot_allocation_memory_admissions_differ_by_host_class() -> Bool {
  host_memory_admitted_width(host: operator_host_srv1) == 15
    && host_memory_admitted_width(host: operator_host_srv3) == 17
    && host_memory_admitted_width(host: operator_host_srv4) == 17
    && !host_memory_width_is_established(host: operator_host_srv2)
}

// THE HOLD IS GONE, AND WHAT STANDS IN ITS PLACE IS A TYPED UNRESOLVED WIDTH, NOT A ZERO. This row
// read `no_host_bypasses_derivation_with_a_held_width` and asserted host_held_runner_width answered
// none on three hosts; that function is deleted (a decoration that could only ever answer none),
// so the row now asserts the fact the hold's deletion was FOR: srv2's width resolves to
// RunnerWidthUnresolved carrying the session reservation's own cause, and no other fleet host does.
//
// THE OLD FORM OF THIS FACT WAS `gunbc_runner_slots_per_host(srv2) == 0`, asserted in
// runner_slot_allocation_committed_widths_are_the_minimum_over_axes below -- a witness that pinned
// the conflation this change removes as though it were the intended behaviour. Unknown and zero
// are different facts; a zero here would now be a slot shape admitting nothing, which is not srv2's
// situation, and a row asserting it would be asserting the wrong cause.
test fn srv2_width_is_unresolved_with_its_cause_and_no_other_host_is() -> Bool {
  width_is_unresolved(host: operator_host_srv2)
    && !width_is_unresolved(host: operator_host_srv1)
    && !width_is_unresolved(host: operator_host_srv3)
    && !width_is_unresolved(host: operator_host_srv4)
}

// THE ALLOCATION ROW FOR THE UNRESOLVED HOST IS THE UNRESOLVED STANDING, so no HostRunnerSlotAllocation
// with slots_per_host 0 exists anywhere in the roster for a consumer to read as a real allocation.
test fn srv2_allocation_row_is_the_unresolved_standing_not_a_zero_record() -> Bool {
  all(
    gunbc_committed_runner_slot_allocations(),
    standing =>
      match standing {
        HostRunnerSlotAllocationUnresolved { host: h, cause: _ } => (h as String) == (operator_host_srv2 as String)
        HostRunnerSlotAllocated { allocation: a } =>
          (a.host as String) != (operator_host_srv2 as String) && a.slots_per_host > 0
      }
  )
}

// RENAMED 2026-08-23, because the old name asserted the very thing that stopped being true.
// runner_slot_allocation_committed_widths_MATCH_MEMORY_ADMISSION was an accurate description of a
// coincidence -- memory was the binding axis on every host, so committed equalled admitted -- and
// a name that states a coincidence as a law is how the next reader learns the wrong invariant.
// Committed width is the MINIMUM over memory, CPU and disk wherever it is DERIVED.
//
// srv2 IS DELIBERATELY NOT HELD TO THAT LAW, AND THE CONJUNCT ASSERTING IT WAS DELETED RATHER THAN
// RETUNED. It read `committed == host_memory_admitted_width(srv2)`, which related srv2's width to a
// subtraction the model now says CANNOT RUN on that host -- so whatever number came back was not a
// fact about anything, and the conjunct would have gone green or red for reasons unconnected to the
// property under test. An assertion whose oracle is an unestablished derivation is worse than a
// missing one, because it reads as coverage. srv2's width is asserted on its own terms, as a hold,
// by srv2_width_is_held_rather_than_derived above.
//
// MEMORY BINDS AGAIN AS OF 2026-09-19, AND THIS TIME BY POLICY RATHER THAN COINCIDENCE. From
// 2026-08-23 to 2026-09-19 cores_per_slot was DERIVED from the slot's memory ceiling against a
// vendor memory-per-vCPU ratio, so raising memory 16 -> 26 GiB took cores_per_slot 6 -> 10 and the
// CPU axis 21 -> 12, binding every host at 12 -- a coupling this witness caught when a draft
// claimed 15/17/17. The operator ruling of 2026-09-19 ("there is no CPU demand - the processes we
// run are single core") replaced the derivation with an authored policy of 1
// (gunbc_runner_cores_per_slot_policy): the CPU axis admits 128 on every M128-30 host and cannot
// bind below memory on any host in this fleet, so the committed widths are the memory admissions
// 15 and 17. The equality conjuncts below are the RED for the coupling coming back: a
// cores_per_slot re-derived from memory_max would drop these widths below memory admission and
// fail the `== host_memory_admitted_width` clauses, and the CPU clause pins the axis at the
// cited core count so a policy above 1 is a visible edit here rather than a silent narrowing.
//
// srv2 IS NOT IN THIS ROW AS A NUMBER ANY MORE. It read `== 0`, which asserted the Int conflation of
// unknown with zero as a pinned fact; its standing is asserted by
// srv2_width_is_unresolved_with_its_cause_and_no_other_host_is on its own terms.
test fn runner_slot_allocation_committed_widths_are_the_minimum_over_axes() -> Bool {
  with_derived_width(host: operator_host_srv1, k: w1 =>
    with_derived_width(host: operator_host_srv3, k: w3 =>
      with_derived_width(host: operator_host_srv4, k: w4 =>
        w1 == 15
          && w3 == 17
          && w4 == 17
          && w1 == host_memory_admitted_width(host: operator_host_srv1)
          && w3 == host_memory_admitted_width(host: operator_host_srv3)
          && w4 == host_memory_admitted_width(host: operator_host_srv4)
          && host_cpu_admitted_width(host: operator_host_srv1) == 128
          && host_cpu_admitted_width(host: operator_host_srv3) > host_memory_admitted_width(host: operator_host_srv3))))
}

test fn runner_slot_allocation_srv4_disk_unconstrained_at_allocation() -> Bool {
  match host_disk_admitted_width(host: operator_host_srv4) {
    DiskWidthUnconstrained { reason: r } => string_contains(s: r, pattern: "runner_width_disk_preflight")
    DiskAdmitsWidth { slots: _, provenance: _ } => false
  }
}

test fn runner_slot_allocation_RED_oversubscription_exceeds_slice() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  all(
    gunbc_committed_runner_slot_allocations(),
    standing =>
      match standing {
        HostRunnerSlotAllocationUnresolved { host: h, cause: _ } => (h as String) == (operator_host_srv2 as String)
        HostRunnerSlotAllocated { allocation: a } =>
          !gunbc_runner_slot_oversubscription_within_slice(
            slots: a.slots_per_host + 1,
            per_slot: per_slot.memory_max,
            slice_cap: a.runner_slice_cap
          )
      }
  )
}

// AN UNKNOWN HOST RESOLVES TO NO WIDTH, NOT TO ZERO. This row asserted `== 0` and a zero-byte slice
// cap for a host that does not exist -- the same conflation as srv2's, on a host nobody committed.
// gunbc.session_reservation_policy joins an unobserved host as if sessions were present and then
// finds no sizing row, so the width is RunnerWidthUnresolved by construction, with no separate
// "not a fleet host" zero to be read as a real width.
test fn runner_slot_allocation_unknown_host_refuses_a_width() -> Bool {
  match gunbc_runner_slots_per_host(host: "srv-does-not-exist") {
    RunnerWidthUnresolved { host: h, cause: _ } => (h as String) == "srv-does-not-exist"
    RunnerWidthDerived { slots: _ } => false
  }
}

