  byte_size_count(b: gunbc_runner_slot_desired().memory_high) > byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
}

test fn runner_slot_allocation_enforcement_expected_cap_is_desired_memory_max() -> Bool {
  byte_size_count(b: gunbc_runner_slot_enforcement_expected_cap()) == byte_size_count(b: gunbc_runner_slot_desired().memory_max)
}

test fn runner_slot_allocation_minimum_viable_armed_budget_wall_holds() -> Bool {
  gunbc_floor_minimum_viable_armed_budget_wall_holds()
}

test fn runner_slot_allocation_minimum_viable_armed_budget_is_12_gib() -> Bool {
  byte_size_count(b: gunbc_floor_minimum_viable_armed_budget_bytes()) == byte_size_count(b: byte_size(12884901888))
}

// SUBJECT B (effective cap on srv2-03): binds 16GiB/15GiB and the declaration now MATCHES it, so
// the 2GiB drift this subject was written for is dissolved (gunbc.runner_slot_allocation
// gunbc_srv2_03_drift_dissolved_by_ruling_note). The witness below asserts the ABSENCE of drift;
// the readback-refusal predicate keeps its discriminating input from
// gunbc_synthetic_drifted_cap_observation instead, deliberately synthetic so no convergence can
// green it. Dissolve-on: post-apply readback replaces gunbc_srv2_03_effective_cap_observation.

// SUBJECT A (declared row): 16GiB/15GiB derives from the 2026-08-17 floor-peak ruling superseding
// the 2026-08-05 calibration (gunbc_runner_slot_memory_max_ruling_note), NOT from srv2-03 live
// readback — that the two now coincide is a coincidence recorded as one in that ruling. This
// witness pins only the declared constants.

// SUBJECT C (refusal): gunbc_runner_slot_allocation_refuses_effective_readback_reconciliation is
// the structural predicate — effective readback must not become declaration authority when drift
// exists. Its discriminating input is now gunbc_synthetic_drifted_cap_observation, srv2-03 having
// stopped drifting; a synthetic fixture is used precisely so that a future converge cannot silently
// retire this predicate's only witness.

// SUBJECT D (converge consequence): ANSWERED, not pending. Modeled-budget compliance under the
// superseded 14GiB/13GiB row is now MEASURED and it failed — an uncensored 15509315584-byte floor
// peak above that max, plus srv1 pinned at exactly 13.00GiB with 829 and 44803 memory.high events
// once it was actually converged there. The floor cgroup leaf events at T5 entry remain zero as the
// baseline they always were, and srv2-03 has no envelope left to enforce because the declaration
// moved to meet it. Superseded detail retained: converge would first enforce the modeled envelope
// against the CI floor consumer (gunbc_srv2_03_converge_floor_fit_note). No OOM outcome and no
// floor byte figure are asserted.

// RENAMED AND RE-PINNED 2026-09-12 to the row it now guards. The 16/15 pair it named was the
// 2026-08-17 ruling's, and every reading behind that ruling was a THROTTLE PIN -- a peak landing
// on the MemoryHigh line, which that ruling itself called a censored lower bound. The 26/25 pair
// derives from the first UNCENSORED floor-lane measurement (`high=max`, stall 0 faults/min), so
// this witness pins a demand rather than the last place a pin happened to land.
test fn witness_declared_row_pins_26_25_gib_from_floor_demand_ruling() -> Bool {
  byte_size_count(b: gunbc_runner_slot_desired().memory_max) == byte_size_count(b: byte_size(27917287424))
    && byte_size_count(b: gunbc_runner_slot_desired().memory_high) == byte_size_count(b: byte_size(26843545600))
}

test fn witness_declared_high_clears_measured_floor_peak() -> Bool {
  byte_size_count(b: gunbc_runner_slot_desired().memory_high)
    >= byte_size_count(b: gunbc_floor_measured_peak_observation)
}

test fn witness_floor_peak_input_is_uncensored_not_a_throttle_pin() -> Bool {
  gunbc_floor_measured_peak_is_uncensored()
}

test fn witness_RED_binary_unit_reading_would_exceed_the_armed_line() -> Bool {
  byte_size_count(b: byte_size(16750372454)) > byte_size_count(b: gunbc_floor_measured_peak_armed_high)
}

// RENAMED 2026-09-12, AND THE RENAME IS THE POINT RATHER THAN BOOKKEEPING. The old name --
// `..._no_longer_drifts_after_ruling` -- was true only because the 2026-08-17 ruling had moved the
// DECLARATION to meet what srv2-03 was already running. The 2026-09-12 demand ruling moves the
// declaration to 26/25 while the fleet still runs 16/15, so the observation drifts again, and it
// SHOULD: a declaration ahead of the hosts is exactly what drift means, and this witness is where
// the model says so out loud.
//
// THAT IS THE DRAIN-BEFORE-RAISE ORDERING SURFACING STRUCTURALLY. Nothing here is broken and
// nothing should be "fixed" by editing the observation: `gunbc_srv2_03_effective_cap_observation`
// is a MEASURED READBACK of a live host, and
// `gunbc_runner_slot_allocation_refuses_effective_readback_reconciliation` forbids reconciling a
// declaration toward a readback precisely so that this gap stays visible until a converge closes
// it. The witness therefore asserts the observation's own bytes unchanged and asserts that drift
// IS detected, which is the true state between the ruling and the rollout.
test fn witness_srv2_03_observation_drifts_until_the_fleet_is_converged() -> Bool {
  match gunbc_srv2_03_effective_cap_observation {
    RunnerSlotEffectiveCapMeasured { runner_unit: unit, memory_max: max, memory_high: high, probed_at: _ } =>
      unit == "actions-runner@srv2-03.service"
        && byte_size_count(b: max) == byte_size_count(b: byte_size(17179869184))
        && byte_size_count(b: high) == byte_size_count(b: byte_size(16106127360))
        && runner_slot_effective_memory_max_drifts_from_declaration(effective: max)
        && runner_slot_effective_memory_high_drifts_from_declaration(effective: high)
    _ => false
  }
}

test fn witness_readback_refusal_stays_witnessed_by_synthetic_drift() -> Bool {
  gunbc_readback_refusal_stays_witnessed_by_synthetic_drift()
}

test fn witness_srv2_03_floor_leaf_cgroup_events_at_entry_are_zero() -> Bool {
  srv2_03_floor_leaf_cgroup_events_at_entry_are_zero()
}

test fn witness_srv2_03_RED_converged_cap_would_not_refuse_readback_reconciliation() -> Bool {
  !gunbc_runner_slot_allocation_refuses_effective_readback_reconciliation(
    obs: RunnerSlotEffectiveCapMeasured {
      runner_unit: "actions-runner@srv2-03.service",
      memory_max: gunbc_runner_slot_desired().memory_max,
      memory_high: gunbc_runner_slot_desired().memory_high,
      probed_at: "synthetic-converged-control",
    }
  )
}

fn membership_is_fabric(m: RunnerSlotMembership) -> Bool {
  match m {
    SlotOutsideCommittedPopulation { identity: _, committed_width: _ } => false
    SlotMembershipUnresolved { identity: _, cause: _ } => false
    CommittedSlotMember { identity: _, purpose: p } =>
      match p {
        SlotServesFabricExecution => true
        SlotServesGitHubActions => false
      }
  }
}

fn membership_is_outside(m: RunnerSlotMembership) -> Bool {
  match m {
    SlotOutsideCommittedPopulation { identity: _, committed_width: _ } => true
    SlotMembershipUnresolved { identity: _, cause: _ } => false
    CommittedSlotMember { identity: _, purpose: _ } => false
  }
}

// THE TWO SLOT POPULATIONS ARE DISJOINT BY CONSTRUCTION, AND THIS WITNESS IS WHAT KEEPS THAT
// CLAIM HONEST RATHER THAN DECORATIVE. runner_slot_purpose is total over a host's index range and
// returns exactly one variant, so a slot cannot be a member of both populations -- there is no
// state in which GitHub believes srv3-06 is an idle registered runner while the fabric believes
// it is an available SupplierOffer member, which is the double-allocation this partition exists to make
// unwritable (two processes inside one 16GiB entitlement).
//
// THE SUMMANDS MUST ADD UP OR THE PARTITION IS NOT ONE. If github + fabric ever drifted from the
// committed width, some slot would be in neither population or counted twice, and the arithmetic
// below is the only thing standing between "purpose is a partition" and "purpose is a label."
//
// srv2 IS OUT OF THE PARTITION ROW AND INTO THE UNRESOLVED ROW: a partition of an unenumerated
// population is not a partition, and the old form asserted 0 + 0 == 0 over it.
fn partition_holds_on(host: HostIdentity) -> Bool {
  with_derived_width(host: host, k: w =>
    with_committed_identities(host: host, k: ids =>
      github_slot_count(identities: ids) + count_fabric_members(identities: ids) == w))
}

test fn slot_purposes_partition_every_host_committed_width() -> Bool {
  partition_holds_on(host: operator_host_srv1)
    && partition_holds_on(host: operator_host_srv3)
    && partition_holds_on(host: operator_host_srv4)
    && match committed_slot_identities(host: operator_host_srv2) {
      CommittedSlotsUnresolved { host: _, cause: _ } => true
      CommittedSlotsEnumerated { identities: _ } => false
    }
}

// THE CANARY SLOT IS srv3-06 AND NOTHING ELSE IS FABRIC (operator, 2026-08-21). srv4-06 is the
// discriminating control and it is the whole point of the row: it is the SAME index on a host of
// the SAME committed width, and it is a GitHub slot. So the partition is keyed on the host's
// authored fabric count, not on the number 6 -- an implementation that special-cased the top index
// fleet-wide would pass the srv3 assertion and fail here.
// AN IDENTITY THAT IS NOT A COMMITTED SLOT IS NOT A FABRIC SLOT, AND THIS ROW EXISTS BECAUSE THE
// FIRST VERSION SAID IT WAS. Purpose was derived by comparing the index against a count, so any
// index above the GitHub ceiling answered "fabric" -- measured, srv1-06 and srv3-99 both did, though
// srv1 is five wide and neither is a member of anything. Membership now precedes purpose and those
// identities are refused with the width they were measured against.
// THE OUT-OF-RANGE INDEX IS DERIVED, BECAUSE WRITING ONE DOWN IS HOW THIS ROW STOPPED CHECKING.
//
// It read slot 6 on srv1 and slot 7 on srv3. Both WERE outside the committed population -- at the
// widths of the day, five and six. The 2026-08-23 CPU-axis change moved both hosts to twenty-one,
// so both indices became ordinary committed members, the refusal correctly did not fire, and the
// row went red. Nothing about the property it names had changed.
//
// Retyping 7 as 22 would re-arm exactly the same landmine one width later. A fixture that picks an
// out-of-range index by writing down a number that happens to be out of range TODAY is a change
// detector wearing a property's name (DESIGN section 5: a measurement copied from the same current
// tree is not an oracle). Deriving committed + 1 makes the fixture discriminating at ANY width,
// which is what it was always trying to say.
//
// The two clauses that did NOT need touching are the informative ones. srv3-99 stays outside at any
// plausible width, and srv3-06 stays INSIDE and stays fabric, because runner_slot_allocation
// AUTHORS that identity rather than deriving it from a count -- the defence in
// the_fabric_member_is_an_authored_identity_not_a_top_index_rule, observed working through a real
// width change rather than only asserted.
test fn an_identity_outside_the_committed_population_is_refused_not_classified() -> Bool {
  with_derived_width(host: operator_host_srv1, k: w1 =>
    with_derived_width(host: operator_host_srv3, k: w3 =>
      membership_is_outside(m: runner_slot_membership(host: operator_host_srv1, slot_index: w1 + 1))
        && membership_is_outside(m: runner_slot_membership(host: operator_host_srv3, slot_index: 99))
        && membership_is_outside(m: runner_slot_membership(host: operator_host_srv3, slot_index: w3 + 1))
        && !membership_is_outside(m: runner_slot_membership(host: operator_host_srv3, slot_index: 6))
        && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv1, slot_index: w1 + 1))))
}

// AN IDENTITY ON AN UNRESOLVED HOST IS NEITHER A MEMBER NOR OUTSIDE -- IT IS UNDECIDED, WITH THE
// CAUSE. Until this arm existed srv2-01 answered SlotOutsideCommittedPopulation { committed_width: 0 },
// which every consumer read as "srv2 committed no slots": the planner's foreign refusal, the census's
// retiring classification and the build-cache observer's RetiredRunnerSlot all came from here.
test fn an_identity_on_an_unresolved_host_is_undecided_not_outside() -> Bool {
  match runner_slot_membership(host: operator_host_srv2, slot_index: 1) {
    SlotMembershipUnresolved { identity: id, cause: c } =>
      (id.host as String) == (operator_host_srv2 as String)
        && id.slot_index == 1
        && string_contains(s: c, pattern: "session reservation is unestablished")
    SlotOutsideCommittedPopulation { identity: _, committed_width: _ } => false
    CommittedSlotMember { identity: _, purpose: _ } => false
  }
}

// THE FABRIC MEMBER IS AN EXACT IDENTITY AND DOES NOT MOVE WITH THE WIDTH. The carve is authored as
// srv3-06 rather than derived as "the top index", so the counts below are projections of it. If
// this ever regresses to index arithmetic, a width change would silently relabel a slot that may be
// running work -- which is why the identity is asserted directly here and not just its count.
test fn the_fabric_member_is_an_authored_identity_not_a_top_index_rule() -> Bool {
  srv3_fabric_canary_slot().slot_index == 6
    && (srv3_fabric_canary_slot().host as String) == (operator_host_srv3 as String)
    && with_committed_identities(host: operator_host_srv3, k: ids => count_fabric_members(identities: ids) == 1)
    && with_committed_identities(host: operator_host_srv4, k: ids => count_fabric_members(identities: ids) == 0)
}

test fn srv3_slot_six_is_the_only_fabric_slot_in_the_fleet() -> Bool {
  membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 6))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv4, slot_index: 6))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 5))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv1, slot_index: 5))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv2, slot_index: 5))
}

// THE FIVE LIVE srv3 RUNNERS KEEP THEIR IDENTITIES. Fabric slots are taken from the TOP of the
// index range, so srv3-01..05 -- the five registered runners that exist today -- are all still
// GitHub slots and none is renamed or deregistered to pay for the canary. Taking the fabric slot
// from the bottom would have renumbered every live runner on the host, and this row goes red if
// anyone reverses that direction.
// THE GITHUB COUNT IS THE COMMITTED WIDTH LESS THE FABRIC MEMBERS, NOT THE NUMBER FIVE.
//
// This row pinned 5, which was srv3's six committed slots less its one fabric member. At width
// twenty-one the same relation yields twenty, so the literal went red while the property -- that
// carving out srv3-06 costs GitHub exactly one slot and takes none of the five that were live --
// held throughout.
//
// Stated as the relation it survives any width, and it still fails if the carve ever starts
// deregistering a live runner: slots one through five are asserted individually, so a fabric role
// that slid onto one of them would be caught here rather than absorbed into a count.
//
// The minus-one is deliberate rather than minus host_fabric_slot_count. Subtracting the measured
// fabric count would make this row true for ANY number of fabric members, including zero, which is
// the general conservation already asserted by
// slot_purposes_partition_every_host_committed_width. THIS row is about the specific
// carve: srv3 gives up exactly one slot to the fabric. Writing it as the general identity would
// leave that claim asserted nowhere.
test fn introducing_the_fabric_slot_deregisters_no_live_runner() -> Bool {
  !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 1))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 2))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 3))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 4))
    && !membership_is_fabric(m: runner_slot_membership(host: operator_host_srv3, slot_index: 5))
    && with_derived_width(host: operator_host_srv3, k: w3 =>
         with_committed_identities(host: operator_host_srv3, k: ids =>
           github_slot_count(identities: ids) == w3 - 1))
}

// THE SLOT ROW DECLARES ONE CORE PER SLOT AND NO CPU CEILING, AND THE TWO ARE NOT ONE FACT. Until
// 2026-09-19 the quota WAS the cores_per_slot, so this row asserted their equality; under the
// ruling a 100% quota at one core per slot would throttle parallel link/codegen, so the quota is
// SlotCpuQuotaUnbounded while cores_per_slot is 1. RED: a quota re-derived from cores_per_slot
// resolves to one thread and fails the first clause; a cores_per_slot policy above 1 fails the
// second.
test fn the_slot_row_declares_one_core_and_no_ceiling() -> Bool {
  match gunbc_runner_slot_desired().cpu_quota {
    CpuQuotaResolved { threads: _ } => false
    SlotCpuQuotaUnbounded => hardware_thread_count_value(t: gunbc_runner_cores_per_slot()) == 1
  }
}
