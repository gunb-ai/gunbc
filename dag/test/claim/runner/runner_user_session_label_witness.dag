module test.claim.runner.runner_user_session_label_witness

// THE CLAIM: the user-session label is granted by the roster AND its receipt, and by nothing else.
//
// gunbc.runner.runner_host_deploy runner_job_user_session_hosts names the converged hosts, and
// gunbc.runner.runner_user_session_receipt runner_user_session_converge_receipt_rows carries what a
// converge run read back for each one -- the composition (gunbc.runner.runner_registration_labels
// gunbc_user_session_label) grants the label only to a host that is BOTH rostered and backed by a
// holding receipt row. The controls drive each channel a label could reach the registration through,
// rather than restating the grant:
//   1. THE GATE -- srv4 registers with it; a host FORGED INTO the roster, with no receipt row, must not.
//      That forged-roster control is what makes the receipt a gate and not a caption: it fails the moment
//      the label is derived from the list alone.
//   2. THE CLASS-ARGUMENT CHANNEL -- runner_registration_labels_of_class takes class_labels from its
//      caller, so a forged argument must not be able to grant the label.
//   3. THE HOST-SPELLABLE PLATFORM HALF -- the composition strips the label from the offer-derived half
//      before re-adding it from the gate (today that half is derived from supply facts with custom: [], so
//      this guards the channel an offer row would open, and the strip is what keeps it closed).
//   4. THE SLOT GRAIN -- the CI slot follows its host's gate, and the deploy slot (a different principal)
//      does not inherit the host's capability.
//   5. THE CONSUMER -- the label's consumer is the runs-on selector of the jobs that run a command under
//      the job account's user manager: gunbc#14972's credential-acquisition rows, realized today by
//      gunbc.runner.runner_user_session runner_user_session_unit_run_command_spec (DESIGN 3c: the frontier
//      is recorded beside the row). The consumer control checks that selector, built the way the emitter
//      builds a host-pinned spec, against what each host's registration actually advertises.
//
// Each control states the mechanism it refuses and what main would answer without the guard. The roster
// and the receipt rows are the fleet's own declarations: these are statements about them, so an edit that
// changed who holds a user session moves them, which is exactly what makes them controls instead of
// tautologies.
//
// A REFUSAL IS NOT AN ABSENCE, AND NO HELPER HIDES ONE. There is no labels_of with a Refused => []
// default: every control matches the RunnerRegistrationLabelsResolution directly, so a host whose facts
// stopped resolving makes that control FALSE rather than vacuously green (reviews 86935 and 87051;
// DESIGN 5: "no plausible output is fabricated" -- a folded-in empty list is exactly the fabricated
// default a later control would inherit).

import std.types { String, Bool, Int, List }
import std.optional { Optional, Present, Absent }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv3, operator_host_srv4 }
import gunbc.runner.runner_registration_labels {
  RunnerRegistrationLabelsResolution, RegistrationLabelsResolved, RegistrationLabelsRefused,
  RunnerUserSessionGrant, RunnerUserSessionGranted, RunnerUserSessionRosteredUnconverged,
  RunnerUserSessionReceiptedUnrostered, RunnerUserSessionUnadmitted,
  runner_user_session_grant_of_roster,
  gunbc_user_session_label, runner_registration_labels, runner_registration_labels_of_class,
  runner_slot_registration_labels, runner_user_session_labels_for, runner_user_session_labels_of_roster,
  runner_user_session_label_stripped,
}
import gunbc.runner.runner_host_deploy { runner_job_user_session_hosts }
import gunbc.runner.runner_user_session_receipt {
  runner_user_session_converge_receipt_for, runner_user_session_converge_receipt_row_holds,
}
import gunbc.runner.runner_slot_job_role { srv1_deploy_slot }
import gunbc.ci.ci_fleet { srv4_offer }
import gunbc.runner.runner_spec_from_offer { runner_spec_from_offer }
import gunbc.runner.runner_slot_allocation { runner_labels_satisfy_selector }
import extdeps.github.workflow_runs { github_workflow_run_id_is_positive }
import extdeps.github.actions { SelfHosted }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn has_label(labels: List<String>) -> Bool {
  any(labels, l => l == gunbc_user_session_label)
}

fn label_count(labels: List<String>) -> Int {
  length(filter(labels, l => l == gunbc_user_session_label))
}

// THE HOST ANSWERED, THEN THE CHECK RUNS. A Refused resolution matches to false in every control below,
// so "the label is absent" is only credited when the host actually resolved and the label genuinely was
// not there.
fn srv4_ci_slot() -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv4, slot_index: 1 }
}

// THE GATE, FROM EVERY SIDE, AS TYPED STATE. srv4 is rostered AND receipted: Granted. The two mismatch
// states are asserted BY NAME, not inferred from an empty list (review 87126): srv1 forged INTO the roster
// (the list a second host would join) is RosteredUnconverged -- no label, and the reason carried; srv4
// dropped FROM the roster but keeping its evidence is ReceiptedUnrostered; srv1 on the real roster is
// Unadmitted. If the grant ever goes back to reading the list alone, or to a bare [], these arms go red.
// The Granted arm is no decoration: a gate that always refused would fail it.
test fn the_grant_states_who_holds_the_label_and_why_the_others_do_not() -> Bool {
  match runner_user_session_grant_of_roster(host: operator_host_srv4, roster: runner_job_user_session_hosts) {
    RunnerUserSessionGranted { row: _ } =>
      match runner_user_session_grant_of_roster(host: operator_host_srv1, roster: concat(runner_job_user_session_hosts, [operator_host_srv1])) {
        RunnerUserSessionRosteredUnconverged { host: forged } =>
          match runner_user_session_grant_of_roster(host: operator_host_srv4, roster: []) {
            RunnerUserSessionReceiptedUnrostered { host: stranded } =>
              match runner_user_session_grant_of_roster(host: operator_host_srv1, roster: runner_job_user_session_hosts) {
                RunnerUserSessionUnadmitted { host: outsider } =>
                  (forged as String) == (operator_host_srv1 as String)
                    && (stranded as String) == (operator_host_srv4 as String)
                    && (outsider as String) == (operator_host_srv1 as String)
                    && runner_user_session_labels_of_roster(host: operator_host_srv4, roster: runner_job_user_session_hosts)
                      == [gunbc_user_session_label]
                    && runner_user_session_labels_of_roster(host: operator_host_srv1, roster: concat(runner_job_user_session_hosts, [operator_host_srv1])) == []
                    && !has_label(labels: runner_user_session_labels_for(host: operator_host_srv1))
                RunnerUserSessionGranted { row: _ } => false
                RunnerUserSessionRosteredUnconverged { host: _ } => false
                RunnerUserSessionReceiptedUnrostered { host: _ } => false
              }
            RunnerUserSessionGranted { row: _ } => false
            RunnerUserSessionRosteredUnconverged { host: _ } => false
            RunnerUserSessionUnadmitted { host: _ } => false
          }
        RunnerUserSessionGranted { row: _ } => false
        RunnerUserSessionReceiptedUnrostered { host: _ } => false
        RunnerUserSessionUnadmitted { host: _ } => false
      }
    RunnerUserSessionRosteredUnconverged { host: _ } => false
    RunnerUserSessionReceiptedUnrostered { host: _ } => false
    RunnerUserSessionUnadmitted { host: _ } => false
  }
}

// THE NEGATIVE CONTROLS: a host that is neither rostered nor receipted gains nothing, and the absence is
// only credited on a RESOLVED registration -- if srv1 or srv3 stopped resolving (its compute offer
// deleted) they would Refuse, and this control goes red. An absence is only allowed to mean "the gate
// does not admit it", never "the host could not answer".
test fn an_unconverged_host_never_gains_the_label() -> Bool {
  match runner_registration_labels(host: operator_host_srv1) {
    RegistrationLabelsResolved { labels: srv1 } =>
      match runner_registration_labels(host: operator_host_srv3) {
        RegistrationLabelsResolved { labels: srv3 } =>
          !has_label(labels: srv1) && !has_label(labels: srv3)
            && runner_user_session_labels_for(host: operator_host_srv1) == []
            && runner_user_session_labels_for(host: operator_host_srv3) == []
        RegistrationLabelsRefused { host: _, cause: _ } => false
      }
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
}

// THE GATE READS THE RECEIPT, NOT A SENTENCE ABOUT IT (DESIGN 4c). srv4's row exists, every reading in
// it holds, and the run it cites is a real positive run id -- that run is fleet-converge 40270496735, the
// evidence the PR body cites. Deleting the row does not just make this control red: the grant then answers
// RosteredUnconverged for srv4 and control 1 goes red with it, which is the difference between a gate and
// a caption (review 87051: two String rows compared to literals showed the strings existed, not that srv4
// is eligible). A row with a failed reading would fail here too -- the readings, not their presence, are
// what holds.
test fn srv4_receipt_row_holds_and_cites_a_positive_run() -> Bool {
  match runner_user_session_converge_receipt_for(host: operator_host_srv4) {
    Present { value: row } =>
      runner_user_session_converge_receipt_row_holds(row: row)
        && github_workflow_run_id_is_positive(id: row.run_id)
    Absent => false
  }
}

// THE GRANT IS EXACTLY ONCE, NOT ACCUMULATED: srv4's set carries the label one time, so the composition
// and a host spelling it for itself cannot stack it.
test fn the_grant_adds_the_label_exactly_once() -> Bool {
  match runner_registration_labels(host: operator_host_srv4) {
    RegistrationLabelsResolved { labels: ls } => label_count(labels: ls) == 1
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
}

// THE CLASS-ARGUMENT CHANNEL REFUSES THE LABEL. runner_registration_labels_of_class accepts class_labels
// from its caller and the role drop-ins pass their own labels through it; without the strip one argument
// carrying the label would hand a host a user session it never converged. A Refused resolution is false
// here too -- an absence proven by silence is not a refusal proven by the strip.
// RED control: main (no strip) unions the forged class label straight into srv1's registration.
test fn a_caller_cannot_grant_the_label_through_the_class_labels_argument() -> Bool {
  match runner_registration_labels_of_class(host: operator_host_srv1, class_labels: [gunbc_user_session_label]) {
    RegistrationLabelsResolved { labels: ls } => !has_label(labels: ls)
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
}

// THE HOST-SPELLABLE PLATFORM HALF REFUSES THE LABEL, AND THE STRIP TARGETS ONLY IT. The composition
// strips the label from the union of the offer-derived platform half and the class half, then re-adds it
// only from the gate. With the label present in the host-spelled input, the stripped output must not carry
// it, and stripping must leave the ordinary labels alone (the strip is targeted, not a ban).
// RED control: a strip that filtered nothing (or dropped every label) fails one arm here.
test fn the_platform_half_cannot_carry_the_label_but_keeps_its_own_labels() -> Bool {
  let forged = ["self-hosted", "linux", "arm64", gunbc_user_session_label]
  let stripped = runner_user_session_label_stripped(labels: forged)
  !has_label(labels: stripped)
    && any(stripped, l => l == "self-hosted")
    && any(stripped, l => l == "arm64")
    && label_count(labels: stripped) == 0
}

// THE STRIP AND THE GRANT COMPOSE: stripping a host-spelled copy and then applying the gate still yields
// the label on a converged host -- so the guard closes the forge without disabling the grant.
test fn the_strip_does_not_disable_the_grant() -> Bool {
  let stripped = runner_user_session_label_stripped(labels: [gunbc_user_session_label])
  !has_label(labels: stripped) && has_label(labels: runner_user_session_labels_for(host: operator_host_srv4))
}

// THE SLOT GRAIN FOLLOWS THE GATE, AT BOTH SIDES OF THE PRINCIPAL LINE. srv4's CI slot registers with the
// label and srv1's deploy slot does not, so a per-slot reader (the JIT mint, the replace postcondition,
// the conformance check's desired set) agrees with the host composition instead of disagreeing by one
// label -- which is what would make the first srv4 replacement read as a divergence -- while the deploy
// slot, a DIFFERENT principal, never inherits the host's capability. That is why the gate sits at the job
// entry and not inside _of_class: gating there would hand the deploy principal a capability it never
// earned. Both resolutions must Resolve; either refusal is a false.
// RED control: if the grant were wired only into the host entry and not the slot composition, srv4's slot
// would lack the label; if the gate moved into _of_class, srv1's deploy slot would carry it.
test fn a_ci_slot_label_set_follows_its_host_gate_and_the_deploy_slot_stays_out() -> Bool {
  match runner_slot_registration_labels(slot: srv4_ci_slot()) {
    RegistrationLabelsResolved { labels: srv4_labels } =>
      match runner_slot_registration_labels(slot: srv1_deploy_slot()) {
        RegistrationLabelsResolved { labels: deploy_labels } =>
          has_label(labels: srv4_labels) && !has_label(labels: deploy_labels)
        RegistrationLabelsRefused { host: _, cause: _ } => false
      }
    RegistrationLabelsRefused { host: _, cause: _ } => false
  }
}

// THE CONSUMER'S runs-on SELECTS ON THE CONSTANT, AND ONLY A GATED REGISTRATION SATISFIES IT. The
// restatement of the constant's definition is gone (it could never go red -- DESIGN 4b's decoration).
// What replaces it checks the label's consumer: the runs-on selector of the jobs that run a command under
// the job account's user manager (gunbc#14972's credential-acquisition rows; realized today by
// runner_user_session_unit_run_command_spec, whose labels a workflow emitter renders into runs-on). The
// selector is built the way the emitter builds a host-pinned CI spec -- the offer's platform labels plus
// the label the job must select on -- and satisfaction is GitHub's rule: every named label must be held
// (gunbc.runner.runner_slot_allocation runner_labels_satisfy_selector models it). srv4's registration
// satisfies it; srv1's registration, which the gate does not admit, does not -- and ONLY when srv1
// resolved: a srv1 that refuses makes this control false, never green (review 87051's arm, guarded by
// matching the resolutions directly).
// RED control: a wrong label on srv4's grant (or a second spelling) breaks the first arm; a label granted
// to a host the gate does not admit breaks the second.
test fn the_consumer_selector_is_satisfied_by_the_gate_and_by_nothing_else() -> Bool {
  match runner_spec_from_offer(offer: srv4_offer) {
    SelfHosted { labels: platform } =>
      match runner_registration_labels(host: operator_host_srv4) {
        RegistrationLabelsResolved { labels: srv4_labels } =>
          match runner_registration_labels(host: operator_host_srv1) {
            RegistrationLabelsResolved { labels: srv1_labels } => {
              let selector = concat(platform, [gunbc_user_session_label])
              runner_labels_satisfy_selector(held: srv4_labels, selector: selector)
                && !runner_labels_satisfy_selector(held: srv1_labels, selector: selector)
            }
            RegistrationLabelsRefused { host: _, cause: _ } => false
          }
        RegistrationLabelsRefused { host: _, cause: _ } => false
      }
    other => false
  }
}

// THE CONTROL CENSUS, IN THE ORDER THE FOLD READS THEM. Each control above answers Bool (the claim lane's
// shape); this vocabulary names them so the fold below can carry the FIRST failing control's name into
// the refusal -- DESIGN 5: every path fails with a typed, located diagnostic, so a red receipt says where
// to look instead of listing every possible cause. A named-step sum type folded through a dispatch fn,
// not a List<thunk>: the interpreter runs folded zero-argument thunks but the Rust emission refuses them
// (extdeps.apple.app_attest records that around gunbc#11989), and this witness must emit as cleanly as it
// runs.
type WitnessControl
  = GrantTypedStateStep
  | UnconvergedHostStep
  | ReceiptRowHoldsStep
  | ExactlyOnceStep
  | ClassArgumentChannelStep
  | PlatformHalfStep
  | StripComposesWithGrantStep
  | SlotGrainStep
  | ConsumerSelectorStep

fn witness_control_order() -> List<WitnessControl> {
  [
    GrantTypedStateStep,
    UnconvergedHostStep,
    ReceiptRowHoldsStep,
    ExactlyOnceStep,
    ClassArgumentChannelStep,
    PlatformHalfStep,
    StripComposesWithGrantStep,
    SlotGrainStep,
    ConsumerSelectorStep,
  ]
}

fn witness_control_name(step: WitnessControl) -> String {
  match step {
    GrantTypedStateStep => "the_grant_states_who_holds_the_label_and_why_the_others_do_not"
    UnconvergedHostStep => "an_unconverged_host_never_gains_the_label"
    ReceiptRowHoldsStep => "srv4_receipt_row_holds_and_cites_a_positive_run"
    ExactlyOnceStep => "the_grant_adds_the_label_exactly_once"
    ClassArgumentChannelStep => "a_caller_cannot_grant_the_label_through_the_class_labels_argument"
    PlatformHalfStep => "the_platform_half_cannot_carry_the_label_but_keeps_its_own_labels"
    StripComposesWithGrantStep => "the_strip_does_not_disable_the_grant"
    SlotGrainStep => "a_ci_slot_label_set_follows_its_host_gate_and_the_deploy_slot_stays_out"
    ConsumerSelectorStep => "the_consumer_selector_is_satisfied_by_the_gate_and_by_nothing_else"
  }
}

fn witness_control_holds(step: WitnessControl) -> Bool {
  match step {
    GrantTypedStateStep => the_grant_states_who_holds_the_label_and_why_the_others_do_not()
    UnconvergedHostStep => an_unconverged_host_never_gains_the_label()
    ReceiptRowHoldsStep => srv4_receipt_row_holds_and_cites_a_positive_run()
    ExactlyOnceStep => the_grant_adds_the_label_exactly_once()
    ClassArgumentChannelStep => a_caller_cannot_grant_the_label_through_the_class_labels_argument()
    PlatformHalfStep => the_platform_half_cannot_carry_the_label_but_keeps_its_own_labels()
    StripComposesWithGrantStep => the_strip_does_not_disable_the_grant()
    SlotGrainStep => a_ci_slot_label_set_follows_its_host_gate_and_the_deploy_slot_stays_out()
    ConsumerSelectorStep => the_consumer_selector_is_satisfied_by_the_gate_and_by_nothing_else()
  }
}

// THE FIRST CONTROL THAT DID NOT HOLD. The fold keeps the leftmost refusal, so witness_control_order() is
// the order a reader is pointed through. An earlier refusal buys no later evaluation, so a control whose
// host refuses is reported by name, never papered over.
fn first_failing_control() -> Optional<String> {
  fold(witness_control_order(), init: Absent, f: (acc, step) => match acc {
    Present { value: _ } => acc
    Absent => if witness_control_holds(step: step) { Absent } else { Present { value: witness_control_name(step: step) } }
  })
}

// THE RECEIPT ENTRY. This folds the controls into a process result so a single `gunbc run` of this
// function is the receipt for the whole file -- the run refuses to map a Bool to an exit code, so without
// this there is no single green mark to paste. The refusal carries the first failing control's name.
fn runner_user_session_label_witness_main() -> ProcessExit {
  match first_failing_control() {
    Absent => ExitSuccess {}
    Present { value: name } =>
      ExitFailure { code: 1, reason: join(["the user-session label control did not hold: ", name], "") }
  }
}
