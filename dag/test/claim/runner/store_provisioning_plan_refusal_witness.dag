module test.claim.runner.store_provisioning_plan_refusal_witness

// WITNESS FOR THE ONE PROJECTION FROM A DECLARED DIRECTORY TARGET ONTO A PROVISIONING PLAN ROW
// (gunbc.executor_privileged_operation executor_privileged_owned_directory_plan_rows), review 86390:
// a target whose mode cannot be resolved must contribute a LOCATED REFUSAL ROW to the plan, never an
// empty contribution. The old sites did `OwnedDirectoryModeRefused { reason: _ } => []` -- the plan
// converged without the directory and nothing recorded why. These witnesses pin all three conjuncts
// the fix owes: (1) the refusal survives as exactly one located row, (2) the row is plan TEXT that no
// renderer can turn into a command or a grant, and (3) the grant census never asks sudo about it.

import std.types { Bool, String, NonEmptyStr, List }
import std.optional { Present, Absent }
import std.effect_grant { Read, Write, Execute }
import extdeps.access.posix { PosixUser, LoginShellUnobserved }
import gunbc.ownership { Owned }
import gunbc.managed_directory {
  ManagedDirectory,
  DirectoryDependent,
  EntriesUnmanaged,
}
import gunbc.owned_directory { OwnedDirectoryTarget, OwnedDirectoryManaged }
import gunbc.executor_privileged_operation {
  ExecutorPrivilegedOperation,
  EnsureOwnedDirectory,
  executor_privileged_owned_directory_plan_rows,
  executor_privileged_operation_is_plan_comment,
  executor_privileged_operation_sudoers_line,
  executor_privileged_operation_converge_command,
  executor_privileged_operation_shell_command,
  executor_privileged_operations_sudoers_body,
}
import gunbc.fleet.fleet_host_grant_coverage { host_grant_queries }


fn owner_user() -> PosixUser {
  PosixUser { name: "owner", uid: 4001, gid: 4001, shell: LoginShellUnobserved }
}

fn stranger_user() -> PosixUser {
  PosixUser { name: "outsider", uid: 4002, gid: 4002, shell: LoginShellUnobserved }
}

// A SYNTHETIC MANAGED TARGET. Admitted when its only writer is the owner; refused by
// managed_directory_admit when a writer is neither owner nor in group -- the ONE route that makes
// owned_directory_mode refuse, so the refusal row is not a scenario invented for the test.
fn managed_with(writers: List<PosixUser>) -> OwnedDirectoryTarget {
  OwnedDirectoryManaged {
    directory: ManagedDirectory {
      member: "synthetic-store",
      path: "/synthetic/store-root",
      owner: owner_user(),
      group_principal: owner_user(),
      dependents: map(writers, w => DirectoryDependent { who: w, needs: [Read, Write, Execute] }),
      ownership: Owned,
      entries: EntriesUnmanaged,
    },
  }
}

fn refused_rows() -> List<ExecutorPrivilegedOperation> {
  executor_privileged_owned_directory_plan_rows(t: managed_with(writers: [stranger_user()]))
}

fn admitted_rows() -> List<ExecutorPrivilegedOperation> {
  executor_privileged_owned_directory_plan_rows(t: managed_with(writers: [owner_user()]))
}

fn one_row(rows: List<ExecutorPrivilegedOperation>) -> Bool {
  count(rows) == 1
}

// THE POSITIVE CONTROL: an admitted target still projects exactly one directory row, and it is NOT a
// comment -- the projection cannot pass by refusing everything.
fn the_admitted_target_projects_one_directory_row() -> Bool {
  let rows = admitted_rows()
  count(rows) == 1
    && match rows.first() {
      Absent => false
      Present { value: row } =>
        !executor_privileged_operation_is_plan_comment(op: row)
        && match row {
          EnsureOwnedDirectory { path: p, owner: o, group: g, mode: _ } =>
            (p as String) == "/synthetic/store-root" && (o as String) == "owner" && (g as String) == "owner"
          _ => false
        }
    }
}

// THE RED THE FIX ANSWERS: a target whose mode cannot be resolved projects EXACTLY ONE located
// refusal row -- not zero rows. Under the deleted `=> []` arms this witness is red: the plan carried
// no trace of the directory at all.
fn the_refused_target_projects_a_located_refusal_not_nothing() -> Bool {
  let rows = refused_rows()
  match rows.first() {
    Absent => false
    Present { value: row } =>
      count(rows) == 1
        && executor_privileged_operation_is_plan_comment(op: row)
        && string_contains(s: executor_privileged_operation_shell_command(op: row), pattern: "/synthetic/store-root")
        // the refusal names WHO the executor refused: the stray writer from managed_directory_admit.
        && string_contains(s: executor_privileged_operation_shell_command(op: row), pattern: "outsider")
  }
}

// THE REFUSAL IS TEXT, NEVER A COMMAND OR A GRANT: the apply-script renderer emits a shell comment,
// and the sudoers renderer emits a comment line -- no NOPASSWD, no argv, nothing visudo would honor.
fn the_refusal_row_renders_as_comment_in_both_channels() -> Bool {
  match refused_rows().first() {
    Absent => false
    Present { value: row } => {
      let apply = executor_privileged_operation_converge_command(op: row)
      let sudo = executor_privileged_operation_sudoers_line(grantee: "ghrunner", op: row) as String
      string_contains(s: apply, pattern: "#") && !string_contains(s: apply, pattern: "sudo")
        && string_contains(s: sudo, pattern: "#") && !string_contains(s: sudo, pattern: "NOPASSWD")
    }
  }
}

// THE SUDOERS BODY CARRIES THE REFUSAL BESIDE THE GRANT IT REFUSES TO PRODUCE: with one admitted and
// one refused target in the same plan population, the rendered file contains the real grant line for
// the admitted directory AND the comment line for the refused one. Before the fix the file held only
// the grant line and the refused directory was invisible.
fn the_sudoers_body_shows_both_the_grant_and_the_refusal() -> Bool {
  let body = executor_privileged_operations_sudoers_body(grantee: "ghrunner", ops: concat(admitted_rows(), refused_rows()))
  string_contains(s: body, pattern: "NOPASSWD")
    && string_contains(s: body, pattern: "# REFUSED")
    && string_contains(s: body, pattern: "/synthetic/store-root has no resolvable mode")
}

// THE GRANT CENSUS NEVER ASKS SUDO ABOUT A REFUSAL: an invoker population holding only the refusal
// row yields no queries at all, while the admitted row yields its query. A refusal queried would be
// reported as a MISSING GRANT, inventing a remediation the mode decision withheld.
fn the_census_asks_nothing_of_a_refusal_row() -> Bool {
  let refused_queries = host_grant_queries(host: "no-such-host" as NonEmptyStr, lease_owner: "lease", invoker_ops: refused_rows())
  let admitted_queries = host_grant_queries(host: "no-such-host" as NonEmptyStr, lease_owner: "lease", invoker_ops: admitted_rows())
  count(refused_queries) == 0 && count(admitted_queries) == 1
}
