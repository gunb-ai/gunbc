// Ordering-equivalence witness: the install fold routes its readback sorts onto the native
// `sort_by` kernel. This witness binds the fold's OWN comparator -- gunbc.host.host_effect_realize::
// tree_path_total_order and ::tree_path_compare, IMPORTED rather than reimplemented, so a single
// authority decides the path order -- against the native order. Supplying the stress inputs here never
// removes the last execution of the real path: the modeled side sorts with the imported
// tree_path_total_order, and the landmark calls the imported tree_path_compare directly. The two orders
// agree on shared prefixes, '/' against other low bytes, case and non-ASCII, and on duplicate-path tie
// order (stability); a deliberately reversed order is detected. Elevation-free: no host seam is called.
module test.claim.runner.tree_hash_sort_equivalence

import std.algebra { list_sort_by_key, list_map, FreeMonoid, TotalOrder, Ordering, Less, Greater, Equal }
import std.content_hash { sha256_hex_of_text }
import std.optional { Present, Absent }
import gunbc.host.host_effect_realize { tree_path_total_order, tree_path_compare, tree_metadata_merge_disagreement }

data entry: FreeMonoid<Entry> = [
  Entry { hex: "01", path: "a/b" },
  Entry { hex: "02", path: "a.b" },
  Entry { hex: "03", path: "foo" },
  Entry { hex: "04", path: "foo/bar" },
  Entry { hex: "05", path: "foobar" },
  Entry { hex: "06", path: "A" },
  Entry { hex: "07", path: "a" },
  Entry { hex: "08", path: "Z" },
  Entry { hex: "09", path: "a" },
  Entry { hex: "10", path: "/root" },
  Entry { hex: "11", path: "root" },
  Entry { hex: "12", path: "a b" },
  Entry { hex: "13", path: "a/b" },
  Entry { hex: "14", path: "é" },
  Entry { hex: "15", path: "z" },
  Entry { hex: "16", path: "foo/bar" }
]

type Entry { hex: String, path: String }

// RED control: an order deliberately OPPOSITE to the fold's, to prove the witness discriminates.
// It is a purpose-built mutant here, never the production comparator.
data reversed_order: TotalOrder<String> = { compare: reversed_compare }
fn reversed_compare(a: String, b: String) -> Ordering {
  if a < b { Greater } else { if a > b { Less } else { Equal } }
}
fn to_lines(xs: FreeMonoid<Entry>) -> String {
  join(list_map(xs: xs, f: e => join([e.hex, "  ", e.path, "\n"], "")), "")
}
fn native_sorted() -> FreeMonoid<Entry> { entry |> sort_by(e => e.path) }
fn modeled_sorted() -> FreeMonoid<Entry> {
  list_sort_by_key(xs: entry, key: fn(e) { e.path }, order: tree_path_total_order)
}
fn reversed_sorted() -> FreeMonoid<Entry> {
  list_sort_by_key(xs: entry, key: fn(e) { e.path }, order: reversed_order)
}

test fn native_and_modeled_lists_agree() -> Bool { to_lines(native_sorted()) == to_lines(modeled_sorted()) }
test fn native_and_modeled_hashes_agree() -> Bool {
  sha256_hex_of_text(text: to_lines(native_sorted())) == sha256_hex_of_text(text: to_lines(modeled_sorted()))
}
// The agreed order IS the imported comparator's: exercise tree_path_compare directly on the low-byte and
// leading-'/' landmarks, and check the agreed lines sit in that order (bytewise-first is '/'-leading,
// bytewise-last is the non-ASCII entry).
test fn order_matches_imported_comparator() -> Bool {
  tree_path_compare(a: "a/b", b: "a.b") == Greater
    && tree_path_compare(a: "/root", b: "z") == Less
    && starts_with(s: to_lines(native_sorted()), prefix: "10  /root")
    && ends_with(s: to_lines(native_sorted()), suffix: "14  é\n")
}
// RED: a differing order is detected -- the reversed order is NOT equal to the native order.
test fn red_differing_order_detected() -> Bool { to_lines(native_sorted()) != to_lines(reversed_sorted()) }

// ---- tree_metadata_merge_disagreement: pins the rewrite's observable contract (DESIGN §6b) ----
// tree_metadata_merge_disagreement (the metadata readback's agreement walk) was rewritten from a
// SELF-recursive list walk -- whose depth grew with the number of metadata entries -- to a native
// left-fold carrying the observed tail. That rewrite must report the SAME first disagreement, in path
// order, with the SAME message text. This fixture feeds inputs with MORE THAN ONE divergence and pins
// (i) which one is reported (the first, in path order), (ii) its exact message, and (iii) that no
// later divergence is reported. It calls the fold's OWN function, IMPORTED not reimplemented. Lines
// are the `path|kind|mode|user|group` shape tree_metadata_entry_line produces; both lists are passed
// already in path order because the fold sorts before calling this. Run identically against the
// pre-fix recursive fold and the fixed native fold: both must return the same value.
fn merge_msg(expected: List<String>, observed: List<String>) -> String {
  match tree_metadata_merge_disagreement(expected: expected, observed: observed) {
    Present { value: m } => m
    Absent => ""
  }
}
// Two content mismatches (b and c): only the FIRST, b, is reported, with its exact message.
test fn merge_reports_first_mismatch_exact_message() -> Bool {
  merge_msg(["a|f|0644|root|root", "b|f|0644|root|root", "c|f|0644|root|root"],
            ["a|f|0644|root|root", "b|f|0600|root|root", "c|f|0666|root|root"])
    == "missing entry b|f|0644|root|root (the installed line at this path is b|f|0600|root|root)"
}
// A missing trailing entry reports "missing entry <e>".
test fn merge_reports_missing_entry() -> Bool {
  merge_msg(["a|f|0644|root|root", "b|f|0644|root|root"], ["a|f|0644|root|root"])
    == "missing entry b|f|0644|root|root"
}
// An unexpected trailing entry reports "unexpected installed entry <o>".
test fn merge_reports_unexpected_entry() -> Bool {
  merge_msg(["a|f|0644|root|root"], ["a|f|0644|root|root", "z|f|0644|root|root"])
    == "unexpected installed entry z|f|0644|root|root"
}
// Agreement yields no disagreement (Absent -> "").
test fn merge_agreement_no_message() -> Bool {
  merge_msg(["a|f|0644|root|root", "b|f|0644|root|root"], ["a|f|0644|root|root", "b|f|0644|root|root"]) == ""
}
// RED: the second divergence (c) must NOT be what is reported -- pins short-circuit on the first.
test fn merge_red_does_not_report_second_mismatch() -> Bool {
  merge_msg(["a|f|0644|root|root", "b|f|0644|root|root", "c|f|0644|root|root"],
            ["a|f|0644|root|root", "b|f|0600|root|root", "c|f|0666|root|root"])
    != "missing entry c|f|0644|root|root (the installed line at this path is c|f|0666|root|root)"
}
