module test.claim.runner.runner_jit_dead_sweep_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.nat { Nat, nat_range_inclusive }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Present }
import product.host_identity { HostIdentity }
import extdeps.github.ci_runner { GitHubSelfHostedRunnerRegistration, GitHubRunnerRegistrationStatus, GitHubRunnerOnline, GitHubRunnerOffline }
import gunbc.fleet.fleet_runner_connectivity {
  OrganizationRunnerRosterEvidence, RosterObserved, RosterObservedPartial, RosterReadUnavailable,
}
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity }
import gunbc.runner.runner_jit_dead_sweep {
  JitMainPid, JitCurrentIncarnation, MainPidKnown, MainPidUnreadable,
  JitDeadRow, JitDeadSweep, JitDeadSweepSelected, JitDeadSweepRefused,
  SweepRosterIncomplete, SweepRosterUnavailable, SweepHostSlotsUnresolved,
  jit_dead_registration_sweep, jit_row_is_dead, jit_row_is_retired_selection,
  jit_sweep_selected_names, jit_sweep_host_count,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE HOST UNDER SWEEP. Its committed slots are 01, 02, 03. It was renamed FROM "oldhost", so the plan supplies
// the retired prefix "oldhost-" as an input -- never a literal baked into the sweep.
data swept_host: HostIdentity = "fox"
data retired_old_host_prefix: NonEmptyStr = "oldhost-"

fn swept_slots() -> List<RunnerSlotIdentity> {
  [
    RunnerSlotIdentity { host: swept_host, slot_index: 1 },
    RunnerSlotIdentity { host: swept_host, slot_index: 2 },
    RunnerSlotIdentity { host: swept_host, slot_index: 3 },
  ]
}

// The slot units' observed MainPIDs. Slot 2's unit has MainPID 9999 (so its live registration "...-9999" is the
// current incarnation and is protected); slot 1 has 555; slot 3 is unreadable (fail closed -- its offline rows are
// preserved, not swept).
fn swept_current() -> List<JitCurrentIncarnation> {
  [
    JitCurrentIncarnation { slot_index: 1, main_pid: MainPidKnown { pid: 555 } },
    JitCurrentIncarnation { slot_index: 2, main_pid: MainPidKnown { pid: 9999 } },
    JitCurrentIncarnation { slot_index: 3, main_pid: MainPidUnreadable },
  ]
}

fn reg(id: Nat, name: String, online: Bool) -> GitHubSelfHostedRunnerRegistration {
  GitHubSelfHostedRunnerRegistration {
    id: id,
    name: name as NonEmptyStr,
    status: if online { GitHubRunnerOnline } else { GitHubRunnerOffline },
    busy: false,
    ephemeral: none,
    version: none,
    os: "linux" as NonEmptyStr,
    labels: [],
  }
}

// A hundred-and-five FOREIGN filler rows, all offline. They must never be selected (a stranger is never collateral),
// and they push the planted target rows PAST THE FIRST HUNDRED so the sweep cannot be capped at the first page. A
// filler row's id is its Nat index -- ids are unique; the foreign name never parses under any host's slot grammar,
// so every one of them reads ForeignName.
fn filler_rows() -> List<GitHubSelfHostedRunnerRegistration> {
  map(nat_range_inclusive(lo: 1, hi: 105), i => reg(i, "filler", false))
}

// The planted target rows. Index offset so ids stay unique above the filler.
fn target_dead() -> GitHubSelfHostedRunnerRegistration {
  reg(200, "fox-02-1700000000-1234", false)   // slot 2, offline, pid 1234 != MainPID 9999 -> DEAD (selected)
}
fn target_current_incarnation() -> GitHubSelfHostedRunnerRegistration {
  reg(201, "fox-02-1699999000-9999", false)   // slot 2, offline, pid 9999 == MainPID -> CURRENT INCARNATION (never selected)
}
fn target_live() -> GitHubSelfHostedRunnerRegistration {
  reg(202, "fox-01-1600000000-555", true)     // slot 1, ONLINE -> live (never selected)
}
fn target_unreadable() -> GitHubSelfHostedRunnerRegistration {
  reg(203, "fox-03-1600000000-777", false)    // slot 3, offline, MainPID unreadable -> preserved (never selected)
}
fn target_stranger() -> GitHubSelfHostedRunnerRegistration {
  reg(204, "srv9-05-1600000000-888", false)   // a different host's slot grammar -> Foreign (never selected)
}
fn target_stranger_non_jit() -> GitHubSelfHostedRunnerRegistration {
  reg(205, "gunbc-service-fox-02", false)     // a service-grammar name, outside the JIT grammar -> Foreign (never selected)
}
fn target_retired() -> GitHubSelfHostedRunnerRegistration {
  reg(206, "oldhost-02-1600000000-333", false) // under the retired prefix "oldhost-" -> DEAD BY DEFINITION (selected)
}

// THE COMPLETE ROSTER: filler first (past 100 rows), then the seven planted targets.
fn complete_roster() -> OrganizationRunnerRosterEvidence {
  RosterObserved {
    observed_on: "2026-11-10T00:00:00Z" as NonEmptyStr,
    registrations: concat(
      filler_rows(),
      [
        target_dead(), target_current_incarnation(), target_live(),
        target_unreadable(), target_stranger(), target_stranger_non_jit(), target_retired(),
      ],
    ),
  }
}

fn run_complete() -> JitDeadSweep {
  jit_dead_registration_sweep(
    host: swept_host,
    slots: swept_slots(),
    current: swept_current(),
    retired_prefixes: [retired_old_host_prefix],
    evidence: complete_roster(),
  )
}

fn selected_names_of(sweep: JitDeadSweep) -> List<NonEmptyStr> {
  match sweep {
    JitDeadSweepSelected { host: _, selected: selected, preserved: _, counts: _ } => jit_sweep_selected_names(selected)
    JitDeadSweepRefused { refusal: _ } => []
  }
}

fn selected_rows_of(sweep: JitDeadSweep) -> List<JitDeadRow> {
  match sweep {
    JitDeadSweepSelected { host: _, selected: selected, preserved: _, counts: _ } => selected
    JitDeadSweepRefused { refusal: _ } => []
  }
}

fn list_has(xs: List<NonEmptyStr>, want: String) -> Bool {
  fold(xs, init: false, f: (acc, x) => acc || (x as String == want))
}

fn list_does_not_have(xs: List<NonEmptyStr>, unwanted: String) -> Bool {
  fold(xs, init: true, f: (acc, x) => acc && (x as String != unwanted))
}

fn is_selected(sweep: JitDeadSweep, name: String) -> Bool {
  list_has(selected_names_of(sweep), name)
}

// THE WITNESS. Only the dead offline incarnation and the retired-prefix row are selected. The current incarnation
// (even though offline), the live row, the unreadable-MainPID row, and BOTH strangers are never selected. And the
// planted rows sit past the first hundred (the filler is 105 long), so a sweep capped at one page would fail here.
test fn only_dead_and_retired_are_selected_and_the_rest_are_never() -> Bool {
  let sweep = run_complete()
  // exactly two rows selected, by name
  (match sweep {
    JitDeadSweepSelected { host: _, selected: selected, preserved: _, counts: _ } => length(selected) == 2
    JitDeadSweepRefused { refusal: _ } => false
  })
    && is_selected(sweep, "fox-02-1700000000-1234")
    && is_selected(sweep, "oldhost-02-1600000000-333")
    && list_does_not_have(selected_names_of(sweep), "fox-02-1699999000-9999")
    && list_does_not_have(selected_names_of(sweep), "fox-01-1600000000-555")
    && list_does_not_have(selected_names_of(sweep), "fox-03-1600000000-777")
    && list_does_not_have(selected_names_of(sweep), "srv9-05-1600000000-888")
    && list_does_not_have(selected_names_of(sweep), "gunbc-service-fox-02")
    // none of the 105 foreign filler rows -- all present in the roster -- was ever selected
    && list_does_not_have(selected_names_of(sweep), "filler")
}

// The two selected rows carry the right REASONS: the dead arm for the offline incarnation, the retired arm for the
// old name. A row is never selected for both, and the arms are never conflated.
test fn the_selected_rows_carry_the_right_arms() -> Bool {
  let rows = selected_rows_of(run_complete())
  let dead_names = map(filter(rows, r => jit_row_is_dead(r)), r => r.name)
  let retired_names = map(filter(rows, r => jit_row_is_retired_selection(r)), r => r.name)
  // each row is in exactly one arm; the dead arm holds the offline incarnation, the retired arm holds the old name
  length(rows) == length(dead_names) + length(retired_names)
    && list_has(dead_names, "fox-02-1700000000-1234")
    && list_has(retired_names, "oldhost-02-1600000000-333")
    && !list_has(dead_names, "oldhost-02-1600000000-333")
    && !list_has(retired_names, "fox-02-1700000000-1234")
}

// Counts BY HOST, with no per-host literal in the sweep: both selected rows are attributed to the swept host.
test fn counts_by_host() -> Bool {
  match run_complete() {
    JitDeadSweepSelected { host: _, selected: _, preserved: _, counts: counts } =>
      jit_sweep_host_count(counts: counts, host: swept_host) == 2
    JitDeadSweepRefused { refusal: _ } => false
  }
}

// A PARTIAL ROSTER REFUSES -- the completeness discipline. An incomplete read is never a clean sweep and never zero
// selected; it is an outright refusal (the RFM: a partial roster read stays unobserved, never zero).
test fn a_partial_roster_refuses() -> Bool {
  let partial: OrganizationRunnerRosterEvidence = RosterObservedPartial {
    observed_on: "2026-11-10T00:00:00Z" as NonEmptyStr,
    registrations: concat(filler_rows(), [target_dead(), target_retired()]),
    observed_count: 107,
    authority_total: 522,
  }
  let sweep = jit_dead_registration_sweep(
    host: swept_host,
    slots: swept_slots(),
    current: swept_current(),
    retired_prefixes: [retired_old_host_prefix],
    evidence: partial,
  )
  match sweep {
    JitDeadSweepRefused { refusal: SweepRosterIncomplete { observed_count: observed, authority_total: total } } =>
      observed == 107 && total == 522
    _ => false
  }
}

// An UNAVAILABLE roster read also refuses, never zero.
test fn an_unavailable_roster_refuses() -> Bool {
  let sweep = jit_dead_registration_sweep(
    host: swept_host,
    slots: swept_slots(),
    current: swept_current(),
    retired_prefixes: [retired_old_host_prefix],
    evidence: RosterReadUnavailable { reason: "fixture: transport refused" },
  )
  match sweep {
    JitDeadSweepRefused { refusal: SweepRosterUnavailable { reason: _ } } => true
    _ => false
  }
}

// NO COMMITTED SLOTS -> refuse, never report a clean roster it never enumerated.
test fn empty_committed_slots_refuses() -> Bool {
  let sweep = jit_dead_registration_sweep(
    host: swept_host,
    slots: [],
    current: swept_current(),
    retired_prefixes: [retired_old_host_prefix],
    evidence: complete_roster(),
  )
  match sweep {
    JitDeadSweepRefused { refusal: SweepHostSlotsUnresolved { host: _ } } => true
    _ => false
  }
}

// THE CURRENT-INCARNATION GUARD IS LOAD-BEARING: if the current-incarnation row's pid did NOT match the unit's
// MainPID it WOULD be selected -- proving the protection is the MainPID comparison, not the name pattern.
test fn the_current_incarnation_guard_is_load_bearing() -> Bool {
  // Same roster, but claim slot 2's MainPID is 4242 (not 9999). Now the 9999 row is a dead incarnation and must be
  // selected, while nothing named 4242 exists to protect.
  let wrong_current: List<JitCurrentIncarnation> = [
    JitCurrentIncarnation { slot_index: 1, main_pid: MainPidKnown { pid: 555 } },
    JitCurrentIncarnation { slot_index: 2, main_pid: MainPidKnown { pid: 4242 } },
    JitCurrentIncarnation { slot_index: 3, main_pid: MainPidUnreadable },
  ]
  let sweep = jit_dead_registration_sweep(
    host: swept_host,
    slots: swept_slots(),
    current: wrong_current,
    retired_prefixes: [retired_old_host_prefix],
    evidence: complete_roster(),
  )
  is_selected(sweep, "fox-02-1699999000-9999") && is_selected(sweep, "fox-02-1700000000-1234")
}
