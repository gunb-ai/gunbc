module test.claim.runner.runner_group_restriction_ensure_witness_test

import std.types { Bool, String, List, Int, NonEmptyStr }
import gunbc.fleet.org_actions_inspection { decode_runner_groups_json }
import gunbc.runner_group_restriction_observation { microvm_shakedown_selected_workflow, microvm_shakedown_runner_group_name }
import gunbc.runner_group_restriction_ensure {
  RunnerGroupEnsurePlan, GroupAlreadyRestricted, GroupCreateRequired, GroupEnsureRefused,
  CreatedGroupRestricted, CreatedGroupNotRestricted,
  plan_runner_group_ensure, readback_after_create, microvm_runner_group_create_subject,
  runner_group_create_subject_text,
}

// THE PLAN'S SUBJECT IS ONE INTERFACE: the organization's runner-groups body, decoded by the
// production decode, in; which of three things to do, out. The bodies are GitHub's shape.

fn group_json(id: Int, name: String, restricted: Bool, selected: List<String>) -> String {
  join([
    "\{\"id\":", to_string(id), ",\"name\":\"", name,
    "\",\"visibility\":\"selected\",\"allows_public_repositories\":false,\"restricted_to_workflows\":",
    if restricted { "true" } else { "false" },
    ",\"selected_workflows\":[", join(map(selected, w => join(["\"", w, "\""], "")), ","),
    "],\"workflow_restrictions_read_only\":false}",
  ], "")
}

fn body_of(groups: List<String>) -> String {
  join(["\{\"total_count\":", to_string(count(groups)), ",\"runner_groups\":[", join(groups, ","), "]}"], "")
}

fn default_group() -> String { group_json(id: 1, name: "Default", restricted: false, selected: []) }

fn ours(id: Int, restricted: Bool, selected: List<String>) -> String {
  group_json(id: id, name: microvm_shakedown_runner_group_name as String, restricted: restricted, selected: selected)
}

fn planned(body: String) -> RunnerGroupEnsurePlan {
  plan_runner_group_ensure(subject: microvm_runner_group_create_subject(), listed: decode_runner_groups_json(body: body))
}

fn shakedown() -> String { microvm_shakedown_selected_workflow() as String }

// An organization with only the Default group needs the create -- the unrestricted Default group
// is never mistaken for ours.
test fn witness_ensure_requires_the_create_when_only_default_exists() -> Bool {
  match planned(body: body_of(groups: [default_group()])) {
    GroupCreateRequired { subject: s } => (s.name as String) == "microvm-shakedown" && s.restricted_to_workflows && !s.allows_public_repositories
    _ => false
  }
}

// ALREADY RESTRICTED IS A NOOP, carrying the observer's restriction -- no create is planned, so no
// operator is asked to approve an effect that would change nothing.
test fn witness_ensure_is_a_noop_when_the_group_is_already_restricted() -> Bool {
  match planned(body: body_of(groups: [default_group(), ours(id: 9, restricted: true, selected: [shakedown()])])) {
    GroupAlreadyRestricted { restriction: r } => r.group.value == 9
    _ => false
  }
}

// A group holding our name with any other restriction is refused, not edited.
test fn witness_ensure_refuses_our_name_held_by_an_unrestricted_group() -> Bool {
  match planned(body: body_of(groups: [ours(id: 9, restricted: false, selected: [])])) {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupNotEnsurable") && string_contains(s: c as String, pattern: "RunnerGroupNotRestrictedToWorkflows")
    _ => false
  }
}

test fn witness_ensure_refuses_two_groups_with_our_name() -> Bool {
  match planned(body: body_of(groups: [ours(id: 9, restricted: true, selected: [shakedown()]), ours(id: 10, restricted: true, selected: [shakedown()])])) {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupDuplicated")
    _ => false
  }
}

test fn witness_ensure_refuses_an_unreadable_list() -> Bool {
  match planned(body: "not json") {
    GroupEnsureRefused { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupListUnreadable")
    _ => false
  }
}

// A 201 FOLLOWED BY A READ THAT LACKS THE GROUP IS A REFUSAL, not a success.
test fn witness_readback_after_create_refuses_when_the_group_is_absent() -> Bool {
  match readback_after_create(subject: microvm_runner_group_create_subject(), listed: decode_runner_groups_json(body: body_of(groups: [default_group()]))) {
    CreatedGroupNotRestricted { cause: c } => string_contains(s: c as String, pattern: "RunnerGroupAbsentAfterCreate")
    CreatedGroupRestricted { restriction: _ } => false
  }
}

test fn witness_readback_after_create_holds_the_restriction() -> Bool {
  match readback_after_create(subject: microvm_runner_group_create_subject(), listed: decode_runner_groups_json(body: body_of(groups: [default_group(), ours(id: 11, restricted: true, selected: [shakedown()])]))) {
    CreatedGroupRestricted { restriction: r } => r.group.value == 11
    CreatedGroupNotRestricted { cause: _ } => false
  }
}

// The text the operator reads names every member of the body, so an approval of it is an approval
// of the exact group.
test fn witness_create_subject_text_names_every_member() -> Bool {
  let t = runner_group_create_subject_text(s: microvm_runner_group_create_subject())
  string_contains(s: t, pattern: "visibility=selected")
    && string_contains(s: t, pattern: "allows_public_repositories=false")
    && string_contains(s: t, pattern: "restricted_to_workflows=true")
    && string_contains(s: t, pattern: shakedown())
    && string_contains(s: t, pattern: "repository_id=1143718943")
}
