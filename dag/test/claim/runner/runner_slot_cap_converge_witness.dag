// THE CONTROLS FOR THE SLOT MEMORY-CAP CONVERGE. The decisions are pure over supplied readings (the
// boundary these claims discriminate at): the live reading of a slot, whether its worker is running, and
// the retirement standings. The pairing obligation -- the effect really drains before it restarts and
// really reads the cgroup -- is the remote-claim_batch run against a host (gunbc.runner.runner_slot_cap_converge
// restart_slot_for_caps_over refuses without activating when the drain does not settle, by construction:
// activate is only reachable on a settled drain).

fn desired() -> RunnerSlotDesired { gunbc_runner_slot_desired() }

fn at_desired_live() -> SlotCapLive {
  SlotCapLive {
    unit_memory_max: to_string(byte_size_count(b: desired().memory_max)),
    unit_swap_max: to_string(byte_size_count(b: desired().memory_swap_max)),
    unit_memory_high: to_string(byte_size_count(b: desired().memory_high)),
    unit_tasks_max: to_string(desired().tasks_max),
    control_group: "/system.slice/actions-runner@srv3-01.service",
    cgroup_memory_max: Present { value: concat(to_string(byte_size_count(b: desired().memory_max)), "\n") },
    cgroup_swap_max: Present { value: "0\n" },
    // The shared standing reads TWO files (max+swap); a literal built for it has no high row observed,
    // and the shared fold never reads this field. The holder fold reads it, and builds its own reading.
    cgroup_memory_high: none,
  }
}

fn old_shape_live() -> SlotCapLive {
  SlotCapLive {
    unit_memory_max: to_string(byte_size_count(b: desired().memory_max)),
    unit_swap_max: to_string(byte_size_count(b: desired().memory_swap_max)),
    unit_memory_high: to_string(byte_size_count(b: desired().memory_high)),
    unit_tasks_max: to_string(desired().tasks_max),
    control_group: "/system.slice/actions-runner@srv3-01.service",
    cgroup_memory_max: Present { value: "27917287424\n" },
    cgroup_swap_max: Present { value: "34359738368\n" },
    cgroup_memory_high: none,
  }
}

fn unit(n: String) -> NonEmptyStr { concat("actions-runner@srv3-", n, ".service") as NonEmptyStr }

fn standing_of(u: NonEmptyStr, live: SlotCapLive) -> SlotCapUnitStanding {
  SlotCapUnitStanding { unit: u, standing: slot_cap_standing(live: live, desired: desired()) }
}


fn plan_drains(p: HostCapPlan) -> Bool { match p { HostCapsDrainWriteRestart => true HostCapsLeaveInPlace => false HostCapsWithheld { cause: _ } => false } }
fn plan_leaves(p: HostCapPlan) -> Bool { match p { HostCapsLeaveInPlace => true HostCapsDrainWriteRestart => false HostCapsWithheld { cause: _ } => false } }
fn plan_withheld_naming(p: HostCapPlan, needle: String) -> Bool { match p { HostCapsWithheld { cause: c } => string_contains(s: c, pattern: needle) HostCapsLeaveInPlace => false HostCapsDrainWriteRestart => false } }

// RED: a differing cap on an all-idle host plans the drain-bracketed write (drain, write, reload,
// activate, read back), never a bare restart.
test fn a_differing_cap_row_on_an_idle_host_drains_writes_and_restarts() -> Bool {
  plan_drains(p: host_cap_plan(
    standings: [standing_of(u: unit(n: "01"), live: old_shape_live()), standing_of(u: unit(n: "02"), live: old_shape_live())],
    files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: none,
    extras: [],
  ))
}

// The busy-slot refusal moved to the bracket: idleness is judged under a closed admission (see
// test.claim.runner.runner_host_cap_bracket_witness), never read with admission open.

// Positive: identical caps are left in place whatever the activity, so nothing is drained, written,
// reloaded or restarted.
test fn identical_caps_are_left_in_place() -> Bool {
  plan_leaves(p: host_cap_plan(
    standings: [standing_of(u: unit(n: "01"), live: at_desired_live()), standing_of(u: unit(n: "02"), live: at_desired_live())],
    files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: none,
    extras: [],
  ))
    && slot_cap_outcome_settled(o: SlotCapsLeftInPlace { unit: unit(n: "01") })
}

// Positive: a live-cgroup readback that disagrees with the unit's view withholds the host, and a
// restarted slot whose cgroup is still old is a refused (unsettled) outcome.
test fn a_readback_mismatch_refuses() -> Bool {
  let disagree = SlotCapLive {
    unit_memory_max: "27917287424",
    unit_swap_max: "34359738368",
    unit_memory_high: to_string(byte_size_count(b: desired().memory_high)),
    unit_tasks_max: to_string(desired().tasks_max),
    control_group: "/system.slice/actions-runner@srv3-01.service",
    cgroup_memory_max: Present { value: concat(to_string(byte_size_count(b: desired().memory_max)), "\n") },
    cgroup_swap_max: Present { value: "0\n" },
    cgroup_memory_high: none,
  }
  plan_withheld_naming(p: host_cap_plan(standings: [standing_of(u: unit(n: "01"), live: disagree)], files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: none, extras: []), needle: "disagree")
    && !slot_cap_outcome_settled(o: SlotCapsRefused { unit: unit(n: "01"), step: "live-readback", reason: "x" })
}

// The cgroup row is the slot's own file: a job's descendant cgroup line can never answer for the slot.
test fn the_cgroup_row_is_keyed_by_the_slots_own_path() -> Bool {
  let show = "MemoryMax=100\nMemorySwapMax=0\nMemoryHigh=90\nTasksMax=16384\nControlGroup=/system.slice/a.slice/s.service\n"
  let out = "/sys/fs/cgroup/system.slice/a.slice/s.service/job/memory.max:5\n/sys/fs/cgroup/system.slice/a.slice/s.service/memory.max:100\n/sys/fs/cgroup/system.slice/a.slice/s.service/memory.swap.max:0\n"
  match slot_cap_live_of_show(show_stdout: show, cgroup_stdout: out) {
    Absent => false
    Present { value: l } =>
      (match l.cgroup_memory_max { Present { value: v } => v == "100" Absent => false })
        && (match l.cgroup_swap_max { Present { value: v } => v == "0" Absent => false })
  }
}

// The cap files this route writes ARE the one member list (live_deploy's memory members are its prefix),
// so srv1's rendered bytes do not move.
test fn the_cap_files_are_the_one_member_list_and_srv1_memory_members_are_its_prefix() -> Bool {
  let files = runner_host_cap_files()
  let members = derived_runner_slot_cap_members()
  let memory = derived_runner_memory_cap_members()
  length(files) == length(members)
    && all(files, f => any(members, m => (m.dropin_path as String) == (f.path as String) && m.content == f.content))
    && length(members) == length(memory) + 1
    && all(memory, m => any(members, n => (n.dropin_path as String) == (m.dropin_path as String) && n.content == m.content))
}

fn retired_unit() -> NonEmptyStr { "actions-runner@srv3-06.service" as NonEmptyStr }

// The retirement gate: caps are written only once every required retiree reads retired.
test fn caps_wait_for_the_retirees() -> Bool {
  let done = SlotPopulationObserved { units: [RunnerSlotUnitResult { unit: retired_unit(), standing: SlotRetiredAsDeclared, reload: SlotReloadNotPending, reach: ReachesLiveCgroup }] }
  let pending = SlotPopulationObserved { units: [RunnerSlotUnitResult { unit: retired_unit(), standing: SlotRetirementIncomplete { cause: "job" }, reload: SlotReloadNotPending, reach: ReachesLiveCgroup }] }
  (match runner_host_cap_gate_cause(standing: runner_host_cap_retirement_gate(retired_units: [retired_unit()], population: done)) { Absent => true Present { value: _ } => false })
    && (match runner_host_cap_gate_cause(standing: runner_host_cap_retirement_gate(retired_units: [retired_unit()], population: pending)) { Absent => false Present { value: _ } => true })
    && (match runner_host_cap_gate_cause(standing: runner_host_cap_retirement_gate(retired_units: [retired_unit()], population: SlotPopulationUnobservable { reason: "ssh" })) { Absent => false Present { value: _ } => true })
}

fn one_old() -> List<SlotCapUnitStanding> { [standing_of(u: unit(n: "01"), live: old_shape_live())] }
fn one_at() -> List<SlotCapUnitStanding> { [standing_of(u: unit(n: "01"), live: at_desired_live())] }

// RED (review 5566883083, 1): an extra loaded instance outside the declared sets gets the template
// reload too, and this route never drains or activates it, so a needed bracket withholds, naming it.
test fn an_extra_loaded_instance_withholds_the_host() -> Bool {
  plan_withheld_naming(p: host_cap_plan(standings: one_old(), files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: none, extras: [unit(n: "99")]), needle: "actions-runner@srv3-99.service")
    && plan_withheld_naming(p: host_cap_plan(standings: one_at(), files: CapFilesDiffer, pending_reloads: HostNoReloadPending, retirement_cause: none, extras: [unit(n: "99")]), needle: "actions-runner@srv3-99.service")
}

// RED (review, 1): a withheld cap phase is what bars the later reload sites.
test fn a_withheld_cap_phase_bars_the_reload() -> Bool {
  runner_host_cap_phase_bars_reload(phase: CapPhaseWithheld { cause: "busy" }) && !runner_host_cap_phase_bars_reload(phase: CapPhaseNotOwed)
}

// RED (review, 3): live caps matching does not settle a missing, stale or wrong-mode cap file.
test fn matching_live_caps_do_not_settle_a_differing_cap_file() -> Bool {
  plan_drains(p: host_cap_plan(standings: one_at(), files: CapFilesDiffer, pending_reloads: HostNoReloadPending, retirement_cause: none, extras: []))
    && plan_leaves(p: host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: none, extras: []))
}

fn live_with(cg: String, mm: String?, sw: String?) -> SlotCapLive {
  SlotCapLive {
    unit_memory_max: to_string(byte_size_count(b: desired().memory_max)),
    unit_swap_max: "0",
    unit_memory_high: to_string(byte_size_count(b: desired().memory_high)),
    unit_tasks_max: to_string(desired().tasks_max),
    control_group: cg,
    cgroup_memory_max: mm,
    cgroup_swap_max: sw,
    cgroup_memory_high: none,
  }
}

fn is_unread(s: SlotCapStanding) -> Bool { match s { SlotCapsUnread { cause: _ } => true SlotCapsAtDesired => false SlotCapsNeedRestart { detail: _ } => false SlotCapsReadingsDisagree { detail: _ } => false SlotCapsStopped => false } }
fn is_stopped(s: SlotCapStanding) -> Bool { match s { SlotCapsStopped => true SlotCapsAtDesired => false SlotCapsNeedRestart { detail: _ } => false SlotCapsReadingsDisagree { detail: _ } => false SlotCapsUnread { cause: _ } => false } }

// RED (review, 2): a unit that HAS a cgroup owes both readable files. Missing or malformed is Unread
// (refuses), never NeedRestart (which would authorise drain, write and reload).
test fn missing_or_malformed_cgroup_files_are_unread_not_a_difference() -> Bool {
  let cg = "/system.slice/actions-runner@srv3-01.service"
  let full = concat(to_string(byte_size_count(b: desired().memory_max)), "\n")
  is_unread(s: slot_cap_standing(live: live_with(cg: cg, mm: none, sw: none), desired: desired()))
    && is_unread(s: slot_cap_standing(live: live_with(cg: cg, mm: Present { value: full }, sw: none), desired: desired()))
    && is_unread(s: slot_cap_standing(live: live_with(cg: cg, mm: Present { value: "garbage\n" }, sw: Present { value: "0\n" }), desired: desired()))
}

// Positive: only an EMPTY ControlGroup from a successful show is the stopped state; and a show with no
// ControlGroup field at all is not a reading (live_of_show is Absent, the read refuses).
test fn only_an_empty_control_group_field_is_stopped() -> Bool {
  let present_empty = join(["MemoryMax=", to_string(byte_size_count(b: desired().memory_max)), "\nMemorySwapMax=0\nMemoryHigh=", to_string(byte_size_count(b: desired().memory_high)), "\nTasksMax=", to_string(desired().tasks_max), "\nControlGroup=\n"], "")
  let field_missing = "MemoryMax=100\nMemorySwapMax=0\nMemoryHigh=90\nTasksMax=16384\n"
  (match slot_cap_live_of_show(show_stdout: present_empty, cgroup_stdout: "") { Present { value: l } => is_stopped(s: slot_cap_standing(live: l, desired: desired())) Absent => false })
    && (match slot_cap_live_of_show(show_stdout: field_missing, cgroup_stdout: "") { Present { value: _ } => false Absent => true })
}

// Keying controls: an escaped path (systemd `\x2d`) and a sibling near-match (srv3-01 vs srv3-010) never
// answer for the slot.
test fn the_cgroup_row_ignores_a_sibling_near_match_and_reads_the_escaped_path() -> Bool {
  let show = "MemoryMax=100\nMemorySwapMax=0\nMemoryHigh=90\nTasksMax=16384\nControlGroup=/system.slice/system-actions\\x2drunner.slice/actions-runner@srv3-01.service\n"
  let out = "/sys/fs/cgroup/system.slice/system-actions\\x2drunner.slice/actions-runner@srv3-010.service/memory.max:5\n/sys/fs/cgroup/system.slice/system-actions\\x2drunner.slice/actions-runner@srv3-010.service/memory.swap.max:5\n/sys/fs/cgroup/system.slice/system-actions\\x2drunner.slice/actions-runner@srv3-01.service/memory.max:100\n/sys/fs/cgroup/system.slice/system-actions\\x2drunner.slice/actions-runner@srv3-01.service/memory.swap.max:0\n"
  match slot_cap_live_of_show(show_stdout: show, cgroup_stdout: out) {
    Absent => false
    Present { value: l } =>
      (match l.cgroup_memory_max { Present { value: v } => v == "100" Absent => false })
        && (match l.cgroup_swap_max { Present { value: v } => v == "0" Absent => false })
  }
}

fn ran_with(rl: RunnerHostManagerReload, slots: List<SlotCapOutcome>) -> RunnerHostCapPhase { CapPhaseRan { files: [], reload: rl, slots: slots, certified: [] } }

// RED (review 5567170735, 1a): a cap-file plan that could not be made is Unreadable, never a difference:
// it withholds (no drain, no write) and says so, where it used to reduce to `true` and drain and write.
test fn an_unreadable_cap_file_plan_withholds_instead_of_draining() -> Bool {
  plan_withheld_naming(p: host_cap_plan(standings: one_old(), files: CapFilesUnreadable { cause: "20-fleet-width.conf: privilege unproven" }, pending_reloads: HostNoReloadPending, retirement_cause: none, extras: []), needle: "20-fleet-width.conf: privilege unproven")
}

// RED (1b): a phase that RAN but did not settle (a failed write, reload or readback) still bars the later
// ordinary reloads and activation; only a settled ran phase leaves them open.
test fn a_ran_but_unsettled_cap_phase_still_bars_the_reload() -> Bool {
  runner_host_cap_phase_bars_reload(phase: ran_with(rl: ManagerReloadRefused { reason: "x" }, slots: [SlotCapsRefused { unit: unit(n: "01"), step: "write", reason: "x" }]))
    && runner_host_cap_phase_bars_reload(phase: ran_with(rl: ManagerReloaded, slots: [SlotCapsRefused { unit: unit(n: "01"), step: "live-readback", reason: "x" }]))
    && !runner_host_cap_phase_bars_reload(phase: ran_with(rl: ManagerReloaded, slots: [SlotCapsRestartedAndRead { unit: unit(n: "01") }]))
}

// RED (2): the drain's mask, the activation's unmask/enable and the daemon-reload each reload the manager,
// read off the argv the bracket sends; a start does not, and `--no-reload` is the only thing that turns a
// mask's reload off. The bracket as built therefore reloads, so a pending file is a hazard.
test fn the_brackets_mask_unmask_enable_and_reload_steps_reload_the_manager() -> Bool {
  let u = unit(n: "01")
  host_cap_bracket_reloads(unit: u)
    && host_cap_step_reloads(step: systemctl_mask_step(unit: u))
    && host_cap_step_reloads(step: systemctl_unmask_step(unit: u))
    && host_cap_step_reloads(step: systemctl_enable_step(unit: u))
    && !host_cap_step_reloads(step: systemctl_start_step(unit: u))
    && !host_cap_step_reloads(step: systemctl_stop_step(unit: u))
    && length(filter(host_cap_bracket_steps(unit: u), s => host_cap_step_reloads(step: s))) == 4
}

// Pairing: the typed steps render the SAME argv the actuator's plans send, so the effect table describes
// the real drain and activation, not a parallel list.
test fn the_typed_steps_render_the_actuators_argv() -> Bool {
  let u = unit(n: "01")
  systemctl_mask_step(unit: u).argv == systemctl_mask_argv(unit: u)
    && systemctl_unmask_step(unit: u).argv == systemctl_unmask_argv(unit: u)
    && systemctl_enable_step(unit: u).argv == systemctl_enable_argv(unit: u)
    && systemctl_start_step(unit: u).argv == systemctl_start_argv(unit: u)
    && systemctl_stop_step(unit: u).argv == systemctl_stop_argv(unit: u)
}

// RED (2): a pending or unknown unit-file change withholds in EVERY case -- differing caps, and also
// managed files settled with live caps at desired. A hand-placed instance drop-in
// (actions-runner@srv3-01.service.d/90-lower.conf, smaller MemoryMax, NeedDaemonReload=yes) is outside
// the four managed files, so "nothing differs" cannot vouch for it: the ordinary reload would load it
// onto a busy slot with no drain.
test fn a_pending_unit_file_change_always_withholds() -> Bool {
  plan_withheld_naming(p: host_cap_plan(standings: one_old(), files: CapFilesDiffer, pending_reloads: owed_01(), retirement_cause: none, extras: []), needle: "pending reload")
    && plan_withheld_naming(p: host_cap_plan(standings: one_at(), files: CapFilesDiffer, pending_reloads: owed_01(), retirement_cause: none, extras: []), needle: "pending reload")
    && plan_withheld_naming(p: host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: owed_01(), retirement_cause: none, extras: []), needle: "pending reload")
}

// RED: the instance-drop-in counterexample exactly -- managed files settled, live caps at desired, a
// pending reload, and a BUSY slot. It must withhold (and so bar the ordinary reload), not leave in place.
test fn a_hand_placed_instance_dropin_pending_on_a_busy_slot_bars_the_reload() -> Bool {
  let plan = host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: owed_01(), retirement_cause: none, extras: [])
  plan_withheld_naming(p: plan, needle: "pending reload") && !plan_leaves(p: plan)
}

fn owed_01() -> HostPendingReloads { HostReloadsPending { units: non_empty_singleton(item: UnitPendingReload { unit: unit(n: "01"), kind: PendingReloadOwed }) } }

fn pending_is(got: HostPendingReloads, kind: PendingReloadKind) -> Bool {
  match got {
    HostReloadsPending { units: xs } => length(non_empty_to_list(xs: xs)) == 1 && any(non_empty_to_list(xs: xs), u => (u.unit as String) == "actions-runner@srv3-01.service" && match u.kind { PendingReloadOwed => match kind { PendingReloadOwed => true PendingReloadUnobserved => false } PendingReloadUnobserved => match kind { PendingReloadUnobserved => true PendingReloadOwed => false } })
    HostNoReloadPending => false
    HostPopulationUnobserved { reason: _ } => false
  }
}

fn pending_none(got: HostPendingReloads) -> Bool { match got { HostNoReloadPending => true HostReloadsPending { units: _ } => false HostPopulationUnobserved { reason: _ } => false } }

// RED: the pending-reload reading is LOCATED and TYPED: each case carries the unit and which status it is
// (owed vs unobserved), a population that could not be listed is its own arm, and nothing pending is no list.
test fn the_pending_reload_reading_carries_each_unit_and_its_status() -> Bool {
  pending_is(got: runner_host_cap_pending_reloads(population: obs_with_reload(st: SlotTeardownEffective, rl: SlotReloadOwed), bracket_units: [unit(n: "01")]), kind: PendingReloadOwed)
    && pending_is(got: runner_host_cap_pending_reloads(population: obs_with_reload(st: SlotUnitUnread, rl: SlotReloadUnobserved), bracket_units: [unit(n: "01")]), kind: PendingReloadUnobserved)
    && (match runner_host_cap_pending_reloads(population: SlotPopulationUnobservable { reason: "x" }, bracket_units: [unit(n: "01")]) { HostPopulationUnobserved { reason: r } => r == "x" HostNoReloadPending => false HostReloadsPending { units: _ } => false })
    && pending_none(got: runner_host_cap_pending_reloads(population: obs_of(st: SlotTeardownEffective), bracket_units: [unit(n: "01")]))
}

// RED: the rendered refusal names the unit and the status, for both statuses.
test fn the_pending_reload_refusal_renders_the_unit_and_status() -> Bool {
  let owed = host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: runner_host_cap_pending_reloads(population: obs_with_reload(st: SlotTeardownEffective, rl: SlotReloadOwed), bracket_units: [unit(n: "01")]), retirement_cause: none, extras: [])
  let unobserved = host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: runner_host_cap_pending_reloads(population: obs_with_reload(st: SlotUnitUnread, rl: SlotReloadUnobserved), bracket_units: [unit(n: "01")]), retirement_cause: none, extras: [])
  plan_withheld_naming(p: owed, needle: "pending: actions-runner@srv3-01.service reload=owed")
    && plan_withheld_naming(p: unobserved, needle: "pending: actions-runner@srv3-01.service reload=unobserved")
}

// THE REAL OBSERVATION, END TO END. A loaded FABRIC member (srv3-06) running a job, with a hand-placed
// instance drop-in awaiting reload: the show block says LoadState=loaded NeedDaemonReload=yes. The
// fabric classification replaces the lifecycle standing (FabricMemberRunsARunner), and the reload fact
// must survive it: population -> pending projection -> host plan (caps matching, slot busy) -> reload
// admission. Starts from the show text, not from a supplied flag.
fn fabric_show(reload: String) -> String {
  join(["Id=actions-runner@srv3-06.service\nLoadState=loaded\nNeedDaemonReload=", reload, "\nExitType=main\nKillMode=control-group\nCPUQuotaPerSecUSec=7s\nEnvironment="], "")
}
fn fabric_population_of(show: String) -> RunnerSlotPopulation {
  let u = "actions-runner@srv3-06.service" as NonEmptyStr
  SlotPopulationObserved { units: classify_runner_slot_population_with_fabric(units: [u], fabric: [u], retirements: [], show_stdout: show, expect: runner_slot_expectation(per_slot: hardware_thread_count(count: 7), fragment_delivered: false, residue_absent: false)) }
}
fn fabric_plan_for(show: String) -> HostCapPlan {
  host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: runner_host_cap_pending_reloads(population: fabric_population_of(show: show), bracket_units: [unit(n: "01")]), retirement_cause: none, extras: [])
}
test fn a_pending_reload_on_a_loaded_fabric_member_survives_classification_and_withholds() -> Bool {
  let pop = fabric_population_of(show: fabric_show(reload: "yes"))
  let lifecycle_is_fabric = match pop { SlotPopulationObserved { units: us } => any(us, r => match r.standing { SlotFabricMemberRunsARunner => true _ => false }) SlotPopulationUnobservable { reason: _ } => false }
  lifecycle_is_fabric
    && !pending_none(got: runner_host_cap_pending_reloads(population: pop, bracket_units: [unit(n: "01")]))
    && plan_withheld_naming(p: fabric_plan_for(show: fabric_show(reload: "yes")), needle: "actions-runner@srv3-06.service reload=owed")
    && plan_withheld_naming(p: fabric_plan_for(show: fabric_show(reload: "yes")), needle: "pending reload")
    && runner_host_cap_phase_bars_reload(phase: CapPhaseWithheld { cause: "pending reload" })
}

// Positive: the same fabric member with nothing pending is not pending, and leaves the settled caps in place.
test fn a_loaded_fabric_member_with_no_pending_reload_leaves_settled_caps_in_place() -> Bool {
  pending_none(got: runner_host_cap_pending_reloads(population: fabric_population_of(show: fabric_show(reload: "no")), bracket_units: [unit(n: "01")]))
    && plan_leaves(p: fabric_plan_for(show: fabric_show(reload: "no")))
}

// RED: a fabric member with no show block is unobserved, which counts as pending.
test fn an_unread_fabric_member_counts_as_pending() -> Bool {
  plan_withheld_naming(p: fabric_plan_for(show: ""), needle: "actions-runner@srv3-06.service reload=unobserved")
}

// RED (3): a STOPPED unit whose loaded caps are stale is NeedRestart (its next start would run them), not
// a left-in-place stopped unit; a stopped unit at desired is Stopped.
test fn a_stopped_unit_with_stale_loaded_caps_needs_a_restart() -> Bool {
  let stale = SlotCapLive { unit_memory_max: "100", unit_swap_max: "0", unit_memory_high: "90", unit_tasks_max: "16384", control_group: "", cgroup_memory_max: none, cgroup_swap_max: none, cgroup_memory_high: none }
  match slot_cap_standing(live: stale, desired: desired()) {
    SlotCapsNeedRestart { detail: _ } => true
    SlotCapsStopped => false
    SlotCapsAtDesired => false
    SlotCapsReadingsDisagree { detail: _ } => false
    SlotCapsUnread { cause: _ } => false
  }
}

// RED (4, narrowed): an incomplete retiree withholds a DIFFERING cap (the host is not quiescent) -- typed,
// not a cycle, because a withheld phase on a host whose caps are all settled does not arise.
test fn an_incomplete_retiree_withholds_a_differing_cap_and_not_a_settled_one() -> Bool {
  plan_withheld_naming(p: host_cap_plan(standings: one_old(), files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: Present { value: "surplus slots have not retired: 05" }, extras: []), needle: "surplus slots have not retired: 05")
    && plan_leaves(p: host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: HostNoReloadPending, retirement_cause: Present { value: "surplus slots have not retired: 05" }, extras: []))
}

fn obs_of(st: RunnerSlotUnitStanding) -> RunnerSlotPopulation { obs_with_reload(st: st, rl: SlotReloadNotPending) }
fn obs_with_reload(st: RunnerSlotUnitStanding, rl: SlotReloadStatus) -> RunnerSlotPopulation { SlotPopulationObserved { units: [RunnerSlotUnitResult { unit: unit(n: "01"), standing: st, reload: rl, reach: ReachesLiveCgroup }] } }

// THE MASKED FABRIC MEMBER, FROM REAL SHOW TEXT (the srv3-07 / srv4-06 shape): masked, inactive, no cgroup,
// still owing a reload. `active` and `load` vary the one fact each RED turns on.
fn masked_show(load: String, active: String, cgroup: String) -> String {
  masked_show_reload(load: load, active: active, cgroup: cgroup, reload: "yes")
}
fn masked_show_reload(load: String, active: String, cgroup: String, reload: String) -> String {
  join(["Id=actions-runner@srv3-06.service\nLoadState=", load, "\nNeedDaemonReload=", reload, "\nExitType=main\nKillMode=control-group\nActiveState=", active, "\nControlGroup=", cgroup, "\nCPUQuotaPerSecUSec=7s\nEnvironment="], "")
}
fn masked_plan_for(show: String) -> HostCapPlan {
  host_cap_plan(standings: one_at(), files: CapFilesSettled, pending_reloads: runner_host_cap_pending_reloads(population: fabric_population_of(show: show), bracket_units: [unit(n: "01")]), retirement_cause: none, extras: [])
}

// Positive: an Owed reload on a unit that is masked, inactive and has no cgroup cannot load onto anything,
// so the caps are not withheld on it (settled caps are left in place); the very same population still reports the reload as owed by status.
test fn a_masked_inactive_cgroupless_owed_unit_does_not_withhold_the_caps() -> Bool {
  let show = masked_show(load: "masked", active: "inactive", cgroup: "")
  pending_none(got: runner_host_cap_pending_reloads(population: fabric_population_of(show: show), bracket_units: [unit(n: "01")]))
    && plan_leaves(p: masked_plan_for(show: show))
}

// RED: masked but still ACTIVE (a cgroup exists) is not inert.
test fn a_masked_but_active_owed_unit_still_withholds() -> Bool {
  plan_withheld_naming(p: masked_plan_for(show: masked_show(load: "masked", active: "active", cgroup: "/system.slice/x")), needle: "actions-runner@srv3-06.service reload=owed")
    && plan_withheld_naming(p: masked_plan_for(show: masked_show(load: "masked", active: "inactive", cgroup: "/system.slice/x")), needle: "reload=owed")
}

// RED: inactive but not masked (it can be started, loading the pending change) still withholds.
test fn an_unmasked_inactive_owed_unit_still_withholds() -> Bool {
  plan_withheld_naming(p: masked_plan_for(show: masked_show(load: "loaded", active: "inactive", cgroup: "")), needle: "actions-runner@srv3-06.service reload=owed")
}

// RED: a masked inactive unit that is IN the bracket's set is not excluded -- activation unmasks it.
test fn an_inert_owed_unit_inside_the_bracket_set_still_withholds() -> Bool {
  let u = "actions-runner@srv3-06.service" as NonEmptyStr
  !pending_none(got: runner_host_cap_pending_reloads(population: fabric_population_of(show: masked_show(load: "masked", active: "inactive", cgroup: "")), bracket_units: [u]))
}

// RED: a masked unit with a missing ActiveState/ControlGroup key is not proven inert.
test fn a_masked_unit_missing_its_activity_keys_still_withholds() -> Bool {
  let show = "Id=actions-runner@srv3-06.service\nLoadState=masked\nNeedDaemonReload=yes\nExitType=main\nKillMode=control-group\nCPUQuotaPerSecUSec=7s\nEnvironment="
  plan_withheld_naming(p: masked_plan_for(show: show), needle: "reload=owed")
}

// THE EXTRAS ARM FROM REAL SHOW TEXT, THROUGH EVERY ARM (the srv3-07 / srv4-06 shape). One declared slot
// (srv3-01, caps differ, idle) and one loaded extra outside the declared sets whose own show block varies
// the one fact each case turns on. Population -> extras -> pending reloads -> host plan, no supplied flag.
fn declared_show() -> String {
  "Id=actions-runner@srv3-01.service\nLoadState=loaded\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group\nActiveState=active\nControlGroup=/system.slice/y\nCPUQuotaPerSecUSec=7s\nEnvironment="
}
fn extras_population_of(extra_show: String) -> RunnerSlotPopulation { extras_population_with(extra_show: extra_show, as_fabric: true) }
fn extras_population_with(extra_show: String, as_fabric: Bool) -> RunnerSlotPopulation {
  let d = unit(n: "01")
  let x = "actions-runner@srv3-06.service" as NonEmptyStr
  SlotPopulationObserved { units: classify_runner_slot_population_with_fabric(units: [d, x], fabric: if as_fabric { [x] } else { [] }, retirements: [], show_stdout: join([declared_show(), extra_show], "\n\n"), expect: runner_slot_expectation(per_slot: hardware_thread_count(count: 7), fragment_delivered: false, residue_absent: false)) }
}
fn extras_plan_for(extra_show: String) -> HostCapPlan { extras_plan_with(extra_show: extra_show, as_fabric: true) }
fn extras_plan_with(extra_show: String, as_fabric: Bool) -> HostCapPlan {
  let pop = extras_population_with(extra_show: extra_show, as_fabric: as_fabric)
  host_cap_plan(standings: one_old(), files: CapFilesDiffer, pending_reloads: runner_host_cap_pending_reloads(population: pop, bracket_units: [unit(n: "01")]), retirement_cause: none, extras: runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: pop))
}

// Positive: the inert masked extra is no hazard in ANY arm -- the caps proceed to the bracket.
test fn an_inert_masked_extra_goes_through_every_arm_and_the_caps_proceed() -> Bool {
  let show = masked_show(load: "masked", active: "inactive", cgroup: "")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_of(extra_show: show))) == 0
    && pending_none(got: runner_host_cap_pending_reloads(population: extras_population_of(extra_show: show), bracket_units: [unit(n: "01")]))
    && plan_drains(p: extras_plan_for(extra_show: show))
}

// RED: masked but ACTIVE (a live cgroup) withholds, naming the unit.
test fn a_masked_but_active_extra_withholds() -> Bool {
  plan_withheld_naming(p: extras_plan_for(extra_show: masked_show(load: "masked", active: "active", cgroup: "/system.slice/x")), needle: "actions-runner@srv3-06.service")
}

// RED: an unmasked extra withholds even when inactive and cgroupless.
test fn an_unmasked_extra_withholds() -> Bool {
  plan_withheld_naming(p: extras_plan_for(extra_show: masked_show(load: "loaded", active: "inactive", cgroup: "")), needle: "actions-runner@srv3-06.service")
}

// RED: a missing key is not inert, so the extra withholds.
test fn an_extra_missing_its_activity_keys_withholds() -> Bool {
  let show = "Id=actions-runner@srv3-06.service\nLoadState=masked\nNeedDaemonReload=yes\nExitType=main\nKillMode=control-group\nCPUQuotaPerSecUSec=7s\nEnvironment="
  plan_withheld_naming(p: extras_plan_for(extra_show: show), needle: "actions-runner@srv3-06.service")
}

// THE REACH FACT ALONE GOVERNS AN EXTRA, with NeedDaemonReload=no so no pending-reload arm refuses first.
fn no_reload_missing_keys_show() -> String {
  "Id=actions-runner@srv3-06.service\nLoadState=masked\nNeedDaemonReload=no\nExitType=main\nKillMode=control-group\nCPUQuotaPerSecUSec=7s\nEnvironment="
}

// RED (a): a non-fabric masked-ACTIVE extra with nothing owed stays in extras and withholds by unit name.
test fn a_non_fabric_masked_active_extra_without_a_pending_reload_withholds() -> Bool {
  let show = masked_show_reload(load: "masked", active: "active", cgroup: "/system.slice/x", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: show, as_fabric: false))) == 1
    && plan_withheld_naming(p: extras_plan_with(extra_show: show, as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// Positive (b): the masked, inactive, cgroupless non-fabric extra with nothing owed is no hazard.
test fn a_non_fabric_inert_extra_without_a_pending_reload_is_no_hazard() -> Bool {
  let show = masked_show_reload(load: "masked", active: "inactive", cgroup: "", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: show, as_fabric: false))) == 0
    && plan_drains(p: extras_plan_with(extra_show: show, as_fabric: false))
}

// RED (c): missing activity keys with nothing owed are not inert, fabric or not.
test fn a_non_fabric_extra_missing_activity_keys_without_a_pending_reload_withholds() -> Bool {
  plan_withheld_naming(p: extras_plan_with(extra_show: no_reload_missing_keys_show(), as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// (d): fabric classification alone does not change the reach decision for the same unit.
test fn fabric_classification_alone_does_not_change_the_extras_decision() -> Bool {
  let active = masked_show_reload(load: "masked", active: "active", cgroup: "/system.slice/x", reload: "no")
  let inert = masked_show_reload(load: "masked", active: "inactive", cgroup: "", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: active, as_fabric: true)))
      == length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: active, as_fabric: false)))
    && length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: inert, as_fabric: true)))
      == length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: inert, as_fabric: false)))
}

// Positive: reach is "no loaded config AND no cgroup", not masked-ness. A not-found, inactive, cgroupless
// non-fabric extra has nothing for a reload to apply to, so it is admitted.
test fn a_non_fabric_not_found_inactive_cgroupless_extra_is_no_hazard() -> Bool {
  let show = masked_show_reload(load: "not-found", active: "inactive", cgroup: "", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: show, as_fabric: false))) == 0
    && plan_drains(p: extras_plan_with(extra_show: show, as_fabric: false))
}

// RED: a not-found but ACTIVE extra (a live cgroup) is still reached, and withholds by unit name.
test fn a_non_fabric_not_found_active_extra_withholds() -> Bool {
  let show = masked_show_reload(load: "not-found", active: "active", cgroup: "/system.slice/x", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: show, as_fabric: false))) == 1
    && plan_withheld_naming(p: extras_plan_with(extra_show: show, as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// Positive: a LOADED, inactive, cgroupless extra is still reached (it can be started), unchanged.
test fn a_non_fabric_loaded_inactive_cgroupless_extra_still_withholds() -> Bool {
  let show = masked_show_reload(load: "loaded", active: "inactive", cgroup: "", reload: "no")
  plan_withheld_naming(p: extras_plan_with(extra_show: show, as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// RED (fail-closed): an unrecognized LoadState word is not proof of "no unit file", so an inactive,
// cgroupless extra with it is still reached.
test fn a_non_fabric_unknown_load_state_extra_withholds() -> Bool {
  let show = masked_show_reload(load: "lodaed", active: "inactive", cgroup: "", reload: "no")
  plan_withheld_naming(p: extras_plan_with(extra_show: show, as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// RED: bad-setting and error leave a unit file a reload re-reads and may load, so they are reached.
test fn a_non_fabric_bad_setting_or_error_extra_withholds() -> Bool {
  plan_withheld_naming(p: extras_plan_with(extra_show: masked_show_reload(load: "bad-setting", active: "inactive", cgroup: "", reload: "no"), as_fabric: false), needle: "actions-runner@srv3-06.service")
    && plan_withheld_naming(p: extras_plan_with(extra_show: masked_show_reload(load: "error", active: "inactive", cgroup: "", reload: "no"), as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// Positive: the masked inactive cgroupless extra with nothing owed stays inert.
test fn a_non_fabric_masked_inactive_cgroupless_extra_stays_inert() -> Bool {
  let show = masked_show_reload(load: "masked", active: "inactive", cgroup: "", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: show, as_fabric: false))) == 0
}

// RED: a not-found extra that is inactive but still holds a cgroup is reached, and withholds by unit name.
test fn a_non_fabric_not_found_inactive_extra_with_a_cgroup_withholds() -> Bool {
  let show = masked_show_reload(load: "not-found", active: "inactive", cgroup: "/system.slice/x", reload: "no")
  length(runner_host_cap_extras(desired_units: [unit(n: "01")], retired_units: [], population: extras_population_with(extra_show: show, as_fabric: false))) == 1
    && plan_withheld_naming(p: extras_plan_with(extra_show: show, as_fabric: false), needle: "actions-runner@srv3-06.service")
}

// ==================== THE BRACKET HOLDER: NEVER CLAIMED CONVERGED ON ITS SAY-SO ====================
// THE WALL THIS PR BUILDS ON, AND THE ASSUMPTION IT REFUSES TO MAKE. srv3's converge job runs ON a slot it
// manages, and a slot cannot stop/start the job running on it -- so the holder's caps can only be applied by
// the one host-wide daemon-reload. Whether a reload applies MemoryMax/MemoryHigh to a RUNNING unit's live
// cgroup is NOT assumed: srv1 and srv2 prove nothing here, because they received their caps through the
// stop/start bracket. So the holder counts as converged ONLY when memory.max, memory.swap.max and memory.high
// all read back from its LIVE cgroup equal the desired values; anything else is typed deferred, named loudly
// on the wire, never reported converged -- and the next pass, dispatched from a DIFFERENT slot, brackets it
// through the normal stop/start route. (Fleet slot ruling, parent 2026-10-24.)

// THE READER'S THREE ROWS, AT THE VALUES THE FLEET WANTS. The drop-in sets all three, so all three must
// return; a reading that only carries the shared standing's max+swap pair is NOT a converged holder.
fn holder_live(max: String, swap: String, high: String?) -> SlotCapLive {
  SlotCapLive {
    unit_memory_max: to_string(byte_size_count(b: desired().memory_max)),
    unit_swap_max: to_string(byte_size_count(b: desired().memory_swap_max)),
    unit_memory_high: to_string(byte_size_count(b: desired().memory_high)),
    unit_tasks_max: to_string(desired().tasks_max),
    control_group: "/system.slice/actions-runner@srv3-02.service",
    cgroup_memory_max: Present { value: concat(max, "\n") },
    cgroup_swap_max: Present { value: concat(swap, "\n") },
    cgroup_memory_high: high,
  }
}

fn holder_at_desired_rows() -> SlotCapLive {
  holder_live(max: to_string(byte_size_count(b: desired().memory_max)), swap: to_string(byte_size_count(b: desired().memory_swap_max)), high: Present { value: concat(to_string(byte_size_count(b: desired().memory_high)), "\n") })
}

test fn a_holder_whose_live_cgroup_reads_back_at_desired_is_converged_and_settled() -> Bool {
  match slot_cap_holder_verdict(unit: unit(n: "02"), live: holder_at_desired_rows(), desired: desired()) {
    SlotCapsSelfAtDesired { unit: u } => (u as String) == "actions-runner@srv3-02.service" && slot_cap_outcome_settled(o: SlotCapsSelfAtDesired { unit: u })
    _ => false
  }
}

// RED (the parent's named claim): the holder is NOT read back -- here it carries only the max+swap pair the
// shared standing reads, with no memory.high row at all -- so it is DEFERRED, is not settled, and the wire
// says so; and a deferred holder alone still lets the host's reload proceed (the run-level fold), because
// the deferral is an obligation for the NEXT pass, not a reason to withhold this host's caps.
test fn a_holder_not_read_back_is_deferred_never_converged_yet_never_bars_the_host() -> Bool {
  let owed = holder_live(max: to_string(byte_size_count(b: desired().memory_max)), swap: to_string(byte_size_count(b: desired().memory_swap_max)), high: none)
  let def = slot_cap_holder_verdict(unit: unit(n: "02"), live: owed, desired: desired(), ledger: LedgerFresh)
  match def {
    SlotCapsSelfDeferred { unit: u, detail: _ } =>
      (u as String) == "actions-runner@srv3-02.service"
        && !slot_cap_outcome_settled(o: def)
        && slot_cap_outcome_host_settled(o: def)
        && string_contains(s: slot_cap_outcome_wire(o: def), pattern: "DEFERRED-SELF")
        && string_contains(s: slot_cap_outcome_wire(o: def), pattern: "actions-runner@srv3-02.service")
    _ => false
  }
}

// RED: max read back at the OLD host-wide value (the srv3 observed-owed shape) is owed, not converged --
// the deferred detail names what was read against what was wanted, so the operator sees WHY.
test fn a_holder_reading_stale_values_is_deferred_naming_the_disagreement() -> Bool {
  let stale = holder_live(max: "27917287424", swap: "34359738368", high: Present { value: concat(to_string(byte_size_count(b: desired().memory_high)), "\n") })
  match slot_cap_holder_verdict(unit: unit(n: "02"), live: stale, desired: desired(), ledger: LedgerFresh) {
    SlotCapsSelfDeferred { unit: u, detail: d } =>
      (u as String) == "actions-runner@srv3-02.service" && !slot_cap_outcome_settled(o: SlotCapsSelfDeferred { unit: u, detail: d })
        && string_contains(s: d, pattern: "27917287424") && string_contains(s: d, pattern: to_string(byte_size_count(b: desired().memory_max)))
    _ => false
  }
}

// RED: an unreadable holder reading (no cgroup rows at all) is deferred too, not converged: the absence of
// evidence is never evidence of application. (The unread shape the shared parser produces for a dead unit.)
test fn an_unreadable_holder_is_deferred_not_converged() -> Bool {
  let unread = SlotCapLive { unit_memory_max: "", unit_swap_max: "", unit_memory_high: "", unit_tasks_max: "", control_group: "", cgroup_memory_max: none, cgroup_swap_max: none, cgroup_memory_high: none }
  match slot_cap_holder_verdict(unit: unit(n: "02"), live: unread, desired: desired(), ledger: LedgerFresh) {
    SlotCapsSelfDeferred { unit: u, detail: _ } => (u as String) == "actions-runner@srv3-02.service" && !slot_cap_outcome_settled(o: SlotCapsSelfDeferred { unit: u, detail: "x" })
    _ => false
  }
}

// THE RUN STILL SETTLES AROUND A DEFERRED HOLDER. A pass that restarted every bracketed slot and left the
// holder deferred is a converged run minus one named obligation: the reload proceeds, the phase settles,
// and the deferred unit is still LISTED on the wire (the text fold reads the per-unit settledness, so an
// operator sees the outstanding name). Swap in a REFUSED slot and the run-level fold bars: deferral is
// specific, not a blanket pass.
test fn a_ran_phase_with_a_deferred_holder_settles_and_lists_the_debt() -> Bool {
  let deferred = SlotCapsSelfDeferred { unit: unit(n: "02"), detail: "memory.high not read back" }
  runner_host_cap_phase_settled(phase: ran_with(rl: ManagerReloaded, slots: [SlotCapsRestartedAndRead { unit: unit(n: "01") }, deferred]))
    && !slot_cap_outcome_settled(o: deferred)
    && string_contains(s: runner_host_cap_phase_text(phase: ran_with(rl: ManagerReloaded, slots: [SlotCapsRestartedAndRead { unit: unit(n: "01") }, deferred])), pattern: "actions-runner@srv3-02.service")
    && !runner_host_cap_phase_settled(phase: ran_with(rl: ManagerReloaded, slots: [SlotCapsRefused { unit: unit(n: "01"), step: "live-readback", reason: "x" }]))
}

// THE BOUND, CLAIMED (DESIGN §4b meta-obligation 2 / §5, review 86146): a deferral must name its
// next-rung trigger AND be countable. The host ledger (runner_host_cap_bracket) carries the count;
// this fold turns each count into a typed verdict: under the bound, deferred with the pass number;
// AT the bound, a REFUSAL -- red, unsettled at both levels, obligation held -- because a holder that
// has been deferred across the bound's worth of passes means the next rung was never taken (placement
// is stuck on this slot, or the reload does not apply caps to live cgroups: only an operator, with
// set-property as break-glass, stands between this and a bracket from another slot).
fn owed_live() -> SlotCapLive {
  holder_live(max: "27917287424", swap: "34359738368", high: Present { value: "34359738368\n" })
}

test fn the_first_deferral_counts_pass_one_of_the_bound() -> Bool {
  match slot_cap_holder_deferral_outcome(ledger: LedgerFresh, unit: unit(n: "02"), live: owed_live(), desired: desired()) {
    SlotCapsSelfDeferred { unit: u, detail: d } =>
      (u as String) == "actions-runner@srv3-02.service"
        && string_contains(s: d, pattern: "pass 1 of 3")
        && string_contains(s: d, pattern: "DIFFERENT slot")
    _ => false
  }
}

test fn the_last_deferral_before_the_bound_still_defers_and_says_so() -> Bool {
  match slot_cap_holder_deferral_outcome(ledger: LedgerCount { prior: slot_cap_holder_deferral_bound - 1 }, unit: unit(n: "02"), live: owed_live(), desired: desired()) {
    SlotCapsSelfDeferred { unit: _, detail: d } => string_contains(s: d, pattern: concat("pass ", to_string(slot_cap_holder_deferral_bound), " of ", to_string(slot_cap_holder_deferral_bound)))
    _ => false
  }
}

// RED AT THE BOUND: no more green deferral. Refused, unsettled at both levels, and the reason says
// how many passes were spent and what the operator's options are.
test fn a_holder_deferred_past_the_bound_is_refused_not_deferred() -> Bool {
  let r = slot_cap_holder_deferral_outcome(ledger: LedgerCount { prior: slot_cap_holder_deferral_bound }, unit: unit(n: "02"), live: owed_live(), desired: desired())
  match r {
    SlotCapsRefused { unit: u, step: s, reason: why } =>
      (u as String) == "actions-runner@srv3-02.service"
        && s == "holder-live-read"
        && !slot_cap_outcome_settled(o: r)
        && !slot_cap_outcome_host_settled(o: r)
        && string_contains(s: why, pattern: "3 consecutive passes")
        && string_contains(s: why, pattern: "break-glass")
    _ => false
  }
}

// AN UNREADABLE LEDGER IS RED, NOT A FREE PASS (review 86323, finding 1; DESIGN §5: an uncounted
// degradation is a hard reject). The file that cannot be read is never rewritten by the pass that
// failed to read it, so a deferral here would be read back forever and the bound above could never
// fire. The fold refuses, naming the cause; the bracket pass then RESETS the ledger (loud counted step).
test fn an_unreadable_ledger_refuses_instead_of_deferring_forever() -> Bool {
  let r = slot_cap_holder_deferral_outcome(ledger: LedgerUnwritable { cause: "not a JSON document" }, unit: unit(n: "02"), live: owed_live(), desired: desired())
  match r {
    SlotCapsHolderLedgerRefused { unit: u, cause: why } =>
      (u as String) == "actions-runner@srv3-02.service"
        && !slot_cap_outcome_settled(o: r)
        && !slot_cap_outcome_host_settled(o: r)
        && string_contains(s: why, pattern: "not a JSON document")
        && string_contains(s: why, pattern: "resets the ledger")
    _ => false
  }
}
