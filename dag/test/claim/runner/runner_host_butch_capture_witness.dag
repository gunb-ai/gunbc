fn butch_capture_desired_units() -> List<NonEmptyStr> {
  match committed_slot_identities(host: butch_capture_host()) {
    CommittedPopulationDerived { members: members } => map(members, s => runner_slot_unit_name(slot: s))
    CommittedPopulationWidthUnresolved { host: _, cause: _ } => []
  }
}

fn butch_capture_slot_unit() -> String {
  match sole_where(butch_capture_desired_units(), u => string_contains(s: u as String, pattern: "actions-runner@")) {
    SoleMatchOne { value: u } => u as String
    _ => ""
  }
}

// ───────────────────────────────── THE CLAIMS ─────────────────────────────────
// THE CAPTURE IS THE HOST THE RUN REFUSED ON, AND IT COVERS THE DERIVED DESIRED SLOT EXACTLY ONCE.
// (butch's width is DERIVED -- committed_slot_identities is the fold, so this fixture cannot pin a
// hand-numbered slot.)
test fn the_capture_is_butch_from_the_refused_run_and_covers_every_desired_slot() -> Bool {
  match sole_where(butch_capture_desired_units(), u => string_contains(s: u as String, pattern: "actions-runner@")) {
    SoleMatchOne { value: unit } =>
      length(butch_capture_desired_units()) == 1
        && (unit as String) == "actions-runner@srv14-01.service"
        && string_contains(s: butch_capture_slot_show(), pattern: "Id=actions-runner@srv14-01.service")
        && string_contains(s: butch_capture_slot_show(), pattern: "NeedDaemonReload=yes")
        && string_contains(s: butch_capture_slot_show(), pattern: "ActiveState=inactive")
    _ => false
  }
}

fn capture_units() -> List<NonEmptyStr> { butch_capture_desired_units() }

fn capture_population(show: String) -> RunnerSlotPopulation {
  SlotPopulationObserved { units: classify_runner_slot_population(units: capture_units(), retirements: [], show_stdout: show, expect: runner_slot_expectation(per_slot: hardware_thread_count(count: 72), fragment_delivered: true, residue_absent: false)) }
}

// THE CAPTURED BYTES PARSE THE WAY PRODUCTION PARSES THEM AND READ INERT: stopped, empty control
// group, no process -- and the reload read says PENDING. NeedDaemonReload is the field the hand-built
// #16457 fixture missed.
test fn the_capture_reads_inert_with_a_pending_reload() -> Bool {
  match sole_where(capture_units(), u => string_contains(s: u as String, pattern: "actions-runner@")) {
    SoleMatchOne { value: unit } =>
      match slot_actuation_reading_of(unit: unit, show_stdout: butch_capture_slot_show()) {
        Absent => false
        Present { value: SlotReadingUnknownWord { property: _, raw: _ } } => false
        Present { value: SlotReadingTyped { reading: r } } =>
          match r.active {
            Inactive =>
              slot_unit_inert_in_show(unit: unit, show_stdout: butch_capture_slot_show())
                && (match slot_reload_status_for(unit: unit, show_stdout: butch_capture_slot_show()) { SlotReloadOwed => true _ => false })
                && (match slot_reload_reach_for(unit: unit, show_stdout: butch_capture_show_proxy(unit: unit)) { ReloadInert => true _ => false })
            _ => false
          }
      }
    _ => false
  }
}

fn butch_capture_show_proxy(unit: NonEmptyStr) -> String { butch_capture_slot_show() }

// ABSENCE IS A FACT, NOT A FAILURE: the listing's own ENOENT words prove TreeAbsent, and the slot --
// no process, proven-absent tree -- is SlotNotInstantiated, queued for its first install. RED CONTROL:
// sudo's own refusal words read TreePresenceUnreadable, never absent.
test fn the_capture_tree_is_proven_absent_and_the_slot_queued_for_first_install() -> Bool {
  let presence = classify_runner_slot_tree_presence(exit_code: butch_capture_tree_ls_exit(), stdout: butch_capture_tree_parent_stdout(), stderr: butch_capture_tree_ls_stderr(), entry: "actions-runner")
  let refusal = classify_runner_slot_tree_presence(exit_code: 1, stdout: "", stderr: "sudo: a password is required", entry: "actions-runner")
  match sole_where(capture_units(), u => string_contains(s: u as String, pattern: "actions-runner@")) {
    SoleMatchOne { value: unit } =>
      match presence {
        TreeAbsent =>
          match refusal {
            TreePresenceUnreadable { cause: _ } =>
              match the_capture_instantiation(unit: unit, presence: presence) {
                SlotNotInstantiated => !runner_slot_instantiation_is_instantiated(instantiation: the_capture_instantiation(unit: unit, presence: presence))
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn the_capture_instantiation(unit: NonEmptyStr, presence: RunnerSlotTreePresence) -> RunnerSlotInstantiation {
  match slot_actuation_reading_of(unit: unit, show_stdout: butch_capture_slot_show()) {
    Present { value: SlotReadingTyped { reading: r } } => runner_slot_instantiation(unit: unit, read: SlotRead { reading: r }, presence: presence)
    _ => runner_slot_instantiation(unit: unit, read: SlotReadRefused { reason: "the capture must parse" }, presence: presence)
  }
}

// THE CAP PHASE'S OWN PENDING QUESTION NO LONGER HOLDS FOR BUTCH (run 43561214659 died two doors
// before this fix): the pending slot is queued for its first install, so the bracket never unmasks and
// starts it -- cap_bracket_units, the ONE set function, says so, and the cap phase's pending question,
// asked over THAT set, answers nothing-reaches-activation. Before the fix, desired_units were passed as
// bracket_units (over-bracketing a slot the bracket will never activate) and the phase withheld.
test fn the_cap_phase_pending_question_clears_once_the_bracket_set_is_the_one_set() -> Bool {
  match sole_where(capture_units(), u => string_contains(s: u as String, pattern: "actions-runner@")) {
    SoleMatchOne { value: unit } =>
      match runner_host_cap_pending_reloads(population: capture_population(show: butch_capture_slot_show()), bracket_units: cap_bracket_units(units: capture_units(), holder: HolderNotOnSubject { why: "srv14 is CI only; the fleet-converge job runs on srv1" }, trees: [RunnerSlotTreeQueuedForFirstInstall { unit: unit }])) {
        HostNoReloadPending => true
        _ => false
      }
    _ => false
  }
}

// RUN 1, DRIVEN THROUGH THE ONE ORDERING FUNCTION FROM THESE BYTES. The cap phase (previous claim)
// does not withhold; the population is butch's exact refused state; the run changes unit sources.
// The decisions must be: reload ATTEMPTED (not OwedNotAttempted -- the deadlock of run 43561214659),
// actuation ADMITTED (enable+start for srv14-01; a slot queued for first install takes its caps from
// the drop-ins at that first load), manager reload ATTEMPTED. Nothing withheld: the ordering terminal
// is not REFUSED. (The success VERDICT's effect receipts -- writes, start, health -- carry
// sole_constructor values only a live run can produce; this claim drives every DECISION, the live
// phase supplies the receipts.)
test fn run1_from_the_capture_attempts_the_reload_and_admits_the_first_start() -> Bool {
  let ordering = runner_host_reload_ordering(cap_phase: CapPhaseRan { files: [], reload: ManagerReloadNotOwed, slots: [], certified: [] }, population: capture_population(show: butch_capture_slot_show()), results: [], also_changed: true)
  match ordering.pre {
    PreReloadAttempt =>
      match ordering.admission {
        ActuationAdmitted =>
          match ordering.manager {
            ManagerGateAttempt => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

// RUN 2, THE SAME CAPTURE WITH THE PENDING WORD CLEARED (the state after run 1's reload landed): the
// pre gate owes nothing, the admission still admits, the manager step finds nothing pending in its own
// late read (has_pending is false). The design is not perpetually owed; it SETTLES.
test fn run2_from_the_post_reload_capture_owes_nothing_and_settles() -> Bool {
  let ordering = runner_host_reload_ordering(cap_phase: CapPhaseRan { files: [], reload: ManagerReloadNotOwed, slots: [], certified: [] }, population: capture_population(show: butch_capture_slot_show_after_reload()), results: [], also_changed: false)
  match ordering.pre {
    PreReloadNotOwed =>
      match ordering.manager {
        ManagerGateAttempt =>
          match ordering.admission {
            ActuationAdmitted => !runner_slot_population_has_pending_reload_read(population: capture_population(show: butch_capture_slot_show_after_reload()))
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

// THE RED CONTROL THROUGH THE EXTRACTED FUNCTION (ruling msg_8d792a3c item 3): a RUNNING, undrained slot
// with a pending change on a host whose caps are withheld -- the ordering withholds the pre reload,
// SKIPS actuation, and withholds the manager reload. The safety did not widen with the generality.
test fn a_running_undrained_pending_slot_with_a_withheld_cap_phase_refuses_everything() -> Bool {
  let busy = SlotPopulationObserved { units: [slot_rec(u: "actions-runner@srv1-01.service", status: SlotReloadOwed, reach: ReachesLiveCgroup)] }
  let ordering = runner_host_reload_ordering(cap_phase: CapPhaseWithheld { cause: "drain refused" }, population: busy, results: [], also_changed: false)
  match ordering.pre {
    PreReloadWithheld { reason: _ } =>
      match ordering.admission {
        ActuationSkipped { cause: _ } =>
          match ordering.manager {
            ManagerGateWithheld { reason: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn slot_rec(u: String, status: SlotReloadStatus, reach: SlotReloadReach) -> RunnerSlotUnitResult {
  RunnerSlotUnitResult { unit: u as NonEmptyStr, standing: SlotTeardownEffective, reload: status, reach: reach }
}

// NO STRATA ANYWHERE IN WHAT THE PLAN ITSELF NAMES FOR SRV14 (parent item 2): the managed cap files,
// the superseded drop-in paths, the control-shadow paths, and every unit the phase brackets or
// actuates -- all DERIVED from the model's srv14 subject, not from a list this test hand-wrote. A
// future write set that names a strata unit turns THIS claim red.
test fn the_plan_for_srv14_names_no_strata_unit_or_path_anywhere() -> Bool {
  match runner_host_file_subject(host: butch_capture_host()) {
    RunnerHostFileSubjectAdmitted { subject: s } =>
      let units = concat(map(s.desired_units, u => u as String), map(s.retired_units, u => u as String))
      let paths = concat(
        concat(map(runner_host_cap_files(host: s.host), f => f.path as String), runner_host_superseded_dropin_paths(host: s.host)),
        runner_host_control_shadow_paths(subject: s),
      )
      length(units) > 0
        && length(paths) > 0
        && all(units, u => !string_contains(s: u, pattern: "strata"))
        && all(paths, p => !string_contains(s: p, pattern: "strata"))
        && all(cap_bracket_units(units: s.desired_units, holder: HolderNotOnSubject { why: "the job runs on srv1" }, trees: []), u => !string_contains(s: u as String, pattern: "strata"))
    RunnerHostFileSubjectRefused { cause: _ } => false
  }
}
