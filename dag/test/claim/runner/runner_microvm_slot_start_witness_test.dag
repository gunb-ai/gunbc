module test.claim.runner.runner_microvm_slot_start_witness_test

import std.types { String, NonEmptyStr, Bool }
import std.measure { second }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.runner_microvm_slot_start {
  MicrovmSlotStartRun, SlotStartWrongHost, SlotStartRefused, SlotStartInvocationUnread,
  SlotStartAlreadyActive, SlotStartInvocationUnchanged, UnitPropertyRead, UnitPropertyUnread,
  SlotStartStillActiveAtBound, SlotStartCompleted,
  ControllerReceiptRead, ControllerReceiptUnreadable,
  microvm_slot_start_admitted, microvm_invocation_observation,
  MicrovmInvocationWait, InvocationTerminated, InvocationStillRunning, InvocationWaitRefused,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data u: NonEmptyStr = "gunbc-microvm-slot@srv1-13.service" as NonEmptyStr
data inv: NonEmptyStr = "0123abcd" as NonEmptyStr

// THE START SUCCEEDS ONLY WHEN THIS INVOCATION'S CONTROLLER RECEIPT WAS READ, whatever it says. The
// red set is every other arm: a wrong host, a refused start, an unread invocation, a unit ALREADY ACTIVE
// before the start or one whose InvocationID did not change across it (either would mean reading an
// EARLIER start's receipt as this one's, review 70683), a unit still running
// at its own bound, and -- the subtle one -- a unit that completed but whose receipt could not be read,
// which is a start with no evidence of what the attempt did.
test fn a_start_is_admitted_only_with_this_invocations_controller_receipt() -> Bool {
  microvm_slot_start_admitted(r: SlotStartCompleted { unit: u, invocation_id: inv, exec_main_status: UnitPropertyRead { value: "1" }, controller_receipt: ControllerReceiptRead { path: "/p", text: "refused: CellNotBound x" } })
    && !microvm_slot_start_admitted(r: SlotStartCompleted { unit: u, invocation_id: inv, exec_main_status: UnitPropertyUnread { property: "ExecMainStatus" as NonEmptyStr, detail: "x" }, controller_receipt: ControllerReceiptUnreadable { path: "/p", detail: "EACCES" } })
    && !microvm_slot_start_admitted(r: SlotStartWrongHost { detail: "srv2" })
    && !microvm_slot_start_admitted(r: SlotStartRefused { unit: u, detail: "x" })
    && !microvm_slot_start_admitted(r: SlotStartInvocationUnread { unit: u, detail: "x" })
    && !microvm_slot_start_admitted(r: SlotStartAlreadyActive { unit: u, invocation: UnitPropertyRead { value: "earlier" } })
    && !microvm_slot_start_admitted(r: SlotStartInvocationUnchanged { unit: u, invocation_id: inv })
    && !microvm_slot_start_admitted(r: SlotStartStillActiveAtBound { unit: u, invocation_id: inv, bound: second(count: 10) })
}

fn invocation_wait_refused(result: MicrovmInvocationWait) -> Bool {
  match result { InvocationWaitRefused { detail: _ } => true _ => false }
}

test fn changed_invocation_cannot_complete_the_waited_controller() -> Bool {
  invocation_wait_refused(result: microvm_invocation_observation(expected: inv,
    before: UnitPropertyRead { value: inv as String }, active: UnitPropertyRead { value: "inactive" },
    after: UnitPropertyRead { value: "a-different-invocation" }))
    && invocation_wait_refused(result: microvm_invocation_observation(expected: inv,
      before: UnitPropertyRead { value: "a-different-invocation" }, active: UnitPropertyRead { value: "inactive" },
      after: UnitPropertyRead { value: inv as String }))
}

test fn unreadable_activity_is_not_termination() -> Bool {
  invocation_wait_refused(result: microvm_invocation_observation(expected: inv,
    before: UnitPropertyRead { value: inv as String },
    active: UnitPropertyUnread { property: "ActiveState" as NonEmptyStr, detail: "transport failed" },
    after: UnitPropertyRead { value: inv as String }))
    && invocation_wait_refused(result: microvm_invocation_observation(expected: inv,
      before: UnitPropertyRead { value: inv as String }, active: UnitPropertyRead { value: "" },
      after: UnitPropertyRead { value: inv as String }))
}

test fn exact_invocation_must_reach_a_known_terminal_state() -> Bool {
  (microvm_invocation_observation(expected: inv, before: UnitPropertyRead { value: inv as String },
    active: UnitPropertyRead { value: "deactivating" }, after: UnitPropertyRead { value: inv as String }) == InvocationStillRunning)
    && (microvm_invocation_observation(expected: inv, before: UnitPropertyRead { value: inv as String },
      active: UnitPropertyRead { value: "inactive" }, after: UnitPropertyRead { value: inv as String }) == InvocationTerminated)
    && (microvm_invocation_observation(expected: inv, before: UnitPropertyRead { value: inv as String },
      active: UnitPropertyRead { value: "failed" }, after: UnitPropertyRead { value: inv as String }) == InvocationTerminated)
}
