module test.claim.runner.runner_microvm_boot_probe_witness

import std.types { String, Bool, List, NonEmptyStr }
import std.measure { second }
import extdeps.shell.exec { ProcessObservation, process_observation }
import extdeps.github.actions_runner { actions_runner_release_2_336_0 }
import extdeps.posix.sh_invocation { posix_sh_program_command }
import extdeps.tools.gnu_coreutils { timeout_command_enforcing_bound }
import extdeps.exec.command { env_prefixed_command }
import std.env_binding { EnvSet }
import extdeps.virtualization.firecracker {
  firecracker_vm_config_document, firecracker_run_config_command,
}
import gunbc.command_runner { run_shell_command_observe, LocalExec }
import gunbc.runner.runner_microvm {
  gunbc_runner_guest_image, gunbc_runner_microvm_declared_size, gunbc_runner_jit_transport,
  GuestNetworkAbsent, runner_microvm_vm_config,
}
import gunbc.runner.runner_microvm_boot_probe {
  BootProbeVerdict, BootPrintedRunnerVersion, BootProducedNoConsole,
  BootConsoleLacksRunnerVersion, BootConsoleLacksGuestBooted,
  BootNotAttempted, BootExceededHostDeadline, BootDeadlineEnforcementUnobservable, BootVmmFailed,
  boot_probe_verdict, boot_probe_admitted, guest_agent_boot_verdict,
  runner_microvm_boot_probe_rootfs, runner_microvm_boot_probe_networking,
  runner_microvm_boot_probe_bounded_command,
  runner_microvm_boot_probe_enforcement_observation,
  runner_microvm_boot_probe_verdict_from_observation,
  runner_microvm_boot_probe_deadline,
  ExecutionBoundReceipt, BoundFired, BoundEnforcementUnobserved, BoundDidNotFire, NoExecutionBound,
}
import gunbc.runner.runner_guest_image { guest_observation_line, GuestBooted }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn console_carrying_version() -> ProcessObservation {
  process_observation(
    exit_code: 0,
    stdout: concat("[    0.412] systemd[1]: Reached target multi-user.target\n2.", "336.0\n"),
    stderr: "",
  )
}

// THE ACCEPTANCE IS A READBACK OF THE CITED RELEASE, AND THIS IS THE PAIR THAT SAYS SO. A console
// that reached multi-user but never printed the runner's version is the exact failure an image
// missing its runner produces -- the guest boots beautifully and is useless -- so the negative arm
// is a console that boots and lacks the version, not an empty one.
test fn a_console_without_the_cited_runner_version_is_not_a_boot() -> Bool {
  let good = boot_probe_verdict(runner: actions_runner_release_2_336_0, observed: console_carrying_version(), receipt: NoExecutionBound)
  let booted_but_empty = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(exit_code: 0, stdout: "[    0.412] systemd[1]: Reached target multi-user.target\n", stderr: ""),
    receipt: NoExecutionBound,
  )
  boot_probe_admitted(v: good)
    && !boot_probe_admitted(v: booted_but_empty)
    && (match booted_but_empty {
      BootConsoleLacksRunnerVersion { expected: e, console: _ } => e == actions_runner_release_2_336_0.version as String
      _ => false
    })
}

// A VMM THAT REFUSED AND A GUEST THAT PRODUCED NOTHING ARE DIFFERENT EVENTS WITH DIFFERENT OWNERS.
// The first is a host or configuration fact and its remedy is on the host; the second is an image
// fact. Collapsing them into one cause would send a reader to the wrong module, and the exit code
// and stderr are carried because they are the only thing that distinguishes them in practice.
test fn a_failed_vmm_and_a_silent_guest_are_distinguishable_and_both_keep_the_console() -> Bool {
  let failed = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(
      exit_code: 1,
      stdout: "[    0.9] Kernel panic - not syncing: VFS: Unable to mount root fs",
      stderr: "Error: cannot open /dev/kvm",
    ),
    receipt: NoExecutionBound,
  )
  let silent = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(exit_code: 0, stdout: "", stderr: ""),
    receipt: NoExecutionBound,
  )
  !boot_probe_admitted(v: failed)
    && !boot_probe_admitted(v: silent)
    && (match failed {
      BootVmmFailed { exit_code: x, console: c, detail: e } =>
        x == 1 && string_contains(s: c, pattern: "Kernel panic") && string_contains(s: e, pattern: "/dev/kvm")
      _ => false
    })
    && (match silent { BootProducedNoConsole { cause: _ } => true  _ => false })
}

// THE PROBE NEVER BOOTS THE BUILT ARTIFACT. A root drive is attached read-write, so booting the
// image itself would mutate the bytes whose digest the build receipt recorded. The red is a probe
// rootfs path equal to the image path.
test fn the_probe_boots_a_copy_rather_than_the_built_image() -> Bool {
  runner_microvm_boot_probe_rootfs(root: "/r")
    != "/r/images/ubuntu-24.04-aarch64-runner-2.336.0.ext4"
}

// THE CONFIG DOCUMENT IS UPSTREAM'S SPELLING, hyphenated at the top level and underscored inside.
// A model that tidied that asymmetry would produce a document Firecracker does not parse, and the
// failure would arrive as a boot error rather than as a modeling one.
//
// THIS WITNESS ASSERTS KEY SPELLINGS AND NOTHING ELSE ABOUT THE TEXT, which is a narrowing after it
// went red in CI for the wrong reason. It had asserted `"network-interfaces":[]`; the emitter writes
// `": "` with a space, so the assertion failed while every key it exists to check was correct. A
// witness that fails on formatting it does not own is a change detector wearing a check's clothes,
// and the emptiness it was trying to catch is already covered structurally by
// a_guest_without_a_tap_carries_no_interface_and_one_with_a_tap_does, which counts the interfaces
// rather than matching serialized bytes.
test fn the_config_document_carries_upstreams_own_key_spelling() -> Bool {
  let doc = firecracker_vm_config_document(
    config: runner_microvm_vm_config(
      rootfs_path: "/r/probe/probe-rootfs.ext4",
      jit_config_path: "/r/probe/probe-rootfs.ext4",
      kernel_path: "/r/base/vmlinux-6.1.128",
      net: runner_microvm_boot_probe_networking(),
      size: gunbc_runner_microvm_declared_size,
      transport: gunbc_runner_jit_transport,
    ),
  )
  string_contains(s: doc, pattern: "\"boot-source\"")
    && string_contains(s: doc, pattern: "\"machine-config\"")
    && string_contains(s: doc, pattern: "\"network-interfaces\"")
    && string_contains(s: doc, pattern: "\"kernel_image_path\"")
    && string_contains(s: doc, pattern: "\"mem_size_mib\"")
}

// `--no-api` IS PART OF THE OPERATION. Without it Firecracker binds its API socket and WAITS for an
// InstanceStart nobody sends, so the step would report a hang rather than a boot.
test fn the_run_command_boots_rather_than_waiting_for_an_api_call() -> Bool {
  let c = firecracker_run_config_command(binary: "/fc/firecracker", config_path: "/r/probe/probe-vm-config.json")
  c.program.invocation as String == "/fc/firecracker"
    && any(xs: c.arguments, predicate: fn(w) { w == "--no-api" })
    && any(xs: c.arguments, predicate: fn(w) { w == "--config-file" })
}

// THE HOST'S DEADLINE IS NOT THE GUEST'S TO DECLINE, and this is the pair that says so.
//
// A guest that exits 124 of its own accord and a guest the host killed at its deadline are
// INDISTINGUISHABLE BY EXIT STATUS (both 124; re-derived with the row's pair). They ARE distinguished by
// the bounder's own diagnostic: GNU `timeout --verbose`, which gunbc.runner.runner_microvm_boot_probe's
// bounded command imposes, writes "timeout: sending signal ..." to stderr at the moment it decides to
// signal the bounded command -- and writes nothing when the subject exits on its own. The receipt is read
// from the captured stderr (separate from the exit status; gunbc.command_runner command_runner.dag:316).
//
// THE REAL PATH IS DRIVEN HERE, not supplied as inputs (gunbc.design_argument::witness_one_interface:
// supplying inputs may never remove the last execution of the real path). Each arm runs the ACTUAL
// `timeout --verbose` pair through run_shell_command_observe over LocalExec -- a real process, real
// deadline, real stderr -- and then reads the receipt from the resulting ProcessObservation.
//
//   (A) A REAL EXPIRY STILL IS A DEADLINE: bound the sleep for 1 second, sleep for 30.
test fn the_real_bound_firing_is_read_as_a_deadline() -> Bool {
  let observed = run_shell_command_observe(
    command: timeout_command_enforcing_bound(
      duration: second(count: 1),
      kill_after: second(count: 1),
      command: posix_sh_program_command(script: "sleep 30"),
    ),
    transport: LocalExec,
  )
  let verdict = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: observed,
    receipt: runner_microvm_boot_probe_enforcement_observation(deadline: runner_microvm_boot_probe_deadline, exit_code: observed.exit_code, stderr: observed.stderr),
  )
  observed.exit_code == 124
    && string_contains(s: observed.stderr, pattern: "timeout: sending signal")
    && (match verdict {
      BootExceededHostDeadline { deadline: d, console: _, detail: e } =>
        string_contains(s: d, pattern: "180") && string_contains(s: e, pattern: "sending signal")
      _ => false
    })
}

//   (B) A CHILD EXITING 124 WITHOUT THE BOUND FIRING IS NOT REPORTED AS A DEADLINE: give the bound 30
//   seconds but exit 124 immediately. The status agrees with (A), the diagnostic does NOT -- so the
//   receipt is BoundEnforcementUnobserved and the classifier REFUSES BY NAME, never reading the bare
//   124 as a deadline. This is the red_control of gunbc.recurring_failure_mode.bare_exit_124_read_as_an_observed_timeout_event.
test fn the_real_child_exiting_124_is_refused_by_name_not_a_deadline() -> Bool {
  let observed = run_shell_command_observe(
    command: timeout_command_enforcing_bound(
      duration: second(count: 30),
      kill_after: second(count: 1),
      command: posix_sh_program_command(script: "exit 124"),
    ),
    transport: LocalExec,
  )
  let verdict = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: observed,
    receipt: runner_microvm_boot_probe_enforcement_observation(deadline: runner_microvm_boot_probe_deadline, exit_code: observed.exit_code, stderr: observed.stderr),
  )
  observed.exit_code == 124
    && !string_contains(s: observed.stderr, pattern: "timeout: sending signal")
    && !boot_probe_admitted(v: verdict)
    && (match verdict {
      BootDeadlineEnforcementUnobservable { console: _, detail: _ } => true
      BootExceededHostDeadline { deadline: _, console: _, detail: _ } => false
      _ => false
    })
}

//   (C) A CLEAN BOOT UNDER THE SAME BOUND IS ADMITTED, NOT REFUSED. The bound is imposed but does NOT
//   fire: the subject exits 0 with the runner version and the agent's GuestBooted marker on its console.
//   The bounder's own contract (timeout(1): a fired timeout exits 124) makes a NON-124 status POSITIVE
//   evidence the bound did not fire -- this is NOT the forbidden inference from a missing diagnostic, it
//   is the status ruling a fire out -- so the receipt is BoundDidNotFire and the run is judged on its
//   console content, reaching an admitted verdict. This is the arm review 98030 required: the real
//   producer driven through a NON-FIRING bound all the way to an admitted verdict.
test fn the_real_non_firing_bound_still_admits_a_clean_boot() -> Bool {
  let version = actions_runner_release_2_336_0.version as String
  let marker = guest_observation_line(event: GuestBooted, image: gunbc_runner_guest_image)
  let observed = run_shell_command_observe(
    command: timeout_command_enforcing_bound(
      duration: second(count: 30),
      kill_after: second(count: 1),
      command: posix_sh_program_command(script: join(["echo '", version, "'; echo '", marker, "'"], "")),
    ),
    transport: LocalExec,
  )
  let receipt = runner_microvm_boot_probe_enforcement_observation(
    deadline: runner_microvm_boot_probe_deadline,
    exit_code: observed.exit_code,
    stderr: observed.stderr,
  )
  let verdict = runner_microvm_boot_probe_verdict_from_observation(
    runner: actions_runner_release_2_336_0,
    observed: observed,
  )
  observed.exit_code == 0
    && (match receipt { BoundDidNotFire => true  _ => false })
    && boot_probe_admitted(v: verdict)
    && (match verdict { BootPrintedRunnerVersion { version: v } => v == version  _ => false })
}

// ABSENCE IS NOT EVIDENCE: a localized or otherwise unrecognized diagnostic must land in the unknown arm
// and be REFUSED BY NAME, never matched-and-fired and never read as "the bound did not fire". The real
// coreutils on the heavy host ships no message catalogs, so the localized form is exercised at the
// classifier interface with a foreign-language diagnostic that the pinned English matcher does not see.
test fn an_unrecognized_enforcement_diagnostic_is_refused_not_matched() -> Bool {
  let receipt = runner_microvm_boot_probe_enforcement_observation(
    deadline: runner_microvm_boot_probe_deadline,
    exit_code: 124,
    stderr: "timeout: Senden von Signal TERM an Befehl »sleep«",
  )
  let verdict = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(exit_code: 124, stdout: "", stderr: "timeout: Senden von Signal TERM an Befehl »sleep«"),
    receipt: receipt,
  )
  !boot_probe_admitted(v: verdict)
    && (match verdict {
      BootDeadlineEnforcementUnobservable { console: _, detail: _ } => true
      _ => false
    })
}

// A SUBJECT CAN FAKE THE DIAGNOSTIC: timeout and the bounded subject share one stderr, so a subject that
// prints `timeout: sending signal ...` itself must NOT be read as a deadline that fired. The bounder's own
// contract (a fired timeout exits 124) is the cross-check -- a diagnostic on a NON-124 status is forged or
// foreign text, never a firing. Both arms are refused by name (no deadline), at exit 0 and at exit 1.
// This is the red case review 98071 required ("diagnostic present, exit != 124").
test fn a_forged_diagnostic_on_a_non_deadline_status_is_refused_not_a_deadline() -> Bool {
  let forged = "timeout: sending signal TERM to command 'firecracker'"
  let forged_clean = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(exit_code: 0, stdout: "2.336.0\n", stderr: forged),
    receipt: runner_microvm_boot_probe_enforcement_observation(deadline: runner_microvm_boot_probe_deadline, exit_code: 0, stderr: forged),
  )
  let forged_fail = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(exit_code: 1, stdout: "", stderr: forged),
    receipt: runner_microvm_boot_probe_enforcement_observation(deadline: runner_microvm_boot_probe_deadline, exit_code: 1, stderr: forged),
  )
  !boot_probe_admitted(v: forged_clean)
    && !boot_probe_admitted(v: forged_fail)
    && (match forged_clean { BootDeadlineEnforcementUnobservable { console: _, detail: _ } => true  _ => false })
    && (match forged_fail { BootDeadlineEnforcementUnobservable { console: _, detail: _ } => true  _ => false })
}

// THE FORGERY RUN THROUGH THE REAL PATH (witness_one_interface): a real bounded invocation whose subject
// itself writes the diagnostic to the SHARED stderr and then exits 0 with an otherwise-clean console. The
// real producer reads exit 0 + diagnostic-present as a contradiction and REFUSES -- it is neither reported
// as a deadline nor admitted as a clean boot. The red is a classifier that keys BoundFired on stderr text
// alone (the review 98071 defect): it would report this as BootExceededHostDeadline.
test fn the_real_forged_diagnostic_on_a_clean_exit_is_refused_not_a_deadline() -> Bool {
  let observed = run_shell_command_observe(
    command: timeout_command_enforcing_bound(
      duration: second(count: 30),
      kill_after: second(count: 1),
      command: posix_sh_program_command(script: "echo 'timeout: sending signal TERM to command x' 1>&2; echo 2.336.0; echo 'gunbc-guest-observation guest-booted image=x'"),
    ),
    transport: LocalExec,
  )
  let verdict = runner_microvm_boot_probe_verdict_from_observation(
    runner: actions_runner_release_2_336_0,
    observed: observed,
  )
  observed.exit_code == 0
    && string_contains(s: observed.stderr, pattern: "timeout: sending signal")
    && !boot_probe_admitted(v: verdict)
    && (match verdict { BootDeadlineEnforcementUnobservable { console: _, detail: _ } => true  _ => false })
}

// THE BOUND ESCALATES TO KILL and pins LC_ALL=C so the diagnostic stays matchable. A bare `timeout` sends
// TERM and then waits, so a wedged VMM outlives its bound -- a deadline the subject can decline is the
// escape hatch gunbc.design_argument::fail_closed refuses -- and an unpinned diagnostic is locale-
// dependent. The red is a builder that drops --kill-after, --verbose, or the LC_ALL=C pin.
test fn the_bounded_command_escalates_and_pins_the_diagnostic_locale() -> Bool {
  let c = runner_microvm_boot_probe_bounded_command(binary: "/fc/firecracker", config_path: "/r/probe/probe-vm-config.json")
  c.program.invocation as String == "env"
    && any(xs: c.arguments, predicate: fn(w) { w == "LC_ALL=C" })
    && any(xs: c.arguments, predicate: fn(w) { w == "timeout" })
    && any(xs: c.arguments, predicate: fn(w) { w == "--verbose" })
    && any(xs: c.arguments, predicate: fn(w) { w == "--kill-after" })
    && any(xs: c.arguments, predicate: fn(w) { w == "/fc/firecracker" })
    && any(xs: c.arguments, predicate: fn(w) { w == "--no-api" })
}

// THE REAL PATH UNDER A HOSTILE OUTER LOCALE, PIN HOLDS. This drives the ACTUAL builder
// (timeout_command_enforcing_bound) -- NOT a hand-typed argv (gunbc.design_argument::witness_one_interface:
// supplying inputs may never remove the last execution of the real path) -- wrapped by an OUTER
// env_prefixed_command that asks for a non-C locale. The builder's own inner pin forces LC_ALL=C on the
// timeout process, so the matchable diagnostic is still produced and the real producer still yields
// BoundFired. The red is a builder that drops the LC_ALL=C pin or --verbose: then the hostile outer
// locale reaches timeout and the English receipt match fails. On this catalog-less host the rendered text
// is identical, so the load-bearing pin claim is ALSO carried by the static arm above (the rendered argv
// must contain the pin) and by the foreign-diagnostic arm (an unmatched localized form is refused).
test fn the_real_bound_under_a_non_c_outer_locale_still_fires_the_diagnostic() -> Bool {
  let hostile_outer = env_prefixed_command(
    bindings: [EnvSet { name: "LC_ALL", value: "de_DE.UTF-8" }],
    command: timeout_command_enforcing_bound(
      duration: second(count: 1),
      kill_after: second(count: 1),
      command: posix_sh_program_command(script: "sleep 30"),
    ),
  )
  let observed = run_shell_command_observe(command: hostile_outer, transport: LocalExec)
  let receipt = runner_microvm_boot_probe_enforcement_observation(
    deadline: runner_microvm_boot_probe_deadline,
    exit_code: observed.exit_code,
    stderr: observed.stderr,
  )
  observed.exit_code == 124
    && string_contains(s: observed.stderr, pattern: "timeout: sending signal")
    && (match receipt {
      BoundFired { deadline: d } => string_contains(s: d, pattern: "180")
      _ => false
    })
}

// A LIVE BOOT IS JUDGED THROUGH THE HOST'S CONSOLE READER, AND THIS IS THE PAIR. The same version
// readback with and without the agent's GuestBooted marker: only the marked console is a boot of
// this image's agent. The marker is produced by the emitter's own line builder, so an emitter edit
// the reader does not follow reds here.
test fn a_live_boot_requires_the_agents_guest_booted_marker() -> Bool {
  let marker = guest_observation_line(event: GuestBooted, image: gunbc_runner_guest_image)
  let marked = guest_agent_boot_verdict(
    runner: actions_runner_release_2_336_0,
    observed: process_observation(exit_code: 0, stdout: join(["[ 3.1] ", marker, "\n2.", "336.0\n"], ""), stderr: ""),
    receipt: NoExecutionBound,
  )
  let unmarked = guest_agent_boot_verdict(runner: actions_runner_release_2_336_0, observed: console_carrying_version(), receipt: NoExecutionBound)
  boot_probe_admitted(v: marked)
    && !boot_probe_admitted(v: unmarked)
    && (match unmarked { BootConsoleLacksGuestBooted { console: _ } => true  _ => false })
    && boot_probe_admitted(v: boot_probe_verdict(runner: actions_runner_release_2_336_0, observed: console_carrying_version(), receipt: NoExecutionBound))
}
