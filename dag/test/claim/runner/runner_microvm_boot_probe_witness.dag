module test.claim.runner.runner_microvm_boot_probe_witness

import std.types { String, Bool, List, NonEmptyStr }
import std.optional { Present, Absent }
import std.algebra { string_contains, for_all }
import std.measure { second }
import extdeps.github.actions_runner { actions_runner_release_2_336_0 }
import extdeps.virtualization.firecracker {
  firecracker_vm_config_document, firecracker_run_config_command,
}
import gunbc.runner.runner_microvm {
  gunbc_runner_guest_image, gunbc_runner_microvm_declared_size, gunbc_runner_jit_transport,
  GuestNetworkAbsent, runner_microvm_vm_config,
}
import gunbc.runner.runner_microvm_boot_probe {
  BootProbeVerdict, BootPrintedRunnerVersion, BootProducedNoConsole,
  BootConsoleLacksRunnerVersion, BootConsoleLacksGuestBooted,
  BootNotAttempted, BootExceededHostDeadline, BootDeadlineEnforcementUnobservable,
  BootConsoleUnreadable, BootVmmFailed,
  BootProbeConsole, EnforcementMismatch,
  SignalledWithoutOurKill, ReapRefused, GroupSignalRefused, SubjectSurvivedOurSignals,
  KillNotConfirmedByReap, GroupUnnameable,
  boot_probe_verdict, boot_probe_verdict_text, boot_probe_admitted, guest_agent_boot_verdict,
  runner_microvm_boot_probe_rootfs, runner_microvm_boot_probe_networking,
  runner_microvm_boot_probe_bounded_command,
  ExecutionBoundReceipt, BoundFired, BoundChildExited, BoundSignalledByOther, BoundReapRefused,
  BoundKillRefused, BoundSubjectSurvivedOurSignals, BoundKillUnconfirmed, BoundKillUnnameable,
  BoundSpawnRefused, NoExecutionBound,
}
import gunbc.runner.runner_guest_image { guest_observation_line, GuestBooted }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CLASSIFIER'S INPUTS, AT ONE INTERFACE. These constructors build the CONSOLE and the RECEIPT that
// the real producer (#gunbc.runner.runner_microvm_boot_probe::runner_microvm_boot_probe_run_bounded) emits
// from a live invocation, so the classifier arms are planted here without pretending to spawn: the
// executions of the real spawn path -- a child's own 124, a child's own 137, a child our own bound
// signalled, a forger, a self-signaller, a decliner, a refusal, and a clean admitted boot -- live in
// #test.claim.runner.runner_microvm_boot_probe_lifecycle_witness, which starts real processes. What this
// file adds on top of those is the arms the real spawns cannot be made to produce on a schedule (the
// kernel refusing a reap, the group verb refusing, a pid that is not a group leader) and the
// whole-family statement that NO arm keys a deadline on a status.
fn console_of(stdout: String, stderr: String) -> BootProbeConsole {
  BootProbeConsole {
    stdout: stdout,
    stderr: stderr,
    source: "witness://classifier-interface",
    read_cause: Absent,
  }
}

// ONE REFUSAL, CHECKED THE SAME WAY: refused, typed as unobservable, its OWN discriminating fact in the
// text, no deadline sentence, and the console still carried.
fn refusal_refuses_by_name(receipt: ExecutionBoundReceipt, discriminating: String) -> Bool {
  let v = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "[    1.0] console survives", stderr: "stderr survives"),
    receipt: receipt,
  )
  let text = boot_probe_verdict_text(v: v)
  !boot_probe_admitted(v: v)
    && (match v { BootDeadlineEnforcementUnobservable { console: _, console_cause: _, detail: _, cause: _ } => true  _ => false })
    && string_contains(s: text, pattern: discriminating)
    && !string_contains(s: text, pattern: "host-deadline-expired")
    && string_contains(s: text, pattern: "console survives")
}

fn console_unreadable(path: String, cause: String) -> BootProbeConsole {
  BootProbeConsole { stdout: "", stderr: "", source: path, read_cause: Present { value: cause } }
}

fn version_console() -> BootProbeConsole {
  console_of(
    stdout: concat("[    0.412] systemd[1]: Reached target multi-user.target\n2.", "336.0\n"),
    stderr: "",
  )
}

// THE ACCEPTANCE IS A READBACK OF THE CITED RELEASE, AND THIS IS THE PAIR THAT SAYS SO. A console
// that reached multi-user but never printed the runner's version is the exact failure an image
// missing its runner produces -- the guest boots beautifully and is useless -- so the negative arm
// is a console that boots and lacks the version, not an empty one. Both travel under NoExecutionBound:
// this is the captured-console route of #gunbc.runner.runner_observed_version_check, where no bound was
// placed and no subject status exists.
test fn a_console_without_the_cited_runner_version_is_not_a_boot() -> Bool {
  let good = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: version_console(),
    receipt: NoExecutionBound,
  )
  let booted_but_empty = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "[    0.412] systemd[1]: Reached target multi-user.target\n", stderr: ""),
    receipt: NoExecutionBound,
  )
  boot_probe_admitted(v: good)
    && !boot_probe_admitted(v: booted_but_empty)
    && (match booted_but_empty {
      BootConsoleLacksRunnerVersion { expected: e, console: _ } => e == actions_runner_release_2_336_0.version as String
      _ => false
    })
}

// A VMM THAT REFUSED AND A GUEST THAT PRODUCED NOTHING ARE DIFFERENT EVENTS WITH DIFFERENT OWNERS.
// The first is a host or configuration fact and its remedy is on the host; the second is an image
// fact. Collapsing them into one cause would send a reader to the wrong module, and the exit code
// and stderr are carried because they are the only thing that distinguishes them in practice. The
// codes arrive INSIDE the receipt, from the kernel's own reap classification -- the classifier is not
// handed a bare status to interpret.
test fn a_failed_vmm_and_a_silent_guest_are_distinguishable_and_both_keep_the_console() -> Bool {
  let failed = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(
      stdout: "[    0.9] Kernel panic - not syncing: VFS: Unable to mount root fs",
      stderr: "Error: cannot open /dev/kvm",
    ),
    receipt: BoundChildExited { exit_code: 1 },
  )
  let silent = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "", stderr: ""),
    receipt: BoundChildExited { exit_code: 0 },
  )
  !boot_probe_admitted(v: failed)
    && !boot_probe_admitted(v: silent)
    && (match failed {
      BootVmmFailed { exit_code: x, console: c, detail: e } =>
        x == 1 && string_contains(s: c, pattern: "Kernel panic") && string_contains(s: e, pattern: "/dev/kvm")
      _ => false
    })
    && (match silent { BootProducedNoConsole { cause: _ } => true  _ => false })
}

// THE ROW'S RED CONTROL, AT THE CLASSIFIER INTERFACE: A CHILD'S OWN 124 IS THE CAUSE BootVmmFailed
// EXISTS TO CARRY. The same status that the withdrawn reader turned into
// "boot=host-deadline-expired after 180 seconds -- the host killed the VMM" -- a duration and a killing
// nobody observed -- now yields the VMM's own failure, with no deadline sentence and no invented
// duration anywhere in the text. The real-spawn twin of this claim, starting an actual process that
// exits 124, is in #test.claim.runner.runner_microvm_boot_probe_lifecycle_witness.
test fn a_childs_own_124_exit_carries_the_vmm_cause_and_no_deadline_sentence() -> Bool {
  let v = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "[    0.4] firecracker: guest exited", stderr: "child exited with 124"),
    receipt: BoundChildExited { exit_code: 124 },
  )
  let text = boot_probe_verdict_text(v: v)
  !boot_probe_admitted(v: v)
    && (match v {
      BootVmmFailed { exit_code: x, console: _, detail: _ } => x == 124
      _ => false
    })
    && string_contains(s: text, pattern: "boot=vmm-failed exit=124")
    && !string_contains(s: text, pattern: "deadline")
}

// AND THE SAME FOR 137, WHICH IS THE STATUS THAT LOOKS MOST LIKE A KILL. A child that exits 137 of its
// own accord -- or whose shell reports a signal death -- is not a bound that fired: this layer never
// signalled anything in this arm, so there is no enforcement event to report and no deadline to name.
test fn a_childs_own_137_exit_carries_the_vmm_cause_and_no_deadline_sentence() -> Bool {
  let v = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "", stderr: "Killed"),
    receipt: BoundChildExited { exit_code: 137 },
  )
  let text = boot_probe_verdict_text(v: v)
  !boot_probe_admitted(v: v)
    && (match v { BootVmmFailed { exit_code: x, console: _, detail: _ } => x == 137  _ => false })
    && !string_contains(s: text, pattern: "deadline")
}

// NO ARM KEYS A DEADLINE ON A STATUS, WHOLE FAMILY. Every status a bounded subject can arrive with,
// crossed with an empty console and a version console, judged under both routes that read content,
// produces no deadline sentence anywhere. This is the row's out_of_scope ("no 124 arm keyed on the bare
// exit status anywhere") asserted as a closed family rather than as the handful of cases a reader
// happens to think of.
test fn no_status_and_console_combination_produces_a_deadline_verdict() -> Bool {
  let statuses = [0, 1, 124, 125, 126, 127, 137, 143, 255] as List<Int>
  let consoles = [
    console_of(stdout: "", stderr: ""),
    version_console(),
    console_of(stdout: "timeout: sending signal TERM to command 'firecracker'", stderr: "timeout: sending signal"),
  ] as List<BootProbeConsole>
  for_all(xs: statuses, predicate: fn(code) {
    for_all(xs: consoles, predicate: fn(c) {
      let via_receipt = boot_probe_verdict_text(v: boot_probe_verdict(
        runner: actions_runner_release_2_336_0,
        console: c,
        receipt: BoundChildExited { exit_code: code },
      ))
      let via_capture = boot_probe_verdict_text(v: boot_probe_verdict(
        runner: actions_runner_release_2_336_0,
        console: c,
        receipt: NoExecutionBound,
      ))
      !string_contains(s: via_receipt, pattern: "host-deadline-expired")
        && !string_contains(s: via_capture, pattern: "host-deadline-expired")
    })
  })
}

// A DEADLINE VERDICT NAMES THE BOUND THIS LAYER IMPOSED AND THE SIGNAL THE KERNEL REPORTED -- both
// carried on the receipt from the run itself. The rendered duration is the one on the receipt (7
// seconds here, not the module's 180), which is what makes it an observation rather than the old
// rendered constant: a verdict cannot quote a bound that was not the one imposed on this run.
test fn the_deadline_verdict_renders_the_bound_this_run_imposed() -> Bool {
  let v = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "[    3.0] watchdog: hung", stderr: ""),
    receipt: BoundFired { deadline: second(count: 7), reaped_signal: 15 },
  )
  let text = boot_probe_verdict_text(v: v)
  !boot_probe_admitted(v: v)
    && (match v { BootExceededHostDeadline { deadline: d, console: _, console_cause: _, detail: _ } => d == "7 seconds"  _ => false })
    && string_contains(s: text, pattern: "host-deadline-expired after 7 seconds")
    && string_contains(s: text, pattern: "signal 15")
    && !string_contains(s: text, pattern: "180")
}

// THE SIX REFUSALS ARE SIX ARMS, EACH NAMING WHAT WAS OBSERVED, because their remedies differ (a kernel
// that refused the reap is someone else's fault from a subject that declined SIGTERM). An earlier
// revision printed one message for two of these situations and was wrong for one of them; a review
// finding on gunbc#17013 required the split. Each arm is planted here so none of them is dead code, and
// each assertion names the fact ONLY that arm may state.
test fn each_unobservable_arm_names_what_was_actually_observed() -> Bool {
  refusal_refuses_by_name(
    receipt: BoundSignalledByOther { signal: 9 },
    discriminating: "although this layer had not signalled",
  )
    && refusal_refuses_by_name(
      receipt: BoundReapRefused { cause: "ECHILD: not our child" },
      discriminating: "refused this layer's reap",
    )
    && refusal_refuses_by_name(
      receipt: BoundKillRefused { deadline: second(count: 3), detail: "kill: no such process" },
      discriminating: "group signal was refused",
    )
    && refusal_refuses_by_name(
      receipt: BoundSubjectSurvivedOurSignals { deadline: second(count: 3) },
      discriminating: "the kernel would not reap it",
    )
    && refusal_refuses_by_name(
      receipt: BoundKillUnconfirmed { deadline: second(count: 3), exit_code: 0 },
      discriminating: "as EXITED",
    )
    && refusal_refuses_by_name(
      receipt: BoundKillUnnameable { pid: 1 },
      discriminating: "could not be minted",
    )
}

// THE SIX CAUSES ARE SEPARATE VALUES, not one message with a formatted reason inside: each carries its
// own observed data (the signal, the refusal cause, the exit code the kernel reported, the pid). A
// single arm with a string could claim any of them for any of the situations.
test fn each_unobservable_cause_carries_its_own_observed_data() -> Bool {
  let c = console_of(stdout: "", stderr: "")
  let by_signal = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundSignalledByOther { signal: 9 })
  let by_reap = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundReapRefused { cause: "ECHILD" })
  let by_decline = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundSubjectSurvivedOurSignals { deadline: second(count: 4) })
  let by_exit = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundKillUnconfirmed { deadline: second(count: 4), exit_code: 3 })
  let by_pid = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundKillUnnameable { pid: 1 })
  let by_kill = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundKillRefused { deadline: second(count: 4), detail: "EPERM" })
  (match by_signal {
    BootDeadlineEnforcementUnobservable { cause: SignalledWithoutOurKill { signal: s }, console: _, console_cause: _, detail: _ } => s == 9
    _ => false
  })
    && (match by_reap {
      BootDeadlineEnforcementUnobservable { cause: ReapRefused { cause: cc }, console: _, console_cause: _, detail: _ } => cc == "ECHILD"
      _ => false
    })
    && (match by_decline {
      BootDeadlineEnforcementUnobservable { cause: SubjectSurvivedOurSignals { deadline: d }, console: _, console_cause: _, detail: _ } => d == "4 seconds"
      _ => false
    })
    && (match by_exit {
      BootDeadlineEnforcementUnobservable { cause: KillNotConfirmedByReap { deadline: _, exit_code: x }, console: _, console_cause: _, detail: _ } => x == 3
      _ => false
    })
    && (match by_pid {
      BootDeadlineEnforcementUnobservable { cause: GroupUnnameable { pid: p }, console: _, console_cause: _, detail: _ } => p == 1
      _ => false
    })
    && (match by_kill {
      BootDeadlineEnforcementUnobservable { cause: GroupSignalRefused { deadline: _, detail: dd }, console: _, console_cause: _, detail: _ } => dd == "EPERM"
      _ => false
    })
}

// AN UNREADABLE CAPTURE IS NOT AN EMPTY CONSOLE, ON EVERY ARM. "The guest printed nothing" and "we could
// not read what the guest printed" are different claims with different owners -- the first is a fact about
// the guest, the second a fact about the reader. The two content arms refuse outright (BootConsoleUnreadable,
// carrying the path and the reader's cause). The deadline arm and the six refusal arms keep the fact they
// exist to report -- that a bound did or did not observably fire -- and carry the reader's failure with
// them: the console block then names the read cause instead of printing the empty string the unreadable
// read left behind, which is the fabricated-plausible-answer shape gunbc.design_argument::fail_closed
// refuses. A reader must never be able to mistake an unreadable capture for a silent guest.
test fn an_unreadable_capture_refuses_by_name_rather_than_claiming_an_empty_console() -> Bool {
  let c = console_unreadable(path: "/probe/vmm-console.txt", cause: "EACCES: permission denied")
  let bounded = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: BoundChildExited { exit_code: 0 })
  let captured = boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: NoExecutionBound)
  let bounded_text = boot_probe_verdict_text(v: bounded)
  let fired = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: c,
    receipt: BoundFired { deadline: second(count: 7), reaped_signal: 15 },
  )
  let fired_text = boot_probe_verdict_text(v: fired)
  let refusal_receipts = [
    BoundSignalledByOther { signal: 9 },
    BoundReapRefused { cause: "ECHILD" },
    BoundKillRefused { deadline: second(count: 7), detail: "EPERM" },
    BoundSubjectSurvivedOurSignals { deadline: second(count: 7) },
    BoundKillUnconfirmed { deadline: second(count: 7), exit_code: 3 },
    BoundKillUnnameable { pid: 1 },
  ]
  !boot_probe_admitted(v: bounded)
    && !boot_probe_admitted(v: captured)
    && (match bounded {
      BootConsoleUnreadable { path: p, cause: cc } => p == "/probe/vmm-console.txt" && string_contains(s: cc, pattern: "EACCES")
      _ => false
    })
    && (match captured { BootConsoleUnreadable { path: _, cause: _ } => true  _ => false })
    && string_contains(s: bounded_text, pattern: "boot=console-unreadable")
    && !string_contains(s: bounded_text, pattern: "boot=no-console")
    // the deadline arm: still a deadline (it was observed), but its console says unreadable, not empty
    && (match fired {
      BootExceededHostDeadline { deadline: d, console: _, console_cause: cc, detail: _ } =>
        d == "7 seconds" && (match cc { Present { value: why } => string_contains(s: why, pattern: "EACCES")  Absent => false })
      _ => false
    })
    && string_contains(s: fired_text, pattern: "host-deadline-expired")
    && string_contains(s: fired_text, pattern: "unreadable")
    && string_contains(s: fired_text, pattern: "NOT the claim that the guest printed nothing")
    // every refusal arm: still refused for its own reason, and honest that the console was not read
    && for_all(
         xs: refusal_receipts,
         predicate: fn(r) {
           let t = boot_probe_verdict_text(
             v: boot_probe_verdict(runner: actions_runner_release_2_336_0, console: c, receipt: r),
           )
           string_contains(s: t, pattern: "deadline-enforcement-unobservable")
             && string_contains(s: t, pattern: "unreadable")
             && string_contains(s: t, pattern: "EACCES")
         },
       )
}

// NOTHING WAS STARTED, SO NOTHING IS JUDGED. A spawn refusal is not a boot that failed and not a bound
// that fired; it is an attempt that never existed, and it names the program the kernel refused.
test fn a_spawn_refusal_is_not_attempted_and_names_the_program() -> Bool {
  let v = boot_probe_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: "", stderr: ""),
    receipt: BoundSpawnRefused { program: "/fc/firecracker", cause: "ENOENT" },
  )
  let text = boot_probe_verdict_text(v: v)
  !boot_probe_admitted(v: v)
    && (match v { BootNotAttempted { cause: cc } => string_contains(s: cc, pattern: "/fc/firecracker")  _ => false })
    && string_contains(s: text, pattern: "boot=not-attempted")
    && !string_contains(s: text, pattern: "deadline")
}

// THE PROBE NEVER BOOTS THE BUILT ARTIFACT. A root drive is attached read-write, so booting the
// image itself would mutate the bytes whose digest the build receipt recorded. The red is a probe
// rootfs path equal to the image path.
test fn the_probe_boots_a_copy_rather_than_the_built_image() -> Bool {
  runner_microvm_boot_probe_rootfs(root: "/r")
    != "/r/images/ubuntu-24.04-aarch64-runner-2.336.0.ext4"
}

// THE CONFIG DOCUMENT IS UPSTREAM'S SPELLING, hyphenated at the top level and underscored inside.
// A model that tidied that asymmetry would produce a document Firecracker does not parse, and the
// failure would arrive as a boot error rather than as a modeling one.
test fn the_config_document_carries_upstreams_own_key_spelling() -> Bool {
  let doc = firecracker_vm_config_document(
    config: runner_microvm_vm_config(
      rootfs_path: "/r/probe/probe-rootfs.ext4",
      jit_config_path: "/r/probe/probe-rootfs.ext4",
      kernel_path: "/r/base/vmlinux-6.1.128",
      net: runner_microvm_boot_probe_networking(),
      size: gunbc_runner_microvm_declared_size,
      transport: gunbc_runner_jit_transport,
    ),
  )
  string_contains(s: doc, pattern: "\"boot-source\"")
    && string_contains(s: doc, pattern: "\"machine-config\"")
    && string_contains(s: doc, pattern: "\"network-interfaces\"")
    && string_contains(s: doc, pattern: "\"kernel_image_path\"")
    && string_contains(s: doc, pattern: "\"mem_size_mib\"")
}

// `--no-api` IS PART OF THE OPERATION. Without it Firecracker binds its API socket and WAITS for an
// InstanceStart nobody sends, so the step would report a hang rather than a boot.
test fn the_run_command_boots_rather_than_waiting_for_an_api_call() -> Bool {
  let c = firecracker_run_config_command(binary: "/fc/firecracker", config_path: "/r/probe/probe-vm-config.json")
  c.program.invocation as String == "/fc/firecracker"
    && any(xs: c.arguments, predicate: fn(w) { w == "--no-api" })
    && any(xs: c.arguments, predicate: fn(w) { w == "--config-file" })
}

// THE UPSTREAM CONVENTION STAYS MODELLED, AND ITS ESCALATION IS WITNESSED. The production boot route
// no longer wraps the subject in GNU timeout -- a bound this layer does not own cannot evidence its own
// firing to this layer (the receipt's comment carries that reasoning) -- but the wrapper stays modelled
// in #extdeps.tools.gnu_coreutils, cited to upstream timeout(1), because OTHER readers still consume its
// contract: the follow-up row bare-124-timeout-readers-consume-the-bound-observation names them. What is
// witnessed here is the argv the retained composition builds: TERM escalating to KILL, the bound value,
// and the subject underneath it.
test fn the_bounded_command_escalates_rather_than_asking_politely() -> Bool {
  let c = runner_microvm_boot_probe_bounded_command(binary: "/fc/firecracker", config_path: "/r/probe/probe-vm-config.json")
  c.program.invocation as String == "timeout"
    && any(xs: c.arguments, predicate: fn(w) { w == "--kill-after" })
    && any(xs: c.arguments, predicate: fn(w) { w == "/fc/firecracker" })
    && any(xs: c.arguments, predicate: fn(w) { w == "--no-api" })
}

// A LIVE BOOT IS JUDGED THROUGH THE HOST'S CONSOLE READER, AND THIS IS THE PAIR. The same version
// readback with and without the agent's GuestBooted marker: only the marked console is a boot of
// this image's agent. The marker is produced by the emitter's own line builder, so an emitter edit
// the reader does not follow reds here. The real-spawn twin -- a child that prints both lines and is
// admitted through a bound that never fired -- is in
// #test.claim.runner.runner_microvm_boot_probe_lifecycle_witness.
test fn a_live_boot_requires_the_agents_guest_booted_marker() -> Bool {
  let marker = guest_observation_line(event: GuestBooted, image: gunbc_runner_guest_image)
  let marked = guest_agent_boot_verdict(
    runner: actions_runner_release_2_336_0,
    console: console_of(stdout: join(["[ 3.1] ", marker, "\n2.", "336.0\n"], ""), stderr: ""),
    receipt: NoExecutionBound,
  )
  let unmarked = guest_agent_boot_verdict(
    runner: actions_runner_release_2_336_0,
    console: version_console(),
    receipt: NoExecutionBound,
  )
  boot_probe_admitted(v: marked)
    && !boot_probe_admitted(v: unmarked)
    && (match unmarked { BootConsoleLacksGuestBooted { console: _ } => true  _ => false })
}

// A STATUS IS NOT A CAUSE, AND THE RECEIPT TYPE SAYS SO: the fired arm carries the imposed deadline and
// the signal the kernel reported, and no arm of this coproduct holds a diagnostic string. That is a
// typing claim, and typing claims are cheap to state and cheap to lose -- this pins it so a future
// revision that reaches for stderr text reds here first.
test fn the_receipt_types_the_observation_and_carries_no_diagnostic_text() -> Bool {
  let fired = BoundFired { deadline: second(count: 180), reaped_signal: 15 }
  match fired {
    BoundFired { deadline: d, reaped_signal: s } => s == 15 && second_count(s: d) == 180
    _ => false
  }
}
