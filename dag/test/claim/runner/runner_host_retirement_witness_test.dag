data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── THE OBLIGATION EXISTS, AND IT IS NOT THE CAPACITY REFUSAL ────────────────────────────────

// THE POSITIVE CONTROL. srv2 carries a declared retirement, so its obligation is its whole owned
// population rather than the empty set a width transition answers for it.
test fn srv2_carries_a_declared_host_retirement() -> Bool {
  match host_retirement_standing(host: operator_host_srv2) {
    HostRetirementDeclared { retirement: r } => (r.host as String) == (operator_host_srv2 as String)
    HostNotRetiring { host: _, cause: _ } => false
  }
}


// THE RETIREMENT CARRIES THE HOST SPEC, which is what a route needs to reach the machine at all --
// address, principals, app. A retirement that named only a host would leave every consumer
// reconstructing those or fabricating a deploy row to get at them.
test fn the_declared_retirement_carries_the_host_spec() -> Bool {
  list_length(items: host_retirement_spec(host: operator_host_srv2)) == 1
    && (srv2_host_retirement.spec.host_label as String) == "srv2"
    && (srv2_host_retirement.spec.ssh_target as String) != ""
}

// THE DISCRIMINATING RED, AND IT IS THE WHOLE POINT OF THE MODULE. A host nobody declared retiring
// has no obligation and nothing about it may be deleted -- whatever its admitted width did or did
// not resolve to. If this ever answers Declared, a retirement has been minted from something other
// than a declaration.
test fn a_host_nobody_declared_retiring_owes_nothing() -> Bool {
  match host_retirement_standing(host: operator_host_srv4) {
    HostNotRetiring { host: _, cause: _ } =>
      list_length(items: host_retirement_required_retirees(host: operator_host_srv4)) == 0
    HostRetirementDeclared { retirement: _ } => false
  }
}


// AND THE OTHER DIRECTION, so the union is not satisfied by a function that always returns the
// retirement side. srv4 has a width transition and no retirement, and its obligation survives.
test fn the_union_preserves_the_width_transition_side() -> Bool {
  list_length(items: transition_required_retiring(host: operator_host_srv4)) > 0
}


// ── OWNERSHIP IS ESTABLISHED BEFORE ANYTHING IS DELETED ──────────────────────────────────────

// THESE FIXTURES CARRY REGISTRATION-SHAPED NAMES, AND THE PREVIOUS ONES DID NOT.
//
// The first version of this suite put `actions-runner@srv2-07.service` into
// `RegistrationNamesNoCommittedSlot.registration_name` -- a systemd unit name in a field that holds
// GitHub registration names. The ownership predicate it was exercising tested the systemd prefix, so
// the two agreed and the positive control passed while being wrong about every name the production
// decoder will ever hand it. A real registration is `srv2-07`
// (gunbc.fleet_runner_connectivity host_registration_name_for_slot).
//
// So the fixtures below are real-shaped `GitHubSelfHostedRunnerRegistration` values and they go
// through `decode_registration_slot`, the production decoder, rather than having their decoding
// asserted by hand.
fn registration(name: String, id: Nat) -> GitHubSelfHostedRunnerRegistration {
  GitHubSelfHostedRunnerRegistration {
    id: id,
    name: name as NonEmptyStr,
    status: GitHubRunnerOffline,
    busy: false,
    ephemeral: true,
    version: "2.328.0" as NonEmptyStr,
    os: "linux" as NonEmptyStr,
    labels: [],
  }
}

data witness_org: NonEmptyStr = "https://github.com/gunb-ai" as NonEmptyStr

// THE BINDING CARRIES ITS OWN HOST, because ownership now corroborates the candidate's host against
// it rather than taking the caller's word. A fixture that hardcoded srv2 while the claim asked about
// srv4 is exactly the disagreement the join is there to refuse.
fn witness_binding_on(host: HostIdentity, slot: String, agent_id: Int, name: String) -> RunnerRegistrationBinding {
  RunnerRegistrationBinding {
    host: host,
    slot_instance: slot as NonEmptyStr,
    capture_path: join(["/opt/actions-runner/", slot, "/.runner"], "") as NonEmptyStr,
    organization: witness_org,
    agent_id: agent_id,
    agent_name: name as NonEmptyStr,
    lifecycle: ActionsRunnerRegistrationEphemeral,
    provenance: CaptureProvenance {
      observed_on: "2026-09-19" as NonEmptyStr,
      method: "witness-supplied" as NonEmptyStr,
    },
  }
}

fn witness_binding(slot: String, agent_id: Int, name: String) -> RunnerRegistrationBinding {
  witness_binding_on(host: operator_host_srv2, slot: slot, agent_id: agent_id, name: name)
}

fn owned_capture(bindings: List<RunnerRegistrationBinding>) -> CaptureCensus {
  CaptureCensusComplete { observed_on: "2026-09-19" as NonEmptyStr, bindings: bindings, unresolved: [] }
}

// THE CAPTURE BINDS THE REGISTRATION'S ID TO A SLOT, which is what ownership now consults. The slot
// is supplied by the fixture rather than parsed out of the name, exactly as a real capture supplies
// it from the directory the file was found under.
fn disposition_bound(host: HostIdentity, reg: GitHubSelfHostedRunnerRegistration, slot: String) -> SurplusIdentityDisposition {
  surplus_identity_disposition(
    host: host,
    decoding: decode_registration_slot(reg: reg),
    name: reg.name,
    organization: witness_org,
    agent_id: reg.id as Int,
    capture: owned_capture(bindings: [witness_binding_on(host: host, slot: slot, agent_id: reg.id as Int, name: reg.name as String)]),
  )
}

fn disposition_of(host: HostIdentity, reg: GitHubSelfHostedRunnerRegistration) -> SurplusIdentityDisposition {
  disposition_bound(host: host, reg: reg, slot: reg.name as String)
}

fn disposition_without_capture(host: HostIdentity, reg: GitHubSelfHostedRunnerRegistration) -> SurplusIdentityDisposition {
  surplus_identity_disposition(
    host: host,
    decoding: decode_registration_slot(reg: reg),
    name: reg.name,
    organization: witness_org,
    agent_id: reg.id as Int,
    capture: CaptureCensusUnavailable { cause: "no capture census has been taken" },
  )
}

// AN OWNED IDENTITY OUTSIDE THE COMMITTED POPULATION STAYS AN OBLIGATION. srv2 commits nothing, so
// every srv2 registration decodes as NoCommittedSlot -- and that is a fact about the decoder, not a
// discharge. This runs the REAL decoder over a REAL-shaped name.
test fn an_owned_registration_outside_the_committed_population_stays_an_obligation() -> Bool {
  match disposition_of(host: operator_host_srv2, reg: registration(name: "srv2-07", id: 701)) {
    SurplusOwnedRetiree { name: _, host: _ } => true
    CommittedSlotIdentity { name: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    UnownedRegistration { name: _, cause: _ } => false
  }
}

// THE SAME CLAIM FOR A FORMER MEMBER WELL OUTSIDE ANY PLAUSIBLE COMMITMENT, so the row above is not
// passing on an index that happens to sit inside some other host's range.
test fn an_owned_former_member_outside_every_commitment_stays_an_obligation() -> Bool {
  match disposition_of(host: operator_host_srv2, reg: registration(name: "srv2-19", id: 719)) {
    SurplusOwnedRetiree { name: _, host: _ } => true
    CommittedSlotIdentity { name: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    UnownedRegistration { name: _, cause: _ } => false
  }
}

// THE DISCRIMINATOR THE PREVIOUS SUITE COULD NOT EXPRESS: a unit-shaped string is NOT a registration
// this estate issued. If ownership ever goes back to the systemd grammar, this row goes red.
test fn a_unit_shaped_name_is_not_an_owned_registration() -> Bool {
  match disposition_of(host: operator_host_srv2, reg: registration(name: "actions-runner@srv2-07.service", id: 799)) {
    UnownedRegistration { name: _, cause: _ } => true
    SurplusOwnedRetiree { name: _, host: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    CommittedSlotIdentity { name: _ } => false
  }
}

// THE OPPOSITE MISREADING, AND IT IS THE ONE THAT DESTROYS SOMEBODY ELSE'S RUNNER.
test fn a_registration_this_estate_never_issued_is_unowned_rather_than_surplus() -> Bool {
  match disposition_of(host: operator_host_srv2, reg: registration(name: "someone-elses-runner", id: 900)) {
    UnownedRegistration { name: _, cause: _ } => true
    SurplusOwnedRetiree { name: _, host: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    CommittedSlotIdentity { name: _ } => false
  }
}

// ANOTHER HOST'S OWNED REGISTRATION IS NOT srv2'S, so the prefix test discriminates between hosts
// rather than accepting anything with a dash in it. The index is deliberately OUTSIDE srv3's
// committed width: a name that decodes to a committed slot is ordinary business whichever host is
// asking, and it would short-circuit before ownership is ever consulted.
test fn another_hosts_registration_is_not_owned_by_this_one() -> Bool {
  match disposition_of(host: operator_host_srv2, reg: registration(name: "srv3-19", id: 319)) {
    UnownedRegistration { name: _, cause: _ } => true
    SurplusOwnedRetiree { name: _, host: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    CommittedSlotIdentity { name: _ } => false
  }
}

// A COMMITTED SLOT IS ORDINARY BUSINESS and blocks nothing. srv4 commits slots, so its low-index
// registration decodes as a committed identity -- which also proves the decoder is reached.
test fn a_committed_registration_blocks_nothing() -> Bool {
  let d = disposition_of(host: operator_host_srv4, reg: registration(name: "srv4-03", id: 403))
  match d {
    CommittedSlotIdentity { name: _ } =>
      !surplus_identity_blocks_closure(d: d) && !surplus_identity_within_retirement_scope(d: d)
    SurplusOwnedRetiree { name: _, host: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    UnownedRegistration { name: _, cause: _ } => false
  }
}

// SCOPE NEEDS BOTH FACTS. srv4 issues its own names, so ownership holds -- and srv4 carries no
// declared retirement, so its owned surplus is in scope for nothing while still blocking.
test fn ownership_without_a_declared_retirement_is_not_in_retirement_scope() -> Bool {
  let d = disposition_of(host: operator_host_srv4, reg: registration(name: "srv4-31", id: 431))
  match d {
    SurplusOwnedRetiree { name: _, host: _ } =>
      !surplus_identity_within_retirement_scope(d: d) && surplus_identity_blocks_closure(d: d)
    CommittedSlotIdentity { name: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    UnownedRegistration { name: _, cause: _ } => false
  }
}

// THE POSITIVE CONTROL FOR SCOPE, without which every row above is satisfied by a predicate that
// admits nothing. Note what it does NOT establish: scope is not deletion admission, which stays at
// slot_removal_realization's RemovalTeardownAuthorized behind an exact RetirementComplete.
test fn ownership_plus_a_declared_retirement_is_in_retirement_scope() -> Bool {
  surplus_identity_within_retirement_scope(
    d: disposition_of(host: operator_host_srv2, reg: registration(name: "srv2-07", id: 707)),
  )
}

// AN UNOWNED REGISTRATION IS NEVER IN SCOPE AND IS STILL ACCOUNTED FOR -- not in scope is not
// permission to stop looking, which is the half the filter reading loses.
test fn an_unowned_registration_blocks_without_entering_scope() -> Bool {
  let d = disposition_of(host: operator_host_srv2, reg: registration(name: "someone-elses-runner", id: 901))
  !surplus_identity_within_retirement_scope(d: d) && surplus_identity_blocks_closure(d: d)
}

test fn ownership_is_read_off_the_registration_naming_authority() -> Bool {
  ownership_is_established(e: registration_ownership(host: operator_host_srv2, name: "srv2-01" as NonEmptyStr, organization: witness_org, agent_id: 11, capture: owned_capture(bindings: [witness_binding(slot: "srv2-01", agent_id: 11, name: "srv2-01")])))
    && !ownership_is_established(e: registration_ownership(host: operator_host_srv2, name: "srv4-01" as NonEmptyStr, organization: witness_org, agent_id: 12, capture: owned_capture(bindings: [witness_binding(slot: "srv4-01", agent_id: 12, name: "srv4-01")])))
    && !ownership_is_established(e: registration_ownership(host: operator_host_srv2, name: "actions-runner@srv2-01.service" as NonEmptyStr, organization: witness_org, agent_id: 13, capture: owned_capture(bindings: [])))
}

// THE REQUIRED DISCRIMINATOR: a name inside srv2's namespace that names no canonical slot must NOT
// establish ownership. Under the previous prefix test both of these were OwnershipEstablished, and a
// registration nobody in this estate issued would have become an owned retiree.
test fn a_namespace_shaped_name_that_names_no_slot_is_not_owned() -> Bool {
  match registration_ownership(host: operator_host_srv2, name: "srv2-not-a-slot" as NonEmptyStr, organization: witness_org, agent_id: 14, capture: owned_capture(bindings: [])) {
    OwnershipCandidateUnresolved { name: _, cause: _ } => true
    OwnershipEstablished { host: _, slot_index: _, observed_on: _, basis: _ } => false
    OwnershipCanonicalUnresolved { name: _, slot_index: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

test fn a_bare_host_prefix_is_not_owned() -> Bool {
  match registration_ownership(host: operator_host_srv2, name: "srv2-" as NonEmptyStr, organization: witness_org, agent_id: 15, capture: owned_capture(bindings: [])) {
    OwnershipCandidateUnresolved { name: _, cause: _ } => true
    OwnershipEstablished { host: _, slot_index: _, observed_on: _, basis: _ } => false
    OwnershipCanonicalUnresolved { name: _, slot_index: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

// AN UNRESOLVED CANDIDATE BLOCKS AND IS NOT IN SCOPE -- it is neither promoted to ours nor dropped.
test fn an_unresolved_candidate_blocks_without_entering_scope() -> Bool {
  let d = disposition_of(host: operator_host_srv2, reg: registration(name: "srv2-not-a-slot", id: 950))
  match d {
    UnresolvedCandidate { name: _, cause: _ } =>
      surplus_identity_blocks_closure(d: d) && !surplus_identity_within_retirement_scope(d: d)
    SurplusOwnedRetiree { name: _, host: _ } => false
    CommittedSlotIdentity { name: _ } => false
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    UnownedRegistration { name: _, cause: _ } => false
  }
}

// THE CANONICAL INDEX IS CARRIED, which is what makes this an identity rather than a shape match.
test fn an_owned_registration_carries_its_canonical_slot_index() -> Bool {
  match registration_ownership(host: operator_host_srv2, name: "srv2-07" as NonEmptyStr, organization: witness_org, agent_id: 707, capture: owned_capture(bindings: [witness_binding(slot: "srv2-07", agent_id: 707, name: "srv2-07")])) {
    OwnershipEstablished { host: _, slot_index: i, observed_on: _, basis: _ } => (i as Int) == 7
    OwnershipCanonicalUnresolved { name: _, slot_index: _, cause: _ } => false
    OwnershipCandidateUnresolved { name: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

// THE UNIT PROJECTION IS THE EXISTING ONE, not a second composition of prefix/name/suffix.
test fn the_unit_projection_matches_the_shared_authority() -> Bool {
  (unit_name_for_owned_registration(name: "srv2-07" as NonEmptyStr) as String)
    == (runner_unit_name_of_registration(registration_name: "srv2-07" as NonEmptyStr) as String)
}

// THE UNIT IDENTITY IS DERIVED FROM THE REGISTRATION, and the two grammars stay distinguishable.
test fn the_unit_identity_is_derived_from_the_owned_registration() -> Bool {
  (unit_name_for_owned_registration(name: "srv2-07" as NonEmptyStr) as String) == "actions-runner@srv2-07.service"
}

// THE OBLIGATION IS NOT GROUNDED WHILE IT COMES FROM A SEARCH BOUND, and the closure is told so
// rather than the authored number being laundered into observed history.
test fn a_search_bound_obligation_is_reported_ungrounded() -> Bool {
  let b = host_retirement_obligation_basis(host: operator_host_srv2)
  match b {
    ObligationFromSearchBound { units: _, bound: n, cause: _ } =>
      n == 21
        && match retiree_obligation_ungrounded_cause(b: b) {
             Present { value: _ } => true
             Absent => false
           }
    ObligationFromCapturedSnapshot { observed_on: _, units: _ } => false
    ObligationAbsent { host: _ } => false
  }
}

// ── SLOT RETIREMENT SATISFIED IS NOT ESTATE CLEANUP ──────────────────────────────────────────

// THE DISCRIMINATING RED. Discharging the timer alone leaves the registration and the tree
// outstanding; there is no arm of the fold in which slot evidence closes them.
test fn discharging_one_estate_obligation_does_not_complete_the_estate() -> Bool {
  match estate_cleanup_standing(standings: [
    EstateObligationDischarged { obligation: LivenessReconcileTimerRetired, evidence: "masked" },
  ]) {
    EstateCleanupOutstanding { outstanding: os } => list_length(items: os) == 2
    EstateCleanupComplete => false
  }
}

// AN OBLIGATION WITH NO STANDING AT ALL IS OUTSTANDING, NOT ABSENT -- completeness is an identity
// join over the closed roster rather than a count over whatever standings arrived.
test fn an_estate_obligation_with_no_standing_is_outstanding() -> Bool {
  match estate_cleanup_standing(standings: []) {
    EstateCleanupOutstanding { outstanding: os } => list_length(items: os) == 3
    EstateCleanupComplete => false
  }
}

// AN UNOBSERVED OBLIGATION DOES NOT DISCHARGE, which is the fail-closed direction: a reading nobody
// could take is not a reading that succeeded.
test fn an_unobserved_estate_obligation_does_not_discharge() -> Bool {
  match estate_cleanup_standing(standings: [
    EstateObligationUnobserved { obligation: RegistrationRemoval, cause: "no app credential" },
    EstateObligationDischarged { obligation: RunnerTreeRemoval, evidence: "absent" },
    EstateObligationDischarged { obligation: LivenessReconcileTimerRetired, evidence: "masked" },
  ]) {
    EstateCleanupOutstanding { outstanding: os } => list_length(items: os) == 1
    EstateCleanupComplete => false
  }
}

// THE POSITIVE CONTROL. All three discharged completes, so the rows above are not satisfied by a
// fold that never completes.
test fn all_three_estate_obligations_discharged_completes() -> Bool {
  match estate_cleanup_standing(standings: [
    EstateObligationDischarged { obligation: RegistrationRemoval, evidence: "delisted" },
    EstateObligationDischarged { obligation: RunnerTreeRemoval, evidence: "absent" },
    EstateObligationDischarged { obligation: LivenessReconcileTimerRetired, evidence: "masked" },
  ]) {
    EstateCleanupComplete => true
    EstateCleanupOutstanding { outstanding: _ } => false
  }
}


// ── THE RECONCILE MECHANISM ──────────────────────────────────────────────────────────────────

fn reading(file_state: String, timer_active: String, service_active: String) -> ReconcileMechanismReading {
  ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "loaded" },
    timer_unit_file_state: ReconcilePropertyValue { value: file_state },
    timer_active_state: ReconcilePropertyValue { value: timer_active },
    service_active_state: ReconcilePropertyValue { value: service_active },
  }
}

fn srv2_standing(r: ReconcileMechanismReading) -> EstateObligationStanding {
  reconcile_timer_estate_standing(
    intent: runner_liveness_reconcile_timer_intent(host: operator_host_srv2),
    reading: r,
  )
}

fn is_discharged(s: EstateObligationStanding) -> Bool {
  match s {
    EstateObligationDischarged { obligation: _, evidence: _ } => true
    EstateObligationOutstanding { obligation: _, cause: _ } => false
    EstateObligationUnobserved { obligation: _, cause: _ } => false
  }
}

fn is_outstanding(s: EstateObligationStanding) -> Bool {
  match s {
    EstateObligationOutstanding { obligation: _, cause: _ } => true
    EstateObligationDischarged { obligation: _, evidence: _ } => false
    EstateObligationUnobserved { obligation: _, cause: _ } => false
  }
}

fn is_unobserved(s: EstateObligationStanding) -> Bool {
  match s {
    EstateObligationUnobserved { obligation: _, cause: _ } => true
    EstateObligationDischarged { obligation: _, evidence: _ } => false
    EstateObligationOutstanding { obligation: _, cause: _ } => false
  }
}

// THE INTENT IS DERIVED FROM THE RETIREMENT ROSTER, so declaring the retirement IS declaring the
// intent and there is no second list to fall out of step with it.
test fn a_retiring_host_intends_its_reconcile_timer_retired() -> Bool {
  match runner_liveness_reconcile_timer_intent(host: operator_host_srv2) {
    ReconcileTimerRetired { host: _, unit: _, reason: _ } => true
    ReconcileTimerActive { host: _ } => false
  }
}

// AND THE RED: a host still in the estate keeps its timer, so the intent is not Retired everywhere.
test fn a_retained_host_intends_its_reconcile_timer_active() -> Bool {
  match runner_liveness_reconcile_timer_intent(host: operator_host_srv4) {
    ReconcileTimerActive { host: _ } => true
    ReconcileTimerRetired { host: _, unit: _, reason: _ } => false
  }
}

// THE POSITIVE CONTROL: inhibited, inactive, and its triggered reconciler is not running.
test fn an_inhibited_quiescent_mechanism_discharges() -> Bool {
  is_discharged(s: srv2_standing(r: reading(file_state: "masked", timer_active: "inactive", service_active: "inactive")))
}

// THE CASE THE ONE-PROPERTY OBSERVER GOT WRONG: systemd documents that disabling a unit does not stop
// it, so a DISABLED but still ACTIVE timer is armed and the obligation is outstanding. The first
// version discharged here.
test fn a_disabled_but_active_timer_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: reading(file_state: "disabled", timer_active: "active", service_active: "inactive")))
}

// AND THE SECOND THING ONE PROPERTY COULD NOT SEE: the timer is gone, and a reconcile invocation it
// already started is still running and still restoring runners.
test fn a_stopped_timer_with_a_running_reconciler_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: reading(file_state: "masked", timer_active: "inactive", service_active: "active")))
}

// AN ENABLED TIMER IS NOT PERSISTENTLY INHIBITED whatever it is doing right now.
test fn an_enabled_timer_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: reading(file_state: "enabled", timer_active: "inactive", service_active: "inactive")))
}

// A BLANK ENABLEMENT STATE IS UNKNOWN, NOT OFF. The first version read blank as not-enabled and
// discharged, which is a refused or fragment-less read minting a retirement.
test fn a_blank_enablement_state_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: reading(file_state: "", timer_active: "inactive", service_active: "inactive")))
}

// AND A SPELLING THIS MODEL DOES NOT RECOGNIZE IS UNKNOWN TOO, rather than falling through to off.
test fn an_unrecognized_enablement_state_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: reading(file_state: "not-a-systemd-state", timer_active: "inactive", service_active: "inactive")))
}

// AND A REAL STATE THE OLD LOCAL LITERAL LIST DID NOT CARRY IS NOW KNOWN AND NOT INHIBITING.
// `generated` read as UNRECOGNIZED against the hand-spelled list this file used to keep; consuming
// the upstream vocabulary is what makes it legible, which is the drift a second spelling invites.
test fn a_generated_unit_file_state_is_known_and_not_inhibiting() -> Bool {
  is_outstanding(s: srv2_standing(r: reading(file_state: "generated", timer_active: "inactive", service_active: "inactive")))
}

// A REFUSED READ OF ANY OF THE THREE BLOCKS. A property nobody could take cannot discharge the two
// that were taken.
test fn an_unreadable_property_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "loaded" },
    timer_unit_file_state: ReconcilePropertyValue { value: "masked" },
    timer_active_state: ReconcilePropertyUnreadable { cause: "ssh refused" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// A FULLY QUIESCENT MECHANISM ON A HOST THAT IS NOT RETIRING STILL DOES NOT DISCHARGE. Recording a
// retired timer against a host still in the estate would be a false fact about a working machine.
test fn a_quiescent_mechanism_on_a_retained_host_does_not_discharge() -> Bool {
  is_outstanding(s: reconcile_timer_estate_standing(
    intent: runner_liveness_reconcile_timer_intent(host: operator_host_srv4),
    reading: reading(file_state: "masked", timer_active: "inactive", service_active: "inactive"),
  ))
}

// A RUNTIME MASK LASTS UNTIL THE NEXT REBOOT, so it cannot discharge an obligation that the mechanism
// will not come back. The previous version accepted it as persistent inhibition.
test fn a_runtime_mask_does_not_discharge() -> Bool {
  is_outstanding(s: srv2_standing(r: reading(file_state: "masked-runtime", timer_active: "inactive", service_active: "inactive")))
}

// BLANK TIMER ACTIVITY IS UNOBSERVED. `masked / blank / inactive` discharged before: a blank
// ActiveState is what systemctl returns for a unit the manager does not hold, which is a fact about
// the query rather than about quiescence.
test fn a_blank_timer_activity_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: reading(file_state: "masked", timer_active: "", service_active: "inactive")))
}

// AND BLANK RECONCILER ACTIVITY TOO -- the second of the pair, which the enablement-only blank
// control could not see.
test fn a_blank_reconciler_activity_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: reading(file_state: "masked", timer_active: "inactive", service_active: "")))
}


// AN UNREADABLE LOAD STATE BLOCKS, so absence cannot be inferred from a refused read.
test fn an_unreadable_load_state_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyUnreadable { cause: "ssh refused" },
    timer_unit_file_state: ReconcilePropertyValue { value: "masked" },
    timer_active_state: ReconcilePropertyValue { value: "inactive" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// ── R5: A CONTRADICTORY ESTATE READING CANNOT MINT COMPLETION ────────────────────────────────

// THREE DISCHARGED OBLIGATIONS PLUS AN UNOBSERVED READING FOR ONE OF THEM. The previous fold filtered
// to the discharged subset and never looked outside it, so this produced EstateCleanupComplete.
test fn a_contradictory_estate_reading_blocks_completion() -> Bool {
  match estate_cleanup_standing(standings: [
    EstateObligationDischarged { obligation: RegistrationRemoval, evidence: "delisted" },
    EstateObligationDischarged { obligation: RunnerTreeRemoval, evidence: "absent" },
    EstateObligationDischarged { obligation: LivenessReconcileTimerRetired, evidence: "masked" },
    EstateObligationUnobserved { obligation: RegistrationRemoval, cause: "read failed" },
  ]) {
    EstateCleanupOutstanding { outstanding: os } => list_length(items: os) == 1
    EstateCleanupComplete => false
  }
}

// AND IN THE OTHER ORDER, because a fold that scans for the first or the last match is order
// sensitive and this one must not be.
test fn a_contradictory_estate_reading_blocks_in_either_order() -> Bool {
  match estate_cleanup_standing(standings: [
    EstateObligationUnobserved { obligation: RegistrationRemoval, cause: "read failed" },
    EstateObligationDischarged { obligation: RegistrationRemoval, evidence: "delisted" },
    EstateObligationDischarged { obligation: RunnerTreeRemoval, evidence: "absent" },
    EstateObligationDischarged { obligation: LivenessReconcileTimerRetired, evidence: "masked" },
  ]) {
    EstateCleanupOutstanding { outstanding: os } => list_length(items: os) == 1
    EstateCleanupComplete => false
  }
}

// AN AGREEING DUPLICATE IS STILL A DUPLICATE AND IS REFUSED, because two readings of one subject are
// one observation taken twice only if something established that -- and nothing here did.
test fn a_duplicate_estate_reading_is_not_settled() -> Bool {
  !estate_obligation_is_settled(
    standings: [
      EstateObligationDischarged { obligation: RunnerTreeRemoval, evidence: "absent" },
      EstateObligationDischarged { obligation: RunnerTreeRemoval, evidence: "absent" },
    ],
    o: RunnerTreeRemoval,
  )
}

// ── R7: CAPTURE AVAILABILITY IS NOT MEMBER COUNT ─────────────────────────────────────────────

// AN UNAVAILABLE CAPTURE LEAVES THE POPULATION UNGROUNDED, and the cause is available for a consumer
// to block on rather than only to print.
test fn an_unavailable_capture_yields_an_ungrounded_cause() -> Bool {
  match retiree_obligation_ungrounded_cause(b: host_retirement_obligation_basis(host: operator_host_srv2)) {
    Present { value: _ } => true
    Absent => false
  }
}

// A COMPLETE CAPTURE THAT FOUND NOTHING IS GROUNDED AND EMPTY -- the case a bare list could not
// express, and the direction the repair must not break.
test fn a_complete_but_empty_capture_is_grounded() -> Bool {
  match host_retirement_obligation_basis_of(
    capture: CaptureCensusComplete { observed_on: "2026-09-19" as NonEmptyStr, bindings: [], unresolved: [] },
    host: operator_host_srv2,
    bound: 21,
  ) {
    ObligationFromCapturedSnapshot { observed_on: _, units: us } => list_length(items: us) == 0
    ObligationFromSearchBound { units: _, bound: _, cause: _ } => false
    ObligationAbsent { host: _ } => false
  }
}

// A PARTIAL CAPTURE IS NOT GROUNDED HOWEVER MANY MEMBERS IT CARRIES, because the members it missed
// are exactly the ones an assessment would stop looking for.
test fn a_partial_capture_is_not_grounded() -> Bool {
  match host_retirement_obligation_basis_of(
    capture: CaptureCensusPartial {
      observed_on: "2026-09-19" as NonEmptyStr,
      bindings: [witness_binding(slot: "srv2-01", agent_id: 11, name: "srv2-01")],
      unresolved: [],
      cause: "page 1 of 3",
    },
    host: operator_host_srv2,
    bound: 21,
  ) {
    ObligationFromSearchBound { units: _, bound: _, cause: _ } => true
    ObligationFromCapturedSnapshot { observed_on: _, units: _ } => false
    ObligationAbsent { host: _ } => false
  }
}

// ── R3: RECOGNITION IS NOT OWNERSHIP ─────────────────────────────────────────────────────────

// THE REQUIRED DISCRIMINATOR: the same canonical name, separated by whether ownership evidence
// exists. Previously both of these were OwnershipEstablished, because the forward name match was the
// whole test and no capture participated in it.
test fn a_canonical_name_without_capture_is_recognized_but_unresolved() -> Bool {
  match registration_ownership(
    host: operator_host_srv2,
    name: "srv2-07" as NonEmptyStr,
    organization: witness_org,
    agent_id: 707,
    capture: CaptureCensusUnavailable { cause: "no capture census has been taken" },
  ) {
    OwnershipCanonicalUnresolved { name: _, slot_index: i, cause: _ } => (i as Int) == 7
    OwnershipEstablished { host: _, slot_index: _, observed_on: _, basis: _ } => false
    OwnershipCandidateUnresolved { name: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

// A PARTIAL CENSUS STILL ESTABLISHES A MEMBER IT DID OBSERVE, and this claim previously asserted the
// opposite. The earlier rule refused ownership from ANY partial capture on the reasoning that a hit
// inside a prefix reads the prefix as the world. That is true of the POPULATION claim and false of
// the MEMBER claim: a binding the census actually took is sound whether or not other captures went
// unread, and refusing it would make an incomplete scan unable to establish anything at all.
//
// The population question is asked separately and still refuses -- see the basis controls below.
test fn a_partial_census_establishes_a_member_it_observed() -> Bool {
  match registration_ownership(
    host: operator_host_srv2,
    name: "srv2-07" as NonEmptyStr,
    organization: witness_org,
    agent_id: 707,
    capture: CaptureCensusPartial {
      observed_on: "2026-09-19" as NonEmptyStr,
      bindings: [witness_binding(slot: "srv2-07", agent_id: 707, name: "srv2-07")],
      unresolved: [],
      cause: "page 1 of 3",
    },
  ) {
    OwnershipEstablished { host: _, slot_index: _, observed_on: _, basis: _ } => true
    OwnershipCanonicalUnresolved { name: _, slot_index: _, cause: _ } => false
    OwnershipCandidateUnresolved { name: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

// AND A MEMBER THE PARTIAL CENSUS DID NOT OBSERVE STAYS UNRESOLVED, so admitting from a partial
// census did not become admitting anything.
test fn a_partial_census_leaves_an_unobserved_member_unresolved() -> Bool {
  match registration_ownership(
    host: operator_host_srv2,
    name: "srv2-07" as NonEmptyStr,
    organization: witness_org,
    agent_id: 707,
    capture: CaptureCensusPartial {
      observed_on: "2026-09-19" as NonEmptyStr,
      bindings: [witness_binding(slot: "srv2-01", agent_id: 11, name: "srv2-01")],
      unresolved: [],
      cause: "page 1 of 3",
    },
  ) {
    OwnershipCanonicalUnresolved { name: _, slot_index: _, cause: _ } => true
    OwnershipEstablished { host: _, slot_index: _, observed_on: _, basis: _ } => false
    OwnershipCandidateUnresolved { name: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

// AND A COMPLETE CAPTURE THAT DOES NOT LIST IT leaves the canonical name unresolved rather than
// asserting we own it -- the estate looked and this is not ours.
test fn a_complete_capture_that_omits_the_name_leaves_it_unresolved() -> Bool {
  match registration_ownership(
    host: operator_host_srv2,
    name: "srv2-07" as NonEmptyStr,
    organization: witness_org,
    agent_id: 707,
    capture: owned_capture(bindings: [witness_binding(slot: "srv2-01", agent_id: 11, name: "srv2-01")]),
  ) {
    OwnershipCanonicalUnresolved { name: _, slot_index: _, cause: _ } => true
    OwnershipEstablished { host: _, slot_index: _, observed_on: _, basis: _ } => false
    OwnershipCandidateUnresolved { name: _, cause: _ } => false
    OwnershipForeign { name: _, cause: _ } => false
  }
}

// AN UNRESOLVED CANONICAL IDENTITY IS ACCOUNTED FOR AND NOT OWNED: it blocks the closure and does not
// enter retirement scope, which is "neither silently omitted nor asserted owned".
test fn an_unresolved_canonical_identity_blocks_without_entering_scope() -> Bool {
  let d = disposition_without_capture(host: operator_host_srv2, reg: registration(name: "srv2-07", id: 707))
  match d {
    CanonicalOwnershipUnresolved { name: _, slot_index: _, cause: _ } =>
      surplus_identity_blocks_closure(d: d) && !surplus_identity_within_retirement_scope(d: d)
    SurplusOwnedRetiree { name: _, host: _ } => false
    UnresolvedCandidate { name: _, cause: _ } => false
    CommittedSlotIdentity { name: _ } => false
    UnownedRegistration { name: _, cause: _ } => false
  }
}

// ── R4: TIMER ABSENCE DOES NOT ANSWER THE SERVICE'S QUESTION ─────────────────────────────────

// AN ABSENT TIMER BESIDE A RUNNING RECONCILER IS OUTSTANDING. The absence branch discharged before
// looking at this value.
test fn an_absent_timer_with_a_running_reconciler_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-found" },
    timer_unit_file_state: ReconcilePropertyValue { value: "" },
    timer_active_state: ReconcilePropertyValue { value: "inactive" },
    service_active_state: ReconcilePropertyValue { value: "active" },
  }))
}

// AND BESIDE A BLANK ONE IT IS UNOBSERVED, because a blank activity establishes nothing about the
// service and absence of the timer does not stand in for it.
test fn an_absent_timer_with_a_blank_reconciler_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-found" },
    timer_unit_file_state: ReconcilePropertyValue { value: "" },
    timer_active_state: ReconcilePropertyValue { value: "inactive" },
    service_active_state: ReconcilePropertyValue { value: "" },
  }))
}

// THE REPAIRED POSITIVE CONTROL: every discharged part has its own evidence. The timer is positively
// absent AND the service is positively inactive -- the service's state is read for the service, not
// borrowed from the timer's LoadState.
test fn an_absent_timer_with_an_established_quiescent_reconciler_discharges() -> Bool {
  is_discharged(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-found" },
    timer_unit_file_state: ReconcilePropertyValue { value: "" },
    timer_active_state: ReconcilePropertyValue { value: "inactive" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// ── R7: THE SEARCH BOUND PRODUCES DISCOVERY SUBJECTS, NOT OBLIGATIONS ────────────────────────

// srv2's capture is unavailable, so its OBLIGATION is empty and its DISCOVERY set is the bound.
// Previously the bound's 21 candidates flowed into the obligation and on into interruption coverage.
test fn an_ungrounded_host_owes_nothing_and_offers_discovery_subjects() -> Bool {
  list_length(items: host_retirement_required_retirees(host: operator_host_srv2)) == 0
    && list_length(items: host_retirement_discovery_subjects(host: operator_host_srv2)) == 21
}

// AND THE OBLIGATION SEAM AGREES: srv2 contributes no required retiree to the consumed union while
// its population is ungrounded.
test fn the_consumed_seam_carries_no_ungrounded_candidates() -> Bool {
  list_length(items: transition_required_retiring(host: operator_host_srv2)) == 0
}

// ── R4: THE TIMER'S OWN ACTIVITY IS ORTHOGONAL TO ITS LOAD STATE ─────────────────────────────

// systemd documents LoadState and ActiveState as independent: a unit whose configuration is not
// loaded may still be RUNNING. The absence branch discharged before reading this value.
test fn an_absent_but_active_timer_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-found" },
    timer_unit_file_state: ReconcilePropertyValue { value: "" },
    timer_active_state: ReconcilePropertyValue { value: "active" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// AND THE TRANSITIONAL SPELLINGS TOO -- a timer mid-stop still owns its runtime.
test fn an_absent_but_deactivating_timer_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-found" },
    timer_unit_file_state: ReconcilePropertyValue { value: "" },
    timer_active_state: ReconcilePropertyValue { value: "deactivating" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// A BLANK TIMER ACTIVITY DOES NOT BECOME QUIESCENT BECAUSE THE CONFIGURATION WAS NOT FOUND.
test fn an_absent_timer_with_blank_activity_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-found" },
    timer_unit_file_state: ReconcilePropertyValue { value: "" },
    timer_active_state: ReconcilePropertyValue { value: "" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// AN UNRECOGNIZED LOAD STATE IS UNKNOWN, NOT ABSENT AND NOT LOADED. The five words are cited to
// systemd.unit(5) and now live in extdeps; a sixth spelling systemd might add must not default in
// either direction, which is what the parser's absent arm establishes through this fold.
test fn an_unrecognized_load_state_is_unobserved() -> Bool {
  is_unobserved(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "not-a-load-state" },
    timer_unit_file_state: ReconcilePropertyValue { value: "masked" },
    timer_active_state: ReconcilePropertyValue { value: "inactive" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// AND A `masked` LOAD STATE IS KNOWN AND NOT ABSENT -- it is one of the cited five, and reading it as
// absence would discharge on a unit the manager is actively refusing to load.
test fn a_masked_load_state_is_known_and_not_absent() -> Bool {
  is_discharged(s: srv2_standing(r: ReconcileMechanismReading {
    timer_load_state: ReconcilePropertyValue { value: "masked" },
    timer_unit_file_state: ReconcilePropertyValue { value: "masked" },
    timer_active_state: ReconcilePropertyValue { value: "inactive" },
    service_active_state: ReconcilePropertyValue { value: "inactive" },
  }))
}

// ── ONLY A MASK INHIBITS ─────────────────────────────────────────────────────────────────────

// A DISABLED RECONCILER IS OUTSTANDING. disable removes the [Install] symlinks so the unit will not
// be armed at boot, and does not refuse activation: it still starts on an explicit systemctl start
// and still starts when another unit pulls it in through Wants= or Requires=. Either restores the
// population this retirement removes, so the weaker act must not discharge the stronger claim.
// Operator decision 2026-09-19, after srv2's timer was first retired with disable --now.
test fn a_disabled_reconciler_is_outstanding() -> Bool {
  is_outstanding(s: srv2_standing(r: reading(file_state: "disabled", timer_active: "inactive", service_active: "inactive")))
}

// AND THE POSITIVE CONTROL IS NOW A MASK, which is the state srv2 was subsequently put into: both
// the timer and its service masked, with systemctl start refused as masked.
test fn a_masked_reconciler_discharges() -> Bool {
  is_discharged(s: srv2_standing(r: reading(file_state: "masked", timer_active: "inactive", service_active: "inactive")))
}

// ── MASKING A UNIT IN THE MANAGED DIRECTORY NEEDS THE FRAGMENT MOVED FIRST ───────────────────

// MEASURED ON srv2: mask refused until the fragments were moved out of /etc/systemd/system. The
// precondition is typed so a plan renders the relocation before the mask, rather than the mask
// failing at apply time.
test fn a_fragment_in_the_managed_directory_requires_relocation() -> Bool {
  match mask_fragment_precondition(
    unit: "runner-liveness-reconcile.timer" as NonEmptyStr,
    fragment_path: ReconcilePropertyValue { value: "/etc/systemd/system/runner-liveness-reconcile.timer" },
  ) {
    MaskFragmentRelocationRequired { unit: _, fragment_path: fp, cause: _ } =>
      (fp as String) == "/etc/systemd/system/runner-liveness-reconcile.timer"
    MaskFragmentClear { unit: _ } => false
    MaskFragmentUnobserved { unit: _, cause: _ } => false
  }
}

// A FRAGMENT SHIPPED ELSEWHERE NEEDS NO RELOCATION -- /usr/lib is not the directory mask writes into,
// so the symlink has nothing to collide with.
test fn a_vendor_fragment_needs_no_relocation() -> Bool {
  match mask_fragment_precondition(
    unit: "runner-liveness-reconcile.timer" as NonEmptyStr,
    fragment_path: ReconcilePropertyValue { value: "/usr/lib/systemd/system/runner-liveness-reconcile.timer" },
  ) {
    MaskFragmentClear { unit: _ } => true
    MaskFragmentRelocationRequired { unit: _, fragment_path: _, cause: _ } => false
    MaskFragmentUnobserved { unit: _, cause: _ } => false
  }
}

// AN UNREADABLE FragmentPath IS UNOBSERVED, not clear: a mask planned on an unread precondition is
// the apply-time failure this carrier exists to move earlier.
test fn an_unreadable_fragment_path_is_unobserved() -> Bool {
  match mask_fragment_precondition(
    unit: "runner-liveness-reconcile.timer" as NonEmptyStr,
    fragment_path: ReconcilePropertyUnreadable { cause: "ssh refused" },
  ) {
    MaskFragmentUnobserved { unit: _, cause: _ } => true
    MaskFragmentClear { unit: _ } => false
    MaskFragmentRelocationRequired { unit: _, fragment_path: _, cause: _ } => false
  }
}
