data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data attempt: NonEmptyStr = "q-1"
data branch: NonEmptyStr = "main"
data revision: CommitSha = "1111111111111111111111111111111111111111"
data floor_job_id: NonEmptyStr = "qualification-floor"

// ── THE SUBJECT, THROUGH THE REAL MINT ──────────────────────────────────────────────────────────
// The registration and the delivered credential come from the route's own JIT mint over the real
// managed-host roster: each claim calls dispatch_jit_mint itself (admitted by name), and the subject mint takes its sealed AuthorizedJitMintDispatch with receive_jit_mint over a 201
// decoded by upstream's own outcome fold (runner id 4242). Nothing below constructs a registration,
// and every caller of the sealed subject mint is a claim returning Bool (no constructor proxy).





fn slot_binding(h: ManagedHost, slot_workflow: NonEmptyStr) -> JitSlotBinding {
  HostUnitSlotBinding { standing: host_unit_slot_for(host: managed_host_binding(host: h), attempt: attempt, workflow: slot_workflow) }
}

fn delivered(d: AuthorizedJitMintDispatch) -> JitCredentialDelivery {
  receive_jit_mint(dispatch: JitMintDispatchAuthorized { dispatch: d }, outcome: minted_outcome)
}

fn qualification_slot() -> NonEmptyStr {
  qualification_selected_workflow(branch: branch)
}

fn floor_job(runs_on: RunnerSpec) -> Job {
  Job {
    id: floor_job_id as String,
    name: Present { value: "qualification floor" },
    runner: runs_on,
    environment: none,
    steps: [],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}

data attempt_runs_on: RunnerSpec = RunsOnExpression { expression: "${{ inputs.runner_attempt_label }}" }

fn workflow_with(declares_input: Bool, runs_on: RunnerSpec) -> Workflow {
  Workflow {
    name: "fleet-converge",
    run_name: none,
    on: [WorkflowDispatch { inputs: if declares_input { [qualification_attempt_dispatch_input] } else { [] } }],
    concurrency: none,
    jobs: [floor_job(runs_on: runs_on)],
    env: none,
    permissions: none,
  }
}

// POSITIVE CONTROL AND THE ROUTE: the subject carries the slot's own attempt and host, the runner id
// GitHub returned for that registration, and the floor job's name; the dispatch sends exactly the
// declared input carrying that attempt, which is a label the slot registered; the effect names the
// generated fleet-converge workflow file in gunbc_repository at the pinned revision.
test fn the_subject_binds_the_minted_runner_and_the_attempt_input() -> Bool {
  match first(managed_hosts()) {
    Present { value: h } => match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: qualification_slot()), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: qualification_slot()), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
      JitMintDispatchAuthorized { dispatch: d } => {
  match qualification_dispatch_subject_over(
    dispatch: d, delivery: delivered(d: d),
    workflow: workflow_with(declares_input: true, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
  ) {
    QualificationSubjectAdmitted { subject: s } =>
      s.attempt == attempt && (s.registration.name.value as String) == (ephemeral_slot_unit(host: h.host, attempt: attempt) as String)
        && (s.floor_job_name as String) == "qualification floor"
        && (s.host as String) == (h.host as String)
        && count(map_keys(qualification_dispatch_inputs(attempt: s.attempt))) == 1
        && (match map_get(qualification_dispatch_inputs(attempt: s.attempt), qualification_attempt_dispatch_input.name) {
          Present { value: v } => v == (attempt as String) && (ephemeral_slot_labels(host: h.host, attempt: attempt) |> any(l => l == v))
          Absent => false
        })
        && (match qualification_dispatch_effect(subject: s) {
          DispatchWorkflow { repository: r, workflow: w, subject: sha } =>
            r.full_name == "gunb-ai/gunbc" && (w.file_name as String) == "fleet-converge.yml" && (sha as String) == (revision as String)
          _ => false
        })
    QualificationSubjectRefused { refusal: _ } => false
  }
    }
      JitMintDispatchRefused { refusal: _ } => false
    }
    Absent => false
  }
}

fn slot_refuses(h: ManagedHost, slot_workflow: NonEmptyStr) -> Bool {
  match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: slot_workflow), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: slot_workflow), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
    JitMintDispatchAuthorized { dispatch: other } =>
      match qualification_dispatch_subject_over(
        dispatch: other, delivery: delivered(d: other),
        workflow: workflow_with(declares_input: true, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
      ) {
        QualificationSubjectRefused { refusal: SubjectSlotForAnotherWorkflow { slot_workflow: sw, qualification_workflow: _ } } => (sw as String) == (slot_workflow as String)
        _ => false
      }
    JitMintDispatchRefused { refusal: _ } => false
  }
}

fn runs_on_refuses(h: ManagedHost, d: AuthorizedJitMintDispatch, runs_on: RunnerSpec) -> Bool {
  match qualification_dispatch_subject_over(
    dispatch: d, delivery: delivered(d: d),
    workflow: workflow_with(declares_input: true, runs_on: runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
  ) {
    QualificationSubjectRefused { refusal: SubjectFloorRunsOnNotTheAttemptInput { job_id: _, runs_on: _ } } => true
    _ => false
  }
}

fn undeclared_input_refuses(h: ManagedHost, d: AuthorizedJitMintDispatch) -> Bool {
  match qualification_dispatch_subject_over(
    dispatch: d, delivery: delivered(d: d),
    workflow: workflow_with(declares_input: false, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
  ) {
    QualificationSubjectRefused { refusal: SubjectAttemptInputUndeclared { input: _ } } => true
    _ => false
  }
}

// THE RULING'S SCOPE IS CONSTRUCTION, AND THIS IS ITS RED. Through the one mint, no other workflow
// and no other label can become a dispatch subject:
//   - a slot registered for another workflow file, or for the qualification path on another branch,
//     refuses before the workflow model is read;
//   - a floor job whose runs-on is a literal label, another input, the attempt input composed with
//     anything else, or a bare string, refuses;
//   - a workflow that does not declare the input refuses;
//   - the production mint, over today's generated fleet-converge model (no qualification mode yet),
//     refuses rather than admitting anything.
test fn no_other_workflow_or_label_can_be_dispatched_through_the_ruling() -> Bool {
  match first(managed_hosts()) {
    Present { value: h } => match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: qualification_slot()), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: qualification_slot()), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
      JitMintDispatchAuthorized { dispatch: d } => {
  slot_refuses(h: h, slot_workflow: "gunb-ai/gunbc/.github/workflows/witnesses.yml@refs/heads/main")
    && slot_refuses(h: h, slot_workflow: qualification_selected_workflow(branch: "feature"))
    && runs_on_refuses(h: h, d: d, runs_on: SelfHosted { labels: [attempt as String] })
    && runs_on_refuses(h: h, d: d, runs_on: RunsOnExpression { expression: "${{ inputs.runner }}" })
    && runs_on_refuses(h: h, d: d, runs_on: RunsOnExpression { expression: "${{ inputs.runner_attempt_label }}-x" })
    && runs_on_refuses(h: h, d: d, runs_on: RunsOnExpression { expression: "gunbc-qualification" })
    && undeclared_input_refuses(h: h, d: d)
    && (match qualification_dispatch_subject(
      dispatch: d, delivery: delivered(d: d),
      floor_job_id: floor_job_id, branch: branch, revision: revision,
    ) {
      QualificationSubjectAdmitted { subject: _ } => false
      QualificationSubjectRefused { refusal: _ } => true
    })
    }
      JitMintDispatchRefused { refusal: _ } => false
    }
    Absent => false
  }
}

fn mutation_standing(rest: RestOutcome) -> QualificationDispatchStanding {
  qualification_dispatch_standing(performance: classify_rest_outcome(standing: RestMutationExchange { rest: rest }))
}

fn ambiguous(s: QualificationDispatchStanding) -> Bool {
  match s { DispatchStandingCommitAmbiguous { detail: _ } => true _ => false }
}

// THREE STANDINGS, FROM THE MUTATION CLASSIFIER: a decided 422 is refused; no response, a 503, and
// an undecodable 200 are commit-ambiguous; only a succeeded exchange dispatches. And the interlock:
// the hold covers the slot's own host and no other.
test fn the_dispatch_has_three_standings_and_an_interlock() -> Bool {
  match first(managed_hosts()) {
    Present { value: h } => match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: qualification_slot()), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: qualification_slot()), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
      JitMintDispatchAuthorized { dispatch: d } => {
  (match mutation_standing(rest: RestStatusRefused { status: 422, body: "Unexpected inputs provided" }) { DispatchStandingRefused { status: st, body: _ } => st == 422 _ => false })
    && ambiguous(s: mutation_standing(rest: RestTransportRefused { cause: "fixture: connection reset after send" }))
    && ambiguous(s: mutation_standing(rest: RestStatusRefused { status: 503, body: "fixture" }))
    && ambiguous(s: mutation_standing(rest: RestBodyUndecodable { status: 200, cause: "fixture: truncated body" }))
    && (match mutation_standing(rest: RestOk) { DispatchStandingSucceeded => true _ => false })
    && match qualification_dispatch_subject_over(
      dispatch: d, delivery: delivered(d: d),
      workflow: workflow_with(declares_input: true, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
    ) {
      QualificationSubjectAdmitted { subject: s } =>
        hold_covers_subject(held: h.host, subject: s) && !hold_covers_subject(held: "fixture-other-host" as HostIdentity, subject: s)
      QualificationSubjectRefused { refusal: _ } => false
    }
    }
      JitMintDispatchRefused { refusal: _ } => false
    }
    Absent => false
  }
}

// ── THE COLLECTION ─────────────────────────────────────────────────────────────────────────────

fn run(id: Int, attempt_n: Int, event: String, path: String, sha: CommitSha, completed: Bool, concluded: Bool) -> WorkflowRun {
  WorkflowRun {
    id: id,
    name: none,
    path: Present { value: path },
    head_sha: sha,
    head_branch: Present { value: branch as String },
    event: event,
    status: if completed { Completed } else { InProgress },
    conclusion: if concluded { Present { value: Failure } } else { none },
    workflow_id: 9,
    run_number: 1,
    run_attempt: attempt_n,
    actor: none,
    triggering_actor: none,
    html_url: "https://github.com/gunb-ai/gunbc/actions/runs/77",
    created_at: "2026-10-04T00:00:00Z",
    updated_at: "2026-10-04T01:00:00Z",
    pull_requests: [],
  }
}

fn dispatched_run(attempt_n: Int) -> WorkflowRun {
  run(id: 77, attempt_n: attempt_n, event: "workflow_dispatch", path: qualification_workflow_path() as String, sha: revision, completed: true, concluded: true)
}

fn job(id: Int, name: String, runner: String, started: Bool, attempt_n: Int) -> WorkflowJobRun {
  WorkflowJobRun {
    id: id,
    run_id: 77,
    run_attempt: attempt_n,
    name: name,
    status: Completed,
    conclusion: Present { value: Success },
    labels: [attempt as String],
    runner_name: Present { value: runner },
    created_at: Present { value: "2026-10-04T00:00:10Z" },
    started_at: if started { Present { value: "2026-10-04T00:01:00Z" } } else { none },
    completed_at: Present { value: "2026-10-04T00:50:00Z" },
  }
}

fn floor_on(runner: String) -> WorkflowJobRun {
  job(id: 1, name: "qualification floor", runner: runner, started: true, attempt_n: 1)
}

fn registered(s: QualificationDispatchSubject) -> String {
  s.registration.name.value as String
}

fn jobs(js: List<WorkflowJobRun>) -> WorkflowJobRunList {
  WorkflowJobRunList { total_count: count(js), jobs: js }
}

fn decide_jobs(s: QualificationDispatchSubject, js: WorkflowJobRunList) -> QualificationRunVerdict {
  decide_qualification_run(subject: s, run_id: 77, run_performance: RestExchangeSucceeded, run: dispatched_run(attempt_n: 1), jobs_performance: RestExchangeSucceeded, jobs: js)
}

fn decide_run(s: QualificationDispatchSubject, r: WorkflowRun, js: WorkflowJobRunList) -> QualificationRunVerdict {
  decide_qualification_run(subject: s, run_id: 77, run_performance: RestExchangeSucceeded, run: r, jobs_performance: RestExchangeSucceeded, jobs: js)
}

fn never_reached(v: QualificationRunVerdict) -> Bool {
  match v {
    RunVerdictRefused { refusal: RunNeverReachedAttemptRunner { registered_runner: _, runner_names_seen: seen } } => count(seen) > 0
    _ => false
  }
}

fn mismatch(v: QualificationRunVerdict) -> Bool {
  match v {
    RunVerdictRefused { refusal: RunSubjectMismatch { observed_run_id: _, observed_event: _, observed_path: _, foreign_jobs: _ } } => true
    _ => false
  }
}

// THE RUNNER IS JOINED BY IDENTITY. Positive control: the named floor job on the minted runner id is
// collected with the run's own conclusion (a Failure is still this host's run). REDs: the same
// labels on another runner; a helper job on the minted runner while the floor ran elsewhere; a floor
// on the minted runner that never started; two jobs answering to the floor's name.
test fn the_collection_joins_the_floor_job_to_the_minted_runner() -> Bool {
  match first(managed_hosts()) {
    Present { value: h } => match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: qualification_slot()), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: qualification_slot()), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
      JitMintDispatchAuthorized { dispatch: d } => {
  match qualification_dispatch_subject_over(
    dispatch: d, delivery: delivered(d: d),
    workflow: workflow_with(declares_input: true, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
  ) {
    QualificationSubjectAdmitted { subject: s } => {
      (match decide_jobs(s: s, js: jobs(js: [floor_on(runner: registered(s: s))])) {
        RunVerdictCollected { run: r, floor_job: f, conclusion: c } => r.id == 77 && f.id == 1 && (match c { Failure => true _ => false })
        _ => false
      })
        && never_reached(v: decide_jobs(s: s, js: jobs(js: [floor_on(runner: "another-runner-with-the-same-labels")])))
        && (match decide_jobs(s: s, js: jobs(js: [
          job(id: 2, name: "helper", runner: registered(s: s), started: true, attempt_n: 1),
          floor_on(runner: "another-runner-with-the-same-labels"),
        ])) {
          RunVerdictRefused { refusal: RunRegisteredRunnerRanAnotherJob { registered_runner: _, job_name: n } } => n == "helper"
          _ => false
        })
        && (match decide_jobs(s: s, js: jobs(js: [job(id: 1, name: "qualification floor", runner: registered(s: s), started: false, attempt_n: 1)])) {
          RunVerdictRefused { refusal: RunFloorJobNotStarted { job_id: id } } => id == 1
          _ => false
        })
        && (match decide_jobs(s: s, js: jobs(js: [floor_on(runner: registered(s: s)), job(id: 2, name: "qualification floor", runner: registered(s: s), started: true, attempt_n: 1)])) {
          RunVerdictRefused { refusal: RunFloorJobNotUnique { floor_job_name: _, matching: m } } => m == 2
          _ => false
        })
    }
    QualificationSubjectRefused { refusal: _ } => false
  }
    }
      JitMintDispatchRefused { refusal: _ } => false
    }
    Absent => false
  }
}

// THE SUBJECT IS THE DISPATCHED RUN'S FIRST ATTEMPT. REDs: the run re-run to attempt 2 (whose floor
// job carries the same labels and runner); a job of attempt 2 in the listing; another run id;
// another event; another workflow path.
test fn a_rerun_or_another_run_cannot_be_collected_as_the_dispatch() -> Bool {
  match first(managed_hosts()) {
    Present { value: h } => match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: qualification_slot()), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: qualification_slot()), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
      JitMintDispatchAuthorized { dispatch: d } => {
  let path = qualification_workflow_path() as String
  match qualification_dispatch_subject_over(
    dispatch: d, delivery: delivered(d: d),
    workflow: workflow_with(declares_input: true, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
  ) {
    QualificationSubjectAdmitted { subject: s } => {
      let floor = jobs(js: [floor_on(runner: registered(s: s))])
      (match decide_run(s: s, r: dispatched_run(attempt_n: 2), js: floor) {
        RunVerdictRefused { refusal: RunAdvancedPastDispatchedAttempt { observed_attempt: a } } => a == 2
        _ => false
      })
        && mismatch(v: decide_run(s: s, r: dispatched_run(attempt_n: 1), js: jobs(js: [job(id: 1, name: "qualification floor", runner: registered(s: s), started: true, attempt_n: 2)])))
        && mismatch(v: decide_run(s: s, r: run(id: 78, attempt_n: 1, event: "workflow_dispatch", path: path, sha: revision, completed: true, concluded: true), js: floor))
        && mismatch(v: decide_run(s: s, r: run(id: 77, attempt_n: 1, event: "push", path: path, sha: revision, completed: true, concluded: true), js: floor))
        && mismatch(v: decide_run(s: s, r: run(id: 77, attempt_n: 1, event: "workflow_dispatch", path: ".github/workflows/witnesses.yml", sha: revision, completed: true, concluded: true), js: floor))
    }
    QualificationSubjectRefused { refusal: _ } => false
  }
    }
      JitMintDispatchRefused { refusal: _ } => false
    }
    Absent => false
  }
}

test fn an_unfinished_unpinned_or_unreadable_run_refuses() -> Bool {
  match first(managed_hosts()) {
    Present { value: h } => match dispatch_jit_mint(binding: slot_binding(h: h, slot_workflow: qualification_slot()), authority: app_credential, control_plane: observed_grant(perms: runner_grant), organization: gunbai_org_ref, runner_group: group_restricted_to(workflow: qualification_slot()), attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis)) {
      JitMintDispatchAuthorized { dispatch: d } => {
  let path = qualification_workflow_path() as String
  match qualification_dispatch_subject_over(
    dispatch: d, delivery: delivered(d: d),
    workflow: workflow_with(declares_input: true, runs_on: attempt_runs_on), floor_job_id: floor_job_id, branch: branch, revision: revision,
  ) {
    QualificationSubjectAdmitted { subject: s } => {
      let floor = jobs(js: [floor_on(runner: registered(s: s))])
      (match decide_run(s: s, r: run(id: 77, attempt_n: 1, event: "workflow_dispatch", path: path, sha: revision, completed: false, concluded: false), js: floor) {
        RunVerdictRefused { refusal: RunNotCompleted { status: InProgress } } => true
        _ => false
      })
        && (match decide_run(s: s, r: run(id: 77, attempt_n: 1, event: "workflow_dispatch", path: path, sha: revision, completed: true, concluded: false), js: floor) {
          RunVerdictRefused { refusal: RunCompletedWithoutConclusion } => true
          _ => false
        })
        && (match decide_run(s: s, r: run(id: 77, attempt_n: 1, event: "workflow_dispatch", path: path, sha: "2222222222222222222222222222222222222222", completed: true, concluded: true), js: floor) {
          RunVerdictRefused { refusal: RunRevisionNotPinned { pinned: _, observed: _ } } => true
          _ => false
        })
        && (match decide_run(s: s, r: dispatched_run(attempt_n: 1), js: WorkflowJobRunList { total_count: 2, jobs: floor.jobs }) {
          RunVerdictRefused { refusal: RunJobsTruncated { returned: rt, total: t } } => rt == 1 && t == 2
          _ => false
        })
        && (match decide_qualification_run(subject: s, run_id: 77, run_performance: RestExchangeUnreached { cause: "fixture" }, run: dispatched_run(attempt_n: 1), jobs_performance: RestExchangeSucceeded, jobs: floor) {
          RunVerdictRefused { refusal: RunReadUnreadable { performance: _ } } => true
          _ => false
        })
        && (match decide_qualification_run(subject: s, run_id: 77, run_performance: RestExchangeSucceeded, run: dispatched_run(attempt_n: 1), jobs_performance: RestExchangeStatusRefused { status: 404, body: "fixture" }, jobs: floor) {
          RunVerdictRefused { refusal: RunJobsUnreadable { performance: _ } } => true
          _ => false
        })
    }
    QualificationSubjectRefused { refusal: _ } => false
  }
    }
      JitMintDispatchRefused { refusal: _ } => false
    }
    Absent => false
  }
}

// ── THE DESIGNATED JOB'S LOG ──────────────────────────────────────────────────────────────────

// RED: a log read for any job other than the designated one is refused, whatever it says.
test fn a_log_of_another_job_is_not_the_floor_jobs_log() -> Bool {
  (match designated_job_log(designated_job_id: 502, log: AttemptJobLogRead { job_id: 501, log: "[floor-phase] phase=x wall_ms=1" }) {
    DesignatedJobLogRefused { refusal: JobLogOfAnotherJob { designated_job_id: 502, read_job_id: 501 } } => true
    _ => false
  })
    && (match designated_job_log(designated_job_id: 502, log: AttemptJobLogUnreadable { job_id: 502, performance: RestExchangeStatusRefused { status: 410, body: "Gone" } }) {
      DesignatedJobLogRefused { refusal: JobLogUnreadable { job_id: 502, performance: _ } } => true
      _ => false
    })
    && (match designated_job_log(designated_job_id: 502, log: AttemptJobLogRead { job_id: 502, log: "" }) {
      DesignatedJobLogRefused { refusal: JobLogEmpty { job_id: 502 } } => true
      _ => false
    })
}

// ── THE PURE DECODER, OVER SUPPLIED TEXT ──────────────────────────────────────────────────────

data slot: NonEmptyStr = "gunbc-qualification-mtcollins1-q-20261004-1.service"

data phase_line: String = "2026-10-04T00:10:00.0000000Z [floor-phase] phase=gate-closure state=completed wall_ms=22194 prefixes=0"
data started_line: String = "2026-10-04T00:09:00.0000000Z [floor-phase] phase=strict-preparation state=started"
data slot_level_line: String = "2026-10-04T00:09:00.0000000Z [floor-cgroup] when=floor-entry level=/sys/fs/cgroup/system.slice/gunbc-qualification-mtcollins1-q-20261004-1.service max=17179869184 high=16106127360 current=8949473280 peak=10444185600 events=[low,0]"
data slice_level_line: String = "2026-10-04T00:09:00.0000000Z [floor-cgroup] when=floor-entry level=/sys/fs/cgroup/system.slice max=max high=max current=1 peak=364675248128"

fn decode(lines: List<String>) -> JobLogInstrumentDecode {
  decode_job_log_instruments(log: join(lines, "\n"), slot_unit: slot)
}

fn undecodable_with(d: JobLogInstrumentDecode, check: fn(InstrumentReadRefusal) -> Bool) -> Bool {
  match d {
    JobLogInstrumentsUndecodable { refusal: r } => check(r)
    JobLogInstrumentsDecoded { readings: _ } => false
  }
}

test fn the_job_log_instruments_are_the_two_the_extraction_reads() -> Bool {
  qualification_instrument_read_from_job_log(i: FloorPhaseRows)
    && qualification_instrument_read_from_job_log(i: FloorCgroupRows)
    && count(qualification_instruments |> filter(i => qualification_instrument_read_from_job_log(i: i))) == 2
    && count(qualification_instrument_extraction_frontier_rows) == 4
}

// THE POSITIVE CONTROL: timed and untimed phase rows are both carried, and only the slot's own
// level is taken -- the slice above it has a larger peak and must not be read as the slot's.
test fn a_log_with_phase_rows_and_the_slot_level_is_decoded() -> Bool {
  match decode(lines: ["noise before the floor", started_line, slot_level_line, slice_level_line, phase_line]) {
    JobLogInstrumentsDecoded { readings: rd } =>
      count(rd.floor_phase_rows) == 2
        && count(rd.slot_cgroup_rows) == 1
        && (rd.slot_cgroup_rows |> all(l => byte_size_count(b: l.peak) == 10444185600))
        && (rd.floor_phase_rows |> any(p => match p { FloorPhaseTimed { phase: _, wall: w } => millisecond_count(m: w) == 22194 _ => false }))
    JobLogInstrumentsUndecodable { refusal: _ } => false
  }
}

test fn a_garbled_row_refuses_rather_than_being_skipped() -> Bool {
  undecodable_with(d: decode(lines: [slot_level_line, phase_line, "[floor-phase] phase=gate-closure wall_ms=twelve"]), check: r => match r {
    FloorPhaseRowGarbledInLog { line: _, cause: _ } => true
    _ => false
  })
    && undecodable_with(d: decode(lines: [phase_line, "[floor-cgroup] when=beat-10 level=/sys/fs/cgroup/x.service high=lots peak=1"]), check: r => match r {
      FloorCgroupRowGarbledInLog { line: _, cause: _ } => true
      _ => false
    })
}

// RED, THE SPLIT-ACROSS-JOBS CASE: the phase rows of one job and the slot row of another never meet,
// because only the designated job's log is decoded -- read alone, the job carrying only phase rows
// refuses for want of the slot level, and the one carrying only the slot level refuses for want of a
// timed phase row.
test fn rows_split_across_two_jobs_are_not_one_measurement() -> Bool {
  undecodable_with(d: decode(lines: [started_line, phase_line]), check: r => match r {
    SlotCgroupLevelAbsent { slot_unit: u, levels_seen: seen } => u == slot && count(seen) == 0
    _ => false
  })
    && undecodable_with(d: decode(lines: [slot_level_line, slice_level_line]), check: r => match r {
      FloorPhaseRowsAbsent => true
      _ => false
    })
}

test fn a_log_without_the_slot_level_names_the_levels_it_saw() -> Bool {
  undecodable_with(d: decode(lines: [phase_line, slice_level_line]), check: r => match r {
    SlotCgroupLevelAbsent { slot_unit: u, levels_seen: seen } => u == slot && count(seen) == 1
    _ => false
  })
}

// ── INHABITANCE: THE REAL PRODUCER'S BYTES ─────────────────────────────────────────────────────
//
// The supplied lines above are designed against the row shapes; this claim is what keeps them
// readings. It hands decode_job_log_instruments the verbatim [floor-phase] and [floor-cgroup] lines
// claim_executor printed on a recorded required-floor run (test.fixture
// recorded_required_floor_log_excerpt), under that run's real slot unit, and asserts the ROUTE as well
// as the answer: every one of the 79 phase rows is read (none garbled, none dropped), the timed rows
// carry the gate-closure wall the log printed, and of the 12 level rows only the 4 at the slot's own
// level -- floor entry and three heartbeats -- are taken, with the slot's memory.high read as a byte
// bound and floor entry's memory.peak as printed. If the host's row encoding moves, this goes red
// while the designed fixtures above stay green.
test fn the_decoder_reads_a_recorded_required_floor_log() -> Bool {
  match decode_job_log_instruments(log: recorded_required_floor_log_excerpt, slot_unit: recorded_floor_log_slot_unit as NonEmptyStr) {
    JobLogInstrumentsDecoded { readings: rd } =>
      count(rd.floor_phase_rows) == 79
        && (rd.floor_phase_rows |> any(p => match p { FloorPhaseTimed { phase: ph, wall: w } => (ph as String) == "gate-closure" && millisecond_count(m: w) == 22194 _ => false }))
        && (rd.floor_phase_rows |> any(p => match p { FloorPhaseUntimed { phase: ph } => (ph as String) == "strict-preparation" _ => false }))
        && count(rd.slot_cgroup_rows) == 4
        && (rd.slot_cgroup_rows |> all(l => match l.high { CgroupMemoryLimited { bytes: b } => byte_size_count(b: b) == 16106127360 _ => false }))
        && (rd.slot_cgroup_rows |> any(l => (l.when as String) == "floor-entry" && byte_size_count(b: l.peak) == 10444185600))
    JobLogInstrumentsUndecodable { refusal: _ } => false
  }
}

// ── THE CLAIM-COST READ'S REFUSALS ─────────────────────────────────────────────────────────────
//
// Every way the artifact read can end today is a typed arm, and none of them is a reading: the
// listing truncated, the artifact absent (with the names that were there), expired, the archive
// unreadable (the RestBodyUndecodable a zip body produces), or an archive that arrived with no
// inflate reader to open it.
fn artifact(name: String, expired: Bool) -> ActionsArtifact {
  ActionsArtifact { id: 9001, name: name, expired: expired }
}

test fn every_claim_cost_read_ends_in_a_typed_refusal() -> Bool {
  let present = ActionsArtifactList { total_count: 1, artifacts: [artifact(name: "required-floor-claim-cost", expired: false)] }
  let gone = RestExchangeStatusRefused { status: 410, body: "Gone" }
  let undecodable = RestExchangeUndecodable { status: 200, cause: "stream did not contain valid UTF-8" }
  (match conclude_claim_cost_listing(performance: RestExchangeSucceeded, listed: ActionsArtifactList { total_count: 1, artifacts: [artifact(name: "required-ci-measurement-receipt", expired: false)] }) {
    Present { value: ClaimCostArtifactAbsent { names_seen: ns } } => count(ns) == 1
    _ => false
  })
    && (match conclude_claim_cost_listing(performance: RestExchangeSucceeded, listed: ActionsArtifactList { total_count: 1, artifacts: [artifact(name: "required-floor-claim-cost", expired: true)] }) {
      Present { value: ClaimCostArtifactExpired { artifact_id: 9001 } } => true
      _ => false
    })
    && (match conclude_claim_cost_listing(performance: RestExchangeSucceeded, listed: ActionsArtifactList { total_count: 3, artifacts: [] }) {
      Present { value: ClaimCostArtifactListTruncated { returned: 0, total: 3 } } => true
      _ => false
    })
    && (match conclude_claim_cost_listing(performance: RestExchangeSucceeded, listed: present) { Absent => true _ => false })
    && (match conclude_claim_cost_download(artifact_id: 9001, performance: undecodable) {
      ClaimCostArchiveUnreadable { artifact_id: 9001, performance: _ } => true
      _ => false
    })
    && (match conclude_claim_cost_download(artifact_id: 9001, performance: gone) {
      ClaimCostArtifactExpired { artifact_id: 9001 } => true
      _ => false
    })
    && (match conclude_claim_cost_download(artifact_id: 9001, performance: RestExchangeSucceeded) {
      ClaimCostArchiveNotInflatable { artifact_id: 9001 } => true
      _ => false
    })
}
