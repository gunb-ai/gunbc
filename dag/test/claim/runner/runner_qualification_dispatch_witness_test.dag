  recorded_required_floor_log_excerpt, recorded_floor_log_job_id, recorded_floor_log_slot_unit,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data attempt: NonEmptyStr = "q-20261004-1"

// THE DISPATCH KEY IS THE DECLARED INPUT'S NAME AND ITS VALUE IS THE ATTEMPT -- the same label the
// slot registers under (ephemeral_slot_labels), so runs-on fed from this input selects exactly that
// registration. Renaming the input row, or sending any other value, turns this red.
test fn the_dispatch_carries_the_attempt_label_under_the_declared_input() -> Bool {
  let inputs = qualification_dispatch_inputs(attempt: attempt)
  count(map_keys(inputs)) == 1
    && match map_get(inputs, qualification_attempt_dispatch_input.name) {
      Present { value: v } => v == (attempt as String)
        && (ephemeral_slot_labels(host: operator_host_mtcollins1, attempt: attempt) |> any(l => l == v))
      Absent => false
    }
    && qualification_attempt_dispatch_input.required
}

fn run(status_completed: Bool, concluded: Bool) -> WorkflowRun {
  WorkflowRun {
    id: 77,
    name: none,
    path: none,
    head_sha: "abc123",
    head_branch: none,
    event: "workflow_dispatch",
    status: if status_completed { Completed } else { InProgress },
    conclusion: if concluded { Present { value: Failure } } else { none },
    workflow_id: 9,
    run_number: 1,
    run_attempt: 1,
    actor: none,
    triggering_actor: none,
    html_url: "https://github.com/gunb-ai/gunbc/actions/runs/77",
    created_at: "2026-10-04T00:00:00Z",
    updated_at: "2026-10-04T01:00:00Z",
    pull_requests: [],
  }
}

fn job(labels: List<String>, started: Bool) -> WorkflowJobRun {
  WorkflowJobRun {
    id: 500,
    run_id: 77,
    run_attempt: 1,
    name: "floor",
    status: Completed,
    conclusion: Present { value: Success },
    labels: labels,
    runner_name: none,
    created_at: Present { value: "2026-10-04T00:00:10Z" },
    started_at: if started { Present { value: "2026-10-04T00:01:00Z" } } else { none },
    completed_at: Present { value: "2026-10-04T00:50:00Z" },
  }
}

fn jobs(js: List<WorkflowJobRun>) -> WorkflowJobRunList {
  WorkflowJobRunList { total_count: count(js), jobs: js }
}


// THE POSITIVE CONTROL: a completed run whose job was taken under the attempt label is collected,
// and its conclusion is the one read back (a FAILED floor is still collected and says so).
test fn a_completed_run_served_by_the_attempt_runner_is_collected_with_its_conclusion() -> Bool {
  match conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job(labels: ["self-hosted", attempt as String], started: true)])) {
    QualificationRunCollected { collected: c } =>
      c.attempt == attempt && c.run_id == 77 && count(c.attempt_jobs) == 1
        && (match c.conclusion { Failure => true _ => false })
    QualificationRunRefused { attempt: _, run_id: _, refusal: _ } => false
  }
}

// THE BRIEF'S REFUSAL: the run completed but no job carried the attempt label, or the one that did
// never started (no runner under the attempt took it). Both refuse, and carry the labels observed.
test fn a_run_the_attempt_runner_never_served_refuses_with_the_labels_it_saw() -> Bool {
  let other = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job(labels: ["self-hosted", "srv1"], started: true)]))
  let unstarted = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job(labels: [attempt as String], started: false)]))
  (match other {
    QualificationRunRefused { attempt: _, run_id: _, refusal: RunNeverReachedAttemptRunner { job_labels: ls } } =>
      count(ls) == 1 && (ls |> all(l => l |> any(x => x == "srv1")))
    _ => false
  })
    && !qualification_run_collected(c: unstarted)
    && (match unstarted { QualificationRunRefused { attempt: _, run_id: _, refusal: RunNeverReachedAttemptRunner { job_labels: _ } } => true _ => false })
}

test fn an_unfinished_or_unconcluded_run_refuses_rather_than_collecting() -> Bool {
  let served = jobs(js: [job(labels: [attempt as String], started: true)])
  (match conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: false, concluded: false), jobs_outcome: RestOk, jobs: served) {
    QualificationRunRefused { attempt: _, run_id: _, refusal: RunNotCompleted { status: InProgress } } => true
    _ => false
  })
    && (match conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: false), jobs_outcome: RestOk, jobs: served) {
      QualificationRunRefused { attempt: _, run_id: _, refusal: RunCompletedWithoutConclusion } => true
      _ => false
    })
}

// A PAGE SHORTER THAN total_count IS NOT A JOB LISTING: the attempt's job could sit on the unread
// page, so the fold refuses rather than reporting the runner never reached.
test fn a_truncated_or_unreadable_readback_refuses() -> Bool {
  let truncated = WorkflowJobRunList { total_count: 2, jobs: [job(labels: [attempt as String], started: true)] }
  (match conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: truncated) {
    QualificationRunRefused { attempt: _, run_id: _, refusal: RunJobsTruncated { returned: 1, total: 2 } } => true
    _ => false
  })
    && (match conclude_qualification_run(
      attempt: attempt, run_id: 77,
      run_outcome: RestStatusRefused { status: 404, body: "Not Found" }, run: run(status_completed: true, concluded: true),
      jobs_outcome: RestOk, jobs: jobs(js: []),
    ) {
      QualificationRunRefused { attempt: _, run_id: _, refusal: RunReadUnreadable { outcome: _ } } => true
      _ => false
    })
    && (match conclude_qualification_run(
      attempt: attempt, run_id: 77,
      run_outcome: RestOk, run: run(status_completed: true, concluded: true),
      jobs_outcome: RestTransportRefused { cause: "unreached" }, jobs: jobs(js: []),
    ) {
      QualificationRunRefused { attempt: _, run_id: _, refusal: RunJobsUnreadable { outcome: _ } } => true
      _ => false
    })
}

// THE SUBJECT IS THE DISPATCHED RUN: a readback naming another run id, or listing a job of another
// run, refuses as RunSubjectMismatch even when everything else would collect -- the served job
// below carries the attempt label and started, so only the subject check can turn it red.
test fn a_readback_of_another_run_refuses_on_the_subject() -> Bool {
  let served = jobs(js: [job(labels: [attempt as String], started: true)])
  let other_run = conclude_qualification_run(
    attempt: attempt, run_id: 78,
    run_outcome: RestOk, run: run(status_completed: true, concluded: true),
    jobs_outcome: RestOk, jobs: served,
  )
  let foreign_job = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [WorkflowJobRun {
    id: 501, run_id: 99, run_attempt: 1, name: "floor", status: Completed,
    conclusion: Present { value: Success }, labels: [attempt as String],
    runner_name: none,
    created_at: none, started_at: Present { value: "2026-10-04T00:01:00Z" }, completed_at: none,
  }]))
  (match other_run { QualificationRunRefused { attempt: _, run_id: _, refusal: RunSubjectMismatch { observed_run_id: 77, observed_event: _, foreign_job_run_ids: _ } } => true _ => false })
    && (match foreign_job { QualificationRunRefused { attempt: _, run_id: _, refusal: RunSubjectMismatch { observed_run_id: _, observed_event: _, foreign_job_run_ids: f } } => count(f) == 1 && (f |> all(x => x == 99)) _ => false })
}

// ── THE SUBJECT: ONE RUN, ONE REGISTERED RUNNER, ONE JOB ──────────────────────────────────────
//
// designated_floor_job is the pure join qualification_extraction_subject runs before any network
// read. Each claim concludes its own readback (admitted by name to conclude_qualification_run) and
// asks the join for the floor job, so the collection is never minted by a helper here.

data runner: NonEmptyStr = "gunbc-q-mtcollins1-q-20261004-1"

fn job_on(id: Int, runner_name: String?) -> WorkflowJobRun {
  WorkflowJobRun {
    id: id,
    run_id: 77,
    run_attempt: 1,
    name: "floor",
    status: Completed,
    conclusion: Present { value: Success },
    labels: [attempt as String],
    runner_name: runner_name,
    created_at: Present { value: "2026-10-04T00:00:10Z" },
    started_at: Present { value: "2026-10-04T00:01:00Z" },
    completed_at: Present { value: "2026-10-04T00:50:00Z" },
  }
}

fn designated_in(c: QualificationRunCollection, dispatched_run_id: Int, slot_attempt: NonEmptyStr) -> DesignatedFloorJob? {
  match c {
    QualificationRunCollected { collected: collected } =>
      Present { value: designated_floor_job(dispatched_run_id: dispatched_run_id, dispatched_attempt: attempt, collected: collected, slot_attempt: slot_attempt, runner_name: runner) }
    QualificationRunRefused { attempt: _, run_id: _, refusal: _ } => none
  }
}

fn subject_refused(d: DesignatedFloorJob?, check: fn(ExtractionSubjectRefusal) -> Bool) -> Bool {
  match d {
    Present { value: FloorJobRefused { refusal: r } } => check(r)
    _ => false
  }
}

// THE POSITIVE CONTROL: of two served jobs, the one the registered runner ran is the floor job.
test fn the_floor_job_is_the_one_the_registered_runner_ran() -> Bool {
  let c = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job_on(id: 501, runner_name: Present { value: "srv4-03" }), job_on(id: 502, runner_name: Present { value: runner as String })]))
  match designated_in(c: c, dispatched_run_id: 77, slot_attempt: attempt) {
    Present { value: FloorJobDesignated { job: j } } => j.id == 502
    _ => false
  }
}

// RED: a target from run B beside a collection of run A refuses before any read -- the dispatched
// run id and the collected run id are both carried, so the cross-wire is located.
test fn a_dispatch_of_another_run_refuses_the_subject() -> Bool {
  let c = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job_on(id: 502, runner_name: Present { value: runner as String })]))
  subject_refused(d: designated_in(c: c, dispatched_run_id: 78, slot_attempt: attempt), check: r => match r {
    SubjectRunMismatch { dispatched_run_id: 78, collected_run_id: 77 } => true
    _ => false
  })
}

// RED: a slot minted for attempt B beside a run of attempt A refuses, so its unit can never filter
// any cgroup row of this run.
test fn a_slot_of_another_attempt_refuses_the_subject() -> Bool {
  let c = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job_on(id: 502, runner_name: Present { value: runner as String })]))
  subject_refused(d: designated_in(c: c, dispatched_run_id: 77, slot_attempt: "q-20261004-2"), check: r => match r {
    SubjectAttemptMismatch { dispatched_attempt: _, other_attempt: o } => (o as String) == "q-20261004-2"
    _ => false
  })
}

// RED: no served job ran on the registered runner, or two did. Neither is a floor job.
test fn zero_or_two_jobs_on_the_registered_runner_refuse() -> Bool {
  let none_on = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job_on(id: 501, runner_name: Present { value: "srv4-03" }), job_on(id: 503, runner_name: none)]))
  let two_on = conclude_qualification_run(attempt: attempt, run_id: 77, run_outcome: RestOk, run: run(status_completed: true, concluded: true), jobs_outcome: RestOk, jobs: jobs(js: [job_on(id: 501, runner_name: Present { value: runner as String }), job_on(id: 502, runner_name: Present { value: runner as String })]))
  subject_refused(d: designated_in(c: none_on, dispatched_run_id: 77, slot_attempt: attempt), check: r => match r {
    NoJobOnRegisteredRunner { runner_name: _, runner_names_seen: seen } => count(seen) == 2 && (seen |> any(n => n == "srv4-03"))
    _ => false
  })
    && subject_refused(d: designated_in(c: two_on, dispatched_run_id: 77, slot_attempt: attempt), check: r => match r {
      SeveralJobsOnRegisteredRunner { runner_name: _, job_ids: ids } => count(ids) == 2
      _ => false
    })
}

// ── THE DESIGNATED JOB'S LOG ──────────────────────────────────────────────────────────────────

// RED: a log read for any job other than the designated one is refused, whatever it says.
test fn a_log_of_another_job_is_not_the_floor_jobs_log() -> Bool {
  (match designated_job_log(designated_job_id: 502, log: AttemptJobLogRead { job_id: 501, log: "[floor-phase] phase=x wall_ms=1" }) {
    DesignatedJobLogRefused { refusal: JobLogOfAnotherJob { designated_job_id: 502, read_job_id: 501 } } => true
    _ => false
  })
    && (match designated_job_log(designated_job_id: 502, log: AttemptJobLogUnreadable { job_id: 502, outcome: RestStatusRefused { status: 410, body: "Gone" } }) {
      DesignatedJobLogRefused { refusal: JobLogUnreadable { job_id: 502, outcome: _ } } => true
      _ => false
    })
    && (match designated_job_log(designated_job_id: 502, log: AttemptJobLogRead { job_id: 502, log: "" }) {
      DesignatedJobLogRefused { refusal: JobLogEmpty { job_id: 502 } } => true
      _ => false
    })
}

// ── THE PURE DECODER, OVER SUPPLIED TEXT ──────────────────────────────────────────────────────

data slot: NonEmptyStr = "gunbc-qualification-mtcollins1-q-20261004-1.service"

data phase_line: String = "2026-10-04T00:10:00.0000000Z [floor-phase] phase=gate-closure state=completed wall_ms=22194 prefixes=0"
data started_line: String = "2026-10-04T00:09:00.0000000Z [floor-phase] phase=strict-preparation state=started"
data slot_level_line: String = "2026-10-04T00:09:00.0000000Z [floor-cgroup] when=floor-entry level=/sys/fs/cgroup/system.slice/gunbc-qualification-mtcollins1-q-20261004-1.service max=17179869184 high=16106127360 current=8949473280 peak=10444185600 events=[low,0]"
data slice_level_line: String = "2026-10-04T00:09:00.0000000Z [floor-cgroup] when=floor-entry level=/sys/fs/cgroup/system.slice max=max high=max current=1 peak=364675248128"

fn decode(lines: List<String>) -> JobLogInstrumentDecode {
  decode_job_log_instruments(log: join(lines, "\n"), slot_unit: slot)
}

fn undecodable_with(d: JobLogInstrumentDecode, check: fn(InstrumentReadRefusal) -> Bool) -> Bool {
  match d {
    JobLogInstrumentsUndecodable { refusal: r } => check(r)
    JobLogInstrumentsDecoded { readings: _ } => false
  }
}

test fn the_job_log_instruments_are_the_two_the_extraction_reads() -> Bool {
  qualification_instrument_read_from_job_log(i: FloorPhaseRows)
    && qualification_instrument_read_from_job_log(i: FloorCgroupRows)
    && count(qualification_instruments |> filter(i => qualification_instrument_read_from_job_log(i: i))) == 2
    && count(qualification_instrument_extraction_frontier_rows) == 4
}

// THE POSITIVE CONTROL: timed and untimed phase rows are both carried, and only the slot's own
// level is taken -- the slice above it has a larger peak and must not be read as the slot's.
test fn a_log_with_phase_rows_and_the_slot_level_is_decoded() -> Bool {
  match decode(lines: ["noise before the floor", started_line, slot_level_line, slice_level_line, phase_line]) {
    JobLogInstrumentsDecoded { readings: rd } =>
      count(rd.floor_phase_rows) == 2
        && count(rd.slot_cgroup_rows) == 1
        && (rd.slot_cgroup_rows |> all(l => byte_size_count(b: l.peak) == 10444185600))
        && (rd.floor_phase_rows |> any(p => match p { FloorPhaseTimed { phase: _, wall: w } => millisecond_count(m: w) == 22194 _ => false }))
    JobLogInstrumentsUndecodable { refusal: _ } => false
  }
}

test fn a_garbled_row_refuses_rather_than_being_skipped() -> Bool {
  undecodable_with(d: decode(lines: [slot_level_line, phase_line, "[floor-phase] phase=gate-closure wall_ms=twelve"]), check: r => match r {
    FloorPhaseRowGarbledInLog { line: _, cause: _ } => true
    _ => false
  })
    && undecodable_with(d: decode(lines: [phase_line, "[floor-cgroup] when=beat-10 level=/sys/fs/cgroup/x.service high=lots peak=1"]), check: r => match r {
      FloorCgroupRowGarbledInLog { line: _, cause: _ } => true
      _ => false
    })
}

// RED, THE SPLIT-ACROSS-JOBS CASE: the phase rows of one job and the slot row of another never meet,
// because only the designated job's log is decoded -- read alone, the job carrying only phase rows
// refuses for want of the slot level, and the one carrying only the slot level refuses for want of a
// timed phase row.
test fn rows_split_across_two_jobs_are_not_one_measurement() -> Bool {
  undecodable_with(d: decode(lines: [started_line, phase_line]), check: r => match r {
    SlotCgroupLevelAbsent { slot_unit: u, levels_seen: seen } => u == slot && count(seen) == 0
    _ => false
  })
    && undecodable_with(d: decode(lines: [slot_level_line, slice_level_line]), check: r => match r {
      FloorPhaseRowsAbsent => true
      _ => false
    })
}

test fn a_log_without_the_slot_level_names_the_levels_it_saw() -> Bool {
  undecodable_with(d: decode(lines: [phase_line, slice_level_line]), check: r => match r {
    SlotCgroupLevelAbsent { slot_unit: u, levels_seen: seen } => u == slot && count(seen) == 1
    _ => false
  })
}

// ── INHABITANCE: THE REAL PRODUCER'S BYTES ─────────────────────────────────────────────────────
//
// The supplied lines above are designed against the row shapes; this claim is what keeps them
// readings. It hands decode_job_log_instruments the verbatim [floor-phase] and [floor-cgroup] lines
// claim_executor printed on a recorded required-floor run (test.fixture
// recorded_required_floor_log_excerpt), under that run's real slot unit, and asserts the ROUTE as well
// as the answer: every one of the 79 phase rows is read (none garbled, none dropped), the timed rows
// carry the gate-closure wall the log printed, and of the 12 level rows only the 4 at the slot's own
// level -- floor entry and three heartbeats -- are taken, with the slot's memory.high read as a byte
// bound and floor entry's memory.peak as printed. If the host's row encoding moves, this goes red
// while the designed fixtures above stay green.
test fn the_decoder_reads_a_recorded_required_floor_log() -> Bool {
  match decode_job_log_instruments(log: recorded_required_floor_log_excerpt, slot_unit: recorded_floor_log_slot_unit as NonEmptyStr) {
    JobLogInstrumentsDecoded { readings: rd } =>
      count(rd.floor_phase_rows) == 79
        && (rd.floor_phase_rows |> any(p => match p { FloorPhaseTimed { phase: ph, wall: w } => (ph as String) == "gate-closure" && millisecond_count(m: w) == 22194 _ => false }))
        && (rd.floor_phase_rows |> any(p => match p { FloorPhaseUntimed { phase: ph } => (ph as String) == "strict-preparation" _ => false }))
        && count(rd.slot_cgroup_rows) == 4
        && (rd.slot_cgroup_rows |> all(l => match l.high { CgroupMemoryLimited { bytes: b } => byte_size_count(b: b) == 16106127360 _ => false }))
        && (rd.slot_cgroup_rows |> any(l => (l.when as String) == "floor-entry" && byte_size_count(b: l.peak) == 10444185600))
    JobLogInstrumentsUndecodable { refusal: _ } => false
  }
}

// ── THE CLAIM-COST READ'S REFUSALS ─────────────────────────────────────────────────────────────
//
// Every way the artifact read can end today is a typed arm, and none of them is a reading: the
// listing truncated, the artifact absent (with the names that were there), expired, the archive
// unreadable (the RestBodyUndecodable a zip body produces), or an archive that arrived with no
// inflate reader to open it.
fn artifact(name: String, expired: Bool) -> ActionsArtifact {
  ActionsArtifact { id: 9001, name: name, size_in_bytes: 4096, archive_download_url: "https://api.github.com/x", expired: expired, created_at: none, expires_at: none }
}

test fn every_claim_cost_read_ends_in_a_typed_refusal() -> Bool {
  let present = ActionsArtifactList { total_count: 1, artifacts: [artifact(name: "required-floor-claim-cost", expired: false)] }
  let gone = RestStatusRefused { status: 410, body: "Gone" }
  (match conclude_claim_cost_listing(outcome: RestOk, listed: ActionsArtifactList { total_count: 1, artifacts: [artifact(name: "required-ci-measurement-receipt", expired: false)] }) {
    Present { value: ClaimCostArtifactAbsent { names_seen: ns } } => count(ns) == 1
    _ => false
  })
    && (match conclude_claim_cost_listing(outcome: RestOk, listed: ActionsArtifactList { total_count: 1, artifacts: [artifact(name: "required-floor-claim-cost", expired: true)] }) {
      Present { value: ClaimCostArtifactExpired { artifact_id: 9001 } } => true
      _ => false
    })
    && (match conclude_claim_cost_listing(outcome: RestOk, listed: ActionsArtifactList { total_count: 3, artifacts: [] }) {
      Present { value: ClaimCostArtifactListTruncated { returned: 0, total: 3 } } => true
      _ => false
    })
    && (match conclude_claim_cost_listing(outcome: RestOk, listed: present) { Absent => true _ => false })
    && (match conclude_claim_cost_download(artifact_id: 9001, outcome: RestBodyUndecodable { status: 200, cause: "stream did not contain valid UTF-8" }) {
      ClaimCostArchiveUnreadable { artifact_id: 9001, outcome: _ } => true
      _ => false
    })
    && (match conclude_claim_cost_download(artifact_id: 9001, outcome: gone) {
      ClaimCostArtifactExpired { artifact_id: 9001 } => true
      _ => false
    })
    && (match conclude_claim_cost_download(artifact_id: 9001, outcome: RestOk) {
      ClaimCostArchiveNotInflatable { artifact_id: 9001 } => true
      _ => false
    })
}
