module test.claim.runner_jit_deregistration_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.upsert_decision { Noop, Apply, Refuse }
import extdeps.transports.rest { RestExchangeSucceeded, RestExchangeStatusRefused, RestExchangeCommitAmbiguous, RestExchangeUnreached }
import extdeps.github.effect { GitHubOrganizationRef }
import extdeps.github.actions_jit_runner { JitRunnerName }
import extdeps.github.actions_self_hosted_runners { OrganizationRunnerListWire, OrganizationRunnerWire }
import gunbc.github_effect_perform { OrganizationRunnerListRead }
import gunbc.managed_host { managed_hosts, managed_host_binding }
import gunbc.runner.runner_host_unit_slot { host_unit_slot_for, HostUnitSlotBound }
import gunbc.runner_jit_mint { HostUnitJitSlot }
import gunbc.runner.runner_jit_deregistration {
  JitRegistration, JitSlotExit, SlotJobCompleted, SlotJobFailed, SlotNeverLaunched,
  JitRunnerListing, JitRunnerListed, JitRunnerNotListed, JitRunnerListingUnreadable,
  JitRunnerDeleteAttempt, JitDeregistration, JitRunnerDeregistered, JitDeregistrationRefused,
  DeregistrationRunnerStillListed, DeregistrationListingUnreadable,
  jit_runner_listing_of, plan_jit_deregistration, conclude_jit_deregistration, jit_runner_deregistered,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data runner_name: JitRunnerName = JitRunnerName { value: "gunbc-qualification-mtcollins1-q-1.service" }

fn listing_read(runners: List<OrganizationRunnerWire>, total: Int) -> OrganizationRunnerListRead {
  OrganizationRunnerListRead { performance: RestExchangeSucceeded, body: OrganizationRunnerListWire { total_count: total, runners: runners } }
}

fn registrations() -> List<JitRegistration> {
  managed_hosts() |> flat_map(h =>
    match host_unit_slot_for(host: managed_host_binding(host: h), attempt: "q-1") {
      HostUnitSlotBound { slot: s } =>
        [JitRegistration { organization: GitHubOrganizationRef { login: "gunb-ai" }, name: runner_name, slot: HostUnitJitSlot { slot: s } }]
      _ => []
    })
}

data every_exit: List<JitSlotExit> = [
  SlotJobCompleted,
  SlotJobFailed { cause: "the floor job failed" },
  SlotNeverLaunched { cause: "the unit never started" },
]

// THE LISTING IS AN IDENTITY JOIN ON THE MINTED NAME: a different runner in the page is not this
// registration, and a page shorter than total_count is unreadable rather than absent.
test fn the_listing_finds_the_registration_by_name_and_refuses_a_short_page() -> Bool {
  let other = OrganizationRunnerWire { id: 7, name: "some-other-runner" }
  let mine = OrganizationRunnerWire { id: 42, name: runner_name.value as String }
  (match jit_runner_listing_of(name: runner_name, read: listing_read(runners: [other], total: 1)) { JitRunnerNotListed => true _ => false })
    && (match jit_runner_listing_of(name: runner_name, read: listing_read(runners: [other, mine], total: 2)) {
      JitRunnerListed { ids: ids } => ids == [42]
      _ => false
    })
    && (match jit_runner_listing_of(name: runner_name, read: listing_read(runners: [other], total: 2)) {
      JitRunnerListingUnreadable { performance: _, cause: _ } => true
      _ => false
    })
    && (match jit_runner_listing_of(name: runner_name, read: OrganizationRunnerListRead {
      performance: RestExchangeUnreached { cause: "fixture: connection refused" },
      body: OrganizationRunnerListWire { total_count: 0, runners: [] },
    }) {
      JitRunnerListingUnreadable { performance: _, cause: _ } => true
      _ => false
    })
}

test fn the_plan_is_an_ensure_over_the_listing() -> Bool {
  (match plan_jit_deregistration(listing: JitRunnerNotListed) { Noop => true _ => false })
    && (match plan_jit_deregistration(listing: JitRunnerListed { ids: [42] }) { Apply { plan: ids } => ids == [42] _ => false })
    && (match plan_jit_deregistration(listing: JitRunnerListingUnreadable { performance: RestExchangeSucceeded, cause: "fixture" }) {
      Refuse { reason: _ } => true
      _ => false
    })
}

// SUCCESS IS THE READBACK AND ONLY THE READBACK, ON EVERY EXIT. A 204 with the runner still listed
// refuses; an ambiguous delete whose readback shows it gone succeeds; an unreadable readback refuses;
// and none of that depends on how the slot exited.
test fn deregistration_succeeds_only_on_an_absent_readback_on_every_exit() -> Bool {
  let deleted_ok = [JitRunnerDeleteAttempt { runner_id: 42, performance: RestExchangeSucceeded }]
  let deleted_ambiguous = [JitRunnerDeleteAttempt { runner_id: 42, performance: RestExchangeCommitAmbiguous { detail: "fixture: 502 after the write" } }]
  count(registrations()) > 0 && registrations() |> all(reg => every_exit |> all(exit =>
    jit_runner_deregistered(result: conclude_jit_deregistration(registration: reg, exit: exit, deletes: deleted_ambiguous, readback: JitRunnerNotListed))
      && (match conclude_jit_deregistration(registration: reg, exit: exit, deletes: deleted_ok, readback: JitRunnerListed { ids: [42] }) {
        JitDeregistrationRefused { registration: _, exit: _, refusal: DeregistrationRunnerStillListed { ids: ids, deletes: _ } } => ids == [42]
        _ => false
      })
      && (match conclude_jit_deregistration(registration: reg, exit: exit, deletes: deleted_ok,
        readback: JitRunnerListingUnreadable { performance: RestExchangeStatusRefused { status: 403, body: "fixture" }, cause: "fixture" }) {
        JitDeregistrationRefused { registration: _, exit: _, refusal: DeregistrationListingUnreadable { performance: _, cause: _ } } => true
        _ => false
      })))
}
