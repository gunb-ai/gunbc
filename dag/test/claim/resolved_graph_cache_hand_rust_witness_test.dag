module test.claim.resolved_graph_cache_hand_rust_witness



data resolved_graph_cache_hand_rust_witness_note: String = "HAND-RUST checkable receipt (reviews 46781/46990): scaffold bind on lookup_verified_probe; full #7534 Rust census (four paths after the #8146 test-suite cutover removed three; per-path net deltas summing to loc_delta_net); consumer bridge defers to materialization_provider_consumer_hand_rust_witness_test.dag. Discriminator rows deleted 2026-08-11 (review 51152) — the module they named was removed by the test-suite cutover and a substring check over the constants proved nothing."

test fn resolved_graph_cache_hand_rust_scaffold_is_seed_retained() -> Bool {
  match gunbc.resolved_graph_cache_hand_rust_scaffold.resolved_graph_cache_hand_rust_scaffold {
    std.disposition.Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn resolved_graph_cache_hand_rust_receipt_is_checkable() -> Bool {
  !(dissolution_description(condition: gunbc.resolved_graph_cache_hand_rust_scaffold.resolved_graph_cache_hand_rust_dissolve_trigger) == "")
    && !(resolved_graph_cache_hand_rust_receipt_plan_anchor == "")
    && !(resolved_graph_cache_hand_rust_roadmap_lane_anchor == "")
    && resolved_graph_cache_hand_rust_receipt_witness_entry ==
      "dag/test/claim/resolved_graph_cache_hand_rust_witness_test.dag"
    && resolved_graph_cache_hand_rust_deferred_consumer_scaffold_module ==
      "gunbc.materialization_provider_consumer_scaffold"
    && resolved_graph_cache_hand_rust_deferred_consumer_witness_entry ==
      "dag/test/claim/materialization_provider_consumer_hand_rust_witness_test.dag"
    && length(xs: resolved_graph_cache_hand_rust_paths) == 4
    && length(xs: resolved_graph_cache_hand_rust_path_loc_deltas_net) == 4
    && resolved_graph_cache_hand_rust_loc_delta_net ==
      fold(
        resolved_graph_cache_hand_rust_path_loc_deltas_net,
        init: 0,
        f: (acc, delta) => acc + delta
      )
    && every_censused_path_exists()
}

// A LENGTH AND A SUM ARE NOT A CENSUS (review 51132). Both clauses above stayed
// green while three of the seven censused paths had been deleted from the tree:
// nothing joined a path to the file it names, so the receipt reported a hand-Rust
// population that no longer existed. That is the same specification-without-
// execution class this receipt exists to prevent, one level up.
//
// A path that cannot be read REFUSES. An unreadable file is ignorance, not
// evidence the census is accurate — and it is the exact signal that a deletion
// elsewhere silently invalidated this row.
fn censused_path_exists(path: String) -> Bool {
  string_length(s: filesystem_read(path: path).content) > 0
}

fn every_censused_path_exists() -> Bool {
  resolved_graph_cache_hand_rust_paths |> all(p => censused_path_exists(path: p))
}

// THE NEGATIVE CONTROL IS NOT A test fn HERE, and the reason is a measurement.
// Pointing censused_path_exists at an absent path does not return false — the
// host refuses the read outright ("hermetic mode: no mock_response for operation
// Read — refusing to fabricate Unit") and the witness FAILS with that typed
// error. Verified by execution 2026-08-11 against
// "src/v1/tests/src/zz_this_module_does_not_exist.rs".
//
// That is strictly stronger than the false-return this control was written to
// assert, so the wall is real; it simply cannot be expressed as a Bool a witness
// returns. Encoding it as `!censused_path_exists(absent)` would enroll a test
// that can never be green, which is a permanently red probe, not a control.
//
// The positive control below is what remains expressible: a path that IS in the
// tree reads nonempty, so every_censused_path_exists is not passing because the
// read primitive always answers true.
test fn resolved_graph_cache_hand_rust_census_reads_a_real_path() -> Bool {
  censused_path_exists(path: "src/v1/stage0/src/resolved_graph_cache.rs")
}
