module test.claim.resolved_graph_cache_hand_rust_witness

import std.dissolution { dissolution_description }

import gunbc.resolved_graph_cache_hand_rust_scaffold {
  resolved_graph_cache_hand_rust_scaffold,
  resolved_graph_cache_hand_rust_dissolve_trigger,
  resolved_graph_cache_hand_rust_loc_delta_net,
  resolved_graph_cache_hand_rust_path_loc_deltas_net,
  resolved_graph_cache_hand_rust_paths,
  resolved_graph_cache_hand_rust_deferred_consumer_scaffold_module,
  resolved_graph_cache_hand_rust_deferred_consumer_witness_entry,
  resolved_graph_cache_hand_rust_receipt_plan_anchor,
  resolved_graph_cache_hand_rust_receipt_witness_entry,
  resolved_graph_cache_hand_rust_roadmap_lane_anchor,
  resolved_graph_cache_hand_rust_test_discriminator_cold_oracle,
  resolved_graph_cache_hand_rust_test_discriminator_legacy_migrate,
  resolved_graph_cache_hand_rust_test_discriminator_migration_race,
  resolved_graph_cache_hand_rust_test_discriminator_toctou,
}
import std.disposition { Scaffold, SingleAuthority }
import std.types { Bool }
import v2.std.algebra { length }

data resolved_graph_cache_hand_rust_witness_note: String = "HAND-RUST checkable receipt (reviews 46781/46990): scaffold bind on lookup_verified_probe; full #7534 Rust census (seven paths, per-path net deltas summing to loc_delta_net); consumer bridge defers to materialization_provider_consumer_hand_rust_witness_test.dag. Discriminators executed by cargo test -p v1-compiler-tests resolve_cross_process_cache_test -- --nocapture."

test fn resolved_graph_cache_hand_rust_scaffold_is_seed_retained() -> Bool {
  match resolved_graph_cache_hand_rust_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn resolved_graph_cache_hand_rust_receipt_is_checkable() -> Bool {
  !(dissolution_description(condition: resolved_graph_cache_hand_rust_dissolve_trigger) == "")
    && !(resolved_graph_cache_hand_rust_receipt_plan_anchor == "")
    && !(resolved_graph_cache_hand_rust_roadmap_lane_anchor == "")
    && resolved_graph_cache_hand_rust_receipt_witness_entry ==
      "dag/test/claim/resolved_graph_cache_hand_rust_witness_test.dag"
    && resolved_graph_cache_hand_rust_deferred_consumer_scaffold_module ==
      "gunbc.materialization_provider_consumer_scaffold"
    && resolved_graph_cache_hand_rust_deferred_consumer_witness_entry ==
      "dag/test/claim/materialization_provider_consumer_hand_rust_witness_test.dag"
    && length(xs: resolved_graph_cache_hand_rust_paths) == 7
    && length(xs: resolved_graph_cache_hand_rust_path_loc_deltas_net) == 7
    && resolved_graph_cache_hand_rust_loc_delta_net ==
      fold(
        resolved_graph_cache_hand_rust_path_loc_deltas_net,
        init: 0,
        f: (acc, delta) => acc + delta
      )
}

test fn resolved_graph_cache_hand_rust_discriminating_tests_named() -> Bool {
  string_contains(
    s: resolved_graph_cache_hand_rust_test_discriminator_toctou,
    pattern: "verified_lookup"
  )
    && string_contains(
      s: resolved_graph_cache_hand_rust_test_discriminator_migration_race,
      pattern: "v3_write_refuses"
    )
    && string_contains(
      s: resolved_graph_cache_hand_rust_test_discriminator_legacy_migrate,
      pattern: "legacy_v1"
    )
    && string_contains(
      s: resolved_graph_cache_hand_rust_test_discriminator_cold_oracle,
      pattern: "cold_oracle"
    )
}
