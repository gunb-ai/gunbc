module test.claim.instrument_motion_page_witness


data witness_subject_note: String = "THE MOTION LAB'S VERTICAL SLICE, exercised through the route rather than through the page function, because the thing that can break in production is the composition — a handler arm that renders the wrong page, an asset route serving the wrong body, a page whose attributes and whose client program have drifted apart. Calling instrument_motion_page() directly would prove the fragment and leave every seam above it untested.

WHAT THE RED CONTROLS DISCRIMINATE. The reduced wire is asserted to DIFFER from the full wire and to be exactly the at-rest frame: if a future edit made reduced motion a client-side opt-out, both wires would be equal and the first control reds. The client program is asserted to contain no arithmetic library call: if the physics ever migrated into the renderer, Math. would appear and the second control reds. And the shipped full wire is asserted to respect the modelled travel bound at every frame, so a page that shipped an unbounded sequence reds even though the model that decided it is green."

fn fixture_request(method: std.types.HttpMethod, path: String) -> extdeps.http.server.ServeHttpRequest {
  extdeps.http.server.ServeHttpRequest { method: method, path: path, body: "" }
}

fn motion_page_body() -> String {
  gunbc.roadmap_serve.roadmap_serve_invoke(
    handler: gunbc.roadmap_serve.InstrumentMotionPageHandler,
    params: [],
    request: fixture_request(method: std.types.GET, path: gunbc.roadmap_component.instrument_motion_page_path),
    release_revision: test.claim.live_deploy.deploy_release_fixture.deploy_witness_release_revision,
  ).body
}

fn motion_asset_body() -> String {
  gunbc.roadmap_serve.roadmap_serve_invoke(
    handler: gunbc.roadmap_serve.InstrumentMotionAssetHandler,
    params: [],
    request: fixture_request(method: std.types.GET, path: gunbc.roadmap_component.instrument_motion_asset_path),
    release_revision: test.claim.live_deploy.deploy_release_fixture.deploy_witness_release_revision,
  ).body
}

test fn witness_motion_page_renders_through_its_route() -> Bool {
  let r = gunbc.roadmap_serve.roadmap_serve_invoke(
    handler: gunbc.roadmap_serve.InstrumentMotionPageHandler,
    params: [],
    request: fixture_request(method: std.types.GET, path: gunbc.roadmap_component.instrument_motion_page_path),
    release_revision: test.claim.live_deploy.deploy_release_fixture.deploy_witness_release_revision,
  )
  let html = r.body
  r.status == 200
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_plate_class)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_tap_btn_class)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_receipt_class)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_plate_id)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_receipt_id)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_probe_run_id)
    && string_contains(s: html, pattern: gunbc.roadmap_component.instrument_motion_asset_path)
}

data nonempty_wire_note: String = "EVERY WIRE ASSERTION CHECKS THE WIRE IS NON-EMPTY BEFORE CHECKING THE PAGE CARRIES IT (review finding, 2026-08-07). string_contains(anything, \"\") is true, so a control written as contains(html, wire) passes on a page that ships nothing the moment the wire collapses to the empty string. That is not a hypothetical: the helper this file used to call answered a refused sequence with an empty list, and these three claims would all have gone green over an empty attribute. Each claim now reaches the wire only through a settled sequence, and asserts the wire is non-empty in the same breath."

fn page_ships_full_wire(t: gunbc.capability_binding.SyntheticTapStrength) -> Bool {
  match gunbc.roadmap_instrument_motion.sequence_for(t: t, m: gunbc.design.instrument_bob.MotionFull) {
    gunbc.design.instrument_bob.BobSequenceRefused { cause: _, frames_emitted: _, budget_allowed: _ } => false
    gunbc.design.instrument_bob.BobSequenceSettled { frames: fs } => {
      let w = gunbc.roadmap_instrument_motion.frames_wire(frames: fs)
      w != "" && string_contains(s: motion_page_body(), pattern: w)
    }
  }
}

test fn witness_page_ships_both_decided_sequences() -> Bool {
  let html = motion_page_body()
  string_contains(s: html, pattern: gunbc.roadmap_component.motion_frame_data_attr)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_reduced_frame_data_attr)
    && string_contains(s: html, pattern: gunbc.roadmap_component.motion_frame_interval_attr)
    && string_contains(s: html, pattern: concat(gunbc.roadmap_component.motion_frame_interval_attr, concat("=\"", concat(to_string(gunbc.roadmap_instrument_motion.motion_frame_interval_ms), "\""))))
    && page_ships_full_wire(t: gunbc.capability_binding.SyntheticTapKnock)
    && page_ships_full_wire(t: gunbc.capability_binding.SyntheticTapLight)
    && page_ships_full_wire(t: gunbc.capability_binding.SyntheticTapFirm)
}

test fn witness_reduced_is_a_decided_answer_not_an_opt_out() -> Bool {
  match gunbc.roadmap_instrument_motion.sequence_for(t: gunbc.capability_binding.SyntheticTapKnock, m: gunbc.design.instrument_bob.MotionFull) {
    gunbc.design.instrument_bob.BobSequenceRefused { cause: _, frames_emitted: _, budget_allowed: _ } => false
    gunbc.design.instrument_bob.BobSequenceSettled { frames: fulls } =>
      match gunbc.roadmap_instrument_motion.sequence_for(t: gunbc.capability_binding.SyntheticTapKnock, m: gunbc.design.instrument_bob.MotionReduced) {
        gunbc.design.instrument_bob.BobSequenceRefused { cause: _, frames_emitted: _, budget_allowed: _ } => false
        gunbc.design.instrument_bob.BobSequenceSettled { frames: reduceds } => {
          let full = gunbc.roadmap_instrument_motion.frames_wire(frames: fulls)
          let reduced = gunbc.roadmap_instrument_motion.frames_wire(frames: reduceds)
          reduced == "0" && full != reduced && count(reduceds) == 1 && count(fulls) > 3
        }
      }
  }
}

test fn witness_shipped_sequence_respects_the_modelled_bound() -> Bool {
  match gunbc.roadmap_instrument_motion.sequence_for(t: gunbc.capability_binding.SyntheticTapKnock, m: gunbc.design.instrument_bob.MotionFull) {
    gunbc.design.instrument_bob.BobSequenceRefused { cause: _, frames_emitted: _, budget_allowed: _ } => false
    gunbc.design.instrument_bob.BobSequenceSettled { frames: fs } =>
      count(fs) > 0
        && all(fs, f => f.displacement_px <= gunbc.design.instrument_bob.bob_max_travel_px && f.displacement_px >= (0 - gunbc.design.instrument_bob.bob_max_travel_px))
  }
}

data shipped_sequence_control_note: String = "THE ROUTE-LEVEL CONTROL ON THE ACTUAL PRODUCTION SEQUENCE (review requirement, 2026-08-06). Every property here is asserted over the sixteen-millisecond wire the page really ships, not over the physics in isolation — which is the whole point, because the defect this replaces left the envelope function correct while the emitted sequence rang at full reach for about a second and then had a zero supplied for it by the renderer.

Seven conjuncts, one per property the review named: the sequence is ADMITTED rather than truncated; it starts at rest; its first movement is downward; it occupies positions that are neither rest nor an extreme; it appears on both sides of rest; its reach falls between the first third and the last; it contains exactly one settled frame; and it ends at zero on its own, which the client no longer manufactures."

test fn witness_the_shipped_sequence_moves_decays_and_settles() -> Bool {
  match gunbc.roadmap_instrument_motion.sequence_for(t: gunbc.capability_binding.SyntheticTapKnock, m: gunbc.design.instrument_bob.MotionFull) {
    gunbc.design.instrument_bob.BobSequenceRefused { cause: _, frames_emitted: _, budget_allowed: _ } => false
    gunbc.design.instrument_bob.BobSequenceSettled { frames: fs } => {
      let settle = gunbc.design.instrument_bob.max_settle_time_ms()
      fs.length() > 8
        && gunbc.design.instrument_bob.frames_max_abs_between(fs: fs, from_ms: 0, to_ms: 1) == 0
        && frames_first_movement_is_downward(fs: fs)
        && gunbc.design.instrument_bob.frames_visit_an_intermediate_position(fs: fs)
        && gunbc.design.instrument_bob.frames_cross_rest(fs: fs)
        && gunbc.design.instrument_bob.frames_max_abs_between(fs: fs, from_ms: 0, to_ms: settle / 3) >
             gunbc.design.instrument_bob.frames_max_abs_between(fs: fs, from_ms: (settle * 2) / 3, to_ms: settle * 4)
        && gunbc.design.instrument_bob.frames_terminate_exactly_once(fs: fs)
        && gunbc.design.instrument_bob.frames_last_displacement(fs: fs) == 0
    }
  }
}

data first_movement_note: String = "The first NON-ZERO displacement in the sequence, because a knock pushes the plate away from the hand. Reading the first non-zero rather than the second frame keeps the claim about the physics rather than about how many frames precede the first visible pixel."

fn frames_first_movement_is_downward(fs: List<gunbc.design.instrument_bob.BobFrame>) -> Bool {
  fold(fs, init: 0, f: (acc, x) => if acc == 0 { x.displacement_px } else { acc }) < 0
}

test fn witness_asset_route_serves_the_modeled_client() -> Bool {
  let js = motion_asset_body()
  js == gunbc.roadmap_component.instrument_motion_client_js_source()
    && string_contains(s: js, pattern: "addEventListener('devicemotion'")
    && string_contains(s: js, pattern: "LinearAccelerationSensor")
    && string_contains(s: js, pattern: "try {")
    && string_contains(s: js, pattern: "catch (err)")
    && string_contains(s: js, pattern: "interface absent in this container")
    && string_contains(s: js, pattern: "construction refused")
}

data axes_are_read_in_the_shipped_client_note: String = "THE READING PREDICATE, ASSERTED ON THE FILE THE ROUTE SERVES (review finding, 2026-08-07). Both probes decided what counted as a value by reading one field — the event path tested acceleration.x alone, the sensor path counted reading events and tested nothing — so a device whose knock landed on y or z was reported as emitting hollow events, and the sensor route reported readings on axes the specification declares nullable.

Pinning the emitted disjunction rather than the constructor is the point: the fix is a change to what the browser executes, so a control that only exercised the AST helper would go green on a client that still shipped the single-axis test. The last two conjuncts hold the vocabulary apart, because 'readings' and 'values' are exactly the two words the collapse merged."

test fn witness_the_shipped_probes_count_any_axis_as_a_value() -> Bool {
  let js = motion_asset_body()
  string_contains(s: js, pattern: "a.x !== null || a.y !== null || a.z !== null")
    && string_contains(s: js, pattern: "s.x !== null || s.y !== null || s.z !== null")
    && !string_contains(s: js, pattern: "a && a.x !== null)")
    && string_contains(s: js, pattern: " reading events, ")
    && string_contains(s: js, pattern: " carrying values, over ")
}

data client_manufactures_no_zero_note: String = "The renderer used to set translateY(0) after consuming the frames, which supplied the ending a non-settling model had failed to reach. That line is gone, and this asserts its absence directly rather than trusting the diff: the client contains no translateY built from a literal zero, and the sequence it replays ends at zero because the model proved it does."

test fn witness_client_computes_no_physics_and_manufactures_no_ending() -> Bool {
  let js = motion_asset_body()
  !string_contains(s: js, pattern: "Math.")
    && !string_contains(s: js, pattern: "exp(")
    && !string_contains(s: js, pattern: "sin(")
    && string_contains(s: js, pattern: "split(',')")
    && !string_contains(s: js, pattern: "'translateY(' + 0 + 'px)'")
}

test fn witness_receipt_starts_unanswered() -> Bool {
  let html = motion_page_body()
  string_contains(s: html, pattern: "not yet run")
    && !string_contains(s: html, pattern: "sensor present")
    && !string_contains(s: html, pattern: "supported")
}


data shared_note_class_note: String = "THE NOTE CLASS IS A WIRE VALUE, NOT A SYMBOL. A repo-wide rename of the fn homonym note matched inside the string literal too, because in \"instrument-note\" the token sits between a hyphen and a quote and neither is a word character. The declaration kept compiling, both pages kept rendering, and the motion page's notes silently stopped matching the stylesheet rule that styles them — a class name is resolved by the browser against CSS text, so nothing in this repository could refuse it. There is now ONE helper: motion imported the sandbox's instrument_note rather than carrying a second copy, so the two cannot drift apart at all. This pins the remaining fact the type system still cannot see — that the emitted class equals the selector the stylesheet defines. The controls are the two exact corrupted spellings: either one reappearing reds this, which the rename that caused it would not have."

test fn witness_note_class_wire_matches_stylesheet_selector() -> Bool {
  let css = gunbc.roadmap_instrument_sandbox.instrument_css()
  let html = motion_page_body()
  gunbc.roadmap_instrument_sandbox.instrument_note_class == "instrument-note"
    && string_contains(s: css, pattern: ".instrument-note")
    && string_contains(s: html, pattern: "instrument-note")
    && !string_contains(s: html, pattern: "instrument-motion_note")
    && !string_contains(s: html, pattern: "instrument-instrument_note")
    && !string_contains(s: css, pattern: ".instrument-motion_note")
}
