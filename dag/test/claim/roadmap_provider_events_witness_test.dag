module test.claim.roadmap_provider_events_witness_test


data successful_codex_jsonl: String = "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item-1\",\"type\":\"file_change\",\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item-1\",\"type\":\"file_change\",\"status\":\"completed\"}}\n{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":10,\"output_tokens\":3}}\n"

test fn codex_stream_classifies_running_activity() -> Bool {
  let parsed = gunbc.roadmap_provider_events.parse_codex_jsonl(
    text: "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
  )
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: parsed) {
    gunbc.roadmap_provider_events.ProviderRunning { activity } => activity == "Agent working · running command"
    _ => false
  }
}

test fn codex_completed_is_terminal_only_from_provider_event() -> Bool {
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(text: successful_codex_jsonl)) {
    gunbc.roadmap_provider_events.ProviderCompleted { activity } => activity == "Agent complete"
    _ => false
  }
}

test fn codex_completed_state_is_terminal() -> Bool {
  match gunbc.roadmap_provider_events.provider_execution_state(
    parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(
      text: join([
        successful_codex_jsonl,
        "{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
      ], ""),
    ),
  ) {
    gunbc.roadmap_provider_events.ProviderCompleted { activity } => activity == "Agent complete"
    _ => false
  }
}

test fn codex_turn_failed_preserves_raw_provider_evidence() -> Bool {
  let failed = "{\"type\":\"turn.failed\",\"error\":{\"message\":\"usage exhausted\"}}"
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(text: failed)) {
    gunbc.roadmap_provider_events.ProviderFailed { activity, detail } =>
      activity == "agent turn failed"
        && string_contains(s: detail, pattern: "usage exhausted")
    _ => false
  }
}

test fn codex_error_is_not_absorbed_into_spawned() -> Bool {
  let state = gunbc.roadmap_provider_events.provider_execution_state(
    parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(
      text: "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"error\",\"message\":\"upstream unavailable\"}\n",
    ),
  )
  gunbc.roadmap_provider_events.provider_execution_state_label(state: state) == "failed"
    && string_contains(
      s: gunbc.roadmap_provider_events.provider_execution_detail(state: state),
      pattern: "upstream unavailable",
    )
}

test fn truncated_line_refuses_with_location_and_raw() -> Bool {
  let truncated = "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"item.started\""
  match gunbc.roadmap_provider_events.parse_codex_jsonl(text: truncated) {
    gunbc.roadmap_provider_events.CodexEventsParsed { events: _ } => false
    gunbc.roadmap_provider_events.CodexEventsRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      count(events_before_refusal) == 1
        && line_number == 2
        && raw == "{\"type\":\"item.started\""
        && string_contains(s: reason, pattern: "truncated")
  }
}

test fn unknown_event_refuses_instead_of_guessing_progress() -> Bool {
  let parsed = gunbc.roadmap_provider_events.parse_codex_jsonl(text: "{\"type\":\"future.event\",\"value\":1}\n")
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: parsed) {
    gunbc.roadmap_provider_events.ProviderEventsRefused { activity: _, detail } =>
      string_contains(s: detail, pattern: "unknown Codex JSONL event type")
        && string_contains(s: detail, pattern: "future.event")
    _ => false
  }
}

test fn nested_type_token_cannot_fabricate_terminal_success() -> Bool {
  let parsed = gunbc.roadmap_provider_events.parse_codex_jsonl(
    text: "{\"kind\":\"future.event\",\"payload\":{\"type\":\"turn.completed\"}}\n",
  )
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: parsed) {
    gunbc.roadmap_provider_events.ProviderEventsRefused { activity: _, detail } =>
      string_contains(s: detail, pattern: "unknown Codex JSONL event type")
    _ => false
  }
}

test fn braced_but_invalid_json_cannot_fabricate_terminal_success() -> Bool {
  match gunbc.roadmap_provider_events.parse_codex_jsonl(text: "{\"type\":\"turn.completed\",}\n") {
    gunbc.roadmap_provider_events.CodexEventsParsed { events: _ } => false
    gunbc.roadmap_provider_events.CodexEventsRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      count(events_before_refusal) == 0
        && line_number == 1
        && raw == "{\"type\":\"turn.completed\",}"
        && string_contains(s: reason, pattern: "malformed")
  }
}

test fn oversized_event_refuses_without_echoing_payload() -> Bool {
  let secret = "large-command-output-must-stay-in-the-attempt-evidence-file"
  let oversized = join([
    "{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"aggregated_output\":\"",
    secret,
    "\"}}\n",
  ], "")
  match gunbc.roadmap_provider_events.parse_codex_jsonl_with_line_budget(
    text: oversized,
    line_budget: std.measure.character_count(count: 48),
  ) {
    gunbc.roadmap_provider_events.CodexEventsParsed { events: _ } => false
    gunbc.roadmap_provider_events.CodexEventsRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      count(events_before_refusal) == 0
        && line_number == 1
        && string_contains(s: raw, pattern: "oversized")
        && !string_contains(s: raw, pattern: secret)
        && string_contains(s: reason, pattern: "observation line budget 48")
        && string_contains(s: reason, pattern: "full raw remains")
  }
}

test fn refusal_marks_prior_activity_as_historical() -> Bool {
  let parsed = gunbc.roadmap_provider_events.parse_codex_jsonl_with_line_budget(
    text: join([
      "{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
      "{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"aggregated_output\":\"payload too large\"}}\n",
    ], ""),
    line_budget: std.measure.character_count(count: 80),
  )
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: parsed) {
    gunbc.roadmap_provider_events.ProviderEventsRefused { activity, detail } =>
      activity == "last observed · Agent working · running command"
        && string_contains(s: detail, pattern: "observation line budget 80")
    _ => false
  }
}

data codex_budget_row_evaluation_witness_note: String = "Forces the three CharacterCount budget rows to EVALUATE, not merely typecheck. A data row can pass every single-entry witness and still fail in CI's affected-set re-eval leg, which evaluates changed data items — that is exactly how `2 as Seconds` shipped green from this branch. Reading the values here makes an unevaluable budget row red locally."

test fn codex_character_budgets_are_measured_counts() -> Bool {
  std.measure.character_count_value(c: gunbc.roadmap_provider_events.codex_provider_event_line_observation_budget) == 65536
    && std.measure.character_count_value(c: gunbc.roadmap_provider_events.codex_provider_projection_type_budget) == 128
    && std.measure.character_count_value(c: gunbc.roadmap_provider_events.codex_provider_projection_detail_budget) == 4096
    && string_contains(
      s: gunbc.roadmap_provider_events.codex_provider_event_projection_filter as String,
      pattern: "[0:128]",
    )
}

data codex_item_activity_anchor_witness_note: String = "review 44058. The activity read used to scan the WHOLE projected line for a \"type\":\"…\" fragment, so a sibling or nested object carrying another item type reclassified the pane — the same shape the top-level classifier is already anchored against (nested_type_token_cannot_fabricate_terminal_success, right above). The pair is discriminating in both directions: the forged line puts item.type = agent_message beside a sibling object spelling file_change, and the old scan answered \"editing files\" on it because file_change is tested before agent_message; the genuine line proves the anchored walk still finds a real file_change rather than having simply stopped working. Reachability: today the projector emits only a top-level type plus an item object carrying only its own type, so the sibling shape arrives on projector drift or on any future direct read of the raw stream — this is the defense-in-depth the top-level anchor already carries, applied to the member beneath it."

fn activity_of(text: String) -> String {
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(text: text)) {
    gunbc.roadmap_provider_events.ProviderRunning { activity } => activity
    _ => ""
  }
}

test fn codex_agent_message_completed_is_finishing_not_complete() -> Bool {
  match gunbc.roadmap_provider_events.provider_execution_state(parsed: gunbc.roadmap_provider_events.parse_codex_jsonl(
    text: join([
      "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n",
      "{\"type\":\"turn.started\"}\n",
      "{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"done\"}}\n",
    ], ""),
  )) {
    gunbc.roadmap_provider_events.ProviderRunning { activity } => activity == "Agent finishing"
    gunbc.roadmap_provider_events.ProviderCompleted { activity: _ } => false
    _ => false
  }
}

test fn codex_item_activity_ignores_a_quoted_type_in_the_payload() -> Bool {
  let forged = activity_of(
    text: "{\"type\":\"item.started\",\"item\":{\"type\":\"agent_message\"},\"echo\":{\"type\":\"file_change\"}}\n",
  )
  let genuine = activity_of(
    text: "{\"type\":\"item.started\",\"item\":{\"type\":\"file_change\"}}\n",
  )
  forged == "Agent working · reporting" && genuine == "Agent working · editing files"
}

test fn roadmap_provider_events_keystone_holds() -> Bool {
  codex_stream_classifies_running_activity()
    && codex_agent_message_completed_is_finishing_not_complete()
    && codex_completed_is_terminal_only_from_provider_event()
    && codex_completed_state_is_terminal()
    && codex_turn_failed_preserves_raw_provider_evidence()
    && codex_error_is_not_absorbed_into_spawned()
    && truncated_line_refuses_with_location_and_raw()
    && unknown_event_refuses_instead_of_guessing_progress()
    && nested_type_token_cannot_fabricate_terminal_success()
    && braced_but_invalid_json_cannot_fabricate_terminal_success()
    && oversized_event_refuses_without_echoing_payload()
    && refusal_marks_prior_activity_as_historical()
}

data agent_report_projection_witness_note: String = "The agent REPORT members of the projection filter, pinned as a string contract because the filter is a jq program the substrate assembles but does not itself interpret (codex_projection_filter_scaffold_note). Nothing downstream of the shell can prove what the projector emitted, so the claims that matter here are: the report bound is the MESSAGE budget and not the detail budget beside it (a copy-paste of the wrong bound would still emit valid jq and still look fine on a short message, failing only on the day a long one arrived); the truncation flag is computed with a length comparison against the ORIGINAL text, so it describes the provider output rather than the slice; and the anchored item.type walk is untouched, since the report is emitted as a member AFTER item.type and the walk depends on that position. The behavioural half — real captured events through real jq — is dag/test/fixture/codex_provider_events, whose third line carries the item.text this filter reads."

fn projection_filter_text() -> String { gunbc.roadmap_provider_events.codex_provider_event_projection_filter as String }

fn message_budget_chars() -> Int { std.measure.character_count_value(c: gunbc.roadmap_provider_events.codex_provider_projection_message_budget) }

fn detail_budget_chars() -> Int { std.measure.character_count_value(c: gunbc.roadmap_provider_events.codex_provider_projection_detail_budget) }

test fn agent_report_is_bounded_by_the_message_budget() -> Bool {
  string_contains(
    s: projection_filter_text(),
    pattern: concat(".item.text[0:", concat(to_string(message_budget_chars()), "]")),
  )
}

test fn agent_report_budget_is_not_the_detail_budget() -> Bool {
  let m = message_budget_chars()
  let d = detail_budget_chars()
  !(m == d)
}

test fn agent_report_declares_truncation_from_original_length() -> Bool {
  string_contains(s: projection_filter_text(), pattern: "\"truncated\":((.item.text | length) > ")
    && string_contains(s: projection_filter_text(), pattern: "agent_message")
}

test fn agent_report_does_not_disturb_the_item_type_anchor() -> Bool {
  string_contains(s: projection_filter_text(), pattern: "\"item\":{\"type\":item_type,\"message\":agent_report}")
    && string_contains(s: projection_filter_text(), pattern: "\"item\":{\"type\":item_type}")
}
