module test.claim.generic_collection_callback_binding_witness

import std.types { String, Bool, Int }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// Permanent source-level controls for v1.compiler.infer.infer_call_arguments_generic_pass.
// The census compiles each authored program against the live tree; a failed observation
// refuses the claim. std.occurrence_identity.occurrence_allocation_fold is the later consumer of this shape.
fn callback_inference_error_count(source: String) -> Int {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(source), wanted: "InternalError") {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

data list_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn asks(xs: List<Element>) -> Int { collect(xs: xs, f: item => item.value) }\n"

data direct_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn asks(xs: FreeMonoid<Element>) -> Int { collect(xs: xs, f: item => item.value) }\n"

data concrete_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn value_of(item: Element) -> Int { item.value }\nfn asks(xs: List<Element>) -> Int { collect(xs: xs, f: value_of) }\n"

data unbound_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn asks<T>(xs: FreeMonoid<T>) -> Int { collect(xs: xs, f: item => item.value) }\n"

data missing_field_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn asks(xs: List<Element>) -> Int { collect(xs: xs, f: item => item.missing) }\n"

test fn list_callback_binds() -> Bool {
  callback_inference_error_count(source: list_callback_source) == 0
}

test fn direct_callback_binds() -> Bool {
  callback_inference_error_count(source: direct_callback_source) == 0
}

test fn concrete_callback_binds() -> Bool {
  callback_inference_error_count(source: concrete_callback_source) == 0
}

test fn unbound_callback_refuses() -> Bool {
  callback_inference_error_count(source: unbound_callback_source) >= 1
}

test fn missing_field_callback_refuses() -> Bool {
  callback_inference_error_count(source: missing_field_callback_source) >= 1
}

