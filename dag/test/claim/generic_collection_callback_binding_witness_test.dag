module test.claim.generic_collection_callback_binding_witness

import std.types { String, Bool, Int }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// Permanent source-level controls for v1.compiler.infer.infer_call_arguments_generic_pass.
// The census compiles each authored program against the live tree; a failed observation
// refuses the claim. std.occurrence_identity.occurrence_allocation_fold is the later consumer of this shape.
fn callback_inference_error_count(source: String) -> Int {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(source), wanted: "InternalError") {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

data concrete_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn value_of(item: Element) -> Int { item.value }\nfn asks(xs: List<Element>) -> Int { collect(xs: xs, f: value_of) }\n"

data unbound_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn asks<T>(xs: FreeMonoid<T>) -> Int { collect(xs: xs, f: item => item.value) }\n"

data missing_field_callback_source: String = "module probe_generic_collection_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\ntype Element { value: Int }\nfn collect<T>(xs: FreeMonoid<T>, f: fn(T) -> Int) -> Int { fold(xs, init: 0, f: fn(total, item) { total + f(item) }) }\nfn asks(xs: List<Element>) -> Int { collect(xs: xs, f: item => item.missing) }\n"

test fn concrete_callback_binds() -> Bool {
  callback_inference_error_count(source: concrete_callback_source) == 0
}

test fn unbound_callback_refuses() -> Bool {
  callback_inference_error_count(source: unbound_callback_source) >= 1
}

test fn missing_field_callback_refuses() -> Bool {
  callback_inference_error_count(source: missing_field_callback_source) >= 1
}

data state_node_source: String = "module probe_generic_state_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\nimport test.claim.generic_collection_callback_fixture { Step, collect_state }\nimport v2.std.node { Atom, Conj, Node, Edge, Positional, TypeNode, node_synthetic }\nfn edges() -> FreeMonoid<Edge> { [Edge { label: Positional, target: node_synthetic(kind: TypeNode { connective: Atom { identity: ^fixture_target } }, children: []) }] }\nfn parent() -> Node { node_synthetic(kind: TypeNode { connective: Conj }, children: edges()) }\nfn asks() -> Int { let p = parent() let result = collect_state(xs: p.children, init: Step { value: 0, cursor: 0 }, f: fn(total, edge, cursor) { Step { value: total + 1 + count(edge.target.children), cursor: cursor } }) result.value }\n"

test fn state_node_binds() -> Bool {
  callback_inference_error_count(source: state_node_source) == 0
}

data state_direct_node_source: String = "module probe_generic_state_callback\nimport std.algebra { FreeMonoid }\nimport std.types { Int, List }\nimport test.claim.generic_collection_callback_fixture { Step, collect_state }\nimport v2.std.node { Atom, Conj, Node, Edge, Positional, TypeNode, node_synthetic }\nfn edges() -> FreeMonoid<Edge> { [Edge { label: Positional, target: node_synthetic(kind: TypeNode { connective: Atom { identity: ^fixture_target } }, children: []) }] }\nfn parent() -> Node { node_synthetic(kind: TypeNode { connective: Conj }, children: edges()) }\nfn asks() -> Int { let result = collect_state(xs: edges(), init: Step { value: 0, cursor: 0 }, f: fn(total, edge, cursor) { Step { value: total + 1 + count(edge.target.children), cursor: cursor } }) result.value }\n"

test fn state_direct_node_binds() -> Bool {
  callback_inference_error_count(source: state_direct_node_source) == 0
}

// Consumed by the seed substitution repair: a concrete applied alias must retain
// its argument identity when it is substituted into another collection.
data applied_alias_return_source: String = "module probe\n\ntype FreeMonoid<T> = Empty | Cons { head: T, tail: FreeMonoid<T> }\ntype Names = FreeMonoid<String>\nfn keep<T>(xs: FreeMonoid<T>, item: T) -> FreeMonoid<T> { xs }\nfn asks(xs: List<Names>, item: Names) -> List<Names> {\n  if true { xs } else { keep(xs: xs, item: item) }\n}\n"

test fn applied_alias_return_binds() -> Bool {
  callback_inference_error_count(source: applied_alias_return_source) == 0
}

// Consumed by seed type-argument canonicalization: an initially empty accumulator
// must acquire its element type before a later callback reads that element.
data empty_fold_source: String = "module probe_generic_empty_fold\nimport std.types { Int, List, String }\nimport v2.std.algebra { fold_list, list_snoc_item }\ntype Module { module: String, declarations: List<String> }\nfn asks(xs: List<Module>) -> Int {\n  let modules = fold_list(xs: xs, empty: [], cons: fn(acc, m) { list_snoc_item(xs: acc, item: m) })\n  fold_list(xs: modules, empty: 0, cons: fn(acc, m) { acc + count(m.declarations) })\n}\n"

test fn empty_fold_element_binds() -> Bool {
  callback_inference_error_count(source: empty_fold_source) == 0
}

data empty_map_source: String = "module probe_generic_empty_map\nfn asks() -> Map<String, Int> { empty_map() }\n"

test fn empty_map_argument_binds() -> Bool {
  callback_inference_error_count(source: empty_map_source) == 0
}

data empty_set_source: String = "module probe_generic_empty_set\nfn asks() -> Set<Int> { empty_set() }\n"

test fn empty_set_argument_binds() -> Bool {
  callback_inference_error_count(source: empty_set_source) == 0
}

// Consumed by the semantic type-child projection repair: branch typing runs
// type_resolution_verdict through this nested optional fold path.
data nested_optional_fold_source: String = "module probe\ntype Record { value: Int }\ntype Rejected { item: Record }\nfn asks(xs: List<Record>) -> Rejected? {\n fold(xs, init: Absent, f: fn(acc, a) {\n  match acc {\n   Present { value: r } => Present { value: r }\n   Absent => if a.value > 0 {\n    match a.value { 0 => Absent _ => Present { value: Rejected { item: a } } }\n   } else { Absent }\n  }\n })\n}\n"

test fn nested_optional_fold_binds() -> Bool {
  callback_inference_error_count(source: nested_optional_fold_source) == 0
}

// Consumed by the semantic type-child projection repair: branch typing runs
// type_resolution_verdict through this record field branch path.
data record_field_branch_source: String = "module probe_record_field_branch\ntype Record { value: Int }\nfn asks(flag: Bool, record: Record) -> Record {\n if flag { record } else { Record { value: 3 } }\n}\n"

test fn record_field_branch_binds() -> Bool {
  callback_inference_error_count(source: record_field_branch_source) == 0
}

// Consumed by the semantic type-child projection repair: branch typing runs
// type_resolution_verdict through this generic argument branch path.
data generic_argument_branch_source: String = "module probe_generic_argument_branch\ntype Envelope<T> { value: T }\nfn asks(flag: Bool, xs: List<Envelope<Int>>) -> List<Envelope<Int>> {\n if flag { xs } else { [Envelope { value: 1 }] }\n}\n"

test fn generic_argument_branch_binds() -> Bool {
  callback_inference_error_count(source: generic_argument_branch_source) == 0
}

// Consumed by the seed collection-constraint repair: preserves the nested accumulator
// flow of v2.compiler.compile.native_lane_universe_after_ownership.
data nested_empty_fold_source: String = "module probe_nested_empty_fold\nimport std.types { Int, List, String }\nimport v2.std.algebra { fold_list, list_snoc_item }\ntype Module { module: String, declarations: List<String> }\ntype Source { modules: List<Module> }\nfn modules_for_source(source: Source) -> List<Module> { source.modules }\nfn asks(sources: List<Source>) -> Int {\n  let modules = fold_list(\n    xs: sources,\n    empty: [],\n    cons: fn(acc, source) {\n      fold_list(\n        xs: modules_for_source(source: source),\n        empty: acc,\n        cons: fn(inner, m) { list_snoc_item(xs: inner, item: m) }\n      )\n    }\n  )\n  fold_list(xs: modules, empty: 0, cons: fn(acc, m) { acc + count(m.declarations) })\n}\n"

test fn nested_empty_fold_element_binds() -> Bool {
  callback_inference_error_count(source: nested_empty_fold_source) == 0
}
