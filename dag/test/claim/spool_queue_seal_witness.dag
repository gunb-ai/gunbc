test fn the_instance_keyed_open_resolves() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: probe_open_source), holds: fn(n) { n == 0 }))
}

test fn the_unit_spool_claimed_dir_is_gone() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: raw_unit_claimed_source, wanted_class: "MissingExport", wanted_subject: "attempt_unit_spool_claimed_dir"), holds: fn(n) { n == 1 }))
}

