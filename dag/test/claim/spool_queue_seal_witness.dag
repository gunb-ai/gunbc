  census_exit(census_verdict(census: blocking_subject_census(source: raw_publication_source, wanted_class: "MissingExport", wanted_subject: "publication_request_dir"), holds: fn(n) { n == 1 }))
}

test fn a_pending_exit_entry_advances_to_handed_off_not_claimed() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RolePending }) {
    ClaimEligible { from: _, into: r } => if (r == RoleHandedOff) { ExitSuccess } else { exit_failure(reason: "the exit chain skipped its handed-off stage") }
    ClaimAlreadyClaimed => exit_failure(reason: "pending read as claimed")
    ClaimAbsent => exit_failure(reason: "pending read as absent")
    ClaimTerminal { state: _ } => exit_failure(reason: "pending read as terminal")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "undeclared role: pending read as terminal")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
    ClaimRefused { detail: _ } => exit_failure(reason: "pending was refused")
  }
}

test fn a_refused_entry_is_terminal_and_never_claimable_again() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleRefused }) {
    ClaimTerminal { state: _ } => ExitSuccess
    ClaimEligible { from: _, into: _ } => exit_failure(reason: "a refused entry was offered for claim")
    ClaimAlreadyClaimed => exit_failure(reason: "refused read as claimed")
    ClaimAbsent => exit_failure(reason: "refused read as absent")
    ClaimRefused { detail: _ } => exit_failure(reason: "refused was refused")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "undeclared role")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
  }
}

fn key_refused(kind: SpoolKind, parts: List<String>) -> Bool {
  match spool_entry_key(kind: kind, parts: parts) {
    SpoolKeyRefused { detail: _ } => true
    SpoolKeyMinted { key: _ } => false
  }
}

test fn a_part_containing_the_separator_is_refused_so_the_mint_is_injective() -> ProcessExit {
  if key_refused(kind: SpoolAttemptUnit, parts: ["a+b", "c"]) && key_refused(kind: SpoolAttemptUnit, parts: ["a", "b+c"]) { ExitSuccess } else { exit_failure(reason: "a separator-bearing part minted a key") }
}

test fn an_empty_or_unsafe_part_is_refused() -> ProcessExit {
  if key_refused(kind: SpoolAttemptUnit, parts: ["", "c"]) && key_refused(kind: SpoolAttemptUnit, parts: ["..", "c"]) { ExitSuccess } else { exit_failure(reason: "an empty or unsafe part minted a key") }
}

test fn a_foreign_name_does_not_decode_to_a_key() -> ProcessExit {
  if key_refused(kind: SpoolAttemptUnit, parts: ["a", "b", "c"]) {
    match spool_entry_key_of_name(kind: SpoolAttemptUnit, name: "only") {
      SpoolKeyRefused { detail: _ } => ExitSuccess
      SpoolKeyMinted { key: _ } => exit_failure(reason: "a one-part name decoded for a two-part spool")
    }
  } else {
    exit_failure(reason: "a three-part list minted a two-part key")
  }
}

test fn a_minted_name_decodes_to_the_same_key() -> ProcessExit {
  match spool_entry_key_of_name(kind: SpoolAttemptUnit, name: "node-1+abc") {
    SpoolKeyMinted { key: _ } => ExitSuccess
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
  }
}

// PERMANENT CONTROLS: no UNEVIDENCED operation moves an entry out of Claimed to an earlier role (the only one is
// requeue_on_evidence, gated on a claimant-dead boot-id observation), and none reclaims by age.
// Importing any such effect is a MissingExport and must stay one.
test fn no_requeue_operation_exists() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: probe_requeue_source, wanted_class: "MissingExport", wanted_subject: "spool_queue_requeue"), holds: fn(n) { n == 1 }))
}

test fn no_reap_stale_reclaim_operation_exists() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: probe_reap_source, wanted_class: "MissingExport", wanted_subject: "spool_queue_reap_stale"), holds: fn(n) { n == 1 }))
}

// The evidence-gated requeue effect resolves; its stripped twin is the MissingExport probes above.
test fn the_requeue_on_evidence_effect_resolves() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: probe_requeue_on_evidence_source), holds: fn(n) { n == 0 }))
}

test fn a_different_boot_id_licenses_requeue_to_pending() -> ProcessExit {
  match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, evidence: BootsObserved { claim_boot_id: "boot-a", current_boot_id: "boot-b" as NonEmptyStr }) {
    RequeueEligible { from: _, into: t } => if (t == RolePending) { ExitSuccess } else { exit_failure(reason: "requeued somewhere other than pending") }
    _ => exit_failure(reason: "a different boot id did not license requeue")
  }
}

test fn the_same_boot_id_or_no_observation_never_requeues() -> ProcessExit {
  match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, evidence: BootsObserved { claim_boot_id: "boot-a", current_boot_id: "boot-a" as NonEmptyStr }) {
    RequeueClaimantStillBound =>
      match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, evidence: NoClaimantObservation { cause: "no boot id readable" as NonEmptyStr }) {
        RequeueRefused { cause: _ } => ExitSuccess
        _ => exit_failure(reason: "no observation did not refuse")
      }
    _ => exit_failure(reason: "the same boot id did not hold the claim")
  }
}

test fn only_a_claimed_entry_is_requeued() -> ProcessExit {
  match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleHandedOff }, evidence: BootsObserved { claim_boot_id: "a", current_boot_id: "b" as NonEmptyStr }) {
    RequeueNotClaimed { state: _ } => ExitSuccess
    _ => exit_failure(reason: "a non-claimed entry was requeued")
  }
}

// EXPECTING-RED: the one stale effect is the line stop feeding gunbc.roadmap.spool_stall; it does not exist yet.
test fn the_stale_stop_effect_resolves() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: probe_stale_stop_source), holds: fn(n) { n == 0 }))
}

// EXPECTING-RED: HostSpoolStage must dissolve into SpoolRole (consumers moved: gunbc.durable_handoff_host,
// gunbc.roadmap.spool_stall, gunbc.roadmap.roadmap_attempt_exit_spool, gunbc.roadmap.roadmap_belt_actuate,
// gunbc.roadmap.roadmap_launch_deployment_observe, and the claims that import it). Flips to MissingExport.
test fn the_host_spool_stage_enum_is_gone() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: raw_host_spool_stage_source, wanted_class: "MissingExport", wanted_subject: "HostSpoolStage"), holds: fn(n) { n == 1 }))
}
