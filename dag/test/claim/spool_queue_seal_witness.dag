test fn a_pending_exit_entry_advances_to_handed_off_not_claimed() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RolePending }) {
    ClaimEligible { from: _, into: r } => if (r == RoleHandedOff) { ExitSuccess } else { exit_failure(reason: "the exit chain skipped its handed-off stage") }
    ClaimAlreadyClaimed => exit_failure(reason: "pending read as claimed")
    ClaimAbsent => exit_failure(reason: "pending read as absent")
    ClaimTerminal { state: _ } => exit_failure(reason: "pending read as terminal")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "undeclared role: pending read as terminal")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
    ClaimParked { role: _ } => exit_failure(reason: "the entry reads as parked")
    ClaimRefused { detail: _ } => exit_failure(reason: "pending was refused")
  }
}

test fn a_refused_entry_is_terminal_and_never_claimable_again() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleRefused }) {
    ClaimTerminal { state: _ } => ExitSuccess
    ClaimEligible { from: _, into: _ } => exit_failure(reason: "a refused entry was offered for claim")
    ClaimAlreadyClaimed => exit_failure(reason: "refused read as claimed")
    ClaimAbsent => exit_failure(reason: "refused read as absent")
    ClaimRefused { detail: _ } => exit_failure(reason: "refused was refused")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "undeclared role")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
    ClaimParked { role: _ } => exit_failure(reason: "the entry reads as parked")
  }
}

fn key_refused(kind: SpoolKind, parts: List<String>) -> Bool {
  match spool_entry_key(kind: kind, parts: parts) {
    SpoolKeyRefused { detail: _ } => true
    SpoolKeyMinted { key: _ } => false
  }
}

test fn a_part_containing_the_separator_is_refused_so_the_mint_is_injective() -> ProcessExit {
  if key_refused(kind: SpoolAttemptUnit, parts: ["a+b", "c"]) && key_refused(kind: SpoolAttemptUnit, parts: ["a", "b+c"]) { ExitSuccess } else { exit_failure(reason: "a separator-bearing part minted a key") }
}

test fn an_empty_or_unsafe_part_is_refused() -> ProcessExit {
  if key_refused(kind: SpoolAttemptUnit, parts: ["", "c"]) && key_refused(kind: SpoolAttemptUnit, parts: ["..", "c"]) { ExitSuccess } else { exit_failure(reason: "an empty or unsafe part minted a key") }
}

test fn a_foreign_name_does_not_decode_to_a_key() -> ProcessExit {
  if key_refused(kind: SpoolAttemptUnit, parts: ["a", "b", "c"]) {
    match spool_entry_key_of_name(kind: SpoolAttemptUnit, name: "only") {
      SpoolKeyRefused { detail: _ } => ExitSuccess
      SpoolKeyMinted { key: _ } => exit_failure(reason: "a one-part name decoded for a two-part spool")
    }
  } else {
    exit_failure(reason: "a three-part list minted a two-part key")
  }
}

test fn a_minted_name_decodes_to_the_same_key() -> ProcessExit {
  match spool_entry_key_of_name(kind: SpoolAttemptUnit, name: "node1+abc") {
    SpoolKeyMinted { key: _ } => ExitSuccess
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
  }
}

// PERMANENT CONTROLS: no UNEVIDENCED operation moves an entry out of Claimed to an earlier role (the only one is
// requeue_on_evidence, gated on a claimant-dead boot-id observation), and none reclaims by age.
// Importing any such effect is a MissingExport and must stay one.
test fn no_requeue_operation_exists() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: probe_requeue_source, wanted_class: "MissingExport", wanted_subject: "spool_queue_requeue"), holds: fn(n) { n == 1 }))
}

test fn no_reap_stale_reclaim_operation_exists() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: probe_reap_source, wanted_class: "MissingExport", wanted_subject: "spool_queue_reap_stale"), holds: fn(n) { n == 1 }))
}

// The evidence-gated requeue effect resolves; its stripped twin is the MissingExport probes above.
test fn the_requeue_on_evidence_effect_resolves() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: probe_requeue_on_evidence_source), holds: fn(n) { n == 0 }))
}

test fn a_different_boot_id_licenses_requeue_to_pending() -> ProcessExit {
  match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, evidence: BootsObserved { claim_boot_id: "boot-a", current_boot_id: "boot-b" as NonEmptyStr }) {
    RequeueEligible { from: _, into: t } => if (t == RolePending) { ExitSuccess } else { exit_failure(reason: "requeued somewhere other than pending") }
    _ => exit_failure(reason: "a different boot id did not license requeue")
  }
}

test fn the_same_boot_id_or_no_observation_never_requeues() -> ProcessExit {
  match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, evidence: BootsObserved { claim_boot_id: "boot-a", current_boot_id: "boot-a" as NonEmptyStr }) {
    RequeueClaimantStillBound =>
      match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, evidence: NoClaimantObservation { cause: "no boot id readable" as NonEmptyStr }) {
        RequeueRefused { cause: _ } => ExitSuccess
        _ => exit_failure(reason: "no observation did not refuse")
      }
    _ => exit_failure(reason: "the same boot id did not hold the claim")
  }
}

test fn only_a_claimed_entry_is_requeued() -> ProcessExit {
  match spool_requeue_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleHandedOff }, evidence: BootsObserved { claim_boot_id: "a", current_boot_id: "b" as NonEmptyStr }) {
    RequeueNotClaimed { state: _ } => ExitSuccess
    _ => exit_failure(reason: "a non-claimed entry was requeued")
  }
}

// PERMANENT CONTROL (was expecting-red): HostSpoolStage dissolved into SpoolRole (consumers moved: gunbc.durable_handoff_host,
// gunbc.roadmap.spool_stall, gunbc.roadmap.roadmap_attempt_exit_spool, gunbc.roadmap.roadmap_belt_actuate,
// gunbc.roadmap.roadmap_launch_deployment_observe, and the claims that import it). It is a MissingExport.
// MUTANT: a consumer that collapses the typed path result back to an Optional (the kind refusal read as "no entry")
// does not typecheck, and the three-armed twin does.
data collapse_mutant_source: String = "module probe_collapse\nimport std.types { String }\nimport std.optional { Present, Absent }\nimport gunbc.spool_queue { spool_entry_key, SpoolKind, SpoolAttemptUnit, SpoolEntryPath, SpoolEntryPathReady, SpoolEntryRoleUndeclared, SpoolEntryKindRefused, RolePending, spool_open, spool_entry_path, SpoolKeyMinted, SpoolKeyRefused }\nfn f(p: SpoolEntryPath) -> String {\n  match p {\n    Absent => \"collapsed\"\n    Present { value: _ } => \"ready\"\n  }\n}\n"

data collapse_typed_twin_source: String = "module probe_collapse\nimport std.types { String }\nimport std.optional { Present, Absent }\nimport gunbc.spool_queue { spool_entry_key, SpoolKind, SpoolAttemptUnit, SpoolEntryPath, SpoolEntryPathReady, SpoolEntryRoleUndeclared, SpoolEntryKindRefused, RolePending, spool_open, spool_entry_path, SpoolKeyMinted, SpoolKeyRefused }\nfn f(p: SpoolEntryPath) -> String {\n  match p {\n    SpoolEntryPathReady { path: _ } => \"ready\"\n    SpoolEntryRoleUndeclared { role: _ } => \"undeclared\"\n    SpoolEntryKindRefused { detail: d } => d\n  }\n}\n"

test fn collapsing_the_path_result_to_an_optional_is_refused_at_compile() -> ProcessExit {
  census_exit(blocking_delta(hostile: collapse_mutant_source, safe: collapse_typed_twin_source, holds: fn(n) { n >= 1 }))
}

test fn the_typed_path_result_consumer_compiles_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: collapse_typed_twin_source), holds: fn(n) { n == 0 }))
}

test fn the_host_spool_stage_enum_is_gone() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: raw_host_spool_stage_source, wanted_class: "MissingExport", wanted_subject: "HostSpoolStage"), holds: fn(n) { n == 1 }))
}

test fn every_declared_spool_has_a_wellformed_stage_graph() -> ProcessExit {
  if spool_declaration_wellformed(declaration: spool_declaration(kind: SpoolAttemptUnit)) && spool_declaration_wellformed(declaration: spool_declaration(kind: SpoolAttemptExit)) && spool_declaration_wellformed(declaration: spool_declaration(kind: SpoolPublication)) {
    ExitSuccess
  } else {
    exit_failure(reason: "a declared spool has a malformed stage graph")
  }
}

// NEGATIVE CONTROL: a role in both chain and terminals, and a non-positive key part count
// are each refused by the same decision.
test fn a_malformed_stage_graph_is_refused() -> ProcessExit {
  let base = spool_declaration(kind: SpoolAttemptUnit)
  let overlapping = SpoolDeclaration { exclusion: base.exclusion, entry_kind: base.entry_kind, chain: base.chain, terminals: [SpoolStage { role: RoleClaimed, directory: "claimed2" }], parked: base.parked, enqueuer: PrincipalRequester, claimant: PrincipalDrainer, key_separator: "-", key_part_count: 2, partition: base.partition }
  let keyless = SpoolDeclaration { exclusion: base.exclusion, entry_kind: base.entry_kind, chain: base.chain, terminals: [], parked: base.parked, enqueuer: PrincipalRequester, claimant: PrincipalDrainer, key_separator: "-", key_part_count: 0, partition: base.partition }
  if spool_declaration_wellformed(declaration: overlapping) || spool_declaration_wellformed(declaration: keyless) {
    exit_failure(reason: "a malformed stage graph was admitted")
  } else {
    ExitSuccess
  }
}

// DISCRIMINATING: a role the spool does not declare has no writers (the unit spool declares no done role, the
// publication spool no claimed role), while a declared role still has them.
test fn the_writers_column_names_no_writer_for_an_undeclared_role() -> ProcessExit {
  if is_empty(xs: spool_role_writers(kind: SpoolAttemptUnit, role: RoleDone)) && is_empty(xs: spool_role_writers(kind: SpoolPublication, role: RoleClaimed)) && (!is_empty(xs: spool_role_writers(kind: SpoolAttemptUnit, role: RoleClaimed))) && (!is_empty(xs: spool_role_writers(kind: SpoolPublication, role: RoleRefused))) {
    ExitSuccess
  } else {
    exit_failure(reason: "the writers column answers for an undeclared role, or omits a declared one")
  }
}

// The publication spool's entry is a file: its wire name carries the declared suffix, a bare name is foreign, and a
// directory spool's wire name is its key name unchanged.
test fn the_wire_name_carries_the_declared_entry_kind() -> ProcessExit {
  match spool_entry_key_of_wire_name(kind: SpoolPublication, wire_name: "abc.json") {
    SpoolKeyMinted { key: k } =>
      match spool_entry_key_of_wire_name(kind: SpoolPublication, wire_name: "abc") {
        SpoolKeyMinted { key: _ } => exit_failure(reason: "a file entry name without the suffix was admitted")
        SpoolKeyRefused { detail: _ } =>
          if spool_entry_wire_name(key: k) == "abc.json" {
            ExitSuccess
          } else {
            exit_failure(reason: "the wire name does not round-trip")
          }
      }
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
  }
}

// The live bytes are `<node_id>+<attempt_key>` (attempt_system_unit_request_entry_name); node ids carry hyphens, so the separator
// must be '+' for the key to be injective over real names.
test fn a_hyphenated_node_id_round_trips_and_the_on_disk_name_parses() -> ProcessExit {
  match spool_entry_key(kind: SpoolAttemptUnit, parts: ["adhoc-ec4fbad6-dec", "attempt-1"]) {
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
    SpoolKeyMinted { key: k } => {
      match spool_entry_key_of_name(kind: SpoolAttemptUnit, name: "adhoc-ec4fbad6-dec+attempt-1") {
        SpoolKeyRefused { detail: d } => exit_failure(reason: d)
        SpoolKeyMinted { key: k2 } => if (k == k2) && ((k.name as String) == "adhoc-ec4fbad6-dec+attempt-1") && (spool_entry_key_parts(key: k) == ["adhoc-ec4fbad6-dec", "attempt-1"]) { ExitSuccess } else { exit_failure(reason: "a hyphenated node id did not round-trip through the on-disk name") }
      }
    }
  }
}

// THE KIND ADMISSION CONTROL. A lawful key of one spool kind (a publication request) against a lawful store of another
// (the attempt-unit spool), over a root that does not exist: nothing is created or moved whatever the outcome, and the
// outcome must be the typed kind refusal, not absence, which is what the same pair reads as without the boundary
// (the BROKEN twin removes spool_key_kind_refusal and these claims then read EntryAbsent / ClaimAbsent / NotClaimed).
data cross_kind_root: String = "/nonexistent-spool-kind-admission-control"

data cross_kind_detail: String = "a key minted for one spool kind was presented to a store of another kind: req"

test fn a_key_of_another_kind_cannot_address_a_path_in_the_store() -> ProcessExit {
  match spool_entry_key(kind: SpoolPublication, parts: ["req"]) {
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
    SpoolKeyMinted { key: k } => {
      let st = spool_open(kind: SpoolAttemptUnit, instance_root: cross_kind_root)
      match spool_entry_path(store: st, role: RolePending, key: k) {
        SpoolEntryKindRefused { detail: d } => if d == cross_kind_detail { ExitSuccess } else { exit_failure(reason: d) }
        SpoolEntryRoleUndeclared { role: _ } => exit_failure(reason: "a cross-kind key read as an undeclared role")
        SpoolEntryPathReady { path: _ } => exit_failure(reason: "a cross-kind key addressed a path")
      }
    }
  }
}

test fn a_key_of_another_kind_cannot_be_observed() -> ProcessExit {
  match spool_entry_key(kind: SpoolPublication, parts: ["req"]) {
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
    SpoolKeyMinted { key: k } => {
      let st = spool_open(kind: SpoolAttemptUnit, instance_root: cross_kind_root)
      match spool_queue_observe(store: st, key: k) {
        EntryObservationUnavailable { detail: d } => if d == cross_kind_detail { ExitSuccess } else { exit_failure(reason: d) }
        other => exit_failure(reason: "a cross-kind key was observed as an entry state")
      }
    }
  }
}

test fn a_key_of_another_kind_cannot_be_claimed() -> ProcessExit {
  match spool_entry_key(kind: SpoolPublication, parts: ["req"]) {
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
    SpoolKeyMinted { key: k } => {
      let st = spool_open(kind: SpoolAttemptUnit, instance_root: cross_kind_root)
      match spool_queue_claim(store: st, key: k) {
        SpoolClaimNotDone { assessment: ClaimRefused { detail: d } } => if d == cross_kind_detail { ExitSuccess } else { exit_failure(reason: d) }
        other => exit_failure(reason: "a cross-kind key was claimed or read as absent")
      }
    }
  }
}

test fn a_key_of_another_kind_cannot_be_completed() -> ProcessExit {
  match spool_entry_key(kind: SpoolPublication, parts: ["req"]) {
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
    SpoolKeyMinted { key: k } => {
      let st = spool_open(kind: SpoolAttemptUnit, instance_root: cross_kind_root)
      match spool_queue_complete(store: st, key: k, outcome: SpoolOutcomeDone) {
        SpoolCompleteNotDone { assessment: CompleteRefused { detail: d } } => if d == cross_kind_detail { ExitSuccess } else { exit_failure(reason: d) }
        other => exit_failure(reason: "a cross-kind key was completed or read as not claimed")
      }
    }
  }
}

test fn a_key_of_another_kind_cannot_be_requeued() -> ProcessExit {
  match spool_entry_key(kind: SpoolPublication, parts: ["req"]) {
    SpoolKeyRefused { detail: d } => exit_failure(reason: d)
    SpoolKeyMinted { key: k } => {
      let st = spool_open(kind: SpoolAttemptUnit, instance_root: cross_kind_root)
      match spool_queue_requeue_on_evidence(store: st, key: k, evidence: BootsObserved { claim_boot_id: "a" as NonEmptyStr, current_boot_id: "b" as NonEmptyStr }) {
        SpoolRequeueNotDone { assessment: RequeueNotClaimed { state: EntryObservationUnavailable { detail: d } } } => if d == cross_kind_detail { ExitSuccess } else { exit_failure(reason: d) }
        other => exit_failure(reason: "a cross-kind key was requeued or read as absent")
      }
    }
  }
}

// RoleDeferred IS A ROW OF THE SAME DECLARATION: the attempt-unit spool declares it (directory derived, claimant the
// writer), the others do not, and a parked role that also stands in the chain is refused like any overlapping stage.
test fn the_parked_stage_is_declared_by_the_attempt_unit_spool_alone() -> ProcessExit {
  if spool_role_dir_present(kind: SpoolAttemptUnit, role: RoleDeferred) && (!spool_role_dir_present(kind: SpoolAttemptExit, role: RoleDeferred)) && (!spool_role_dir_present(kind: SpoolPublication, role: RoleDeferred)) && (!is_empty(xs: spool_role_writers(kind: SpoolAttemptUnit, role: RoleDeferred))) && is_empty(xs: spool_role_writers(kind: SpoolPublication, role: RoleDeferred)) {
    ExitSuccess
  } else {
    exit_failure(reason: "the parked stage is not declared by the attempt-unit spool alone")
  }
}

test fn a_parked_role_in_the_chain_is_refused() -> ProcessExit {
  let base = spool_declaration(kind: SpoolAttemptUnit)
  let doubled = SpoolDeclaration { exclusion: base.exclusion, entry_kind: base.entry_kind, chain: base.chain, terminals: base.terminals, parked: [SpoolStage { role: RolePending, directory: "deferred" }], enqueuer: PrincipalRequester, claimant: PrincipalDrainer, key_separator: base.key_separator, key_part_count: base.key_part_count, partition: base.partition }
  if spool_declaration_wellformed(declaration: doubled) {
    exit_failure(reason: "a parked role standing in the chain was admitted")
  } else {
    ExitSuccess
  }
}

// DEFER AND UNDEFER are the only two moves: pending -> deferred and deferred -> pending. A claimed entry is not parked,
// a parked entry is not claimed, and a spool with no parked stage refuses both.
test fn only_the_two_declared_park_moves_exist() -> ProcessExit {
  let ok = match spool_defer_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RolePending }) {
    ParkEligible { from: RolePending, into: RoleDeferred } => true
    _ => false
  } && match spool_undefer_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleDeferred }) {
    ParkEligible { from: RoleDeferred, into: RolePending } => true
    _ => false
  }
  let refused = match spool_defer_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleClaimed }) {
    ParkNotApplicable { state: _ } => true
    _ => false
  } && match spool_undefer_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleClaimed }) {
    ParkNotApplicable { state: _ } => true
    _ => false
  } && match spool_defer_assess(kind: SpoolPublication, observed: EntryStanding { role: RolePending }) {
    ParkNotDeclared => true
    _ => false
  } && match spool_claim_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleDeferred }) {
    ClaimParked { role: _ } => true
    _ => false
  }
  if ok && refused { ExitSuccess } else { exit_failure(reason: "a park move outside the two declared ones exists, or a declared one is missing") }
}
