// RoleDeferred SEAL: the park moves take the sealed SpoolEntryKey, so a foreign module cannot park or unpark an entry it did
// not mint a key for. RED: forged key into spool_queue_defer is exactly one SoleConstructorViolation; STRIPPED TWIN: the same
// call over a key minted by spool_entry_key_of_name has zero.
data forged_defer_source: String = "module probe_spool_queue_forged_defer\nimport std.types { NonEmptyStr }\nimport gunbc.spool_queue { SpoolEntryKey, SpoolKind, SpoolAttemptUnit, SpoolStore, spool_queue_defer, SpoolParkOutcome }\nfn f(store: SpoolStore, n: NonEmptyStr) -> SpoolParkOutcome {\n  spool_queue_defer(store: store, key: SpoolEntryKey { kind: SpoolAttemptUnit, name: n })\n}\n"

data twin_defer_source: String = "module probe_spool_queue_twin_defer\nimport std.types { NonEmptyStr }\nimport gunbc.spool_queue { SpoolKind, SpoolAttemptUnit, SpoolStore }\nimport test.fixture.spool_queue_seal.unsealed { SpoolEntryKey }\nfn defer_stand_in(store: SpoolStore, key: SpoolEntryKey) -> SpoolEntryKey {\n  key\n}\nfn f(store: SpoolStore, n: NonEmptyStr) -> SpoolEntryKey {\n  defer_stand_in(store: store, key: SpoolEntryKey { kind: SpoolAttemptUnit, name: n })\n}\n"

data lawful_defer_source: String = "module probe_spool_queue_lawful_defer\nimport std.types { String }\nimport gunbc.spool_queue { SpoolAttemptUnit, SpoolStore, spool_queue_defer, spool_entry_key_of_name, SpoolKeyMinted, SpoolKeyRefused }\nfn f(store: SpoolStore, name: String) -> String {\n  match spool_entry_key_of_name(kind: SpoolAttemptUnit, name: name) {\n    SpoolKeyMinted { key } => match spool_queue_defer(store: store, key: key) {\n      _ => \"parked\"\n    }\n    SpoolKeyRefused { detail: d } => d\n  }\n}\n"

// THE PARTITIONED SPOOL STORE SEAL (SpoolComputeExit, partition ByPrincipalUid). A partitioned store carries
// a principal uid alongside the instance; the ONLY mint that stamps it is spool_open_uid, which refuses Zero
// and any unpartitioned kind. The sealed SpoolStore cannot be spelled outside its declaring file, so a foreign
// module cannot forge a partitioned store -- with a uid or without one. RED: a foreign literal is exactly one
// SoleConstructorViolation on SpoolStore. STRIPPED TWIN: the identical literal over test.fixture.spool_queue_seal.unsealed
// SpoolStore (same fields, sole_constructor removed) is admitted with zero, so the refusal is the keyword, not
// the field shape or the uid. MINTED CONTROL: a store produced by spool_open_uid (the business-key mint) carries
// no violation.

data forged_partitioned_store_source: String = "module probe_spool_queue_forged_partitioned_store\nimport gunbc.spool_queue { SpoolComputeExit, SpoolStore }\nimport std.optional { Present }\nfn f() -> SpoolStore {\n  SpoolStore { kind: SpoolComputeExit, instance_root: \"/tmp/compute/root\", partition_uid: Present { value: 1000 } }\n}\n"

data forged_partitioned_store_no_uid_source: String = "module probe_spool_queue_forged_partitioned_store_no_uid\nimport gunbc.spool_queue { SpoolComputeExit, SpoolStore }\nimport std.optional { Absent }\nfn f() -> SpoolStore {\n  SpoolStore { kind: SpoolComputeExit, instance_root: \"/tmp/compute/root\", partition_uid: Absent }\n}\n"

data twin_partitioned_store_source: String = "module probe_spool_queue_twin_partitioned_store\nimport gunbc.spool_queue { SpoolComputeExit }\nimport test.fixture.spool_queue_seal.unsealed { SpoolStore }\nimport std.optional { Present }\nfn f() -> SpoolStore {\n  SpoolStore { kind: SpoolComputeExit, instance_root: \"/tmp/compute/root\", partition_uid: Present { value: 1000 } }\n}\n"

data minted_partitioned_store_source: String = "module probe_spool_queue_minted_partitioned_store\nimport gunbc.spool_queue { SpoolComputeExit, spool_open_uid, SpoolOpenReady, SpoolOpenRefused }\nfn f() -> String {\n  match spool_open_uid(kind: SpoolComputeExit, instance_root: \"/tmp/compute/root\", uid: 1000) {\n    SpoolOpenReady { store: _ } => \"ready\"\n    SpoolOpenRefused { cause: _ } => \"refused\"\n  }\n}\n"

test fn a_forged_key_cannot_defer_an_entry() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_defer_source, subject: "SpoolEntryKey"), holds: fn(n) { n == 1 }))
}

test fn the_same_forged_defer_passes_against_the_seal_stripped_twin() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: twin_defer_source, subject: "SpoolEntryKey"), holds: fn(n) { n == 0 }))
}

test fn a_minted_key_defers_with_no_seal_violation() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: lawful_defer_source, subject: "SpoolEntryKey"), holds: fn(n) { n == 0 }))
}

test fn a_forged_entry_key_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_literal_source, subject: "SpoolEntryKey"), holds: fn(n) { n == 1 }))
}

test fn a_forged_entry_key_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_cast_source, subject: "SpoolEntryKey"), holds: fn(n) { n == 1 }))
}

test fn the_lawful_entry_key_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_mint_source, safe: baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_mint_source, subject: "SpoolEntryKey"), holds: fn(n) { n == 0 }),
  ])
}

// PARTITIONED SPOOL STORE SEAL (SpoolComputeExit, ByPrincipalUid). A foreign module cannot spell a partitioned
// store -- the ONLY mint is spool_open_uid (sealed), which requires a positive principal uid alongside the instance.
test fn a_foreign_module_cannot_construct_a_partitioned_spool_store() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_partitioned_store_source, subject: "SpoolStore"), holds: fn(n) { n == 1 }))
}

test fn a_foreign_module_cannot_construct_a_partitioned_spool_store_without_a_uid() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_partitioned_store_no_uid_source, subject: "SpoolStore"), holds: fn(n) { n == 1 }))
}

// STRIPPED TWIN: the identical forged literal, over the unsealed fixture's SpoolStore (same field names and
// types, sole_constructor removed), is admitted -- so the refusal above is the keyword, not the shape or the uid.
test fn the_same_forged_partitioned_store_passes_against_the_seal_stripped_twin() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: twin_partitioned_store_source, subject: "SpoolStore"), holds: fn(n) { n == 0 }))
}

// MINTED CONTROL: a store produced by the business-key mint spool_open_uid carries no seal violation.
test fn a_minted_partitioned_store_has_no_seal_violation() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: minted_partitioned_store_source, subject: "SpoolStore"), holds: fn(n) { n == 0 }))
}

test fn a_claim_over_a_pending_entry_is_eligible() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RolePending }) {
    ClaimEligible { from: _, into: _ } => ExitSuccess
    ClaimAlreadyClaimed => exit_failure(reason: "a pending entry reads as already claimed")
    ClaimAbsent => exit_failure(reason: "a pending entry reads as absent")
    ClaimTerminal { state: _ } => exit_failure(reason: "a pending entry reads as terminal")
    ClaimRefused { detail: _ } => exit_failure(reason: "a pending entry is refused")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "a pending entry reads as undeclared")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
    ClaimParked { role: _ } => exit_failure(reason: "the entry reads as parked")
  }
}

test fn enqueue_over_absent_is_eligible_and_over_present_is_not() -> ProcessExit {
  match spool_enqueue_assess(kind: SpoolAttemptUnit, observed: EntryAbsent) {
    EnqueueEligible { into: _ } =>
      match spool_enqueue_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RolePending }) {
        EnqueueAlreadyPresent { state: _ } => ExitSuccess
        EnqueueEligible { into: _ } => exit_failure(reason: "a present entry is enqueueable again")
        _ => exit_failure(reason: "a present entry reads as refused")
      }
    _ => exit_failure(reason: "an absent entry is not enqueueable")
  }
}

test fn only_a_claimed_entry_completes() -> ProcessExit {
  match spool_complete_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RoleClaimed }, outcome: SpoolOutcomeDone) {
    CompleteEligible { into: _ } =>
      match spool_complete_assess(kind: SpoolAttemptExit, observed: EntryStanding { role: RolePending }, outcome: SpoolOutcomeDone) {
        CompleteEligible { into: _ } => exit_failure(reason: "a pending entry completes without a claim")
        _ => ExitSuccess
      }
    _ => exit_failure(reason: "a claimed entry does not complete")
  }
}

fn exit_inbox_writers_include(who: SpoolPrincipal) -> Bool {
  spool_role_writers(kind: SpoolAttemptExit, role: RolePending) |> any(w => w == who)
}

test fn the_exit_spool_inbox_is_written_by_the_hook_and_by_requeue_of_the_drainer() -> ProcessExit {
  if (exit_inbox_writers_include(who: PrincipalExternalHook) && exit_inbox_writers_include(who: PrincipalDrainer)) {
    ExitSuccess
  } else {
    exit_failure(reason: "the exit inbox writers are not the hook and the requeueing drainer")
  }
}

test fn a_role_the_spool_never_declared_is_refused_not_elected() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleHandedOff }) {
    ClaimRoleUndeclared { role: _ } => ExitSuccess
    ClaimEligible { from: _, into: _ } => exit_failure(reason: "an undeclared role was elected")
    _ => exit_failure(reason: "an undeclared role has the wrong refusal")
  }
}

test fn the_publication_spool_has_no_claim_and_refuses_one_typed() -> ProcessExit {
  match spool_claim_assess(kind: SpoolPublication, observed: EntryStanding { role: RolePending }) {
    ClaimNotRealized => ExitSuccess
    _ => exit_failure(reason: "a claim over the claimless publication spool was not refused")
  }
}

test fn the_unit_refusal_has_no_directory_so_completing_into_it_is_refused_typed() -> ProcessExit {
  match spool_complete_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleClaimed }, outcome: SpoolOutcomeRefused { cause: "x" }) {
    CompleteRoleUndeclared { role: _ } => ExitSuccess
    _ => exit_failure(reason: "a refusal into a role with no directory was admitted")
  }
}

test fn the_publication_refusal_retires_a_pending_request_in_place() -> ProcessExit {
  match spool_complete_assess(kind: SpoolPublication, observed: EntryStanding { role: RolePending }, outcome: SpoolOutcomeRefused { cause: "undecodable" }) {
    CompleteEligible { into: _ } => ExitSuccess
    _ => exit_failure(reason: "a pending publication request cannot be retired to requests-refused")
  }
}

test fn the_publication_entry_is_a_file_with_a_refused_directory_and_no_claimed_one() -> ProcessExit {
  if spool_entry_is_file(kind: SpoolPublication) && (!spool_role_dir_present(kind: SpoolPublication, role: RoleClaimed)) && spool_role_dir_present(kind: SpoolPublication, role: RoleRefused) {
    ExitSuccess
  } else {
    exit_failure(reason: "the publication spool disk shape is misdeclared")
  }
}

fn spool_entry_is_file(kind: SpoolKind) -> Bool {
  match spool_declaration(kind: kind).entry_kind {
    SpoolEntryDirectory => false
    SpoolEntryFile { wire_suffix: _ } => true
  }
}

fn spool_role_dir_present(kind: SpoolKind, role: SpoolRole) -> Bool {
  match spool_role_dir(kind: kind, role: role) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn the_publication_single_drainer_assumption_ends_when_a_second_drainer_appears() -> ProcessExit {
  if (!spool_needs_claim_stage(kind: SpoolPublication, drainers: 1)) && spool_needs_claim_stage(kind: SpoolPublication, drainers: 2) && (!spool_needs_claim_stage(kind: SpoolAttemptExit, drainers: 5)) {
    ExitSuccess
  } else {
    exit_failure(reason: "the second-drainer trigger does not fire for the agreement spool alone")
  }
}

test fn claim_realization_agrees_with_the_declared_exclusion() -> ProcessExit {
  let rename_spools_claim = !(spool_claim_assess(kind: SpoolAttemptExit, observed: EntryAbsent) == ClaimNotRealized)
  if rename_spools_claim && (spool_claim_assess(kind: SpoolPublication, observed: EntryAbsent) == ClaimNotRealized) && (spool_declaration(kind: SpoolPublication).exclusion != ExclusiveByRename) {
    ExitSuccess
  } else {
    exit_failure(reason: "a spool's claim stage disagrees with its declared exclusion")
  }
}

test fn a_lost_election_is_already_claimed_not_absent() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptUnit, observed: EntryStanding { role: RoleClaimed }) {
    ClaimAlreadyClaimed => ExitSuccess
    ClaimEligible { from: _, into: _ } => exit_failure(reason: "a claimed entry is claimable again")
    ClaimAbsent => exit_failure(reason: "a claimed entry reads as absent")
    ClaimTerminal { state: _ } => exit_failure(reason: "a claimed entry reads as terminal")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "undeclared role: a claimed entry reads as terminal")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
    ClaimParked { role: _ } => exit_failure(reason: "the entry reads as parked")
    ClaimRefused { detail: _ } => exit_failure(reason: "a claimed entry is refused")
  }
}

test fn an_entry_in_two_stages_is_refused_never_picked() -> ProcessExit {
  match spool_claim_assess(kind: SpoolAttemptUnit, observed: EntryAmbiguous { roles: [RolePending, RoleClaimed] }) {
    ClaimRefused { detail: _ } => ExitSuccess
    ClaimEligible { from: _, into: _ } => exit_failure(reason: "an ambiguous entry was claimed")
    ClaimAlreadyClaimed => exit_failure(reason: "an ambiguous entry was resolved to claimed")
    ClaimAbsent => exit_failure(reason: "an ambiguous entry was resolved to absent")
    ClaimTerminal { state: _ } => exit_failure(reason: "an ambiguous entry was resolved to terminal")
    ClaimRoleUndeclared { role: _ } => exit_failure(reason: "undeclared role: an ambiguous entry was resolved to terminal")
    ClaimNotRealized => exit_failure(reason: "claim reads as not realized")
    ClaimParked { role: _ } => exit_failure(reason: "the entry reads as parked")
  }
}

test fn an_unobservable_claimant_is_not_dead() -> ProcessExit {
  match spool_stale_assess(observed: EntryStanding { role: RoleClaimed }, liveness: ClaimantUnobservable { cause: "no unit status" }) {
    StaleRefused { cause: _ } => ExitSuccess
    StaleStopTheLine { evidence: _ } => exit_failure(reason: "an unobservable claimant licensed the line stop")
    StaleClaimantLive => exit_failure(reason: "an unobservable claimant read as live")
    StaleNotApplicable { state: _ } => exit_failure(reason: "a claimed entry was not applicable")
  }
}

test fn an_observed_dead_claimant_stops_the_line_and_is_not_reclaimed() -> ProcessExit {
  match spool_stale_assess(observed: EntryStanding { role: RoleClaimed }, liveness: ClaimantObservedDead { evidence: "invocation gone" }) {
    StaleStopTheLine { evidence: _ } => ExitSuccess
    StaleRefused { cause: _ } => exit_failure(reason: "an observed-dead claimant was refused")
    StaleClaimantLive => exit_failure(reason: "an observed-dead claimant read as live")
    StaleNotApplicable { state: _ } => exit_failure(reason: "a claimed entry was not applicable")
  }
}

