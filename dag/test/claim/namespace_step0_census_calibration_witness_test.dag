module test.claim.namespace_step0_census_calibration_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.process { ProcessExit, exit_failure }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.occurrence_identity {
  OccurrenceCategory,
  LexicalValueOccurrence,
  TypeOccurrence,
  CallableOccurrence,
  ConstructorOccurrence,
  NamespaceSegmentOccurrence,
  FieldOccurrence,
  MethodOccurrence
}
import tools.multi_module_compile_fixture { FixtureSource, fixture_source }
import tools.reference_occurrence_binding_census {
  ReferenceOccurrenceBindingCensus,
  ReferenceOccurrenceBindingCensusObserved,
  ReferenceOccurrenceBindingCensusRefused,
  ReferenceOccurrenceBindingRow,
  ReferenceOccurrenceBindingDisposition,
  ReferenceOccurrenceBound,
  ReferenceOccurrenceUnresolved,
  ReferenceOccurrenceAmbiguous,
  ReferenceOccurrenceBindingRefused,
  OccurrenceEntryRow,
  OccurrenceEntryRole,
  EntryAdmittedAsReference,
  EntryClassifiedAsDeclaration,
  EntryCarriesNoRole,
  reference_occurrence_binding_census
}
import gunbc.compile_clean_diagnostic_policy {
  UnlistedImportBindingSource,
  ListedImport,
  PoolCoincidence,
  DefinerResolvable
}
import gunbc.namespace_step0_census_calibration {
  Step0CalibrationStanding,
  CalibrationRosterIncomplete,
  CalibrationBlindToFamilies,
  CalibrationCappedByConvergence,
  CalibrationDiscriminatesEveryFamily,
  step0_calibration_standing,
  step0_occurrence_category_label,
  step0_unclaimed_producer_branches,
  step0_uncalibrated_families,
  step0_unit_mapping_disagreements,
  step0_rows_claiming_observed_outcome,
  step0_rows_with_uncalibrated_outcome
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THIS FILE ESTABLISHES, AND IT IS A NEGATIVE RESULT. The candidate reference-occurrence
// producer's coverage of the family roster was recorded as UNESTABLISHED. It is now REFUTED, by
// execution, on a hand-authored subject: two families produce no denominator row at all, and a thing
// that is not a reference produces one. Both directions of error are here, and they do not cancel.
//
// EVERY BYTE OF THE SUBJECT IS FIXTURE-OWNED, so no corpus rename can turn a control green while the
// instrument is broken, and the pool is exactly this manifest -- the instrument consults no module
// index. CalMiddle exists ONLY in pattern position on purpose: CalLeft appears in an expression too,
// so a control asserting "no row for CalLeft" would be false for the wrong reason.
data cal_provider: String = "module cal.provider\n\nfn cal_two_named(zalpha: Int, zbeta: Int) -> Int { 0 }\n\nfn cal_apply2(f: fn(Int, Int) -> Int) -> Int { f(1, 2) }\n\ntype CalOnlyGeneric { z: Int }\n\ntype CalPayload { n: Int }\n\ntype CalChoice\n  = CalLeft\n  | CalMiddle\n  | CalRight { n: Int }\n\ndata cal_top_value: Int = 7\n\nfn cal_called(n: Int) -> Int { n }\n"

data cal_entry: String = "module cal.entry\n\nimport cal.provider { cal_apply2, CalOnlyGeneric, CalPayload, CalChoice, CalLeft, CalMiddle, CalRight, cal_top_value, cal_called }\n\ntype CalHolder { field: CalPayload }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\ntype CalLocalArg { w: Int }\n\ntype CalLocalBox { cells: List<CalLocalArg> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(c: CalChoice) -> Int {\n  match c {\n    CalLeft => 0\n    CalMiddle => 1\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zalpha: 1, zbeta: 2) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

// THE PERTURBED SUBJECT, AND IT IS WHAT TURNS "I FOUND NO ROW" INTO "THERE IS NO ROW". It is the
// same fixture with CalMiddle removed from the coproduct, from the import list and from the match --
// every appearance of one variant, deleted. If a variant in pattern position produced an occurrence,
// or if a name in an import list did, this subject MUST observe fewer of them than the one above.
// The two counts are compared by the control below. An absence read off a single run is an
// observation; an absence that survives a perturbation which had to move it is a control.
data cal_provider_without_middle: String = "module cal.provider\n\nfn cal_two_named(zalpha: Int, zbeta: Int) -> Int { 0 }\n\nfn cal_apply2(f: fn(Int, Int) -> Int) -> Int { f(1, 2) }\n\ntype CalOnlyGeneric { z: Int }\n\ntype CalPayload { n: Int }\n\ntype CalChoice\n  = CalLeft\n  | CalRight { n: Int }\n\ndata cal_top_value: Int = 7\n\nfn cal_called(n: Int) -> Int { n }\n"

data cal_entry_without_middle: String = "module cal.entry\n\nimport cal.provider { cal_apply2, CalOnlyGeneric, CalPayload, CalChoice, CalLeft, CalRight, cal_top_value, cal_called }\n\ntype CalHolder { field: CalPayload }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\ntype CalLocalArg { w: Int }\n\ntype CalLocalBox { cells: List<CalLocalArg> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(c: CalChoice) -> Int {\n  match c {\n    CalLeft => 0\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zalpha: 1, zbeta: 2) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

data cal_entry_reordered_imports: String = "module cal.entry\n\nimport cal.provider { cal_apply2, cal_called, cal_top_value, CalRight, CalMiddle, CalLeft, CalChoice, CalPayload, CalOnlyGeneric }\n\ntype CalHolder { field: CalPayload }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\ntype CalLocalArg { w: Int }\n\ntype CalLocalBox { cells: List<CalLocalArg> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(c: CalChoice) -> Int {\n  match c {\n    CalLeft => 0\n    CalMiddle => 1\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zalpha: 1, zbeta: 2) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

data cal_entry_renamed_binder: String = "module cal.entry\n\nimport cal.provider { cal_apply2, CalOnlyGeneric, CalPayload, CalChoice, CalLeft, CalMiddle, CalRight, cal_top_value, cal_called }\n\ntype CalHolder { field: CalPayload }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\ntype CalLocalArg { w: Int }\n\ntype CalLocalBox { cells: List<CalLocalArg> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(scrutinee: CalChoice) -> Int {\n  match scrutinee {\n    CalLeft => 0\n    CalMiddle => 1\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zalpha: 1, zbeta: 2) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

data cal_entry_reordered_declarations: String = "module cal.entry\n\nimport cal.provider { cal_apply2, CalOnlyGeneric, CalPayload, CalChoice, CalLeft, CalMiddle, CalRight, cal_top_value, cal_called }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalHolder { field: CalPayload }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\ntype CalLocalArg { w: Int }\n\ntype CalLocalBox { cells: List<CalLocalArg> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(c: CalChoice) -> Int {\n  match c {\n    CalLeft => 0\n    CalMiddle => 1\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zalpha: 1, zbeta: 2) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

fn cal_rows_of(entry_source: String) -> List<ReferenceOccurrenceBindingRow> {
  match reference_occurrence_binding_census(
    sources: [fixture_source("cal/provider.dag", cal_provider), fixture_source("cal/entry.dag", entry_source)],
    entry: "cal/entry.dag" as NonEmptyStr
  ) {
    ReferenceOccurrenceBindingCensusRefused { cause: _ } => []
    ReferenceOccurrenceBindingCensusObserved { source_digest: _, compiler_digest: _, entries: _, denominator: _, observations: observations } => observations
  }
}

data cal_entry_swapped_arguments: String = "module cal.entry\n\nimport cal.provider { cal_apply2, CalOnlyGeneric, CalPayload, CalChoice, CalLeft, CalMiddle, CalRight, cal_top_value, cal_called }\n\ntype CalHolder { field: CalPayload }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\ntype CalLocalArg { w: Int }\n\ntype CalLocalBox { cells: List<CalLocalArg> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(c: CalChoice) -> Int {\n  match c {\n    CalLeft => 0\n    CalMiddle => 1\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zbeta: 2, zalpha: 1) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

data cal_entry_without_local_declarations: String = "module cal.entry\n\nimport cal.provider { cal_apply2, CalOnlyGeneric, CalPayload, CalChoice, CalLeft, CalMiddle, CalRight, cal_top_value, cal_called }\n\ntype CalHolder { field: CalPayload }\n\ntype CalBox { items: List<CalPayload> }\n\ntype CalGenericBox { slots: List<CalOnlyGeneric> }\n\nfn cal_uses_call() -> Int { cal_called(n: 1) }\n\nfn cal_uses_top_value() -> Int { cal_top_value }\n\nfn cal_nullary() -> CalChoice { CalLeft }\n\nfn cal_payload() -> CalChoice { CalRight { n: 2 } }\n\nfn cal_pattern(c: CalChoice) -> Int {\n  match c {\n    CalLeft => 0\n    CalMiddle => 1\n    CalRight { n: n } => n\n  }\n}\n\nfn cal_fn_value() -> Int { cal_called }\n\nfn cal_qualified() -> CalChoice { CalChoice.CalLeft }\n\n\nfn cal_calls_two() -> Int { cal_two_named(zalpha: 1, zbeta: 2) }\n\nfn cal_lambda_two() -> Int { cal_apply2(f: (zacc, zitem) => zacc) }"

// THE IDENTITY OF AN OBSERVATION, FOR THE PURPOSE OF COMPARING TWO SUBJECTS. Occurrence ids are
// graph-scoped, so they cannot be joined across two compilations, and spans move under exactly the
// transformations these invariants apply. What survives both is the authored spelling paired with
// the category the instrument stamped it -- which is also what a reader of the census consumes.
// Comparison is over the MULTISET of those keys, so a substitution fails even when the totals agree.
fn cal_row_key(row: ReferenceOccurrenceBindingRow) -> String {
  concat(row.authored_name, concat(":", step0_occurrence_category_label(category: row.category) as String))
}

// EACH CLAIM COMPILES EACH SUBJECT ONCE. These take the rows a claim already has rather than an
// entry source, so a control that compares two subjects performs two compiles and not six -- the
// repeated demand had one shared-state ancestor and was authored duplication (DESIGN section 2).
fn cal_keys_from(rows: List<ReferenceOccurrenceBindingRow>) -> List<String> {
  rows |> map(row => cal_row_key(row: row))
}

fn cal_key_mentions(key: String, a: String, b: String) -> Bool {
  string_contains(key, a) || string_contains(key, b)
}

fn cal_key_multiplicity(keys: List<String>, key: String) -> Int {
  count(keys |> filter(candidate => candidate == key))
}

fn cal_key_sets_agree(left: List<String>, right: List<String>) -> Bool {
  count(left) == count(right)
    && count(left |> filter(key =>
         cal_key_multiplicity(keys: left, key: key) != cal_key_multiplicity(keys: right, key: key)
       )) == 0
    && count(right |> filter(key =>
         cal_key_multiplicity(keys: left, key: key) != cal_key_multiplicity(keys: right, key: key)
       )) == 0
}

// ADDITION IS ADDITIVE, WHICH IS THE ONLY FORM OF INVARIANT D THAT IS SOUND HERE. Every key present
// before must still be present after, at least as often. Growth is permitted -- an added declaration
// legitimately contributes occurrences, and some of them are spelled with names the subject already
// used, `List` and `Int` among them -- but LOSS and SUBSTITUTION are not.
fn cal_key_set_covers(before: List<String>, after: List<String>) -> Bool {
  count(before |> filter(key =>
    cal_key_multiplicity(keys: after, key: key) < cal_key_multiplicity(keys: before, key: key)
  )) == 0
}

fn cal_manifest_without_middle() -> List<FixtureSource> {
  [
    fixture_source("cal/provider.dag", cal_provider_without_middle),
    fixture_source("cal/entry.dag", cal_entry_without_middle)
  ]
}

fn cal_denominator_size_without_middle() -> Int {
  match reference_occurrence_binding_census(sources: cal_manifest_without_middle(), entry: "cal/entry.dag" as NonEmptyStr) {
    ReferenceOccurrenceBindingCensusRefused { cause: _ } => 0
    ReferenceOccurrenceBindingCensusObserved { source_digest: _, compiler_digest: _, entries: _, denominator: denominator, observations: _ } => count(denominator)
  }
}

fn cal_manifest() -> List<FixtureSource> {
  [
    fixture_source("cal/provider.dag", cal_provider),
    fixture_source("cal/entry.dag", cal_entry)
  ]
}

fn cal_census() -> ReferenceOccurrenceBindingCensus {
  reference_occurrence_binding_census(sources: cal_manifest(), entry: "cal/entry.dag" as NonEmptyStr)
}

fn cal_observations() -> List<ReferenceOccurrenceBindingRow> {
  match cal_census() {
    ReferenceOccurrenceBindingCensusRefused { cause: _ } => []
    ReferenceOccurrenceBindingCensusObserved { source_digest: _, compiler_digest: _, entries: _, denominator: _, observations: observations } => observations
  }
}

fn cal_denominator_size() -> Int {
  match cal_census() {
    ReferenceOccurrenceBindingCensusRefused { cause: _ } => 0
    ReferenceOccurrenceBindingCensusObserved { source_digest: _, compiler_digest: _, entries: _, denominator: denominator, observations: _ } => count(denominator)
  }
}

fn cal_rows_named(spelling: String) -> List<ReferenceOccurrenceBindingRow> {
  cal_observations() |> filter(row => row.authored_name == spelling)
}

fn cal_rows_named_in_category(spelling: String, category: OccurrenceCategory) -> List<ReferenceOccurrenceBindingRow> {
  cal_rows_named(spelling: spelling) |> filter(row =>
    (step0_occurrence_category_label(category: row.category) as String)
      == (step0_occurrence_category_label(category: category) as String)
  )
}

fn cal_binding_source_label(source: UnlistedImportBindingSource) -> String {
  match source {
    ListedImport => "listed-import"
    PoolCoincidence => "pool-coincidence"
    DefinerResolvable => "definer-resolvable"
  }
}

fn cal_binding_source_of(disposition: ReferenceOccurrenceBindingDisposition) -> String {
  match disposition {
    ReferenceOccurrenceBound { declaration_occurrence: _, provider_module: _, binding_source: source } =>
      cal_binding_source_label(source: source)
    ReferenceOccurrenceUnresolved => "none"
    ReferenceOccurrenceAmbiguous { candidates: _ } => "none"
    ReferenceOccurrenceBindingRefused { cause: _ } => "none"
  }
}

fn cal_disposition_label(disposition: ReferenceOccurrenceBindingDisposition) -> String {
  match disposition {
    ReferenceOccurrenceBound { declaration_occurrence: _, provider_module: provider, binding_source: source } =>
      concat("bound:", concat(provider as String, concat(":", cal_binding_source_label(source: source))))
    ReferenceOccurrenceUnresolved => "unresolved"
    ReferenceOccurrenceAmbiguous { candidates: _ } => "ambiguous"
    ReferenceOccurrenceBindingRefused { cause: _ } => "refused"
  }
}

fn cal_row_line(row: ReferenceOccurrenceBindingRow) -> String {
  concat(
    concat(row.consumer_file as String, concat(" ", row.authored_name)),
    concat(
      concat(" ", step0_occurrence_category_label(category: row.category) as String),
      concat(" ", cal_disposition_label(disposition: row.disposition))
    )
  )
}

// THE INSTRUMENT THAT RE-DERIVES THE TABLE, an entry point rather than a transcribed list, because a
// number copied into prose is unreachable from the thing that owns it and rots without anyone
// touching either end (DESIGN section 6). Run it with
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/test/claim/namespace_step0_census_calibration_witness_test.dag \
//     --function step0_calibration_probe
// It renders one line per observed reference occurrence and exits NONZERO, because a probe that
// exited 0 would be reporting a verdict it never reached.
fn cal_entries() -> List<OccurrenceEntryRow> {
  match cal_census() {
    ReferenceOccurrenceBindingCensusRefused { cause: _ } => []
    ReferenceOccurrenceBindingCensusObserved { source_digest: _, compiler_digest: _, entries: entries, denominator: _, observations: _ } => entries
  }
}

fn cal_entry_role_label(role: OccurrenceEntryRole) -> String {
  match role {
    EntryAdmittedAsReference => "admitted-as-reference"
    EntryClassifiedAsDeclaration => "classified-as-declaration"
    EntryCarriesNoRole => "carries-no-role"
  }
}

fn cal_entries_named(spelling: String) -> List<OccurrenceEntryRow> {
  cal_entries() |> filter(entry => entry.authored_name == spelling)
}

fn cal_entry_line(entry: OccurrenceEntryRow) -> String {
  concat(
    concat(entry.entry_file as String, concat(" ", entry.authored_name)),
    concat(" ", cal_entry_role_label(role: entry.role))
  )
}

// THE ENTRIES PROBE. The controls below read the `references` view; this one reads the population
// that view is filtered from, so an absence can be attributed. Run it with --function
// step0_entries_probe. It exits NONZERO for the same reason the row probe does.
fn step0_entries_probe() -> ProcessExit {
  exit_failure(reason: concat(
    concat("entries=", to_string(count(cal_entries()))),
    concat("\n", join(cal_entries() |> map(entry => cal_entry_line(entry: entry)), "\n"))
  ))
}

fn step0_calibration_probe() -> ProcessExit {
  match cal_census() {
    ReferenceOccurrenceBindingCensusRefused { cause: cause } =>
      exit_failure(reason: concat("census refused: ", cause as String))
    ReferenceOccurrenceBindingCensusObserved { source_digest: _, compiler_digest: _, entries: _, denominator: denominator, observations: observations } =>
      exit_failure(reason: concat(
        concat("denominator=", concat(to_string(count(denominator)), concat(" observations=", to_string(count(observations))))),
        concat("\n", join(observations |> map(row => cal_row_line(row: row)), "\n"))
      ))
  }
}

// ---------------------------------------------------------------------------
// CONTROL 0, FIRST, BECAUSE EVERY ABSENCE CONTROL BELOW IS VACUOUS WITHOUT IT. An instrument that
// refused, or that saw nothing, answers "no row for CalRight" exactly as a blind one does. So the
// subject is established as OBSERVED and nonempty before any absence is read as a finding, and the
// positive control is a spelling the instrument demonstrably does emit.
test fn the_instrument_observed_this_subject_and_is_not_silent() -> Bool {
  cal_denominator_size() > 0
    && count(cal_observations()) == cal_denominator_size()
    && count(cal_rows_named(spelling: "CalChoice")) > 0
}

// CONTROL 1. A PAYLOAD CONSTRUCTOR IN EXPRESSION POSITION PRODUCES NO OCCURRENCE. `CalRight { n: 2 }`
// is authored in the fixture and the instrument emits nothing for it -- while the type in the
// surrounding signature DOES get a row, which is why a reader glancing at nearby rows would conclude
// the construction was seen. This is a family the census is blind to, not one it measures coarsely.
test fn a_payload_constructor_in_expression_position_produces_no_occurrence() -> Bool {
  count(cal_rows_named(spelling: "CalRight")) == 0
}

// CONTROL 2. A VARIANT IN PATTERN POSITION PRODUCES NO OCCURRENCE. CalMiddle is authored ONLY inside
// a match arm, so its absence cannot be explained by anything else in the subject. The scrutinee and
// the payload binder each produce a row, so the arm is represented in the denominator by everything
// except the name that selects it.
test fn a_variant_in_pattern_position_produces_no_occurrence() -> Bool {
  count(cal_rows_named(spelling: "CalMiddle")) == 0
}

// CONTROL 3, THE POSITIVE ONE THAT MAKES CONTROLS 1 AND 2 MEAN SOMETHING, and it answers the
// acquisition-path question by measurement rather than by reading the walk. ONE spelling, cal_called,
// appears twice in the same file: once in call-head position and once as a bare value. The instrument
// stamps the first CallableOccurrence and the second LexicalValueOccurrence. So the walk does
// separate acquisition path -- and an instrument that separates that while emitting nothing for a
// payload constructor is discriminating, not uniformly coarse.
test fn a_call_head_and_a_bare_function_value_are_stamped_differently() -> Bool {
  count(cal_rows_named_in_category(spelling: "cal_called", category: CallableOccurrence)) == 1
    && count(cal_rows_named_in_category(spelling: "cal_called", category: LexicalValueOccurrence)) == 1
}

// CONTROL 4. THE DENOMINATOR IS WRONG IN THE OTHER DIRECTION TOO. The label of a named argument --
// the `n` in `cal_called(n: 1)` -- is emitted as a reference occurrence and stamped
// CallableOccurrence, though it names a parameter of the callee and refers to no declaration. So the
// population is short some real occurrences and long some invented ones at the same time, and the
// two errors are over different populations and cannot cancel.
test fn a_named_argument_label_is_emitted_as_a_reference_occurrence() -> Bool {
  count(cal_rows_named_in_category(spelling: "n", category: CallableOccurrence)) > 0
}

// CONTROL 5. A NULLARY CONSTRUCTOR IS NOT STAMPED ConstructorOccurrence. `CalLeft` in expression
// position comes back LexicalValueOccurrence, in the same bucket as a top-level data reference and a
// bare function value -- so four authored families share one observation key and ConstructorOccurrence
// is stamped for nothing in this subject.
test fn a_nullary_constructor_is_stamped_as_a_lexical_value() -> Bool {
  count(cal_rows_named_in_category(spelling: "CalLeft", category: LexicalValueOccurrence)) > 0
    && count(cal_rows_named_in_category(spelling: "CalLeft", category: ConstructorOccurrence)) == 0
}

// CONTROL 6. ONE AUTHORED QUALIFIED REFERENCE BECOMES TWO OCCURRENCES UNDER TWO CATEGORIES, and
// neither is a namespace segment: `CalChoice.CalLeft` emits the container head as a lexical value and
// the member as a FIELD. A per-occurrence figure over this family is therefore not a count of
// authored references, which is a multiplicity fact the outcome axis alone would never surface.
test fn a_qualified_containment_reference_is_split_into_two_occurrences() -> Bool {
  count(cal_rows_named_in_category(spelling: "CalLeft", category: FieldOccurrence)) == 1
    && count(cal_rows_named_in_category(spelling: "CalChoice", category: NamespaceSegmentOccurrence)) == 0
}

// ---------------------------------------------------------------------------
// THE ROSTER-TOTALITY CONTROLS, which need no compile: they join the branch roster to the matrix and
// the family roster to the matrix, by identity rather than by count. A branch added with no row
// claiming it, or a family added with no row authoring an occurrence of it, goes red here.
test fn every_producer_branch_is_claimed_by_a_calibration_row() -> Bool {
  count(step0_unclaimed_producer_branches()) == 0
}

test fn every_reference_family_is_claimed_by_a_calibration_row() -> Bool {
  count(step0_uncalibrated_families()) == 0
}

// AND THE STANDING REPORTS BLINDNESS BEFORE CONVERGENCE. Two families are not observed at all, six
// converge onto a shared observation key, and two are discriminated. The arm matters more than the
// counts: CalibrationBlindToFamilies and CalibrationCappedByConvergence are different claims, and
// only the second can be reported as coverage at any grain -- a converged family is counted in the
// wrong bucket, an unobserved family is not counted anywhere. If this file's controls above ever
// flip because the producer was repaired, THIS is the assertion that goes red and names the table
// row to correct; it is a join to the instrument, not a snapshot of it.
test fn the_calibration_standing_reports_blindness_rather_than_coverage() -> Bool {
  match step0_calibration_standing() {
    CalibrationBlindToFamilies {
      unobserved_family_count: unobserved,
      converged_family_count: converged,
      discriminated_family_count: discriminated,
      unauthorable_branch_count: unauthorable,
      denominator_defect_count: defects
    } => unobserved == 3 && converged == 4 && discriminated == 3 && unauthorable == 2 && defects == 5
    CalibrationCappedByConvergence { converged_family_count: _, discriminated_family_count: _, unauthorable_branch_count: _, capability: _ } => false
    CalibrationDiscriminatesEveryFamily { unauthorable_branch_count: _ } => false
    CalibrationRosterIncomplete { unclaimed_branches: _, uncalibrated_families: _ } => false
  }
}

// THE PERTURBATION CONTROL. Removing every appearance of one variant -- its declaration, its
// import-list entry and its match arm -- changes the observed occurrence count by ZERO. A variant in
// pattern position and a name in an import list therefore produce no occurrence, established by a
// change that HAD to move the number if they did, rather than by not finding them in one listing.
// Both counts are nonzero, so this is not two silences agreeing.
test fn removing_a_variant_entirely_does_not_change_the_occurrence_count() -> Bool {
  cal_denominator_size() > 0
    && cal_denominator_size_without_middle() > 0
    && cal_denominator_size() == cal_denominator_size_without_middle()
}

// THE TWO AUTHORED TABLES ABOUT ONE INSTRUMENT MUST AGREE. A family the observation table calls
// blind must map to zero occurrences per authored reference, and a family it calls observed must map
// to at least one. Without this join they are a meaning fork waiting to drift.
test fn the_observation_table_and_the_unit_mapping_agree() -> Bool {
  count(step0_unit_mapping_disagreements()) == 0
}

// CONTROL 13, FILED BY REVIEW 59402 AND WIDENED BY MEASURING RATHER THAN READING. The matrix claimed
// QualifiedContainmentReference calibrates the definer-resolvable branch. It cannot: the instrument
// selects that branch only for an authored spelling carrying a dot, and control 7 already
// established that `CalChoice.CalLeft` reaches the census as TWO occurrences, `CalChoice` and
// `CalLeft`, neither of which carries one. So the branch is unreachable from this subject and the
// row's outcome column was unfalsifiable. This control checks the disposition the pair ACTUALLY
// carries, which is the check whose absence let the wrong claim stand.
test fn the_qualified_pair_carries_no_definer_resolvable_disposition() -> Bool {
  count(cal_observations() |> filter(row => cal_disposition_label(disposition: row.disposition) == "unresolved"
    && (row.authored_name == "CalChoice" || row.authored_name == "CalLeft"))) > 0
    && count(cal_observations() |> filter(row =>
        cal_binding_source_of(disposition: row.disposition) == "definer-resolvable")) == 0
}

// CONTROL 14, THE GENERAL FORM OF CONTROL 13, so the next overstated row goes red without a reviewer
// finding it. Every row whose outcome column claims a disposition must claim a branch the fixture
// run actually exercises. The fixture exercises the pool-coincidence and unresolved branches and no
// other, which is why only three of the seventeen family rows carry an observed outcome.
test fn every_observed_outcome_claims_a_branch_the_run_exercises() -> Bool {
  count(step0_rows_claiming_observed_outcome()) == 3
    && count(step0_rows_with_uncalibrated_outcome()) == 14
    && count(cal_observations() |> filter(row =>
        cal_binding_source_of(disposition: row.disposition) == "pool-coincidence")) > 0
    && count(cal_observations() |> filter(row =>
        cal_disposition_label(disposition: row.disposition) == "unresolved")) > 0
    && count(cal_observations() |> filter(row =>
        cal_binding_source_of(disposition: row.disposition) == "listed-import")) == 0
    && count(cal_observations() |> filter(row =>
        cal_disposition_label(disposition: row.disposition) == "ambiguous")) == 0
}

// CONTROL 15, AND THE SPELLING IT USES IS THE WHOLE POINT. A generic ARGUMENT produces no reference
// occurrence; the generic HEAD produces one. `CalLocalArg` is declared in the CONSUMER module and
// appears in exactly one authored position, inside `List<CalLocalArg>` -- so it is in no import list,
// no annotation, and no pattern, and nothing in the subject can stand in for it in either direction.
//
// An earlier version of this control used `CalOnlyGeneric`, which is IMPORTED, and it reported the
// opposite. That row was the import list, not the argument (control 16). The `List` count is the
// other half: the head is admitted from the same declaration, so the zero is the argument position
// and not a declaration the walk skipped.
test fn a_generic_type_argument_produces_no_occurrence() -> Bool {
  count(cal_rows_named(spelling: "CalLocalArg")) == 0
    && count(cal_rows_named_in_category(spelling: "List", category: TypeOccurrence)) > 0
}

// CONTROL 16, A FABRICATED ROW, AND THE SECOND ONE THIS SUBJECT CARRIES. The FIRST name in an import
// list is emitted as a reference occurrence; every later name in the same list carries no role. An
// import-list entry is not a use site, so the row refers to nothing. Control 5 records a second row
// that refers to nothing, the named-argument label. Whether the two share a cause is NOT asserted
// here: a common-cause story would have to come from the rule the walk actually applies, and until
// that rule is written and discriminated, collapsing them would hide the possibility that one is
// positional and the other is about construct kind -- which are different repairs.
//
// It is checked by PERTURBATION rather than by reading one listing, because a claim about list
// POSITION cannot be established from a single arrangement. `CalOnlyGeneric` was authored at the
// head of the entry's import list, ahead of `CalPayload`, which used to hold that position. The
// admitted row moved with the position: `CalOnlyGeneric` gained one and `CalPayload` lost the one it
// had, while neither name's authored USES changed at all. Both counts are nonzero somewhere in the
// subject, so this is not two silences agreeing.
test fn only_the_head_of_an_import_list_is_emitted_as_a_reference() -> Bool {
  count(cal_rows_named_in_category(spelling: "CalOnlyGeneric", category: TypeOccurrence)) == 1
    && count(cal_rows_named(spelling: "CalLocalArg")) == 0
    && count(cal_rows_named(spelling: "CalMiddle")) == 0
}

// ---------------------------------------------------------------------------
// THE METAMORPHIC INVARIANTS. Each changes something that MUST NOT MATTER and asserts the
// measurement does not move. They need no oracle: nobody has to know the right denominator, only
// that it cannot depend on this. That makes them stronger than any fixture whose expected numbers
// were authored by the same person who authored the instrument's reading, and it is how control 16's
// fabrication was found rather than reasoned about.

// A CARDINALITY ASSERTION IS BLIND TO SUBSTITUTION, WHEREVER IT APPEARS. It fails on a safe addition
// and passes on an unsafe swap, so it is the wrong shape for every completeness question in this
// lane -- the contract's roster check and the invariants below are the same defect at two layers,
// and so is every figure this census eventually publishes. These four are therefore stated over
// IDENTITY SETS. Each changes something that MUST NOT MATTER and asserts the identities do not move;
// none needs an oracle, because a semantics-preserving transformation supplies its own.

// INVARIANT A -- AND IT DOES NOT HOLD, WHICH IS WHY IT IS ASSERTED IN ITS BROKEN FORM. Reordering an
// import list is meaning-preserving, so the identity set must not move. It moves -- and the SIZE
// does not, which is exactly why the cardinality version of this invariant would have passed clean
// over the fabrication it exists to catch. What changes is WHICH NAME HOLDS THE ROW: the head of the
// list is emitted as a reference and the rest are not, so putting a different name first hands the
// row to that name and takes it from the one that had it, with no authored use changed.
//
// Asserting the invariant here would put a permanent red in CI, reporting nothing the defect roster
// does not carry. Asserting the DEFECT keeps the property executing and makes the repair visible:
// this control reds the day the fabrication is fixed and is then INVERTED to the invariant it was
// always meant to be. That inversion is its dissolution condition, and it is the DESIGN 4b(4) rule
// that a discriminating RED stays enrolled rather than retiring on the climb.
test fn reordering_an_import_list_moves_which_name_holds_the_row_which_is_the_defect() -> Bool {
  let base = cal_rows_of(entry_source: cal_entry)
  let moved = cal_rows_of(entry_source: cal_entry_reordered_imports)
  (cal_key_sets_agree(left: cal_keys_from(rows: base), right: cal_keys_from(rows: moved)) == false)
    && count(moved) == count(base)
    && count(base |> filter(row => row.authored_name == "CalOnlyGeneric")) == 1
    && count(moved |> filter(row => row.authored_name == "CalOnlyGeneric")) == 0
}

// INVARIANT B, OVER IDENTITIES. Renaming a binder consistently -- the parameter and every use of it
// -- is meaning-preserving, so the key multiset must map bijectively with only the renamed keys
// differing: the two runs agree on every key mentioning neither name, and the total is unchanged.
test fn renaming_a_binder_consistently_disturbs_only_the_renamed_identities() -> Bool {
  let base = cal_rows_of(entry_source: cal_entry)
  let renamed = cal_rows_of(entry_source: cal_entry_renamed_binder)
  cal_key_sets_agree(
    left: cal_keys_from(rows: base) |> filter(key => cal_key_mentions(key: key, a: "c:", b: "scrutinee:") == false),
    right: cal_keys_from(rows: renamed) |> filter(key => cal_key_mentions(key: key, a: "c:", b: "scrutinee:") == false)
  )
    && count(renamed) == count(base)
    && count(base) > 0
}

// INVARIANT C, OVER IDENTITIES. Swapping two independent declarations is meaning-preserving, so the
// key multiset must be unchanged -- not merely the same size. This is the one that catches an
// ordinal or a running counter leaking into what gets admitted, which is invariant A's defect shape.
test fn reordering_independent_declarations_does_not_change_the_identity_set() -> Bool {
  let base = cal_rows_of(entry_source: cal_entry)
  let swapped = cal_rows_of(entry_source: cal_entry_reordered_declarations)
  cal_key_sets_agree(left: cal_keys_from(rows: base), right: cal_keys_from(rows: swapped))
    && count(base) > 0
}

// INVARIANT D, AND THE FIRST VERSION OF IT WAS WRONG -- THE CONTROL, NOT THE CENSUS. I stated it as
// "the keys mentioning neither added spelling agree exactly", ran it, and it went RED. The cause was
// mine: `type CalLocalBox { cells: List<CalLocalArg> }` legitimately contributes `List` and `Int`
// occurrences, and those spellings are shared with occurrences the subject already had, so an exact
// agreement on "other spellings" demanded that a real addition add nothing. That is the homonym trap
// of this file's own fixture law, committed a third time and in a property statement rather than an
// observation -- which is its own evidence that the law needs to govern how invariants are phrased,
// not only which spellings a fixture uses.
//
// The sound form needs no oracle and no count of what was added: addition is ADDITIVE. Every key
// present before is present after at least as often, so growth passes while LOSS and SUBSTITUTION
// fail. The strict size increase keeps it from being vacuous, and `CalLocalArg` contributing nothing
// is control 15 restated from the other side -- the added generic argument is admitted by nobody.
test fn adding_an_unreferenced_declaration_only_adds() -> Bool {
  let before = cal_rows_of(entry_source: cal_entry_without_local_declarations)
  let after = cal_rows_of(entry_source: cal_entry)
  cal_key_set_covers(before: cal_keys_from(rows: before), after: cal_keys_from(rows: after))
    && count(after) > count(before)
    && count(before) > 0
    && count(after |> filter(row => row.authored_name == "CalLocalArg")) == 0
}

// ---------------------------------------------------------------------------
// THE ROLE-CLASSIFICATION RULE, AND THIS IS THE CONTROL THAT DECIDES ONE HALF OF IT.
// `stamp_parsed_node_list_with_head_role` stamps `nodes.first()` with a head role and `skip(1)` with a
// tail role. A node's role is therefore the role its parent requested FOR ITS POSITION-CLASS -- head or
// tail -- and only when nothing was requested does the node's own ExprData variant decide, with every
// unnamed variant falling through to Unclassified. `index.entries` records all of them; the
// declarations and references views record only the classified.
//
// THE REQUESTING SITES, ENUMERATED RATHER THAN GENERALIZED, because an earlier version of this comment
// said "every caller passes tail = Unclassified" and "position one is privileged" -- both false, and
// both were universals asserted from three sites that happened to agree. `stamp_parsed_node_children`
// dispatches on ExprData and then, where that does not select, ON THE PARENT'S REQUESTED ROLE:
//   ExprCall                                 head Reference{Callable}  tail Unclassified
//   ExprLambda                               head Unclassified         tail Declaration{LexicalValue}
//   ExprLet                                  no head/tail: all Unclassified
//   requested Declaration{LexicalValue}      head Reference{Type}      tail Unclassified
//   requested Declaration{NamespaceSegment}  routed to module items
//   anything else                            all Unclassified
// So EITHER position-class may carry a non-Unclassified role, and the lambda arm is the exact inverse
// of the call arm. What survives is the mechanism -- role is a function of position-class and of the
// parent's request, not of the child's construct kind -- which the lambda arm CORROBORATES as a second
// independent instance while refuting the privileged-position spelling.
//
// The call arm passes head = Reference{CallableOccurrence}. That role is plainly meant for the
// callee, but the callee is the call NODE and is separately stamped by the ExprData clause, so the
// head role lands on the FIRST ARGUMENT. The prediction is therefore sharp and strange: in a call
// with two named arguments, the FIRST label carries a CallableOccurrence row and the second carries
// none -- and `zalpha` / `zbeta` are spellings that appear nowhere else in the subject.
//
// COUNTING THE ROWS WOULD NOT DECIDE IT, which is this file's own rule turned on its newest control.
// "one of two labels is admitted" is satisfied by a positional rule, by a first-declared-name rule,
// and by anything else that happens to admit exactly one. So the subject is PERTURBED: the two
// argument labels are swapped, changing nothing about meaning. If the rule is positional the row
// FOLLOWS THE POSITION and the other label now holds it; if it is bound to the name or to declaration
// order, the row FOLLOWS THE NAME and does not move. The assertion is on WHICH NAME HOLDS THE ROW.
test fn the_head_role_of_a_call_lands_on_whichever_argument_is_first() -> Bool {
  let base = cal_rows_of(entry_source: cal_entry)
  let swapped = cal_rows_of(entry_source: cal_entry_swapped_arguments)
  // LIVENESS FIRST, because every zero below is otherwise unreadable. A swapped subject that failed
  // to compile returns no rows at all, and "zalpha has no row" would then be true for the wrong
  // reason -- the same trap control 0 exists to close for the base subject. Both subjects must be
  // observed and nonempty, and the callee must be present in both, before any absence is read.
  count(base) > 0
    && count(swapped) > 0
    && count(base |> filter(row => row.authored_name == "cal_two_named")) == 1
    && count(swapped |> filter(row => row.authored_name == "cal_two_named")) == 1
    // THE ROW FOLLOWS THE POSITION, NOT THE NAME. Swapping the two labels is meaning-preserving, so
    // a name-bound or declaration-order-bound rule leaves the row where it was.
    && count(base |> filter(row => row.authored_name == "zalpha")) == 1
    && count(base |> filter(row => row.authored_name == "zbeta")) == 0
    && count(swapped |> filter(row => row.authored_name == "zbeta")) == 1
    && count(swapped |> filter(row => row.authored_name == "zalpha")) == 0
    && count(swapped) == count(base)
}

// AND THE ROW IT LANDS ON IS STAMPED CALLABLE, which is the half that makes it a FABRICATION rather
// than a mislabelled reference: an argument label names a parameter of the callee, so a row calling
// it a callable refers to nothing that exists at that site.
//
// The callee body is a literal on purpose. It was `{ zalpha }`, and that use is a GENUINE lexical
// reference -- so the spelling carried a second, legitimate row that stood in for the one this
// control asserts about, and the control went red against a census that was right. The fixture law
// again, and the fourth time in this lane that running a control refuted the claim it was written to
// confirm: `zalpha` must appear ONLY as a parameter declaration and as an argument label.
test fn the_admitted_argument_label_is_stamped_callable() -> Bool {
  count(cal_rows_named_in_category(spelling: "zalpha", category: CallableOccurrence)) == 1
    && count(cal_rows_named_in_category(spelling: "zalpha", category: LexicalValueOccurrence)) == 0
}

// THE LAMBDA ARM, MEASURED BECAUSE READING THE STAMPER COULD NOT DECIDE IT. `stamp_parsed_node_children`
// dispatches on the node's ExprData and, for a lambda, requests head = Unclassified with
// tail = Declaration{LexicalValueOccurrence} -- the INVERSE of the call arm, which requests
// head = Reference{CallableOccurrence} with tail = Unclassified. So the enumeration refutes any claim
// that position one is privileged or that every caller passes an Unclassified tail: three of the six
// arms leave the tail unclassified, one classifies it, one leaves everything unclassified, and one
// routes to module items. What survives is the mechanism itself -- role is requested per POSITION-CLASS,
// head or tail, and either may be non-Unclassified -- plus a second axis: where ExprData does not
// select, the PARENT'S REQUESTED ROLE selects how the children are dispatched.
//
// THE OPEN QUESTION THAT READING LEFT, AND IT HAD TWO VERY DIFFERENT ANSWERS. If a lambda's children
// are [param, param, body], then head = Unclassified means THE FIRST PARAMETER IS NEVER DECLARED --
// the call arm's off-by-one, one position over. If the head is something else, the arm is sound. The
// answer is that BOTH parameters carry declaration rows, so the tail role reaches both and the head is
// neither of them: the lambda arm is a second, INDEPENDENT instance of positional dispatch and NOT a
// defect. `zacc` and `zitem` appear nowhere else in the subject, and `zitem` is deliberately never used
// in the body, so its single declaration entry cannot be its own body reference standing in for it.
//
// This reads the ENTRIES population rather than the census rows, because a declaration never reaches
// the references view the census consumes -- which is why the rule could not be completed until the
// entries instrument existed.
test fn a_two_parameter_lambda_declares_both_parameters() -> Bool {
  let entries = cal_entries()
  count(entries) > 0
    && count(entries |> filter(e => e.authored_name == "zacc"
         && cal_entry_role_label(role: e.role) == "classified-as-declaration")) == 1
    && count(entries |> filter(e => e.authored_name == "zitem"
         && cal_entry_role_label(role: e.role) == "classified-as-declaration")) == 1
    && count(entries |> filter(e => e.authored_name == "zacc"
         && cal_entry_role_label(role: e.role) == "admitted-as-reference")) == 1
    && count(entries |> filter(e => e.authored_name == "zitem"
         && cal_entry_role_label(role: e.role) == "carries-no-role")) == 0
    && count(entries |> filter(e => e.authored_name == "zacc"
         && cal_entry_role_label(role: e.role) == "carries-no-role")) == 0
}
