module test.claim.srv3_sol_console_capture

import gunbc.srv3_sol_console_capture {
  srv3_sol_console_capture_log_path_is_declared,
  srv3_sol_console_capture_carries_dissolution_trigger,
}
import gunbc.srv3_sol_console_intent { srv3_sol_console_capture_intent }
import extdeps.bmc.serial_console {
  ObmcConsoleCli,
  RedfishSerialInterface,
  IpmiSol,
  extdeps_external_authority_anchor,
  redfish_serial_interface_authority,
  sol_console_transport_authority_for,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn srv3_sol_console_capture_intent_uses_obmc_cli() -> Bool {
  match srv3_sol_console_capture_intent.transport {
    ObmcConsoleCli => true
    RedfishSerialInterface => false
    IpmiSol => false
  }
    && srv3_sol_console_capture_log_path_is_declared()
    && srv3_sol_console_capture_carries_dissolution_trigger()
}

test fn sol_console_redfish_serial_transport_cites_dmtf_authority() -> Bool {
  sol_console_transport_authority_for(transport: RedfishSerialInterface) == redfish_serial_interface_authority
    && sol_console_transport_authority_for(transport: ObmcConsoleCli) == extdeps_external_authority_anchor
}
