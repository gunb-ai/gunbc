module test.claim.fleet_host_key_enrollment_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// Acceptance item 4: an empty registry answers none for every host (nothing enrolled
// means no expectation — the probe stays on the Unenrolled arm, never a fabricated
// Mismatch), and a known_hosts line renders exactly "endpoint keytype key".
test fn witness_empty_registry_yields_no_expectation_and_line_shape_is_exact() -> Bool {
  match gunbc.fleet_host_key_enrollment.enrolled_fingerprint_for(host: "srv5") {
    Present { value: _ } => length(gunbc.fleet_host_key_enrollment.fleet_host_key_enrollments) > 0
    Absent => length(gunbc.fleet_host_key_enrollment.fleet_host_key_enrollments) == 0
  }
    && gunbc.fleet_host_key_enrollment.known_hosts_line(k: gunbc.fleet_host_key_enrollment.KnownHostKeyRow {
      host: "srv5" as product.placement_supply.HostIdentity,
      endpoint: "192.168.1.222",
      key_type: "ssh-ed25519",
      public_key_base64: "AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKE",
      sha256_fingerprint: "SHA256:fakefake",
      provenance: gunbc.fleet_host_key_enrollment.ScannedFirstContact { scanned_from: "192.168.1.222 fixture" as std.types.NonEmptyStr },
    }) == "192.168.1.222 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKE"
}

// A registry row's fingerprint reaches the probe classifier as a Present expectation:
// with it, a host-key verification failure classifies Mismatch carrying that exact
// expected fingerprint; without it, the same wire stays Unenrolled — the enrollment is
// what moves a host between the two remedies.
test fn witness_enrolled_expectation_moves_wire_from_unenrolled_to_mismatch() -> Bool {
  match gunbc.host_reach_identity_probe.classify_reach_probe_wire_with_expectation(
    success: false,
    stdout: "",
    stderr: "Host key verification failed.",
    expected_fingerprint: gunbc.fleet_host_key_enrollment.enrolled_fingerprint_for(host: "srv5"),
  ) {
    gunbc.host_reach_identity_probe.ProbeHostKeyUnenrolled { transport_diagnostic: _ } => length(gunbc.fleet_host_key_enrollment.fleet_host_key_enrollments) == 0
    gunbc.host_reach_identity_probe.ProbeHostKeyMismatch { expected_fingerprint: _, observed_fingerprint: _ } => length(gunbc.fleet_host_key_enrollment.fleet_host_key_enrollments) > 0
    _ => false
  }
    && match gunbc.host_reach_identity_probe.classify_reach_probe_wire_with_expectation(
      success: false,
      stdout: "",
      stderr: "Host key verification failed.",
      expected_fingerprint: Present { value: "SHA256:enrolled" },
    ) {
      gunbc.host_reach_identity_probe.ProbeHostKeyMismatch { expected_fingerprint: e, observed_fingerprint: _ } => e == "SHA256:enrolled"
      _ => false
    }
}
