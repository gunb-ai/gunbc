module test.claim.altra_datasheet_supersession_witness_test

import std.types { Bool }
import extdeps.publication {
  HeldSpecificationSupersessionStanding, supersession_standing_is_current,
  HeldRevisionIsCurrentPublicCopy, NewerRevisionExistsUnretrieved, NewerRevisionPubliclyServed,
}
import extdeps.cpu.ampere {
  ampere_altra_max_rev_a1_datasheet_supersession_standing,
  ampere_altra_classic_rev_a1_datasheet_supersession_standing,
}

// EXECUTING EVIDENCE that the two datasheet citations say which revision they actually hold, and
// that the two standings DIFFER. A pair that agreed would be satisfied by a constant.

test fn w_the_altra_max_citation_declares_itself_superseded() -> Bool {
  !supersession_standing_is_current(s: ampere_altra_max_rev_a1_datasheet_supersession_standing)
}

test fn w_the_non_max_altra_citation_declares_itself_current() -> Bool {
  supersession_standing_is_current(s: ampere_altra_classic_rev_a1_datasheet_supersession_standing)
}

// THE DISCRIMINATION CONTROL. The two rows must not merely both exist; the predicate must separate
// them. If supersession_standing_is_current ever answered one way for every arm, this reds while
// the two rows above could both still pass under a constant.
test fn w_RED_the_two_datasheet_standings_disagree() -> Bool {
  supersession_standing_is_current(s: ampere_altra_classic_rev_a1_datasheet_supersession_standing)
    != supersession_standing_is_current(s: ampere_altra_max_rev_a1_datasheet_supersession_standing)
}

// THE MAX STANDING IS THE PUBLICLY-SERVED ARM, NOT THE UNRETRIEVED ONE. This distinction is the
// whole reason the third arm was added: an unretrieved supersession is a standing we may hold
// because there is nothing to read, while a publicly-served one is a live citation debt. Reading
// the arm rather than the boolean is what stops the debt hiding behind the other arm's excuse.
test fn w_the_max_supersession_is_a_live_citation_debt_not_an_unreadable_one() -> Bool {
  match ampere_altra_max_rev_a1_datasheet_supersession_standing {
    HeldRevisionIsCurrentPublicCopy => false
    NewerRevisionExistsUnretrieved { newer_version_label: _, newer_publication_date: _, index_authority: _, held_version_label: _, detail: _ } => false
    NewerRevisionPubliclyServed { newer_version_label: v, newer_locator: _, index_authority: _, held_version_label: h, detail: _ } =>
      v == "v1.25" && h == "v1.15"
  }
}
