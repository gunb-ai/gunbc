module test.claim.space_asymptotic_witness

import std.logic { Bool }
import std.types { Int }
import v1.compiler.complexity {
  CostExpr, CostConst, CostAdd, CostMul, CostMax, CostSum, CostUnknown,
  SizeExpr, SizeVar,
  cost_expr_degree, space_of,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data space_asymptotic_witness_note: String = "Space-complexity increment 2 ACCEPT: the asymptotic reading, proven through the polynomial DEGREE (cost_expr_degree, exhaustive Optional — no CostBound wildcard). The space degree = degree(space_of(work)) is <= the time degree by construction. Headline decided asymptotically: a reducing fold is O(n) TIME (degree 1) but O(1) SPACE (degree 0); a nested reducing loop is O(n^2) time but still O(1) space (both CostSums collapse); an underivable frontier yields Absent, never a fabricated degree."

fn time_degree(work: CostExpr) -> Int? {
  cost_expr_degree(e: work)
}

fn space_degree(work: CostExpr) -> Int? {
  cost_expr_degree(e: space_of(work: work))
}

data reducing_fold: CostExpr = CostSum { binder: "i", upper: SizeVar { name: "n" }, body: CostConst { value: 1 } }

test fn reducing_fold_time_linear_space_constant_holds() -> Bool {
  let t = match time_degree(work: reducing_fold) { Present { value: d } => d  Absent => 0 - 1 }
  let s = match space_degree(work: reducing_fold) { Present { value: d } => d  Absent => 0 - 1 }
  t == 1 && s == 0
}

test fn nested_reducing_loop_time_quadratic_space_constant_holds() -> Bool {
  let inner = CostSum { binder: "j", upper: SizeVar { name: "n" }, body: CostConst { value: 1 } }
  let nested = CostSum { binder: "i", upper: SizeVar { name: "n" }, body: inner }
  let t = match time_degree(work: nested) { Present { value: d } => d  Absent => 0 - 1 }
  let s = match space_degree(work: nested) { Present { value: d } => d  Absent => 0 - 1 }
  t == 2 && s == 0
}

test fn parallel_region_space_is_constant_degree_holds() -> Bool {
  let par = CostMax {
    left: CostSum { binder: "i", upper: SizeVar { name: "n" }, body: CostConst { value: 1 } },
    right: CostSum { binder: "j", upper: SizeVar { name: "n" }, body: CostConst { value: 1 } }
  }
  match space_degree(work: par) { Present { value: d } => d == 0  Absent => false }
}

test fn frontier_yields_absent_degree_holds() -> Bool {
  let work = CostAdd { left: CostConst { value: 1 }, right: CostUnknown { reason: "unmodeled" } }
  match space_degree(work: work) { Present { value: _ } => false  Absent => true }
}
