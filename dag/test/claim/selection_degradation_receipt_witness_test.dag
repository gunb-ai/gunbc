module test.claim.selection_degradation_receipt_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { String, Bool, NonEmptyStr }
import std.nat { Nat }
import gunbc.selection_degradation_receipt {
  SelectionDegradationReceipt,
  SelectionDegradationApplied,
  SelectionDegradationSuperset,
  SelectionDegradationOff,
  selection_degradation_receipt_of,
  selection_degradation_receipt_line,
  selection_degradation_receipt_body,
  selection_degradation_is_superset,
  selection_degradation_is_applied_narrowed,
  selection_degradation_state_tag,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executing consumer for gunbc.selection_degradation_receipt (floor prep-tax P2). THE PAIR IS THE PROOF: a narrowed affected run must read SelectionApplied with honest counts; a whole-corpus affected run must read SelectionSuperset with an explicit fallback_reason — never quiet success. RED controls mislabel a superset as applied.
test fn sdr_applied_narrowed_receipt() -> Bool {
  let line = selection_degradation_receipt_line(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 602,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  let r = selection_degradation_receipt_of(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 602,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  selection_degradation_is_applied_narrowed(receipt: r)
    && string_contains(s: line, pattern: "selection_state=SelectionApplied")
    && string_contains(s: line, pattern: "selected_entry_groups=602")
    && string_contains(s: line, pattern: "total_entry_groups=842")
    && string_contains(s: line, pattern: "selection_ratio=0.7149")
    && string_contains(s: line, pattern: "fallback_reason=")
}

test fn sdr_superset_whole_corpus_is_loud() -> Bool {
  let line = selection_degradation_receipt_line(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 842,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  let r = selection_degradation_receipt_of(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 842,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  selection_degradation_is_superset(receipt: r)
    && string_contains(s: line, pattern: "selection_state=SelectionSuperset")
    && string_contains(s: line, pattern: "selected_entry_groups=842")
    && string_contains(s: line, pattern: "total_entry_groups=842")
    && string_contains(s: line, pattern: "selection_ratio=1.0000")
    && string_contains(s: line, pattern: "counted performance degradation")
}

test fn sdr_off_mode_reports_full_run() -> Bool {
  let line = selection_degradation_receipt_line(
    selection_mode_tag: "off" as NonEmptyStr,
    selected: 842,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  let r = selection_degradation_receipt_of(
    selection_mode_tag: "off" as NonEmptyStr,
    selected: 842,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  selection_degradation_state_tag(state: r.selection_state) == "SelectionOff"
    && string_contains(s: line, pattern: "selection_state=SelectionOff")
}

test fn sdr_superset_must_not_read_as_applied_red() -> Bool {
  let r = selection_degradation_receipt_of(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 842,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  !selection_degradation_is_applied_narrowed(receipt: r)
}

test fn sdr_categorization_unavailable_superset_still_superset() -> Bool {
  let r = selection_degradation_receipt_of(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 842,
    total: 842,
    categorization_unavailable: true,
    categorization_reason: "module graph facts absent"
  )
  selection_degradation_is_superset(receipt: r)
    && string_contains(
      s: r.fallback_reason,
      pattern: "upfront import-closure categorization failed"
    )
}

test fn sdr_receipt_body_carries_all_five_fields() -> Bool {
  let body = selection_degradation_receipt_body(
    selection_mode_tag: "applied" as NonEmptyStr,
    selected: 602,
    total: 842,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  string_contains(s: body, pattern: "selection_state=SelectionApplied")
    && string_contains(s: body, pattern: "selected_entry_groups=602")
    && string_contains(s: body, pattern: "total_entry_groups=842")
    && string_contains(s: body, pattern: "selection_ratio=0.7149")
    && string_contains(s: body, pattern: "fallback_reason=")
}

test fn sdr_unknown_mode_tag_is_unavailable_fail_closed() -> Bool {
  let r = selection_degradation_receipt_of(
    selection_mode_tag: "bogus" as NonEmptyStr,
    selected: 1,
    total: 2,
    categorization_unavailable: false,
    categorization_reason: ""
  )
  selection_degradation_state_tag(state: r.selection_state) == "SelectionUnavailable"
    && string_contains(s: r.fallback_reason, pattern: "unknown selection_mode_tag")
    && string_contains(s: r.fallback_reason, pattern: "bogus")
    && !string_contains(s: r.fallback_reason, pattern: "categorization failed")
}
