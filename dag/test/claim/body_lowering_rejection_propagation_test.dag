module gunbc.test.claim.body_lowering_rejection_propagation_test

import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.diagnostic { Diagnostic, NonEmptyDiagnostics, None }
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, node_synthetic }
import v2.compiler.body_lowering_fold {
  BodyLowered,
  BodyLowering,
  BodyWrapperRetained,
  body_lower_finish_for_normalize
}

// THE DISCRIMINATING CONTROL for the deleted rejection catch. body_lower_finish_for_normalize used
// to match EVERY Rejected from body_lower_after_children and return a wrapper-retained Accepted
// instead, binding the rejection diagnostics to _ and discarding them — so a malformed form, a
// violated invariant and a genuinely unsupported one all left the seam looking like the same
// counted frontier state.
//
// These two claims are the pair that separates them, and they are durable because both are
// invariants rather than observations of the present frontier: a form the lowering strategies
// REJECT must leave the seam Rejected carrying its own reason, and an emitted identity with no
// registered producer must STILL leave it Accepted as the BodyWrapperRetained variant (retention
// has been a typed variant rather than a diagnostic reason since MQ-4). The first fails on the pre-
// repair implementation, which returned Accepted; the second fails on any over-correction that
// deletes the legitimate retention arm along with the catch. Neither claim mentions a specific std
// module, so neither inverts when the frontier moves.
//
// The rejecting specimen is a pass-through production (^dag_surface_expr) carrying a production-
// identity child and NO captured child, which is exactly the shape body_lower_unwrap_pass_through
// refuses with ^body_lowering_reason_unsupported_form. The retaining specimen carries an identity
// no producer is registered for, which reaches the final arm of body_lower_production_emitted.

fn atom_node(id: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: id } }, children: [])
}

fn emitted_shell(id: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^grammar_production_identity_node_projection },
        target: atom_node(id: id)
      }
    ]
  )
}

fn diagnostic_reason(d: Diagnostic) -> Symbol {
  d.reason
}

fn all_reasons(d: NonEmptyDiagnostics) -> List<Symbol> {
  fold_list(xs: d.tail, empty: [diagnostic_reason(d: d.head)], cons: fn(acc, item) {
    concat(acc, [diagnostic_reason(d: item)])
  })
}

fn reasons_contain(reasons: List<Symbol>, sym: Symbol) -> Bool {
  fold_list(xs: reasons, empty: false, cons: fn(acc, r) {
    acc || (r == sym)
  })
}

fn finish(id: Symbol) -> v2.std.diagnostic.Outcome<BodyLowering> {
  let shell = emitted_shell(id: id)
  body_lower_finish_for_normalize(
    n: shell,
    folded: shell,
    cd: None,
    fn_body_pass_through: false
  )
}

// The outcome ARM is rendered, never collapsed to an empty list: a claim that only asks
// "does this reason list lack the retention reason" is satisfied by the wrong arm returning
// nothing at all, which is the same vacuity the annotation witness had to close.
fn rendered_arm(id: Symbol) -> String {
  match finish(id: id) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => "REJECTED"
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => "ACCEPTED"
  }
}

fn finish_is_retained(id: Symbol) -> Bool {
  match finish(id: id) {
    v2.std.diagnostic.Accepted { value: BodyWrapperRetained { retention: _ }, diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: BodyLowered { node: _ }, diagnostics: _ } => false
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

// One direct match on the Rejected arm: the REJECTED diagnostic set itself must carry the
// strategy's own reason and must NOT carry the retention reason. Asserting the absence via
// accepted_reasons would not establish this, because that helper returns [] for every rejected
// result — the claim would hold for the wrong reason.
test fn genuine_rejection_leaves_the_seam_rejected() -> Bool {
  match finish(id: ^dag_surface_expr) {
    v2.std.diagnostic.Rejected { diagnostics: d } =>
      reasons_contain(reasons: all_reasons(d: d), sym: ^body_lowering_reason_unsupported_form)
        && (reasons_contain(reasons: all_reasons(d: d), sym: ^normalized_tree_reason_wrapper_retention_not_normalized) == false)
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn genuine_rejection_lands_on_the_rejected_arm() -> Bool {
  rendered_arm(id: ^dag_surface_expr) == "REJECTED"
}


test fn unregistered_producer_lands_on_the_accepted_arm() -> Bool {
  rendered_arm(id: ^probe_unregistered_surface_form) == "ACCEPTED"
}

test fn unregistered_producer_still_retains() -> Bool {
  finish_is_retained(id: ^probe_unregistered_surface_form)
}
