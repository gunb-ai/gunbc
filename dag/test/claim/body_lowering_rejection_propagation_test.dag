module gunbc.test.claim.body_lowering_rejection_propagation_test


data body_lowering_rejection_propagation_note: String = "THE DISCRIMINATING CONTROL for the deleted rejection catch. body_lower_finish_for_normalize used to match EVERY Rejected from body_lower_after_children and return a wrapper-retained Accepted instead, binding the rejection diagnostics to _ and discarding them — so a malformed form, a violated invariant and a genuinely unsupported one all left the seam looking like the same counted frontier state.\n\nThese two claims are the pair that separates them, and they are durable because both are invariants rather than observations of the present frontier: a form the lowering strategies REJECT must leave the seam Rejected carrying its own reason, and an emitted identity with no registered producer must STILL leave it Accepted carrying the retention reason. The first fails on the pre-repair implementation, which returned Accepted; the second fails on any over-correction that deletes the legitimate retention arm along with the catch. Neither claim mentions a specific std module, so neither inverts when the frontier moves.\n\nThe rejecting specimen is a pass-through production (^dag_surface_expr) carrying a production-identity child and NO captured child, which is exactly the shape body_lower_unwrap_pass_through refuses with ^body_lowering_reason_unsupported_form. The retaining specimen carries an identity no producer is registered for, which reaches the final arm of body_lower_production_emitted."

fn atom_node(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } }, children: [])
}

fn emitted_shell(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.node_synthetic(
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Named { name: ^grammar_production_identity_node_projection },
        target: gunbc.test.claim.body_lowering_rejection_propagation_test.atom_node(id: id)
      }
    ]
  )
}

fn diagnostic_reason(d: v2.std.diagnostic.Diagnostic) -> v2.std.node.Symbol {
  d.reason
}

fn all_reasons(d: v2.std.diagnostic.NonEmptyDiagnostics) -> List<v2.std.node.Symbol> {
  v2.std.algebra.fold_list(xs: d.tail, empty: [gunbc.test.claim.body_lowering_rejection_propagation_test.diagnostic_reason(d: d.head)], cons: fn(acc, item) {
    concat(acc, [gunbc.test.claim.body_lowering_rejection_propagation_test.diagnostic_reason(d: item)])
  })
}

fn reasons_contain(reasons: List<v2.std.node.Symbol>, sym: v2.std.node.Symbol) -> v2.std.logic.Bool {
  v2.std.algebra.fold_list(xs: reasons, empty: false, cons: fn(acc, r) {
    acc || (r == sym)
  })
}

fn finish(id: v2.std.node.Symbol) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  let shell = emitted_shell(id: id)
  v2.compiler.body_lowering_fold.body_lower_finish_for_normalize(
    n: shell,
    folded: shell,
    cd: v2.std.diagnostic.None,
    fn_body_pass_through: false
  )
}

// The outcome ARM is rendered, never collapsed to an empty list: a claim that only asks
// "does this reason list lack the retention reason" is satisfied by the wrong arm returning
// nothing at all, which is the same vacuity the annotation witness had to close.
fn rendered_arm(id: v2.std.node.Symbol) -> String {
  match finish(id: id) {
    Rejected { diagnostics: _ } => "REJECTED"
    Accepted { value: _, diagnostics: _ } => "ACCEPTED"
  }
}

fn accepted_reasons(id: v2.std.node.Symbol) -> List<v2.std.node.Symbol> {
  match finish(id: id) {
    Accepted { value: _, diagnostics: d } =>
      match d {
        Some { diagnostics: ne } => gunbc.test.claim.body_lowering_rejection_propagation_test.all_reasons(d: ne)
        None => []
      }
    Rejected { diagnostics: _ } => []
  }
}

// One direct match on the Rejected arm: the REJECTED diagnostic set itself must carry the
// strategy's own reason and must NOT carry the retention reason. Asserting the absence via
// accepted_reasons would not establish this, because that helper returns [] for every rejected
// result — the claim would hold for the wrong reason.
test fn genuine_rejection_leaves_the_seam_rejected() -> v2.std.logic.Bool {
  match finish(id: ^dag_surface_expr) {
    Rejected { diagnostics: d } =>
      gunbc.test.claim.body_lowering_rejection_propagation_test.reasons_contain(reasons: gunbc.test.claim.body_lowering_rejection_propagation_test.all_reasons(d: d), sym: ^body_lowering_reason_unsupported_form)
        && (gunbc.test.claim.body_lowering_rejection_propagation_test.reasons_contain(reasons: gunbc.test.claim.body_lowering_rejection_propagation_test.all_reasons(d: d), sym: ^body_lowering_reason_wrapper_retained_emitted) == false)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn genuine_rejection_lands_on_the_rejected_arm() -> v2.std.logic.Bool {
  rendered_arm(id: ^dag_surface_expr) == "REJECTED"
}


test fn unregistered_producer_lands_on_the_accepted_arm() -> v2.std.logic.Bool {
  rendered_arm(id: ^probe_unregistered_surface_form) == "ACCEPTED"
}

test fn unregistered_producer_still_retains() -> v2.std.logic.Bool {
  gunbc.test.claim.body_lowering_rejection_propagation_test.reasons_contain(
    reasons: accepted_reasons(id: ^probe_unregistered_surface_form),
    sym: ^body_lowering_reason_wrapper_retained_emitted
  )
}
