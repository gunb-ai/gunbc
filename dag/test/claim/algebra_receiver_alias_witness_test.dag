module test.claim.algebra_receiver_alias_witness_test

import std.types { Bool, Int, String }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }

fn blocking_count_for(source: String, wanted: String) -> Int {
  match census_blocking_count_for_class(
    census: compile_dag_diagnostic_census(source),
    wanted: wanted
  ) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// These are deliberately source fixtures: the alias spelling is expected to
// refuse until owner identity is carried to variant_reference_inferred_node.
// Keeping the invalid programs inside strings lets the control observe the
// typed refusal without making the required corpus reject this module.
data nominal_return_source: String = "module alias_nominal_return\nimport std.algebra { Empty }\nfn asks() -> FreeMonoid<Int> { [1, 2] |> fold(init: Empty, f: fn(acc, value) { acc |> list_push(value) }) }\n"
data alias_return_source: String = "module alias_return\nimport std.algebra { Empty }\nfn asks() -> List<Int> { [1, 2] |> fold(init: Empty, f: fn(acc, value) { acc |> list_push(value) }) }\n"
data alias_field_source: String = "module alias_field\nimport std.algebra { Empty }\ntype Box { values: List<Int> }\nfn asks() -> List<Int> { let b = Box { values: [1, 2] |> fold(init: Empty, f: fn(acc, value) { acc |> list_push(value) }) }; b.values }\n"
data alias_initializer_source: String = "module alias_initializer\nimport std.algebra { Empty }\nfn asks() -> List<Int> { let initial: FreeMonoid<Int> = Empty; [1, 2] |> fold(init: initial, f: fn(acc, value) { acc |> list_push(value) }) }\n"

test fn alias_nominal_return_is_a_refusal_fixture() -> Bool {
  blocking_count_for(source: nominal_return_source, wanted: "MethodNotFound") >= 1
}

test fn alias_return_is_a_refusal_fixture() -> Bool {
  blocking_count_for(source: alias_return_source, wanted: "MethodNotFound") >= 1
}

test fn alias_field_is_a_refusal_fixture() -> Bool {
  blocking_count_for(source: alias_field_source, wanted: "MethodNotFound") >= 1
}

test fn alias_initializer_is_a_refusal_fixture() -> Bool {
  blocking_count_for(source: alias_initializer_source, wanted: "MethodNotFound") >= 1
}
