module test.claim.floor_exhaustiveness_allowlist_equality_witness

import std.types { String, Bool, Int, List }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.algebra { trim }
import extdeps.filesystem.filesystem_io
import v2.workflow.floor_exhaustiveness_allowlist {
  floor_exhaustiveness_allowlist,
  floor_exhaustiveness_site_key
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// ============================================================================
// MODEL-LAYER WAIVER-FILE == ROSTER EQUALITY for the floor-exhaustiveness wall.
//
// The A+C waiver arm (cli_run/compile_clean.rs) TRUSTS the file named by
// GUNBC_EXHAUSTIVENESS_UNKNOWN_ALLOWLIST: any key present there downgrades that
// site's ExhaustivenessUnknown from hard-blocking to advisory. The roster in
// v2.workflow.floor_exhaustiveness_allowlist is the AUTHORITY the arm's file must
// be honest to. This claim reads BOTH committed artifacts as data -- the .dag
// roster and the materialized .data file -- and checks them against EACH OTHER,
// so each can independently drift or be tampered with and be caught:
//   (extra) a line in the file that is not a rostered site -> waives a site the
//           operator never authorized -> RED.
//   (stale) a rostered site with no line in the file -> the arm will not waive it,
//           so it hard-blocks (this is also the missing-line control) -> RED.
//
// WHICH LAYER MEASURES WHAT: this claim is the MODEL-LAYER equality (committed
// data file vs model roster); it performs no filesystem source census. The
// per-scrutinee SOURCE-TEXT census witnesses that used to live in this file were
// RETIRED: they fed filesystem_read(source).content into compile_dag_diagnostic_census,
// a builtin that is never called with arguments from .dag, so they measured an
// empty set and could never pass (they also carried an authoring fault, an
// undefined 'scrutines' at the old :116). The emit / compile-clean gate -- not a
// claim -- is what measures live blocking sites; this claim is what keeps the file
// the arm actually reads honest to the roster.
// ============================================================================

// The committed materialized waiver input the A+C arm reads (CI points
// GUNBC_EXHAUSTIVENESS_UNKNOWN_ALLOWLIST at this path before the corpus compile).
data floor_exhaustiveness_data_file_path: String =
  "src/v2/workflow/floor_exhaustiveness_allowlist.data"

// Parse the file EXACTLY as the arm's Rust reader does: split on newline, trim each
// line, drop blank lines and lines beginning with '#'. (cli_run/compile_clean.rs:
// body.lines().map(trim).filter(|l| !l.is_empty() && !l.starts_with('#'))).
fn floor_exhaustiveness_data_file_keys() -> List<String> {
  let body: String = filesystem_read(path: floor_exhaustiveness_data_file_path).content
  let raw_lines: List<String> = split(s: body, delimiter: "\n")
  filter(map(raw_lines, line => trim(s: line)), line => line != "" && !starts_with(s: line, prefix: "#"))
}

fn floor_exhaustiveness_roster_key_list() -> List<String> {
  map(floor_exhaustiveness_allowlist(), floor_exhaustiveness_site_key)
}

fn floor_exhaustiveness_in_roster(key: String) -> Bool {
  filter(floor_exhaustiveness_roster_key_list(), k => k == key).length() > 0
}

fn floor_exhaustiveness_in_data_file(key: String) -> Bool {
  filter(floor_exhaustiveness_data_file_keys(), k => k == key).length() > 0
}

test fn floor_exhaustiveness_data_file_equals_the_roster() -> Bool {
  let extra_in_file: List<String> = filter(floor_exhaustiveness_data_file_keys(), k => !floor_exhaustiveness_in_roster(k))
  let missing_from_file: List<String> = filter(floor_exhaustiveness_roster_key_list(), k => !floor_exhaustiveness_in_data_file(k))
  extra_in_file.length() == 0 && missing_from_file.length() == 0
}
