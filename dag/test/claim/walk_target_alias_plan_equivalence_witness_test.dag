module test.claim.walk_target_alias_plan_equivalence_witness_test

import tools.walk_target_alias_plan_equivalence_transport {
  wtaa_plan_equivalence_pure_arm_self_consistent
}
import tools.walk_target_alias_plan {
  walk_target_alias_plan_alias_row_tsv,
  walk_target_alias_plan_rows_all_match,
  WalkTargetAliasPlanRow,
  WalkTargetAliasPlanRowKey,
  GlobalBareLcp
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wtaa_plan_equivalence_note: String = "Phase 7 PLACEHOLDER (operator ruling msg_b6c9153f): these witnesses only check pure-arm self-consistency (golden row equals itself; tsv shape) — they do NOT ingest the Rust wet arm and CANNOT go red on a real dual-run divergence, so they do NOT gate #6984 Rust deletion. The real dual-run gate is pending walk_target_alias_plan_from_census in .dag (seed-gap row 1); see wtaa_plan_equivalence_placeholder_scaffold."

data wtaa_plan_equivalence_golden_row: WalkTargetAliasPlanRow = WalkTargetAliasPlanRow {
  key: WalkTargetAliasPlanRowKey {
    class: GlobalBareLcp,
    declaring_module: "test.aliasplan.near.consumer",
    binding: "AmbigType",
    walk_target_qualified_path: "test.aliasplan.near.AmbigType"
  },
  pre_flip_qualified_path: "test.aliasplan.near.AmbigType",
  walk_verified: true,
  lookup_events: 1
}

test fn walk_target_alias_plan_equivalence_golden_row_self_match_holds() -> Bool {
  walk_target_alias_plan_rows_all_match(
    expected: [wtaa_plan_equivalence_golden_row],
    actual: [wtaa_plan_equivalence_golden_row]
  )
}

test fn walk_target_alias_plan_equivalence_tsv_shape_holds() -> Bool {
  string_contains(
    s: walk_target_alias_plan_alias_row_tsv(row: wtaa_plan_equivalence_golden_row),
    pattern: "ALIAS_ROW\tglobal_bare_lcp\tmodule=test.aliasplan.near.consumer\tbinding=AmbigType\twalk_target=test.aliasplan.near.AmbigType"
  )
}

test fn walk_target_alias_plan_equivalence_pure_arm_self_consistent() -> Bool {
  wtaa_plan_equivalence_pure_arm_self_consistent()
}
