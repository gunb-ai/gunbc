module test.claim.constructor_tag_route_probe_red

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type Pa = P1 { a: Int } | P2
type Pb = Q1 { a: Int } | Q2

type ConstructorTag<T> = ConstructorTag { name: String }

fn tag_of<T>(v: T) -> ConstructorTag<T> {
  ConstructorTag { name: discriminant(v: v) }
}

fn same_arm<T>(a: T, b: T) -> Bool {
  tag_of(v: a) == tag_of(v: b)
}

test fn same_arm_one_t_two_coproducts_must_refuse() -> Bool {
  same_arm(a: P1 { a: 1 }, b: Q1 { a: 1 })
}
