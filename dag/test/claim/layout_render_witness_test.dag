module test.claim.layout_render_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data flat_proto: std.layout.LayoutProtocol = std.layout.LayoutProtocol { indent_unit: "" }
data yaml_proto: std.layout.LayoutProtocol = std.layout.LayoutProtocol { indent_unit: "  " }

fn flat_doc() -> std.layout.Doc {
  std.layout.doc_concat(parts: [std.layout.doc_line_of(text: "a"), std.layout.doc_line_of(text: "b")])
}

fn nested_doc(levels: Int) -> std.layout.Doc {
  std.layout.doc_concat(parts: [
    std.layout.doc_text(text: "root:"),
    std.layout.DocLine,
    std.layout.doc_nest(levels: levels, body: std.layout.doc_concat(parts: [std.layout.doc_text(text: "child"), std.layout.DocLine]))
  ])
}

fn witness_flat_lines() -> Bool {
  render(doc: flat_doc(), proto: flat_proto) == "a\nb\n"
}

fn witness_nesting_applies_indent() -> Bool {
  render(doc: nested_doc(levels: 1), proto: yaml_proto) == "root:\n  child\n"
}

fn witness_nest_level_discriminates() -> Bool {
  render(doc: nested_doc(levels: 1), proto: yaml_proto) !=
    render(doc: nested_doc(levels: 2), proto: yaml_proto)
}

fn witness_indent_unit_discriminates() -> Bool {
  render(doc: nested_doc(levels: 1), proto: yaml_proto) !=
    render(doc: nested_doc(levels: 1), proto: flat_proto)
}

fn witness_blank_line_carries_no_indent() -> Bool {
  let d = std.layout.doc_concat(parts: [std.layout.doc_text(text: "k:"), std.layout.DocLine, std.layout.doc_blank(), std.layout.doc_nest(levels: 3, body: std.layout.doc_concat(parts: [std.layout.doc_text(text: "x"), std.layout.DocLine]))])
  render(doc: d, proto: yaml_proto) == "k:\n\n      x\n"
}

fn witness_trailing_line_no_trailing_indent() -> Bool {
  let d = std.layout.doc_nest(levels: 2, body: std.layout.doc_concat(parts: [std.layout.doc_text(text: "deep"), std.layout.DocLine]))
  render(doc: d, proto: yaml_proto) == "    deep\n"
}

fn witness_dash_nest_alignment() -> Bool {
  let v2.test.resolve.qualified_module_projection_g1b_fixture.item = std.layout.doc_concat(parts: [
    std.layout.doc_text(text: "- "),
    std.layout.doc_nest(levels: 1, body: std.layout.doc_concat(parts: [std.layout.doc_text(text: "name: a"), std.layout.DocLine, std.layout.doc_text(text: "run: x"), std.layout.DocLine]))
  ])
  render(doc: v2.test.resolve.qualified_module_projection_g1b_fixture.item, proto: yaml_proto) == "- name: a\n  run: x\n"
}

fn witness_render_is_format_agnostic() -> Bool {
  let flat = render(doc: flat_doc(), proto: flat_proto)
  let nested = render(doc: nested_doc(levels: 1), proto: yaml_proto)
  (flat == "a\nb\n") && (nested == "root:\n  child\n")
}

test fn layout_render_keystone_holds() -> Bool {
  witness_flat_lines() &&
    witness_nesting_applies_indent() &&
    witness_nest_level_discriminates() &&
    witness_indent_unit_discriminates() &&
    witness_blank_line_carries_no_indent() &&
    witness_trailing_line_no_trailing_indent() &&
    witness_dash_nest_alignment() &&
    witness_render_is_format_agnostic()
}
