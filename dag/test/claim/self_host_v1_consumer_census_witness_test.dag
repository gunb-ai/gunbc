data planted_observed_tree: RustObservedTree = RustObservedTree { revision: "0000000000000000000000000000000000000001", tree: "0000000000000000000000000000000000000002" }

// THERE IS NO LIVE HALF ON THE FLOOR ANY MORE. Since the Rust reference population became a
// produced observation (gunbc.rust_item_host_observation head_rust_sources reaches
// git.Inspect.HeadCommit, ListTreePathsAtRevision, ShowTree and git.Core.Show),
// v1_consumer_population() is a live read the hermetic envelope has no route for, and
// v2.workflow.floor_changed_witness refuses a changed witness that ends in a route gap. The two
// assertions that read the live population are therefore deleted, the loss is the declared drop
// gunbc.rung_drop v1_consumer_census_live_population_off_the_merge_path, and the executing consumer
// of the live census is the operator instrument v1_blocking_consumer_count_report. Everything here
// folds planted sources through the same producer.
//
// WHAT THIS WITNESS ESTABLISHES, AND WHAT IT DOES NOT.
//
// It does NOT measure the repository. The live roster in gunbc.v1_consumer_census is a hand sweep
// over seven per-medium producers, and no assertion here would move if a new v1 consumer were
// authored tomorrow. Saying that first is the point: a green witness beside a census is exactly the
// artifact a reader mistakes for 'the census is verified'.
//
// What it DOES establish is that the census's refusals DISCRIMINATE -- each goes red on the state
// it exists to catch, and green on the same fixture with that one state removed. Every assertion
// below is therefore a PAIR, and the green half is not decoration: a predicate that returned false
// unconditionally would pass every red-only probe in this file, the positive-control-on-the-plant
// gap this repository has already filed twice.
//
// NO ASSERTION COMPARES ANYTHING TO A LITERAL COUNT. Every number is a fold over a population
// compared to another fold over the same population, so adding a row cannot make this file stale
// and no assertion can be silenced by editing a number.

fn undisposed_consumer_is_caught() -> Bool {
  v1_every_discovered_consumer_disposed(discovered: clean_discovered, rows: clean_rows)
    && !v1_every_discovered_consumer_disposed(discovered: planted_undisposed_discovered, rows: clean_rows)
}

fn stale_row_is_caught() -> Bool {
  v1_every_row_names_a_live_consumer(discovered: clean_discovered, rows: clean_rows)
    && !v1_every_row_names_a_live_consumer(discovered: planted_stale_discovered, rows: clean_rows)
}

// A DISPOSITION CANNOT BE MADE TRUE BY EDITING IT, through BOTH arms that carry a successor: the
// ReplacedByY authority and the Covered coverage claim. A refusal that reached only one of them
// would leave the other as the place an author types a name nothing realizes.
fn unrealized_successor_claim_is_caught() -> Bool {
  v1_every_claimed_successor_is_realized(rows: clean_rows, realized: clean_realized)
    && !v1_every_claimed_successor_is_realized(rows: planted_unrealized_rows, realized: clean_realized)
    && !v1_every_claimed_successor_is_realized(rows: planted_covered_unrealized_rows, realized: clean_realized)
}

// THE ADMISSION GATE REFUSES AN UNMEASURED POPULATION AND A LOWER-BOUND ONE, and admits the
// complete one. The populations differ ONLY in the completeness arm -- same rows, same successors.
fn admission_reads_completeness() -> Bool {
  v1_bankruptcy_transaction_admitted(population: clean_population, realized: clean_realized)
    && !v1_bankruptcy_transaction_admitted(population: planted_lower_bound_population, realized: clean_realized)
    && !v1_bankruptcy_transaction_admitted(population: planted_unmeasured_population, realized: clean_realized)
}

fn admission_refuses_a_blocking_consumer() -> Bool {
  !v1_bankruptcy_transaction_admitted(population: planted_blocking_population, realized: clean_realized)
    && consumer_population_is_complete(p: planted_blocking_population)
}

fn admission_refuses_an_unrealized_successor() -> Bool {
  !v1_bankruptcy_transaction_admitted(population: planted_unrealized_population, realized: clean_realized)
    && !v1_bankruptcy_transaction_admitted(population: planted_covered_unrealized_population, realized: clean_realized)
    && consumer_population_is_complete(p: planted_unrealized_population)
}

// THE PROJECTION INTO THE EXACT CARRIER ENUMERATES EXACTLY THE ROWS IT WAS GIVEN, and never the
// declared-empty arm: a census with rows that projected to BoundaryDeclaredEmpty would hand the
// exact cut a clean boundary over a population it was told about.
fn boundary_census_enumerates_the_rows() -> Bool {
  match v1_boundary_census(rows: clean_rows) {
    ConsumersEnumerated { consumers: cs } => count(cs) == count(clean_rows)
    BoundaryDeclaredEmpty { basis: _ } => false
  }
}

// THE TOOLING NAMESPACE ROW IS LOAD-BEARING, AND ITS ABSENCE IS EXECUTED, NOT DESCRIBED. Under the
// live table every shim projects to a BoundaryConsumer row under the v1_compiled. namespace and nothing is
// uncitable; under the live table with exactly the tooling row removed, every shim returns to the
// uncitable list and none is cited. The two halves together are the falsifier the ruling asked for:
// the row is what makes the four spellable, and the census does not spell them any other way.
fn live_rows_without_tooling() -> List<RustSourceNamespaceRow> {
  rust_source_namespace_rows |> filter(r => r.repo_prefix != rust_source_prefix_tooling)
}

// THE PLANTED REFERENCE POPULATION: three hand-Rust files under the tooling tree, authored here so
// the producer's fold is exercised on inputs this file controls rather than on whatever the tree
// happens to carry. One reaches v1_rt at file level, one through a `mod` item, one names nothing
// and must produce no row at all -- the negative control that shows the fold is keyed on the token
// rather than on the tree.
fn planted_source(path: String, content: String) -> RustFileChangeInput {
  RustFileChangeInput {
    repo_path: path, base_content: "", head_content: content,
    present_at_base: false, present_at_head: true, old_ranges: [], new_ranges: []
  }
}

fn planted_sources() -> List<RustFileChangeInput> {
  [
    planted_source(path: "dag/gunbc/instruments/planted_use_shims/lib.rs", content: "#![allow(dead_code)]\npub use v1_compiler::v1_rt;\npub fn bridge() {}\n"),
    planted_source(path: "dag/gunbc/instruments/planted_mod_shims/lib.rs", content: "pub mod v1_rt;\npub mod other;\n"),
    planted_source(path: "dag/gunbc/instruments/planted_clean_shims/lib.rs", content: "pub fn nothing_here() {}\n"),
  ]
}

fn planted_observation(rows: List<RustSourceNamespaceRow>) -> RustReferenceObservation {
  observe_rust_references(observed_at: planted_observed_tree, sources: planted_sources(), generated_repo_paths: [], tokens: v1_reference_tokens(), rows: rows)
}

// A TOKEN THE AUTHORITY TABLE DOES NOT CARRY IS AN UNDECIDED CONSUMER, NOT A V1RuntimeBridge ROW:
// the producer is handed a token the census never declared, and the partition refuses to guess.
fn an_unknown_token_refuses_rather_than_borrowing_the_first_authority() -> Bool {
  match observe_rust_references(observed_at: planted_observed_tree, sources: planted_sources(), generated_repo_paths: [], tokens: ["v1_rt", "planted_unknown_token"], rows: rust_source_namespace_rows) {
    RustReferenceHostRefused { detail: _ } => false
    RustReferencesObserved { observed_at: _, rows: rs, unattributed: u, unscannable: _ } => {
      let unknown_sources = [planted_source(path: "dag/gunbc/instruments/planted_unknown_shims/lib.rs", content: "pub use v1_compiler::planted_unknown_token;\n")]
      match observe_rust_references(observed_at: planted_observed_tree, sources: unknown_sources, generated_repo_paths: [], tokens: ["v1_rt", "planted_unknown_token"], rows: rust_source_namespace_rows) {
        RustReferenceHostRefused { detail: _ } => false
        RustReferencesObserved { observed_at: _, rows: rs2, unattributed: u2, unscannable: _ } => {
          let p = v1_shim_partition_over(observed_at: planted_observed_tree, rows: rs2, unattributed: u2)
          count(rs2) == 1 && count(p.cited) == 0 && count(p.uncitable) == 1
            && (p.uncitable |> all(x => consumer_disposition_blocks(d: x.disposition) && string_contains(s: x.refusal_detail, pattern: "planted_unknown_token")))
            && count(v1_shim_partition_over(observed_at: planted_observed_tree, rows: rs, unattributed: u).cited) == count(rs)
        }
      }
    }
  }
}

// TWO LINES, ONE RELATION: a crate root naming v1_rt on two file-level `use` lines is one consumer
// of one authority, not two -- the produced grain is the line, the census grain is consumer x
// authority. (A `pub mod v1_rt;` beside a `pub use` is NOT this case: the scan mints the mod as
// its own item, so that is two consumers.)
fn two_lines_naming_one_authority_are_one_consumer() -> Bool {
  let twice = [planted_source(path: "dag/gunbc/instruments/planted_twice_shims/lib.rs", content: "pub use v1_compiler::v1_rt;\npub use v1_compiler::v1_rt as rt;\n")]
  match observe_rust_references(observed_at: planted_observed_tree, sources: twice, generated_repo_paths: [], tokens: v1_reference_tokens(), rows: rust_source_namespace_rows) {
    RustReferenceHostRefused { detail: _ } => false
    RustReferencesObserved { observed_at: _, rows: rs, unattributed: u, unscannable: _ } =>
      count(rs) == 2 && count(v1_shim_partition_over(observed_at: planted_observed_tree, rows: rs, unattributed: u).cited) == 1
  }
}

// ONE ITEM, TWO AUTHORITIES, TWO RELATIONS -- the opposite case to two-lines-one-authority. A crate
// root that names v1_rt AND v1_interpreter at file level is one item reaching two consumed
// authorities, so the census keeps two rows in BOTH columns: cited under the live table, and
// uncitable under the table without the tooling row (where the dedup key must carry the authority,
// or the two would collapse to one and the count would undercount in the fail-open direction).
fn one_item_naming_two_authorities_is_two_relations() -> Bool {
  let sources = [planted_source(path: "dag/gunbc/instruments/planted_two_authority_shims/lib.rs", content: "pub use v1_compiler::v1_rt;\npub use v1_compiler::v1_interpreter;\n")]
  match observe_rust_references(observed_at: planted_observed_tree, sources: sources, generated_repo_paths: [], tokens: v1_reference_tokens(), rows: rust_source_namespace_rows) {
    RustReferenceHostRefused { detail: _ } => false
    RustReferencesObserved { observed_at: _, rows: rs, unattributed: u, unscannable: _ } =>
      match observe_rust_references(observed_at: planted_observed_tree, sources: sources, generated_repo_paths: [], tokens: v1_reference_tokens(), rows: live_rows_without_tooling()) {
        RustReferenceHostRefused { detail: _ } => false
        RustReferencesObserved { observed_at: _, rows: rs2, unattributed: u2, unscannable: _ } =>
          count(rs) == 2
            && count(v1_shim_partition_over(observed_at: planted_observed_tree, rows: rs, unattributed: u).cited) == 2
            && count(v1_shim_partition_over(observed_at: planted_observed_tree, rows: rs2, unattributed: u2).uncitable) == 2
      }
  }
}

fn planted_partition(rows: List<RustSourceNamespaceRow>) -> V1ShimPopulation {
  v1_shim_population_of(observation: planted_observation(rows: rows))
}

fn planted_row_count() -> Int {
  match planted_observation(rows: rust_source_namespace_rows) {
    RustReferencesObserved { observed_at: _, rows: rs, unattributed: _, unscannable: _ } => count(rs)
    RustReferenceHostRefused { detail: _ } => 0
  }
}

fn the_tooling_row_decides_shim_citability() -> Bool {
  match planted_partition(rows: rust_source_namespace_rows) {
    V1ShimPopulationRefused { reason: _ } => false
    V1ShimPopulationObserved { partition: cited_partition } =>
      match planted_partition(rows: live_rows_without_tooling()) {
        V1ShimPopulationRefused { reason: _ } => false
        V1ShimPopulationObserved { partition: uncited_partition } =>
          planted_row_count() == 2
            && count(cited_partition.cited) == planted_row_count() && count(cited_partition.uncitable) == 0
            && count(uncited_partition.uncitable) == planted_row_count() && count(uncited_partition.cited) == 0
            && count(live_rows_without_tooling()) == count(rust_source_namespace_rows) - 1
            && (cited_partition.cited |> all(r => starts_with(s: r.boundary.consumer.module_path as String, prefix: "v1_compiled.")))
            && (cited_partition.cited |> all(r => r.boundary.consumed_old_authority.module_path as String == "v1_compiler.v1_rt"))
      }
  }
}

// THE POPULATION IS DERIVED FROM THE SAME PARTITION: with the row, the uncitable column carries
// only what the manifest join contributes; without it, every planted reference joins it. Both arms
// stay LowerBound -- the row was necessary for Complete, not sufficient -- and a host refusal on
// EITHER observation is the Unmeasured arm, never an empty list.
fn the_population_carries_the_partition() -> Bool {
  let join_uncitable = count(v1_join_uncitable_consumers(j: v1_minted_manifest_join_over(observation: clean_seed_link_observation())))
  count(consumer_population_uncitable(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: clean_seed_link_observation()))) == join_uncitable
    && count(consumer_population_uncitable(p: v1_consumer_population_for(observation: planted_observation(rows: live_rows_without_tooling()), seed_links: clean_seed_link_observation()))) == planted_row_count() + join_uncitable
    && !consumer_population_is_complete(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: clean_seed_link_observation()))
    && !consumer_population_is_complete(p: v1_consumer_population_for(observation: planted_observation(rows: live_rows_without_tooling()), seed_links: clean_seed_link_observation()))
    && count(consumer_population_rows(p: v1_consumer_population_for(observation: RustReferenceHostRefused { detail: "planted host refusal" }, seed_links: clean_seed_link_observation()))) == 0
    && count(consumer_population_uncitable(p: v1_consumer_population_for(observation: RustReferenceHostRefused { detail: "planted host refusal" }, seed_links: clean_seed_link_observation()))) == 0
    && !consumer_population_is_complete(p: v1_consumer_population_for(observation: RustReferenceHostRefused { detail: "planted host refusal" }, seed_links: clean_seed_link_observation()))
    && !consumer_population_is_complete(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: RustReferenceHostRefused { detail: "planted host refusal" }))
    && count(consumer_population_rows(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: RustReferenceHostRefused { detail: "planted host refusal" }))) == 0
    && match v1_blocking_count_of(p: v1_consumer_population_for(observation: RustReferenceHostRefused { detail: "planted host refusal" }, seed_links: clean_seed_link_observation())) {
         V1BlockingUnmeasured { reason: r } => string_contains(s: r, pattern: "planted host refusal")
         V1BlockingCounted { blocking: _, members: _ } => false
       }
    && match v1_blocking_count_of(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: clean_seed_link_observation())) {
         V1BlockingCounted { blocking: b, members: m } => b > 0 && b <= m
         V1BlockingUnmeasured { reason: _ } => false
       }
}

// THE CARGO MANIFEST MEDIUM, ON PLANTED SEED-LINK SITES. The roster of Rust renderers is authored
// to one site (the cssl stale-red control) and one uncitable site (the behavioral receipt's rlib
// oracle); the sources below are planted so each join direction is exercised: the rostered site
// produced (joined), an extra citable site with the token (undisposed, becomes an Undecided
// consumer that blocks), the rostered site absent (stale, excluded from consumers), the rostered
// impl method produced (rostered uncitable, carried with its oracle disposition), a different impl
// method with the token (undisposed uncitable), and a comment line carrying the token (no row).
fn seed_link_observation(sources: List<RustFileChangeInput>) -> RustReferenceObservation {
  observe_rust_references(observed_at: planted_observed_tree, sources: sources, generated_repo_paths: [], tokens: v1_seed_link_tokens(), rows: rust_source_namespace_rows)
}

data cssl_assembly_path: String = "src/v1/stage0/src/cssl_seed_linked_closure_assembly.rs"

data behavioral_receipt_path: String = "src/v1/stage0/src/behavioral_receipt_host.rs"

data planted_cssl_test_source: String = "#[cfg(test)]\nmod tests {\n    fn normalize_stale_narrow_lib_without_namespace_graft_refuses_cargo() {\n        let toml = \"v1-compiler = {{ path = \\\"{}\\\" }}\";\n    }\n}\n"

data planted_extra_renderer_source: String = "pub fn another_minted_manifest() -> String {\n    \"v1-compiler = { path = \\\"x\\\" }\".to_string()\n}\n"

data planted_behavioral_source: String = "struct ReceiptCrate {\n    package: String,\n}\n\nimpl ReceiptCrate {\n    fn v1_compiler() -> Self {\n        Self {\n            package: \"v1-compiler\".to_string(),\n        }\n    }\n}\n"

data planted_other_impl_source: String = "struct Other {\n    package: String,\n}\n\nimpl Other {\n    fn seed() -> Self {\n        Self {\n            package: \"v1-compiler\".to_string(),\n        }\n    }\n}\n"

data planted_comment_only_source: String = "// the rendered rows carried `v1-compiler = { path = <workspace>/src/v1/stage0 }` once\npub fn documented() -> u32 {\n    1\n}\n"

fn clean_seed_link_observation() -> RustReferenceObservation {
  seed_link_observation(sources: [
    planted_source(path: cssl_assembly_path, content: planted_cssl_test_source),
    planted_source(path: behavioral_receipt_path, content: planted_behavioral_source),
  ])
}

fn join_of(sources: List<RustFileChangeInput>) -> MintedManifestJoin {
  v1_minted_manifest_join_over(observation: seed_link_observation(sources: sources))
}

fn the_manifest_join_is_clean_when_every_rostered_site_is_produced() -> Bool {
  let j = v1_minted_manifest_join_over(observation: clean_seed_link_observation())
  minted_manifest_join_is_clean(j: j)
    && count(v1_join_stale_renderers(j: j)) == 0
    && count(v1_join_uncitable_consumers(j: j)) == 1
    && (v1_join_uncitable_consumers(j: j) |> all(u => consumer_disposition_blocks(d: u.disposition)))
    && match j {
         MintedManifestJoined { observed_at: _, produced: p, undisposed_sites: _, undisposed_uncitable: _, uncitable: _, stale_rows: _, stale_uncitable: _, unattributed_lines: _ } =>
           count(p) == 1 && (p |> all(r => declaration_ref_display_key(ref: r) == "v1_compiler.cssl_seed_linked_closure_assembly.tests::normalize_stale_narrow_lib_without_namespace_graft_refuses_cargo"))
         MintedManifestJoinUnobserved { reason: _ } => false
       }
}

fn an_unrostered_seed_link_site_is_an_undecided_consumer_that_blocks() -> Bool {
  let j = join_of(sources: [
    planted_source(path: cssl_assembly_path, content: planted_cssl_test_source),
    planted_source(path: behavioral_receipt_path, content: planted_behavioral_source),
    planted_source(path: "src/v1/stage0/src/planted_extra.rs", content: planted_extra_renderer_source),
  ])
  !minted_manifest_join_is_clean(j: j)
    && count(v1_join_uncitable_consumers(j: j)) == 2
    && (v1_join_uncitable_consumers(j: j) |> all(u => consumer_disposition_blocks(d: u.disposition)))
    && (v1_join_uncitable_consumers(j: j) |> any(u => u.item_key == "v1_compiler.planted_extra::another_minted_manifest"))
}

// A STALE ROW SUBTRACTS A CONSUMER ROW ONLY BY ADDING A BLOCKING ONE THAT NAMES IT: the consumer
// count drops by one, and the uncitable column gains an Undecided row for the stale renderer.
fn a_rostered_renderer_the_tree_no_longer_carries_is_stale_and_excluded() -> Bool {
  let j = join_of(sources: [planted_source(path: behavioral_receipt_path, content: planted_behavioral_source)])
  !minted_manifest_join_is_clean(j: j)
    && count(v1_join_stale_renderers(j: j)) == 1
    && count(v1_join_uncitable_consumers(j: j)) == count(v1_join_uncitable_consumers(j: v1_minted_manifest_join_over(observation: clean_seed_link_observation()))) + 1
    && (v1_join_uncitable_consumers(j: j) |> any(u => consumer_disposition_blocks(d: u.disposition) && string_contains(s: u.refusal_detail, pattern: "stale row")))
    && (v1_join_stale_renderers(j: j) |> all(r => declaration_ref_display_key(ref: r) == "v1_compiler.cssl_seed_linked_closure_assembly.tests::normalize_stale_narrow_lib_without_namespace_graft_refuses_cargo"))
    && count(consumer_population_rows(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: seed_link_observation(sources: [planted_source(path: behavioral_receipt_path, content: planted_behavioral_source)]))))
       == count(consumer_population_rows(p: v1_consumer_population_for(observation: planted_observation(rows: rust_source_namespace_rows), seed_links: clean_seed_link_observation()))) - 1
}

fn an_unrostered_uncitable_site_is_undisposed_and_a_comment_is_not_a_site() -> Bool {
  let j = join_of(sources: [
    planted_source(path: cssl_assembly_path, content: planted_cssl_test_source),
    planted_source(path: behavioral_receipt_path, content: planted_behavioral_source),
    planted_source(path: "src/v1/stage0/src/planted_other.rs", content: planted_other_impl_source),
    planted_source(path: "src/v1/stage0/src/planted_comment.rs", content: planted_comment_only_source),
  ])
  match j {
    MintedManifestJoinUnobserved { reason: _ } => false
    MintedManifestJoined { observed_at: _, produced: p, undisposed_sites: a, undisposed_uncitable: b, uncitable: _, stale_rows: c, stale_uncitable: d, unattributed_lines: e } =>
      count(p) == 1 && count(a) == 0 && count(b) == 1 && count(c) == 0 && count(d) == 0 && count(e) == 0
        && (b |> all(k => k == "src/v1/stage0/src/planted_other.rs::impl_method::Other::seed"))
  }
}

// THE RELATION ITSELF: derived edges carry the partition's names, only seed edges become consumers,
// and the seed edges are exactly the hand tests manifest plus the minted rows.
fn the_manifest_relation_keys_on_the_package_graph() -> Bool {
  let all = v1_cargo_manifest_dependencies()
  let seed = v1_seed_manifest_dependencies()
  count(all) > count(seed)
    && (seed |> all(d => d.dependency_package == stage0_host_shell_package_name()))
    && (all |> filter(d => !cargo_dependency_is_seed_edge(d: d)) |> all(d => d.dependency_package != stage0_host_shell_package_name()))
    && count(seed |> filter(d => match d.origin {
         CargoManifestHandMaintained { repo_path: rp } => rp == "src/v1/tests/Cargo.toml"
         CargoManifestRenderedFromPartition { renderer: _ } => false
         CargoManifestMinted { renderer: _ } => false
       })) == 1
    && (all |> filter(d => match d.origin {
         CargoManifestRenderedFromPartition { renderer: _ } => true
         CargoManifestHandMaintained { repo_path: _ } => false
         CargoManifestMinted { renderer: _ } => false
       }) |> all(d => !cargo_dependency_is_seed_edge(d: d)))
}

