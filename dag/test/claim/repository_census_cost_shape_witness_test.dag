module test.claim.repository_census_cost_shape_witness

import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.lens.cost {
  AsymptoticClass,
  ClassConstant,
  ClassLog,
  ClassLinear,
  ClassLinearithmic,
  ClassPolynomial,
  ClassPolyLog,
  ClassExponential,
  ClassFactorial,
  ClassUnknown,
}
import v2.lens.enforcement.cost_coverage {
  CostCoverageFileReceipt,
  CostCoverageFnReceipt,
  CostCoverageFnVerdict,
  FnCostKnown,
  FnCostUnknown,
  FnBodyParseTreeOpaque,
  FnBodyNotLocated,
  CostCoverageIngestVerdict,
  IngestParsedClean,
  IngestRejected,
  cost_coverage_file_receipt,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data census_cost_shape_note: String = "THE COST CLAIM IS STRUCTURAL, DERIVED FROM THE SHAPE, NOT TIMED. What motivated this witness was a wall-clock measurement — the reconciliation this module guards was quadratic, and the std keyed-roster substrate proposed as its replacement measured 85ms, 318ms and 1273ms at 256, 512 and 1024 keys, so 4.00x per doubling. That measurement was the right instrument for DECIDING, and it is the wrong one for ENFORCING: a wall-clock assertion at two sizes is a change detector, it is dominated by host noise on the machines this repository runs on, and it says nothing about the shape of the code that produced it. So the enforced claim is derived instead by v2.lens.cost, which folds the Node kernel of the REAL parsed file and reports an AsymptoticClass per function. The subject is the live source at its repository path, ingested by cost_coverage_file_receipt, so this cannot pass against a hand-built Node model that has drifted from the module it claims to describe."

data census_cost_shape_subject: String = "dag/gunbc/repository_census_coverage.dag"

fn census_cost_shape_receipt() -> CostCoverageFileReceipt {
  cost_coverage_file_receipt(rel_path: census_cost_shape_subject)
}

data census_cost_shape_ingest_note: String = "INGEST IS ASSERTED SEPARATELY BECAUSE A REJECTED INGEST YIELDS ZERO FUNCTION ROWS, and a claim of the form no function is quadratic is VACUOUSLY TRUE over zero rows. That is the green-by-vacancy failure this repository has hit before: the assertion would keep passing if the file were renamed, emptied, or made unparseable. So the ingest verdict and the presence of rows are their own witnesses, and the shape claim below is only meaningful because they hold."

fn census_cost_shape_ingest_is_clean(receipt: CostCoverageFileReceipt) -> Bool {
  match receipt.ingest_verdict {
    IngestParsedClean => true
    IngestRejected { stage: _, reason: _ } => false
  }
}

fn census_cost_class_is_superlinear(class: AsymptoticClass) -> Bool {
  match class {
    ClassConstant => false
    ClassLog => false
    ClassLinear => false
    ClassLinearithmic => false
    ClassPolyLog { exponent: _ } => false
    ClassPolynomial { degree: _ } => true
    ClassExponential => true
    ClassFactorial => true
    ClassUnknown => false
  }
}

data census_cost_unknown_note: String = "ClassUnknown IS NOT COUNTED AS SUPERLINEAR AND IT IS NOT COUNTED AS SAFE EITHER. It means the lens could not derive a class, which is ignorance rather than an answer, and folding ignorance into either verdict is the state-space conflation DESIGN section 5 forbids — call it superlinear and the witness reds on a lens limitation, call it linear and an underived function passes as proven. It is therefore carried as its own counted quantity, asserted below to be what it actually is on this file rather than assumed to be zero."

fn census_cost_fn_is_superlinear(row: CostCoverageFnReceipt) -> Bool {
  match row.verdict {
    FnCostKnown { asymptotic_class: class } => census_cost_class_is_superlinear(class: class)
    FnCostUnknown { reason: _ } => false
    FnBodyParseTreeOpaque => false
    FnBodyNotLocated => false
  }
}

fn census_cost_fn_is_known(row: CostCoverageFnReceipt) -> Bool {
  match row.verdict {
    FnCostKnown { asymptotic_class: _ } => true
    FnCostUnknown { reason: _ } => false
    FnBodyParseTreeOpaque => false
    FnBodyNotLocated => false
  }
}

fn census_cost_superlinear_rows(receipt: CostCoverageFileReceipt) -> List<CostCoverageFnReceipt> {
  filter(receipt.fn_rows, row => census_cost_fn_is_superlinear(row: row))
}

test fn witness_the_census_coverage_module_ingests_clean() -> Bool {
  census_cost_shape_ingest_is_clean(receipt: census_cost_shape_receipt())
}

test fn witness_the_census_coverage_module_presents_function_rows() -> Bool {
  count(census_cost_shape_receipt().fn_rows) > 0
}

test fn witness_no_census_coverage_function_is_superlinear_by_shape() -> Bool {
  count(census_cost_superlinear_rows(receipt: census_cost_shape_receipt())) == 0
}

test fn witness_the_census_coverage_shape_claim_rests_on_derived_classes() -> Bool {
  count(filter(census_cost_shape_receipt().fn_rows, row => census_cost_fn_is_known(row: row))) > 0
}

data census_cost_control_note: String = "THE DISCRIMINATING CONTROL IS A REAL FILE THE LENS CALLS SUPERLINEAR, and it is what licenses the assertion above. Without it, no census coverage function is superlinear is satisfied by a lens that never returns a polynomial class at all — the assertion would be green because the instrument is blind, not because the subject is linear, which is the coverage-by-illusion tier DESIGN section 6 names. The control asserts the SAME predicate over a subject where it must come out the other way, so a lens that stopped discriminating reds here rather than passing silently everywhere."

data census_cost_control_subject: String = "dag/std/keyed_roster.dag"

fn census_cost_control_receipt() -> CostCoverageFileReceipt {
  cost_coverage_file_receipt(rel_path: census_cost_control_subject)
}

test fn witness_the_control_subject_ingests_clean() -> Bool {
  census_cost_shape_ingest_is_clean(receipt: census_cost_control_receipt())
}

test fn witness_the_control_subject_is_superlinear_by_shape() -> Bool {
  count(census_cost_superlinear_rows(receipt: census_cost_control_receipt())) > 0
}
