// Reads the wall figure out of the typed reading. A refusal answers a negative,
// which no claim below can mistake for a wattage.
fn node_wall(inputs: product.node_power_envelope.NodeElectricalInputs) -> Int {
  match product.node_power_envelope.node_draw(inputs: inputs) {
    NodeDrawDerived { dc_load: _, wall_draw: w } => std.measure.watt_count(w: w)
    NodeDrawRefused { cause: _ } => 0 - 1
  }
}

data q8030_node: product.node_power_envelope.NodeElectricalInputs = product.node_power_envelope.NodeElectricalInputs {
  label: "altrad8ud-q8030",
  sockets: 1,
  cpu: extdeps.cpu.ampere.altra_q8030_catalog,
  context: altrad8ud_context,
  memory: product.node_power_envelope.PopulationModuleRead { population: eight_module_population },
  dram_power_per_chip: std.measure.milliwatt(count: 400),
  board_idle_draw: std.measure.watt(count: 30),
  psu_rated_output: std.measure.watt(count: 550),
  psu_efficiency: product.node_power_envelope.Gold,
}

// THE 2DPC DOWNCLOCK IS RANK-DEPENDENT — the claim that survived the module
// deletion unchanged, now stated against the relocated function.
fn rate_at(dimms_per_channel: std.nat.Nat, rank_count: std.nat.Nat) -> std.nat.Nat {
  std.measure.megatransfers_per_second_count(
    r: product.node_power_envelope.effective_data_rate(
      context: mt_collins_context,
      dimms_per_channel: dimms_per_channel,
      rank_count: rank_count,
    ),
  )
}

test fn downclock_is_rank_dependent() -> Bool {
  rate_at(dimms_per_channel: 2, rank_count: 1) == 3200
    && rate_at(dimms_per_channel: 2, rank_count: 2) == 2933
    && rate_at(dimms_per_channel: 2, rank_count: 4) == 2400
    && rate_at(dimms_per_channel: 1, rank_count: 2) == 3200
}

// THE DERATING FIGURES ARE UNCITED, AND THE MODEL SAYS SO. They arrived as bare
// literals with the physics relocated from the deleted product.hardware_selection.
// Carrying them with a typed evidence standing makes the gap countable — this
// claim is what turns green the day a real citation lands, and it will need
// updating then, which is the point.
test fn the_two_dpc_ceilings_declare_themselves_uncited() -> Bool {
  count(product.node_power_envelope.altra_two_dpc_ceilings.rows) == 2
    && fold(product.node_power_envelope.altra_two_dpc_ceilings.rows, init: true, f: fn(acc, row) {
      acc && !product.node_power_envelope.ceiling_is_cited(evidence: row.evidence)
    })
}

// THE POPULATED DEPTH COMES FROM THE POPULATION, NOT FROM A FIELD BESIDE IT. A
// board that admits two DIMMs per channel but was populated one-deep is
// electrically one-deep, and the only authority for which happened is the
// PopulationOption's own coverage.
test fn the_populated_depth_is_read_from_the_population() -> Bool {
  product.node_power_envelope.populated_dimms_per_channel(population: sixteen_module_population) == 2
    && product.node_power_envelope.populated_dimms_per_channel(population: eight_module_population) == 1
}

// PSU SIZING IS COMPUTED, and its verdict carries both numbers. 161W of
// processor (the Q80-30's cited TDP, not a hand-authored typical draw) plus
// 115W of DRAM plus 30W of board is 306W at the DC rail; a Gold supply turns
// that into 340W at the wall. The DRAM figure counts the ECC devices as well as
// the data ones — eight 2Rx4 modules are 8 x 2 x 18 chips, not 8 x 2 x 16 —
// because the chip count comes from the module width against the ECC word:
// dram_chips_per_rank derives the count from the 72-bit ECC word rather than
// the 64-bit data word.
test fn psu_sizing_is_computed_from_the_cited_tdp() -> Bool {
  std.measure.watt_count(w: product.node_power_envelope.memory_power(population: eight_module_population, power_per_chip: std.measure.milliwatt(count: 400))) == 115
    && node_wall(inputs: q8030_node) == 340
    && match product.node_power_envelope.psu_adequacy(inputs: q8030_node) {
      PsuAdequate { dc_load: dc, rated: _, headroom: h } => std.measure.watt_count(w: dc) == 306 && std.measure.watt_count(w: h) == 244
      PsuUndersized { dc_load: _, rated: _, shortfall: _ } => false
      PsuUndecidable { cause: _ } => false
    }
}

// RED CONTROL: the same node behind a supply that cannot carry it reports the
// shortfall, not a Boolean false a buyer cannot act on.
test fn an_undersized_supply_reports_its_shortfall() -> Bool {
  let small = product.node_power_envelope.NodeElectricalInputs {
    label: "altrad8ud-q8030-undersized",
    sockets: 1,
    cpu: extdeps.cpu.ampere.altra_q8030_catalog,
    context: altrad8ud_context,
    memory: product.node_power_envelope.PopulationModuleRead { population: eight_module_population },
    dram_power_per_chip: std.measure.milliwatt(count: 400),
    board_idle_draw: std.measure.watt(count: 30),
    psu_rated_output: std.measure.watt(count: 250),
    psu_efficiency: product.node_power_envelope.Gold,
  }
  match product.node_power_envelope.psu_adequacy(inputs: small) {
    PsuUndersized { dc_load: dc, rated: r, shortfall: s } =>
      std.measure.watt_count(w: dc) == 306 && std.measure.watt_count(w: r) == 250 && std.measure.watt_count(w: s) == 56
    PsuAdequate { dc_load: _, rated: _, headroom: _ } => false
    PsuUndecidable { cause: _ } => false
  }
}

test fn memory_bandwidth_is_derived_from_the_populated_topology() -> Bool {
  std.measure.bandwidth_count(b: product.node_power_envelope.memory_bandwidth(context: altrad8ud_context, population: eight_module_population)) == 204800000000
    && std.measure.bandwidth_count(b: product.node_power_envelope.memory_bandwidth(context: mt_collins_context, population: sixteen_module_population)) == 187712000000
}

// A single-rank module cannot interleave, so it does not reach the bus's rated
// throughput even at its rated clock — the axis that made rank a real tradeoff
// rather than a preference.
test fn a_single_rank_population_does_not_reach_the_rated_bus() -> Bool {
  std.measure.bandwidth_count(b: product.node_power_envelope.memory_bandwidth(context: altrad8ud_context, population: sixteen_module_1rx4_population))
    < std.measure.bandwidth_count(b: product.node_power_envelope.memory_bandwidth(context: altrad8ud_context, population: eight_module_population))
}

test fn realizability_rejects_an_impossible_sku() -> Bool {
  extdeps.memory.types.dram_module_is_realizable(module: mod_2rx4_32g, jedec: extdeps.memory.jedec.ddr4_generation_catalog)
    && !extdeps.memory.types.dram_module_is_realizable(module: mod_1rx8_32g_impossible, jedec: extdeps.memory.jedec.ddr4_generation_catalog)
}

test fn a_real_part_computes_a_real_die_density() -> Bool {
  std.measure.byte_size_count(b: extdeps.memory.types.dram_module_required_die_density(module: mod_1rx4_16g)) == 1073741824
}

// DERIVED AND OBSERVED ARE TWO FACTS OF THE SAME SHAPE. A measurement that
// disagrees with the derivation is reported as the divergence it is; nothing
// here overwrites the derived figure with the measured one, and there is no
// function that would.
test fn a_measurement_beside_the_derivation_reports_the_divergence() -> Bool {
  let derived = match product.node_power_envelope.derived_wall_power(inputs: q8030_node) {
    DerivedWallPowerReading { reading: r } => r
    DerivedWallPowerRefused { cause: _ } => product.node_power_envelope.WallPowerMeasured { watts: std.measure.watt(count: 0), host: "unreachable" as std.types.NonEmptyStr, observed_at: 0 }
  }
  let measured_low = product.node_power_envelope.WallPowerMeasured {
    watts: std.measure.watt(count: 300),
    host: "srv1" as std.types.NonEmptyStr,
    observed_at: 1786600000000,
  }
  let measured_equal = product.node_power_envelope.WallPowerMeasured {
    watts: std.measure.watt(count: 340),
    host: "srv1" as std.types.NonEmptyStr,
    observed_at: 1786600000000,
  }
  match product.node_power_envelope.envelope_divergence(derived: derived, measured: measured_low) {
    DerivationReadsHigh { derived: d, measured: m, excess: e } =>
      std.measure.watt_count(w: d) == 340 && std.measure.watt_count(w: m) == 300 && std.measure.watt_count(w: e) == 40
    _ => false
  }
    && match product.node_power_envelope.envelope_divergence(derived: derived, measured: measured_equal) {
      EnvelopeAgrees { watts: w } => std.measure.watt_count(w: w) == 340
      _ => false
    }
}

// --- THE OPERATOR'S PENDING CONFIGURATION ---------------------------------------------------------
//
// ALTRAD8UD-1L2T, one Altra Max M128-30, eight 64 GiB RDIMMs — the population
// arriving now, whose exact part number has NOT been read. This is the
// configuration the home-versus-colo placement decision divides a power budget
// by, so it is pinned here rather than left to be recomputed by whoever needs
// it next.
//
// The claim is that the draw REFUSES. A 64 GiB DDR4 module can be 2Rx4, 4Rx4 or
// stacked-die, and those differ by a factor of two in device count; assuming
// 2Rx4 to keep the arithmetic runnable would publish a wattage a rack
// allocation would be sized on. The refusal names the read obligation, so what
// is missing is one part number rather than an unknown amount of work.

data sixty_four_gib_stick: std.measure.ByteSize = std.measure.byte_size(count: 68719476736)

data pending_altrad8ud_m12830_node: product.node_power_envelope.NodeElectricalInputs = product.node_power_envelope.NodeElectricalInputs {
  label: "altrad8ud-m12830-8x64",
  sockets: 1,
  cpu: extdeps.cpu.ampere.altra_max_m12830_catalog,
  context: altrad8ud_context,
  memory: product.node_power_envelope.PopulationModuleUnread {
    stick_capacity: sixty_four_gib_stick,
    dimm_count: 8,
    read_obligation: "read the part number off an arriving 64 GiB RDIMM and cite its catalog row: rank count and DRAM device width decide the chip count per rank, and a 64 GiB DDR4 module may be 2Rx4, 4Rx4 or stacked-die",
  },
  dram_power_per_chip: std.measure.milliwatt(count: 400),
  board_idle_draw: std.measure.watt(count: 30),
  psu_rated_output: std.measure.watt(count: 550),
  psu_efficiency: product.node_power_envelope.Gold,
}

test fn the_pending_configuration_refuses_its_draw_and_names_the_read() -> Bool {
  match product.node_power_envelope.node_draw(inputs: pending_altrad8ud_m12830_node) {
    NodeDrawRefused { cause: c } =>
      match c {
        MemoryModuleUnread { stick_capacity: cap, dimm_count: n, read_obligation: _ } =>
          std.measure.byte_size_count(b: cap) == 68719476736 && n == 8
      }
    NodeDrawDerived { dc_load: _, wall_draw: _ } => false
  }
}

// ...and the supply is UNDECIDABLE rather than adequate. A 550W supply against
// a 183W processor and a board looks comfortable until the memory it could not
// count is added, which is exactly the reading this arm refuses to give.
test fn the_pending_configuration_leaves_the_supply_undecidable() -> Bool {
  match product.node_power_envelope.psu_adequacy(inputs: pending_altrad8ud_m12830_node) {
    PsuUndecidable { cause: _ } => true
    PsuAdequate { dc_load: _, rated: _, headroom: _ } => false
    PsuUndersized { dc_load: _, rated: _, shortfall: _ } => false
  }
}

// CAPACITY STILL ANSWERS: the sticks state their capacity on the label, so the
// same node reports 512 GiB while refusing to report a wattage. Two questions,
// two evidence requirements — and a reader who only needed capacity is not
// blocked by a read obligation that does not bear on it.
test fn the_pending_configuration_still_answers_its_capacity() -> Bool {
  std.measure.byte_size_count(b: product.node_power_envelope.node_memory_capacity(inputs: pending_altrad8ud_m12830_node)) == 549755813888
}

// POSITIVE CONTROL, and the number the placement decision consumes the moment
// the sticks are qualified: the SAME node with the part read as a 2Rx4 64 GiB
// module derives 183W of processor plus 115W of DRAM plus 30W of board = 328W
// at the DC rail, 364W at the wall behind a Gold supply. If the refusal above
// were a modelling dead end rather than a missing read, this claim could not
// exist.
data rdimm_64g_2rx4: extdeps.memory.types.DramModuleCatalogRow = extdeps.memory.types.DramModuleCatalogRow {
  part_number: "GENERIC-64G-2RX4-3200",
  manufacturer: extdeps.vendor.sk_hynix.sk_hynix,
  generation: extdeps.memory.types.dram_generation_ddr4,
  capacity_bytes: sixty_four_gib_stick,
  data_rate_mts: 3200,
  ecc: true,
  buffering: extdeps.memory.types.Registered,
  chip_width: extdeps.memory.types.bit_width(count: 4),
  rank_count: 2,
}

data eight_by_64_population: gunbc.memory_provisioning.PopulationOption = gunbc.memory_provisioning.PopulationOption {
  module: rdimm_64g_2rx4,
  dimm_count: 8,
  coverage: gunbc.memory_provisioning.FullChannel { topology: extdeps.cpu.ampere_altra_platform_hw_design.platform.OneDimmPerChannel },
  total_bytes: std.measure.byte_size(count: 549755813888),
  margin_bytes: std.measure.byte_size(count: 0),
}

data qualified_altrad8ud_m12830_node: product.node_power_envelope.NodeElectricalInputs = product.node_power_envelope.NodeElectricalInputs {
  label: "altrad8ud-m12830-8x64-qualified",
  sockets: 1,
  cpu: extdeps.cpu.ampere.altra_max_m12830_catalog,
  context: altrad8ud_context,
  memory: product.node_power_envelope.PopulationModuleRead { population: eight_by_64_population },
  dram_power_per_chip: std.measure.milliwatt(count: 400),
  board_idle_draw: std.measure.watt(count: 30),
  psu_rated_output: std.measure.watt(count: 550),
  psu_efficiency: product.node_power_envelope.Gold,
}

test fn the_same_node_derives_its_draw_once_the_part_is_read() -> Bool {
  match product.node_power_envelope.node_draw(inputs: qualified_altrad8ud_m12830_node) {
    NodeDrawDerived { dc_load: dc, wall_draw: w } => std.measure.watt_count(w: dc) == 328 && std.measure.watt_count(w: w) == 364
    NodeDrawRefused { cause: _ } => false
  }
}
