  ByteSize,
  bandwidth_count,
  byte_size,
  byte_size_count,
  milliwatt,
  watt,
  watt_count,
}
import extdeps.vendor.sk_hynix { sk_hynix }
import extdeps.memory.jedec { ddr4_generation_catalog }
import extdeps.memory.types {
  DramModuleCatalogRow,
  Registered,
  bit_width,
  dram_generation_ddr4,
  dram_module_is_realizable,
  dram_module_required_die_density,
}
import extdeps.cpu.ampere { altra_q8030_catalog }
import extdeps.cpu.ampere_altra_platform_hw_design.platform { OneDimmPerChannel, TwoDimmsPerChannel }
import gunbc.memory_provisioning {
  FullChannel,
  PopulationOption,
  asrock_altrad8ud_1l2t_geometry,
  mt_collins_per_socket_geometry,
}
import product.node_power_envelope {
  DerivationReadsHigh,
  EnvelopeAgrees,
  Gold,
  MemoryElectricalContext,
  NodeElectricalInputs,
