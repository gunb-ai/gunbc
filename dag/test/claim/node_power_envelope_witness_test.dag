// The board geometries are the CITED upstream rows, not restated here: this
// module's context adds only the platform's rated transfer rate.
data altrad8ud_context: product.node_power_envelope.MemoryElectricalContext = product.node_power_envelope.MemoryElectricalContext {
  geometry: gunbc.memory_provisioning.asrock_altrad8ud_1l2t_geometry,
  max_data_rate: std.measure.megatransfers_per_second(count: 3200),
  two_dpc_ceilings: product.node_power_envelope.altra_two_dpc_ceilings,
}

data mt_collins_context: product.node_power_envelope.MemoryElectricalContext = product.node_power_envelope.MemoryElectricalContext {
  geometry: gunbc.memory_provisioning.mt_collins_per_socket_geometry,
  max_data_rate: std.measure.megatransfers_per_second(count: 3200),
  two_dpc_ceilings: product.node_power_envelope.altra_two_dpc_ceilings,
}

