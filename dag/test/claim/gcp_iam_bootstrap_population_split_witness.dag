data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── WHAT THESE CLAIMS ARE ABOUT ───────────────────────────
// The side chat's three structural findings on gunbc#14360 (relayed by warm-crane-219, 2026-10-19), each
// at the interface it names:
//   1. the root ceremony binds only root cells: one derivation, split into a ceremony population and a
//      delta population, disjoint, and widening the targets or grant sets moves the delta only;
//   3. no pool cell the observer cannot read is dropped as "nothing to do": the observer reads every
//      delta pool's policy, and a pool missing one cell surfaces exactly that cell;
//   4. a missing root cell names the ceremony that repairs THAT cell, not one ceremony for every root;
//   5-8. and what that means for the APNs accessor cell (node://adhoc-25c62174-378): it is DeltaOwned, so
//        no ceremony binds it and no operator-token ensure may either -- see the block at the foot.

data probe_secret: NonEmptyStr = "gunbc-bootstrap-split-probe-secret"

fn keys(bs: List<IamBootstrapBinding>) -> List<String> {
  map(bs, b => concat(iam_bootstrap_resource_key(resource: b.resource), cell_preimage(c: b.cell)))
}

fn same_cells(a: List<IamBootstrapBinding>, b: List<IamBootstrapBinding>) -> Bool {
  let ka = keys(bs: a)
  let kb = keys(bs: b)
  count(ka) == count(kb) && all(ka, k => any(kb, x => x == k))
}

// ── 1. ONE DERIVATION, TWO DISJOINT POPULATIONS ──────────────────────────────────────────────

test fn the_root_ceremony_population_does_not_move_when_targets_and_grant_sets_widen() -> Bool {
  let narrow_targets = gcp_iam_converge_targets.skip(n: 1)
  let narrow_secrets = gcp_iam_converge_grant_set_secrets().skip(n: 1)
  let wide_secrets = gcp_iam_converge_grant_set_secrets() + [probe_secret]
  let root_narrow = iam_bootstrap_root_ceremony_bindings_over(targets: narrow_targets, grant_set_secrets: narrow_secrets)
  let root_wide = iam_bootstrap_root_ceremony_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: wide_secrets)
  let delta_narrow = iam_bootstrap_delta_bindings_over(targets: narrow_targets, grant_set_secrets: narrow_secrets)
  let delta_wide = iam_bootstrap_delta_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: wide_secrets)
  count(gcp_iam_converge_targets) > 0
    && same_cells(a: root_narrow, b: root_wide)
    && count(delta_wide) > count(delta_narrow)
    && any(delta_wide, b => iam_bootstrap_resource_key(resource: b.resource) == iam_bootstrap_resource_key(resource: BootstrapSecret { secret: probe_secret }))
}

test fn the_ceremony_and_delta_populations_are_disjoint_and_cover_the_derivation() -> Bool {
  let all_cells = iam_bootstrap_capability_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets())
  let root = iam_bootstrap_root_ceremony_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets())
  let delta = iam_bootstrap_delta_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets())
  let kr = keys(bs: root)
  count(root) > 0 && count(delta) > 0
    && !any(keys(bs: delta), k => any(kr, x => x == k))
    && same_cells(a: all_cells, b: root + delta)
    && !any(delta, b => b.resource == BootstrapProject)
}

// ── 3. NO UNREAD POOL CELL IS "NOTHING TO DO" ────────────────────────────────────────────────

data delta_roster: List<IamBootstrapBinding> = iam_bootstrap_delta_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets())

fn bound_policy(cells: List<IamBootstrapBinding>) -> GcpPolicy {
  GcpPolicy { bindings: gcp_cells_bindings(cs: map(cells, b => b.cell)), etag: "e1", version: 3 }
}

fn read_in_place(s: IamBootstrapResource) -> BootstrapSubjectObservation {
  BootstrapSubjectObservation { subject: s, reading: match s {
    BootstrapProject => SubjectUnobservable
    BootstrapPool { pool: _ } => SubjectPolicyRead { policy: bound_policy(cells: subject_cells(roster: delta_roster, subject: s)) }
    BootstrapAccount { account: _ } => SubjectPolicyRead { policy: bound_policy(cells: subject_cells(roster: delta_roster, subject: s)) }
    BootstrapSecret { secret: _ } => SubjectPolicyRead { policy: bound_policy(cells: subject_cells(roster: delta_roster, subject: s)) }
    BootstrapBucket { bucket: _ } => SubjectPolicyRead { policy: bound_policy(cells: subject_cells(roster: delta_roster, subject: s)) }
  } }
}

fn delta_pools() -> List<IamBootstrapResource> {
  filter(roster_subjects(roster: delta_roster), s => match s { BootstrapPool { pool: _ } => true  BootstrapProject => false  BootstrapAccount { account: _ } => false  BootstrapSecret { secret: _ } => false  BootstrapBucket { bucket: _ } => false })
}

fn same_subject(a: IamBootstrapResource, b: IamBootstrapResource) -> Bool {
  iam_bootstrap_resource_key(resource: a) == iam_bootstrap_resource_key(resource: b)
}

test fn the_observer_reads_every_delta_pools_policy() -> Bool {
  count(delta_pools()) > 0
    && all(delta_pools(), p => match observer_reach(subject: p) { ObserverReadsPolicy => true  ObserverReadsSubjectOnly => false  ObserverHoldsNothing => false })
}

test fn an_answered_pool_without_its_policy_is_never_nothing_to_do() -> Bool {
  all(delta_pools(), p => {
    let obs = map(roster_subjects(roster: delta_roster), s => if same_subject(a: s, b: p) { BootstrapSubjectObservation { subject: s, reading: SubjectAnswered } } else { read_in_place(s: s) })
    match bootstrap_delta_over(roster: delta_roster, observations: obs) { BootstrapObserved { root_residual: _ } => false  BootstrapDeltaRequired { subjects: _, root_residual: _ } => true  BootstrapDeltaRefused { reasons: _ } => true }
  })
}

// THE MUTATION THE SIDE CHAT NAMED: drop the provider-role cell from an existing pool's policy, and
// exactly that cell is in the delta.
test fn a_pool_missing_its_provider_role_cell_surfaces_exactly_that_cell() -> Bool {
  let provider_role = iam_bootstrap_role_name(role: BootstrapApplyRole { role: ConvergeProviderRole }) as String
  count(delta_pools()) > 0 && all(delta_pools(), p => {
    let cells = subject_cells(roster: delta_roster, subject: p)
    let kept = filter(cells, b => b.cell.role != provider_role)
    let obs = map(roster_subjects(roster: delta_roster), s => if same_subject(a: s, b: p) { BootstrapSubjectObservation { subject: s, reading: SubjectPolicyRead { policy: bound_policy(cells: kept) } } } else { read_in_place(s: s) })
    count(kept) == count(cells) - 1 && match bootstrap_delta_over(roster: delta_roster, observations: obs) {
      BootstrapDeltaRequired { subjects: ss, root_residual: _ } => count(ss) == 1 && all(ss, x => same_subject(a: x.subject, b: p) && count(x.missing) == 1 && all(x.missing, m => m.cell.role == provider_role))
      BootstrapObserved { root_residual: _ } => false
      BootstrapDeltaRefused { reasons: _ } => false
    }
  })
}

// ── 4. A MISSING ROOT CELL NAMES THE CEREMONY THAT REPAIRS IT ────────────────────────────────

fn same_ceremony(a: TrustRootCeremony, b: TrustRootCeremony) -> Bool {
  match a {
    IamBootstrapApply => match b { IamBootstrapApply => true  ApprovalMacKeyProvision => false  OrgAdminAppKeyAccessConverge => false }
    ApprovalMacKeyProvision => match b { ApprovalMacKeyProvision => true  IamBootstrapApply => false  OrgAdminAppKeyAccessConverge => false }
    OrgAdminAppKeyAccessConverge => match b { OrgAdminAppKeyAccessConverge => true  IamBootstrapApply => false  ApprovalMacKeyProvision => false }
  }
}

test fn each_root_cell_names_its_own_repairing_ceremony() -> Bool {
  count(ceremony_trust_root_cells()) == 4
    && all(ceremony_trust_root_cells(), t => match root_cell_repair_ceremony(b: IamBootstrapBinding { resource: BootstrapSecret { secret: t.secret }, cell: t.cell }) { Present { value: c } => same_ceremony(a: c, b: t.ceremony)  Absent => false })
}

// ── THE CEREMONY'S STAGES EXECUTE THE SELECTOR (srv2 mutations N1, N1b) ───────────────────────
// gunbc.auth.gcp_iam_bootstrap folds exactly iam_bootstrap_stage_bindings / iam_bootstrap_stage_identities
// through executors that name no population, so these claims over the selector are claims over what
// the capabilities and identities stages do.
test fn the_capabilities_stage_binds_exactly_the_root_population_and_does_not_move_when_inputs_widen() -> Bool {
  let narrow = iam_bootstrap_stage_bindings_over(stage: BootstrapCapabilities, targets: gcp_iam_converge_targets.skip(n: 1), grant_set_secrets: gcp_iam_converge_grant_set_secrets().skip(n: 1))
  let wide = iam_bootstrap_stage_bindings_over(stage: BootstrapCapabilities, targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets() + [probe_secret])
  count(wide) > 0
    && same_cells(a: wide, b: iam_bootstrap_root_ceremony_bindings_over(targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets() + [probe_secret]))
    && same_cells(a: narrow, b: wide)
    && !any(wide, b => iam_bootstrap_resource_key(resource: b.resource) == iam_bootstrap_resource_key(resource: BootstrapSecret { secret: probe_secret }))
}

test fn the_identities_stage_creates_exactly_the_root_identities_and_does_not_move_when_targets_widen() -> Bool {
  let narrow = map(iam_bootstrap_stage_identities_over(stage: BootstrapIdentities, targets: []), i => i.federation.pool_id as String)
  let wide = map(iam_bootstrap_stage_identities_over(stage: BootstrapIdentities, targets: gcp_iam_converge_targets), i => i.federation.pool_id as String)
  count(narrow) == 3 && count(wide) == 3 && all(wide, x => any(narrow, y => y == x))
    && all(iam_bootstrap_stage_identities_over(stage: BootstrapIdentities, targets: gcp_iam_converge_targets), i => i.own_trust)
}

// ── THE APNs ACCESSOR CELL: WHICH POPULATION OWNS IT, AND WHAT UNBLOCKS IT ────────────────────
// node://adhoc-25c62174-378 asked whether srv1's read grant on approval-apns-auth-key goes through the root
// ceremony (a) or through a NEW operator-token gunbc.auth.gcp_secret_access secret_access_ensure_for entry
// (b), copying the MAC-key precedent. The model answers before anyone argues: the secret is absent from
// gunbc.auth.gcp_iam_trust_roots ceremony_trust_root_secrets, so secret_iam_owner answers BootstrapRostered
// and iam_bootstrap_cell_owner answers DeltaOwned -- the cell belongs to no ceremony, while the cells run
// 40251866941 refused on DO, and each names IamBootstrapApply as its repair. (b) would rebuild the
// per-credential fold the operator deleted on 2026-10-18 ("for ALL keys"). These claims hold that line at
// the selectors that decide it, so a future "just this one row" entry cannot land without breaking one.

data apns_lane: String = "approval APNs auth key (srv1 broker custody)"

data apns_secret_id: NonEmptyStr = "approval-apns-auth-key"

// The APNs grant cell, derived the way the converge derives it -- never re-spelled here.
fn apns_grant() -> SecretAccessGrant {
  fleet_accessor_grant(row: approval_apns_auth_key_accessor_row)
}

fn apns_cells() -> List<GcpIamBindingCell> {
  match grant_member_resolution() {
    GrantMemberResolved { member: m } => secret_access_desired_cells(member: m, grant: apns_grant())
    GrantMemberUnresolved { cause: _ } => []
  }
}

// THE ROW THE NODE TURNS ON exists, names the secret the operator added version 1 for on 2026-10-25, and is
// in the fold the converge selects. A lane rename is a real change here: it would silently drop srv1's
// grant from fleet_roster_grants and the custody read would keep refusing with nobody noticing.
test fn the_apns_accessor_row_is_rostered_for_the_secret_the_operator_added() -> Bool {
  (approval_apns_auth_key_accessor_row.target.secret as String) == (apns_secret_id as String)
    && approval_apns_auth_key_accessor_row.target.version == "1"
    && any(fleet_accessor_grant_roster, r => r.lane == apns_lane)
    && any(fleet_roster_grants(), g => (g.target.secret as String) == (apns_secret_id as String))
}

// THE DECISION, PINNED AT THE OWNER RELATION. Not a trust root => BootstrapRostered => DeltaOwned => no
// ceremony repairs it, and the very cells the refused run named ARE the ceremony's. If anyone later
// "fixes" srv1 by declaring this secret a trust root, this claim fails out loud rather than letting a
// ceremony swallow a roster cell.
test fn the_apns_accessor_cell_is_delta_owned_and_names_no_ceremony_repair() -> Bool {
  !ceremony_trust_root_secret(secret: apns_secret_id)
    && match secret_iam_owner(secret: apns_secret_id) {
        Present { value: BootstrapRostered } => true
        _ => false
      }
    && all(map(apns_cells(), c => IamBootstrapBinding { resource: BootstrapSecret { secret: apns_secret_id }, cell: c }), b => delta_owned(b: b))
    && all(map(apns_cells(), c => IamBootstrapBinding { resource: BootstrapSecret { secret: apns_secret_id }, cell: c }), b => root_cell_repair_ceremony(b: b) == none)
    // ... while every cell class the refusal named is the bootstrap ceremony's, and says so.
    && all(map(iam_bootstrap_journal_cells(), b => b), b => match root_cell_repair_ceremony(b: b) { Present { value: IamBootstrapApply } => true  _ => false })
    && any(iam_bootstrap_root_ceremony_bindings(), b => match b.resource {
        BootstrapPool { pool } => (pool as String) == (gcp_iam_observe_wif_pool_id as String)
        _ => false
      })
    && any(iam_bootstrap_root_ceremony_bindings(), b => match b.resource {
        BootstrapAccount { account } => (account as String) == (iam_observe_service_account as String)
        _ => false
      })
}

// WHAT DOES BIND IT, so "run the ceremony" is not a guess about the rest of the path. THE ROUTE, in the
// order the model actually runs it: the row is folded by fleet_roster_grants, the converge's grant-set
// selectors (gcp_iam_converge_grant_sets) select that roster fold, and plan_grant_set -- the pure step
// converge runs against a policy read -- turns the selected set's desired cells into the AddPolicyCells
// effect that reaches GCP. So there is no per-row entry to add and no second path: the ceremony establishes
// the writer identity that lets that plan be applied, and the accessor cell travels on the grant-set route.
// The grant set is SELECTED from the converge's own list, never re-spelled here: if no set selects the APNs
// grant there is no route and this claim says so by refusing (Absent), not by inventing an empty set.
fn apns_fleet_grant_set() -> Optional<GrantSet> {
  filter(gcp_iam_converge_grant_sets, g =>
    any(g.grants, x => (x.target.secret as String) == (apns_secret_id as String))
  ).first()
}

// An empty policy read over exactly the set's secrets: the shape the estate's first read comes back in for
// a secret nobody has granted on yet. Built from grant_set_secrets, the same selector plan_grant_set keys
// its "readings are exactly the set's secrets" guard on, so the plan cannot refuse on a key-set mismatch.
fn apns_empty_readings(g: GrantSet) -> List<SecretPolicyReading> {
  map(grant_set_secrets(g: g), x => SecretPolicyReading {
    secret: x,
    reading: PolicyObserved { policy: GcpPolicy { bindings: [], etag: "apns-witness-empty", version: 1 } },
  })
}

test fn the_apns_accessor_cell_reaches_gcp_through_the_converge_grant_set_plan() -> Bool {
  count(apns_cells()) == 1
    // (1) THE FOLD: fleet_roster_grants carries the row's grant for the secret.
    && any(fleet_roster_grants(), g => (g.target.secret as String) == (apns_secret_id as String))
    // (2) THE SELECTION: some converge grant set selects that grant, and the secret is in the converge's
    //     grant-set secret selectors.
    && any(gcp_iam_converge_grant_sets, s =>
      any(s.grants, x => (x.target.secret as String) == (apns_secret_id as String)))
    && any(gcp_iam_converge_grant_set_secrets(), s => (s as String) == (apns_secret_id as String))
    // (3) THE PLAN: plan_grant_set carries the accessor cell as an AddPolicyCells effect on the APNs
    //     secret. Matched on Present -- no selected set means no route, and that FAILS rather than
    //     planning over a fabricated empty set.
    && match apns_fleet_grant_set() {
        Present { value: g } => match plan_grant_set(g: g, member: g.member, secret_policies: apns_empty_readings(g: g)) {
          GcpIamApply { diff: d } => any(d.effects, e => match e {
            AddPolicyCells { subject: SecretPolicy { secret: s }, observed_etag: _, cells: cs } =>
              (s as String) == (apns_secret_id as String) && all(apns_cells(), c => gcp_cell_in(c: c, xs: cs))
            _ => false
          })
          _ => false
        }
        Absent => false
      }
    // (4) AND IT TRAVELS ON THAT ROUTE ALONE: the ceremony population never holds the APNs secret, and the
    //     capability population -- which holds a secret only as the policy-writer cells (secret.iamMember)
    //     and the observe cells (secret.versionGetter), never an accessor cell -- never holds this cell.
    && !any(iam_bootstrap_root_ceremony_bindings(), b => match b.resource {
        BootstrapSecret { secret } => (secret as String) == (apns_secret_id as String)
        _ => false
      })
    && all(iam_bootstrap_capability_bindings(), b => match b.resource {
        BootstrapSecret { secret } => (secret as String) != (apns_secret_id as String) || !gcp_cell_in(c: b.cell, xs: apns_cells())
        _ => true
      })
}


// ── THE 2026-10-27 CEREMONY THAT WENT GREEN WITHOUT WRITING ITS OWN CELLS ─────────
// fleet-converge run 40458649201 refused ROOT CEREMONY CELLS MISSING on five cells (the two WIF pool
// observe cells, iam-bootstrap's observe cell, and the two journal-bucket cells) while the ceremony at
// receipt iam-ceremony-20261027T055742Z had exited 0 with 10 of 12 stage receipts and no setIamPolicy
// anywhere in the REST log. The fork: the delta folded the owner relation, the ceremony folded the
// stage row. These claims weld the two sides to the ONE population and to the stage row, and pin the
// ceremony's post-run proof to fail closed (DESIGN section 5: a cell the ceremony cannot show bound is
// NOT established -- an absent or unreadable policy is not a green).

fn stage_wires(stages: List<IamBootstrapStage>) -> List<String> {
  map(stages, s => iam_bootstrap_stage_wire(stage: s))
}

// THE RUN FOLDS ALL TWELVE STAGES, IN ORDER, BY WIRE NAME. The expectation is spelled out HERE rather
// re-derived from the module, so this claim is what goes red when a stage leaves the run by any route:
// dropped from the order literal, or dropped because a population the stage owes went empty. On
// 2026-10-27 the run folded 10 stages, wrote no receipt for trust-root-tags or journal-bucket, and
// cost no refusal, because every in-run check folded over the run's own list.
test fn the_ceremony_folds_all_twelve_stages_in_order() -> Bool {
  stage_wires(stages: iam_bootstrap_stages) == [
    "services", "identities", "journal-bucket", "trust-root-tags", "roles", "deny",
    "authority-cleanup", "capabilities", "probe-authority", "privilege-readback",
    "probe-cleanup", "workflow-trust"
  ]
}

// THE ORDER LITERAL AND THE FOLDED ROW AGREE ON THE SET THE ESTATE OWES: every owed stage is in the
// run and nothing unowed is, so the run cannot fold a stage nobody owes nor skip one everybody does.
test fn the_folded_run_is_exactly_the_owed_stages_in_declared_order() -> Bool {
  let owed = filter(iam_bootstrap_stage_order, s => iam_bootstrap_stage_owed(stage: s))
  count(owed) == count(iam_bootstrap_stages)
    && stage_wires(stages: owed) == stage_wires(stages: iam_bootstrap_stages)
}

// THE TWO STAGES THE INCIDENT RUN LOST ARE OWED, so a row that drops them fails the claim above
// rather than the ceremony.
test fn trust_root_tags_and_journal_bucket_are_owed_stages() -> Bool {
  iam_bootstrap_stage_owed(stage: BootstrapTrustRootTags)
    && iam_bootstrap_stage_owed(stage: BootstrapJournalBucket)
}

// ONE STAGE OWNS THE BUCKET AND THE CELLS ON IT: the journal stage declares its cells through the
// model's single journal population (not a copied list), so the stage that creates the bucket is the
// stage that binds them, and the ceremony's proof reads the same population back.
test fn the_journal_stage_declares_the_journal_cells_it_makes_readable() -> Bool {
  let declared = iam_bootstrap_stage_bindings(stage: BootstrapJournalBucket)
  count(declared) == count(iam_bootstrap_journal_cells())
    && all(iam_bootstrap_journal_cells(), b => any(declared, d => d.cell.role == b.cell.role && d.cell.member == b.cell.member))
    && all(declared, b => any(iam_bootstrap_ceremony_owned_cells(), c => c.cell.role == b.cell.role && c.cell.member == b.cell.member))
}

// THE PROOF FOLDS EXACTLY THE POPULATION THE DELTA BLAMES THIS CEREMONY FOR: the cells whose owner
// relation says IamBootstrapApply. If the two sides ever derive from different lists again, this is
// the claim that goes red -- which is the meaning fork that let the ceremony green over five cells.
test fn the_post_run_proof_population_is_the_deltas_root_cell_population() -> Bool {
  let proved = iam_bootstrap_ceremony_owned_cells()
  count(proved) > 0
    && all(proved, b => any(iam_bootstrap_root_ceremony_bindings(), c => c.cell.role == b.cell.role && c.cell.member == b.cell.member && iam_bootstrap_resource_key(resource: c.resource) == iam_bootstrap_resource_key(resource: b.resource)))
    && count(proved) == count(iam_bootstrap_root_ceremony_bindings())
}

// THE PROOF REFUSES, IN THE DELTA'S OWN WORDS, WHEN A CELL IT OWNS IS NOT BOUND (both sides call the
// cell through ceremony_cell_phrase, so one fact is one string); a fully bound reading is silent.
test fn the_proof_names_an_unbound_cell_with_the_shared_phrase() -> Bool {
  let cell = iam_bootstrap_journal_cells().first()
  match cell {
    Present { value: b } => {
      let bound = CeremonySubjectReading { subject: b.resource, reading: PolicyObserved { policy: GcpPolicy { bindings: gcp_cells_bindings(cs: [b.cell]), etag: "w", version: 1 } } }
      let unbound = CeremonySubjectReading { subject: b.resource, reading: PolicyObserved { policy: GcpPolicy { bindings: [], etag: "w", version: 1 } } }
      count(ceremony_unestablished_cell_phrases(readings: [bound])) == 0
      && ceremony_owned_proof_refusal(readings: [bound]) == ""
      && ceremony_owned_proof_refusal(readings: [unbound]) != ""
      && count(filter(ceremony_unestablished_cell_phrases(readings: [unbound]), p => p == ceremony_cell_phrase(b: b))) == 1
    }
    Absent => false
  }
}

// FAIL CLOSED: an unreadable policy and a never-read subject are both NOT established -- "no evidence
// of absence" never means "present" (DESIGN section 5).
test fn unreadable_or_unread_policies_are_not_established() -> Bool {
  let cell = iam_bootstrap_journal_cells().first()
  match cell {
    Present { value: b } => {
      let unreadable = CeremonySubjectReading { subject: b.resource, reading: PolicyUnreadable { cause: "403" } }
      count(ceremony_unestablished_cell_phrases(readings: [unreadable])) == 1
      && count(ceremony_unestablished_cell_phrases(readings: [])) == count(iam_bootstrap_ceremony_owned_cells())
      && count(filter(ceremony_unestablished_cell_phrases(readings: [unreadable]), p => p == concat(ceremony_cell_phrase(b: b), " (policy unreadable: 403)"))) == 1
    }
    Absent => false
  }
}

// AN ABSENT POLICY RESOURCE IS NOT ESTABLISHED either (the bucket stage must have created it first).
test fn an_absent_policy_is_not_established() -> Bool {
  let cell = iam_bootstrap_journal_cells().first()
  match cell {
    Present { value: b } => {
      let absent_reading = CeremonySubjectReading { subject: b.resource, reading: PolicyResourceAbsent }
      count(ceremony_unestablished_cell_phrases(readings: [absent_reading])) == 1
        && ceremony_owned_proof_refusal(readings: [absent_reading]) != ""
    }
    Absent => false
  }
}
