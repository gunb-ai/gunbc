module test.claim.hermetic_fixture_realization


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data shared_input_digest: ContentHash = "hermetic-fixture-witness-shared-input-digest"

fn witness_file_handler_is_content_addressed_reference() -> Bool {
  let f = extdeps.cache.cache.cache_interface_facts_from_catalog(row: extdeps.realization.hermetic_fixture.hermetic_fixture_file_facts)
  (extdeps.cache.types.catalog_key_derivation_classification(kd: extdeps.realization.hermetic_fixture.hermetic_fixture_file_facts.key_derivation) == std.cache_interface.ContentAddressedByValue)
    && f.key_derivation.content_verified_on_read
    && (f.locality == std.cache_interface.PerHostFilesystem)
    && (f.value_shape == StructuredArtifact)
}

fn witness_in_process_handler_is_content_addressed_converged() -> Bool {
  let m = extdeps.cache.cache.cache_interface_facts_from_catalog(row: extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_facts)
  (extdeps.cache.types.catalog_key_derivation_classification(kd: extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_facts.key_derivation) == std.cache_interface.ContentAddressedByValue)
    && m.key_derivation.content_verified_on_read
    && (m.locality == std.cache_interface.InProcess)
    && (m.value_shape == StructuredArtifact)
}

fn witness_handlers_converged_on_key_derivation() -> Bool {
  let f = extdeps.cache.cache.cache_interface_facts_from_catalog(row: extdeps.realization.hermetic_fixture.hermetic_fixture_file_facts)
  let m = extdeps.cache.cache.cache_interface_facts_from_catalog(row: extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_facts)
  let f_class = extdeps.cache.types.catalog_key_derivation_classification(kd: extdeps.realization.hermetic_fixture.hermetic_fixture_file_facts.key_derivation)
  let m_class = extdeps.cache.types.catalog_key_derivation_classification(kd: extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_facts.key_derivation)
  (f_class == m_class)
    && (f_class == std.cache_interface.ContentAddressedByValue)
    && f.key_derivation.content_verified_on_read
    && m.key_derivation.content_verified_on_read
    && !(f.locality == m.locality)
}

fn witness_handlers_share_kernel_invariants() -> Bool {
  let f = extdeps.cache.cache.cache_interface_facts_from_catalog(row: extdeps.realization.hermetic_fixture.hermetic_fixture_file_facts)
  let m = extdeps.cache.cache.cache_interface_facts_from_catalog(row: extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_facts)
  (f.value_shape == m.value_shape)
    && (f.miss_semantics == std.cache_interface.MissIsDiagnostic)
    && (m.miss_semantics == std.cache_interface.MissIsDiagnostic)
}

fn witness_one_artifact_routes_to_both_backends() -> Bool {
  let id = std.cache_interface.ArtifactIdentity {
    subject_digest: shared_input_digest,
    artifact_kind: std.cache_identity.hermetic_fixture_artifact_kind,
  }
  let file_key = extdeps.cache.cache.cache_key_projection_transport(artifact: id, backend: extdeps.realization.hermetic_fixture.hermetic_fixture_file_facts)
  let mem_key = extdeps.cache.cache.cache_key_projection_transport(artifact: id, backend: extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_facts)
  (file_key.store == extdeps.realization.hermetic_fixture.hermetic_fixture_file_store_id)
    && (mem_key.store == extdeps.realization.hermetic_fixture.hermetic_fixture_in_process_id)
    && !(file_key.store == mem_key.store)
}

test fn hermetic_fixture_realization_witnesses() -> Bool {
  witness_file_handler_is_content_addressed_reference()
    && witness_in_process_handler_is_content_addressed_converged()
    && witness_handlers_converged_on_key_derivation()
    && witness_handlers_share_kernel_invariants()
    && witness_one_artifact_routes_to_both_backends()
}
