module test.claim.bach_double_slit_path_additivity_synthetic_fixture_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn w_synthetic_path_additivity_refuted_by_fold_derivation() -> Bool {
  match synthetic_first_minimum_verdict() {
    PathAdditivityRefutationAtBand { receipt: receipt } =>
      path_additivity_refutation_holds_for_synthetic_fixture(receipt: receipt)
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_fold_receipt_resolution_matches_kernel_counts() -> Bool {
  synthetic_fold_receipt_resolution_matches_kernel_counts()
}

test fn w_synthetic_equal_counts_do_not_resolve_refutation_receipt() -> Bool {
  match path_additivity_refutation_receipt_resolution_from_resolved_counts(
    left: 10,
    right: 10,
    both: 20,
    band: FirstMinimumBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  ) {
    RefutationReceiptResolved { receipt: fabricated_receipt } => false
    RefutationNotEstablished { reason: AdditivityHeld { band: held_band, exposure: held_exposure } } => true
    RefutationNotEstablished { reason: AdditivityUndecided { failure: undecided_failure } } => false
  }
}

test fn w_synthetic_held_verdict_does_not_resolve_refutation_receipt() -> Bool {
  match refutation_receipt_resolution_from_band_verdict(
    verdict: gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand {
      band: FirstMinimumBand,
      exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
    },
  ) {
    RefutationReceiptResolved { receipt: fabricated_receipt } => false
    RefutationNotEstablished { reason: AdditivityHeld { band: held_band, exposure: held_exposure } } => true
    RefutationNotEstablished { reason: AdditivityUndecided { failure: undecided_failure } } => false
  }
}

test fn w_synthetic_undecided_verdict_does_not_resolve_refutation_receipt() -> Bool {
  match refutation_receipt_resolution_from_band_verdict(
    verdict: synthetic_derive_first_minimum_verdict_from_partial_rows(),
  ) {
    RefutationReceiptResolved { receipt: fabricated_receipt } => false
    RefutationNotEstablished { reason: AdditivityUndecided { failure: undecided_failure } } => true
    RefutationNotEstablished { reason: AdditivityHeld { band: held_band, exposure: held_exposure } } => false
  }
}

test fn w_synthetic_path_additivity_rejects_fabricated_both_open_count() -> Bool {
  match bach_double_slit_path_additivity_first_minimum_verdict {
    PathAdditivityRefutationAtBand { receipt: canonical_receipt } => {
      let witness = canonical_receipt.witness
      let fabricated = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityCounterexampleWitness {
        left_alternative_count: witness.left_alternative_count,
        right_alternative_count: witness.right_alternative_count,
        both_open_observed_count: path_additivity_witness_classical_additive_prediction(witness: witness),
      }
      let bad_receipt = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt {
        subject: path_additivity_subject,
        witness: fabricated,
        location: canonical_receipt.location,
      }
      !synthetic_path_additivity_receipt_matches_fold_kernel(
        receipt: bad_receipt,
        band: FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      )
    }
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_path_additivity_rejects_corrupted_left_count() -> Bool {
  match bach_double_slit_path_additivity_first_minimum_verdict {
    PathAdditivityRefutationAtBand { receipt: canonical_receipt } => {
      let witness = canonical_receipt.witness
      let fabricated = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityCounterexampleWitness {
        left_alternative_count: witness.left_alternative_count + 1,
        right_alternative_count: witness.right_alternative_count,
        both_open_observed_count: witness.both_open_observed_count,
      }
      let bad_receipt = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt {
        subject: path_additivity_subject,
        witness: fabricated,
        location: canonical_receipt.location,
      }
      !synthetic_path_additivity_receipt_matches_fold_kernel(
        receipt: bad_receipt,
        band: FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      )
    }
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_path_additivity_rejects_additive_equal_observed() -> Bool {
  match bach_double_slit_path_additivity_first_minimum_verdict {
    PathAdditivityRefutationAtBand { receipt: canonical_receipt } => {
      let fabricated = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityCounterexampleWitness {
        left_alternative_count: 10,
        right_alternative_count: 10,
        both_open_observed_count: 20,
      }
      let bad_receipt = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt {
        subject: path_additivity_subject,
        witness: fabricated,
        location: canonical_receipt.location,
      }
      !synthetic_path_additivity_receipt_matches_fold_kernel(
        receipt: bad_receipt,
        band: FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      )
    }
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_derive_undecided_carries_incomplete_failure() -> Bool {
  match synthetic_derive_first_minimum_verdict_from_partial_rows() {
    PathAdditivityUndecidedAtBand {
      failure: AdditivityInputMissing {
        missing_arrangement: SlitTwoOpen,
        band: incomplete_band,
        exposure: incomplete_exposure,
      },
    } => true
    PathAdditivityRefutationAtBand { receipt: refutation_receipt } => false
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
  }
}

test fn w_synthetic_central_band_verdict_is_refutation_not_held_or_undecided() -> Bool {
  match synthetic_central_band_verdict() {
    PathAdditivityRefutationAtBand { receipt: refutation_receipt } => true
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_central_band_refutes_with_observed_above_prediction() -> Bool {
  bach_double_slit_path_additivity_central_band_refutation_holds()
}

test fn w_synthetic_blocked_count_is_resolved_zero_not_missing() -> Bool {
  synthetic_blocked_count_is_resolved_zero_not_missing()
}

test fn w_synthetic_missing_row_yields_incomplete_inputs() -> Bool {
  synthetic_missing_row_yields_incomplete_inputs()
}

test fn w_synthetic_path_additivity_subject_is_synthetic_fixture_coproduct() -> Bool {
  path_additivity_subject == gunbc.physics.bach_double_slit_path_additivity.PathAdditivitySyntheticFixture {}
}

test fn w_synthetic_compare_orientation_first_arg_is_observed() -> Bool {
  path_additivity_compare_observed_to_prediction(observed_both: 5, prediction: 20) == Less
    && path_additivity_compare_observed_to_prediction(observed_both: 95, prediction: 78) == Greater
}

test fn w_synthetic_first_minimum_witness_less_than_prediction() -> Bool {
  match bach_double_slit_path_additivity_first_minimum_verdict {
    PathAdditivityRefutationAtBand { receipt: canonical_receipt } =>
      canonical_receipt.witness.both_open_observed_count == 5
        && path_additivity_witness_classical_additive_prediction(witness: canonical_receipt.witness) == 20
        && path_additivity_witness_observed_vs_prediction(witness: canonical_receipt.witness) == Less
    PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}
