module test.claim.bach_double_slit_path_additivity_synthetic_fixture_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn w_synthetic_path_additivity_refuted_by_fold_derivation() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_first_minimum_verdict() {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: receipt } =>
      gunbc.physics.bach_double_slit_path_additivity.path_additivity_refutation_holds_for_synthetic_fixture(receipt: receipt)
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_fold_receipt_resolution_matches_kernel_counts() -> Bool {
  gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_fold_receipt_resolution_matches_kernel_counts()
}

test fn w_synthetic_equal_counts_do_not_resolve_refutation_receipt() -> Bool {
  match gunbc.physics.bach_double_slit_path_additivity.path_additivity_refutation_receipt_resolution_from_resolved_counts(
    left: 10,
    right: 10,
    both: 20,
    band: gunbc.physics.bach_double_slit_path_additivity.FirstMinimumBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  ) {
    gunbc.physics.bach_double_slit_path_additivity.RefutationReceiptResolved { receipt: fabricated_receipt } => false
    gunbc.physics.bach_double_slit_path_additivity.RefutationNotEstablished { reason: gunbc.physics.bach_double_slit_path_additivity.AdditivityHeld { band: held_band, exposure: held_exposure } } => true
    gunbc.physics.bach_double_slit_path_additivity.RefutationNotEstablished { reason: gunbc.physics.bach_double_slit_path_additivity.AdditivityUndecided { failure: undecided_failure } } => false
  }
}

test fn w_synthetic_held_verdict_does_not_resolve_refutation_receipt() -> Bool {
  match gunbc.physics.bach_double_slit_path_additivity.refutation_receipt_resolution_from_band_verdict(
    verdict: gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand {
      band: gunbc.physics.bach_double_slit_path_additivity.FirstMinimumBand,
      exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
    },
  ) {
    gunbc.physics.bach_double_slit_path_additivity.RefutationReceiptResolved { receipt: fabricated_receipt } => false
    gunbc.physics.bach_double_slit_path_additivity.RefutationNotEstablished { reason: gunbc.physics.bach_double_slit_path_additivity.AdditivityHeld { band: held_band, exposure: held_exposure } } => true
    gunbc.physics.bach_double_slit_path_additivity.RefutationNotEstablished { reason: gunbc.physics.bach_double_slit_path_additivity.AdditivityUndecided { failure: undecided_failure } } => false
  }
}

test fn w_synthetic_undecided_verdict_does_not_resolve_refutation_receipt() -> Bool {
  match gunbc.physics.bach_double_slit_path_additivity.refutation_receipt_resolution_from_band_verdict(
    verdict: gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_derive_first_minimum_verdict_from_partial_rows(),
  ) {
    gunbc.physics.bach_double_slit_path_additivity.RefutationReceiptResolved { receipt: fabricated_receipt } => false
    gunbc.physics.bach_double_slit_path_additivity.RefutationNotEstablished { reason: gunbc.physics.bach_double_slit_path_additivity.AdditivityUndecided { failure: undecided_failure } } => true
    gunbc.physics.bach_double_slit_path_additivity.RefutationNotEstablished { reason: gunbc.physics.bach_double_slit_path_additivity.AdditivityHeld { band: held_band, exposure: held_exposure } } => false
  }
}

test fn w_synthetic_path_additivity_rejects_fabricated_both_open_count() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.bach_double_slit_path_additivity_first_minimum_verdict {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: canonical_receipt } => {
      let witness = canonical_receipt.witness
      let fabricated = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityCounterexampleWitness {
        left_alternative_count: witness.left_alternative_count,
        right_alternative_count: witness.right_alternative_count,
        both_open_observed_count: gunbc.physics.bach_double_slit_path_additivity.path_additivity_witness_classical_additive_prediction(witness: witness),
      }
      let bad_receipt = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt {
        subject: gunbc.bach_double_slit_path_additivity_synthetic_fixture.path_additivity_subject,
        witness: fabricated,
        location: canonical_receipt.location,
      }
      !gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_path_additivity_receipt_matches_fold_kernel(
        receipt: bad_receipt,
        band: gunbc.physics.bach_double_slit_path_additivity.FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      )
    }
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_path_additivity_rejects_corrupted_left_count() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.bach_double_slit_path_additivity_first_minimum_verdict {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: canonical_receipt } => {
      let witness = canonical_receipt.witness
      let fabricated = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityCounterexampleWitness {
        left_alternative_count: witness.left_alternative_count + 1,
        right_alternative_count: witness.right_alternative_count,
        both_open_observed_count: witness.both_open_observed_count,
      }
      let bad_receipt = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt {
        subject: gunbc.bach_double_slit_path_additivity_synthetic_fixture.path_additivity_subject,
        witness: fabricated,
        location: canonical_receipt.location,
      }
      !gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_path_additivity_receipt_matches_fold_kernel(
        receipt: bad_receipt,
        band: gunbc.physics.bach_double_slit_path_additivity.FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      )
    }
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_path_additivity_rejects_additive_equal_observed() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.bach_double_slit_path_additivity_first_minimum_verdict {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: canonical_receipt } => {
      let fabricated = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityCounterexampleWitness {
        left_alternative_count: 10,
        right_alternative_count: 10,
        both_open_observed_count: 20,
      }
      let bad_receipt = gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt {
        subject: gunbc.bach_double_slit_path_additivity_synthetic_fixture.path_additivity_subject,
        witness: fabricated,
        location: canonical_receipt.location,
      }
      !gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_path_additivity_receipt_matches_fold_kernel(
        receipt: bad_receipt,
        band: gunbc.physics.bach_double_slit_path_additivity.FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      )
    }
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_derive_undecided_carries_incomplete_failure() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_derive_first_minimum_verdict_from_partial_rows() {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand {
      failure: gunbc.physics.bach_double_slit_path_additivity.AdditivityInputMissing {
        missing_arrangement: extdeps.physics.bach_et_al_2013_double_slit.SlitTwoOpen,
        band: incomplete_band,
        exposure: incomplete_exposure,
      },
    } => true
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: refutation_receipt } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
  }
}

test fn w_synthetic_central_band_verdict_is_refutation_not_held_or_undecided() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_central_band_verdict() {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: refutation_receipt } => true
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

test fn w_synthetic_central_band_refutes_with_observed_above_prediction() -> Bool {
  gunbc.bach_double_slit_path_additivity_synthetic_fixture.bach_double_slit_path_additivity_central_band_refutation_holds()
}

test fn w_synthetic_blocked_count_is_resolved_zero_not_missing() -> Bool {
  gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_blocked_count_is_resolved_zero_not_missing()
}

test fn w_synthetic_missing_row_yields_incomplete_inputs() -> Bool {
  gunbc.bach_double_slit_path_additivity_synthetic_fixture.synthetic_missing_row_yields_incomplete_inputs()
}

test fn w_synthetic_path_additivity_subject_is_synthetic_fixture_coproduct() -> Bool {
  gunbc.bach_double_slit_path_additivity_synthetic_fixture.path_additivity_subject == gunbc.physics.bach_double_slit_path_additivity.PathAdditivitySyntheticFixture {}
}

test fn w_synthetic_compare_orientation_first_arg_is_observed() -> Bool {
  gunbc.physics.bach_double_slit_path_additivity.path_additivity_compare_observed_to_prediction(observed_both: 5, prediction: 20) == std.algebra.Less
    && gunbc.physics.bach_double_slit_path_additivity.path_additivity_compare_observed_to_prediction(observed_both: 95, prediction: 78) == std.algebra.Greater
}

test fn w_synthetic_first_minimum_witness_less_than_prediction() -> Bool {
  match gunbc.bach_double_slit_path_additivity_synthetic_fixture.bach_double_slit_path_additivity_first_minimum_verdict {
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationAtBand { receipt: canonical_receipt } =>
      canonical_receipt.witness.both_open_observed_count == 5
        && gunbc.physics.bach_double_slit_path_additivity.path_additivity_witness_classical_additive_prediction(witness: canonical_receipt.witness) == 20
        && gunbc.physics.bach_double_slit_path_additivity.path_additivity_witness_observed_vs_prediction(witness: canonical_receipt.witness) == std.algebra.Less
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityHeldAtBand { band: held_band, exposure: held_exposure } => false
    gunbc.physics.bach_double_slit_path_additivity.PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}
