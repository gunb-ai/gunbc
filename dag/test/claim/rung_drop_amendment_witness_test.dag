module test.claim.rung_drop_amendment_witness_test

import std.types { String, Bool, List, NonEmptyStr }
import gunbc.rung_drop_amendment {
  RungDropAmendment, TriggerStandsWhole, TriggerSuperseded,
  rung_drop_amendment_message, every_amendment_names_a_rostered_drop,
}
import gunbc.rung_drop_amendment.roster { rung_drop_amendment_roster, amendments_for_drop }
import gunbc.rung_drop_amendment.namespace_wave_admission_carrier_redesign {
  namespace_wave_admission_carrier_redesign,
}
import gunbc.rung_drop.roster { rung_drop_roster }

// AN AMENDMENT NAMING NO DROP. It is the discriminating RED for the join: a check that answered
// true for a dangling key would agree with the live roster and be caught here.
data control_dangling_amendment: RungDropAmendment = RungDropAmendment {
  drop_identity: "control.no.such.drop" as NonEmptyStr,
  amended: "2026-01-01",
  later_event: "control later event" as NonEmptyStr,
  bearing: "control bearing" as NonEmptyStr,
  trigger: TriggerSuperseded { replacement: "control replacement trigger" as NonEmptyStr },
}

fn rostered_drop_identities() -> List<String> {
  map(rung_drop_roster, d => (d.identity as String))
}

fn contains_text(haystack: String, needle: String) -> Bool {
  haystack.contains(needle)
}

// EVERY AMENDMENT JOINS TO A ROSTERED DROP, AND A DANGLING ONE DOES NOT. Both directions, because
// a predicate stuck at true and one stuck at false are different defects.
test fn every_amendment_names_a_drop_that_exists() -> Bool {
  every_amendment_names_a_rostered_drop(
    amendments: rung_drop_amendment_roster,
    drop_identities: rostered_drop_identities(),
  ) && !every_amendment_names_a_rostered_drop(
    amendments: [control_dangling_amendment],
    drop_identities: rostered_drop_identities(),
  )
}

// THE JOIN THE PROJECTION FOLDS SELECTS BY IDENTITY AND NOT BY POSITION. The live drop has one
// amendment; a drop that has none gets none.
test fn amendments_are_selected_by_drop_identity() -> Bool {
  length(xs: amendments_for_drop(identity: "namespace_wave_admission_wall_removed" as NonEmptyStr)) == 1
    && length(xs: amendments_for_drop(identity: "floor_cut_heal" as NonEmptyStr)) == 0
}

// THE RENDERING CARRIES THE RESCUED REASONING AND ITS CONSEQUENCE. The needles are the two facts
// the paragraph exists to keep -- that the carrier redesign had already landed, and that the ruling
// priced the gate itself -- plus the trigger sentence that keeps the amendment from being read as a
// change to the restoration trigger.
test fn the_amendment_renders_its_reasoning_and_its_trigger_effect() -> Bool {
  let rendered = rung_drop_amendment_message(a: namespace_wave_admission_carrier_redesign)
  contains_text(haystack: rendered, needle: "gunbc#11704")
    && contains_text(haystack: rendered, needle: "prices the gate itself")
    && contains_text(haystack: rendered, needle: "The restoration trigger above stands whole.")
    && !contains_text(haystack: rendered, needle: "superseded")
}

// A SUPERSEDING AMENDMENT RENDERS DIFFERENTLY, which is what makes the arm above an assertion
// rather than a constant. A renderer that ignored the trigger arm would fail here.
test fn a_superseding_amendment_renders_its_replacement() -> Bool {
  let rendered = rung_drop_amendment_message(a: control_dangling_amendment)
  contains_text(haystack: rendered, needle: "is superseded: control replacement trigger.")
    && !contains_text(haystack: rendered, needle: "stands whole")
}
