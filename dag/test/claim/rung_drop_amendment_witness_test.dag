module test.claim.rung_drop_amendment_witness_test

import std.types { String, Bool, List, NonEmptyStr }
import gunbc.rung_drop_amendment {
  RungDropAmendment, rung_drop_amendment_message, every_amendment_names_a_rostered_drop,
}
import gunbc.rung_drop { Standing, Retired }
import gunbc.rung_drop_amendment.roster { rung_drop_amendment_roster, amendments_for_drop }
import gunbc.rung_drop_amendment.namespace_wave_admission_carrier_redesign {
  namespace_wave_admission_carrier_redesign,
}
import gunbc.rung_drop.roster { rung_drop_roster }

// AN AMENDMENT NAMING NO DROP. It is the discriminating RED for the join: a check that answered
// true for a dangling key would agree with the live roster and be caught here.
data control_dangling_amendment: RungDropAmendment = RungDropAmendment {
  drop_identity: "control.no.such.drop" as NonEmptyStr,
  amended: "2026-01-01",
  later_event: "control later event" as NonEmptyStr,
  bearing: "control bearing" as NonEmptyStr,
}

fn rostered_drop_identities() -> List<String> {
  map(rung_drop_roster, d => (d.identity as String))
}

fn contains_text(haystack: String, needle: String) -> Bool {
  haystack.contains(needle)
}

// EVERY AMENDMENT JOINS TO A ROSTERED DROP, AND A DANGLING ONE DOES NOT. Both directions, because
// a predicate stuck at true and one stuck at false are different defects.
test fn every_amendment_names_a_drop_that_exists() -> Bool {
  every_amendment_names_a_rostered_drop(
    amendments: rung_drop_amendment_roster,
    drop_identities: rostered_drop_identities(),
  ) && !every_amendment_names_a_rostered_drop(
    amendments: [control_dangling_amendment],
    drop_identities: rostered_drop_identities(),
  )
}

// THE JOIN THE PROJECTION FOLDS SELECTS BY IDENTITY AND NOT BY POSITION. The live drop has one
// amendment; a drop that has none gets none.
test fn amendments_are_selected_by_drop_identity() -> Bool {
  length(xs: amendments_for_drop(identity: "namespace_wave_admission_wall_removed" as NonEmptyStr)) == 1
    && length(xs: amendments_for_drop(identity: "floor_cut_heal" as NonEmptyStr)) == 0
}

// THE RENDERING CARRIES THE RESCUED REASONING. The needles are the three facts the paragraph exists
// to keep: that the carrier redesign landed, that the ruling priced the gate itself and not only its
// billing, and that restoration half (1) is therefore BUILT AND DELETED rather than unbuilt -- the
// last being the one a reader of the projected restoration trigger alone would get wrong, and would
// act on by re-landing gunbc#11704, which retires nothing.
test fn the_amendment_renders_the_reasoning_that_was_lost() -> Bool {
  let rendered = rung_drop_amendment_message(a: namespace_wave_admission_carrier_redesign, standing: Standing)
  contains_text(haystack: rendered, needle: "gunbc#11704")
    && contains_text(haystack: rendered, needle: "priced the gate itself")
    && contains_text(haystack: rendered, needle: "BUILT AND DELETED")
}

// THE CLOSING SENTENCE IS READ OFF THE DROP'S STANDING AND IS AUTHORED NOWHERE. Same amendment,
// two standings, two sentences: a renderer that ignored the standing -- which is what an authored
// trigger field would have let it do -- agrees with itself here and is caught. This is the
// assertion that keeps the amendment from becoming a second authority for retirement.
test fn the_closing_sentence_is_derived_from_the_rows_standing() -> Bool {
  let standing = rung_drop_amendment_message(a: namespace_wave_admission_carrier_redesign, standing: Standing)
  let retired = rung_drop_amendment_message(
    a: namespace_wave_admission_carrier_redesign,
    standing: Retired { trigger_fired: "control trigger fired" as NonEmptyStr },
  )
  contains_text(haystack: standing, needle: "The restoration trigger above stands whole.")
    && !contains_text(haystack: retired, needle: "stands whole")
    && contains_text(haystack: retired, needle: "has since fired")
}
