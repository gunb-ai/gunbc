module test.claim.credential_validity_witness
import std.optional { Present, Absent }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Int, String, NonEmptyStr, Secret, secret_of_text }
import std.logic { Bool }
import std.measure { ObservationInstant, ProcessMonotonic, WallClock, nanosecond, nanosecond_count }
import std.decl_ref { DeclarationRef, NamedField }
import std.checked_arithmetic { checked_int_to_nat, CheckedIntReady, CheckedIntOverflow, int_inclusive_max, int_inclusive_min }
import std.nat { Nat, Zero }
import std.access {
  AccessDecision, Permit, Deny, AccessRefusalLocation,
  AccessEvidenceStale, AccessEvidenceValidityUnestablished, AccessEvidenceClockIncomparable,
  AccessEvidenceBindingRefused, access_refusal_reason,
}
import std.credentials {
  AcquisitionClockReading, AcquisitionClockRead, AcquisitionClockObserved, AcquisitionClockUnread, acquisition_clock_reading_of, credential_clock_domain, CredentialUseRequirement, observe_credential_monotonic,
}
import std.credential_refusal { ExpiryUndecodable, BindingAxisMismatch, BindingUnestablished, BindingMember }
import std.credential_admission { credential_validity_decision, credential_binding_decision }
import extdeps.time.rfc3339 { Rfc3339Instant, rfc3339_instant_of_unix, rfc3339_instant_nanoseconds_after }
import extdeps.cloud.gcp.iam {
  GcpImpersonatedAccessCredential, impersonated_access_credential_of, gcp_impersonated_access_validity,
  gcp_impersonated_binding_refusal, gcp_impersonated_binding_same,
}
import extdeps.github.app {
  GitHubInstallationCredential, GitHubAppPermission, ContentsAxis, PullRequestsAxis, AppAccessRead, AppAccessWrite,
  installation_credential_of, github_installation_validity, github_installation_binding_refusal,
  GitHubInstallationAcquisition, GitHubInstallationAcquired, GitHubInstallationPermissionAxisRepeated,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUPPLIED INTERFACE IS THE ACQUISITION. Each fixture below is a declared admitted caller of the
// sealed mint it names, supplying the clock readings and the provider answer at that boundary (
// gunbc.design_argument::witness_one_interface). Its inhabitance pairing -- the real producer emitting this shape -- is the acquisition
// route itself (extdeps.cloud.gcp.iam acquire_impersonated_access, extdeps.github.app
// acquire_scoped_installation_token), exercised end to end by the heal publication consumer that this
// carrier's declared frontier names.

// The incident: the send reading at 17:40:28Z, monotonic origin 1000 s into the process.
data send_unix: Int = 1793986828
data send_monotonic_nanos: Int = 1000000000000
data nanos_per_second: Int = 1000000000

// A sentinel standing for token bytes. Every refusal rendered below must not contain it.
data sentinel_token_text: String = "SENTINEL-CREDENTIAL-BYTES-7f3a"

fn sentinel_token() -> Secret { secret_of_text(text: sentinel_token_text) }

fn mono_at(seconds_after_send: Int) -> ObservationInstant {
  ObservationInstant {
    domain: credential_clock_domain(),
    basis: WallClock,
    since_origin: nanosecond(count: nat_of(n: send_monotonic_nanos + seconds_after_send * nanos_per_second)),
  }
}

fn nat_of(n: Int) -> Nat {
  match checked_int_to_nat(n: n) { Present { value: v } => v  Absent => Zero }
}

fn fx_acquisition() -> AcquisitionClockRead
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "fx_gcp_credential"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "fx_github_acquisition"),
  ]
{
  match rfc3339_instant_of_unix(unix_seconds: send_unix, nanos: 0) {
    Absent => AcquisitionClockUnread { detail: "fixture wall instant did not form" }
    Present { value: wall } => acquisition_clock_reading_of(send_monotonic: mono_at(seconds_after_send: 0), send_wall: wall)
  }
}

fn fx_gcp_credential(expire_time: String, service_account: String, scopes: List<String>) -> GcpImpersonatedAccessCredential?
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "a_credential_issued_already_expired_is_refused_at_its_send"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "an_undecodable_expiry_is_unestablished_never_a_deadline"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "incident_credential"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "renewal_equality_is_semantic_over_scope_sets"),
  ]
{
  match fx_acquisition() {
    AcquisitionClockUnread { detail: _ } => none
    AcquisitionClockObserved { reading: acq } =>
      Present { value: impersonated_access_credential_of(
        token: sentinel_token(), expire_time: expire_time,
        target_service_account: service_account, scopes: scopes, acquisition: acq,
      ) }
  }
}

fn fx_github_acquisition(expires_at: String, repositories: List<String>, permissions: List<GitHubAppPermission>) -> GitHubInstallationAcquisition?
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "a_repeated_permission_axis_mints_no_credential"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "fx_github_credential"),
  ]
{
  match fx_acquisition() {
    AcquisitionClockUnread { detail: _ } => none
    AcquisitionClockObserved { reading: acq } =>
      Present { value: installation_credential_of(
        token: sentinel_token(), expires_at: expires_at, installation_id: 136673607,
        repositories: repositories, permissions: permissions, acquisition: acq,
      ) }
  }
}

fn fx_github_credential(expires_at: String, repositories: List<String>, permissions: List<GitHubAppPermission>) -> GitHubInstallationCredential?
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "an_installation_wide_token_does_not_establish_a_named_repository"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "publisher_credential"),
  ]
{
  match fx_github_acquisition(expires_at: expires_at, repositories: repositories, permissions: permissions) {
    Present { value: GitHubInstallationAcquired { credential: c } } => Present { value: c }
    _ => none
  }
}

data location: AccessRefusalLocation = AccessRefusalLocation {
  profile: "credential-presentation", subject: "heal-publisher", action: "present", object: "gcp.SecretManager.AccessVersion",
}

fn requirement(remaining_s: Int, margin_s: Int) -> CredentialUseRequirement {
  CredentialUseRequirement {
    required_remaining: nanosecond(count: nat_of(n: remaining_s * nanos_per_second)),
    skew_margin: nanosecond(count: nat_of(n: margin_s * nanos_per_second)),
  }
}

data heal_sa: String = "heal-publisher@gunbai-secrets.iam.gserviceaccount.com"
data cloud_platform: String = "https://www.googleapis.com/auth/cloud-platform"

// The incident's credential: requested 300 s, issued expiry 17:45:28 in Google's 3-digit spelling.
fn incident_credential() -> GcpImpersonatedAccessCredential?
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "a_missing_scope_is_refused_and_a_held_scope_is_not"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "a_wrong_service_account_is_a_typed_binding_refusal"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "an_observation_on_another_clock_refuses"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "remaining_lifetime_and_skew_margin_are_both_required"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "the_expiry_instant_belongs_to_the_refused_interval"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "the_incident_presentation_nine_minutes_after_a_five_minute_mint_is_refused"),
  ]
{
  fx_gcp_credential(expire_time: "2026-11-06T17:45:28.000Z", service_account: heal_sa, scopes: [cloud_platform])
}

fn gcp_decision_at(cred: GcpImpersonatedAccessCredential?, seconds_after_send: Int, req: CredentialUseRequirement) -> AccessDecision? {
  match cred {
    Absent => none
    Present { value: c } => Present { value: credential_validity_decision(
      evidence: "gcp impersonated access token", validity: gcp_impersonated_access_validity(c: c),
      observed_at: mono_at(seconds_after_send: seconds_after_send), requirement: req, location: location,
    ) }
  }
}

fn permits(d: AccessDecision?) -> Bool {
  match d { Present { value: Permit } => true  _ => false }
}

fn stale(d: AccessDecision?) -> Bool {
  match d {
    Present { value: Deny { refusal: r } } =>
      match r.cause { AccessEvidenceStale { evidence: _, observed_at: _, usable_until: _, required_remaining: _, skew_margin: _ } => true  _ => false }
    _ => false
  }
}

fn reason_discloses_nothing(d: AccessDecision?) -> Bool {
  match d {
    Present { value: Deny { refusal: r } } => !string_contains(s: access_refusal_reason(refusal: r), pattern: sentinel_token_text)
    _ => false
  }
}

// THE OBSERVED CASE: minted for 300 s at 17:40:28 and presented at 17:49:20 (532 s later). Refused,
// and refused as stale evidence, not as an unauthenticated request discovered after the send.
test fn the_incident_presentation_nine_minutes_after_a_five_minute_mint_is_refused() -> Bool {
  let d = gcp_decision_at(cred: incident_credential(), seconds_after_send: 532, req: requirement(remaining_s: 0, margin_s: 0))
  stale(d: d) && reason_discloses_nothing(d: d)
}

// THE BOUNDARY: one second before the issued expiry is usable; the expiry instant itself is not.
test fn the_expiry_instant_belongs_to_the_refused_interval() -> Bool {
  permits(d: gcp_decision_at(cred: incident_credential(), seconds_after_send: 299, req: requirement(remaining_s: 0, margin_s: 0)))
    && stale(d: gcp_decision_at(cred: incident_credential(), seconds_after_send: 300, req: requirement(remaining_s: 0, margin_s: 0)))
}

// A request that needs two minutes is refused with three minutes of life left once a 90 s skew margin
// is added, and admitted with a 30 s margin.
test fn remaining_lifetime_and_skew_margin_are_both_required() -> Bool {
  stale(d: gcp_decision_at(cred: incident_credential(), seconds_after_send: 120, req: requirement(remaining_s: 120, margin_s: 90)))
    && permits(d: gcp_decision_at(cred: incident_credential(), seconds_after_send: 120, req: requirement(remaining_s: 120, margin_s: 30)))
}

// An expiry that does not parse is unestablished validity: refused, and NOT as stale (no deadline is
// fabricated to put in a stale refusal).
test fn an_undecodable_expiry_is_unestablished_never_a_deadline() -> Bool {
  match gcp_decision_at(cred: fx_gcp_credential(expire_time: "in an hour", service_account: heal_sa, scopes: [cloud_platform]), seconds_after_send: 0, req: requirement(remaining_s: 0, margin_s: 0)) {
    Present { value: Deny { refusal: r } } =>
      match r.cause {
        AccessEvidenceValidityUnestablished { evidence: _, cause: ExpiryUndecodable { cause: _ } } => true
        _ => false
      }
    _ => false
  }
}

// An observation on another clock cannot be ordered against the deadline and refuses.
test fn an_observation_on_another_clock_refuses() -> Bool {
  match incident_credential() {
    Absent => false
    Present { value: c } =>
      match credential_validity_decision(
        evidence: "gcp impersonated access token", validity: gcp_impersonated_access_validity(c: c),
        observed_at: ObservationInstant { domain: ProcessMonotonic { process: "some-other-process" }, basis: WallClock, since_origin: nanosecond(count: 1) },
        requirement: requirement(remaining_s: 0, margin_s: 0), location: location,
      ) {
        Deny { refusal: r } => match r.cause { AccessEvidenceClockIncomparable { evidence: _, held: _, observed: _ } => true  _ => false }
        Permit => false
      }
  }
}

// A credential that arrived already expired (expiry before the send) is refused at once.
test fn a_credential_issued_already_expired_is_refused_at_its_send() -> Bool {
  stale(d: gcp_decision_at(cred: fx_gcp_credential(expire_time: "2026-11-06T17:40:00Z", service_account: heal_sa, scopes: [cloud_platform]), seconds_after_send: 0, req: requirement(remaining_s: 0, margin_s: 0)))
}

// ── BINDING: TYPED REFUSALS SURVIVE THE KERNEL ─────────────────────────────────────────────────
// The wrong service account is refused on the service-account axis, with the required and held
// members carried to the decision, and rendered without the token.
test fn a_wrong_service_account_is_a_typed_binding_refusal() -> Bool {
  match incident_credential() {
    Absent => false
    Present { value: c } => {
      let d = credential_binding_decision(
        evidence: "gcp impersonated access token",
        refusal: gcp_impersonated_binding_refusal(credential: c, required_service_account: "fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com", required_scopes: [cloud_platform]),
        location: location,
      )
      match d {
        Deny { refusal: r } =>
          !string_contains(s: access_refusal_reason(refusal: r), pattern: sentinel_token_text)
            && match r.cause {
                 AccessEvidenceBindingRefused { evidence: _, cause: BindingAxisMismatch { axis: axis, required: req, held: held } } =>
                   axis.field.decl_name == "GcpImpersonatedAccessBinding"
                     && axis.field.field == NamedField { field_name: "target_service_account" }
                     && req == [BindingMember { identity: "fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com" }]
                     && held == [BindingMember { identity: heal_sa as NonEmptyStr }]
                 _ => false
               }
        Permit => false
      }
    }
  }
}

test fn a_missing_scope_is_refused_and_a_held_scope_is_not() -> Bool {
  match incident_credential() {
    Absent => false
    Present { value: c } =>
      gcp_impersonated_binding_refusal(credential: c, required_service_account: heal_sa, required_scopes: [cloud_platform]) == none
        && match gcp_impersonated_binding_refusal(credential: c, required_service_account: heal_sa, required_scopes: ["https://www.googleapis.com/auth/devstorage.read_only"]) {
             Present { value: BindingAxisMismatch { axis: axis, required: _, held: _ } } => axis.field.field == NamedField { field_name: "scopes" }
             _ => false
           }
  }
}

// RENEWAL EQUALITY IS OVER SETS: reordered scopes are the same binding; another principal is not.
test fn renewal_equality_is_semantic_over_scope_sets() -> Bool {
  match fx_gcp_credential(expire_time: "2026-11-06T17:45:28Z", service_account: heal_sa, scopes: [cloud_platform, "openid"]) {
    Absent => false
    Present { value: a } =>
      match fx_gcp_credential(expire_time: "2026-11-06T18:45:28.000000Z", service_account: heal_sa, scopes: ["openid", cloud_platform, "openid"]) {
        Absent => false
        Present { value: b } =>
          match fx_gcp_credential(expire_time: "2026-11-06T18:45:28Z", service_account: "other@gunbai-secrets.iam.gserviceaccount.com", scopes: [cloud_platform, "openid"]) {
            Absent => false
            Present { value: other } => gcp_impersonated_binding_same(a: a, b: b) && !gcp_impersonated_binding_same(a: a, b: other)
          }
      }
  }
}

// ── GITHUB INSTALLATION TOKENS ─────────────────────────────────────────────────────────────────
data contents_write: GitHubAppPermission = GitHubAppPermission { name: ContentsAxis, access: AppAccessWrite }
data contents_read: GitHubAppPermission = GitHubAppPermission { name: ContentsAxis, access: AppAccessRead }
data pulls_write: GitHubAppPermission = GitHubAppPermission { name: PullRequestsAxis, access: AppAccessWrite }

fn publisher_credential() -> GitHubInstallationCredential?
  admit_callers: [
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "a_github_permission_mismatch_survives_the_kernel_and_renders_without_the_token"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "another_repository_or_installation_is_refused"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "the_installation_token_carries_its_issued_hour"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "write_covers_read_and_never_another_axis"),
  ]
{
  fx_github_credential(expires_at: "2026-11-06T18:40:28Z", repositories: ["gunbc"], permissions: [contents_write])
}

fn github_decision_at(c: GitHubInstallationCredential, seconds_after_send: Int) -> AccessDecision {
  credential_validity_decision(
    evidence: "github installation token", validity: github_installation_validity(c: c),
    observed_at: mono_at(seconds_after_send: seconds_after_send), requirement: requirement(remaining_s: 0, margin_s: 0), location: location,
  )
}

test fn the_installation_token_carries_its_issued_hour() -> Bool {
  match publisher_credential() {
    Absent => false
    Present { value: c } =>
      permits(d: Present { value: github_decision_at(c: c, seconds_after_send: 3599) })
        && stale(d: Present { value: github_decision_at(c: c, seconds_after_send: 3600) })
  }
}

test fn write_covers_read_and_never_another_axis() -> Bool {
  match publisher_credential() {
    Absent => false
    Present { value: c } =>
      github_installation_binding_refusal(credential: c, required_installation_id: 136673607, required_repositories: ["gunbc"], required_permissions: [contents_read]) == none
        && match github_installation_binding_refusal(credential: c, required_installation_id: 136673607, required_repositories: ["gunbc"], required_permissions: [pulls_write]) {
             Present { value: BindingAxisMismatch { axis: axis, required: req, held: held } } =>
               axis.field.field == NamedField { field_name: "permissions" }
                 && req == [BindingMember { identity: "pull_requests:write" }]
                 && held == [BindingMember { identity: "contents:write" }]
             _ => false
           }
  }
}

test fn another_repository_or_installation_is_refused() -> Bool {
  match publisher_credential() {
    Absent => false
    Present { value: c } =>
      match github_installation_binding_refusal(credential: c, required_installation_id: 136673607, required_repositories: ["gunbc-private"], required_permissions: [contents_write]) {
        Present { value: BindingAxisMismatch { axis: a1, required: _, held: _ } } =>
          a1.field.field == NamedField { field_name: "repositories" }
            && match github_installation_binding_refusal(credential: c, required_installation_id: 104134109, required_repositories: ["gunbc"], required_permissions: [contents_write]) {
                 Present { value: BindingAxisMismatch { axis: a2, required: _, held: _ } } => a2.field.field == NamedField { field_name: "installation_id" }
                 _ => false
               }
        _ => false
      }
  }
}

// An installation-wide token (no selection in its request) does not establish coverage of a NAMED
// repository: the set it stands for is not observed, so the axis is unestablished, not assumed.
test fn an_installation_wide_token_does_not_establish_a_named_repository() -> Bool {
  match fx_github_credential(expires_at: "2026-11-06T18:40:28Z", repositories: [], permissions: []) {
    Absent => false
    Present { value: c } =>
      match github_installation_binding_refusal(credential: c, required_installation_id: 136673607, required_repositories: ["gunbc"], required_permissions: []) {
        Present { value: BindingUnestablished { axis: a } } => a.field.field == NamedField { field_name: "repositories" }
        _ => false
      }
  }
}

// THE BINDING IS WHAT WAS ASKED FOR. The request encoder sends the first entry per axis, so a list
// naming contents twice would ask for read while a binding taken from the list claimed write. The
// sealed mint refuses the repeated axis, naming it, and builds no credential at all.
test fn a_repeated_permission_axis_mints_no_credential() -> Bool {
  match fx_github_acquisition(expires_at: "2026-11-06T18:40:28Z", repositories: ["gunbc"], permissions: [contents_read, contents_write]) {
    Present { value: GitHubInstallationPermissionAxisRepeated { axis: ContentsAxis } } => true
    _ => false
  }
}

// THE GITHUB REFUSAL THROUGH THE KERNEL, as the GCP case above: the binding judgment's typed refusal is
// carried through credential_binding_decision into AccessDecision with its axis and members intact,
// and the rendered reason carries no credential material.
test fn a_github_permission_mismatch_survives_the_kernel_and_renders_without_the_token() -> Bool {
  match publisher_credential() {
    Absent => false
    Present { value: c } =>
      match credential_binding_decision(
        evidence: "github installation token",
        refusal: github_installation_binding_refusal(credential: c, required_installation_id: 136673607, required_repositories: ["gunbc"], required_permissions: [pulls_write]),
        location: location,
      ) {
        Permit => false
        Deny { refusal: r } =>
          !string_contains(s: access_refusal_reason(refusal: r), pattern: sentinel_token_text)
            && match r.cause {
                 AccessEvidenceBindingRefused { evidence: _, cause: BindingAxisMismatch { axis: axis, required: req, held: held } } =>
                   (axis.field.module_path as String) == "extdeps.github.app"
                     && (axis.field.decl_name as String) == "GitHubInstallationBinding"
                     && axis.field.field == NamedField { field_name: "permissions" }
                     && req == [BindingMember { identity: "pull_requests:write" }]
                     && held == [BindingMember { identity: "contents:write" }]
                 _ => false
               }
      }
  }
}

// THE MONOTONIC READ IS NOT MEMOIZED. Two reads with the same label in one evaluation frame must be two
// readings: the second is strictly later. A memoized read returns the first answer, which this
// refuses -- and which is the defect that made a later acquisition pair an old monotonic reading with a
// fresh wall reading.
test fn two_monotonic_reads_with_one_label_are_two_readings() -> Bool uses clk: std.resources.Clock {
  match observe_credential_monotonic(label: "credential-validity-witness-repeat") {
    Absent => false
    Present { value: first } =>
      match observe_credential_monotonic(label: "credential-validity-witness-repeat") {
        Absent => false
        Present { value: second } => (nanosecond_count(n: second.since_origin) as Int) > (nanosecond_count(n: first.since_origin) as Int)
      }
  }
}

// THE SPAN IS CHECKED FROM ITS FIRST OPERATION. Opposite seconds extrema through the checked Unix
// factory overflow in the SUBTRACTION, before any scaling; that refuses as CheckedIntOverflow instead
// of an interpreter or runtime overflow.
test fn a_span_between_opposite_extrema_refuses_at_its_subtraction() -> Bool {
  match rfc3339_instant_of_unix(unix_seconds: int_inclusive_max(), nanos: 0) {
    Absent => false
    Present { value: hi } =>
      match rfc3339_instant_of_unix(unix_seconds: int_inclusive_min(), nanos: 0) {
        Absent => false
        Present { value: lo } =>
          match rfc3339_instant_nanoseconds_after(later: hi, earlier: lo) {
            CheckedIntOverflow { cause: _ } => true
            CheckedIntReady { value: _ } => false
          }
      }
  }
}
