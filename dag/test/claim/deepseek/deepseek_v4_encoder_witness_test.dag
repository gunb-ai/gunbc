module test.claim.deepseek.deepseek_v4_encoder_witness

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.deepseek.deepseek_v4 {
  DeepseekV4ReasoningMode, DeepseekV4NonThink, DeepseekV4ThinkHigh, DeepseekV4ThinkMax,
  deepseek_v4_reasoning_mode_wire, deepseek_v4_effort_has_preamble, deepseek_v4_think_max_preamble,
  deepseek_v4_encoder_effort_values, DeepseekV4EncoderThinkingMode, EncoderChat, EncoderThinking,
  deepseek_v4_encoder_prefill, deepseek_v4_thinking_start_token, deepseek_v4_thinking_end_token,
  deepseek_v4_effort_rendering_iq3s_split_vllm, deepseek_v4_rendering_distinguishes_max,
}

// These pin a TRANSCRIPTION against the shape the source has. The preamble is read from the cited
// encoder at the cited revision; a re-transcription that dropped a sentence, or a tier that grew a
// preamble the encoder does not give it, goes red here.
data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn the_think_max_preamble_is_the_encoders_opening_line() -> Bool {
  (deepseek_v4_think_max_preamble as String).starts_with("Reasoning Effort: Absolute maximum with no shortcuts permitted.")
    && (deepseek_v4_think_max_preamble as String).contains("rejected hypothesis")
}

// ONLY MAX CARRIES A PREAMBLE. A high tier that acquired one would be a paraphrase wearing a trained
// tier's name, which is the defect this module exists to make unwritable.
test fn only_think_max_carries_a_preamble() -> Bool {
  deepseek_v4_effort_has_preamble(mode: DeepseekV4ThinkMax)
    && !deepseek_v4_effort_has_preamble(mode: DeepseekV4ThinkHigh)
    && !deepseek_v4_effort_has_preamble(mode: DeepseekV4NonThink)
}

// THE ENCODER HAS NO "low". The hosted API does; a harness that sent it to this encoder would be
// sending a value the artifact ignores, which the rendering row below also shows.
test fn the_encoder_accepts_max_and_high_and_nothing_else() -> Bool {
  list_length(items: deepseek_v4_encoder_effort_values) == 2
    && !any(deepseek_v4_encoder_effort_values, v => (v as String) == "low")
}

// THINKING OFF IS A PREFILLED END TOKEN, not an absent start token.
test fn chat_mode_prefills_the_end_token_and_thinking_the_start() -> Bool {
  (deepseek_v4_encoder_prefill(m: EncoderChat) as String) == (deepseek_v4_thinking_end_token as String)
    && (deepseek_v4_encoder_prefill(m: EncoderThinking) as String) == (deepseek_v4_thinking_start_token as String)
}

// THE MEASURED REALIZATION RENDERS THE ENCODER: max adds tokens, high adds none, unknown adds none.
test fn the_iq3s_split_realization_renders_max_and_only_max() -> Bool {
  deepseek_v4_rendering_distinguishes_max(o: deepseek_v4_effort_rendering_iq3s_split_vllm)
}

test fn the_wire_label_for_think_max_is_max() -> Bool {
  (deepseek_v4_reasoning_mode_wire(mode: DeepseekV4ThinkMax) as String) == "max"
    && (deepseek_v4_reasoning_mode_wire(mode: DeepseekV4ThinkHigh) as String) == "high"
}
