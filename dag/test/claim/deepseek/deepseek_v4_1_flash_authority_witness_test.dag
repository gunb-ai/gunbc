  deepseek_v4_1_flash_thinking_end_token, deepseek_v4_1_flash_named_effort_budget,
  deepseek_v4_1_flash_named_effort_wire, deepseek_v4_1_flash_default_named_effort,
  deepseek_v4_1_flash_budget_is_admissible, deepseek_v4_1_flash_effort_is_rendered,
  deepseek_v4_1_flash_effort_preamble, deepseek_v4_1_flash_system_token,
