  deepseek_v4_1_flash_frontier, deepseek_v4_1_flash_frontier_dsv41_1,
  deepseek_v4_1_flash_frontier_dsv41_2, deepseek_v4_1_flash_frontier_harness_wire,
  deepseek_v4_1_flash_frontier_dsv41_10,
  deepseek_v4_1_flash_safetensors_payload_footprint, deepseek_v4_1_flash_safetensors_payload_total,
  deepseek_v4_1_flash_safetensors_index_total_size, deepseek_v4_1_flash_safetensors_tree_file_bytes,
  DeepseekV41EncoderChat, DeepseekV41EncoderThinking,
  DeepseekV41EffortLow, DeepseekV41EffortHigh, DeepseekV41EffortMax,
