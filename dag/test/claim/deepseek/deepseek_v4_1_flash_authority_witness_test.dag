  deepseek_v4_1_flash_engram_shard_1, deepseek_v4_1_flash_engram_shard_14, deepseek_v4_1_flash_tokenizer_files,
  deepseek_v4_1_flash_published_manifest_text, deepseek_v4_1_flash_weight_manifest_text, deepseek_v4_1_flash_tokenizer_manifest_text,
  deepseek_v4_1_flash_hub_repo, deepseek_v4_1_flash_revision,
  deepseek_v4_1_flash_encoder_path, deepseek_v4_1_flash_config_path,
  deepseek_v4_1_flash_license_path, deepseek_v4_1_flash_license_spdx,
  extdeps_external_authority_anchor,
