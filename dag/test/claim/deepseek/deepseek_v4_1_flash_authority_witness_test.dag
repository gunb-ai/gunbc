}

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn encoder_and_config_blob_urls_are_the_hub_shape_at_this_pin() -> Bool {
  let enc = hub_blob_url(repo: deepseek_v4_1_flash_hub_repo, revision: deepseek_v4_1_flash_revision, path_in_repo: deepseek_v4_1_flash_encoder_path)
  let cfg = hub_blob_url(repo: deepseek_v4_1_flash_hub_repo, revision: deepseek_v4_1_flash_revision, path_in_repo: deepseek_v4_1_flash_config_path)
  let lic = hub_blob_url(repo: deepseek_v4_1_flash_hub_repo, revision: deepseek_v4_1_flash_revision, path_in_repo: deepseek_v4_1_flash_license_path)
  let tree = hub_repo_tree_api_url(repo: deepseek_v4_1_flash_hub_repo, revision: deepseek_v4_1_flash_revision)
  (enc as String) == "https://huggingface.co/deepseek-ai/DeepSeek-V4.1-Flash/blob/dba1be0a40aa45a94ad051997016db3960a90277/encoding/encoding.py"
    && (cfg as String) == "https://huggingface.co/deepseek-ai/DeepSeek-V4.1-Flash/blob/dba1be0a40aa45a94ad051997016db3960a90277/config.json"
    && (lic as String) == "https://huggingface.co/deepseek-ai/DeepSeek-V4.1-Flash/blob/dba1be0a40aa45a94ad051997016db3960a90277/LICENSE"
    && (deepseek_v4_1_flash_license_spdx as String) == "MIT"
    && (tree as String) == "https://huggingface.co/api/models/deepseek-ai/DeepSeek-V4.1-Flash/tree/dba1be0a40aa45a94ad051997016db3960a90277?recursive=1"
    && (uri_wire(uri: hub_repo_https_uri(repo: deepseek_v4_1_flash_hub_repo)) as String)
      == (uri_wire(uri: extdeps_external_authority_anchor.uri) as String)
}

test fn yarn_factor_reproduces_the_scaled_window() -> Bool {
  token_count_value(t: deepseek_v4_1_flash_yarn_scaled_positions())
    == token_count_value(t: deepseek_v4_1_flash_context_length)
}

test fn remaining_window_saturates_at_zero() -> Bool {
  let window = token_count(count: 100)
  let used_thirty = token_count(count: 30)
  token_count_value(t: token_count_remaining_in_window(window: window, used: used_thirty)) == 70
    && token_count_value(t: token_count_remaining_in_window(window: window, used: window)) == 0
    && token_count_value(t: token_count_remaining_in_window(window: window, used: token_count(count: 101))) == 0
}

fn flash_decl_key(decl_name: String) -> String {
  declaration_ref_display_key(ref: DeclarationRef {
    module_path: "extdeps.deepseek.deepseek_v4_1_flash" as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration,
  })
}

fn frontier_keys_contain(rows: List<FrontierRow>, decl_name: String) -> Bool {
  let want = flash_decl_key(decl_name: decl_name)
  any(frontier_path_subjects(rows: rows), k => k == want)
}

// ── THE GROUPS ARE JOINED TO THE AGGREGATE, NOT MERELY CHECKED BESIDE IT ──────────────────────
//
// CHECKING THE RIGHT HELPER INDEPENDENTLY DOES NOT PROVE THE CLAIMED PATH USES IT. A first cut read
// each GROUP directly for well-formedness and membership while keyed-roster construction and the
// expiry fold read the AGGREGATE, and nothing joined the two -- so the discriminator was the original
// defect itself: drop dsv41_10 from `deepseek_v4_1_flash_frontier`, change nothing else, and every
// assertion still passed. The control added to prevent a recurrence could not detect the recurrence.
// The membership negative did not see it either, because it asks whether a subject is in DSV41-2, not
// whether it is in the aggregate.
//
// So the aggregate's subject identities are reconciled against the union of the intended groups in
// BOTH directions, with the count equality rejecting duplicates rather than standing in for the join.
// `a_three_group_aggregate_is_refused` below is the discriminating negative: it constructs exactly the
// disconnected aggregate this cut shipped and asserts the reconciliation REFUSES it.
data expected_flash_frontier_groups: List<List<FrontierRow>> = [
  deepseek_v4_1_flash_frontier_dsv41_1,
  deepseek_v4_1_flash_frontier_dsv41_2,
  deepseek_v4_1_flash_frontier_harness_wire,
  deepseek_v4_1_flash_frontier_dsv41_10,
]

fn frontier_aggregate_covers_groups(aggregate: List<FrontierRow>, groups: List<List<FrontierRow>>) -> Bool {
  let expected = flat_map(groups, g => frontier_path_subjects(rows: g))
  let actual = frontier_path_subjects(rows: aggregate)
  count(actual) == count(expected)
    && all(expected, e => any(actual, a => a == e))
    && all(actual, a => any(expected, e => e == a))
}

test fn the_flash_frontier_aggregate_is_exactly_its_declared_groups() -> Bool {
  frontier_aggregate_covers_groups(
    aggregate: deepseek_v4_1_flash_frontier,
    groups: expected_flash_frontier_groups)
}

test fn a_three_group_aggregate_is_refused() -> Bool {
  !frontier_aggregate_covers_groups(
    aggregate: concat_frontier_row_groups(groups: [
      deepseek_v4_1_flash_frontier_dsv41_1,
      deepseek_v4_1_flash_frontier_dsv41_2,
      deepseek_v4_1_flash_frontier_harness_wire,
    ]),
    groups: expected_flash_frontier_groups)
}

test fn declared_frontier_groups_are_consumed_and_partition_the_named_facts() -> Bool {
  let expiry = fold_frontier_expiry(rows: deepseek_v4_1_flash_frontier, present_decls: [])
  frontier_rows_well_formed(rows: deepseek_v4_1_flash_frontier_dsv41_1)
    && frontier_rows_well_formed(rows: deepseek_v4_1_flash_frontier_dsv41_2)
    && frontier_rows_well_formed(rows: deepseek_v4_1_flash_frontier_harness_wire)
    && frontier_rows_well_formed(rows: deepseek_v4_1_flash_frontier_dsv41_10)
    && match frontier_rows_keyed_roster_build(rows: deepseek_v4_1_flash_frontier) {
      KeyedRosterBuilt { rows: _ } => true
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
    }
    && frontier_expiry_clean(report: expiry)
    && expiry.pending_count == 0
    && expiry.fired_still_present_count == 0
    && expiry.unbound_count != 0
    && frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_dsv41_1, decl_name: "deepseek_v4_1_flash_architecture_class")
    && frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_dsv41_2, decl_name: "deepseek_v4_1_flash_engram")
    && !frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_dsv41_1, decl_name: "deepseek_v4_1_flash_engram")
    && frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_harness_wire, decl_name: "deepseek_v4_1_flash_effort_preamble")
    && frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_dsv41_10, decl_name: "deepseek_v4_1_flash_engram_population")
    && !frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_dsv41_2, decl_name: "deepseek_v4_1_flash_engram_population")
    && frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_harness_wire, decl_name: "deepseek_v4_1_flash_system_token")
    && !frontier_keys_contain(rows: deepseek_v4_1_flash_frontier_dsv41_2, decl_name: "deepseek_v4_1_flash_system_token")
}

test fn payload_partition_sums_to_the_index_total_and_is_strictly_below_tree_file_size() -> Bool {
  let f = deepseek_v4_1_flash_safetensors_payload_footprint
  byte_size_count(b: deepseek_v4_1_flash_safetensors_payload_total(f: f))
    == byte_size_count(b: deepseek_v4_1_flash_safetensors_index_total_size)
    && byte_size_count(b: deepseek_v4_1_flash_safetensors_tree_file_bytes)
      > byte_size_count(b: deepseek_v4_1_flash_safetensors_index_total_size)
}

test fn named_effort_is_ordered_and_the_budget_interval_is_closed() -> Bool {
  deepseek_v4_1_flash_named_effort_budget(e: DeepseekV41EffortMax)
      > deepseek_v4_1_flash_named_effort_budget(e: DeepseekV41EffortHigh)
    && deepseek_v4_1_flash_named_effort_budget(e: DeepseekV41EffortHigh)
      > deepseek_v4_1_flash_named_effort_budget(e: DeepseekV41EffortLow)
    && (deepseek_v4_1_flash_named_effort_wire(e: DeepseekV41EffortLow) as String) == "low"
    && (deepseek_v4_1_flash_named_effort_wire(e: DeepseekV41EffortHigh) as String) == "high"
    && (deepseek_v4_1_flash_named_effort_wire(e: DeepseekV41EffortMax) as String) == "max"
    && deepseek_v4_1_flash_named_effort_budget(e: deepseek_v4_1_flash_default_named_effort)
      == deepseek_v4_1_flash_named_effort_budget(e: DeepseekV41EffortHigh)
    && deepseek_v4_1_flash_budget_is_admissible(budget: 1)
    && deepseek_v4_1_flash_budget_is_admissible(budget: 100)
    && !deepseek_v4_1_flash_budget_is_admissible(budget: 0)
    && !deepseek_v4_1_flash_budget_is_admissible(budget: 101)
}

test fn engram_layers_overlap_kv_source_and_not_dspark_targets() -> Bool {
  any(deepseek_v4_1_flash_engram.layer_ids, id => any(deepseek_v4_1_flash_kv_source_layer_ids, k => k == id))
    && !any(deepseek_v4_1_flash_engram.layer_ids, id => any(deepseek_v4_1_flash_dspark_target_layer_ids, k => k == id))
}

test fn effort_preamble_names_the_budget_and_system_token_is_not_a_think_marker() -> Bool {
  let high = deepseek_v4_1_flash_effort_preamble(budget: 75)
  let low = deepseek_v4_1_flash_effort_preamble(budget: 50)
  high != low
    && string_contains(s: high, pattern: "75")
    && string_contains(s: high, pattern: "range 1-100")
    && (deepseek_v4_1_flash_system_token as String) != (deepseek_v4_1_flash_thinking_start_token as String)
    && (deepseek_v4_1_flash_system_token as String) != (deepseek_v4_1_flash_thinking_end_token as String)
    && string_contains(s: deepseek_v4_1_flash_system_token as String, pattern: "System")
}

test fn effort_renders_only_on_thinking_at_index_zero() -> Bool {
  deepseek_v4_1_flash_effort_is_rendered(m: DeepseekV41EncoderThinking, message_index: 0)
    && !deepseek_v4_1_flash_effort_is_rendered(m: DeepseekV41EncoderThinking, message_index: 1)
    && !deepseek_v4_1_flash_effort_is_rendered(m: DeepseekV41EncoderChat, message_index: 0)
}

test fn chat_prefills_the_end_token_and_thinking_the_start() -> Bool {
  (deepseek_v4_1_flash_encoder_prefill(m: DeepseekV41EncoderChat) as String)
      == (deepseek_v4_1_flash_thinking_end_token as String)
    && (deepseek_v4_1_flash_encoder_prefill(m: DeepseekV41EncoderThinking) as String)
      == (deepseek_v4_1_flash_thinking_start_token as String)
    && (deepseek_v4_1_flash_encoder_prefill(m: DeepseekV41EncoderChat) as String)
      != (deepseek_v4_1_flash_encoder_prefill(m: DeepseekV41EncoderThinking) as String)
}

test fn dsml_block_name_is_the_encoder_leading_space_not_v4_tool_calls() -> Bool {
  (deepseek_v4_1_flash_dsml_tool_calls_block_name as String).starts_with(" ")
    && !(deepseek_v4_1_flash_dsml_tool_calls_block_name as String).contains("tool_calls")
    && string_contains(s: deepseek_v4_1_flash_dsml_tool_calls_open(), pattern: deepseek_v4_1_flash_dsml_token as String)
}

// THE WEIGHT MANIFEST IS THE TREE, BY FOLD: 48 rows whose sizes sum to the tree total the module
// carries; the two Engram shards in it are the rows their owners declare (one source for path,
// size and digest); the canonical text is one serialization shared with the tokenizer manifest,
// and the two manifests are distinct texts.
test fn the_weight_manifest_reconciles_with_the_tree_and_owns_each_shard_once() -> Bool {
  deepseek_v4_1_flash_weight_manifest_agrees_with_tree()
    && length(deepseek_v4_1_flash_weight_manifest) == 48
    && (match deepseek_v4_1_flash_published_file(path: deepseek_v4_1_flash_engram_shard_1.file.path) { Present { value: f } => (f.sha256.hex as String) == (deepseek_v4_1_flash_engram_shard_1.sha256.hex as String)  Absent => false })
    && (match deepseek_v4_1_flash_published_file(path: deepseek_v4_1_flash_engram_shard_14.file.path) { Present { value: f } => (f.sha256.hex as String) == (deepseek_v4_1_flash_engram_shard_14.sha256.hex as String)  Absent => false })
    && (match deepseek_v4_1_flash_published_file(path: "model-00049-of-00048.safetensors" as NonEmptyStr) { Absent => true  Present { value: _ } => false })
    && deepseek_v4_1_flash_weight_manifest_text() == deepseek_v4_1_flash_published_manifest_text(rows: deepseek_v4_1_flash_weight_manifest)
    && deepseek_v4_1_flash_weight_manifest_text() != deepseek_v4_1_flash_tokenizer_manifest_text()
    && length(deepseek_v4_1_flash_tokenizer_files) == 2
}
