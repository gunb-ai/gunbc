module test.claim.workflow_run_id_axis_measure

import std.types { String, Bool, Int }
import extdeps.filesystem.filesystem_io
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CensusObserved, CensusNotRunnable, census_count_at_key,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE WORKFLOW RUN ID IS ONE CARRIER, AND IT IS A DISTINCT AXIS (extdeps.github.workflow_runs
// GitHubWorkflowRunId). Each claim reads its own compiled source, keyed (class + subject + blocking)
// the way test.claim.deployment_gate_evidence_forged_probe_witness keys its cross-axis claims, against
// a control that imports the same names, builds the same rows correctly and reads zero at the key.
// CensusNotRunnable reads negative from refusals(), so an unrunnable census fails the claim.
//
// The subjects are MEASURED on the real compile path, not guessed (see the PR body for the run).

data probe_dir: String = "dag/test/probe/"

fn probe_source(name: String) -> String {
  filesystem_read(path: probe_dir + name + ".dag").content
}

fn census_of(name: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(probe_source(name: name))
}

fn control_census() -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(control_source)
}

fn refusals(c: CompileDiagnosticCensus, class: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => 0 - 1
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: class, subject_name: subject, blocking: true)
  }
}

// THE CONTROL: imports every carrier and record the probes attack, builds each row with the CORRECT
// axis, calls the path builder with a run carrier. If this reads a refusal at a probe key, the key
// is about importing, not forging.
data control_source: String = "module probe_workflow_run_id_axis_control\nimport std.types { Int }\nimport extdeps.github.app { GitHubAppId, GitHubAppInstallationId }\nimport extdeps.github.workflow_runs { GitHubWorkflowRunId }\nimport extdeps.github.actions_runs { WorkflowRunRecord }\nimport extdeps.github.deployment_protection_rule { GitHubDeploymentProtectionRuleId, EnabledDeploymentProtectionRule, RuleOwningApp, review_endpoint_path_built_for, BuiltReviewPath }\ndata c_run: GitHubWorkflowRunId = GitHubWorkflowRunId { value: 35447067113 }\ndata c_rule: GitHubDeploymentProtectionRuleId = GitHubDeploymentProtectionRuleId { value: 1 }\ndata c_inst: GitHubAppInstallationId = GitHubAppInstallationId { value: 2 }\ndata c_row: EnabledDeploymentProtectionRule = EnabledDeploymentProtectionRule { id: c_rule, node_id: \"DPPR_c\", enabled: true, app: RuleOwningApp { id: GitHubAppId { value: 3 }, slug: \"s\" } }\ndata c_rec: WorkflowRunRecord = WorkflowRunRecord { run_id: c_run, event: \"e\", head_branch: \"b\", status: \"completed\", conclusion: \"success\", created_at_epoch_s: 1, run_started_at_epoch_s: 1, updated_at_epoch_s: 1 }\ndata c_path: BuiltReviewPath = review_endpoint_path_built_for(owner: \"o\", repo: \"r\", run_id: c_run)\n"

test fn cand_0() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "DeclaredTypeNotInhabited", subject: "call argument 'run_id'") >= 1 }
test fn cand_1() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "DeclaredTypeNotInhabited", subject: "Product(GitHubDeploymentProtectionRuleId)") >= 1 }
test fn cand_2() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "TypeMismatch", subject: "Product(GitHubWorkflowRunId)") >= 1 }
test fn cand_3() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "TypeMismatch", subject: "Primitive(Int)") >= 1 }
test fn cand_4() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "TypeMismatch", subject: "argument 'run_id'") >= 1 }
test fn cand_5() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "DeclaredTypeNotInhabited", subject: "argument 'run_id'") >= 1 }
test fn cand_6() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "TypeMismatch", subject: "call argument 'run_id'") >= 1 }
test fn cand_7() -> Bool { refusals(c: census_of(name: "workflow_run_id_axis_call_arg"), class: "DeclaredTypeNotInhabited", subject: "Product(GitHubWorkflowRunId)") >= 1 }
