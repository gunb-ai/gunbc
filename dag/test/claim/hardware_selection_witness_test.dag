  label: "GENERIC-8CH-BOARD",
  socket: extdeps.cpu.types.CpuSocket { platform_owner: extdeps.vendor.ampere.ampere_vendor, termination: extdeps.cpu.types.SocketedLandGrid, contact_count: 4926, cooling_mount: extdeps.cpu.ampere.ampere_lga4926_cooling_mount },
