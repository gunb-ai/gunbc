module test.claim.hardware_selection

import std.logic { Bool }
import std.types { Int, List }
import std.measure { byte_size, byte_size_count, bit_width, watt, watt_count, hardware_thread_count, hertz, money_amount_micro }
import product.hardware_selection { milliwatt }
import extdeps.cpu.types { CpuModelCatalogRow, CpuSocket, SocketPackage }
import extdeps.toolchain.types { Architecture }
import extdeps.memory.types { DimmBuffering, DramModuleCatalogRow, dram_module_is_realizable, dram_module_required_die_density, dram_generation_ddr4 }
import extdeps.vendor.sk_hynix { sk_hynix }
import extdeps.vendor.ampere { ampere }
import extdeps.memory.jedec { ddr4_generation_catalog, jedec_ddr_generation_catalog_row }
import std.pareto { verdict_dominates, verdict_is_incomparable }
import product.hardware_selection {
  Platform,
  MemoryConfig,
  CpuCandidate,
  Motherboard,
  PsuModel,
  EfficiencyRating,
  SystemConfig,
  HardwareAxes,
  effective_data_rate_mts,
  config_axes,
  wall_draw_watts,
  psu_is_adequate,
  dominates,
  axes_on_front,
  config_is_realizable,
  cost_micros_per_gib,
  bandwidth_per_watt
}

data altra8: Platform = Platform {
  label: "altra-8ch-ddr4-3200",
  memory_channels: 8,
  slots_per_channel: 2,
  max_data_rate_mts: 3200
}

data stick_16g: ByteSize = byte_size(count: 17179869184)

data mod_1rx8_16g: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "GENERIC-16G-1RX8-3200",
  manufacturer: sk_hynix,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_16g,
  data_rate_mts: 3200,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 8),
  rank_count: 1
}

data mod_2rx8_16g: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "GENERIC-16G-2RX8-3200",
  manufacturer: sk_hynix,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_16g,
  data_rate_mts: 3200,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 8),
  rank_count: 2
}

data mod_1rx4_16g: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "HMA82GR7AFR4N-VK",
  manufacturer: sk_hynix,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_16g,
  data_rate_mts: 2666,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 4),
  rank_count: 1
}

data mod_1rx8_32g_impossible: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "FAKE-32G-1RX8-3200",
  manufacturer: sk_hynix,
  generation: dram_generation_ddr4,
  capacity_bytes: byte_size(count: 34359738368),
  data_rate_mts: 3200,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 8),
  rank_count: 1
}

data mem_1rx8_2dpc: MemoryConfig = MemoryConfig {
  module: mod_1rx8_16g, jedec: ddr4_generation_catalog, dimms_per_channel: 2, power_per_chip: milliwatt(count: 400), price_per_stick: money_amount_micro(count: 120000000)
}
data mem_2rx8_2dpc: MemoryConfig = MemoryConfig {
  module: mod_2rx8_16g, jedec: ddr4_generation_catalog, dimms_per_channel: 2, power_per_chip: milliwatt(count: 400), price_per_stick: money_amount_micro(count: 120000000)
}
data mem_1rx8_1dpc: MemoryConfig = MemoryConfig {
  module: mod_1rx8_16g, jedec: ddr4_generation_catalog, dimms_per_channel: 1, power_per_chip: milliwatt(count: 400), price_per_stick: money_amount_micro(count: 120000000)
}

data cpu_catalog: CpuModelCatalogRow = CpuModelCatalogRow {
  model_number: "GENERIC-ARM-64C",
  oem_listing_id: none,
  vendor: ampere,
  architecture: Aarch64,
  cores: 64,
  threads: hardware_thread_count(64),
  nominal_sustained_per_thread_hz: hertz(3000000000),
  socket: CpuSocket { package: LandGridArray, contact_count: 4926 },
  tdp_watts: watt(250)
}

data cpu_fast: CpuCandidate = CpuCandidate {
  catalog: cpu_catalog, typical_draw: watt(count: 166), price: money_amount_micro(count: 400000000), aggregate_throughput: 700
}
data cpu_slow: CpuCandidate = CpuCandidate {
  catalog: cpu_catalog, typical_draw: watt(count: 166), price: money_amount_micro(count: 400000000), aggregate_throughput: 400
}

data board1: Motherboard = Motherboard {
  label: "GENERIC-8CH-BOARD",
  socket: CpuSocket { package: LandGridArray, contact_count: 4926 },
  memory_channels: 8,
  max_dimms_per_channel: 2,
  idle_draw: watt(count: 30),
  price: money_amount_micro(count: 300000000)
}

data psu_gold_550: PsuModel = PsuModel {
  label: "GENERIC-550W-GOLD",
  max_output: watt(count: 550),
  efficiency: Gold,
  price: money_amount_micro(count: 90000000)
}

fn sys(cpu: CpuCandidate, mem: MemoryConfig) -> SystemConfig {
  SystemConfig { platform: altra8, cpu: cpu, memory: mem, board: board1, psu: psu_gold_550 }
}

data cfg_a_axes: HardwareAxes = config_axes(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))
data cfg_b_axes: HardwareAxes = config_axes(cfg: sys(cpu: cpu_fast, mem: mem_2rx8_2dpc))
data cfg_c_axes: HardwareAxes = config_axes(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_1dpc))
data cfg_slow_axes: HardwareAxes = config_axes(cfg: sys(cpu: cpu_slow, mem: mem_1rx8_2dpc))

fn downclock_is_rank_dependent() -> Bool {
  effective_data_rate_mts(platform: altra8, dimms_per_channel: 2, rank_count: 1) == 3200
    && effective_data_rate_mts(platform: altra8, dimms_per_channel: 2, rank_count: 2) == 2933
    && effective_data_rate_mts(platform: altra8, dimms_per_channel: 1, rank_count: 2) == 3200
}

fn psu_sizing_is_computed() -> Bool {
  psu_is_adequate(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))
    && watt_count(w: wall_draw_watts(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))) == 281
}

fn rank_tradeoff_is_incomparable() -> Bool {
  verdict_is_incomparable(v: dominates(a: cfg_a_axes, b: cfg_b_axes))
    && verdict_is_incomparable(v: dominates(a: cfg_b_axes, b: cfg_a_axes))
}

fn higher_throughput_dominates() -> Bool {
  verdict_dominates(v: dominates(a: cfg_a_axes, b: cfg_slow_axes))
}

fn front_keeps_tradeoffs_strips_dominated() -> Bool {
  let pool = [cfg_a_axes, cfg_b_axes, cfg_c_axes, cfg_slow_axes]
  axes_on_front(candidate: cfg_a_axes, pool: pool)
    && axes_on_front(candidate: cfg_b_axes, pool: pool)
    && axes_on_front(candidate: cfg_c_axes, pool: pool)
    && !axes_on_front(candidate: cfg_slow_axes, pool: pool)
}

fn realizability_rejects_impossible_sku() -> Bool {
  dram_module_is_realizable(module: mod_1rx8_16g, jedec: ddr4_generation_catalog)
    && dram_module_is_realizable(module: mod_2rx8_16g, jedec: ddr4_generation_catalog)
    && !dram_module_is_realizable(module: mod_1rx8_32g_impossible, jedec: ddr4_generation_catalog)
    && config_is_realizable(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))
}

fn real_part_computes_real_die_density() -> Bool {
  byte_size_count(b: dram_module_required_die_density(module: mod_1rx4_16g)) == 1073741824
}

fn derived_ratios_are_computed() -> Bool {
  cost_micros_per_gib(a: cfg_a_axes) > 0
    && bandwidth_per_watt(a: cfg_a_axes) > bandwidth_per_watt(a: cfg_b_axes)
}

test fn hardware_selection_holds() -> Bool {
  downclock_is_rank_dependent()
    && psu_sizing_is_computed()
    && rank_tradeoff_is_incomparable()
    && higher_throughput_dominates()
    && front_keeps_tradeoffs_strips_dominated()
    && realizability_rejects_impossible_sku()
    && real_part_computes_real_die_density()
    && derived_ratios_are_computed()
}
