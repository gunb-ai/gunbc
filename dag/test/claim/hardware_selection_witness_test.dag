}
data cpu_slow: product.hardware_selection.CpuCandidate = product.hardware_selection.CpuCandidate {
  catalog: cpu_catalog, typical_draw: std.measure.watt(count: 166), price: std.measure.money_amount_micro(count: 400000000), aggregate_throughput: 400
}

