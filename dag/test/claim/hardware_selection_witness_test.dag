data psu_gold_550: product.hardware_selection.PsuModel = product.hardware_selection.PsuModel {
  label: "GENERIC-550W-GOLD",
  max_output: std.measure.watt(count: 550),
  efficiency: product.hardware_selection.Gold,
  price: std.measure.money_amount_micro(count: 90000000)
}

fn sys(cpu: product.hardware_selection.CpuCandidate, mem: product.hardware_selection.MemoryConfig) -> product.hardware_selection.SystemConfig {
  product.hardware_selection.SystemConfig { platform: altra8, cpu: cpu, memory: mem, board: board1, psu: psu_gold_550 }
}

data cfg_a_axes: product.hardware_selection.HardwareAxes = product.hardware_selection.config_axes(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))
data cfg_b_axes: product.hardware_selection.HardwareAxes = product.hardware_selection.config_axes(cfg: sys(cpu: cpu_fast, mem: mem_2rx8_2dpc))
data cfg_c_axes: product.hardware_selection.HardwareAxes = product.hardware_selection.config_axes(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_1dpc))
data cfg_slow_axes: product.hardware_selection.HardwareAxes = product.hardware_selection.config_axes(cfg: sys(cpu: cpu_slow, mem: mem_1rx8_2dpc))

test fn downclock_is_rank_dependent() -> Bool {
  product.hardware_selection.effective_data_rate_mts(platform: altra8, dimms_per_channel: 2, rank_count: 1) == 3200
    && product.hardware_selection.effective_data_rate_mts(platform: altra8, dimms_per_channel: 2, rank_count: 2) == 2933
    && product.hardware_selection.effective_data_rate_mts(platform: altra8, dimms_per_channel: 1, rank_count: 2) == 3200
}

test fn psu_sizing_is_computed() -> Bool {
  product.hardware_selection.psu_is_adequate(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))
    && std.measure.watt_count(w: product.hardware_selection.wall_draw_watts(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))) == 281
}

test fn rank_tradeoff_is_incomparable() -> Bool {
  std.pareto.verdict_is_incomparable(v: product.hardware_selection.dominates(a: cfg_a_axes, b: cfg_b_axes))
    && std.pareto.verdict_is_incomparable(v: product.hardware_selection.dominates(a: cfg_b_axes, b: cfg_a_axes))
}

test fn higher_throughput_dominates() -> Bool {
  std.pareto.verdict_dominates(v: product.hardware_selection.dominates(a: cfg_a_axes, b: cfg_slow_axes))
}

test fn front_keeps_tradeoffs_strips_dominated() -> Bool {
  let pool = [cfg_a_axes, cfg_b_axes, cfg_c_axes, cfg_slow_axes]
  product.hardware_selection.axes_on_front(candidate: cfg_a_axes, pool: pool)
    && product.hardware_selection.axes_on_front(candidate: cfg_b_axes, pool: pool)
    && product.hardware_selection.axes_on_front(candidate: cfg_c_axes, pool: pool)
    && !product.hardware_selection.axes_on_front(candidate: cfg_slow_axes, pool: pool)
}

test fn realizability_rejects_impossible_sku() -> Bool {
  extdeps.memory.types.dram_module_is_realizable(module: mod_1rx8_16g, jedec: extdeps.memory.jedec.ddr4_generation_catalog)
    && extdeps.memory.types.dram_module_is_realizable(module: mod_2rx8_16g, jedec: extdeps.memory.jedec.ddr4_generation_catalog)
    && !extdeps.memory.types.dram_module_is_realizable(module: mod_1rx8_32g_impossible, jedec: extdeps.memory.jedec.ddr4_generation_catalog)
    && product.hardware_selection.config_is_realizable(cfg: sys(cpu: cpu_fast, mem: mem_1rx8_2dpc))
}

test fn real_part_computes_real_die_density() -> Bool {
  std.measure.byte_size_count(b: extdeps.memory.types.dram_module_required_die_density(module: mod_1rx4_16g)) == 1073741824
}

test fn derived_ratios_are_computed() -> Bool {
  product.hardware_selection.cost_micros_per_gib(a: cfg_a_axes) > 0
    && product.hardware_selection.bandwidth_per_watt(a: cfg_a_axes) > product.hardware_selection.bandwidth_per_watt(a: cfg_b_axes)
}

