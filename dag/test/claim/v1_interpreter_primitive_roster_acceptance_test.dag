module test.claim.v1_interpreter_primitive_roster_acceptance

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.v1_interpreter_primitive_surface {
  DeclaredHere,
  DerivedFromDispatch,
  FreeCall,
  InterpreterPrimitiveArmId,
  InterpreterPrimitiveDispatchArm,
  MethodCall,
  decode_dispatch_form,
  duplicate_row_keys,
  form_has_no_shadowed_spelling,
  form_is_unknown,
  shadowed_spellings,
  v1_interpreter_declared_arms,
  v1_interpreter_derived_arms,
  v1_interpreter_primitive_arms,
  v1_interpreter_unknown_form_arms,
}
import std.primitive_identity { primitive_d0_derived_rows_missing_identity_count }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data closing_contract_note: String = "THE CLOSING CHECK FOR v1-interpreter-primitive-roster, DELIBERATELY STRUCTURAL RATHER THAN POPULATION-PINNED. The node's bar is that the interpreter's dispatch surface is ENUMERABLE and that its roster cannot silently disagree with the dispatch -- not that the surface currently has any particular size. So every clause below is a property that survives the roster legitimately growing: which named dispatch sites contribute rows, that duplicate row keys refuse, that shadows are exactly the known set by NAME, that every declared row carries its own dissolution trigger, that an arm carrying no semantic primitive identity stays representable, and that an unrecognised form label refuses rather than defaulting.\n\nWHY NO COUNTS. #7615 deleted the five witnesses that pinned live-population counts (7 dispatch sites, 183 derived rows, 2 declared, 174 arm identities, 161 spellings) because DESIGN.md 5 rules a measurement copied from the same current tree is not an oracle, and those five had already behaved exactly as that rule predicts -- redding main twice as pure change detectors (#7575 landed one derived arm short, #7614 repaired, #7615 removed the class). Binding this node's completion to a count would re-introduce the same defect at the acceptance layer, where it would be worse: a node whose closing check reds on legitimate growth teaches everyone to edit the number.\n\nWHAT MAKES THIS ABLE TO FAIL. Each clause names a live structure rather than a constant, so removing the map-grounding dispatch site, dropping a declared row's trigger, admitting an unknown form label, or letting a second arm identity shadow a spelling all red it. The discriminating REDs for the detectors themselves (planted duplicate, planted shadow) and their positive controls (a real alias pair, one spelling at two distinct sites) stay in test.claim.v1_interpreter_primitive_surface_witness_test, which executes alongside this file; this contract asserts the live surface satisfies what those detectors decide."

fn planted_row(identity: String, spelling: String, symbol: String) -> InterpreterPrimitiveDispatchArm {
  InterpreterPrimitiveDispatchArm {
    arm: InterpreterPrimitiveArmId { identity: identity },
    form: FreeCall,
    authored_spelling: spelling,
    realization_module: "planted",
    dispatch_symbol: symbol,
    enumeration: DerivedFromDispatch,
  }
}

fn known_dispatch_sites_derive_their_rows() -> Bool {
  let symbols = [
    "eval_builtin_inner",
    "eval_algebra_method_inner",
    "eval_call",
    "try_v2_std_collection_map_primitive_grounding",
    "try_parse_table_memo_dispatch",
  ]
  symbols |> all(s => v1_interpreter_derived_arms() |> any(r => r.dispatch_symbol == s))
    && (v1_interpreter_derived_arms() |> all(r => r.enumeration == DerivedFromDispatch))
}

fn duplicate_row_keys_refuse() -> Bool {
  count(duplicate_row_keys(rows: v1_interpreter_primitive_arms())) == 0
    && count(duplicate_row_keys(rows: [
        planted_row(identity: "planted.alpha", spelling: "alpha", symbol: "planted_dispatch"),
        planted_row(identity: "planted.alpha", spelling: "alpha", symbol: "planted_dispatch"),
      ])) == 1
}

fn shadows_are_exactly_the_known_named_set() -> Bool {
  let free = shadowed_spellings(rows: v1_interpreter_primitive_arms() |> filter(r => r.form == FreeCall))
  let method = shadowed_spellings(rows: v1_interpreter_primitive_arms() |> filter(r => r.form == MethodCall))
  count(free) == 2
    && (free |> any(x => x == "inert_lens_unreached_module_count"))
    && (free |> any(x => x == "inert_lens_top_level_module_count"))
    && count(method) == 1
    && (method |> all(x => x == "lookup"))
    && !form_has_no_shadowed_spelling(rows: [
        planted_row(identity: "planted.alpha", spelling: "alpha", symbol: "planted_dispatch"),
        planted_row(identity: "planted.beta", spelling: "alpha", symbol: "planted_dispatch"),
      ])
}

fn declared_rows_carry_exact_triggers() -> Bool {
  let expected = ["eval_method_call", "eval_service_call"]
  let actual = v1_interpreter_declared_arms() |> map(r => r.dispatch_symbol)
  count(actual |> filter(s => !expected |> any(e => e == s))) == 0
    && count(expected |> filter(e => !actual |> any(s => s == e))) == 0
    && (v1_interpreter_declared_arms() |> all(r =>
        match r.enumeration {
          DeclaredHere { dissolve_on } => string_contains(s: dissolve_on, pattern: "dissolves when")
          DerivedFromDispatch => false
        }))
}

fn arms_without_semantic_identity_stay_representable() -> Bool {
  primitive_d0_derived_rows_missing_identity_count() > 0
}

fn unrecognised_form_refuses_rather_than_defaulting() -> Bool {
  count(v1_interpreter_unknown_form_arms()) == 0
    && form_is_unknown(form: decode_dispatch_form(label: "NotAFormLabel"))
    && !form_is_unknown(form: decode_dispatch_form(label: "FreeCall"))
}

test fn v1_interpreter_primitive_roster_acceptance_contract_holds() -> Bool {
  known_dispatch_sites_derive_their_rows()
    && duplicate_row_keys_refuse()
    && shadows_are_exactly_the_known_named_set()
    && declared_rows_carry_exact_triggers()
    && arms_without_semantic_identity_stay_representable()
    && unrecognised_form_refuses_rather_than_defaulting()
}
