module test.claim.owned_ci_witness


data owned_ci_witness_note: String = "Owned CI v0 decision-procedure witnesses: lease expiry, fork refusal, publication honesty, subject identity, execution plan shape."

fn sample_tree_hash() -> extdeps.git.object_store.GitObjectId {
  match git_sha1_object_id(hex: "4b825dc642cb6eb9a060e54bf8d69288fbee4904") {
    Present { value: oid } => oid
    Absent =>
      extdeps.git.object_store.GitSha1ObjectId {
        digest: std.content_hash.Sha1Digest {
          hex: "4b825dc642cb6eb9a060e54bf8d69288fbee4904" as std.content_hash.Sha1DigestHex,
        },
      }
  }
}

test fn witness_refused_subject_has_no_head_sha() -> Bool {
  match ci_subject_head_sha(
    subject: gunbc.ci_execution_plan.ForkPullRequestRefused {
      pr_number: 1,
      head_repo_full_name: "other/fork",
      reason: "fork PRs refuse in v0" as std.types.NonEmptyStr,
    },
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn witness_poll_without_github_read_refuses() -> Bool {
  match owned_ci_pr_poll_github_read_admission(token_observation: none) {
    PrPollGithubReadRefused { cause: c } =>
      c == owned_ci_pr_poll_missing_github_token_cause()
    PrPollGithubReadAdmitted => false
  }
    && match owned_ci_pr_poll_github_read_admission(token_observation: Present { value: "" }) {
      PrPollGithubReadRefused { cause: c } =>
        c == owned_ci_pr_poll_empty_github_token_cause()
      PrPollGithubReadAdmitted => false
    }
    && match owned_ci_pr_poll_github_read_admission(token_observation: Present { value: "ghp_test" }) {
      PrPollGithubReadAdmitted => true
      PrPollGithubReadRefused { cause: _ } => false
    }
}

test fn witness_fork_pr_refused() -> Bool {
  let subject = gunbc.ci_execution_plan.ForkPullRequestRefused {
    pr_number: 1,
    head_repo_full_name: "other/fork",
    reason: "fork PRs refuse in v0" as std.types.NonEmptyStr,
  }
  match subject {
    ForkPullRequestRefused { pr_number: _, head_repo_full_name: _, reason: _ } => true
    PushToMain { head_sha: _, base_tree_hash: _ } => false
    PullRequestToMain { pr_number: _, head_sha: _, base_ref: _, base_tree_hash: _, head_repo_full_name: _ } => false
    OperatorRerun { head_sha: _, base_ref: _, base_tree_hash: _ } => false
  }
    && !(ci_pull_request_is_same_repo(head_repo_full_name: "other/fork"))
}

test fn witness_same_repo_pr_admits() -> Bool {
  ci_pull_request_is_same_repo(head_repo_full_name: gunbc_repository.full_name)
}

test fn witness_pr_to_main_base_ref_admits() -> Bool {
  ci_pull_request_targets_merge_branch(base_ref: gunbc_default_branch_name)
    && !ci_pull_request_targets_merge_branch(base_ref: "develop")
    && !ci_pull_request_targets_merge_branch(base_ref: "release-1.0")
}

test fn witness_expired_lease_is_reclaimed() -> Bool {
  let lease = gunbc.owned_ci.QueueLease {
    holder: "stale-host",
    expires_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 50 },
  }
  let now = extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 50 }
  match queue_lease_reclaim_decision(lease: lease, now: now) {
    ReclaimExpiredLease => true
    RetainActiveLease => false
    LeaseReclaimRefused { cause: _ } => false
  }
    && match queue_lease_reclaim_decision(lease: lease, now: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 51 }) {
      ReclaimExpiredLease => true
      RetainActiveLease => false
      LeaseReclaimRefused { cause: _ } => false
    }
    && match queue_lease_reclaim_decision(lease: lease, now: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 49 }) {
      ReclaimExpiredLease => false
      RetainActiveLease => true
      LeaseReclaimRefused { cause: _ } => false
    }
}

test fn witness_queue_lease_expiry() -> Bool {
  let lease = gunbc.owned_ci.QueueLease {
    holder: "host-1",
    expires_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 100 },
  }
  let at = extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 100 }
  let after = extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 101 }
  let before = extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 99 }
  let mid = extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 50 }
  match queue_lease_reclaim_decision(lease: lease, now: at) {
    ReclaimExpiredLease => true
    RetainActiveLease => false
    LeaseReclaimRefused { cause: _ } => false
  }
    && match queue_lease_reclaim_decision(lease: lease, now: after) {
      ReclaimExpiredLease => true
      RetainActiveLease => false
      LeaseReclaimRefused { cause: _ } => false
    }
    && match queue_lease_reclaim_decision(lease: lease, now: before) {
      ReclaimExpiredLease => false
      RetainActiveLease => true
      LeaseReclaimRefused { cause: _ } => false
    }
    && match queue_lease_validity(lease: lease, holder: "host-1", now: mid) {
      LeaseValidForHolder => true
      LeaseInvalidHolder => false
      LeaseExpiredForHolder => false
      LeaseValidityRefused { cause: _ } => false
    }
    && match queue_lease_validity(lease: lease, holder: "host-2", now: mid) {
      LeaseValidForHolder => false
      LeaseInvalidHolder => true
      LeaseExpiredForHolder => false
      LeaseValidityRefused { cause: _ } => false
    }
}

test fn witness_fractional_lease_clock_refuses() -> Bool {
  let whole_lease = gunbc.owned_ci.QueueLease {
    holder: "host",
    expires_at: extdeps.auth.jwt.NumericDateWholeSeconds { seconds: 100 },
  }
  let fractional_now = extdeps.auth.jwt.NumericDateFractionalSeconds {
    whole_seconds: 200,
    fractional_digits: "5" as std.types.NonEmptyStr,
  }
  match queue_lease_reclaim_decision(lease: whole_lease, now: fractional_now) {
    LeaseReclaimRefused { cause: _ } => true
    ReclaimExpiredLease => false
    RetainActiveLease => false
  }
    && match queue_lease_validity(
      lease: whole_lease,
      holder: "host",
      now: fractional_now,
    ) {
      LeaseValidityRefused { cause: _ } => true
      LeaseValidForHolder => false
      LeaseInvalidHolder => false
      LeaseExpiredForHolder => false
    }
}

test fn witness_unpublished_completed_run_has_no_check_conclusion() -> Bool {
  match owned_ci_check_conclusion_for_queue(
    state: QueueCompleted,
    publication: CheckPublicationNotStarted,
  ) {
    Absent => true
    Present { value: _ } => false
  }
    && match owned_ci_check_conclusion_for_queue(
      state: QueueCompleted,
      publication: gunbc.owned_ci.CheckPublicationPending {
        local_conclusion: Success,
        details_url: "http://localhost/ci/run/x" as std.types.NonEmptyStr,
      },
    ) {
      Present { value: c } => c == Success
      Absent => false
    }
}

test fn witness_queue_refused_maps_to_failure() -> Bool {
  match owned_ci_check_conclusion_for_queue(
    state: gunbc.owned_ci.QueueRefused { cause: "fork PR refused in v0" },
    publication: CheckPublicationNotStarted,
  ) {
    Present { value: Failure } => true
    Present { value: Success } => false
    Absent => false
  }
}

test fn witness_publication_pending_is_not_github_success() -> Bool {
  let pending = gunbc.owned_ci.CheckPublicationPending {
    local_conclusion: Success,
    details_url: "http://localhost/ci/run/x" as std.types.NonEmptyStr,
  }
  check_publication_is_pending_honest(state: pending)
    && !(check_publication_reports_github_success(state: pending))
}

test fn witness_publication_completed_is_github_success() -> Bool {
  let done = gunbc.owned_ci.CheckPublicationCompleted { check_run_id: 1, conclusion: Success }
  check_publication_reports_github_success(state: done)
    && !(check_publication_is_pending_honest(state: done))
}

test fn witness_execution_plan_stages_build_regen_floor() -> Bool {
  let subject = gunbc.ci_execution_plan.PushToMain {
    head_sha: "abc123",
    base_tree_hash: sample_tree_hash(),
  }
  let plan = ci_execution_plan_for_subject(subject: subject)
  (plan.check_name == owned_ci_check_name)
    && (length(plan.stages) == 3)
    && (plan.stages.first() == CiBuildStage)
    && (plan.stages.skip(n: 1).first() == CiRegenStage)
    && (plan.stages.skip(n: 2).first() == CiFloorStage)
}

test fn witness_subject_identity_keys_differ_by_sha() -> Bool {
  let a = gunbc.ci_execution_plan.PushToMain { head_sha: "aaa", base_tree_hash: sample_tree_hash() }
  let b = gunbc.ci_execution_plan.PushToMain { head_sha: "bbb", base_tree_hash: sample_tree_hash() }
  (ci_subject_identity_key(subject: a) == concat(concat(gunbc_default_branch_name, ":"), "aaa"))
    && (ci_subject_identity_key(subject: b) == concat(concat(gunbc_default_branch_name, ":"), "bbb"))
    && (ci_subject_identity_key(subject: a) != ci_subject_identity_key(subject: b))
}

test fn witness_operator_rerun_identity_key() -> Bool {
  let subject = gunbc.ci_execution_plan.OperatorRerun {
    head_sha: "deadbeef",
    base_ref: gunbc_default_branch_name,
    base_tree_hash: sample_tree_hash(),
  }
  ci_subject_identity_key(subject: subject) == "rerun:deadbeef"
}

test fn witness_executor_stage_labels_match_plan() -> Bool {
  let labels = owned_ci_executor_stage_labels()
  (length(labels) == 3)
    && (labels.first() == "build")
    && (labels.skip(n: 1).first() == "regen")
    && (labels.skip(n: 2).first() == "floor")
}

test fn witness_run_id_admits_produced_shape() -> Bool {
  owned_ci_run_id_admits(run_id: "1730000000-deadbeef")
    && owned_ci_run_id_admits(run_id: "42-abcdef12")
}

test fn witness_run_id_refuses_path_traversal_and_malformed() -> Bool {
  !(owned_ci_run_id_admits(run_id: "../etc/passwd"))
    && !(owned_ci_run_id_admits(run_id: "a/b"))
    && !(owned_ci_run_id_admits(run_id: ".."))
    && !(owned_ci_run_id_admits(run_id: "1730000000-deadbeef-extra"))
    && !(owned_ci_run_id_admits(run_id: "notdigits-deadbeef"))
    && !(owned_ci_run_id_admits(run_id: "1730000000-short"))
}

test fn witness_owned_ci_witness_bundle() -> Bool {
  witness_poll_without_github_read_refuses()
    && witness_refused_subject_has_no_head_sha()
    && witness_fork_pr_refused()
    && witness_same_repo_pr_admits()
    && witness_expired_lease_is_reclaimed()
    && witness_queue_lease_expiry()
    && witness_queue_refused_maps_to_failure()
    && witness_fractional_lease_clock_refuses()
    && witness_publication_pending_is_not_github_success()
    && witness_publication_completed_is_github_success()
    && witness_execution_plan_stages_build_regen_floor()
    && witness_run_id_admits_produced_shape()
    && witness_run_id_refuses_path_traversal_and_malformed()
    && witness_executor_stage_labels_match_plan()
    && witness_unpublished_completed_run_has_no_check_conclusion()
    && witness_subject_identity_keys_differ_by_sha()
}
