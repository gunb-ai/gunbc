// THE OPERATOR'S CONDITIONS FOR THE DISPATCH-ONLY INSTRUMENT WORKFLOW, AS THE GENERATED TEXT CARRIES
// THEM. The drift gate (gunbc.generated_artifact) holds the committed file to this generator; these
// claims hold the generator to the conditions. COVERAGE, STATED: no required job executes these rows
// (nothing in .github/workflows names this file), so they are evidence I run by hand, not gate
// coverage -- §4b. What makes them live rather than decorative is that each was measured against a
// mutation: reverting the one concurrency-group row fails exactly the two group rows, and deleting the
// swap observation from the guard fails exactly the swap row, with every other row green in both runs.

// The input is a closed choice whose every option is a rostered instrument label.
test fn every_dispatch_option_is_a_rostered_instrument_label_holds() -> Bool {
  instrument_dispatch_labels_are_rostered() && (length(xs: instrument_dispatch_label_options()) > 0)
}

fn generated_text() -> String {
  match expected_instrument_dispatch_yml() {
    InstrumentDispatchWorkflowGenerated { content: c } => c
    InstrumentDispatchWorkflowGenerationRefused { reason: _ } => ""
  }
}

// workflow_dispatch is the only trigger; the input is a choice; the job is bounded, serialized and
// read-only; and the receipt is uploaded on every termination.
// SERIALIZED MEANS QUEUED, NOT REPLACED: the group carries queue: max with cancel-in-progress false,
// and the bare scalar form -- under which a pending run is cancelled by the next dispatch with no
// signal to its owner (gunbc.recurring_failure_mode
// pending_run_cancelled_by_a_later_dispatch_with_no_signal) -- is refused by name.
// THE GROUP IS ONE NO PRE-FIX REF NAMES: a scalar-form dispatch cancels every pending run in its own
// group, so sharing the old group name would leave this queue cancellable from any branch cut before
// the fix. The old name is refused as a group here for that reason.
test fn the_workflow_is_dispatch_only_bounded_serialized_and_read_only_holds() -> Bool {
  let t = generated_text()
  contains(t, "workflow_dispatch:")
    && !contains(t, "pull_request")
    && !contains(t, "merge_group")
    && !contains(t, "schedule")
    && !contains(t, "push:")
    && contains(t, "type: choice")
    && contains(t, "timeout-minutes: 360")
    && contains(t, "concurrency:\n  queue: max\n  group: ")
    && contains(t, "\n  cancel-in-progress: false\n")
    && !contains(t, "concurrency: instrument-dispatch")
    && !contains(t, "group: instrument-dispatch\n")
    && contains(t, "contents: read")
    && !contains(t, ": write")
    && contains(t, "instrument-dispatch-receipt")
    && contains(t, "if: always()")
    && contains(t, instrument_dispatch_wave_concurrency_group_expression())
    && all(instrument_dispatch_wave_concurrency_group_keys(), k => contains(t, k))
    && all(instrument_dispatch_wave_concurrency_group_keys(), k => instrument_dispatch_concurrency_key_is_closed(key: k))
    && (length(xs: instrument_dispatch_wave_concurrency_group_keys()) == instrument_dispatch_concurrency_cap)
    && (instrument_dispatch_concurrency_cap == instrument_dispatch_wave_shard_count + 2)
    // THE SPINE FALLTHROUGH: the chain's last operand is format() over the same (prefix, ref, label)
    // parts as instrument_dispatch_concurrency_group_template -- the same VALUE the spine emits, so a
    // non-wave dispatch queues per (ref, label) exactly as main's #14613 dispatch key does. And the
    // name GitHub holds WEDGED ('instrument-dispatch-queued'; evidence recorded beside the wave group
    // keys) must appear NOWHERE in the emitted yml -- not as the default of the group expression, not
    // as any literal. A yml still naming it queues labels into a group whose members never promote.
    && contains(t, "format('instrument-dispatch-', '-', github.ref, '-', inputs.label)")
    && !contains(t, "instrument-dispatch-queued")
}

// THE BOUNDED SET IS THE CAP (operator ruling 2026-10-20). Max concurrency IS the number of keys, so
// the key set is checked closed against the shapes the ruling forbids: a key built from the run id or
// run number (per-run-unique: every dispatch gets its own group, which is no bound at all), a key
// interpolated from a free-text input (bounded only by what a dispatcher can type), and an empty key.
// Each is a RED: the predicate must refuse it. The positive half -- the emitted keys all pass -- lives
// in the claim above, over the generated text, not over a hand-listed roster.
test fn an_unbounded_or_per_run_concurrency_key_refuses() -> Bool {
  !instrument_dispatch_concurrency_key_is_closed(key: "instrument-dispatch-run-${{ github.run_id }}")
    && !instrument_dispatch_concurrency_key_is_closed(key: "instrument-dispatch-run-${{ github.run_number }}")
    && !instrument_dispatch_concurrency_key_is_closed(key: "instrument-dispatch-${{ inputs.wave_shard }}")
    && !instrument_dispatch_concurrency_key_is_closed(key: "")
    && !instrument_dispatch_concurrency_key_is_closed(key: "instrument-dispatch-wave-0/4")
}

fn step_name(step: Step) -> String {
  match step {
    RunStep { name: n, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n {
        Present { value: v } => v
        Absent => ""
      }
    UsesStep { name: n, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n {
        Present { value: v } => v
        Absent => ""
      }
  }
}

// THE RECEIPT'S PRODUCER PRECEDES EVERYTHING THAT CAN FAIL (review of gunbc#12998). Over the job's own
// step list: the first step is the seed, and the checkout and the build come after it, so a run that dies
// in the prelude still has a receipt for the always() upload to read.
test fn the_receipt_is_seeded_before_the_fallible_prelude_holds() -> Bool {
  let names = map(instrument_dispatch_steps(seed: "", guard: "", script: ""), s => step_name(step: s))
  let first = fold(names, init: "", f: fn(acc, n) { if acc == "" { n } else { acc } })
  (first == instrument_dispatch_seed_step_name)
    && any(names, n => n == "Checkout")
    && any(names, n => n == "Build the compiler")
}

// THE FLEET ROUTE SELECTS THE D13 CENSUS: the generated choice carries that exact label, so D13's
// row-deletion change can dispatch the census at its own head (review of gunbc#12992).
test fn the_dispatch_choice_offers_the_dependency_demand_census_holds() -> Bool {
  contains(generated_text(), "//gunbc/instruments:dependency-demand-census")
}

// THE EFFECT-PAIR CENSUS IS DISPATCHABLE: the generated choice carries its label (B0, D16 TRIGGER), so the
// census runs on the fleet at the head under review rather than on a session host.
test fn the_dispatch_choice_offers_the_effect_pair_census_holds() -> Bool {
  contains(generated_text(), "//gunbc/instruments:effect-pair-census")
}

// THE WHOLE-TREE INSTRUMENTS CARRY A DECLARED MEMORY DEMAND (follow-up to gunbc#13141): each census label
// has a row, every row is dispatchable, and the selected runner target's budget admits every row.
test fn the_whole_tree_censuses_declare_a_memory_demand_the_selected_target_admits_holds() -> Bool {
  let declared = map(instrument_dispatch_memory_demands(), d => render_label(l: d.label))
  any(declared, l => l == render_label(l: dependency_demand_census_label()))
    && any(declared, l => l == render_label(l: effect_pair_census_label()))
    && any(declared, l => l == render_label(l: v2_native_census_label()))
    && instrument_dispatch_memory_demands_are_dispatchable()
    && instrument_dispatch_memory_demands_fit_selected_target()
}

// The discriminating red: a demand above the target's budget does not fit, so the generator refuses
// rather than emitting a workflow whose runner cannot hold the subject; a demand at the budget fits.
test fn a_memory_demand_above_the_target_budget_does_not_fit_holds() -> Bool {
  let row = InstrumentDispatchMemoryDemand { label: v2_native_census_label(), demand: byte_size(21474836481) }
  !instrument_dispatch_memory_demands_fit(demands: [row], budget: byte_size(21474836480))
    && instrument_dispatch_memory_demands_fit(demands: [row], budget: byte_size(21474836481))
}

// THE RUN-TIME WALL PRECEDES THE PRELUDE AND IS BOUND TO ITS LABEL: the generated text carries a guard
// per declared row, gated on that label's input, refusing with exit 1 below the declared byte count,
// and the guard runs before the checkout so an under-provisioned runner spends nothing.
fn step_if(step: Step) -> String {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: c, continue_on_error: _, timeout_minutes: _ } =>
      match c {
        Present { value: v } => v
        Absent => ""
      }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: c, continue_on_error: _, timeout_minutes: _ } =>
      match c {
        Present { value: v } => v
        Absent => ""
      }
  }
}

test fn the_memory_guard_is_label_bound_and_precedes_the_prelude_holds() -> Bool {
  let t = generated_text()
  let steps = instrument_dispatch_steps(seed: "", guard: "", script: "")
  let names = map(steps, s => step_name(step: s))
  let guard = concat("Require the declared memory for ", render_label(l: v2_native_census_label()))
  let bound = concat(concat("inputs.label == '", render_label(l: v2_native_census_label())), "'")
  let before_checkout = fold(names, init: "searching", f: fn(acc, n) {
    if acc != "searching" { acc } else { if n == guard { "guard-first" } else { if n == "Checkout" { "checkout-first" } else { acc } } }
  })
  any(steps, s => (step_name(step: s) == guard) && (step_if(step: s) == bound))
    && contains(t, "REQUIRED_MEMORY_BYTES")
    && contains(t, to_string(byte_size_count(b: instrument_dispatch_whole_tree_memory_demand)))
    && contains(t, "InstrumentMemoryBudgetUnmet")
    && (before_checkout == "guard-first")
}

// The stage0 regen round's price is dispatchable, and its row carries its own declared demand rather
// than borrowing the whole-tree census's: a gate sized for the largest subject refuses every smaller one.
test fn the_dispatch_choice_offers_the_regen_round_cost_with_its_own_memory_demand_holds() -> Bool {
  let declared = map(instrument_dispatch_memory_demands(), d => render_label(l: d.label))
  contains(generated_text(), "//gunbc/instruments:regen-round-cost")
    && any(declared, l => l == render_label(l: regen_round_cost_label()))
    && contains(generated_text(), to_string(byte_size_count(b: instrument_dispatch_stage0_regen_memory_demand)))
}

// C5: the dependency arm is dispatched, so it must be offered AND carry its own row at the compute
// price. An un-rostered option refuses the whole corpus; a missing row refuses the guard, and the
// run would take the DEFAULT budget -- which for a two-build instrument is a silent OOM, not a clean
// refusal. Same demand object as the compute row, never the whole-tree row.
test fn the_compute_dependency_wrong_capture_dispatch_carries_its_own_memory_demand_holds() -> Bool {
  let declared = map(instrument_dispatch_memory_demands(), d => render_label(l: d.label))
  contains(generated_text(), "//gunbc/instruments:compute-dependency-wrong-capture")
    && any(declared, l => l == render_label(l: compute_dependency_wrong_capture_label()))
    && any(instrument_dispatch_memory_demands(), d =>
      (render_label(l: d.label) == render_label(l: compute_dependency_wrong_capture_label()))
        && (d.demand == instrument_dispatch_compute_run_unit_cold_memory_demand))
    && (contains(generated_text(), "compute-dependency-wrong-capture"))
}

test fn the_compute_run_unit_cold_dispatch_carries_its_own_memory_demand_holds() -> Bool {
  let declared = map(instrument_dispatch_memory_demands(), d => render_label(l: d.label))
  contains(generated_text(), "//gunbc/instruments:compute-run-unit-cold")
    && any(declared, l => l == render_label(l: compute_run_unit_cold_label()))
    && any(instrument_dispatch_memory_demands(), d =>
      (render_label(l: d.label) == render_label(l: compute_run_unit_cold_label()))
        && (d.demand == instrument_dispatch_compute_run_unit_cold_memory_demand))
    && (instrument_dispatch_compute_run_unit_cold_memory_demand == compute_run_unit_cold_job_memory_demand())
    && (byte_size_count(b: instrument_dispatch_compute_run_unit_cold_memory_demand)
      > byte_size_count(b: compute_run_unit_cold_unit_grant_bytes))
    && contains(generated_text(), to_string(byte_size_count(b: instrument_dispatch_compute_run_unit_cold_memory_demand)))
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE GROUP IS KEYED PER DISPATCH, AND THE MEMORY WALL IS THE SLOT, NOT THE HOST.
//
// WHY A GROUP AT ALL. The instrument fleet and the required v2-bootstrap witnesses request the same
// runner labels (gunbc.ci.ci_runner_placement puts both on self-hosted linux arm64), so an unbounded
// instrument fan-out sits on the same pool as the required lane. THESE ROWS HOLD ONLY THE LOWER EDGE:
// one measurement cannot run twice against itself, and two different labels on one ref must not collapse
// into one group. The UPPER edge question was settled by the operator, not left open: a concurrency
// group never isolated jobs from each other, so no upper edge worth having was lost. The wall between
// jobs on that pool is the SLOT -- gunbc.runner.runner_slot_desired + gunbc.host.memory_envelope -- and
// the operator ruling saying so is carried in gunbc.design_ruling
// instrument_measurement_queues_run_in_parallel.provenance; the fleet gap that IS real (live unit shape
// vs declared slot shape) is gunbc.recurring_failure_mode
// the_live_runner_unit_memory_shape_drifts_from_the_declared_slot.

// THE GROUP IS TYPED THROUGH THE EXPRESSION MODEL, AND THE EMITTED TEXT IS ITS PROJECTION. The
// witness pins the SEGMENT STRUCTURE (prefix, hyphen, ref interpolation over Github, hyphen, label
// interpolation over Inputs) and asserts the emitted yml carries the serializer's rendering of
// exactly that structure -- the ${{ }} medium lives only in extdeps.github.expressions, never in a
// string fragment here (the typed-template rule review 85263 enforces). A consumer can ask which
// half changed: prefix, context, or path.
test fn the_emitted_group_carries_the_ref_and_label_expressions_holds() -> Bool {
  let t = generated_text()
  instrument_dispatch_concurrency_group == serialize_template(template: instrument_dispatch_concurrency_group_template)
    && instrument_dispatch_concurrency_group_template.segments == [
        LiteralText { text: instrument_dispatch_group_prefix },
        LiteralText { text: "-" },
        Interpolation { expression: ContextAccess { context: Github, path: ["ref"] } },
        LiteralText { text: "-" },
        Interpolation { expression: ContextAccess { context: Inputs, path: [instrument_dispatch_label_input] } }
      ]
    && contains(t, instrument_dispatch_wave_concurrency_group_expression())
    && contains(t, "group: ${{ ")
}

// THE RED FOR THE OLD SHAPE. One global group name for every label is what the fleet ran with, and it
// is what makes two unrelated measurements queue behind one another. The emitted text must not carry
// it in ANY position, and must not carry the bare prefix as a whole-line group either (a pre-fix ref
// dispatching that name could cancel this queue: see the scalar-form note in the model).
test fn no_global_group_name_survives_in_the_emitted_workflow_holds() -> Bool {
  let t = generated_text()
  !contains(t, "group: instrument-dispatch-queued")
    && !contains(t, "group: instrument-dispatch\n")
    && !contains(t, "concurrency: instrument-dispatch")
    && !contains(t, "concurrency: instrument-dispatch-queued")
}

// (a) EVERY ROSTERED DEMAND FITS THE SLOT CEILING IT RUNS INSIDE, not merely "the selected target's
// budget" at large. This is the row that survives a routing flip: the ceiling it names is the slot's
// own speed line, which is the cgroup that actually enforces the bound (gunbc.runner.runner_slot_desired
// memory_high / memory_max), so a demand that fits here fits what will kill or throttle it.
test fn every_rostered_demand_fits_the_slot_speed_ceiling_directly_holds() -> Bool {
  instrument_dispatch_memory_demands_fit(
    demands: instrument_dispatch_memory_demands(),
    budget: gunbc_ci_runner_slot_ram_speed_ceiling(),
  )
    && (length(xs: instrument_dispatch_memory_demands()) > 0)
}

// (c) THE CURRENT ROUTING ADDS NOTHING TO THE WALL. Under the committed routing the selected target's
// budget IS the slot ceiling -- it is not a second, larger number that would let a demand through the
// model and into a cgroup kill. This is a RELATION, not a literal: flipping selected_ci_runner_target
// to WholeMachine makes it false and forces a deliberate edit here, which is the point.
test fn the_selected_target_budget_equals_the_slot_ceiling_under_the_current_routing_holds() -> Bool {
  byte_size_count(b: ci_runner_target_ram_speed_budget(target: selected_ci_runner_target()))
    == byte_size_count(b: gunbc_ci_runner_slot_ram_speed_ceiling())
}

// (b) A DEMAND THAT FITS THE HOST AND DOES NOT FIT THE SLOT. THE DISCRIMINATOR FOR WHY (a) NAMES THE
// SLOT. Measured srv2 usable RAM is 134314512384 bytes (gunbc.host.host_memory_observation's own read,
// cited not restated); a 30 GiB demand is well inside it and well outside the slot, so a model that
// compared against host RAM would wave this through and the slot would OOM it. Both arms are asserted:
// the vacuous comparison passes, the load-bearing one refuses.
fn srv2_usable_ram_bytes() -> Int {
  match gunbc_ci_srv2_memtotal_measured {
    HostUsableRamMeasured { bytes: b, provenance: _ } => byte_size_count(b: b)
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => byte_size_count(b: b)
    HostUsableRamUnmeasured { reason: _ } => 0
  }
}

test fn a_demand_inside_the_measured_host_and_outside_the_slot_is_refused_by_the_slot_holds() -> Bool {
  let row = InstrumentDispatchMemoryDemand { label: v2_native_census_label(), demand: byte_size(32212254720) }
  (32212254720 < srv2_usable_ram_bytes())
    && !instrument_dispatch_memory_demands_fit(demands: [row], budget: gunbc_ci_runner_slot_ram_speed_ceiling())
}

// THE ENVELOPE IS OBSERVED BEFORE IT IS ENFORCED. Parallel dispatch makes the memory envelope
// load-bearing in a new way: with the fleet's declared slot shape (memory_swap_max = 0) an overrun is
// an OOM refusal, but a drifted drop-in that permits swap turns the same overrun into memory.high
// throttling inside a run that still reports green -- the exact class this charter exists to make loud.
// The guard therefore OBSERVES the job's own memory.swap.max and prints it with the bounds it already
// prints, so the refusal leg can be armed against what the fleet actually runs rather than against the
// declared value. The row refuses a guard that never looks at the file at all.
test fn the_memory_guard_observes_and_prints_the_swap_bound_holds() -> Bool {
  let t = generated_text()
  contains(t, "/memory.swap.max'") && contains(t, "memory.swap.max=")
}

// THE RELAXATION IS CARRIED IN A ROW, NOT IN PROSE. The per-dispatch key is an operator ruling
// (gunbc.design_ruling instrument_measurement_queues_run_in_parallel), whose provenance carries the
// operator's isolation ruling verbatim: the global group never isolated jobs, so no upper edge on
// concurrent instrument occupancy was lost and none is owed -- the SLOT is the isolation authority
// (gunbc.runner.runner_slot_desired + gunbc.host.memory_envelope). This row refuses if the ruling is
// deleted or softened, which is what keeps the relaxation auditable rather than narrated in the
// instrument's own comment. There is deliberately NO assertion here that a rung drop exists for an
// "upper edge": the operator rejected that premise on 2026-10-21, and a row asserting the old drop
// would pin a claim the tree no longer makes. The fleet failure that IS real -- the live unit memory
// shape drifting from the declared slot shape -- is asserted in its own ledger class,
// gunbc.recurring_failure_mode the_live_runner_unit_memory_shape_drifts_from_the_declared_slot.
test fn the_relaxation_is_authorized_by_a_row_and_its_cost_is_declared_holds() -> Bool {
  let ruling_id = decl_ref(module_path: "gunbc.design_ruling", decl_name: "instrument_measurement_queues_run_in_parallel")
  let ruling_rows = filter(design_rulings(), r => declaration_ref_eq(a: r.reference, b: ruling_id))
  (length(xs: ruling_rows) == 1)
    // The provenance must carry the isolation authority BY SYMBOL, not merely gesture at it: a ruling
    // that authorized the relaxation while hiding what actually protects the pool would leave this
    // PR's central claim in prose. Checked by token, not by equality against a copy of the text -- a
    // copy would still pass if the wording drifted, and the tokens are what a reader follows.
    && (length(xs: filter(ruling_rows, r => string_contains(s: r.provenance, pattern: "gunbc.runner.runner_slot_desired"))) == 1)
    && (length(xs: filter(ruling_rows, r => string_contains(s: r.provenance, pattern: "gunbc.host.memory_envelope"))) == 1)
}

// THE DROPPED DROP STAYS DROPPED. If a rung drop for an instrument-dispatch "upper edge" ever comes
// back, it re-pins the premise the operator rejected (that the global group provided a guarantee),
// so it must be a deliberate, argued re-filing -- not a paste. This row refuses silently while the
// tree is clean and refuses LOUDLY the moment such a drop is restored.
test fn no_upper_edge_rung_drop_is_restored_holds() -> Bool {
  let identities = map(standing_rung_drops(), d => d.identity)
  length(xs: filter(identities, i => i == "instrument_dispatch_upper_edge_unmeasured")) == 0
}

// THE FAST PATH PROVES WHO PUBLISHED THE ARTIFACT (side-chat Q3 blocker at 3c78dc9fa49, 2026-10-25).
// The repo-wide artifacts endpoint filters by NAME only, so a different workflow's same-named
// artifact would otherwise reach the reader's staging dir -- fail-open provenance. The emitted
// transport must therefore prove the producing run's identity per candidate before download
// (runs/<id> TOP-LEVEL path == '.github/workflows/' + this workflow file -- the recorded response
// shape: the single-run endpoint returns workflow: null; the earlier probe read workflow.path from
// an invented fixture shape and rejected every real candidate, fleet defect 2026-10-26; cached,
// errors closed), exactly what the fallback path gets structurally by enumerating only this
// workflow's runs. A transport that drops the proof REDs here; the budget for candidate attempts
// is the declared row, never an inline literal.
test fn the_transport_proves_the_producing_workflow_before_download_holds() -> Bool {
  let t = generated_text()
  contains(t, "def run_produced_by_this_workflow(rid):")
    && contains(t, "'.github/workflows/' + WORKFLOW_FILE")
    && contains(t, "if not run_produced_by_this_workflow(rid):")
    && contains(t, "artifact_candidates('base', False)[:16]")
    && (instrument_dispatch_base_probe_budget == 16)
    && (instrument_dispatch_base_probe_budget > 0)
}
