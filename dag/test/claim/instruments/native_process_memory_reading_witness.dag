module test.claim.instruments.native_process_memory_reading_witness

import std.types { Bool, Int, String }
import std.measure { nanosecond }
import std.process { ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable, CliWireUnprintable }
import gunbc.instruments.native_process_memory_reading {
  NativeChildReading, NativeMeasuredWorkload, NativeCensusWorkload, NativeSelfCompileWorkload,
  NativeCensusFrontEnd, native_process_memory_standing, native_child_maxrss,
}

// THE READER'S ARMS AT ITS INTERFACE, over SUPPLIED readings (DESIGN section 3, a witness discriminates
// at one interface). The inhabitance claim pairing these -- that the real host reaps the real native
// child and hands this reader its wait4 rusage -- is the instrument run itself,
// `gunbc test //gunbc/instruments:native-process-memory-census`, whose control run is the executed red.
// The kibibyte figures below are fixture inputs chosen for their order, not measurements.

fn reading(kib: Int, signal: Int) -> NativeChildReading {
  NativeChildReading { peak: native_child_maxrss(raw_value: kib), elapsed: nanosecond(count: 1), exit_code: 0, signal: signal, terminal: "{\"_terminal\":\"complete\"}" }
}

fn exit_code_of(r: CliWireResponse) -> Int {
  match r {
    CliWirePrintable { bytes: _, exit: e } =>
      match e {
        ExitSuccess => 0
        ExitFailure { code: c, reason: _ } => c
      }
    CliWireUnprintable { cause: _ } => -1
  }
}

fn standing(w: NativeMeasuredWorkload, control: NativeChildReading, measured: NativeChildReading) -> Int {
  exit_code_of(r: native_process_memory_standing(workload: w, binary_identity: "b", input_identity: "i", envelope: "e", control: control, measured: measured))
}

fn census() -> NativeMeasuredWorkload {
  NativeCensusWorkload { verb: NativeCensusFrontEnd }
}

test fn ordered_peaks_hold() -> Bool {
  standing(w: census(), control: reading(kib: 10, signal: 0), measured: reading(kib: 20, signal: 0)) == 0
}

test fn a_peak_that_does_not_exceed_the_control_does_not_hold() -> Bool {
  standing(w: census(), control: reading(kib: 20, signal: 0), measured: reading(kib: 20, signal: 0)) == 1
}

test fn a_zero_peak_is_no_observation() -> Bool {
  standing(w: census(), control: reading(kib: 10, signal: 0), measured: reading(kib: 0, signal: 0)) == 2
}

test fn a_killed_workload_is_no_observation() -> Bool {
  standing(w: census(), control: reading(kib: 10, signal: 0), measured: reading(kib: 20, signal: 9)) == 2
}

test fn self_compile_is_a_frontier_with_no_observation() -> Bool {
  standing(w: NativeSelfCompileWorkload, control: reading(kib: 10, signal: 0), measured: reading(kib: 20, signal: 0)) == 2
}
