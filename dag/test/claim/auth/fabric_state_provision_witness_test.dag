module test.claim.auth.fabric_state_provision_witness_test

import std.types { Bool, String }
import gunbc.fabric_storage_state_provision { fabric_state_provision_intent, fabric_state_provision_request, FabricStateProvisionRequested, FabricStateProvisionUnrequestable, fabric_state_provision_token_variable }
import gunbc.auth.approved_secret_grants { secret_grants_intent, secret_grant_token_variable }
import gunbc.auth.fleet_secret_accessor_roster { fabric_state_key_accessor_row, fleet_accessor_grant }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.auth.approval_gate { approval_gate_from_poll, GateRefused, GateAdmitted }
import gunbc.auth.approval_request_client { PollApproved }

// THE MATERIAL APPROVAL AND THE ACCESSOR-POLICY APPROVAL ARE DIFFERENT INTENTS, and each request
// digests only its intent, so a decision recorded for one cannot match the other's revision. Both
// claims below read the intents (no interpreted SHA-256); the digest-and-gate real path is the one
// inhabitance claim at the end of this module.
test fn material_approval_cannot_authorize_accessor_policy() -> Bool  {
  match secret_grants_intent(grants: [fleet_accessor_grant(row: fabric_state_key_accessor_row)], member: "serviceAccount:fixture@example.invalid", attempt: "fixture-run-1") {
    Absent => false
    Present { value: policy } =>
      fabric_state_provision_intent(attempt: "fixture-run-1") != policy
        && fabric_state_provision_token_variable != secret_grant_token_variable
  }
}

test fn material_approval_is_bound_to_its_run_attempt() -> Bool  {
  fabric_state_provision_intent(attempt: "fixture-run-1") != fabric_state_provision_intent(attempt: "fixture-run-2")
}

// THE ONE INHABITANCE CLAIM OF THE REAL MATERIAL REQUEST (DESIGN §3 pairing obligation): it
// digests the real intent once, the gate admits exactly that revision, and a decision recorded
// against any other revision refuses. Typed admission row: v2.workflow.floor_cost_debt_admission
// approval_intent_digest_typed_admissions.
test fn the_real_material_request_admits_only_its_own_revision() -> Bool  {
  match fabric_state_provision_request(attempt: "fixture-run-1") {
    FabricStateProvisionUnrequestable { reason: _ } => false
    FabricStateProvisionRequested { request: material } => {
      let own = PollApproved { revision: request_revision_of(request: material), decided_by: "fixture-operator", decided_at: "2026-09-28T12:00:00Z", execute_by: "2026-09-28T12:05:00Z" }
      let other = PollApproved { revision: "another-intent", decided_by: "fixture-operator", decided_at: "2026-09-28T12:00:00Z", execute_by: "2026-09-28T12:05:00Z" }
      match approval_gate_from_poll(poll: own, request: material, observed_at: "2026-09-28T12:01:00Z") {
        GateRefused { cause: _ } => false
        GateAdmitted { authorization: _ } => match approval_gate_from_poll(poll: other, request: material, observed_at: "2026-09-28T12:01:00Z") {
          GateRefused { cause: _ } => true
          GateAdmitted { authorization: _ } => false
        }
      }
    }
  }
}
