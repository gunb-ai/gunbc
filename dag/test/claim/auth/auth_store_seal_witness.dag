// ── login transaction store ────────────────────────────────────────────────────────────────────

fn login_forged_literal_source() -> String {
  probe(name: "probe_login_store_literal", body: "fn f(s: LoginTransactionStore) -> LoginTransactionStore {\n  LoginTransactionStore { instance: s.instance, read_record: s.read_record, record_presence: s.record_presence, write_record: s.write_record, delete_record: s.delete_record, consume: s.consume, stage_token_form: s.stage_token_form, remove_token_form: s.remove_token_form }\n}\n")
}

fn login_forged_cast_source() -> String {
  probe(name: "probe_login_store_cast", body: "fn f(r: NonEmptyStr) -> LoginTransactionStore {\n  r as LoginTransactionStore\n}\n")
}

fn login_literal_path_source() -> String {
  probe(name: "probe_login_store_literal_path", body: "fn f(s: LoginTransactionStore) -> LoginTransactionStore {\n  LoginTransactionStore { instance: \"srv1-lab\", read_record: s.read_record, record_presence: s.record_presence, write_record: fn(key, content) { filesystem_write_outcome(path: \"/tmp/forged-auth-login-transactions/x.json\", success: Filesystem.WriteOwnerOnly(path: \"/tmp/forged-auth-login-transactions/x.json\", content: content).success, error: \"\") }, delete_record: s.delete_record, consume: s.consume, stage_token_form: s.stage_token_form, remove_token_form: s.remove_token_form }\n}\n")
}

fn login_path_route_source() -> String {
  probe(name: "probe_login_store_path_route", body: "fn f(t: OidcLoginTransaction) -> LoginTransactionStoreSave {\n  login_transaction_store_save(layout: LoginTransactionStoreLayout { root: \"/tmp/forged-auth-login-transactions\" as FilePath }, transaction: t)\n}\n")
}

fn login_foreign_store_source() -> String {
  probe(name: "probe_login_store_foreign", body: "fn f(s: SessionStore, t: OidcLoginTransaction) -> LoginTransactionStoreSave {\n  login_transaction_store_save(store: s, transaction: t)\n}\n")
}

fn login_root_out_source() -> String {
  probe(name: "probe_login_store_root_out", body: "fn f(s: LoginTransactionStore) -> FilePath {\n  s.root\n}\n")
}

fn login_lawful_source() -> String {
  probe(name: "probe_login_store_lawful", body: "fn f(i: HostDashboardInstance, t: OidcLoginTransaction) -> LoginTransactionStoreSave {\n  match login_transaction_store(instance: i) {\n    LoginTransactionStoreReady { store } => login_transaction_store_save(store: store, transaction: t)\n    LoginTransactionStoreUnready { detail } => LoginTransactionSaveRefused { step: \"store\", reason: detail }\n  }\n}\n")
}

