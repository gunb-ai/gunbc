// ── the two JWKS caches and the broker's host-singleton stores ─────────────────────────────────
// Per record: a forged cast, and a literal of the record over a path the probe chose (the store "minted" from a
// literal path), each exactly one seal violation; plus the two caches each refused where the other is required.

fn broker_probe(name: String, body: String) -> String {
  join([
    "module ", name, "\n",
    "import std.types { String, NonEmptyStr, Int }\n",
    "import gunbc.host_state_root { HostStateTree }\n",
    "import extdeps.auth.oidc { OidcIdTokenSignature, OidcIdTokenSignatureRefused }\n",
    "import extdeps.auth.jwt { JwtCompactSerialization }\n",
    "import gunbc.auth.oidc_id_token_verification { InstanceJwksCache, JwksCacheRoot, broker_jwks_cache_root, jwks_cache_write }\n",
    "import extdeps.filesystem.filesystem_io { FilesystemWriteOutcome }\n",
    "import gunbc.durable_cas_file_store { file_slot_store }\n",
    "import gunbc.roadmap.roadmap_auth_routes { auth_token_signature }\n",
    "import gunbc.auth.approval_device_redemption { BrokerJwksCache, BrokerJwksCacheReady, BrokerJwksCacheUnready, broker_jwks_cache, ApprovalDeviceStore }\n",
    "import gunbc.auth.approval_device_routes { broker_token_signature_over }\n",
    "import gunbc.auth.approval_assertion_counter { AssertionCounterStore }\n",
    body,
  ], "")
}

fn broker_baseline_source() -> String {
  broker_probe(name: "probe_broker_store_baseline", body: "fn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n")
}

fn cast_source(name: String, subject: String) -> String {
  broker_probe(name: name, body: join(["fn f(r: NonEmptyStr) -> ", subject, " {\n  r as ", subject, "\n}\n"], ""))
}

test fn a_forged_instance_jwks_cache_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: cast_source(name: "probe_instance_jwks_cast", subject: "InstanceJwksCache"), subject: "InstanceJwksCache"), holds: fn(n) { n == 1 }))
}

test fn a_forged_broker_jwks_cache_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: cast_source(name: "probe_broker_jwks_cast", subject: "BrokerJwksCache"), subject: "BrokerJwksCache"), holds: fn(n) { n == 1 }))
}

test fn a_forged_approval_device_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: cast_source(name: "probe_device_store_cast", subject: "ApprovalDeviceStore"), subject: "ApprovalDeviceStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_assertion_counter_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: cast_source(name: "probe_counter_store_cast", subject: "AssertionCounterStore"), subject: "AssertionCounterStore"), holds: fn(n) { n == 1 }))
}

fn literal_source(name: String, subject: String, literal: String) -> String {
  broker_probe(name: name, body: join(["fn f() -> ", subject, " {\n  ", literal, "\n}\n"], ""))
}

test fn an_instance_jwks_cache_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_source(name: "probe_instance_jwks_literal", subject: "InstanceJwksCache", literal: "InstanceJwksCache { instance: \"srv1-lab\", cache: JwksCacheRoot { root: \"/tmp/forged-auth-jwks\" } }"), subject: "InstanceJwksCache"), holds: fn(n) { n == 1 }))
}

test fn a_broker_jwks_cache_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_source(name: "probe_broker_jwks_literal", subject: "BrokerJwksCache", literal: "BrokerJwksCache { cache: JwksCacheRoot { root: \"/tmp/forged-approval-jwks\" } }"), subject: "BrokerJwksCache"), holds: fn(n) { n == 1 }))
}

test fn an_approval_device_store_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_source(name: "probe_device_store_literal", subject: "ApprovalDeviceStore", literal: "ApprovalDeviceStore { slots: file_slot_store(root: \"/tmp/forged-approval-devices\") }"), subject: "ApprovalDeviceStore"), holds: fn(n) { n == 1 }))
}

test fn an_assertion_counter_store_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_source(name: "probe_counter_store_literal", subject: "AssertionCounterStore", literal: "AssertionCounterStore { slots: file_slot_store(root: \"/tmp/forged-assertion-counters\") }"), subject: "AssertionCounterStore"), holds: fn(n) { n == 1 }))
}

// THE JWKS CARRIER ITSELF IS SEALED (ruling of jolly-hawk-60, 2026-10-25): a foreign module cannot spell or cast a
// JwksCacheRoot over a directory it chose, so no module reaches the JWKS operations (jwks_cache_write here) except
// over a root one of the two constructors derived. The lawful control reaches the same write through
// broker_jwks_cache_root from a supplied tree and is admitted with no violation.
test fn a_jwks_cache_root_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: broker_probe(name: "probe_jwks_root_literal", body: "fn f() -> FilesystemWriteOutcome {\n  jwks_cache_write(cache: JwksCacheRoot { root: \"/tmp/forged-jwks\" }, content: \"{}\")\n}\n"), subject: "JwksCacheRoot"), holds: fn(n) { n == 1 }))
}

test fn a_forged_jwks_cache_root_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: cast_source(name: "probe_jwks_root_cast", subject: "JwksCacheRoot"), subject: "JwksCacheRoot"), holds: fn(n) { n == 1 }))
}

test fn the_derived_jwks_cache_root_is_admitted() -> ProcessExit {
  let lawful = broker_probe(name: "probe_jwks_root_lawful", body: "fn f(tree: HostStateTree) -> FilesystemWriteOutcome {\n  jwks_cache_write(cache: broker_jwks_cache_root(tree: tree), content: \"{}\")\n}\n")
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful, safe: broker_baseline_source(), holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful, subject: "JwksCacheRoot"), holds: fn(n) { n == 0 }),
  ])
}

test fn an_instance_jwks_cache_is_not_the_brokers() -> ProcessExit {
  census_exit(blocking_delta(hostile: broker_probe(name: "probe_instance_jwks_as_broker", body: "fn f(c: InstanceJwksCache, t: JwtCompactSerialization) -> OidcIdTokenSignature {\n  broker_token_signature_over(cache: c, id_token: t, epoch: 0, verify_id: \"v\")\n}\n"), safe: broker_baseline_source(), holds: fn(n) { n >= 1 }))
}

test fn a_broker_jwks_cache_is_not_an_instances() -> ProcessExit {
  census_exit(blocking_delta(hostile: broker_probe(name: "probe_broker_jwks_as_instance", body: "fn f(c: BrokerJwksCache, t: NonEmptyStr) -> OidcIdTokenSignature {\n  auth_token_signature(cache: c, id_token: t, epoch: 0, verify_id: \"v\")\n}\n"), safe: broker_baseline_source(), holds: fn(n) { n >= 1 }))
}

test fn the_lawful_broker_jwks_cache_mint_is_admitted() -> ProcessExit {
  let lawful = broker_probe(name: "probe_broker_jwks_lawful", body: "fn f(tree: HostStateTree, t: JwtCompactSerialization) -> OidcIdTokenSignature {\n  match broker_jwks_cache(tree: tree) {\n    BrokerJwksCacheReady { cache } => broker_token_signature_over(cache: cache, id_token: t, epoch: 0, verify_id: \"v\")\n    BrokerJwksCacheUnready { detail } => OidcIdTokenSignatureRefused { reason: detail }\n  }\n}\n")
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful, safe: broker_baseline_source(), holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful, subject: "BrokerJwksCache"), holds: fn(n) { n == 0 }),
  ])
}

// ── no authored hold outcome buys a consume ────────────────────────────────────────────────────
// The fold login_transaction_consume_election_of (FileHoldAcquireOutcome -> LoginTransactionConsumeElection) is
// deleted: its match lives inside login_transaction_store_consume beside its own file_hold_acquire, so a foreign
// module holding an authored FileHoldAcquired has no export that turns it into LoginTransactionConsumeWon.
fn consume_laundering_source() -> String {
  join([
    "module probe_login_consume_laundering\n",
    "import std.types { String, NonEmptyStr }\n",
    "import gunbc.durable_exclusive_hold_file_store { FileHoldAcquireOutcome, FileHoldAcquired }\n",
    "import gunbc.auth.login_transaction_store_root { LoginTransactionConsumeElection, login_transaction_consume_election_of }\n",
    "fn f(o: FileHoldAcquireOutcome) -> LoginTransactionConsumeElection {\n  login_transaction_consume_election_of(outcome: o)\n}\n",
  ], "")
}

fn consume_lawful_source() -> String {
  probe(name: "probe_login_consume_lawful", body: "import gunbc.auth.login_transaction_store_root { LoginTransactionConsumeElection, LoginTransactionConsumeRefused, login_transaction_store_consume }\nimport gunbc.auth.auth_store_key { AuthStoreKey }\nfn f(i: HostDashboardInstance, k: AuthStoreKey) -> LoginTransactionConsumeElection {\n  match login_transaction_store(instance: i) {\n    LoginTransactionStoreReady { store } => login_transaction_store_consume(store: store, key: k)\n    LoginTransactionStoreUnready { detail } => LoginTransactionConsumeRefused { detail: detail }\n  }\n}\n")
}

test fn no_authored_hold_outcome_can_win_a_login_transaction_consume() -> ProcessExit {
  census_exit(deleted_callable_is_gone(source: consume_laundering_source(), deleted_callable: "login_transaction_consume_election_of"))
}

test fn the_lawful_login_transaction_consume_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: consume_lawful_source(), safe: baseline_source(), holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: consume_lawful_source(), subject: "LoginTransactionStore"), holds: fn(n) { n == 0 }),
  ])
}
