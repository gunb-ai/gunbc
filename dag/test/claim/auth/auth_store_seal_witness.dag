}

fn profile_path_route_source() -> String {
  probe(name: "probe_profile_store_path_route", body: "fn f() -> ProfileStoreReadAll {\n  profile_store_read_all(layout: ProfileStoreLayout { root: \"/tmp/forged-auth-profiles\" as FilePath })\n}\n")
}

