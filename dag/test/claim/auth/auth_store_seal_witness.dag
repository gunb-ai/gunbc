module test.claim.auth.auth_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// AN AUTH RECORD STORE IS MINTED FROM ITS DECLARATION AND CANNOT BE SPELLED OR MINTED FROM A PATH.
// gunbc.auth.session_store_root SessionStore, gunbc.auth.profile_store_root ProfileStore and
// gunbc.auth.login_transaction_store_root LoginTransactionStore are sole_constructor; each business module takes
// its own type, which only its root module's mint builds, from the instance alone. Each RED hands the compiler a
// module outside the defining files and asserts the refusal on the real acceptance path:
//   - a forged literal (fields copied from a lawful store), a forged cast, and a store whose operations close over
//     a LITERAL PATH: each EXACTLY ONE SoleConstructorViolation on its subject;
//   - the deleted path-taking route (the old layout record handed to the business function), another store's type
//     where this one is required, and a root read out of the store: each at least one blocking diagnostic beyond a
//     baseline importing the same closure (gunbc.compile_diagnostic_census).
// The GREEN per store is the lawful route, the mint into a business function: no blocking diagnostic beyond the
// baseline and no seal violation. The discriminating control is the same probes over a tree with sole_constructor
// stripped from the three records (the receipts in the change): the literal, cast and literal-path REDs go to 0.
// NOT witnessed, because it is not expressible: a store minted for instance A refused where B is required (one
// type per store, not per instance). NOT closed here: any module can still build its own file operations over a
// literal path, because Filesystem.* is ambient (gunbc.recurring_failure_mode
// a_slot_store_is_built_over_a_literal_path_by_any_module); that is not one of these stores.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

// A deleted callable is attributed by name: exactly one blocking MissingExport keyed on it, never a delta.
fn deleted_callable_is_gone(source: String, deleted_callable: String) -> CensusVerdict {
  census_verdict(census: blocking_subject_census(source: source, wanted_class: "MissingExport", wanted_subject: deleted_callable), holds: fn(n) { n == 1 })
}

// Every probe imports the same closure, so a delta counts only what its body adds.
fn probe(name: String, body: String) -> String {
  join([
    "module ", name, "\n",
    "import std.types { String, NonEmptyStr, FilePath, Timestamp }\n",
    "import extdeps.filesystem.filesystem_io { Filesystem }\n",
    "import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\n",
    "import gunbc.principal_projection { PrincipalRef }\n",
    "import gunbc.auth.session { AuthenticatedSession, SessionCookieStanding, SessionCookieUnread }\n",
    "import extdeps.auth.oidc { OidcLoginTransaction }\n",
    "import gunbc.auth.session_store_root { SessionStore, SessionStoreReady, SessionStoreUnready, session_store }\n",
    "import gunbc.auth.session_store { SessionStoreLookup, SessionStoreUnread, session_store_lookup }\n",
    "import gunbc.auth.profile_store_root { ProfileStore, ProfileStoreReady, ProfileStoreUnready, profile_store }\n",
    "import gunbc.auth.profile_projection { ProfileStoreReadAll, ProfileStoreUnread, profile_store_read_all }\n",
    "import gunbc.auth.login_transaction_store_root { LoginTransactionStore, LoginTransactionStoreReady, LoginTransactionStoreUnready, login_transaction_store }\n",
    "import gunbc.auth.login_transaction_store { LoginTransactionStoreSave, LoginTransactionSaveRefused, login_transaction_store_save }\n",
    body,
  ], "")
}

fn baseline_source() -> String {
  probe(name: "probe_auth_store_baseline", body: "fn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n")
}

// ── session store ──────────────────────────────────────────────────────────────────────────────

fn session_forged_literal_source() -> String {
  probe(name: "probe_session_store_literal", body: "fn f(s: SessionStore) -> SessionStore {\n  SessionStore { instance: s.instance, root: s.root }\n}\n")
}

fn session_forged_cast_source() -> String {
  probe(name: "probe_session_store_cast", body: "fn f(r: NonEmptyStr) -> SessionStore {\n  r as SessionStore\n}\n")
}

fn session_literal_path_source() -> String {
  probe(name: "probe_session_store_literal_path", body: "fn f() -> SessionStore {\n  SessionStore { instance: \"srv1-lab\", root: \"/tmp/forged-auth-sessions\" }\n}\n")
}

fn session_path_route_source() -> String {
  probe(name: "probe_session_store_path_route", body: "import gunbc.auth.session_store { session_store_layout_for_instance }\nfn f(i: HostDashboardInstance, id: NonEmptyStr) -> SessionStoreLookup {\n  session_store_lookup(layout: session_store_layout_for_instance(instance: i), session_id: id)\n}\n")
}

fn session_foreign_store_source() -> String {
  probe(name: "probe_session_store_foreign", body: "fn f(p: ProfileStore, id: NonEmptyStr) -> SessionStoreLookup {\n  session_store_lookup(store: p, session_id: id)\n}\n")
}

fn session_lawful_source() -> String {
  probe(name: "probe_session_store_lawful", body: "fn f(i: HostDashboardInstance, id: NonEmptyStr) -> SessionStoreLookup {\n  match session_store(instance: i) {\n    SessionStoreReady { store } => session_store_lookup(store: store, session_id: id)\n    SessionStoreUnready { detail } => SessionStoreUnread { session_id: id, detail: detail }\n  }\n}\n")
}

test fn a_forged_session_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_literal_source(), subject: "SessionStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_session_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_cast_source(), subject: "SessionStore"), holds: fn(n) { n == 1 }))
}

test fn a_session_store_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_literal_path_source(), subject: "SessionStore"), holds: fn(n) { n == 1 }))
}

test fn no_path_taking_session_store_route_resolves() -> ProcessExit {
  census_exit(deleted_callable_is_gone(source: session_path_route_source(), deleted_callable: "session_store_layout_for_instance"))
}

test fn a_profile_store_is_not_a_session_store() -> ProcessExit {
  census_exit(blocking_delta(hostile: session_foreign_store_source(), safe: baseline_source(), holds: fn(n) { n >= 1 }))
}

test fn the_lawful_session_store_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: session_lawful_source(), safe: baseline_source(), holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: session_lawful_source(), subject: "SessionStore"), holds: fn(n) { n == 0 }),
  ])
}

