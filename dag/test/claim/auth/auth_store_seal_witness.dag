  probe(name: "probe_profile_store_foreign", body: "fn f(s: SessionStore) -> ProfileStoreReadAll {\n  profile_store_read_all(store: s)\n}\n")
}

fn profile_root_out_source() -> String {
  probe(name: "probe_profile_store_root_out", body: "fn f(s: ProfileStore) -> FilePath {\n  s.root\n}\n")
}

fn profile_lawful_source() -> String {
  probe(name: "probe_profile_store_lawful", body: "fn f(i: HostDashboardInstance) -> ProfileStoreReadAll {\n  match profile_store(instance: i) {\n    ProfileStoreReady { store } => profile_store_read_all(store: store)\n    ProfileStoreUnready { detail } => ProfileStoreUnread { step: \"list\", reason: detail }\n  }\n}\n")
}

test fn a_forged_profile_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: profile_forged_literal_source(), subject: "ProfileStore"), holds: fn(n) { n == 1 }))
