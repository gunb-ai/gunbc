module test.claim.auth.auth_store_key_witness

import std.types { Bool, FilePath, NonEmptyStr }
import gunbc.auth.auth_store_key { auth_store_key_of }

// REQUEST-SUPPLIED IDENTIFIERS NEVER NAME A FILE OUTSIDE THEIR STORE. The callback's `state` query
// parameter and the Cookie header's session id reach the session and login transaction stores; every
// one of the traversal shapes below is refused by gunbc.auth.auth_store_key auth_store_key_of. RED if
// any traversal shape is admitted as a key. That the stores answer such an id without consulting
// their directory is witnessed over the minted stores, in test.claim.auth.auth_record_store_wet_witness
// (a store is minted only from a listed directory, so the claim needs one).
data traversal_shapes: List<String> = ["../x", "..", "a/b", "/etc/passwd", "a\u{0}b", "a.b", ".", "a b", "a%2Fb"]

test fn no_traversal_shape_is_a_store_key() -> Bool {
  auth_store_key_of(raw: "") == none
    && all(traversal_shapes, raw => match auth_store_key_of(raw: raw) {
      Absent => true
      Present { value: _ } => false
    })
}

test fn a_minted_base64url_identifier_is_a_store_key() -> Bool {
  match auth_store_key_of(raw: "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk") {
    Present { value: k } => (k.value as String) == "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    Absent => false
  }
}
