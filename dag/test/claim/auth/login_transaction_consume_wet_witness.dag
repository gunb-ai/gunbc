module test.claim.auth.login_transaction_consume_wet_witness

import std.types { String, Bool, FilePath, NonEmptyStr }
import extdeps.auth.oidc { OidcLoginTransaction, OidcPkceCodeVerifier, RelativeReturnPath }
import extdeps.shell
import gunbc.host.host_layout { srv1_host_layout }
import gunbc.deployment_risk { deployment_id }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardObserveOnly, DashboardLocalProvision }
import gunbc.auth.auth_store_key { auth_store_key_of }
import gunbc.auth.login_transaction_store_root {
  LoginTransactionStore, LoginTransactionStoreReady, LoginTransactionStoreUnready, login_transaction_store, login_transaction_store_slots_path,
  LoginTransactionConsumeWon, LoginTransactionConsumeAlreadyWon, LoginTransactionConsumeRefused,
}
import gunbc.auth.login_transaction_store { login_transaction_store_save, login_transaction_store_delete, login_transaction_store_lookup, LoginTransactionSaved, LoginTransactionSaveRefused, LoginTransactionDeleted, LoginTransactionNothingToDelete, LoginTransactionDeleteRefused, LoginTransactionStoreFound, LoginTransactionStoreUnknown, LoginTransactionStoreUnread, LoginTransactionStoreEntryMalformed }

// THE ATOMIC CONSUME OVER REAL FILES. Exclusivity is a property of the hold's create-new CAS write
// (gunbc.durable_exclusive_hold_file_store), so these claims run on a throwaway temp directory in the required
// floor's local-repo wet lane (v2.workflow.local_repo_wet_terminal local_repo_wet_schedule), never against a
// mock. The store is the production mint (login_transaction_store) over an instance whose root is the test's,
// its directory created the way the instance directory row would create it.
fn browser_transaction() -> OidcLoginTransaction {
  OidcLoginTransaction { state: "state-A", nonce: "nonce-A", created_at: "2026-09-28T00:00:00Z", expires_at: "2026-09-28T00:10:00Z",
    verifier: OidcPkceCodeVerifier { verifier: "verifier-from-jar-A" }, return_path: RelativeReturnPath { path: "/" } }
}

fn consume_instance(directory: String) -> HostDashboardInstance {
  isolated_dashboard_instance(deployment: deployment_id(name: "login-consume-fixture" as NonEmptyStr), instance_id: "login-consume-fixture", layout: srv1_host_layout(), root: directory as FilePath,
    serve_function: "unused", listen_port: 18745, source_anchor_ref: "refs/heads/fixture", actuation: DashboardObserveOnly, provision_transport: DashboardLocalProvision)
}

fn transactions_at(directory: String) -> LoginTransactionStore? {
  let instance = consume_instance(directory: directory)
  let made = shell.Mkdir.Parents(path: login_transaction_store_slots_path(instance: instance))
  if !made.success { none } else {
    match login_transaction_store(instance: instance) {
      LoginTransactionStoreReady { store: s } => Present { value: s }
      LoginTransactionStoreUnready { detail: _ } => none
    }
  }
}

test fn transaction_consume_has_one_winner_over_real_files() -> Bool {
  let directory = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc-login-consume.XXXXXX").path
  if directory == "" { false } else {
    match transactions_at(directory: directory) {
      Absent => false
      Present { value: store } => {
        let transaction = browser_transaction()
        match login_transaction_store_save(store: store, transaction: transaction) {
          LoginTransactionSaved { state: _ } => match login_transaction_store_delete(store: store, state: transaction.state) {
            LoginTransactionDeleted { state: _ } => match login_transaction_store_delete(store: store, state: transaction.state) {
              LoginTransactionDeleted { state: _ } => false
              LoginTransactionNothingToDelete { state: _ } => true
              LoginTransactionDeleteRefused { state: _, detail: _ } => false
            }
            LoginTransactionNothingToDelete { state: _ } => false
            LoginTransactionDeleteRefused { state: _, detail: _ } => false
          }
          LoginTransactionSaveRefused { step: _, reason: _ } => false
        }
      }
    }
  }
}

// THE CONCURRENT LOSER, by supplied state: a second consumer that still lists the transaction file finds the
// winner's consume hold already taken. The hold is won here through the store's own consume, rather than
// raced, so the arm is reached deterministically; the same consume then answers AlreadyWon to anyone else.
// RED if the consume stops being exclusive (the loser would then delete and report Deleted); the transaction
// file must survive the loser.
test fn a_consumer_that_loses_the_create_new_claim_refuses_and_deletes_nothing() -> Bool {
  let directory = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc-login-consume.XXXXXX").path
  if directory == "" { false } else {
    match transactions_at(directory: directory) {
      Absent => false
      Present { value: store } => {
        let transaction = browser_transaction()
        match login_transaction_store_save(store: store, transaction: transaction) {
          LoginTransactionSaveRefused { step: _, reason: _ } => false
          LoginTransactionSaved { state: _ } =>
            match auth_store_key_of(raw: transaction.state as String) {
              Absent => false
              Present { value: key } => {
                let consume = store.consume
                let won = match consume(key) { LoginTransactionConsumeWon => true  LoginTransactionConsumeAlreadyWon => false  LoginTransactionConsumeRefused { detail: _ } => false }
                let again = match consume(key) { LoginTransactionConsumeAlreadyWon => true  LoginTransactionConsumeWon => false  LoginTransactionConsumeRefused { detail: _ } => false }
                won && again && match login_transaction_store_delete(store: store, state: transaction.state) {
                  LoginTransactionDeleteRefused { state: _, detail: _ } =>
                    match login_transaction_store_lookup(store: store, state: transaction.state) {
                      LoginTransactionStoreFound { transaction: _ } => true
                      LoginTransactionStoreUnknown { state: _ } => false
                      LoginTransactionStoreUnread { state: _, detail: _ } => false
                      LoginTransactionStoreEntryMalformed { state: _, detail: _ } => false
                    }
                  LoginTransactionDeleted { state: _ } => false
                  LoginTransactionNothingToDelete { state: _ } => false
                }
              }
            }
        }
      }
    }
  }
}
