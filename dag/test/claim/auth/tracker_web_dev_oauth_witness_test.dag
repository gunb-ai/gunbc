module test.claim.auth.tracker_web_dev_oauth_witness_test

import std.types { Bool, String, CommitSha }
import v2.std.algebra { any }
import std.goal_assessment { GoalSatisfied, GoalAssessmentRefused }
import std.keyed_roster { KeyedRosterBuilt }
import std.roster_frontier { PathSubject, frontier_rows_keyed_roster_build }
import extdeps.google.workspace { RegisteredWebClient }
import gunbc.auth.google_workspace_admin_convergence {
  workspace_identity_admin_obligations, BasicSignInOnly,
}
import gunbc.auth.google_workspace_login {
  GoogleLoginEnvironmentTest, GoogleLoginEnvironmentProd, TrackerWebOauthClientBound, TrackerWebOauthClientUnbound,
}
import gunbc.auth.oidc_deployment_config {
  oidc_secret_from_file_standing, OidcSecretFileMissing, OidcConfigFieldStringUnavailable, oidc_config_env_var,
}
import gunbc.auth.tracker_web_oauth_client {
  tracker_web_test_oauth_client_binding, tracker_web_test_workspace_identity_binding,
  tracker_web_oidc_serve_placement, tracker_web_oidc_serve_standing,
  TrackerWebOidcServeReady, TrackerWebOidcPlacementUnassigned, TrackerWebOidcPlacementUnbound,
  TrackerWebOidcServeConfigured, TrackerWebOidcConsoleReadbackUnsatisfied,
  tracker_web_oidc_config_document,
  tracker_web_test_lab_redirect_uri, tracker_web_test_oauth_client_secret_host_path,
  tracker_web_test_oidc_config_host_path,
  tracker_web_oauth_standing_for_environment,
  tracker_web_instance_environment, tracker_web_test_target_owned_domain,
  tracker_web_test_oauth_client_secret_ref,
  tracker_web_test_auth_platform_client_assessment,
  tracker_web_test_console_readback_observed_at_epoch,
  tracker_web_test_console_readback_valid_until_epoch,
  tracker_web_test_console_observed_redirect_uris,
  tracker_web_unassigned_redirects,
  tracker_web_test_srv2_redirect_uri,
  tracker_web_oauth_frontier_rows,
}
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import gunbc.live_deploy.emit {
  live_deploy_serve_unit_file, apply_step_effects, apply_oidc_config_steps_at,
  live_deploy_oidc_environment_directives_at, apply_oidc_config_steps,
}
import gunbc.live_deploy.desired { srv1_lab_desired_deployment, srv1_production_desired_deployment, selected_deployment_spec }
import gunbc.live_deploy.spec { ArtifactStep, Dependency, OidcConfigArtifact }
import test.claim.live_deploy.apply_emission_projection { pipeline_steps_text, apply_empty_host_effects }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_full_install_plan }
import gunbc.live_deploy.release_locus { ReleaseRevisionBinding, RevisionBoundAtEmission }
import gunbc.roadmap_dashboard_instance { srv1_dashboard_lab_id, srv1_dashboard_live_id, srv2_deploy_dashboard_id }
import extdeps.systemd.unit_file { serialize_systemd_unit_file, Environment }
import v2.std.collection { Present, Absent }

fn witness_revision() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" as CommitSha }
}

test fn lab_rendered_oidc_config_names_lab_redirect_and_secret_path() -> Bool {
  match tracker_web_oidc_serve_placement(instance_id: srv1_dashboard_lab_id) {
    TrackerWebOidcServeReady { config: cfg } =>
      let body = tracker_web_oidc_config_document(cfg: cfg)
      string_contains(s: body, pattern: tracker_web_test_lab_redirect_uri as String)
        && string_contains(s: body, pattern: tracker_web_test_oauth_client_secret_host_path as String)
        && string_contains(s: body, pattern: "client_secret_file")
        && !string_contains(s: body, pattern: "\"client_secret\":")
    _ => false
  }
}

test fn production_serve_unit_carries_no_oidc_env() -> Bool {
  match tracker_web_oidc_serve_placement(instance_id: srv1_dashboard_live_id) {
    TrackerWebOidcPlacementUnbound { instance_id: _, reason: _ } => true
    _ => false
  }
    && match tracker_web_instance_environment(instance_id: srv1_dashboard_live_id) {
      Present { value: GoogleLoginEnvironmentProd } => true
      _ => false
    }
    && match tracker_web_oauth_standing_for_environment(environment: GoogleLoginEnvironmentProd) {
      TrackerWebOauthClientUnbound { environment: _, reason: _ } => true
      TrackerWebOauthClientBound { binding: _ } => false
    }
    && !string_contains(
      s: serialize_systemd_unit_file(file: live_deploy_serve_unit_file(
        spec: selected_deployment_spec(row: srv1_production_desired_deployment()),
        revision: witness_revision(),
      )),
      pattern: oidc_config_env_var as String,
    )
}

test fn lab_serve_unit_carries_oidc_env() -> Bool {
  match tracker_web_instance_environment(instance_id: srv1_dashboard_lab_id) {
    Present { value: GoogleLoginEnvironmentTest } => true
    _ => false
  }
    && string_contains(
      s: serialize_systemd_unit_file(file: live_deploy_serve_unit_file(
        spec: selected_deployment_spec(row: srv1_lab_desired_deployment()),
        revision: witness_revision(),
      )),
      pattern: oidc_config_env_var as String,
    )
}

test fn admin_obligation_redirect_uris_equal_the_binding() -> Bool {
  let binding = tracker_web_test_workspace_identity_binding()
  let b = tracker_web_test_oauth_client_binding()
  match workspace_identity_admin_obligations(binding: binding, discovery: BasicSignInOnly).first() {
    Absent => false
    Present { value: ob } =>
      match ob.desired {
        RegisteredWebClient { redirect_uris: uris } =>
          all(uris, x => any(b.redirect_uris, y => x == y)) && all(b.redirect_uris, x => any(uris, y => x == y))
        _ => false
      }
  }
}

test fn missing_client_secret_file_refuses_with_typed_cause() -> Bool {
  match oidc_secret_from_file_standing(standing: OidcSecretFileMissing { path: "/etc/gunbc-oidc/missing" }) {
    OidcConfigFieldStringUnavailable { cause: c } =>
      string_contains(s: c, pattern: "client_secret_file") && string_contains(s: c, pattern: "does not exist")
    _ => false
  }
}

test fn srv2_hand_started_unit_is_unmodeled_and_not_adopted() -> Bool {
  match tracker_web_oidc_serve_placement(instance_id: srv2_deploy_dashboard_id) {
    TrackerWebOidcPlacementUnassigned { instance_id: id } => (id as String) == (srv2_deploy_dashboard_id as String)
    _ => false
  }
    && any(tracker_web_unassigned_redirects(), u =>
      (u.environment == GoogleLoginEnvironmentTest) && ((u.uri as String) == (tracker_web_test_srv2_redirect_uri as String))
    )
    && any(census_closure_frontier_rows(), row => match row.subject {
      PathSubject { path: p } => p == "gunbc-dash-18082.service"
      _ => false
    })
    && match frontier_rows_keyed_roster_build(rows: tracker_web_oauth_frontier_rows) {
      KeyedRosterBuilt { rows: roster } =>
        any(roster, kr => match kr.row_key {
          PathSubject { path: p } => p == "gunbc-dash-18082.service"
          _ => false
        })
      _ => false
    }
}

test fn console_readback_is_independent_and_expires() -> Bool {
  let b = tracker_web_test_oauth_client_binding()
  let observed = tracker_web_test_console_observed_redirect_uris
  (b.environment == GoogleLoginEnvironmentTest)
    && (tracker_web_test_oauth_client_secret_ref.version as String) == "1"
    && all(observed, x => any(b.redirect_uris, y => x == y))
    && all(b.redirect_uris, x => any(observed, y => x == y))
    && match tracker_web_test_auth_platform_client_assessment(now_epoch: tracker_web_test_console_readback_observed_at_epoch) {
      GoalSatisfied { evidence: _ } => true
      _ => false
    }
    && match tracker_web_test_auth_platform_client_assessment(now_epoch: tracker_web_test_console_readback_valid_until_epoch) {
      GoalAssessmentRefused { cause: _ } => true
      _ => false
    }
    && match tracker_web_oidc_serve_standing(instance_id: srv1_dashboard_lab_id, now_epoch: tracker_web_test_console_readback_observed_at_epoch) {
      TrackerWebOidcServeConfigured { config: _ } => true
      _ => false
    }
    && match tracker_web_oidc_serve_standing(instance_id: srv1_dashboard_lab_id, now_epoch: tracker_web_test_console_readback_valid_until_epoch) {
      TrackerWebOidcConsoleReadbackUnsatisfied { instance_id: _, cause: _ } => true
      _ => false
    }
    && any(census_closure_frontier_rows(), row => match row.subject {
      PathSubject { path: p } => p == (tracker_web_test_target_owned_domain as String)
      _ => false
    })
}

test fn lab_apply_identity_route_writes_oidc_config_file() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let plan = deploy_witness_full_install_plan(spec: spec)
  let effects = apply_empty_host_effects(spec: spec)
  match filter(spec.steps, st => match st {
    ArtifactStep { step: art } => match art.kind {
      OidcConfigArtifact => true
      _ => false
    }
    Dependency { step: _ } => false
  }).first() {
    Absent => false
    Present { value: step } =>
      let sh = pipeline_steps_text(steps: apply_step_effects(step: step, effects: effects, spec: spec, plan: plan))
      string_contains(s: sh, pattern: tracker_web_test_oidc_config_host_path as String)
        && string_contains(s: sh, pattern: "0600")
        && string_contains(s: sh, pattern: "gunbc-oidc-config.json")
  }
}

test fn lab_apply_oidc_config_refuses_when_console_readback_expired() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let sh = pipeline_steps_text(steps: apply_oidc_config_steps_at(
    spec: spec,
    now_epoch: tracker_web_test_console_readback_valid_until_epoch,
    should_write: false,
  ))
  string_contains(s: sh, pattern: "__GUNBC_OIDC_READBACK_REFUSED__")
    && string_contains(s: sh, pattern: "exit 1")
    && string_contains(s: sh, pattern: "date +%s")
    && !string_contains(s: sh, pattern: tracker_web_test_oidc_config_host_path as String)
}

test fn lab_unit_env_refuses_when_console_readback_expired() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let dirs = live_deploy_oidc_environment_directives_at(
    spec: spec,
    now_epoch: tracker_web_test_console_readback_valid_until_epoch,
  )
  any(dirs, d => match d {
    Environment { assignment: a } =>
      string_contains(s: a as String, pattern: "__GUNBC_OIDC_READBACK_REFUSED__")
        && !string_contains(s: a as String, pattern: oidc_config_env_var as String)
    _ => false
  })
}

test fn lab_apply_oidc_config_observes_host_clock_against_valid_until() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let sh = pipeline_steps_text(steps: apply_oidc_config_steps(spec: spec))
  string_contains(s: sh, pattern: "date +%s")
    && string_contains(s: sh, pattern: to_string(tracker_web_test_console_readback_valid_until_epoch))
}

test fn production_spec_has_no_oidc_config_artifact() -> Bool {
  !any(selected_deployment_spec(row: srv1_production_desired_deployment()).steps, st => match st {
    ArtifactStep { step: art } => match art.kind {
      OidcConfigArtifact => true
      _ => false
    }
    Dependency { step: _ } => false
  })
}
