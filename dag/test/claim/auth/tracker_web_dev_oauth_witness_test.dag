module test.claim.auth.tracker_web_dev_oauth_witness_test

import std.types { Bool, String, CommitSha }
import v2.std.algebra { any }
import std.goal_assessment { GoalSatisfied }
import std.keyed_roster { KeyedRosterBuilt }
import std.roster_frontier { PathSubject, frontier_rows_keyed_roster_build }
import extdeps.google.workspace { RegisteredWebClient }
import gunbc.auth.google_workspace_admin_convergence {
  workspace_identity_admin_obligations, BasicSignInOnly, workspace_admin_assess,
}
import gunbc.auth.google_workspace_login {
  GoogleLoginEnvironmentTest, GoogleLoginEnvironmentProd, TrackerWebOauthClientBound, TrackerWebOauthClientUnbound,
}
import gunbc.auth.oidc_deployment_config {
  oidc_secret_from_file_standing, OidcSecretFileMissing, OidcConfigFieldStringUnavailable, oidc_config_env_var,
}
import gunbc.auth.tracker_web_oauth_client {
  tracker_web_test_oauth_client_binding, tracker_web_test_workspace_identity_binding,
  tracker_web_oidc_serve_config, tracker_web_oidc_config_document,
  tracker_web_test_lab_redirect_uri, tracker_web_dev_oauth_client_secret_host_path,
  production_has_no_oidc_serve_config, tracker_web_oauth_standing_for_environment,
  tracker_web_instance_environment, tracker_web_test_target_owned_domain,
  tracker_web_dev_oauth_client_secret_ref,
  tracker_web_test_registered_web_client_console_readback,
  tracker_web_test_console_readback_observed_at_epoch,
  tracker_web_test_unassigned_redirect_realizations,
  tracker_web_test_srv2_redirect_uri,
  tracker_web_oauth_frontier_roster,
}
import gunbc.workspace_allocation_policy { workspace_operator_principal }
import gunbc.live_deploy.emit { live_deploy_serve_unit_file }
import gunbc.live_deploy.desired { srv1_lab_desired_deployment, srv1_production_desired_deployment, selected_deployment_spec }
import gunbc.live_deploy.release_locus { ReleaseRevisionBinding, RevisionBoundAtEmission }
import gunbc.roadmap_dashboard_instance { srv1_dashboard_lab_id, srv1_dashboard_live_id, srv2_deploy_dashboard_id }
import extdeps.systemd.unit_file { serialize_systemd_unit_file }
import v2.std.collection { Present, Absent }

fn witness_revision() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: "0123456789abcdef0123456789abcdef01234567" as CommitSha }
}

test fn lab_rendered_oidc_config_names_lab_redirect_and_secret_path() -> Bool {
  match tracker_web_oidc_serve_config(instance_id: srv1_dashboard_lab_id) {
    Absent => false
    Present { value: cfg } =>
      let body = tracker_web_oidc_config_document(cfg: cfg)
      string_contains(s: body, pattern: tracker_web_test_lab_redirect_uri as String)
        && string_contains(s: body, pattern: tracker_web_dev_oauth_client_secret_host_path as String)
        && string_contains(s: body, pattern: "client_secret_file")
        && !string_contains(s: body, pattern: "\"client_secret\":")
  }
}

test fn production_serve_unit_carries_no_oidc_env() -> Bool {
  production_has_no_oidc_serve_config()
    && match tracker_web_instance_environment(instance_id: srv1_dashboard_live_id) {
      Present { value: GoogleLoginEnvironmentProd } => true
      _ => false
    }
    && match tracker_web_oauth_standing_for_environment(environment: GoogleLoginEnvironmentProd) {
      TrackerWebOauthClientUnbound { environment: _, reason: _ } => true
      TrackerWebOauthClientBound { binding: _ } => false
    }
    && !string_contains(
      s: serialize_systemd_unit_file(file: live_deploy_serve_unit_file(
        spec: selected_deployment_spec(row: srv1_production_desired_deployment()),
        revision: witness_revision(),
      )),
      pattern: oidc_config_env_var as String,
    )
}

test fn lab_serve_unit_carries_oidc_env() -> Bool {
  match tracker_web_instance_environment(instance_id: srv1_dashboard_lab_id) {
    Present { value: GoogleLoginEnvironmentTest } => true
    _ => false
  }
    && string_contains(
      s: serialize_systemd_unit_file(file: live_deploy_serve_unit_file(
        spec: selected_deployment_spec(row: srv1_lab_desired_deployment()),
        revision: witness_revision(),
      )),
      pattern: oidc_config_env_var as String,
    )
}

test fn admin_obligation_redirect_uris_equal_the_binding() -> Bool {
  let binding = tracker_web_test_workspace_identity_binding()
  let b = tracker_web_test_oauth_client_binding()
  match workspace_identity_admin_obligations(binding: binding, discovery: BasicSignInOnly).first() {
    Absent => false
    Present { value: ob } =>
      match ob.desired {
        RegisteredWebClient { redirect_uris: uris } =>
          all(uris, x => any(b.redirect_uris, y => x == y)) && all(b.redirect_uris, x => any(uris, y => x == y))
        _ => false
      }
  }
}

test fn missing_client_secret_file_refuses_with_typed_cause() -> Bool {
  match oidc_secret_from_file_standing(standing: OidcSecretFileMissing { path: "/etc/gunbc-oidc/missing" }) {
    OidcConfigFieldStringUnavailable { cause: c } =>
      string_contains(s: c, pattern: "client_secret_file") && string_contains(s: c, pattern: "does not exist")
    _ => false
  }
}

test fn srv2_hand_started_unit_is_unmodeled_and_not_adopted() -> Bool {
  let unassigned = tracker_web_test_unassigned_redirect_realizations()
  match tracker_web_instance_environment(instance_id: srv2_deploy_dashboard_id) {
    Absent => true
    Present { value: _ } => false
  }
    && match tracker_web_oidc_serve_config(instance_id: srv2_deploy_dashboard_id) {
      Absent => true
      Present { value: _ } => false
    }
    && any(unassigned, r => (r.uri as String) == (tracker_web_test_srv2_redirect_uri as String))
    && match frontier_rows_keyed_roster_build(rows: tracker_web_oauth_frontier_roster()) {
      KeyedRosterBuilt { rows: roster } =>
        any(roster, kr => match kr.row_key {
          PathSubject { path: p } => p == "gunbc-dash-18082.service"
          _ => false
        })
      _ => false
    }
}

test fn test_environment_owns_uris_and_console_readback_consumes_the_binding() -> Bool {
  let b = tracker_web_test_oauth_client_binding()
  let binding = tracker_web_test_workspace_identity_binding()
  (b.environment == GoogleLoginEnvironmentTest)
    && (tracker_web_dev_oauth_client_secret_ref.version as String) == "1"
    && match workspace_identity_admin_obligations(binding: binding, discovery: BasicSignInOnly).first() {
      Absent => false
      Present { value: ob } =>
        match workspace_admin_assess(
          goal: ob,
          receipt: tracker_web_test_registered_web_client_console_readback(),
          admitted_admins: [workspace_operator_principal()],
          now_epoch: tracker_web_test_console_readback_observed_at_epoch + 1,
        ) {
          GoalSatisfied { evidence: _ } => true
          _ => false
        }
    }
    && match frontier_rows_keyed_roster_build(rows: tracker_web_oauth_frontier_roster()) {
      KeyedRosterBuilt { rows: roster } =>
        any(roster, kr => match kr.row_key {
          PathSubject { path: p } => p == (tracker_web_test_target_owned_domain as String)
          _ => false
        })
      _ => false
    }
}
