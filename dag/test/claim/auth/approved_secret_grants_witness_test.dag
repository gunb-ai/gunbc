module test.claim.auth.approved_secret_grants_witness_test

import std.types { Bool, String, NonEmptyStr }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import gunbc.auth.approved_secret_grants { secret_grants_approval_request }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.auth.approval_run_identity { attempt_identity_of }

fn fixture_grant(secret: String = "fixture-secret", role: String = "roles/secretmanager.secretAccessor") -> SecretAccessGrant {
  SecretAccessGrant { target: SecretRef { project: "fixture-project", secret: secret as NonEmptyStr, version: "1", hash_state: HashPending }, role: role, condition: none }
}

test fn secret_grant_approval_binds_target_role_member_and_attempt() -> Bool {
  match secret_grants_approval_request(grants: [fixture_grant()], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-1") {
    Absent => false
    Present { value: original } => all([
      secret_grants_approval_request(grants: [fixture_grant(secret: "another-secret")], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-1"),
      secret_grants_approval_request(grants: [fixture_grant(role: "roles/secretmanager.admin")], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-1"),
      secret_grants_approval_request(grants: [fixture_grant()], member: "serviceAccount:other@example.invalid", attempt: "run-1-attempt-1"),
      secret_grants_approval_request(grants: [fixture_grant()], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-2"),
    ], candidate => match candidate { Absent => false Present { value: changed } => request_revision_of(request: original) != request_revision_of(request: changed) })
  }
}

test fn secret_grant_approval_refuses_empty_subject() -> Bool {
  match secret_grants_approval_request(grants: [], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-1") {
    Present { value: _ } => false
    Absent => match secret_grants_approval_request(grants: [fixture_grant()], member: " ", attempt: "run-1-attempt-1") { Absent => true _ => false }
  }
}

test fn approval_run_identity_keeps_retry_separate() -> Bool {
  match attempt_identity_of(run_id: "123", run_attempt: "1") {
    Absent => false
    Present { value: first } => match attempt_identity_of(run_id: "123", run_attempt: "2") {
      Absent => false
      Present { value: retry } => first != retry && match attempt_identity_of(run_id: "123", run_attempt: "") { Absent => true _ => false }
    }
  }
}
