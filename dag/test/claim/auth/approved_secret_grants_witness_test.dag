module test.claim.auth.approved_secret_grants_witness_test

import std.types { Bool, String, NonEmptyStr }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import gunbc.auth.approved_secret_grants { secret_grants_approval_request, secret_grants_intent }
import gunbc.auth.approval_gate { approval_gate_from_poll, GateAdmitted, GateRefused }
import gunbc.auth.approval_request_client { PollApproved }
import gunbc.auth.approval_decision_store { request_revision_of }
import gunbc.auth.approval_run_identity { attempt_identity_of }

fn fixture_grant(secret: String = "fixture-secret", role: String = "roles/secretmanager.secretAccessor") -> SecretAccessGrant {
  SecretAccessGrant { target: SecretRef { project: "fixture-project", secret: secret as NonEmptyStr, version: "1", hash_state: HashPending }, role: role, condition: none }
}

// WHAT AN APPROVAL IS BOUND TO is its intent: the request digests nothing else. Each field is its
// own claim over the intent (DESIGN §3 witness rule -- a conjunction of independent cases split
// loses no coverage), so no binding claim pays the interpreted SHA-256. The digest step's real
// path is the one inhabitance claim at the end of this module.
fn fixture_intent(grant: SecretAccessGrant = fixture_grant(), member: String = "serviceAccount:fixture@example.invalid", attempt: String = "run-1-attempt-1") -> String? {
  secret_grants_intent(grants: [grant], member: member, attempt: attempt)
}

fn intents_differ(a: String?, b: String?) -> Bool {
  match a {
    Absent => false
    Present { value: x } => match b {
      Absent => false
      Present { value: y } => x != y
    }
  }
}

test fn secret_grant_intent_binds_the_target() -> Bool  {
  intents_differ(a: fixture_intent(), b: fixture_intent(grant: fixture_grant(secret: "another-secret")))
}

test fn secret_grant_intent_binds_the_role() -> Bool  {
  intents_differ(a: fixture_intent(), b: fixture_intent(grant: fixture_grant(role: "roles/secretmanager.admin")))
}

test fn secret_grant_intent_binds_the_member() -> Bool  {
  intents_differ(a: fixture_intent(), b: fixture_intent(member: "serviceAccount:other@example.invalid"))
}

test fn secret_grant_intent_binds_the_attempt() -> Bool  {
  intents_differ(a: fixture_intent(), b: fixture_intent(attempt: "run-1-attempt-2"))
}

test fn secret_grant_approval_refuses_empty_subject() -> Bool  {
  match secret_grants_intent(grants: [], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-1") {
    Present { value: _ } => false
    Absent => match secret_grants_intent(grants: [fixture_grant()], member: " ", attempt: "run-1-attempt-1") {
      Absent => true
      Present { value: _ } => false
    }
  }
}

test fn approval_run_identity_keeps_retry_separate() -> Bool  {
  match attempt_identity_of(run_id: "123", run_attempt: "1") {
    Absent => false
    Present { value: first } => match attempt_identity_of(run_id: "123", run_attempt: "2") {
      Absent => false
      Present { value: retry } => first != retry && match attempt_identity_of(run_id: "123", run_attempt: "") { Absent => true _ => false }
    }
  }
}

// THE ONE INHABITANCE CLAIM OF THE REAL REQUEST (DESIGN §3 pairing obligation): the constructor
// digests the real intent once, the gate admits exactly that revision, and a decision recorded
// against any other revision refuses. Its whole cost is that one interpreted SHA-256; it is the
// typed admission row v2.workflow.floor_cost_debt_admission approval_intent_digest_typed_admissions.
test fn the_real_request_digests_its_intent_and_admits_only_that_revision() -> Bool  {
  match secret_grants_approval_request(grants: [fixture_grant()], member: "serviceAccount:fixture@example.invalid", attempt: "run-1-attempt-1") {
    Absent => false
    Present { value: request } => {
      let own = PollApproved { revision: request_revision_of(request: request), decided_by: "fixture-operator", decided_at: "2026-09-28T12:00:00Z", execute_by: "2026-09-28T12:05:00Z" }
      let other = PollApproved { revision: "another-intent", decided_by: "fixture-operator", decided_at: "2026-09-28T12:00:00Z", execute_by: "2026-09-28T12:05:00Z" }
      match approval_gate_from_poll(poll: own, request: request, observed_at: "2026-09-28T12:01:00Z") {
        GateRefused { cause: _ } => false
        GateAdmitted { authorization: _ } => match approval_gate_from_poll(poll: other, request: request, observed_at: "2026-09-28T12:01:00Z") {
          GateRefused { cause: _ } => true
          GateAdmitted { authorization: _ } => false
        }
      }
    }
  }
}
