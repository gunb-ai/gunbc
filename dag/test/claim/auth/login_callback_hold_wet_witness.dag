module test.claim.auth.login_callback_hold_wet_witness

import std.types { NonEmptyStr, Bool, FilePath, String, Int }
import extdeps.auth.oidc { OidcLoginTransaction, OidcPkceCodeVerifier, RelativeReturnPath }
import extdeps.shell
import gunbc.host.host_layout { srv1_host_layout }
import gunbc.deployment_risk { deployment_id }
import gunbc.roadmap.roadmap_dashboard_instance { isolated_dashboard_instance, DashboardObserveOnly, DashboardLocalProvision }
import gunbc.auth.login_transaction_store_root { LoginTransactionStoreReady, LoginTransactionStoreUnready, login_transaction_store, login_transaction_store_slots_path }
import gunbc.auth.login_transaction_store { login_transaction_store_save, login_transaction_store_lookup, LoginTransactionSaved, LoginTransactionStoreFound, LoginTransactionStoreUnknown }
import gunbc.auth.login_browser_binding { auth_login_browser_binding }
import gunbc.roadmap.roadmap_auth_routes { auth_google_callback_response, auth_callback_transaction }
import std.process { ProcessExit, ExitSuccess, exit_failure }

// Two independent browser cookie contexts and two already-read copies of one transaction.
// No code is supplied, so even configured CI cannot contact Google's token endpoint.
// The route answers 400 both for a refused browser and for a store it could not read, so each refusal is
// checked by its body (the state names no live transaction), never by the status alone, and the witness's own
// mint refusing fails the claim with its detail (stern-ram-763, 2026-10-25).
fn names_no_live_transaction(status: Int, body: String) -> Bool {
  status == 400 && string_contains(s: body, pattern: "no live login transaction")
}

test fn foreign_browser_cannot_consume_and_cached_replay_cannot_exchange() -> ProcessExit {
  let directory = shell.Mktemp.Dir()
  if !directory.success { exit_failure(reason: "the fixture directory could not be created") } else {
    let instance = isolated_dashboard_instance(deployment: deployment_id(name: "login-hold-fixture" as NonEmptyStr), instance_id: "login-hold-fixture", layout: srv1_host_layout(), root: directory.path as FilePath,
      serve_function: "unused", listen_port: 18744, source_anchor_ref: "refs/heads/fixture", actuation: DashboardObserveOnly, provision_transport: DashboardLocalProvision)
    let made = shell.Mkdir.Parents(path: login_transaction_store_slots_path(instance: instance))
    let transaction = OidcLoginTransaction { state: "hold-browser-state", nonce: "hold-browser-nonce", created_at: "2026-09-28T00:00:00Z", expires_at: "2099-01-01T00:00:00Z",
      verifier: OidcPkceCodeVerifier { verifier: "fixture-pkce-only-never-a-google-code" }, return_path: RelativeReturnPath { path: "/" } }
    if !made.success { exit_failure(reason: "the login transaction directory could not be created") } else { match login_transaction_store(instance: instance) {
     LoginTransactionStoreUnready { detail: d } => exit_failure(reason: join(["the login transaction store mint refused over the fixture tree: ", d], ""))
     LoginTransactionStoreReady { store: transactions } => match login_transaction_store_save(store: transactions, transaction: transaction) {
      LoginTransactionSaved { state: _ } => {
        let wrong = auth_google_callback_response(instance: instance, path: "/auth/google/callback?state=hold-browser-state", cookie_header: "__Host-gunbc-login=another-browser")
        let missing = auth_google_callback_response(instance: instance, path: "/auth/google/callback?state=hold-browser-state", cookie_header: "")
        if !names_no_live_transaction(status: wrong.status, body: wrong.body) || !names_no_live_transaction(status: missing.status, body: missing.body) {
          exit_failure(reason: join(["a foreign or missing browser binding was not refused as naming no live transaction: ", wrong.body, " / ", missing.body], ""))
        } else { match login_transaction_store_lookup(store: transactions, state: transaction.state) {
          LoginTransactionStoreFound { transaction: cached } => {
            let initiated = auth_google_callback_response(instance: instance, path: "/auth/google/callback?state=hold-browser-state",
              cookie_header: concat("__Host-gunbc-login=", auth_login_browser_binding(transaction: transaction)))
            let replay = auth_callback_transaction(instance: instance, transactions: transactions, transaction: cached, path: "/auth/google/callback?state=hold-browser-state")
            if !(initiated.status == 400 || initiated.status == 503) { exit_failure(reason: join(["the initiating browser's callback did not refuse before any exchange: ", initiated.body], "")) }
            else if !names_no_live_transaction(status: replay.status, body: replay.body) { exit_failure(reason: join(["the cached replay was not refused as naming no live transaction: ", replay.body], "")) }
            else { match login_transaction_store_lookup(store: transactions, state: transaction.state) {
              LoginTransactionStoreUnknown { state: _ } => ExitSuccess
              _ => exit_failure(reason: "the initiating browser's callback did not consume the transaction")
            } }
          }
          _ => exit_failure(reason: "the refused browsers did not leave the transaction in place")
        } }
      }
      _ => exit_failure(reason: "the transaction could not be saved")
    } } }
  }
}
