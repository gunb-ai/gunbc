module test.claim.auth.auth_store_key_witness_test

import std.types { Bool, FilePath, NonEmptyStr }
import gunbc.auth.auth_store_key { auth_store_key_of }
import gunbc.auth.login_transaction_store { LoginTransactionStoreLayout, login_transaction_store_lookup, login_transaction_store_delete, LoginTransactionStoreUnknown, LoginTransactionStoreFound, LoginTransactionStoreUnread, LoginTransactionStoreEntryMalformed, LoginTransactionDeleteRefused, LoginTransactionDeleted, LoginTransactionNothingToDelete }
import gunbc.auth.session_store { SessionStoreLayout, session_store_lookup, session_store_delete, SessionStoreUnknown, SessionStoreFound, SessionStoreUnread, SessionStoreEntryMalformed, SessionStoreDeleteRefused, SessionStoreDeleted, SessionStoreNothingToDelete }

// REQUEST-SUPPLIED IDENTIFIERS NEVER NAME A FILE OUTSIDE THEIR STORE. The callback's `state` query
// parameter and the Cookie header's session id reach these stores; every one of the traversal
// shapes below is refused by gunbc.auth.auth_store_key auth_store_key_of, so the store answers
// without any filesystem call (the layout root below does not exist and is never read). RED if any
// traversal shape is admitted as a key, or reaches a lookup/delete that touches the filesystem.
data traversal_shapes: List<String> = ["../x", "..", "a/b", "/etc/passwd", "a\u{0}b", "a.b", ".", "a b", "a%2Fb"]

test fn no_traversal_shape_is_a_store_key() -> Bool  {
  auth_store_key_of(raw: "") == none
    && all(traversal_shapes, raw => match auth_store_key_of(raw: raw) {
      Absent => true
      Present { value: _ } => false
    })
}

test fn a_minted_base64url_identifier_is_a_store_key() -> Bool  {
  match auth_store_key_of(raw: "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk") {
    Present { value: k } => (k.value as String) == "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    Absent => false
  }
}

fn never_read_login_layout() -> LoginTransactionStoreLayout {
  LoginTransactionStoreLayout { root: "/fixture-never-read/login" as FilePath }
}

fn never_read_session_layout() -> SessionStoreLayout {
  SessionStoreLayout { root: "/fixture-never-read/sessions" as FilePath }
}

test fn a_traversal_state_is_unknown_and_its_consume_refuses_without_a_filesystem_call() -> Bool  {
  all(["../x", "a/b", "/etc/passwd"], raw =>
    match login_transaction_store_lookup(layout: never_read_login_layout(), state: raw as NonEmptyStr) {
      LoginTransactionStoreUnknown { state: _ } => true
      LoginTransactionStoreFound { transaction: _ } => false
      LoginTransactionStoreUnread { state: _, detail: _ } => false
      LoginTransactionStoreEntryMalformed { state: _, detail: _ } => false
    } && match login_transaction_store_delete(layout: never_read_login_layout(), state: raw as NonEmptyStr) {
      LoginTransactionDeleteRefused { state: _, detail: d } => string_contains(s: d, pattern: "not a store key")
      LoginTransactionDeleted { state: _ } => false
      LoginTransactionNothingToDelete { state: _ } => false
    })
}

test fn a_traversal_session_id_is_unknown_and_its_delete_refuses_without_a_filesystem_call() -> Bool  {
  all(["../x", "a/b", "/etc/passwd"], raw =>
    match session_store_lookup(layout: never_read_session_layout(), session_id: raw as NonEmptyStr) {
      SessionStoreUnknown { session_id: _ } => true
      SessionStoreFound { session: _ } => false
      SessionStoreUnread { session_id: _, detail: _ } => false
      SessionStoreEntryMalformed { session_id: _, detail: _ } => false
    } && match session_store_delete(layout: never_read_session_layout(), session_id: raw as NonEmptyStr) {
      SessionStoreDeleteRefused { session_id: _, detail: d } => string_contains(s: d, pattern: "not a store key")
      SessionStoreDeleted { session_id: _ } => false
      SessionStoreNothingToDelete { session_id: _ } => false
    })
}
