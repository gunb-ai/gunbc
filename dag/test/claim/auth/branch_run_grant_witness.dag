data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fleet_converge_path: String = ".github/workflows/fleet-converge.yml"

data title: String = "fleet-converge hetzner_cloud_server_read srv1 nonce="

fn run_status(done: Bool) -> WorkflowRunStatus {
  if done { Completed } else { InProgress }
}

fn a_run(id: Int, attempt: Int, path: String, event: String, done: Bool) -> WorkflowRun {
  WorkflowRun {
    id: id, name: Present { value: "fleet-converge" }, display_title: Present { value: title }, path: Present { value: path },
    head_sha: "0123456789abcdef0123456789abcdef01234567" as CommitSha, head_branch: Present { value: "work/cax-onboard" },
    event: event, status: run_status(done: done), conclusion: none,
    workflow_id: 15, run_number: 900, run_attempt: attempt,
    actor: none, triggering_actor: Present { value: GitHubUser { login: "operator", id: 1, type: User } },
    html_url: "https://github.com/gunb-ai/gunbc/actions/runs/7", created_at: "2026-10-09T04:00:00Z",
    updated_at: "2026-10-09T04:00:00Z", pull_requests: [],
  }
}

fn facts(attempt: Int, created_at: Timestamp) -> BranchRunFacts {
  BranchRunFacts {
    run_id: GitHubWorkflowRunId { value: 7 }, run_attempt: attempt, mode: "hetzner_cloud_server_read", branch: "work/cax-onboard",
    head_sha: "0123456789abcdef0123456789abcdef01234567" as CommitSha, dispatched_by: "operator", created_at: created_at,
  }
}

fn policy(cells: List<GcpIamBindingCell>, etag: String) -> GcpPolicy {
  GcpPolicy { bindings: map(cells, c => GcpBinding { role: c.role, members: [c.member], condition: c.condition }), etag: etag, version: 3 }
}

// THE RUN-SCOPED ACCOUNT HOLDS NO STANDING WAY IN, its pool does not pin a ref, and the provider maps
// the run AND its attempt: the facts that make one approval reach one attempt and nothing else.
test fn the_account_has_no_standing_way_in_and_the_pool_maps_the_attempt() -> Bool {
  let f = hetzner_cloud_control_federation()
  impersonation_cells(f: f).length() == 0
    && match standing_principal_set(f: f) { Present { value: _ } => false  Absent => true }
    && !branch_dispatch_attribute_condition().contains("assertion.ref")
    && !branch_dispatch_attribute_condition().contains("workflow_ref")
    && branch_dispatch_attribute_condition().contains("assertion.event_name == 'workflow_dispatch'")
    && match map_lookup(branch_dispatch_attribute_mapping, "attribute.run") { Present { value: v } => v == "assertion.run_id + '-' + assertion.run_attempt"  Absent => false }
    && any(gcp_iam_converge_targets, t => (t.service_account as String) == (f.service_account as String))
}

// THE ACCOUNT REACHES THE READ TOKEN AND ONLY IT: a branch run's approval can never release a token
// that writes.
test fn the_account_holds_only_the_read_only_hetzner_token() -> Bool {
  (match hetzner_cloud_default_read_token.permission { HetznerTokenRead => true  _ => false })
    && hetzner_cloud_api_grants().length() == 1
    && all(hetzner_cloud_api_grants(), g => (g.target.secret as String) == "hetzner-cloud-default-read-api-key")
}

// THE CONVERGE GRANTS THE READ TOKEN AND WRITES NOTHING ON THE ACCOUNT'S OWN POLICY: no empty add, no
// standing cell. The account itself is created by the bootstrap ceremony, not by the converge.
test fn the_converge_provisions_the_account_without_touching_its_policy() -> Bool {
  let f = hetzner_cloud_control_federation()
  match plan_dedicated_federation(
    f: f,
    classification: FederationClassified { create_pool: false, create_provider: true, create_account: false },
    account_policy: PolicyResourceAbsent,
    secret_policies: map(f.secret_grants, g => GrantPolicyReading { grant: g, reading: PolicyObserved { policy: GcpPolicy { bindings: [], etag: "s0", version: 1 } } }),
  ) {
    GcpIamApply { diff: d } =>
      !any(d.effects, e => match e { AddPolicyCells { subject: ServiceAccountPolicy { email: _ }, observed_etag: _, cells: _ } => true  _ => false })
        && any(d.effects, e => match e { AddPolicyCells { subject: SecretPolicy { secret: s }, observed_etag: _, cells: _ } => (s as String) == "hetzner-cloud-default-read-api-key"  _ => false })
    _ => false
  }
}

// THE CELL NAMES ONE RUN ATTEMPT AND EXPIRES; attempt 2 of the same run is a different principal.
test fn the_cell_names_one_attempt_and_expires() -> Bool {
  let c = branch_run_impersonation_cell(run_id: GitHubWorkflowRunId { value: 37879231670 }, run_attempt: 1, expires_at: "2026-10-09T05:00:00Z")
  c.member == branch_run_principal_set(run_id: GitHubWorkflowRunId { value: 37879231670 }, run_attempt: 1)
    && c.member.ends_with("/workloadIdentityPools/github-fleet-converge-dispatch/attribute.run/37879231670-1")
    && c.member != branch_run_principal_set(run_id: GitHubWorkflowRunId { value: 37879231670 }, run_attempt: 2)
    && match c.condition { Present { value: k } => k.expression == "request.time < timestamp('2026-10-09T05:00:00Z')" && k.title == "gunbc-branch-run-37879231670-1"  Absent => false }
}

// ONLY A LIVE DISPATCH OF fleet-converge, AT THE ATTEMPT ASKED ABOUT, IS ADMITTED; its facts are GitHub's.
test fn only_a_live_fleet_converge_dispatch_at_the_asked_attempt_is_admitted() -> Bool {
  match judge_branch_run(run_id: GitHubWorkflowRunId { value: 7 }, run_attempt: 1, run: a_run(id: 7, attempt: 1, path: fleet_converge_path, event: "workflow_dispatch", done: false)) {
    BranchRunAdmitted { facts: r } => r.branch == "work/cax-onboard" && r.dispatched_by == "operator" && r.mode == "hetzner_cloud_server_read" && r.run_attempt == 1
    BranchRunRefused { reason: _ } => false
  }
}

fn refused(run_attempt: Int, r: WorkflowRun) -> Bool {
  match judge_branch_run(run_id: GitHubWorkflowRunId { value: 7 }, run_attempt: run_attempt, run: r) {
    BranchRunRefused { reason: _ } => true
    BranchRunAdmitted { facts: _ } => false
  }
}

// RED: ANOTHER WORKFLOW, ANOTHER EVENT, A FINISHED RUN, ANOTHER ID, OR A RUN GITHUB HAS SINCE RE-RUN.
test fn anything_but_the_live_asked_attempt_is_refused() -> Bool {
  refused(run_attempt: 1, r: a_run(id: 7, attempt: 1, path: ".github/workflows/witnesses.yml", event: "workflow_dispatch", done: false))
    && refused(run_attempt: 1, r: a_run(id: 7, attempt: 1, path: fleet_converge_path, event: "push", done: false))
    && refused(run_attempt: 1, r: a_run(id: 7, attempt: 1, path: fleet_converge_path, event: "workflow_dispatch", done: true))
    && refused(run_attempt: 1, r: a_run(id: 8, attempt: 1, path: fleet_converge_path, event: "workflow_dispatch", done: false))
    && refused(run_attempt: 1, r: a_run(id: 7, attempt: 2, path: fleet_converge_path, event: "workflow_dispatch", done: false))
}

// RED: ATTEMPT 2 CANNOT CONSUME ATTEMPT 1'S APPROVAL. With attempt 1's cell live on the account, a
// grant for attempt 2 is not held: it plans its own add, which needs its own approval.
test fn a_rerun_attempt_needs_its_own_grant() -> Bool {
  let f = hetzner_cloud_control_federation()
  let first = branch_run_impersonation_cell(run_id: GitHubWorkflowRunId { value: 7 }, run_attempt: 1, expires_at: "2026-10-09T05:00:00Z")
  match plan_branch_run_grant(f: f, run: facts(attempt: 2, created_at: "2026-10-09T04:10:00Z"), expires_at: "2026-10-09T05:10:00Z", reading: PolicyObserved { policy: policy(cells: [first], etag: "e1") }) {
    BranchRunGrantPlanned { grant: g } => g.cell.member != first.member && g.pruned.length() == 0
    _ => false
  }
}

// THE GRANT ADDS ONE CELL, REMOVES THE LAPSED ONES, KEEPS THE LIVE ONES AND EVERY FOREIGN BINDING, and
// the apply writes exactly that against the approved etag.
test fn the_grant_prunes_lapsed_cells_and_preserves_the_rest() -> Bool {
  let f = hetzner_cloud_control_federation()
  let lapsed = branch_run_impersonation_cell(run_id: GitHubWorkflowRunId { value: 5 }, run_attempt: 1, expires_at: "2026-10-09T03:00:00Z")
  let live = branch_run_impersonation_cell(run_id: GitHubWorkflowRunId { value: 6 }, run_attempt: 1, expires_at: "2026-10-09T04:30:00Z")
  let foreign = GcpIamBindingCell { role: "roles/iam.serviceAccountTokenCreator", member: "user:operator@example.com", condition: none }
  let observed = policy(cells: [lapsed, live, foreign], etag: "e1")
  match plan_branch_run_grant(f: f, run: facts(attempt: 1, created_at: "2026-10-09T04:00:00Z"), expires_at: "2026-10-09T05:00:00Z", reading: PolicyObserved { policy: observed }) {
    BranchRunGrantPlanned { grant: g } =>
      g.observed_etag == "e1" && g.pruned.length() == 1 && gcp_cell_in(c: lapsed, xs: g.pruned)
        && (branch_run_grant_purpose(g: g) as String).contains("attempt 1 of fleet-converge (mode hetzner_cloud_server_read) on work/cax-onboard")
        && match approved_grant_policy(g: g, reading: PolicyObserved { policy: observed }) {
          Present { value: next } => {
            let cells = gcp_policy_cells(p: next)
            gcp_cell_in(c: g.cell, xs: cells) && gcp_cell_in(c: live, xs: cells) && gcp_cell_in(c: foreign, xs: cells) && !gcp_cell_in(c: lapsed, xs: cells)
          }
          Absent => false
        }
        && match approved_grant_policy(g: g, reading: PolicyObserved { policy: policy(cells: [lapsed, live, foreign], etag: "e2") }) { Present { value: _ } => false  Absent => true }
    _ => false
  }
}

// THE RUN'S CELL ALREADY PRESENT HOLDS; AN OWNED CELL WHOSE EXPIRY THIS MODULE DID NOT WRITE REFUSES.
test fn a_present_cell_holds_and_an_unjudgeable_owned_cell_refuses() -> Bool {
  let f = hetzner_cloud_control_federation()
  let mine = branch_run_impersonation_cell(run_id: GitHubWorkflowRunId { value: 7 }, run_attempt: 1, expires_at: "2026-10-09T05:00:00Z")
  let odd = GcpIamBindingCell { role: mine.role, member: "principalSet://x", condition: Present { value: IamCondition { title: "gunbc-branch-run-9-1", description: none, expression: "true" } } }
  (match plan_branch_run_grant(f: f, run: facts(attempt: 1, created_at: "2026-10-09T04:00:00Z"), expires_at: "2026-10-09T05:00:00Z", reading: PolicyObserved { policy: policy(cells: [mine], etag: "e1") }) {
    BranchRunGrantHeld { run: _ } => true
    _ => false
  })
    && match plan_branch_run_grant(f: f, run: facts(attempt: 1, created_at: "2026-10-09T04:00:00Z"), expires_at: "2026-10-09T05:00:00Z", reading: PolicyObserved { policy: policy(cells: [odd], etag: "e1") }) {
      BranchRunGrantRefused { reason: _ } => true
      _ => false
    }
}

// ONE MODE/REF RULE: a main boot run is ineligible (broker dispatches nothing, planner refuses); a
// non-main boot run maps to mtcollins1-boot-run; the hetzner read mode is eligible on any ref.
test fn boot_mode_eligibility_follows_the_credential_selection_by_ref() -> Bool {
  match run_scoped_mode_eligible(mode: "mtcollins1_boot", branch: "main") { Present { value: _ } => false  Absent => true }
    && match run_scoped_mode_eligible(mode: "mtcollins1_boot", branch: "integration/mtcollins-boot") { Present { value: m } => (run_scoped_account_id(m: m) as String) == "mtcollins1-boot-run"  Absent => false }
    && match run_scoped_mode_eligible(mode: "hetzner_cloud_server_read", branch: "main") { Present { value: m } => (run_scoped_account_id(m: m) as String) == "hetzner-cloud-control"  Absent => false }
    && match run_scoped_mode_eligible(mode: "hetzner_cloud_server_read", branch: "work/x") { Present { value: _ } => true  Absent => false }
    && match run_scoped_mode_eligible(mode: "microvm_network_apply", branch: "work/x") { Present { value: _ } => false  Absent => true }
}

// THE FLEET-IDENTITY ROWS ARE GRANTED ONLY OFF MAIN (main signs in through the main-only pool), each to
// its own account; plan reuses the standing fleet account, apply gets its own.
test fn fleet_identity_modes_are_granted_off_main_only() -> Bool {
  all(["plan", "apply"], mode =>
    match run_scoped_mode_eligible(mode: mode, branch: "main") { Present { value: _ } => false  Absent => true }
      && match run_scoped_mode_eligible(mode: mode, branch: "work/x") { Present { value: _ } => true  Absent => false })
    && match run_scoped_mode_named(mode: "plan") { Present { value: m } => (run_scoped_account_id(m: m) as String) == "fleet-cloud-convergence"  Absent => false }
    && match run_scoped_mode_named(mode: "apply") { Present { value: m } => (run_scoped_account_id(m: m) as String) == "fleet-apply-run"  Absent => false }
    // dashboard_deploy is deliberately not a row (its job holds no credential, so a grant would gate nothing IAM enforces).
    && match run_scoped_mode_named(mode: "dashboard_deploy") { Present { value: _ } => false  Absent => true }
    && match run_scoped_mode_eligible(mode: "dashboard_deploy", branch: "work/x") { Present { value: _ } => false  Absent => true }
}

// RED: every row resolves to a federation (a row without one would be a grant nothing can plan), the
// new accounts hold no standing impersonation and are converge targets, and the plan row's account is
// not a second converge target.
test fn every_row_resolves_and_the_new_accounts_have_no_standing_way_in() -> Bool {
  all(run_scoped_modes(), r => match run_scoped_federation_named(account_id: run_scoped_account_id(m: r) as String) { Present { value: _ } => true  Absent => false })
    && all(["fleet-apply-run"], id =>
      match run_scoped_federation_named(account_id: id) {
        Absent => false
        Present { value: f } => impersonation_cells(f: f).length() == 0
          && match standing_principal_set(f: f) { Present { value: _ } => false  Absent => true }
          && any(gcp_iam_converge_targets, t => (t.service_account as String) == (f.service_account as String))
          && all(f.secret_grants, g => (g.target.secret as String) == "fleet-automation-ssh-key")
      })
    && count(filter(gcp_iam_converge_targets, t => (t.service_account_id as String) == "fleet-cloud-convergence")) == 1
}

// MAIN'S TABLE DECIDES THE ACCOUNT: the read mode maps to hetzner-cloud-control, anything else to nothing.
test fn only_a_declared_mode_reaches_a_declared_account() -> Bool {
  mode_of_run_title(title: title) == "hetzner_cloud_server_read"
    && match run_scoped_mode_named(mode: "hetzner_cloud_server_read") { Present { value: m } => (run_scoped_account_id(m: m) as String) == "hetzner-cloud-control"  Absent => false }
    && match run_scoped_mode_named(mode: "mtcollins1_boot") { Present { value: m } => (run_scoped_account_id(m: m) as String) == (mtcollins1_boot_run_scoped_service_account_id as String)  Absent => false }
    && match run_scoped_mode_named(mode: "microvm_network_apply") { Present { value: _ } => false  Absent => true }
}

fn grant_secret_versions(grants: List<SecretAccessGrant>) -> List<String> {
  map(grants, g => join([g.target.secret as String, ":", g.target.version], ""))
}

// RED: a hetzner grant unlocks the boot. Modes map to distinct accounts; the boot account has no
// standing impersonation, is a converge target, and is not the hetzner account.
test fn a_hetzner_grant_cannot_unlock_the_boot_account() -> Bool {
  match mtcollins1_boot_run_scoped_federation() {
    Absent => false
    Present { value: boot } =>
      (boot.service_account_id as String) != (hetzner_cloud_control_federation().service_account_id as String)
        && impersonation_cells(f: boot).length() == 0
        && match standing_principal_set(f: boot) { Present { value: _ } => false  Absent => true }
        && any(gcp_iam_converge_targets, t => (t.service_account as String) == (boot.service_account as String))
        && match run_scoped_federation_named(account_id: "hetzner-cloud-control") {
          Present { value: h } => (h.service_account as String) != (boot.service_account as String)
          Absent => false
        }
  }
}

// RED: the two boot SAs pin different BMC versions. Both derive secret_grants from the admitted
// pair; a forged second version is not a converge target.
test fn both_boot_accounts_pin_the_admitted_bmc_and_fleet_key_versions() -> Bool {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    Absent => false
    Present { value: admitted } => match mtcollins1_boot_run_scoped_federation() {
      Absent => false
      Present { value: run } => {
        let standing = boot_dedicated_federation(f: admitted)
        grant_secret_versions(grants: standing.secret_grants) == grant_secret_versions(grants: admitted.secret_grants)
          && grant_secret_versions(grants: run.secret_grants) == grant_secret_versions(grants: admitted.secret_grants)
          && any(admitted.secret_grants, g => (g.target.secret as String) == "fleet-automation-ssh-key" && g.target.version == "1")
          && any(admitted.secret_grants, g => (g.target.secret as String) == (mtcollins1_bmc_gunbc_secret_ref.secret as String)
                && (g.target.version as String) == (mtcollins1_bmc_gunbc_secret_ref.version as String))
          && !any(gcp_iam_converge_targets, t =>
            (t.service_account_id as String) == (run.service_account_id as String)
              && any(t.secret_grants, g => (g.target.secret as String) == (mtcollins1_bmc_gunbc_secret_ref.secret as String)
                && any(admitted.secret_grants, a => (a.target.secret as String) == (mtcollins1_bmc_gunbc_secret_ref.secret as String)
                  && a.target.version != g.target.version)))
          && match select_boot_credential_source(on_reviewed_main: true) { BootCredentialSourceSelected { source: ReviewedMainDedicatedFederation } => true  BootCredentialSourceSelected { source: RunScopedApprovedGrant } => false  BootCredentialSourceSelected { source: TrustedBranchBootIdentity } => false  BootCredentialSourceRefused { cause: _ } => false }
          && match select_boot_credential_source(on_reviewed_main: false) { BootCredentialSourceSelected { source: RunScopedApprovedGrant } => true  BootCredentialSourceSelected { source: ReviewedMainDedicatedFederation } => false  BootCredentialSourceSelected { source: TrustedBranchBootIdentity } => false  BootCredentialSourceRefused { cause: _ } => false }
      }
    }
  }
}

fn boot_pattern_is_federated(on_reviewed_main: Bool) -> Bool {
  match select_authorization_pattern(e: boot_credential_effect(on_reviewed_main: on_reviewed_main)) {
    PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => true
    _ => false
  }
}

fn boot_pattern_is_approved(on_reviewed_main: Bool) -> Bool {
  match select_authorization_pattern(e: boot_credential_effect(on_reviewed_main: on_reviewed_main)) {
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => true
    _ => false
  }
}

fn census_boot_credential_effect_conforms(decl_name: String) -> Bool {
  let rows = filter(privileged_effect_census, r => (r.site.decl_name as String) == decl_name)
  rows.length() == 1
    && match rows.first() {
      Present { value: r } => match site_verdict(row: r).conformance { Conforms => true  _ => false }
      Absent => false
    }
}

// RED: a local if on github.ref beside select_authorization_pattern. The census rows execute
// the central selection on the same effects the source fold consumes. Vacuous all(filter(...))
// is not that join (review 80563): a missing or renamed site still passed.
test fn boot_credential_source_is_the_authorization_pattern_selection() -> Bool {
  boot_pattern_is_federated(on_reviewed_main: true)
    && !boot_pattern_is_approved(on_reviewed_main: true)
    && boot_pattern_is_approved(on_reviewed_main: false)
    && !boot_pattern_is_federated(on_reviewed_main: false)
    && match select_boot_credential_source(on_reviewed_main: true) { BootCredentialSourceSelected { source: ReviewedMainDedicatedFederation } => true  BootCredentialSourceSelected { source: RunScopedApprovedGrant } => false  BootCredentialSourceSelected { source: TrustedBranchBootIdentity } => false  BootCredentialSourceRefused { cause: _ } => false }
    && match select_boot_credential_source(on_reviewed_main: false) { BootCredentialSourceSelected { source: RunScopedApprovedGrant } => true  BootCredentialSourceSelected { source: ReviewedMainDedicatedFederation } => false  BootCredentialSourceSelected { source: TrustedBranchBootIdentity } => false  BootCredentialSourceRefused { cause: _ } => false }
    && census_boot_credential_effect_conforms(decl_name: "boot_credential_effect_on_reviewed_main")
    && census_boot_credential_effect_conforms(decl_name: "boot_credential_effect_off_reviewed_main")
}

// THE KEY IS EXACTLY <run id>-<run attempt>, both positive.
test fn the_run_key_parses_only_its_own_shape() -> Bool {
  match parse_branch_run_key(key: "37879231670-2") { Present { value: k } => k.run_id.value == 37879231670 && k.run_attempt == 2  Absent => false }
    && match parse_branch_run_key(key: "37879231670") { Present { value: _ } => false  Absent => true }
    && match parse_branch_run_key(key: "a-1") { Present { value: _ } => false  Absent => true }
    && match parse_branch_run_key(key: "7-0") { Present { value: _ } => false  Absent => true }
    && match parse_branch_run_key(key: "0-1") { Present { value: _ } => false  Absent => true }
    && match parse_branch_run_key(key: "7-1-2") { Present { value: _ } => false  Absent => true }
}

// RED (review 80417): a selection that does not name one of the two admitted patterns must not
// become a credential source. Before this, every such arm fell through to RunScopedApprovedGrant,
// so a refused or undecided selection still emitted the run-scoped account into the boot job.
fn standing_is_refused(s: BootCredentialStanding) -> Bool {
  match s {
    BootCredentialSourceRefused { cause: _ } => true
    BootCredentialSourceSelected { source: _ } => false
  }
}

test fn red_a_non_admitted_pattern_is_a_refused_boot_credential_source() -> Bool {
  standing_is_refused(s: boot_credential_source_from_pattern(on_reviewed_main: false, p: OperatorOwnSession))
    && standing_is_refused(s: boot_credential_source_from_selection(on_reviewed_main: false, s: PatternSelectionRefused { defects: [] }))
    && standing_is_refused(s: boot_credential_source_from_selection(on_reviewed_main: false, s: PatternSelectionNeedsEvidence { needs: [] }))
    && standing_is_refused(s: boot_credential_source_from_selection(on_reviewed_main: false, s: PatternSelectionNeedsPolicy { survivors: [] }))
    && standing_is_refused(s: boot_credential_source_from_pattern(on_reviewed_main: false, p: FederatedScopedGrant))
    && standing_is_refused(s: boot_credential_source_from_pattern(on_reviewed_main: true, p: OperatorApprovedCapability))
}

// ══ THE APPROVAL-FREE BRANCH BOOT (operator rulings 2026-10-22 "is not sensitive", 2026-10-23
// "permission to boot it endlessly" / a non-main integration branch "shouldn't need an approval") ═══
// These REDs hold the line the brief drew: the ONE mode at the ROSTERED ref gets the approval-free
// identity, and nothing else moves. They deliberately do not ask "does the workflow file say
// approval-free" -- a branch can rewrite its own workflow file, so a check on workflow text would pass
// for a bypass. They ask what the SELECTION returns, and what GCP's provider condition ADMITS.

// A REPRESENTATIVE ENTRY, for the claim-level REDs that must present a concrete claim set. The accessor is
// the modeled one; nothing here reimplements it. Note which REDs this is legitimate for (a claim set is
// per-ref, so one entry is a complete example) and which it is NOT: the route's own gating asks every
// entry, and the next test is the one that pins that.
fn trusted_boot_branch() -> String {
  let b = first_trusted_branch()
  if (b as String).length() > 0 { b } else { "__gunbc_no_rostered_branch__" }
}

// THE ROSTER IS ANSWERED AS A SET, NOT THROUGH A REPRESENTATIVE. For every entry, the wait-job rule must
// agree with the credential selection AT THAT SAME REF -- so an entry added to the roster is judged on its
// own ref and cannot inherit a neighbour's approval, and an entry the selection refuses cannot borrow the
// route. This is the assertion that would have caught the single-representative version of this code.
test fn every_roster_entry_is_answered_on_its_own_ref() -> Bool {
  all(mtcollins1_boot_trusted_branches, b =>
    fleet_converge_grant_required_at_ref(mode: MtCollins1Boot, branch: b as String)
      == boot_grant_required_at_ref(on_reviewed_main: false, branch: b as String))
    // AND THE BOOT IS THE ONLY MODE WHOSE GRANT QUESTION CAN DIFFER BY REF -- asked of the modes that
    // actually own a grant question. MEASURED, NOT ASSUMED (2026-10-29, gunbc test on this file): the
    // run-scoped grant universe is gunbc.auth.branch_dispatch_federation run_scoped_modes(), which holds
    // hetzner_cloud_server_read, mtcollins1_boot, plan and apply. An earlier draft of this claim asked
    // host_reset_return and gcp_iam_converge instead, and it FAILED: neither has a row in that table, so
    // fleet_converge_grant_required answers false for them at every ref -- main and branch alike -- and
    // their admission is decided by other authorities entirely. Asking the "still needs the grant"
    // question of a mode that never had one is a claim that cannot fail for the wrong reason, which is
    // the same thing as proving nothing.
    && all(mtcollins1_boot_trusted_branches, b =>
      fleet_converge_grant_required_at_ref(mode: HetznerCloudServerRead, branch: b as String)
        && fleet_converge_grant_required_at_ref(mode: FleetApply, branch: b as String))
}

fn boot_environment() -> String {
  match mtcollins1_boot_trusted_environment() {
    Present { value: e } => e as String
    Absent => ""
  }
}

// THE ROUTE CANNOT EXIST WITHOUT THE BOOT IDENTITY THAT NAMES ITS ENVIRONMENT. The provider pins the
// job's `environment:` to the boot federation's own name, read from code, so an unprovisioned boot
// federation means no branch route at all -- and the selection refuses rather than selecting. Asserting
// this here is what keeps every environment-shaped RED below from being vacuous.
test fn branch_boot_route_has_a_provisioned_boot_identity() -> Bool {
  match mtcollins1_boot_trusted_environment() { Present { value: e } => (e as String).length() > 0  Absent => false }
}

// THE ROSTER IS NOT EMPTY, AND A REF IS PINNED TO A REAL BRANCH. An empty roster would poison the
// provider's ref condition into matching nothing, which is safe but silent; a roster is a code list, so
// this asks the list directly.
test fn branch_boot_roster_is_rostered_and_pinned() -> Bool {
  mtcollins1_boot_trusted_branches.length() > 0
    && starts_with(s: mtcollins1_boot_trusted_branch_ref(branch: trusted_boot_branch()), prefix: "refs/heads/")
    && mtcollins1_boot_branch_is_trusted(branch: trusted_boot_branch())
}

// THE WIDENING, STATED AS A FACT. A same-repository branch dispatch of mtcollins1_boot at a rostered ref
// selects a THIRD credential source: neither the reviewed-main dedicated identity nor the
// approval-gated run-scoped grant, but the dedicated branch-boot identity. This is the row the PR body
// says plainly -- anyone with branch push in gunb-ai/gunbc can now drive mtcollins1's BMC at that ref.
// ...WHILE THE ROUTE IS CLOSED, IT DOES NOT. This is the state on main today, because the reader keypair
// is unminted (see the mint-gate claims below): the rostered ref falls back to the approval-gated
// run-scoped grant rather than selecting an identity that was never converged. Asserting the old form here
// would have been rung inflation of the opposite sign -- advertising the widening as delivered when the
// credential that makes it complete does not exist yet.
test fn branch_boot_selects_the_approval_free_identity() -> Bool {
  match select_boot_credential_source_at_ref(on_reviewed_main: false, branch: trusted_boot_branch()) {
    BootCredentialSourceSelected { source: TrustedBranchBootIdentity } =>
      !boot_grant_required_at_ref(on_reviewed_main: false, branch: trusted_boot_branch())
    // closed route: no approval-free selection, and the grant is still required -- degraded, never bypassed
    BootCredentialSourceRefused { cause: _ } =>
      boot_grant_required_at_ref(on_reviewed_main: false, branch: trusted_boot_branch())
    BootCredentialSourceSelected { source: _ } => false
  }
}

// ...AND IT SELECTS THE IDENTITY THAT WAS DECLARED FOR IT, not the main identity wearing a different
// label: the account and provider this route federates are the branch route's own.
test fn branch_boot_identity_is_a_distinct_principal() -> Bool {
  (mtcollins1_boot_branch_service_account as String) != (mtcollins1_boot_run_scoped_service_account as String)
    && mtcollins1_boot_branch_provider_resource() != branch_dispatch_provider_resource()
    && match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
      // not the reviewed-main boot's account under a new label, either
      Present { value: f } => (mtcollins1_boot_branch_service_account as String) != (f.names.service_account as String)
      Absent => false
    }
}

// RED: THE GRANT STILL GATES THE BOOT AT A BRANCH THE CODE DOES NOT NAME. The roster is the whole
// permission; an arbitrary integration branch is not it.
test fn an_unrostered_branch_boot_still_needs_the_grant() -> Bool {
  let untrusted = concat(trusted_boot_branch(), "-not-rostered")
  !mtcollins1_boot_branch_is_trusted(branch: untrusted)
    && boot_grant_required_at_ref(on_reviewed_main: false, branch: untrusted)
    && match select_boot_credential_source_at_ref(on_reviewed_main: false, branch: untrusted) {
      BootCredentialSourceSelected { source: TrustedBranchBootIdentity } => false
      _ => true
    }
}

// RED: MAIN IS UNCHANGED. The reviewed default branch keeps the dedicated boot identity and still needs
// no grant, exactly as the 2026-09-23/25 rulings left it -- the new rows did not touch it.
// MAIN IS UNCHANGED, and the roster buys nothing there: a run ON reviewed main selects the dedicated
// boot identity even when the branch name it carries is a rostered one.
test fn main_boot_still_selects_the_dedicated_identity() -> Bool {
  match select_boot_credential_source_at_ref(on_reviewed_main: true, branch: trusted_boot_branch()) {
    BootCredentialSourceSelected { source: s } => match s { TrustedBranchBootIdentity => false  _ => true }
    BootCredentialSourceRefused { cause: _ } => false
  }
}

// RED: A DIFFERENT MODE ON THE SAME BRANCH STILL NEEDS ITS GRANT. This is the scope the brief drew --
// mtcollins1_boot only. Read at the rostered ref, every other run-scoped mode must still be eligible for
// a per-run grant, because the only credential the roster opens is the boot's.
test fn another_mode_at_the_rostered_ref_still_needs_its_grant() -> Bool {
  // THE BOOT ALONE DROPS ITS GRANT AT THE ROSTERED REF -- and only once the reader key exists. Asked on
  // both sides, because eligibility reaches the boot's selection and the selection depends on the reader
  // key: a one-sided claim here would also be satisfied by a rule that never required a grant for this mode.
  match run_scoped_mode_eligible_with(state: Unminted, mode: mtcollins1_boot_mode_name as String, branch: trusted_boot_branch()) {
    Present { value: _ } => true
    Absent => false
  }
    && match run_scoped_mode_eligible_with(state: minted_reader_state(), mode: mtcollins1_boot_mode_name as String, branch: trusted_boot_branch()) {
      Absent => true
      Present { value: _ } => false
    }
    // ...and every other run-scoped mode keeps the grant it already had, at that same ref
    && all(run_scoped_modes(), m => m.mode == mtcollins1_boot_mode_name
      || match run_scoped_mode_eligible(mode: m.mode as String, branch: trusted_boot_branch()) {
        Present { value: got } => got.mode == m.mode
        Absent => false
      })
}

// RED: A FORK DISPATCH IS REFUSED -- asked of the PROVIDER, not of a workflow text. A fork is a different
// NUMERIC repository identity, so the claim set it presents fails the condition before any job runs; and
// no roster entry can rescue it, because the pins are conjunctive.
test fn a_fork_dispatch_cannot_present_admissible_claims() -> Bool {
  let real = mtcollins1_boot_branch_presented_claims(branch: trusted_boot_branch(), environment: boot_environment())
  mtcollins1_boot_branch_admits(claims: real)
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "repository_id", value: "999999999"))
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "repository_owner_id", value: "999999999"))
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "event_name", value: "push"))
}

// RED: A BRANCH THAT RENAMES ITS OWN `environment:` GETS NOTHING. The boot job's environment is pinned to
// the boot federation's NAME, which comes from code -- so editing the workflow file to drop or rename the
// environment is refused by GCP, not by a step that could be deleted.
test fn a_renamed_environment_is_refused() -> Bool {
  let real = mtcollins1_boot_branch_presented_claims(branch: trusted_boot_branch(), environment: boot_environment())
  !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "environment", value: "mtcollins1-boot-but-not"))
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "environment", value: ""))
}

// RED: A BRANCH THAT IS NOT THE ROSTERED ONE PRESENTS NOTHING ADMISSIBLE, even carrying every other
// claim correctly -- the ref pin alone refuses. This is what makes the roster the permission.
test fn an_unrostered_ref_presents_nothing_admissible() -> Bool {
  let real = mtcollins1_boot_branch_presented_claims(branch: trusted_boot_branch(), environment: boot_environment())
  !mtcollins1_boot_branch_admits(claims: with_presented_value(
    claims: real,
    claim: "ref",
    value: mtcollins1_boot_trusted_branch_ref(branch: concat(trusted_boot_branch(), "-lookalike")),
  ))
}

// RED: A JOB THAT IS NOT THE FLEET-CONVERGE WORKFLOW IS REFUSED, whatever ref it sits on. The condition
// pins the workflow file itself, so a new workflow on the rostered branch cannot borrow this identity.
test fn a_different_workflow_file_is_refused() -> Bool {
  let real = mtcollins1_boot_branch_presented_claims(branch: trusted_boot_branch(), environment: boot_environment())
  !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "workflow_ref", value: ".github/workflows/anything-else.yml"))
}

// RED: THE APPROVAL-FREE ROUTE IS COUNTED IN THE CENSUS, and counted as CONFORMING. A credential seam
// that no census row names is the shape of every bypass this repo has been burned by; the row also
// carries the classification against one_approval_route_for_every_privileged_action.
// THE CENSUS ROW, ON BOTH SIDES OF THE MINT -- and this is where the first version was simply wrong. It
// demanded Conforms today, and today the row CANNOT conform: the route is closed (the reader key is
// unminted), so its workload identity is unbindable and the selection algebra returns
// PatternSelectionNeedsEvidence, which site_conformance reports as SiteNotDecidable. Demanding Conforms was
// demanding that the census bless a route that does not exist -- the mirror image of the rung inflation this
// PR exists to remove.
//
// WHAT IS TRUE INSTEAD, AND ASSERTED IN BOTH DIRECTIONS: the row is not decidable exactly while the route is
// closed, and it conforms once the mint lands. NEVER Diverges, in either state: a divergence would mean the
// realized credential is not what the selected pattern authorizes. The post-mint half asks the selection
// algebra directly (select_authorization_pattern over the effect built with the minted state, then
// site_conformance against the row's own realized field) rather than pretending site_verdict can see a
// world it cannot.
fn branch_boot_census_rows() -> List<PrivilegedEffectSite> {
  filter(privileged_effect_census, candidate => (candidate.site.decl_name as String) == "branch_boot_credential_effect_approval_free")
}

// TODAY'S VERDICT: not decidable, and only for the reason the route is shut.
fn branch_boot_verdict_today_is_honest() -> Bool {
  match branch_boot_census_rows().first() {
    Absent => false
    Present { value: row } => match site_verdict(row: row).conformance {
      SiteNotDecidable { standing: _ } => mtcollins1_boot_branch_route_is_closed_until_the_reader_key_is_minted()
      Conforms => !mtcollins1_boot_branch_route_is_closed_until_the_reader_key_is_minted()
      Diverges => false
      DivergesWithReason { reason: _ } => false
    }
  }
}

// POST-MINT VERDICT: the same row and the same realized field, now conforming.
fn branch_boot_verdict_post_mint_conforms() -> Bool {
  match branch_boot_census_rows().first() {
    Absent => false
    Present { value: row } => match site_conformance(
      row: row,
      selection: select_authorization_pattern(e: branch_boot_credential_effect_approval_free_over(state: minted_reader_state()))
    ) {
      Conforms => true
      SiteNotDecidable { standing: _ } => false
      Diverges => false
      DivergesWithReason { reason: _ } => false
    }
  }
}

test fn the_branch_boot_credential_is_censused_and_conforms() -> Bool {
  branch_boot_census_rows().length() == 1
    && branch_boot_verdict_today_is_honest()
    && branch_boot_verdict_post_mint_conforms()
}

// ...AND IT CHANGES NO EXISTING VERDICT: the two boot-credential rows and the actuation row keep their
// own effects and their own discharges, so the branch route did not quietly re-authorize the act.
test fn the_branch_boot_row_adds_no_new_discharge() -> Bool {
  // the branch row discharges nothing of its own...
  all(filter(privileged_effect_census, r => (r.site.decl_name as String) == "branch_boot_credential_effect_approval_free"), r =>
    r.effect.witness_discharge == NoWitnessDischarge
    // ...and it never diverges, in either state of the route
    && match site_verdict(row: r).conformance {
      Diverges => false
      DivergesWithReason { reason: _ } => false
      Conforms => true
      SiteNotDecidable { standing: _ } => mtcollins1_boot_branch_route_is_closed_until_the_reader_key_is_minted()
    })
    && census_boot_credential_effect_conforms(decl_name: "boot_credential_effect_on_reviewed_main")
    && census_boot_credential_effect_conforms(decl_name: "boot_credential_effect_off_reviewed_main")
}

// THE WAIT IS SKIPPED, AND THAT SKIP IS ADMITTED -- at the rostered ref, for the boot only. Before
// Change 2 a skipped wait off main was always an unauthorized boot; the class-level question still says
// that (most branches DO need the grant), so the ref-aware admission is what makes this route legal
// instead of a hole. Failure and cancellation are never admitted, at any ref.
test fn the_approval_free_boot_admits_a_skipped_wait() -> Bool {
  // POST-MINT, at the rostered ref: the skip the rendered pipeline performs is admitted, and so is a
  // successful wait.
  fleet_converge_grant_wait_admits_at_ref_with(state: minted_reader_state(), mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitSkipped)
    && fleet_converge_grant_wait_admits_at_ref_with(state: minted_reader_state(), mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitSucceeded)
    // CLOSED TODAY at that same ref: no skip is admitted. A shut route does not make the boot
    // approval-free -- it keeps the grant wait, and a pipeline that skipped there is a run missing its
    // authorization. This is the conjunct a rule admitting skips unconditionally would fail, which is why
    // the claim asks both sides instead of only the flattering one.
    && !fleet_converge_grant_wait_admits_at_ref_with(state: Unminted, mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitSkipped)
    && fleet_converge_grant_wait_admits_at_ref_with(state: Unminted, mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitSucceeded)
    // A HALF-MINTED KEY IS NOT A MINT: no skip on that either.
    && !fleet_converge_grant_wait_admits_at_ref_with(state: half_minted_reader_state(), mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitSkipped)
    && !fleet_converge_grant_wait_admits_at_ref(mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitFailed)
    && !fleet_converge_grant_wait_admits_at_ref(mode: MtCollins1Boot, branch: trusted_boot_branch(), result: GrantWaitCancelled)
    // an unrostered branch keeps the OLD admission: no grant, no boot
    && !fleet_converge_grant_wait_admits_at_ref(mode: MtCollins1Boot, branch: concat(trusted_boot_branch(), "-not-rostered"), result: GrantWaitSkipped)
    // and a different mode AT THE ROSTERED REF keeps the old admission. HetznerCloudServerRead is chosen
    // because the measurement says it genuinely requires the grant off main (run_scoped_modes:
    // MainUsesGrantedAccount); HostResetReturn was the earlier choice and it passed vacuously, since it
    // has no row in that table and so never waits anywhere.
    && !fleet_converge_grant_wait_admits_at_ref(mode: HetznerCloudServerRead, branch: trusted_boot_branch(), result: GrantWaitSkipped)
}

// ══ THE ENVIRONMENT STANDING CANNOT BE REMOVED WITHOUT SHUTTING THE ROUTE DOWN (side-chat
// REQUEST_CHANGES on 18c3e1d0, merry-fox-82, §5 fail-open) ═════════════════════════════════════
// The defect: mtcollins1_boot_branch_claim_pins matched over the boot identity's environment and its
// Absent arm returned the pin list WITHOUT the environment conjunct. So losing the environment standing
// made the converged provider LESS restrictive -- a job in no environment at all would have reached the
// approval-free boot identity. It mattered that the guard lived in the pins and not in the federation:
// the provider is built from claim_pins() directly, NOT through the guarded federation, so a federation
// guard alone would have left the provisioned provider admitting more than the federation describes.

// THE ENVIRONMENT CONJUNCT IS PRESENT, in both projections, unconditionally. Counted rather than
// illustrated: the pins are the membership rule and the CEL is a fold over them.
test fn the_environment_conjunct_is_never_droppable() -> Bool {
  let pins = mtcollins1_boot_branch_claim_pins()
  let named_environment: List<OidcClaimPin> = filter(pins, pin => (pin.claim as String) == "environment")
  // THE BODY MUST START WITH A PRIMARY EXPRESSION: a leading '&&' here is parsed as a continuation of
  // the let's own initializer, which makes named_environment undefined inside its own definition.
  // exactly one, and it is the poisoned-by-default pin
  named_environment.length() == 1
  && match named_environment.first() {
    Present { value: p } => p.value == mtcollins1_boot_trusted_environment_pin().value
    Absent => false
  }
  && string_contains(s: mtcollins1_boot_branch_attribute_condition(), pattern: "assertion.environment")
  // THE CONDITION GCP STORES, not just the list it is folded from: dropping the pin would remove this
  // conjunct from the CEL itself, which is the fail-open the review named. Asserted on the stored
  // provider, because that is the object converge creates -- and asserted as an EQUALITY ON THE
  // ENVIRONMENT CONJUNCT (the whole 'assertion.environment == ...' term), not on the condition's
  // equality to itself through the same function, which would be tautological.
  && match mtcollins1_boot_branch_provider().attribute_condition {
    Present { value: c } =>
      string_contains(s: c, pattern: mtcollins1_boot_environment_conjunct())
      // every other conjunct survives too: the condition is a fold, so one term per pin
      && pins.length() == split(s: c, delimiter: " && ").length()
    Absent => false
  }
}

// THE ENVIRONMENT CONJUNCT, spelled the way claim_pin_cel spells it (oidc_claim_pins:70-77):
// `assertion.<claim> == '<value>'`. Derived from the pin rather than hardcoded, so it tracks a relation
// change instead of going stale.
fn mtcollins1_boot_environment_conjunct() -> String {
  let p = mtcollins1_boot_trusted_environment_pin()
  concat("assertion.", p.claim as String, " == '", p.value, "'")
}

// THE RED THE REVIEW REQUIRED: removing the environment standing CANNOT produce a provider that admits a
// branch boot. Stated the way it has to be stated -- a boot that presents NO environment claim is refused
// outright. That is precisely the claim set the old `Absent => base` arm admitted, because a pin list
// without an environment conjunct is satisfied by a token that never mentions one.
test fn a_boot_presenting_no_environment_is_refused() -> Bool {
  let real = mtcollins1_boot_branch_presented_claims(branch: trusted_boot_branch(), environment: boot_environment())
  mtcollins1_boot_branch_admits(claims: real)
    // the exact fail-open: same claims, environment standing removed
    && !mtcollins1_boot_branch_admits(claims: without_presented_claim(claims: real, claim: "environment"))
    // and the same for every other environment-shaped value: nothing but the pinned name admits
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "environment", value: ""))
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "environment", value: "__GUNBC_MTCOLLINS1_BOOT_NO_ENVIRONMENT__"))
    // and the pinned name itself ADMITS, so the refusals above are about the pin and not about a
    // broken comparison: the environment the boot federation declares (managed_host_boot_federation's
    // own names.environment) is the one value that passes
    && mtcollins1_boot_branch_admits(claims: with_presented_value(
      claims: real, claim: "environment", value: boot_environment()))
    // a near-miss on that name is refused, which is what an equality pin must do and a prefix pin would not
    && !mtcollins1_boot_branch_admits(claims: with_presented_value(claims: real, claim: "environment", value: concat(boot_environment(), "-else")))
}

// THE ROUTE IS NOT DECLARED WHEN THE BOOT IDENTITY CANNOT NAME ITS ENVIRONMENT. The federation returns
// none, so it is not a converge target and no provider is created -- the failure is the absence of the
// route, never a wider route. Asserted alongside the pin poison so both halves are held: the pins refuse
// AND the federation declines to exist.
// THE PIN FOLLOWS THE ENVIRONMENT STANDING AND NOTHING ELSE -- stated as an equivalence, which is what the
// first version of this claim got wrong. It branched on whether the ROUTE exists and, in the absent arm,
// demanded the poison pin; but the route is closed today for a different reason entirely (the reader key is
// unminted), so the claim asserted that the environment had vanished whenever some other conjunct was
// missing. That is not a law about the environment, and it would have gone red for reasons unrelated to the
// fail-open it exists to catch.
//
// THE EQUIVALENCE IS THE HONEST SHAPE: the pin is the poison value exactly when the boot identity cannot
// name its environment. Whether a federation is being built at all, and whether the reader key is minted,
// are separate questions with their own claims. And because the PROVIDER is folded from the same pin list
// (mtcollins1_boot_branch_provider reads mtcollins1_boot_branch_claim_pins directly, as does the workflow
// renderer), the stored CEL carries the environment conjunct exactly when the pin is not the poison -- which
// is the §5 property the review asked for: removing the environment standing cannot leave a provider that
// admits a branch boot.
fn branch_boot_environment_is_nameable() -> Bool {
  match mtcollins1_boot_trusted_environment() {
    Present { value: _ } => true
    Absent => false
  }
}

// (1) the pin tracks the standing, in BOTH directions
fn branch_boot_environment_pin_tracks_the_standing() -> Bool {
  (mtcollins1_boot_trusted_environment_pin().value == "__GUNBC_MTCOLLINS1_BOOT_NO_ENVIRONMENT__")
    == !branch_boot_environment_is_nameable()
}

// (2) the stored provider condition carries the environment term exactly when the standing exists
fn branch_boot_provider_condition_tracks_the_standing() -> Bool {
  match mtcollins1_boot_branch_provider().attribute_condition {
    Present { value: c } =>
      branch_boot_environment_is_nameable() == string_contains(s: c, pattern: boot_environment())
        && string_contains(s: c, pattern: "environment")
    Absent => false
  }
}

// (3) and a federation that DOES exist says the same thing about its own condition
fn branch_boot_federation_condition_tracks_the_standing() -> Bool {
  match mtcollins1_boot_branch_federation() {
    Present { value: f } =>
      f.attribute_condition == mtcollins1_boot_branch_attribute_condition()
        && string_contains(s: f.attribute_condition, pattern: boot_environment())
        && branch_boot_environment_is_nameable()
    Absent => true
  }
}

test fn an_unnameable_environment_leaves_no_federation_and_a_poisoned_pin() -> Bool {
  branch_boot_environment_pin_tracks_the_standing()
    && branch_boot_provider_condition_tracks_the_standing()
    && branch_boot_federation_condition_tracks_the_standing()
  // (4) THE POINT OF IT ALL, INDEPENDENT OF WHAT ELSE IS CLOSED: with the environment conjunct poisoned,
  // no presented claim set admits -- including one that presents the real environment name.
  && !mtcollins1_boot_branch_admits(claims: mtcollins1_boot_branch_presented_claims(
    branch: trusted_boot_branch(), environment: "__GUNBC_MTCOLLINS1_BOOT_NO_ENVIRONMENT__"))
}

// ── THE BRANCH ACCOUNT HOLDS NO FLEET-WIDE CREDENTIAL (review 87197) ──────────────────────────
// WHAT THE POLICY LOOKS LIKE ON THE FAR SIDE OF THE MINT. The reader secret at a concrete version is the
// ONLY difference from the standing today, which is version "pending" -- so this is the minted credential
// #15329 will install, constructed rather than read, because reading it would hand back the unminted
// standing and the claim would prove nothing about the state it is meant to describe.
// THE MINT'S RECEIPT, AS THE STATE TYPE REQUIRES IT. BootMediumReaderKeyState.Minted demands a pinned
// version WITH a content hash, the public half and its fingerprint -- all four, because that is what
// gunbc.host.boot_medium_reader_key says lands together. Constructing the hash goes through
// std.content_hash.sha256_hex_digest rather than a literal, per that module's construction wall; the digest
// is a stand-in for the one the mint will read out of the store, and no claim below depends on its value,
// only on the state being Minted. The public key material is likewise a shape stand-in: what is asserted is
// WHICH CELLS the branch policy holds, not the cryptographic validity of a key that does not exist yet.
fn minted_reader_state() -> BootMediumReaderKeyState {
  match sha256_hex_digest(hex: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
    Absent => Unminted
    Present { value: d } => Minted {
      reference: SecretRef {
        project: boot_medium_reader_ssh_privkey_secret.project,
        secret: boot_medium_reader_ssh_privkey_secret.secret,
        version: "1" as NonEmptyStr,
        hash_state: HashKnown { content_hash: Sha256Hash(d) },
      },
      public_key: SshPublicKey {
        algorithm: Ed25519,
        material: "AAAAC3NzaC1lZDI1NTE5AAAAIPlaceholderForTheMintedReaderPublicKeyShape000" as NonEmptyStr,
        comment: "gunbc-boot-medium-reader" as NonEmptyStr,
      },
      fingerprint: "SHA256:0000000000000000000000000000000000000000000" as NonEmptyStr,
    }
  }
}

// A MINT THAT LANDED PART OF ITS RECEIPT: a pinned version and hash, no public half. Not a hypothetical --
// it is the state a partially-applied converge leaves, and the route has to answer it distinctly.
fn half_minted_reader_state() -> BootMediumReaderKeyState {
  match sha256_hex_digest(hex: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
    Absent => Unminted
    Present { value: d } => HalfMinted {
      why: "witness fixture: a pinned version with no public half" as NonEmptyStr,
    }
  }
}

fn branch_grant_secrets(grants: List<SecretAccessGrant>) -> List<String> {
  map(grants, g => g.target.secret as String)
}

// THE BLOCKING FINDING, FIXED AND HELD. An earlier draft mirrored the boot federation's own secret grants
// onto the branch account. One of those cells is the fleet automation private key -- a single key that
// authenticates as the automation principal against EVERY enrolled host -- and the branch identity is one
// that unreviewed branch code can federate at will, because the workflow_ref pin is a heads-prefix
// starts_with and the environment is declared in the file the branch edits. Mirroring therefore handed
// fleet-wide reach to anyone with branch push, while the census row recorded the reach as
// resource-scoped: a rung reported above the evidence that established it (DESIGN.md §4b).
//
// ASKED FROM BOTH SIDES SO IT CANNOT PASS BY ACCIDENT: the fleet key must be ABSENT from the branch
// policy and PRESENT in the boot's -- if someone re-mirrors f.secret_grants, or "helpfully" adds the fleet
// key because the main boot holds it, the second half fails instead of converging quietly.
test fn the_branch_policy_never_holds_the_fleet_automation_key() -> Bool {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    // an unprovisioned boot identity means there is nothing to narrow FROM, so the narrowing claim has no
    // subject; it fails rather than passing vacuously over an absent federation.
    Absent => false
    Present { value: f } =>
  let branch_secrets = branch_grant_secrets(grants: mtcollins1_boot_branch_secret_grants_with(f: f, state: minted_reader_state()))
  let boot_secrets = branch_grant_secrets(grants: f.secret_grants)
  let fleet_key = fleet_automation_ssh_privkey_secret.secret as String
  // the narrowing itself
  filter(branch_secrets, sec => sec == fleet_key).length() == 0
    // ...and it is a narrowing: the boot really does hold that key, so the claim above is not vacuous
    && filter(boot_secrets, sec => sec == fleet_key).length() > 0
    // the branch policy is exactly the two cells that were ruled, nothing else
    && branch_secrets.length() == 2
    && all(branch_secrets, sec =>
      sec == (mtcollins1_boot_branch_bmc_secret_id as String)
        || sec == (boot_medium_reader_ssh_privkey_secret.secret as String))
  }
}

// THE BMC CELL IS INHERITED, NOT RE-DERIVED: same secret, same pinned version, same condition. A rotation
// moves both identities together, and a branch boot cannot read an unpinned or older version. Matched BY
// SECRET ID -- an index-0 grab would become a silent fleet-key handover the first time someone reorders
// the boot federation's cells, which is exactly the failure this section exists to close.
test fn the_bmc_cell_is_the_boot_federations_own() -> Bool {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    Absent => false
    Present { value: f } => match mtcollins1_boot_branch_bmc_grant(f: f) {
    Absent => false
    Present { value: g } =>
      (g.target.secret as String) == (mtcollins1_boot_branch_bmc_secret_id as String)
        && filter(f.secret_grants, b => (b.target.secret as String) == (g.target.secret as String)
          && (b.target.version as String) == (g.target.version as String)).length() > 0
    }
  }
}

// CLOSED TODAY, AND THE REFUSAL NAMES THE REASON. The route is not provisioned while the reader key is
// unminted: no pool, no provider, no service account, and the selection refuses. This is the fail-closed
// state the manager ruled for (option A, 2026-10-29) -- the alternative was a branch boot that advertises
// a readback it cannot perform and then refuses at the evidence step, which reports a capability the
// executed evidence does not establish.
test fn the_branch_route_is_closed_until_the_reader_key_is_minted() -> Bool {
  match mtcollins1_boot_branch_federation() {
    Present { value: _ } => false
    Absent =>
      // nothing is converged for a route that does not exist
      match mtcollins1_boot_branch_reader_grant() { Absent => true  Present { value: _ } => false }
        // and the refusal is actionable: it names the missing credential and the change that installs it
        && match mtcollins1_boot_branch_route_refusal_cause() {
             Present { value: cause } =>
               string_contains(s: cause as String, pattern: "reader key")
                 && string_contains(s: cause as String, pattern: "#15329")
             Absent => false
           }
  }
}

// THE MINT IS THE ONLY GATE. Same builder, same pins, same account -- the reader credential is the sole
// input that decides whether the route exists. Asserted from both sides in one claim, because a route that
// was closed by something ELSE as well would pass a one-sided version of this.
test fn the_reader_mint_is_the_only_thing_that_opens_the_route() -> Bool {
  match mtcollins1_boot_branch_federation_with(state: minted_reader_state()) {
    Absent => false
    Present { value: fed } =>
      // the policy it converges is the narrowed one, not the boot's
      filter(branch_grant_secrets(grants: fed.secret_grants), sec => sec == (fleet_automation_ssh_privkey_secret.secret as String)).length() == 0
        && fed.secret_grants.length() == 2
        // with no reader credential the very same builder declares nothing at all. The match below already
        // decides the conjunct -- a Bool is not matchable, so it is not wrapped in a second match.
        && match mtcollins1_boot_branch_federation_with(state: Unminted) { Absent => true  Present { value: _ } => false }
  }
}

// A HALF-MINTED KEY DOES NOT OPEN ANYTHING, AND SAYS WHY IT IS SHUT. The state type has a third inhabitant
// precisely because "the mint ran" and "the mint is usable" are different facts: a pinned version with no
// public half is a converge that applied part of its receipt. Treating that as unminted would let a partially
// applied mint reopen a route whose credential nobody can verify; treating it as minted would converge a
// policy granting a secret whose public half is missing. It refuses, by a name that includes the state's own
// reason -- which is the difference between a typed state and the version-string tag review 87627 replaced.
test fn a_half_minted_reader_key_keeps_the_route_closed_by_its_own_reason() -> Bool {
  match mtcollins1_boot_branch_federation_with(state: half_minted_reader_state()) {
    Present { value: _ } => false
    Absent => true
  }
  && match mtcollins1_boot_branch_route_refusal_cause_with(state: half_minted_reader_state()) {
    Absent => false
    Present { value: c } =>
      string_contains(s: c, pattern: "part of its receipt")
      // the refusal carries the state's reason, not a generic sentence: mutate the why and the text moves
      && string_contains(s: c, pattern: "witness fixture")
      // and it still points at the change that finishes the mint
      && string_contains(s: c, pattern: "#15329")
  }
  // the reader cell is absent, so the policy would have been the BMC credential alone -- which is exactly
  // the incomplete policy the both-cells-or-nothing rule refuses to converge
  && match mtcollins1_boot_branch_reader_grant_over(state: half_minted_reader_state()) {
    Present { value: _ } => false
    Absent => true
  }
  // and the UNMINTED refusal is the other sentence, naming the mint rather than a partial one
  && match mtcollins1_boot_branch_route_refusal_cause_with(state: Unminted) {
    Absent => false
    Present { value: c } =>
      string_contains(s: c, pattern: "is not minted")
      && !string_contains(s: c, pattern: "part of its receipt")
  }
}

// THE PERMISSION THAT MAKES THIS ROUTE LEGAL IS A TYPED ROW, NOT A COMMENT (review 87627, DESIGN §4c and §3).
// Three links, checked as one claim because they fail together:
//   1. gunbc.design_ruling registers mtcollins1_branch_boot_is_approval_free;
//   2. its provenance carries the operator's own sentences, so the consent cannot be paraphrased away;
//   3. the census row that admits the widening names that ruling, and the census module's
//      mtcollins1_branch_boot_operator_ruling_text -- the symbol the selection's citation points at, which
//      did not exist when the review was written -- reads them out of that same row.
// Empty the ruling and this goes red; rename it and the citation check goes red; rewrite the operator's
// words into a summary and the provenance conjuncts go red. That is what makes it a carrier rather than
// prose.
fn branch_boot_ruling_rows() -> List<DesignRuling> {
  filter(design_rulings(), candidate => (candidate.reference.decl_name as String) == "mtcollins1_branch_boot_is_approval_free")
}

// THE OPERATOR'S OWN WORDS, STILL IN THE ROW. Each conjunct is one of their sentences; paraphrase the
// provenance into a summary and the conjunct it satisfies goes red.
fn branch_boot_ruling_carries_the_operators_words() -> Bool {
  match branch_boot_ruling_rows().first() {
    Absent => false
    Present { value: row } =>
      string_contains(s: row.provenance, pattern: "is not sensitive")
        && string_contains(s: row.provenance, pattern: "permission to boot it endlessly")
        && string_contains(s: row.provenance, pattern: "shouldn't need an approval")
        && string_contains(s: row.provenance, pattern: "2026-09-23")
        && string_contains(s: row.provenance, pattern: "one_approval_route_for_every_privileged_action")
        && row.decided == "2026-10-23"
  }
}

// ONE HOME FOR THE TEXT: the census module's datum -- the symbol the selection's citation names, which did
// not exist when review 87627 was written -- is that row's provenance, not a copy of it.
fn branch_boot_ruling_text_has_one_home() -> Bool {
  match branch_boot_ruling_rows().first() {
    Absent => false
    Present { value: row } => mtcollins1_branch_boot_operator_ruling_text() == row.provenance
  }
}

// THE JOIN: the census site is backed by a ruling that RESOLVES. PrivilegedEffectSite carries no prose field,
// so the association is data in the census module (SiteRulingLinkage) keyed by the site identity the row
// itself uses. This is the half that catches a citation whose home has gone missing -- exactly what the
// review found by hand, now a claim.
fn branch_boot_ruling_linkage_resolves() -> Bool {
  match site_ruling_linkage(site(module_path: "gunbc.auth.branch_dispatch_federation", decl_name: "branch_boot_credential_effect_approval_free")) {
    Absent => false
    Present { value: linkage } =>
      declaration_ref_in_list(target: linkage.ruling, refs: map(design_rulings(), candidate => candidate.reference))
        && declaration_ref_eq(a: linkage.ruling, b: mtcollins1_branch_boot_is_approval_free.reference)
  }
}

test fn the_approval_free_branch_boot_rests_on_a_typed_ruling() -> Bool {
  branch_boot_ruling_rows().length() == 1
    && branch_boot_ruling_carries_the_operators_words()
    && branch_boot_ruling_text_has_one_home()
    && branch_boot_ruling_linkage_resolves()
}

// THE WIDENING, ASSERTED WHERE IT IS TRUE -- on the far side of the mint. On a rostered ref the boot needs
// NO per-run grant; on the same ref with the route closed (today) it still does, which is what keeps the
// closed route from being a silent bypass: a branch boot that cannot get the narrowed identity falls back
// to the approval-gated grant rather than booting unattended.
test fn branch_boot_selects_the_approval_free_identity_once_the_key_is_minted() -> Bool {
  let b = trusted_boot_branch()
  // post-mint: the dedicated branch identity, and no grant required at that ref. THE BODY STARTS WITH A
  // PRIMARY ON PURPOSE -- a leading '&&' here is parsed as a continuation of the let's initializer.
  match select_boot_credential_source_at_ref_with(state: minted_reader_state(), on_reviewed_main: false, branch: b) {
       BootCredentialSourceSelected { source: TrustedBranchBootIdentity } =>
         !boot_grant_required_at_ref_with(state: minted_reader_state(), on_reviewed_main: false, branch: b)
       _ => false
     }
  // today (route closed): the same ref still requires the grant -- closed means degraded to the old route,
  // never means approved-free by accident
  && boot_grant_required_at_ref_with(state: Unminted, on_reviewed_main: false, branch: b)
}
