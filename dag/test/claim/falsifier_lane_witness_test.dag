module test.claim.falsifier_lane_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data falsifier_lane_witness_grain_note: String = "Every row here is fixture-grain: hand-built enrollment lists and component rows constructed through the receipt's own floor_component_row_of, never a scan of the live tree and never a real cadence receipt. The live-plan half — that the falsifier schedule and the lane attribution stay derived from one enrollment list — is proven in src/v2/test/claim/falsifier_lane_plan_agreement_test.dag, which reaches the plan module and carries its own disposition. Keeping the two apart is the Class C split: a stamp is file-grain, so a file mixing fixture algebra with a live-plan read would have to take the fail-closed value and lose predict-skip eligibility for rows that genuinely do not read the tree."

test fn falsifier_lane_planned_roster_is_enrollment_ordered() -> Bool {
  witness_planned_components_skip_unenrolled_and_renumber()
    && witness_lane_names_are_distinct()
}

test fn falsifier_run_standing_is_an_identity_join() -> Bool {
  witness_standing_green_on_matching_plan()
    && witness_standing_reds_on_missing_component()
    && witness_standing_reds_on_surplus_component()
    && witness_standing_reds_on_duplicate_component()
    && witness_standing_fails_closed_on_empty_plan()
    && witness_standing_reds_when_counts_agree_but_identities_do_not()
}

test fn falsifier_run_standing_never_projects_to_observed() -> Bool {
  witness_complete_standing_does_not_project_to_observed()
    && witness_incomplete_standing_refuses_observed()
}

test fn falsifier_routing_attributes_or_refuses_by_named_cause() -> Bool {
  witness_routing_attributes_failing_component_to_owner()
    && witness_routing_refuses_lane_undetermined()
    && witness_routing_refuses_owner_undeclared_but_names_lane()
    && witness_routing_empty_owner_roster_still_determines_lane()
    && witness_unsuccessful_routings_exclude_done_rows()
}

data falsifier_failing_set_test_note: String = "The per-window failing-set rows. falsifier_class_signature_marks_transitions is the control for the live defect that reprioritized this lane: issue #7737 stayed open and accurate as a status while its BODY described a failure class that had stopped occurring thirty hours earlier, because nothing re-derived the failing set per window and nothing compared one window's classes to the previous one's."

test fn falsifier_failure_class_is_carried_per_component() -> Bool {
  witness_failure_class_separates_budget_from_witness_red()
    && witness_failure_class_records_the_infra_collapse()
    && witness_failing_set_names_lane_and_class_per_component()
}

test fn falsifier_class_signature_marks_transitions() -> Bool {
  witness_class_signature_distinguishes_a_class_transition()
    && witness_class_signature_stable_when_class_persists()
}
