module test.claim.cache_key_completeness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_module: String = "test.claim.cache_key_completeness"

fn witness_cav_toolchain_derives_transform() -> Bool {
  let inputs = extdeps.cache.types.content_addressed_inputs(triggers: [std.cache_interface.ToolchainChange, std.cache_interface.ManualPurge])
  extdeps.cache.types.catalog_has_vendor_only_key_inputs(inputs: inputs) && (inputs.length() == 2)
}

fn witness_cav_no_toolchain_derives_subject_only() -> Bool {
  let inputs = extdeps.cache.types.content_addressed_inputs(triggers: [std.cache_interface.ManualPurge])
  !extdeps.cache.types.catalog_has_vendor_only_key_inputs(inputs: inputs) && (inputs.length() == 1)
}

fn witness_live_resolved_graph_derives_toolchain() -> Bool {
  let inputs = extdeps.cache.types.catalog_inputs_considered(kd: extdeps.realization.resolved_graph.resolved_graph_cache_facts.key_derivation)
  extdeps.cache.types.catalog_has_vendor_only_key_inputs(inputs: inputs) && (inputs.length() == 2)
}

fn sound_cited_facts() -> extdeps.cache.types.CatalogKeyDerivationFacts {
  extdeps.cache.types.CatalogKeyDerivationFacts {
    key_inputs: extdeps.cache.types.NativeInternal { cited_inputs: [extdeps.cache.types.RustcInvocation, extdeps.cache.types.ToolchainSpec] },
    overwritable: false,
    prefix_fallback_allowed: false,
    content_verified_on_read: true,
    visibility_scope: Org,
    invalidation_triggers: [std.cache_interface.ToolchainChange, std.cache_interface.ManualPurge],
  }
}

fn undercited_native_facts() -> extdeps.cache.types.CatalogKeyDerivationFacts {
  extdeps.cache.types.CatalogKeyDerivationFacts {
    key_inputs: extdeps.cache.types.NativeInternal { cited_inputs: [extdeps.cache.types.UpsertSubject] },
    overwritable: false,
    prefix_fallback_allowed: false,
    content_verified_on_read: true,
    visibility_scope: Org,
    invalidation_triggers: [std.cache_interface.ToolchainChange, std.cache_interface.ManualPurge],
  }
}

fn hand_authored_facts() -> extdeps.cache.types.CatalogKeyDerivationFacts {
  extdeps.cache.types.CatalogKeyDerivationFacts {
    key_inputs: extdeps.cache.types.HandAuthored { cited_inputs: [extdeps.cache.types.UpsertSubject] },
    overwritable: false,
    prefix_fallback_allowed: false,
    content_verified_on_read: true,
    visibility_scope: Org,
    invalidation_triggers: [std.cache_interface.ToolchainChange, std.cache_interface.ManualPurge],
  }
}

fn no_promise_native_facts() -> extdeps.cache.types.CatalogKeyDerivationFacts {
  extdeps.cache.types.CatalogKeyDerivationFacts {
    key_inputs: extdeps.cache.types.NativeInternal { cited_inputs: [extdeps.cache.types.UpsertSubject] },
    overwritable: false,
    prefix_fallback_allowed: false,
    content_verified_on_read: true,
    visibility_scope: Org,
    invalidation_triggers: [std.cache_interface.ManualPurge],
  }
}

fn witness_complete_green_on_sound_cited() -> Bool {
  extdeps.cache.key_completeness.cache_key_derivation_complete(facts: sound_cited_facts())
}

fn witness_complete_red_on_undercited() -> Bool {
  !extdeps.cache.key_completeness.cache_key_derivation_complete(facts: undercited_native_facts())
}

fn witness_verdict_holds_on_sound_cited() -> Bool {
  match v2.extdeps.cache.key_completeness_verdict.cache_key_completeness_verdict(facts: sound_cited_facts(), module_name: witness_module) {
    Holds => true
    _ => false
  }
}

fn witness_verdict_violation_on_undercited() -> Bool {
  match v2.extdeps.cache.key_completeness_verdict.cache_key_completeness_verdict(facts: undercited_native_facts(), module_name: witness_module) {
    v2.std.lens_verdict.Violation { diagnostic: _ } => true
    _ => false
  }
}

fn witness_hand_authored_exempt() -> Bool {
  extdeps.cache.key_completeness.cache_key_derivation_complete(facts: hand_authored_facts())
}

fn witness_native_not_exempt() -> Bool {
  !extdeps.cache.key_completeness.cache_key_derivation_complete(facts: undercited_native_facts())
}

fn witness_no_promise_complete() -> Bool {
  extdeps.cache.key_completeness.cache_key_derivation_complete(facts: no_promise_native_facts())
}

fn witness_promise_without_input_incomplete() -> Bool {
  !extdeps.cache.key_completeness.cache_key_derivation_complete(facts: undercited_native_facts())
}

fn witness_live_catalog_holds() -> Bool {
  extdeps.cache.key_completeness.cache_catalog_key_completeness_holds(catalog: extdeps.cache.cache.cache_catalog)
}

fn witness_live_resolved_graph_complete() -> Bool {
  extdeps.cache.key_completeness.cache_key_derivation_complete(facts: extdeps.realization.resolved_graph.resolved_graph_cache_facts.key_derivation)
}

test fn cache_key_completeness_witnesses() -> Bool {
  witness_cav_toolchain_derives_transform()
    && witness_cav_no_toolchain_derives_subject_only()
    && witness_live_resolved_graph_derives_toolchain()
    && witness_complete_green_on_sound_cited()
    && witness_complete_red_on_undercited()
    && witness_verdict_holds_on_sound_cited()
    && witness_verdict_violation_on_undercited()
    && witness_hand_authored_exempt()
    && witness_native_not_exempt()
    && witness_no_promise_complete()
    && witness_promise_without_input_incomplete()
    && witness_live_catalog_holds()
    && witness_live_resolved_graph_complete()
}
