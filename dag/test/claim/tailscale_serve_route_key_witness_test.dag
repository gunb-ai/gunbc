module test.claim.tailscale_serve_route_key_witness


type RetiredFlattenedServeFlagsKeyRelation
type TailscaleEnableArgvIdentityKeyRelation
type GlobalCollapseDemonstrationRelation

type TailscaleServeRouteMemberAt = std.key_relation.ScopedKey<TailscaleServeRouteKeyRelation, TailscaleServeScope, TailscaleServeRouteKey>

type TailscaleEnableArgvMemberAt = std.key_relation.ScopedKey<TailscaleEnableArgvIdentityKeyRelation, std.key_relation.GlobalKeyScope, std.types.NonEmptyStr>

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data tailscale_route_key_witness_note: String = "Step-1 discriminating controls for extdeps.tailscale.serve TailscaleServeRouteKey. The load-bearing law: same listener x mount + different backend is a re-point (Modified), never Remove+Add. A key that embeds backend classifies that drift as different keys and produces teardown+reinstall — the membership_reconcile failure mode the design note names."

fn tailscale_route_subject(endpoint: extdeps.tailscale.serve.TailscaleServeEndpoint) -> extdeps.tailscale.serve.TailscaleServeRouteSubject {
  tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv1_tailscale_endpoint),
    endpoint: endpoint,
  )
}

fn tailscale_endpoint_value_eq(a: extdeps.tailscale.serve.TailscaleServeRouteSubject, b: extdeps.tailscale.serve.TailscaleServeRouteSubject) -> Bool {
  a.endpoint.https_port == b.endpoint.https_port
    && tailscale_serve_mount_eq(a: a.endpoint.mount, b: b.endpoint.mount)
    && a.endpoint.backend as String == b.endpoint.backend as String
}

fn tailscale_endpoint_ownership(_: extdeps.tailscale.serve.TailscaleServeRouteSubject) -> gunbc.ownership.Ownership? {
  Present { value: gunbc.ownership.Owned }
}

fn retired_flattened_serve_flags_key(subject: extdeps.tailscale.serve.TailscaleServeRouteSubject) -> std.types.NonEmptyStr {
  join(tailscale_serve_endpoint_flags(endpoint: subject.endpoint), " ") as std.types.NonEmptyStr
}

fn retired_flattened_serve_flags_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> std.types.Bool {
  a as String == b as String
}

data retired_flattened_serve_flags_key_relation: KeyRelation<RetiredFlattenedServeFlagsKeyRelation, TailscaleServeRouteSubject, GlobalKeyScope, NonEmptyStr> = key_relation_global(
  key_of: retired_flattened_serve_flags_key,
  key_eq: retired_flattened_serve_flags_key_eq,
)

fn tailscale_enable_argv_identity_key(subject: extdeps.tailscale.serve.TailscaleServeRouteSubject) -> std.types.NonEmptyStr {
  join(tailscale_serve_enable_argv(endpoint: subject.endpoint), " ") as std.types.NonEmptyStr
}

fn tailscale_enable_argv_identity_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> std.types.Bool {
  a as String == b as String
}

data tailscale_enable_argv_identity_key_relation: KeyRelation<TailscaleEnableArgvIdentityKeyRelation, TailscaleServeRouteSubject, GlobalKeyScope, NonEmptyStr> = key_relation_global(
  key_of: tailscale_enable_argv_identity_key,
  key_eq: tailscale_enable_argv_identity_key_eq,
)

fn plan_has_change_between_backends(
  plan: gunbc.membership_reconcile.MembershipPlan<extdeps.tailscale.serve.TailscaleServeRouteSubject, TailscaleServeRouteMemberAt>,
  from_backend: String,
  to_backend: String,
) -> std.types.Bool {
  any(plan.actions, a =>
    match a {
      MemberChanged { at: _, from: f, to: t } =>
        f.endpoint.backend as String == from_backend && t.endpoint.backend as String == to_backend
      _ => false
    }
  )
}

fn plan_has_remove_add_not_change(plan: gunbc.membership_reconcile.MembershipPlan<extdeps.tailscale.serve.TailscaleServeRouteSubject, TailscaleEnableArgvMemberAt>) -> Bool {
  let has_remove = any(plan.actions, a => match a { MemberRemoved { at: _, from: _ } => true  _ => false })
  let has_add = any(plan.actions, a => match a { MemberAdded { at: _, to: _ } => true  _ => false })
  let has_change = any(plan.actions, a => match a { MemberChanged { at: _, from: _, to: _ } => true  _ => false })
  has_remove && has_add && !has_change
}

fn root_endpoint(backend: String) -> extdeps.tailscale.serve.TailscaleServeEndpoint {
  extdeps.tailscale.serve.TailscaleServeEndpoint {
    https_port: 443,
    mount: extdeps.tailscale.serve.ServeRootMount,
    backend: backend as std.types.NonEmptyStr,
  }
}

data w_route_key_backend_repoint_note: String = "THE STEP-1 POSITIVE CONTROL. Same listener x mount, different backend: TailscaleServeRouteKey is unchanged, so membership_reconcile must emit exactly one MemberChanged carrying both sides — a re-point, not teardown+reinstall."

test fn w_route_key_backend_repoint_is_modified_not_remove_add() -> Bool {
  let observed = [tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))]
  let desired = [tailscale_route_subject(endpoint: root_endpoint(backend: "18081"))]
  let plan = membership_plan_admitting_scoped_outcome(
    outcome: membership_reconcile_scoped(
      desired: desired,
      observed: observed,
      resource: extdeps.tailscale.serve.tailscale_serve_resource_relation,
      ownership_of: tailscale_endpoint_ownership,
    ),
  )
  plan_has_change_between_backends(plan: plan, from_backend: "8080", to_backend: "18081")
    && gunbc.membership_reconcile.membership_change_count(plan: plan) == 1
    && gunbc.membership_reconcile.membership_added_count(plan: plan) == 0
    && gunbc.membership_reconcile.membership_removal_count(plan: plan) == 0
}

fn tailscale_enable_argv_endpoint_state_of(subject: extdeps.tailscale.serve.TailscaleServeRouteSubject) -> std.types.NonEmptyStr {
  subject.endpoint.backend
}

fn tailscale_enable_argv_endpoint_state_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> std.types.Bool {
  a == b
}

data tailscale_enable_argv_resource_relation: KeyedResourceRelation<TailscaleEnableArgvIdentityKeyRelation, TailscaleServeRouteSubject, GlobalKeyScope, NonEmptyStr, NonEmptyStr> = std.key_relation.KeyedResourceRelation {
  key: tailscale_enable_argv_identity_key_relation,
  state: std.key_relation.StateRelation {
    state_of: tailscale_enable_argv_endpoint_state_of,
    state_eq: tailscale_enable_argv_endpoint_state_eq,
  },
}

data w_enable_argv_key_backend_repoint_red_note: String = "RED CONTROL for the Remove+Add failure class. Using the rendered enable argv (which includes backend) as identity makes a backend re-point look like two different members — Remove+Add with zero MemberChanged. This is the discriminating half the step-1 witness must pin; a key-equality test alone cannot catch it."

test fn w_enable_argv_key_backend_repoint_is_remove_add_not_modified() -> Bool {
  let observed = [tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))]
  let desired = [tailscale_route_subject(endpoint: root_endpoint(backend: "18081"))]
  let plan = membership_plan_admitting_scoped_outcome(
    outcome: membership_reconcile_scoped(
      desired: desired,
      observed: observed,
      resource: tailscale_enable_argv_resource_relation,
      ownership_of: tailscale_endpoint_ownership,
    ),
  )
  plan_has_remove_add_not_change(plan: plan)
    && gunbc.membership_reconcile.membership_change_count(plan: plan) == 0
    && gunbc.membership_reconcile.membership_added_count(plan: plan) == 1
    && gunbc.membership_reconcile.membership_removal_count(plan: plan) == 1
}

data w_retired_flags_key_same_route_note: String = "The deleted tailscale_serve_endpoint_key joined endpoint FLAGS only (listener + mount argv), so it did NOT trigger Remove+Add on backend drift — it shares the route key's listener x mount axis. Its defect class is argv-as-locator/path (design note 3a), not backend-as-identity. This row pins that the retired carrier is route-stable across backend re-point, so the step-1 Modified law is about structured route keys vs keys that embed mutable content (enable argv), not about flags-only flattening alone."

test fn w_retired_flags_key_is_route_stable_across_backend_repoint() -> Bool {
  let a = tailscale_route_subject(endpoint: root_endpoint(backend: "8080"))
  let b = tailscale_route_subject(endpoint: root_endpoint(backend: "18081"))
  retired_flattened_serve_flags_key(subject: a) as String
    == retired_flattened_serve_flags_key(subject: b) as String
}

test fn backend_change_preserves_route_key() -> std.types.Bool {
  let root = root_endpoint(backend: "8080")
  let repointed = root_endpoint(backend: "18081")
  extdeps.tailscale.serve.tailscale_serve_route_key_eq(
    a: extdeps.tailscale.serve.tailscale_serve_route_key(endpoint: root),
    b: extdeps.tailscale.serve.tailscale_serve_route_key(endpoint: repointed),
  )
}

test fn distinct_mounts_have_distinct_keys() -> std.types.Bool {
  let root = extdeps.tailscale.serve.tailscale_serve_route_key(endpoint: root_endpoint(backend: "8080"))
  let lab = extdeps.tailscale.serve.tailscale_serve_route_key(endpoint: extdeps.tailscale.serve.TailscaleServeEndpoint {
    https_port: 443,
    mount: extdeps.tailscale.serve.ServeSetPath { path: "/srv1-lab" as std.types.NonEmptyStr },
    backend: "18081" as std.types.NonEmptyStr,
  })
  !extdeps.tailscale.serve.tailscale_serve_route_key_eq(a: root, b: lab)
}

test fn membership_label_is_not_rendered_argv() -> std.types.Bool {
  let endpoint = extdeps.tailscale.serve.TailscaleServeEndpoint {
    https_port: 443,
    mount: extdeps.tailscale.serve.ServeSetPath { path: "/srv1-lab" as std.types.NonEmptyStr },
    backend: "18081" as std.types.NonEmptyStr,
  }
  let label = extdeps.tailscale.serve.tailscale_serve_route_key_label(key: extdeps.tailscale.serve.tailscale_serve_route_key(endpoint: endpoint)) as String
  let argv = join(extdeps.tailscale.serve.tailscale_serve_endpoint_flags(endpoint: endpoint), " ")
  label != argv
}

data w_per_device_scope_preserves_distinct_nodes_note: String = "THE SCOPE DEFECT NO EXISTING WITNESS COULD SEE. Two tailnet devices may each own the same listener×mount route; GlobalKeyScope collapses them into one ScopedKey — the identity-collapse class the twin witnesses name when one deployment's teardown deletes another's live resource. This control must go red against GlobalKeyScope and green only after TailscaleServeScope lands."

fn srv1_root_route_subject() -> extdeps.tailscale.serve.TailscaleServeRouteSubject {
  tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv1_tailscale_endpoint),
    endpoint: root_endpoint(backend: "8080"),
  )
}

fn srv2_root_route_subject() -> extdeps.tailscale.serve.TailscaleServeRouteSubject {
  tailscale_serve_route_subject(
    scope: tailscale_serve_scope(node: srv2_tailscale_endpoint),
    endpoint: root_endpoint(backend: "8080"),
  )
}

test fn w_per_device_scope_preserves_distinct_nodes_same_route() -> Bool {
  let key_a = key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: srv1_root_route_subject())
  let key_b = key_relation_scoped_key(relation: tailscale_serve_route_key_relation, subject: srv2_root_route_subject())
  !key_relation_scoped_key_eq(relation: tailscale_serve_route_key_relation, a: key_a, b: key_b)
}

fn global_collapse_route_key_of(subject: extdeps.tailscale.serve.TailscaleServeRouteSubject) -> extdeps.tailscale.serve.TailscaleServeRouteKey {
  tailscale_serve_route_key(endpoint: subject.endpoint)
}

data global_collapse_demonstration_relation: KeyRelation<GlobalCollapseDemonstrationRelation, TailscaleServeRouteSubject, GlobalKeyScope, TailscaleServeRouteKey> = key_relation_global(
  key_of: global_collapse_route_key_of,
  key_eq: tailscale_serve_route_key_eq,
)

test fn w_global_scope_collapses_distinct_nodes_same_route() -> Bool {
  let key_a = key_relation_scoped_key(relation: global_collapse_demonstration_relation, subject: srv1_root_route_subject())
  let key_b = key_relation_scoped_key(relation: global_collapse_demonstration_relation, subject: srv2_root_route_subject())
  key_relation_scoped_key_eq(relation: global_collapse_demonstration_relation, a: key_a, b: key_b)
}
