module test.claim.hosted_runner_shadow_gate_workflow_witness

// THE CLAIMS OVER THE HOSTED-RUNNER SHADOW GATE EMITTER.
//
// The shadow gate is a NON-required job admitted by the 2026-11-19 operator ruling (#gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign) and
// recorded as the roadmap node hosted-runner-shadow-gate. It is a scaffold in two ways, and each has a
// dissolution condition that belongs on the carrier (gunbc.design_argument::source_annotations: "a
// dissolution condition belongs in a typed carrier"), not only in a comment:
//   1. the run: steps assemble shell as strings -- the ctrl HAND-SHELL GATE -- pending the
//      orchestration-to-shell capability v2.workflow.bash_emit / bash_emit_stmts (#5828);
//   2. the whole job dissolves at remote-build cutover, when the fleet runs the remote build natively
//      and the v2-bootstrap required context retires.
// The precedent for naming the bash-emit capability on the artifact is
// gunbc.test.claim.runner.runner_host_medium_fleet_keys_witness
// the_boot_command_carries_its_dissolution_trigger_naming_bash_emit. These claims fail if the emitted
// YAML loses either marker, so a regeneration that silently drops them is caught.

import std.types { Bool, Int, String }
import test.fixture.text_scan { occurs_before, occurrences }
import gunbc.witness.hosted_runner_shadow_gate_workflow {
  expected_hosted_runner_shadow_gate_yml,
  ShadowGateWorkflowGenerationOutcome,
  ShadowGateWorkflowGenerated,
  ShadowGateWorkflowGenerationRefused,
}

// Present-or-not over a String, built on the claim-safe occurrences counter (same helper the
// runner_host_medium precedent witness uses).
fn contains(haystack: String, needle: String) -> Bool {
  occurrences(s: haystack, pattern: needle) > 0
}

// The emitted YAML, or false when the emitter refuses (a refusal is claimed elsewhere: the emitted
// artifact must exist for this gate to ship, and the drift watch enforces the bytes).
fn emitted_yaml_or_empty() -> String {
  match expected_hosted_runner_shadow_gate_yml() {
    ShadowGateWorkflowGenerated { content } => content
    ShadowGateWorkflowGenerationRefused { reason } => ""
  }
}

// THE HAND-SHELL GATE MARKER ON THE EMITTED CARRIER, naming the capability that replaces the strings.
test fn the_emitted_workflow_carries_its_dissolution_trigger_naming_bash_emit() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "HAND-SHELL GATE")
    && contains(haystack: rendered, needle: "DISSOLVES WHEN")
    && contains(haystack: rendered, needle: "v2.workflow.bash_emit")
    && contains(haystack: rendered, needle: "bash_emit_stmts")
    && contains(haystack: rendered, needle: "#5828")
}

// THE CUTOVER DISSOLUTION ON THE EMITTED CARRIER: the job dissolves when the fleet runs the remote
// build natively; the string carries the condition, not a comment outside the artifact.
test fn the_emitted_workflow_names_its_cutover_dissolution() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "remote-build cutover")
    && contains(haystack: rendered, needle: "shadow-gate-config")
    && contains(haystack: rendered, needle: "configured")
}

// THE FORK GUARD AND THE ARM NOTICES are the fail-closed arms: forks never federate, and every arm
// that gets no remote legs says WHY with a typed notice, never green-as-passed. Lock them on the
// artifact.
test fn the_emitted_workflow_gates_forks_and_types_the_not_configured_notice() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "pull_request")
    && contains(haystack: rendered, needle: "merge_group")
    && contains(haystack: rendered, needle: "workflow_dispatch")
    && contains(haystack: rendered, needle: "::notice::remote legs run only on workflow_dispatch")
}

// THE ARMS ARE TYPED (WIF switch; review 96834's demand retargeted): with no repository secrets to
// miss, the arms are EVENTS. A dispatch at refs/heads/main is the only configured arm (the pinned
// provider federates exactly that arm); a dispatch at any other ref and a pull_request/merge_group
// run each get their own typed notice -- a silent green on the wrong arm is what fail_closed forbids.
test fn the_emitted_workflow_arms_the_events_with_typed_notices() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "$GITHUB_EVENT_NAME")
    && contains(haystack: rendered, needle: "\"refs/heads/main\" ]; then")
    && contains(haystack: rendered, needle: "::notice::not a dispatch at refs/heads/main")
    && contains(haystack: rendered, needle: "refusing rather than pretending to shadow")
    && contains(haystack: rendered, needle: "the pinned WIF provider refuses pull_request/merge_group claims")
}

// THE EVIDENCE RE-RUN ARM. The operator ruling's evidence (receipt per run, wall time, red control)
// is captured by dispatching this workflow on demand. The emitted bytes must carry the dispatch
// trigger, its optional pattern input, and the step defaulting to the MODELLED plumbing-proof pattern
// (single authority: the default is the model's row, not a second literal).
test fn the_emitted_workflow_carries_the_dispatch_evidence_input_defaulting_to_the_model_pattern() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "workflow_dispatch:")
    && contains(haystack: rendered, needle: "pattern:")
    && contains(haystack: rendered, needle: "GUNBC_GATE_PATTERN: ${{ inputs.pattern }}")
    && contains(haystack: rendered, needle: "--arg pattern=\"")
    && contains(haystack: rendered, needle: "GUNBC_GATE_PATTERN:-//dag/test/claim/compute/host_capacity_seal_witness.dag}\"")
    && contains(haystack: rendered, needle: "--arg identity_file=$RUNNER_TEMP/remote-build-ci-ssh-key")
}

// THE PER-ROW GATE STEPS (shape agreed with gunbc.compute.remote_build_client's remote_gate_cli):
// one step per emitted_subject_build_rows row, named after the row's label, invoking remote_gate_cli
// with worktree/label/receipt_path, cat-ing the receipt on EVERY outcome, and rendering the
// instrument-law exits per the manager ruling: 1/2/3 red (with the typed 'no host admitted' text
// for 3), 4 a countable cleanup warning without failing the code verdict.
test fn the_emitted_workflow_runs_every_gate_row_with_the_agreed_exit_rendering() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "Remote gate: //gunbc/instruments:self-host")
    && contains(haystack: rendered, needle: "Remote gate: //gunbc/instruments:v2-native-cli")
    && contains(haystack: rendered, needle: "remote_gate_cli --arg worktree=$GITHUB_WORKSPACE --arg label='//gunbc/instruments:self-host'")
    && contains(haystack: rendered, needle: "remote_gate_cli --arg worktree=$GITHUB_WORKSPACE --arg label='//gunbc/instruments:v2-native-cli'")
    && contains(haystack: rendered, needle: "gate-emit_build_self_host.json")
    && contains(haystack: rendered, needle: "gate-emit_build_v2_native_cli.json")
    && contains(haystack: rendered, needle: "no host admitted the reservation (capacity/infra)'; exit 1")
    && contains(haystack: rendered, needle: "typed local refusal - nothing was sent to any host'; exit 1")
    && contains(haystack: rendered, needle: "an origin ref was left behind (cleanup fact; count these)'; exit 0")
}

// THE CREDENTIALS ARRIVE OVER WIF, NEVER FROM THE SECRETS CONTEXT. The emitted job must carry the
// pinned-provider auth step (pool/provider/SA from gunbc.auth.hosted_ci_secrets_federation), the
// fetch of BOTH Secret Manager secrets at their PINNED versions, the tailscale step wired to the
// PUBLIC client-id constant and the fetched env, and it must reference the GitHub `secrets.` context
// NOWHERE. Discriminating: reintroduce `${{ secrets.X }}` or a `latest`-version fetch and a claim here
// goes red.
test fn the_emitted_workflow_fetches_credentials_over_wif_never_from_secrets() -> Bool {
  let rendered = emitted_yaml_or_empty()
  contains(haystack: rendered, needle: "workloadIdentityPools/github-hosted-shadow-gate/providers/github-hosted-shadow-gate-oidc")
    && contains(haystack: rendered, needle: "hosted-ci-secrets@gunbai-secrets.iam.gserviceaccount.com")
    && contains(haystack: rendered, needle: "secrets/remote-build-ci-ssh-key/versions/1:access")
    && contains(haystack: rendered, needle: "secrets/tailscale-oauth-client-secret/versions/1:access")
    && contains(haystack: rendered, needle: "oauth-client-id: kNQLY8UpZK11CNTRL")
    && contains(haystack: rendered, needle: "oauth-secret: ${{ env.TS_OAUTH_SECRET }}")
    && contains(haystack: rendered, needle: "id-token: write")
    && contains(haystack: rendered, needle: "EXPECTED_FP=\"SHA256:Xy1UDMurH15SRT6Uhp5STj2YcIjPzW/OzPtEidv7ioM\"")
    // The path is set in SCRIPT (env values are literal), the secret is ::add-mask::-registered
    // before $GITHUB_ENV, and the bearer header is deleted exactly ONCE -- after both fetches
    // (review 97111: an rm between them made the OAuth curl impossible; and $GITHUB_ENV alone
    // does not mask).
    && contains(haystack: rendered, needle: "KEY_FILE=\"$RUNNER_TEMP/remote-build-ci-ssh-key\"")
    && contains(haystack: rendered, needle: "echo \"::add-mask::$VAL\"")
    && occurs_before(haystack: rendered, before: "secrets/tailscale-oauth-client-secret/versions/1:access", after: "rm -f \"$HDR_FILE\"")
    && !(contains(haystack: rendered, needle: "${{ secrets."))
}

// ONE PROVENANCE SOURCE (smart-crane-730's drift report on #16766): the "# Generated by"/
// "# Authority" lines are projected from gunbc.generated_workflow_provenance and prepended by
// gunbc.generated_artifact_emit artifact_generate at one bytes boundary. Inlining them in the
// emitted content duplicated them when main_wet regenerated — the emitted content must NOT carry
// them. Discriminating: add an inline provenance line and this claim goes red.
test fn the_emitted_content_does_not_inline_the_projected_provenance_lines() -> Bool {
  let rendered = emitted_yaml_or_empty()
  !(contains(haystack: rendered, needle: "Generated by gunbc"))
    && !(contains(haystack: rendered, needle: "# Authority: gunbc"))
}
