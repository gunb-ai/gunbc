module test.claim.fleet_fan_mint_seal_witness

import std.types { String, Bool, Int }
import std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CensusNotRunnable, CensusObserved, CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class, census_blocking_rows, census_total_count }

// THE FLEET FAN OBSERVATION MINT IS TERMINAL-SEALED. Each probe is source handed to the compiler as
// DATA (the pattern of operation_admit_callers_inert_witness), written as an OUTSIDE module that is
// named by no admit_callers list. The four routes a successful FleetFanObserved or a synthetic
// FanObserveHost could take are each refused: a direct record literal, a direct call to the mint, an
// indirect call through the witness `read` helper, and an indirect call through `variant_subject`.
// The accepted controls are the baseline witnesses in fleet_fan_converge_witness, which execute the
// admitted terminal routes; the control below shows the harness itself compiles a legal outside module
// clean, so a red cannot mean this file cannot compile a probe at all.

data literal_source: String = "module probe_fan_literal\nimport gunbc.fleet.fleet_fan_converge { FleetFanObserved, FleetFanReadReceipt, FleetFanReading }\nimport gunbc.machine_intake.fan_observe { FanObserveHost }\nfn forged(s: FanObserveHost, r: FleetFanReadReceipt, x: FleetFanReading) -> FleetFanObserved {\n  FleetFanObserved { subject: s, receipt: r, reading: x }\n}\n"

data direct_mint_source: String = "module probe_fan_direct_mint\nimport gunbc.fleet.fleet_fan_converge { FleetFanObserved, FleetFanReadReceipt, FleetFanReading, fleet_fan_observed }\nimport gunbc.machine_intake.fan_observe { FanObserveHost }\nfn forged(s: FanObserveHost, r: FleetFanReadReceipt, x: FleetFanReading) -> FleetFanObserved {\n  fleet_fan_observed(subject: s, receipt: r, reading: x)\n}\n"

data indirect_read_source: String = "module probe_fan_indirect_read\nimport gunbc.fleet.fleet_fan_converge { FleetFanObserved, FleetFanReading }\nimport gunbc.machine_intake.fan_observe { FanObserveHost }\nimport test.claim.fleet_fan_converge_witness { read }\nfn forged(s: FanObserveHost, x: FleetFanReading) -> FleetFanObserved {\n  read(s: s, n: 1, r: x)\n}\n"

data indirect_subject_source: String = "module probe_fan_indirect_subject\nimport product.host_identity { HostIdentity }\nimport gunbc.machine_intake.fan_observe { FanObserveHost }\nimport test.claim.fleet_fan_converge_witness { variant_subject }\nfn forged(h: HostIdentity) -> FanObserveHost? {\n  variant_subject(host: h, openbmc: true)\n}\n"

data evidence_literal_source: String = "module probe_fan_evidence_literal\nimport product.host_identity { HostIdentity }\nimport product.fleet_fan_policy { FleetFanControl }\nimport gunbc.fleet.fleet_fan_converge { FleetFanConvergedEvidence, FleetFanReadReceipt }\nfn forged(h: HostIdentity, c: FleetFanControl, r: FleetFanReadReceipt) -> FleetFanConvergedEvidence {\n  FleetFanConvergedEvidence { host: h, control: c, readback: r }\n}\n"

data evidence_mint_source: String = "module probe_fan_evidence_mint\nimport product.host_identity { HostIdentity }\nimport product.fleet_fan_policy { FleetFanControl }\nimport gunbc.fleet.fleet_fan_converge { FleetFanConvergedEvidence, FleetFanReadReceipt, fleet_fan_converged_evidence }\nfn forged(h: HostIdentity, c: FleetFanControl, r: FleetFanReadReceipt) -> FleetFanConvergedEvidence {\n  fleet_fan_converged_evidence(host: h, control: c, readback: r)\n}\n"

data legal_outside_source: String = "module probe_fan_legal\nimport std.types { Int }\nimport gunbc.fleet.fleet_fan_converge { FleetFanReadReceipt }\nfn takes(r: FleetFanReadReceipt) -> Int { r.attempt }\n"

fn fan_census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn blocked_with(source: String, class: String) -> Bool {
  match census_blocking_count_for_class(census: fan_census_of(source: source), wanted: class) {
    Present { value: n } => n >= 1
    Absent => false
  }
}

fn clean(source: String) -> Bool {
  match fan_census_of(source: source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows)) == 0
    CensusNotRunnable { cause: _ } => false
  }
}

test fn witness_direct_literal_is_refused() -> Bool {
  blocked_with(source: literal_source, class: "SoleConstructorViolation")
}

test fn witness_direct_mint_call_is_refused() -> Bool {
  blocked_with(source: direct_mint_source, class: "ConstructorCallAdmissionRefused")
}

test fn witness_indirect_mint_through_read_is_refused() -> Bool {
  blocked_with(source: indirect_read_source, class: "ConstructorCallAdmissionRefused")
}

test fn witness_indirect_subject_through_variant_subject_is_refused() -> Bool {
  blocked_with(source: indirect_subject_source, class: "ConstructorCallAdmissionRefused")
}

test fn witness_a_legal_outside_module_compiles_clean() -> Bool {
  clean(source: legal_outside_source)
}

test fn witness_converged_evidence_literal_is_refused() -> Bool {
  blocked_with(source: evidence_literal_source, class: "SoleConstructorViolation")
}

test fn witness_converged_evidence_mint_call_is_refused() -> Bool {
  blocked_with(source: evidence_mint_source, class: "ConstructorCallAdmissionRefused")
}
