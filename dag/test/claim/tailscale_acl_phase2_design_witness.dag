module test.claim.tailscale_acl_phase2_design_witness

// This carrier named no authority, so it bound none: every call below -- `acl_upsert_permitted`,
// `tailscale_ephemeral_token_within_ttl`, `second`, `operator_bindings_are_user_principal_accessor_only`,
// and the rest -- resolved out of the reference-derived pool that `test/` drags in, and on a checkout
// where that pool is narrowed to the module's own closure each one is `undefined variable`. Naming the
// authorities is what makes the witness a check rather than a coincidence of the corpus (`gunbc.design_argument::fail_closed`:
// the binding must ride the mechanism that typechecks the calls).
import std.optional { Absent, Present }
import std.algebra { string_contains }
import std.measure { second, second_count }
import std.types { Bool, Secret, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.disposition { Scaffold, SingleAuthority }
import extdeps.cloud.gcp.iam {
  role_secretmanager_secret_accessor,
  admit_token_lifetime,
  hermetic_generate_access_token,
  hermetic_generate_access_token_expire_time,
}
import gunbc.auth.optional_impersonation {
  optional_impersonation,
  OptionalImpersonationToken,
  OptionalImpersonationLifetimeRefused,
}
import gunbc.assimilate.bmc_token_federation {
  SecretAccessBinding,
  bmc_secrets_project_id,
  bmc_federated_github_repo,
  bmc_wif_principal_set,
  bmc_assimilator_sa_member,
}
import gunbc.fleet.fleet_posix_accounts { fleet_operator_email, fleet_operator_gcp_iam_member }
import gunbc.tailscale_acl_phase2_credential {
  operator_tailscale_acl_secret_bindings,
  tailscale_acl_ephemeral_token_secret_id,
  tailscale_acl_ephemeral_lifetime,
  tailscale_acl_operator_email,
  operator_bindings_are_user_principal_accessor_only,
  operator_bindings_admit_repo_scoped_wif,
  operator_bindings_admit_bmc_assimilator_sa,
  operator_principal_member,
  ephemeral_token_gate_fail_closed,
  ephemeral_token_gate_valid,
  tailscale_ephemeral_token_within_ttl,
  acl_auto_upsert_refused,
  acl_upsert_permitted,
  acl_upsert_wet_shape_is_diff_print_only,
  tailscale_acl_phase2_live_write_disposition,
  tailscale_acl_phase2_credential_design_holds,
  TokenPresent,
  TokenAbsent,
  TokenExpired,
  DiffPending,
  PoliciesMatch,
  PoliciesDiffer,
  RefusedAutoUpsert,
  DiffPrintOnly,
  LiveWriteRefused,
  OperatorConfirmed,
}

test fn witness_secret_homed_in_gunbai_secrets() -> Bool {
  match operator_tailscale_acl_secret_bindings.first() {
    Present { value: b } => b.project == bmc_secrets_project_id && b.secret == (tailscale_acl_ephemeral_token_secret_id as String)
    Absent => false
  }
}

test fn witness_operator_user_principal_accessor_only() -> Bool {
  operator_bindings_are_user_principal_accessor_only(bindings: operator_tailscale_acl_secret_bindings)
    && match operator_tailscale_acl_secret_bindings.first() {
      Present { value: b } => b.role == role_secretmanager_secret_accessor
      Absent => false
    }
    && operator_principal_member() == fleet_operator_gcp_iam_member()
    && string_contains(s: operator_principal_member(), pattern: tailscale_acl_operator_email() as String)
    && tailscale_acl_operator_email() == fleet_operator_email
}

test fn witness_excludes_repo_scoped_wif_structurally() -> Bool {
  !operator_bindings_admit_repo_scoped_wif(bindings: operator_tailscale_acl_secret_bindings)
    && !operator_bindings_admit_bmc_assimilator_sa(bindings: operator_tailscale_acl_secret_bindings)
    && string_contains(s: bmc_wif_principal_set(), pattern: bmc_federated_github_repo)
}

test fn witness_wif_binding_perturbation_reddens() -> Bool {
  let poisoned_wif = SecretAccessBinding {
    member: bmc_wif_principal_set(),
    role: role_secretmanager_secret_accessor,
    secret: tailscale_acl_ephemeral_token_secret_id as String,
    project: bmc_secrets_project_id,
  }
  let poisoned_sa = SecretAccessBinding {
    member: bmc_assimilator_sa_member(),
    role: role_secretmanager_secret_accessor,
    secret: tailscale_acl_ephemeral_token_secret_id as String,
    project: bmc_secrets_project_id,
  }
  operator_bindings_admit_repo_scoped_wif(bindings: [poisoned_wif])
    && operator_bindings_admit_bmc_assimilator_sa(bindings: [poisoned_sa])
    && !operator_bindings_are_user_principal_accessor_only(bindings: [poisoned_wif])
}

// The six clauses this witness used to carry are DELETED rather than rehomed, and gunbc.design_argument::guarantee_ladder (dissolution on climb) is why
// the distinction matters. A climb keeps the discriminating RED that proves the higher rung is
// real; there was no discriminating RED here to keep. Five compared a `DeclarationRef` row's
// literal field against the same literal. The sixth matched `tailscale_acl_operator_adc_strategy`
// -- itself a literal `data` constant -- into true/false, which has the SAME property: green by
// construction, reddenable only by editing the row it reads. That is a change detector, not a
// check, and keeping it while deleting the five for that exact reason would have been inconsistent.
//
// The binding those clauses claimed is now an import edge in
// `gunbc.tailscale_acl_phase2_credential`, enforced by the compiler. The strategy is carried
// structurally too: `tailscale_acl_operator_adc_strategy` is passed to `gcp_oauth_access_token`,
// so a strategy that does not inhabit `GcpOAuth2AccessTokenStrategy` refuses at that call.

test fn witness_ephemeral_lifetime_matches_optional_impersonation_cap() -> Bool {
  second_count(s: tailscale_acl_ephemeral_lifetime) == 3600
    && string_contains(s: tailscale_acl_ephemeral_token_secret_id as String, pattern: "ephemeral")
}

test fn witness_fail_closed_on_absent_or_expired_token() -> Bool {
  ephemeral_token_gate_fail_closed(gate: TokenAbsent { reason: "not dispensed" })
    && ephemeral_token_gate_fail_closed(gate: TokenExpired { reason: "ttl elapsed" })
    && !ephemeral_token_gate_valid(
      gate: TokenAbsent { reason: "not dispensed" },
      now: second(count: 1000)
    )
    && ephemeral_token_gate_valid(
      gate: gunbc.tailscale_acl_phase2_credential.TokenPresent {
        token: "tskey-witness" as Secret,
        issued_at: second(count: 1000),
        lifetime: second(count: 3600),
      },
      now: second(count: 2000)
    )
    && !tailscale_ephemeral_token_within_ttl(
      issued_at: second(count: 1000),
      lifetime: second(count: 3600),
      now: second(count: 5000)
    )
}

test fn witness_diff_gate_refuses_auto_upsert() -> Bool {
  acl_auto_upsert_refused(gate: DiffPending { diff: PoliciesMatch })
    && acl_auto_upsert_refused(gate: DiffPending {
      diff: PoliciesDiffer { emitted: "{}", live: "{\"grants\":[]}" }
    })
    && acl_auto_upsert_refused(gate: RefusedAutoUpsert { reason: "operator has not confirmed" })
    && acl_upsert_wet_shape_is_diff_print_only(shape: DiffPrintOnly {
      diff: PoliciesDiffer { emitted: "{}", live: "{\"grants\":[]}" }
    })
    && !acl_upsert_wet_shape_is_diff_print_only(shape: LiveWriteRefused { reason: "design only" })
}

test fn witness_upsert_requires_valid_ephemeral_token() -> Bool {
  acl_upsert_permitted(
    gate: OperatorConfirmed {
      emitted: "{}",
      token: "tskey-witness" as Secret,
      issued_at: second(count: 1000),
      lifetime: second(count: 3600),
    },
    now: second(count: 2000)
  )
    && !acl_upsert_permitted(
      gate: OperatorConfirmed {
        emitted: "{}",
        token: "tskey-witness" as Secret,
        issued_at: second(count: 1000),
        lifetime: second(count: 3600),
      },
      now: second(count: 5000)
    )
}

test fn witness_phase2_is_design_only_scaffold() -> Bool {
  match tailscale_acl_phase2_live_write_disposition {
      Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
      _ => false
    }
}

test fn witness_design_spine() -> Bool {
  tailscale_acl_phase2_credential_design_holds()
}

// THE OPERATOR PATH'S BOUNDED MINT IS RULED ON BY THE API MODEL, BEFORE ANY CALL. The operator
// credential path reaches Google through `gunbc.auth.optional_impersonation`, whose lifetime
// admission this PR moved out of a where-refinement in the policy layer and into the one checked
// constructor `extdeps.cloud.gcp.iam::admit_token_lifetime`. This claim EXECUTES that path rather
// than asserting it exists, in both directions: an illegal request is refused with the offending
// lifetime carried back so the refusal can name it; the boundary is checked at the constructor both
// callers ask; and the ADMITTED leg actually runs the bounded mint and comes back with the token the
// API model issued. That last leg needs the operation's hermetic arm -- the `mock_response` row on
// `gcp.IAM.GenerateAccessToken` in `extdeps/cloud/gcp/iam.dag` -- because a hermetic run with no
// published mock refuses the effect (`HostEffectRefused { ground: NoMockResponse }`), which the route
// reports as UNOBSERVED, and no observation is not a pass
// (`gunbc.design_argument::fail_closed`: done means a real consumer green by execution).
test fn witness_the_api_model_refuses_an_illegal_lifetime_before_any_call() -> Bool {
  let refused_above_max = match optional_impersonation(
    access_token: "witness-operator-token" as Secret,
    service_account: Absent,
    lifetime: second(count: 3601)
  ) {
    OptionalImpersonationLifetimeRefused { lifetime: refused } =>
      second_count(s: refused) == 3601
    _ => false
  }
  let refused_unset = match optional_impersonation(
    access_token: "witness-operator-token" as Secret,
    service_account: Absent,
    lifetime: second(count: 0)
  ) {
    OptionalImpersonationLifetimeRefused { lifetime: _ } => true
    _ => false
  }
  // The boundary is checked where it is decided: the constructor both callers ask, at the ordinary
  // maximum and one second above it.
  let admitted_at_the_ordinary_maximum = match admit_token_lifetime(s: second(count: 3600)) {
    Present { value: admitted } => second_count(s: admitted.seconds) == 3600
    Absent => false
  }
  let refused_one_second_above = match admit_token_lifetime(s: second(count: 3601)) {
    Absent => true
    Present { value: _ } => false
  }
  // THE ADMITTED LEG RUNS THE MINT. With a service account to impersonate, the admitted leg plans
  // gcp.IAM.GenerateAccessToken; the hermetic arm of that operation publishes the decoded-200 body
  // `hermetic_generate_access_token` (extdeps/cloud/gcp/iam.dag), so this leg EXECUTES the exchange
  // and the answer it returns is the minted token -- not the caller's own, which is what makes it
  // evidence that the node ran rather than being skipped. Without that mock row this leg came back
  // HostEffectRefused { ground: NoMockResponse }, which the route reports as UNOBSERVED, and no
  // observation is not a pass.
  let admitted_leg_mints_through_the_api_model = match optional_impersonation(
    access_token: "witness-operator-token" as Secret,
    service_account: Present {
      value: "witness-operator@v1-compiler-prod.iam.gserviceaccount.com"
    },
    lifetime: second(count: 3600)
  ) {
    OptionalImpersonationToken { token: minted, expire_time: observed } =>
      (minted as String) == (hermetic_generate_access_token as String)
        // ...and it keeps the mint's own observation. DESIGN's worked example counts "returns the token
        // while discarding `expire_time`" as part of this defect; a caller that cannot see when a
        // credential dies cannot tell whether it will still be alive when it is spent, which is exactly
        // how `heal-publish` failed (456 s of dead time against a 300 s lifetime).
        && (match observed {
             Present { value: expiry } =>
               expiry == hermetic_generate_access_token_expire_time
             Absent => false
           })
    _ => false
  }
  // The other direction of the same rule: with no service account to impersonate no mint runs, so no
  // expiry was observed -- and the pattern must say so rather than invent one.
  let unimpersonated_arm_observed_no_expiry = match optional_impersonation(
    access_token: "witness-operator-token" as Secret,
    service_account: Absent,
    lifetime: second(count: 3600)
  ) {
    OptionalImpersonationToken { token: passed_through, expire_time: observed } =>
      (passed_through as String) == ("witness-operator-token" as String)
        && (match observed {
             Absent => true
             Present { value: _ } => false
           })
    _ => false
  }
  refused_above_max && refused_unset && admitted_at_the_ordinary_maximum
    && refused_one_second_above && admitted_leg_mints_through_the_api_model
    && unimpersonated_arm_observed_no_expiry
}
