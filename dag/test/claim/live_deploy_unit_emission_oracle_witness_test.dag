    TimerUnitFile { unit: _, timer: directives, install: _ } =>
      match unwrap_timer_directive(directives: directives, wanted: "OnUnitInactiveSec") {
        Present { value: duration } => duration == "60s"
        Absent => false
      }
    _ => false
  }
}

// AccuracySec= is 5s.
test fn belt_timer_accuracysec_is_5s() -> Bool {
