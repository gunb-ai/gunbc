// TimerUnit= names the belt service unit.
test fn belt_timer_targets_the_belt_service() -> Bool {
  let spec = live_spec()
  match live_deploy_belt_timer_unit_file(spec: spec) {
    TimerUnitFile { unit: _, timer: directives, install: _ } =>
      match unwrap_timer_directive(directives: directives, wanted: "TimerUnit") {
        Present { value: target } => string_contains(s: target, pattern: "belt")
        Absent => false
      }
    _ => false
  }
}
