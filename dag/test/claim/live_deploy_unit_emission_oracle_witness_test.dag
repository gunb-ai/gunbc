// ── SLICE UNIT DIRECTIVES ────────────────────────────────────────────────────────────────────

// MemoryMax= derives from gunbc_runner_slot_desired().memory_max.
// RED: a RunnerSlotDesired whose memory_max differs produces a slice
// whose MemoryMax= disagrees. That is representable:
// gunbc_runner_slot_desired is a function call, so a changed slot
// allocation produces different expected bytes.
test fn slice_unit_memory_max_derives_from_runner_slot() -> Bool {
  let spec = live_spec()
  let desired = gunbc_runner_slot_desired()
  let expected_bytes = byte_size_count(b: desired.memory_max)
  match live_deploy_slice_unit_file(spec: spec) {
    SliceUnitFile { unit: _, slice: directives, install: _ } =>
      match unwrap_slice_byte_count(directives: directives, property: MemoryMax) {
        Present { value: v } => v == expected_bytes
        Absent => false
      }
    _ => false
  }
}

// MemoryHigh= derives from gunbc_runner_slot_desired().memory_high.
test fn slice_unit_memory_high_derives_from_runner_slot() -> Bool {
  let spec = live_spec()
  let desired = gunbc_runner_slot_desired()
  let expected_bytes = byte_size_count(b: desired.memory_high)
  match live_deploy_slice_unit_file(spec: spec) {
    SliceUnitFile { unit: _, slice: directives, install: _ } =>
      match unwrap_slice_byte_count(directives: directives, property: MemoryHigh) {
        Present { value: v } => v == expected_bytes
        Absent => false
      }
    _ => false
  }
}

// ── BELT TIMER DIRECTIVES ────────────────────────────────────────────────────────────────────

// OnBootSec= is 2min.
test fn belt_timer_onbootsec_is_2min() -> Bool {
  let spec = live_spec()
  match live_deploy_belt_timer_unit_file(spec: spec) {
    TimerUnitFile { unit: _, timer: directives, install: _ } =>
      match unwrap_timer_directive(directives: directives, wanted: "OnBootSec") {
        Present { value: duration } => duration == "2min"
        Absent => false
      }
    _ => false
  }
}

// OnUnitInactiveSec= is 60s (belt_tick_cadence).
