// A DATED, INDEPENDENTLY TRANSCRIBED REALIZATION FIXTURE — NOT LIVE DRIFT DETECTION.
//
// Read this claim precisely, because an earlier revision of this note overstated it and the
// overstatement is the exact failure this repository keeps paying for. What executes here is
//
//     emitter(current) == bytes transcribed from srv1 on 2026-08-19
//
// and NOT
//
//     emitter(current) == host(current)
//
// Nothing reads srv1 at execution time. If the deployed units drift tomorrow while these
// functions stay put, every witness below stays green — so this fixture CANNOT ask "did the host
// change?", and calling the running host an external authority for these bytes would be a claim
// the mechanism does not support. The deployed file is an observed realization, not the authority
// for systemd syntax or for desired deployment state.
//
// What it IS good for, and why it exists: the expected bytes were obtained independently of the
// functions under test, so this is not a self-capture golden — it cannot certify a renderer as
// correct merely because nobody edited it, which is the change detector DESIGN section 5 rejects.
// That makes it a sound BASELINE for refactoring these renderers: a red means the emitter moved
// off the last observed deployed baseline, which during a migration is exactly the question.
//
// It is needed because nothing else pins these bytes. dag/test/claim/live_deploy/long/emit_test.dag
// carries 57 witnesses and not one asserts a unit doc's text; the emitted deploy script is not a
// committed artifact, so git shows no diff; and the generated-artifact drift gate was deleted by
// the 2026-08-15 floor cut (.github/workflows now holds only fleet-converge.yml and witnesses.yml).
//
// Live drift detection is a DIFFERENT mechanism this fixture does not provide: it would have to
// observe the host at run time and would belong with the fleet observation lane, not here.
//
// ── RETIRED WITH THEIR MEMBER, NOT PENDING AN OBSERVATION ──────────────────────────────────────
//
// the_fleet_converge_service_unit_matches_the_deployed_bytes and
// the_fleet_converge_timer_unit_matches_the_deployed_bytes were transcribed from
// gunbc-srv1-green-fleet-converge.{service,timer}, which existed only on the deleted slot. srv1's
// surviving deployment carries no fleet-converge units — checked on the host 2026-08-19.

fn live_spec() -> DeploymentSpec {
  deployment_spec_srv1()
}

// The revision the live slot is actually serving, read from its ExecStart on the same date.
// Bound rather than synthesised because it appears verbatim in the emitted unit.
fn live_revision() -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: "b2dd729f92954e50e3d8d9bbd65022c2d58f14dd" as CommitSha }
}

// gunbc-roadmap-belt.service, as deployed on srv1.
//
// THIS ROW AGREES WITH THE LIVE BYTES AGAIN, and the round trip is worth recording because the
// intermediate state was committed. An earlier cut added EnvironmentFile=-/etc/... here and annotated
// the row as DELIBERATELY DIVERGING until the next apply -- honest at the time, and describing a
// change that was then withdrawn: binding an ambient credential into this multipurpose unit hands the
// token to every child the belt spawns, including the dispatched provider session. See
// live_deploy.spec deployment_credential_env_path for why the withdrawal happened and what replaces
// it.
//
// WHAT THIS MEANS FOR THE DEFECT THE OLD ANNOTATION NAMED: publish_pass still refuses on every tick
// with "GITHUB_TOKEN is not set in the belt's environment" (belt-last-tick.json, observed
// 2026-08-27). That refusal is UNCHANGED and is now correct rather than pending -- the belt is not
// supposed to hold that credential. It closes when the publication-only consumer boundary lands, not
// when this unit is next applied.
test fn the_belt_service_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = render(doc: emit_belt_service_unit_doc(spec: live_spec()), proto: live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc roadmap belt tick (one reconcile pass over the ready frontier)\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nUser=briansrls\nGroup=briansrls\nSlice=gunbc-roadmap.slice\nWorkingDirectory=/opt/gunbc/gunbc\nEnvironment=GUNBC_BELT_SPAWN_WORKDIR=/opt/gunbc/gunbc\nEnvironment=XDG_RUNTIME_DIR=/run/user/1000\nEnvironment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus\nExecStart=/opt/gunbc/bin/gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_belt_tick_cli.dag --function belt_run_once_cli\n"
}

// gunbc-roadmap-belt.timer, as deployed on srv1 2026-08-19.
test fn the_belt_timer_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = render(doc: emit_belt_timer_unit_doc(spec: live_spec()), proto: live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc roadmap belt tick cadence\n\n[Timer]\nUnit=gunbc-roadmap-belt.service\nOnBootSec=2min\nOnUnitInactiveSec=60s\nAccuracySec=5s\n\n[Install]\nWantedBy=timers.target\n"
}

// gunbc-roadmap.service, as deployed on srv1. LIKE THE BELT ROW ABOVE, this briefly carried an
// EnvironmentFile line and no longer does, for the same reason: POST /publish/NODE_ID reaches the
// same credential resolver the belt tick does (roadmap_serve
// serve_publish_handler_response_for_instance -> belt_publish_node_for_instance), so crediting THIS
// long-running multipurpose server was the same over-grant in a second place. Both routes will share
// one publication boundary rather than one ambient token; live_deploy.spec
// deployment_credential_env_path carries the argument.
test fn the_serve_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = render(doc: emit_systemd_unit_doc(spec: live_spec(), revision: live_revision()), proto: live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc roadmap HTTP server (gunbc serve)\nAfter=network-online.target tailscaled.service\nWants=network-online.target\n\n[Service]\nType=simple\nUser=briansrls\nGroup=briansrls\nSlice=gunbc-roadmap.slice\nWorkingDirectory=/opt/gunbc/gunbc\nEnvironment=XDG_RUNTIME_DIR=/run/user/1000\nEnvironment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus\nExecStart=/opt/gunbc/bin/gunbc serve --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_serve.dag --function roadmap_serve_handle --host 0.0.0.0 --port 8080 --release-revision b2dd729f92954e50e3d8d9bbd65022c2d58f14dd --eval-budget-cpu-ms 30000 --eval-budget-wall-ms 30000\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n"
}

// gunbc-tree-sync.service, AS EMITTED, and this row now asserts the emission rather than a
// transcription. Its predecessor kept a 2026-08-19 transcription of the deployed bytes carrying a
// SECOND ExecStart -- the `.git` rsync leg -- and named its one intended divergence, the widened
// exclude run on the first leg. The `.git` leg was deleted from the emitter when Git-native
// repository convergence replaced file transport of repository metadata (gunbc.live_deploy.
// repository_convergence_placement), and the expectation was never moved, so this witness was red
// on main against an emitter with one ExecStart and nothing rostered it. Measured 2026-09-04 while
// wiring `gunbc converge --mode deploy`.
//
// WHAT IS ASSERTED NOW: one ExecStart, the exclude run derived from deployed_tree_excluded_prefixes
// (eight prefixes: the two bootstrap receipt channels joined it the same day), and the deployment
// slice the unit joins. The deployed bytes on srv1 predate all three and converge on the next deploy.
test fn the_tree_sync_unit_matches_the_deployed_bytes_plus_the_exclusion_widening() -> Bool {
  let emitted = render(doc: emit_tree_sync_unit_doc(spec: live_spec(), tree_path: live_spec().service.repo_root as String), proto: live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc source tree sync (service-user-principal rsync from CI runner checkout)\n\n[Service]\nType=oneshot\nUser=briansrls\nGroup=briansrls\nSlice=gunbc-roadmap.slice\nEnvironmentFile=/etc/gunbc-tree-sync.env\nExecStart=/usr/bin/rsync -rlpt --delete --exclude /target --exclude /.git --exclude /.claude --exclude /.gunbc --exclude /target-codex --exclude /.cargo-home --exclude /.gunbc-build-receipts --exclude /.gunbc-converge-receipts \"$\{GUNBC_TREE_SRC}/\" /opt/gunbc/gunbc/\n"
}


// THE SLICE UNIT, BYTE FOR BYTE. The bound is the runner slot's allowance rendered by the
// resource-control authority; a change to either shows up here as the deployed bytes changing.
test fn the_slice_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = render(doc: emit_slice_unit_doc(spec: live_spec()), proto: live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc deployment cgroup bound for gunbc-roadmap.service\n\n[Slice]\nMemoryMax=17179869184\nMemoryHigh=16106127360\n"
}


// ── DIRECTIVE-LEVEL CLAIMS ───────────────────────────────────────────────────────────────────
//
// Each assertion below checks a single directive against the SPEC FIELD it derives from, rather
// than comparing against a whole-file byte string. A directive-level claim goes red exactly when
// the emitter stops deriving the value from its spec source:
//
//   spec.service.service_user        →  ServiceUser=, ServiceGroup=
//   spec.service.repo_root           →  WorkingDirectory=
//   deployment_slice_unit_name(spec) →  Slice=
//   spec.service.serve_binary        →  ExecStart= (containment, not byte identity)
//   gunbc_runner_slot_desired        →  MemoryMax=, MemoryHigh=
//   belt_tick_cadence                →  OnUnitInactiveSec=
//
// These are ADDITIVE to the byte-level rows above. Nothing is deleted. The byte rows provide the
// baseline against the 2026-08-19 transcription; these provide the derivation trace.

// ── HELPERS ──────────────────────────────────────────────────────────────────────────────────

fn unwrap_service_type(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      ServiceType { mode: m } => Present { value: m as String }
      _ => none
    }
  })
}

fn unwrap_service_user(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      ServiceUser { name: n } => Present { value: n as String }
      _ => none
    }
  })
}

fn unwrap_service_group(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      ServiceGroup { name: n } => Present { value: n as String }
      _ => none
    }
  })
}

fn unwrap_service_slice(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      ServiceSlice { name: n } => Present { value: n as String }
      _ => none
    }
  })
}

fn unwrap_working_directory(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      WorkingDirectory { path: p } => Present { value: p as String }
      _ => none
    }
  })
}

fn unwrap_restart_policy(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      Restart { policy: p } => Present { value: p as String }
      _ => none
    }
  })
}

fn unwrap_environment_value(directives: List<SystemdServiceDirective>, var_name: String) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      Environment { assignment: a } =>
        if string_contains(s: a as String, pattern: join([var_name, "="], ""))
          then Present { value: a as String }
          else none
      _ => none
    }
  })
}

fn exec_start_matches(directives: List<SystemdServiceDirective>, pattern: String) -> Bool {
  fold(directives, init: false, f: (acc, d) => match d {
    ExecStart { command: c } => acc || string_contains(s: c as String, pattern: pattern)
    _ => acc
  })
}

fn unwrap_timer_directive(directives: List<SystemdTimerDirective>, wanted: String) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      OnBootSec { duration: dur } if wanted == "OnBootSec" => Present { value: dur as String }
      OnUnitInactiveSec { duration: dur } if wanted == "OnUnitInactiveSec" => Present { value: dur as String }
      AccuracySec { duration: dur } if wanted == "AccuracySec" => Present { value: dur as String }
      TimerUnit { target: t } if wanted == "TimerUnit" => Present { value: t as String }
      _ => none
    }
  })
}

fn unwrap_slice_byte_count(directives: List<SystemdSliceDirective>, property: SystemdUnitProperty) -> Int? {
  let expected_wire = systemd_unit_property_wire(property: property) as String
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: _ } => acc
    Absent => match d {
      SystemdSliceDirective { property: p, value: DirectiveByteCount { bytes: b } } =>
        if systemd_unit_property_wire(property: p) as String == expected_wire {
          Present { value: byte_size_count(b: b) }
        } else {
          none
        }
      _ => none
    }
  })
}

// ── SERVE UNIT DIRECTIVES ────────────────────────────────────────────────────────────────────

// ServiceUser= and ServiceGroup= both derive from spec.service.service_user.
// RED: a spec whose service_user differs produces a unit whose ServiceUser= disagrees.
// That is representable: provide a spec with a distinct service_user and the directive
// will name the wrong principal.
test fn serve_unit_user_and_group_derive_from_service_user() -> Bool {
  let spec = live_spec()
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match unwrap_service_user(directives: directives) {
        Present { value: u } =>
          match unwrap_service_group(directives: directives) {
            Present { value: g } =>
              u == spec.service.service_user as String
                && g == spec.service.service_user as String
            Absent => false
          }
        Absent => false
      }
    _ => false
  }
}

// ServiceSlice= derives from deployment_slice_unit_name(names: spec.names).
// RED: a spec whose names produce a different slice name produces a unit whose Slice= disagrees.
test fn serve_unit_slice_derives_from_deployment_names() -> Bool {
  let spec = live_spec()
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match unwrap_service_slice(directives: directives) {
        Present { value: s } =>
          s == deployment_slice_unit_name(names: spec.names) as String
        Absent => false
      }
    _ => false
  }
}

// WorkingDirectory= derives from spec.service.repo_root.
// RED: a spec with a different repo_root produces a unit whose WorkingDirectory= disagrees.
test fn serve_unit_working_directory_derives_from_repo_root() -> Bool {
  let spec = live_spec()
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match unwrap_working_directory(directives: directives) {
        Present { value: wd } => wd == spec.service.repo_root as String
        Absent => false
      }
    _ => false
  }
}

// ExecStart= contains the serve binary and the serve function from the spec.
// Uses string containment rather than byte identity because the full ExecStart includes
// flags whose exact order is a rendering choice.
// RED: a spec with a different serve_binary produces a unit whose ExecStart does not
// contain that binary, which would refuse here.
test fn serve_unit_execstart_contains_serve_binary_and_function() -> Bool {
  let spec = live_spec()
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      exec_start_matches(directives: directives, pattern: spec.service.serve_binary as String)
        && exec_start_matches(directives: directives, pattern: spec.service.serve_function as String)
    _ => false
  }
}

// The user-manager Environment= lines derive from spec.service.service_uid.
// RED: a spec with a different service_uid produces XDG_RUNTIME_DIR and
// DBUS_SESSION_BUS_ADDRESS with the wrong uid, and this goes red
// on the uid mismatch.
test fn serve_unit_has_user_manager_env_with_correct_uid() -> Bool {
  let spec = live_spec()
  let uid_str = to_string(spec.service.service_uid)
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match unwrap_environment_value(directives: directives, var_name: "XDG_RUNTIME_DIR") {
        Present { value: xdg } =>
          match unwrap_environment_value(directives: directives, var_name: "DBUS_SESSION_BUS_ADDRESS") {
            Present { value: dbus } =>
              string_contains(s: xdg, pattern: uid_str)
                && string_contains(s: dbus, pattern: uid_str)
            Absent => false
          }
        Absent => false
      }
    _ => false
  }
}

// ServiceType=simple (the serve process is long-running).
test fn serve_unit_is_type_simple() -> Bool {
  let spec = live_spec()
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match unwrap_service_type(directives: directives) {
        Present { value: t } => t == "simple"
        Absent => false
      }
    _ => false
  }
}

// Restart=on-failure.
test fn serve_unit_restarts_on_failure() -> Bool {
  let spec = live_spec()
  match live_deploy_serve_unit_file(spec: spec, revision: live_revision()) {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match unwrap_restart_policy(directives: directives) {
        Present { value: r } => r == "on-failure"
        Absent => false
      }
    _ => false
  }
}

