module test.claim.live_deploy_unit_emission_oracle_witness

// A DATED, INDEPENDENTLY TRANSCRIBED REALIZATION FIXTURE — NOT LIVE DRIFT DETECTION.
//
// Read this claim precisely, because an earlier revision of this note overstated it and the
// overstatement is the exact failure this repository keeps paying for. What executes here is
//
//     emitter(current) == bytes transcribed from srv1 on 2026-08-19
//
// and NOT
//
//     emitter(current) == host(current)
//
// Nothing reads srv1 at execution time. If the deployed units drift tomorrow while these
// functions stay put, every witness below stays green — so this fixture CANNOT ask "did the host
// change?", and calling the running host an external authority for these bytes would be a claim
// the mechanism does not support. The deployed file is an observed realization, not the authority
// for systemd syntax or for desired deployment state.
//
// What it IS good for, and why it exists: the expected bytes were obtained independently of the
// functions under test, so this is not a self-capture golden — it cannot certify a renderer as
// correct merely because nobody edited it, which is the change detector DESIGN section 5 rejects.
// That makes it a sound BASELINE for refactoring these renderers: a red means the emitter moved
// off the last observed deployed baseline, which during a migration is exactly the question.
//
// It is needed because nothing else pins these bytes. dag/test/claim/live_deploy/long/emit_test.dag
// carries 47 witnesses and not one asserts a unit doc's text; the emitted deploy script is not a
// committed artifact, so git shows no diff; and the generated-artifact drift gate was deleted by
// the 2026-08-15 floor cut (.github/workflows now holds only fleet-converge.yml and witnesses.yml).
//
// Live drift detection is a DIFFERENT mechanism this fixture does not provide: it would have to
// observe the host at run time and would belong with the fleet observation lane, not here.
//
// ── RETIRED WITH THEIR MEMBER, NOT PENDING AN OBSERVATION ──────────────────────────────────────
//
// the_fleet_converge_service_unit_matches_the_deployed_bytes and
// the_fleet_converge_timer_unit_matches_the_deployed_bytes were transcribed from
// gunbc-srv1-green-fleet-converge.{service,timer}, which existed only on the deleted slot. srv1's
// surviving deployment carries no fleet-converge units — checked on the host 2026-08-19.
//
// THE FIRST VERSION OF THIS RECEIPT GAVE A FALSE REASON, and the correction matters more than the
// rows. It said the members were still in deployment_spec_srv1's step list and would appear at the
// next apply, so the oracle would re-arm then. They are not. gunbc.live_deploy.spec
// deployment_owned_steps lists eight members and FleetConvergeTimerUnit is not among them —
// deployment_apply_order_note in that module records it as RETIRED from deployment membership by
// operator directive 2026-08-13, and test.claim.live_deploy.emit carries an enrolled claim
// asserting exactly that absence. So the re-arm trigger I wrote could never fire: no apply will
// ever install those units. That is the stalled-trigger shape DESIGN section 4b names, a `cannot
// climb` wearing the label `can climb after one event`, and it would have sent a later session
// waiting on an apply that cannot deliver.
//
// WHAT IS ACTUALLY TRUE: gunbc.live_deploy.emit emit_fleet_converge_service_unit_doc and
// emit_fleet_converge_timer_unit_doc now have no member, no spec consumer, and no oracle. They are
// orphaned emitters, and under delete-first they are the NEXT root to cut rather than evidence to
// re-arm. This is recorded as an observation for that cut, not as an obligation on this one — no
// trigger is declared here, because there is no event that would discharge it.
//
fn live_spec() -> gunbc.live_deploy.spec.DeploymentSpec {
  gunbc.live_deploy.spec.deployment_spec_srv1()
}

// The revision the live slot is actually serving, read from its ExecStart on the same date.
// Bound rather than synthesised because it appears verbatim in the emitted unit.
fn live_revision() -> gunbc.live_deploy.emit.ReleaseRevisionBinding {
  gunbc.live_deploy.emit.RevisionBoundAtEmission { revision: "b2dd729f92954e50e3d8d9bbd65022c2d58f14dd" as std.types.CommitSha }
}

// gunbc-roadmap-belt.service, as deployed on srv1 2026-08-19.
test fn the_belt_service_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = std.layout.render(doc: gunbc.live_deploy.emit.emit_belt_service_unit_doc(spec: live_spec()), proto: gunbc.live_deploy.emit.live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc roadmap belt tick (one reconcile pass over the ready frontier)\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nUser=briansrls\nGroup=briansrls\nWorkingDirectory=/opt/gunbc/gunbc\nEnvironment=GUNBC_BELT_SPAWN_WORKDIR=/opt/gunbc/gunbc\nExecStart=/opt/gunbc/bin/gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap_belt_actuate.dag --function belt_run_once_cli\n"
}

// gunbc-roadmap-belt.timer, as deployed on srv1 2026-08-19.
test fn the_belt_timer_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = std.layout.render(doc: gunbc.live_deploy.emit.emit_belt_timer_unit_doc(spec: live_spec()), proto: gunbc.live_deploy.emit.live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc roadmap belt tick cadence\n\n[Timer]\nUnit=gunbc-roadmap-belt.service\nOnBootSec=2min\nOnUnitInactiveSec=60s\nAccuracySec=5s\n\n[Install]\nWantedBy=timers.target\n"
}

// gunbc-roadmap.service, as deployed on srv1 2026-08-19.
test fn the_serve_unit_matches_the_deployed_bytes() -> Bool {
  let emitted = std.layout.render(doc: gunbc.live_deploy.emit.emit_systemd_unit_doc(spec: live_spec(), revision: live_revision()), proto: gunbc.live_deploy.emit.live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc roadmap HTTP server (gunbc serve)\nAfter=network-online.target tailscaled.service\nWants=network-online.target\n\n[Service]\nType=simple\nUser=briansrls\nGroup=briansrls\nWorkingDirectory=/opt/gunbc/gunbc\nExecStart=/opt/gunbc/bin/gunbc serve --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap_serve.dag --function roadmap_serve_handle --host 0.0.0.0 --port 8080 --release-revision b2dd729f92954e50e3d8d9bbd65022c2d58f14dd --eval-budget-cpu-ms 30000 --eval-budget-wall-ms 30000\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n"
}

// gunbc-tree-sync.service. Base transcription: srv1, 2026-08-19, like its siblings — but this
// row is the ONE in the family whose expectation intentionally diverges from the bytes currently on the
// host, so it is named for what it actually asserts rather than for the family it belongs to.
//
// THE DELTA IS EXACTLY THE FIRST ExecStart's EXCLUDE RUN, and it is derived, not transcribed:
// deployed_tree_rsync_exclude_flags() renders one `--exclude /<p>` per deployed_tree_excluded_prefixes
// entry, and that list widened from two prefixes to six. The deployed unit still carries the two-prefix
// spelling and will carry the six-prefix one after the next deploy of this slot, at which point the
// divergence closes and the transcription and the emission agree again.
//
// The second ExecStart is untouched on purpose: the .git leg carries its own include/exclude set and does
// not read the exclusion list, so a change to that list must not move it. Its bytes staying byte-identical
// here is the control that says the widening reached the leg it should and no other.
test fn the_tree_sync_unit_matches_the_deployed_bytes_plus_the_exclusion_widening() -> Bool {
  let emitted = std.layout.render(doc: gunbc.live_deploy.emit.emit_tree_sync_unit_doc(spec: live_spec(), tree_path: live_spec().service.repo_root as String), proto: gunbc.live_deploy.emit.live_deploy_protocol)
  emitted == "[Unit]\nDescription=gunbc source tree sync (service-user-principal rsync from CI runner checkout)\n\n[Service]\nType=oneshot\nUser=briansrls\nGroup=briansrls\nEnvironmentFile=/etc/gunbc-tree-sync.env\nExecStart=/usr/bin/rsync -rlpt --delete --exclude /target --exclude /.git --exclude /.claude --exclude /.gunbc --exclude /target-codex --exclude /.cargo-home \"$\{GUNBC_TREE_SRC}/\" /opt/gunbc/gunbc/\nExecStart=/usr/bin/rsync -rlpt --exclude=objects/pack/*.keep --exclude=objects/pack/tmp_pack_* --include=/HEAD --include=/objects/*** --include=/packed-refs --include=/refs/*** --exclude=* \"$\{GUNBC_TREE_SRC}/.git/\" /opt/gunbc/gunbc/.git/\n"
}
