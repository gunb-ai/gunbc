module gunbc.test.claim.workspace_acquisition_storage_wet_witness_test

import std.types { Bool, String, NonEmptyStr }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import gunbc.workspace_allocation_plan { workspace_reservation_plan_json }
import extdeps.shell
import std.durable_compare_and_set { ExpectSlotAbsent, CasCommitted }
import gunbc.durable_cas_fabric_storage { fabric_storage_compare_and_set }
import gunbc.durable_cas_file_store { admit_cas_attempt_for_derived_payload, DerivedPayloadAdmitted }
import gunbc.fabric_storage_client { FabricStorageLocalFiles, FabricStorageBinding }
import gunbc.fabric_storage_file_store { fabric_storage_file_root, fabric_storage_file_root_ensure, FabricStorageRootReady }
import extdeps.languages.json.emit { serialize_json, json_array, json_object, json_kv, json_string }
import gunbc.workspace_acquisition_invocation { workspace_acquisition_protocol_key }
import gunbc.workspace_allocation_store { WorkspaceAllocation, WorkspaceAcquiring, WorkspaceRetired, WorkspaceReleased, workspace_owner_key, workspace_allocation_json, workspace_settle_unelected_retirement, WorkspaceStoreWritten, WorkspaceStoreWriteRefused }
import gunbc.test.claim.workspace_launch_directive_witness_test { launch_fixture_allocation }

fn acquisition_fixture_write(store: FabricStorageBinding, key: NonEmptyStr, value: NonEmptyStr) -> Bool {
  match admit_cas_attempt_for_derived_payload(key: key, expected: ExpectSlotAbsent, proposed: value) {
    DerivedPayloadAdmitted { verified: proposed } => match fabric_storage_compare_and_set(store: store, verified: proposed) {
      CasCommitted { committed: _ } => true
      other => false
    }
    other => false
  }
}

// The fixture seeds an old interrupted owner row, never an actual reservation or host effect.
// Without the protocol marker legacy absence stays unknown; a marked unelected actor can cancel.
fn acquisition_cancellation_fixture(store: FabricStorageBinding, marked: Bool, elected: Bool) -> Bool {
  match launch_fixture_allocation() {
    Absent => false
    Present { value: fixture } => match fixture.plan {
      Absent => false
      Present { value: prepared } => {
        let retired = WorkspaceAllocation { recorded_at: fixture.recorded_at, retired_at: "2026-09-27T12:30:00Z",
          desired: WorkspaceRetired, request: fixture.request, plan: fixture.plan, reservation: none,
          phase: WorkspaceAcquiring, connection: "", observed_at: "", reason: "fixture interrupted before actor election" }
        let seeded = acquisition_fixture_write(store: store, key: workspace_owner_key(owner: fixture.request.owner),
          value: serialize_json(v: json_array(elements: [workspace_allocation_json(allocation: retired)])) as NonEmptyStr)
        let protocol = if marked { acquisition_fixture_write(store: store, key: workspace_acquisition_protocol_key(plan: prepared), value: "actor-journal/1" as NonEmptyStr) } else { true }
        let actor = if elected { acquisition_fixture_write(store: store,
          key: concat("workspace-acquisition-actor-", serialize_content_hash(hash: content_hash_of_value(value: serialize_json(v: workspace_reservation_plan_json(plan: prepared)) as NonEmptyStr)) as String) as NonEmptyStr,
          value: serialize_json(v: json_object(members: [
            json_kv(key: "plan", value: json_string(s: serialize_json(v: workspace_reservation_plan_json(plan: prepared)))),
            json_kv(key: "invocation", value: json_string(s: "0123456789abcdef0123456789abcdef")),
          ])) as NonEmptyStr) } else { true }
        if !seeded || !protocol || !actor { false } else {
          match workspace_settle_unelected_retirement(store: store, owner: fixture.request.owner, idempotency_key: fixture.request.idempotency_key, observed_at: "2026-09-27T12:31:00Z") {
            WorkspaceStoreWritten { allocation: settled } => marked && !elected && settled.phase == WorkspaceReleased
            WorkspaceStoreWriteRefused { reason: _ } => !marked || elected
            other => false
          }
        }
      }
    }
  }
}

fn acquisition_cancellation_temporary_store(marked: Bool, elected: Bool) -> Bool {
  let directory = shell.Mktemp.Dir()
  let root = fabric_storage_file_root(root: concat(directory.path as String, "/fabric") as NonEmptyStr)
  let observed = if !directory.success { false } else { match fabric_storage_file_root_ensure(root: root) {
    FabricStorageRootReady => acquisition_cancellation_fixture(store: FabricStorageLocalFiles { root: root }, marked: marked, elected: elected)
    other => false
  } }
  let cleaned = shell.Remove.RecursiveForce(path: directory.path)
  observed && cleaned.success
}

test fn legacy_acquiring_without_actor_journal_retains_quota() -> Bool { acquisition_cancellation_temporary_store(marked: false, elected: false) }
test fn marked_unelected_actor_cancellation_releases_owner_quota() -> Bool { acquisition_cancellation_temporary_store(marked: true, elected: false) }

test fn elected_actor_cannot_be_cancelled_from_absent_hold_assumption() -> Bool { acquisition_cancellation_temporary_store(marked: true, elected: true) }
