// THE OUTCOME-TO-SUCCESS EXPORT (lane sweep, row attempt_request_binding_commit_of) IS DELETED: importing it is a
// MissingExport; the effect entry that now carries the decision imports clean.
test fn attempt_request_record_no_longer_declares_the_commit_decision() -> ProcessExit {
  census_exit(blocking_delta(hostile: ctl_commit_of_source, safe: baseline_source, holds: fn(n) { n >= 1 }))
}

test fn attempt_request_record_declares_the_create_entry() -> ProcessExit {
  census_exit(blocking_delta(hostile: ctl_create_entry_source, safe: baseline_source, holds: fn(n) { n <= 0 }))
}
