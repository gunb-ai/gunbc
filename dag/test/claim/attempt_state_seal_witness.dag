module test.claim.attempt_state_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// THE PER-ATTEMPT DISPATCH STATE (gunbc.roadmap.roadmap_attempt_state_store) IS MINTED FROM instance+node+attempt_key
// AND CANNOT BE SPELLED OR MINTED FROM A PATH. AttemptState (the listed store) and AttemptStateProvision (the
// plan-time path) are sole_constructor. Each RED hands the compiler a module outside the defining file and asserts
// the refusal on the real acceptance path: a forged literal and a forged cast are each EXACTLY ONE
// SoleConstructorViolation on the record's own subject; the mint handed a path, and a handle of the other record
// returned where this one is required, each add at least one blocking diagnostic beyond a baseline importing the
// same closure. The expecting-RED probes (a directory read out of either record) record the declared residual that a
// sole_constructor record's field reads are not module-private (the existing specimen a_slot_store_is_built_over_a_literal_path_by_any_module,
// route 2); they go red, and are inverted, in the change that makes sealed fields readable only by the declaring module.
// The GREEN is the lawful route: the mint from the business key into the external-hand-off path / the provision.
// THE DECLARATION CONTROLS name a symbol each reader module no longer declares (the path-returning family and the
// two verification walks): importing it must add a blocking diagnostic, so a reader cannot quietly regain a raw-path route.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

