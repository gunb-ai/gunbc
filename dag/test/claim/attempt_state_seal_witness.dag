data twin_state_literal_source: String = "module probe_attempt_state_twin_state\nimport std.types { NonEmptyStr, String }\nimport test.fixture.attempt_state_seal.unsealed { AttemptState }\nfn f(i: NonEmptyStr) -> AttemptState {\n  AttemptState { instance: i, node: \"n\", directory: \"/tmp/forged-attempt\" }\n}\n"
data twin_provision_literal_source: String = "module probe_attempt_state_twin_provision\nimport std.types { NonEmptyStr, String }\nimport test.fixture.attempt_state_seal.unsealed { AttemptStateProvision }\nfn f(i: NonEmptyStr) -> AttemptStateProvision {\n  AttemptStateProvision { instance: i, node: \"n\", directory: \"/tmp/forged-attempt\" }\n}\n"

test fn the_same_forged_sources_pass_against_the_seal_stripped_twin() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: seal_violations(source: twin_state_literal_source, subject: "AttemptState"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: twin_provision_literal_source, subject: "AttemptStateProvision"), holds: fn(n) { n == 0 }),
  ])
}

test fn a_forged_state_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: state_literal_source, subject: "AttemptState"), holds: fn(n) { n == 1 }))
}

test fn a_forged_state_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: state_cast_source, subject: "AttemptState"), holds: fn(n) { n == 1 }))
}

test fn a_forged_provision_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: provision_literal_source, subject: "AttemptStateProvision"), holds: fn(n) { n == 1 }))
}

test fn a_forged_provision_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: provision_cast_source, subject: "AttemptStateProvision"), holds: fn(n) { n == 1 }))
}

test fn no_attempt_state_mint_takes_a_path() -> ProcessExit {
  census_exit(blocking_delta(hostile: state_path_minter_source, safe: baseline_source, holds: fn(n) { n >= 1 }))
}

test fn a_provision_is_not_an_attempt_state() -> ProcessExit {
  census_exit(blocking_delta(hostile: state_other_source, safe: baseline_source, holds: fn(n) { n >= 1 }))
}

test fn an_attempt_state_is_not_a_provision() -> ProcessExit {
  census_exit(blocking_delta(hostile: provision_other_source, safe: baseline_source, holds: fn(n) { n >= 1 }))
}

test fn a_directory_is_readable_through_an_attempt_state_today() -> ProcessExit {
  census_exit(blocking_delta(hostile: state_dir_out_source, safe: baseline_source, holds: fn(n) { n <= 0 }))
}

test fn a_directory_is_readable_through_a_provision_today() -> ProcessExit {
  census_exit(blocking_delta(hostile: provision_dir_out_source, safe: baseline_source, holds: fn(n) { n <= 0 }))
}

test fn the_lawful_attempt_state_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_source, safe: baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_source, subject: "AttemptState"), holds: fn(n) { n == 0 }),
  ])
}

test fn the_lawful_provision_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_provision_source, safe: baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_provision_source, subject: "AttemptStateProvision"), holds: fn(n) { n == 0 }),
  ])
}

