module test.claim.design_register_lift_parity_witness

import std.content_hash { content_hash_atom }
import std.types { NonEmptyStr, Bool, String }
import gunbc.site.moodboard { moodboard_css, moodboard_html, moodboard_digest }
import gunbc.site.accent_study { accent_study_html }
import gunbc.roadmap_style { roadmap_css }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data lift_parity_note: String = "Phase-A emission-identical witness (design-register-library.md sect 5): pins content digests of site + roadmap CSS/HTML emissions after the gunbc.design.* lift. Pre-lift golden = post-lift output (lift-not-fork); drift reds. site_register_keystone and roadmap_register_keystone remain the behavioral receipts; this witness is the digest receipt."

data moodboard_css_lift_parity_digest: String = "5f2596b1693465d7"
data moodboard_html_lift_parity_digest: String = "9252e67e6cf24375"
data accent_study_html_lift_parity_digest: String = "90e876af9e5173db"
data roadmap_css_digest_repin_note: String = "Re-pinned across the UI-model migration and the #7104 (SupersededLine) merge. P2 (token migration, px/font -> gunbc.design.scale var tokens) was proven visually-neutral by execution: resolving every var(--scale-token) reproduced the pre-P2 CSS byte-for-byte. P3 (presentation mapping) then INTENTIONALLY adds styling: the dispatch button's reserved min-width (derived from the longest wire label, in ch) and the ok/refusal/requested chip material rules (each painting the P0 state's role). D5 (typed CSS grain) is a pure re-grounding — property names and selector subjects become typed, bytes unchanged. The #7104 merge folds in the .status-superseded / .node-superseded / .superseded-by rules, RE-GROUNDED here onto the same typed+tokenized grain (their raw 11px/6px/font-family literals routed through the scale tokens so the untokened-length census stays green), which shifts the bytes off main's hardcoded emission — hence this digest re-pin. The behavioral receipts (roadmap_register_keystone, dispatch_presentation_keystone) and the untokened-length census remain the substance; this digest only pins bytes."

data roadmap_css_lift_parity_digest: String = "947686b5dbaab2b0"
data moodboard_thesis_themes_lift_parity_digest: String = "69e68066c49667f9"

fn emission_content_digest(s: String) -> String {
  content_hash_atom(value: s as NonEmptyStr) as String
}

fn witness_moodboard_css_digest_pinned() -> Bool {
  emission_content_digest(s: moodboard_css()) == moodboard_css_lift_parity_digest
}

fn witness_moodboard_html_digest_pinned() -> Bool {
  emission_content_digest(s: moodboard_html()) == moodboard_html_lift_parity_digest
}

fn witness_accent_study_html_digest_pinned() -> Bool {
  emission_content_digest(s: accent_study_html()) == accent_study_html_lift_parity_digest
}

fn witness_roadmap_css_digest_pinned() -> Bool {
  emission_content_digest(s: roadmap_css()) == roadmap_css_lift_parity_digest
}

fn roadmap_css_digest_probe() -> String {
  emission_content_digest(s: roadmap_css())
}

fn witness_moodboard_thesis_themes_digest_pinned() -> Bool {
  moodboard_digest() == moodboard_thesis_themes_lift_parity_digest
}

test fn design_register_lift_parity_holds() -> Bool {
  witness_moodboard_css_digest_pinned()
    && witness_moodboard_html_digest_pinned()
    && witness_accent_study_html_digest_pinned()
    && witness_roadmap_css_digest_pinned()
    && witness_moodboard_thesis_themes_digest_pinned()
}
