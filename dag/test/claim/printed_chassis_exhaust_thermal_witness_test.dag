module test.claim.printed_chassis_exhaust_thermal_witness
import std.types { Bool }
import std.measure { watt, percent, celsius, celsius_count, celsius_delta, celsius_delta_count }
import product.printed_chassis.exhaust_thermal { ExhaustCase, mount_thermal_margin, ThermalMargin, PrintedPartBelowHdt, PrintedPartReachesHdt, NoAirflow, worst_inlet, processor_junction_limit }
import extdeps.printing.bambu_lab_filament { bambu_pla_basic_tds, bambu_petg_hf_tds }

fn case(heat_w: Nat, fans: Nat, duty: Nat) -> ExhaustCase {
  ExhaustCase { node_heat: watt(count: heat_w), fans: fans, duty: percent(count: duty), inlet: worst_inlet(), margin_required: celsius_delta(count: 10) }
}

// 300 W through three P8 fans at full duty from a 35 C inlet: single-digit rise, PLA Basic's
// 57 C HDT stays more than ten kelvin away, and the exhaust is nowhere near the 100 C die
// limit the question was framed around.
test fn full_flow_keeps_pla_under_its_hdt_with_margin() -> Bool {
  match mount_thermal_margin(case: case(heat_w: 300, fans: 3, duty: 100), sheet: bambu_pla_basic_tds) {
    PrintedPartBelowHdt { exhaust: e, hdt: _, margin: m } => celsius_count(c: e) < 45 && celsius_delta_count(delta: m) >= 10 && celsius_count(c: e) < celsius_count(c: processor_junction_limit())
    PrintedPartReachesHdt { exhaust: _, hdt: _, excess: _ } => false
    NoAirflow => false
  }
}

// The same heat at twenty percent duty is a different answer: the rise is tens of kelvin and
// PLA reaches its HDT. The fan floor is a safety input, and the instrument says so by refusing.
test fn low_duty_with_full_load_reaches_the_hdt() -> Bool {
  match mount_thermal_margin(case: case(heat_w: 300, fans: 3, duty: 20), sheet: bambu_pla_basic_tds) {
    PrintedPartReachesHdt { exhaust: e, hdt: h, excess: x } => celsius_count(c: e) + 10 > celsius_count(c: h) && celsius_delta_count(delta: x) > 0
    PrintedPartBelowHdt { exhaust: _, hdt: _, margin: _ } => false
    NoAirflow => false
  }
}

test fn petg_carries_more_margin_than_pla_and_no_fans_is_a_refusal() -> Bool {
  let pla = match mount_thermal_margin(case: case(heat_w: 300, fans: 3, duty: 70), sheet: bambu_pla_basic_tds) { PrintedPartBelowHdt { exhaust: _, hdt: _, margin: m } => celsius_delta_count(delta: m) PrintedPartReachesHdt { exhaust: _, hdt: _, excess: _ } => 0 NoAirflow => 0 }
  let petg = match mount_thermal_margin(case: case(heat_w: 300, fans: 3, duty: 70), sheet: bambu_petg_hf_tds) { PrintedPartBelowHdt { exhaust: _, hdt: _, margin: m } => celsius_delta_count(delta: m) PrintedPartReachesHdt { exhaust: _, hdt: _, excess: _ } => 0 NoAirflow => 0 }
  petg > pla && pla > 0
  && (match mount_thermal_margin(case: case(heat_w: 300, fans: 0, duty: 100), sheet: bambu_pla_basic_tds) { NoAirflow => true PrintedPartBelowHdt { exhaust: _, hdt: _, margin: _ } => false PrintedPartReachesHdt { exhaust: _, hdt: _, excess: _ } => false })
}
