module test.claim.spark_serving_membership_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn w_host() -> product.placement_supply.HostIdentity {
  gunbc.fleet_intent_network.operator_host_srv5
}

fn w_principal() -> std.types.NonEmptyStr {
  gunbc.spark_serving_membership.spark_serving_serving_principal()
}

fn w_runtime_member(state: std.types.NonEmptyStr, ownership: gunbc.ownership.Ownership) -> gunbc.spark_serving_membership.SparkServingMember {
  gunbc.spark_serving_membership.spark_serving_member(
    host: test.claim.spark_serving_membership_witness_test.w_host(),
    principal: test.claim.spark_serving_membership_witness_test.w_principal(),
    address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress,
    state_digest: state,
    ownership: ownership,
  )
}

fn w_unit_member(state: std.types.NonEmptyStr, ownership: gunbc.ownership.Ownership) -> gunbc.spark_serving_membership.SparkServingMember {
  gunbc.spark_serving_membership.spark_serving_member(
    host: test.claim.spark_serving_membership_witness_test.w_host(),
    principal: test.claim.spark_serving_membership_witness_test.w_principal(),
    address: gunbc.spark_serving_membership.SparkServingUserUnitAddress,
    state_digest: state,
    ownership: ownership,
  )
}

fn w_linger_member(state: std.types.NonEmptyStr) -> gunbc.spark_serving_membership.SparkServingMember {
  gunbc.spark_serving_membership.spark_serving_member(
    host: test.claim.spark_serving_membership_witness_test.w_host(),
    principal: test.claim.spark_serving_membership_witness_test.w_principal(),
    address: gunbc.spark_serving_membership.SparkServingLingerAddress,
    state_digest: state,
    ownership: gunbc.ownership.Ensured,
  )
}

fn plan_has_change_for_address(
  plan: gunbc.membership_reconcile.MembershipPlan<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
  address: gunbc.spark_serving_membership.SparkServingResourceAddress,
  from_digest: std.types.NonEmptyStr,
  to_digest: std.types.NonEmptyStr,
) -> Bool {
  any(plan.actions, a =>
    match a {
      gunbc.membership_reconcile.MemberChanged { at: _, from: f, to: t } =>
        f.address == address
          && t.address == address
          && f.state_digest == from_digest
          && t.state_digest == to_digest
      _ => false
    }
  )
}

fn plan_has_add_for_address(
  plan: gunbc.membership_reconcile.MembershipPlan<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
  address: gunbc.spark_serving_membership.SparkServingResourceAddress,
) -> Bool {
  any(plan.actions, a => match a { gunbc.membership_reconcile.MemberAdded { at: _, to: m } => m.address == address  _ => false })
}

fn plan_has_refused_address(
  plan: gunbc.membership_reconcile.MembershipPlan<gunbc.spark_serving_membership.SparkServingMember, gunbc.spark_serving_membership.SparkServingMemberAt>,
  address: gunbc.spark_serving_membership.SparkServingResourceAddress,
) -> Bool {
  any(plan.actions, a =>
    match a {
      gunbc.membership_reconcile.MemberRemovalRefused { from: m, cause: _ } => m.address == address
      _ => false
    }
  )
}

data w_noop_note: String = "Already-correct host converging to ZERO effects is the claim most likely to be quietly false — reinstall-every-time is indistinguishable from correct from the outside. Asserts plan AND membership_effects both empty."

test fn w_spark_serving_desired_release_admits_for_admission_backed_witnesses() -> Bool {
  match gunbc.spark_serving_desired.spark_serving_desired_release_admission() {
    gunbc.spark.serving_desired.SparkServingDesiredAdmitted { serving_release: _ } => true
    gunbc.spark.serving_desired.SparkServingDesiredRefused { cause: _ } => false
  }
}

test fn w_spark_serving_noop_when_converged() -> Bool {
  match gunbc.spark_serving_desired.spark_serving_desired_release_admission() {
    gunbc.spark.serving_desired.SparkServingDesiredAdmitted { serving_release: r } =>
      let occ = gunbc.spark_serving_desired.spark_serving_occurrence(host: test.claim.spark_serving_membership_witness_test.w_host(), serving_release: r)
      let desired = gunbc.spark_serving_membership.spark_serving_desired_members(occurrence: occ, serving_release: r)
      let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(desired: desired, observed: desired)
      gunbc.spark_serving_membership.spark_serving_membership_noop(plan: plan)
        && match gunbc.spark_serving_membership.spark_serving_membership_effects(plan: plan) {
          gunbc.membership_reconcile.EffectsReady { effects: es } => count(es) == 0
          ApplyRefused { refusals: _ } => false
        }
    gunbc.spark.serving_desired.SparkServingDesiredRefused { cause: _ } => false
  }
}

test fn w_spark_serving_noop_when_converged_synthetic_fixture() -> Bool {
  let m = test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "v1" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(desired: [m], observed: [m])
  gunbc.spark_serving_membership.spark_serving_membership_noop(plan: plan)
    && match gunbc.spark_serving_membership.spark_serving_membership_effects(plan: plan) {
      gunbc.membership_reconcile.EffectsReady { effects: es } => count(es) == 0
      ApplyRefused { refusals: _ } => false
    }
}

test fn w_spark_serving_modified_is_change_not_add() -> Bool {
  let from_unit = gunbc.spark_serving_membership.spark_serving_user_unit_state_digest()
  let to_unit = "unit-drifted" as std.types.NonEmptyStr
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [test.claim.spark_serving_membership_witness_test.w_unit_member(state: to_unit, ownership: gunbc.ownership.Owned)],
    observed: [test.claim.spark_serving_membership_witness_test.w_unit_member(state: from_unit, ownership: gunbc.ownership.Owned)],
  )
  plan_has_change_for_address(
    plan: plan,
    address: gunbc.spark_serving_membership.SparkServingUserUnitAddress,
    from_digest: from_unit,
    to_digest: to_unit,
  )
    && !plan_has_add_for_address(plan: plan, address: gunbc.spark_serving_membership.SparkServingUserUnitAddress)
    && gunbc.membership_reconcile.membership_change_count(plan: plan) == 1
    && gunbc.membership_reconcile.membership_added_count(plan: plan) == 0
}

test fn w_spark_serving_runtime_upgrade_is_change_not_remove_add() -> Bool {
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "ollama-0.33.0" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)],
    observed: [test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "ollama-0.32.9" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)],
  )
  plan_has_change_for_address(
    plan: plan,
    address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress,
    from_digest: "ollama-0.32.9" as std.types.NonEmptyStr,
    to_digest: "ollama-0.33.0" as std.types.NonEmptyStr,
  )
    && !plan_has_add_for_address(plan: plan, address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress)
    && gunbc.membership_reconcile.membership_added_count(plan: plan) == 0
}

test fn w_spark_serving_added_when_runtime_absent() -> Bool {
  match gunbc.spark_serving_desired.spark_serving_desired_release_admission() {
    gunbc.spark.serving_desired.SparkServingDesiredAdmitted { serving_release: r } =>
      let occ = gunbc.spark_serving_desired.spark_serving_occurrence(host: test.claim.spark_serving_membership_witness_test.w_host(), serving_release: r)
      let desired = gunbc.spark_serving_membership.spark_serving_desired_members(occurrence: occ, serving_release: r)
      let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(desired: desired, observed: [])
      gunbc.membership_reconcile.membership_write_count(plan: plan) == count(desired)
        && gunbc.membership_reconcile.membership_removal_count(plan: plan) == 0
    gunbc.spark.serving_desired.SparkServingDesiredRefused { cause: _ } => false
  }
}

test fn w_spark_serving_added_when_runtime_absent_synthetic_fixture() -> Bool {
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "v1" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)],
    observed: [],
  )
  plan_has_add_for_address(plan: plan, address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress)
}

test fn w_spark_serving_ensured_linger_converges_on_drift() -> Bool {
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [test.claim.spark_serving_membership_witness_test.w_linger_member(state: gunbc.spark_serving_membership.spark_serving_executor_linger_state_digest())],
    observed: [test.claim.spark_serving_membership_witness_test.w_linger_member(state: "linger=drifted" as std.types.NonEmptyStr)],
  )
  plan_has_change_for_address(
    plan: plan,
    address: gunbc.spark_serving_membership.SparkServingLingerAddress,
    from_digest: "linger=drifted" as std.types.NonEmptyStr,
    to_digest: gunbc.spark_serving_membership.spark_serving_executor_linger_state_digest(),
  )
    && gunbc.membership_reconcile.membership_removal_count(plan: plan) == 0
    && gunbc.membership_reconcile.membership_refusal_count(plan: plan) == 0
}

test fn w_spark_serving_ensured_linger_removal_refused() -> Bool {
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [],
    observed: [test.claim.spark_serving_membership_witness_test.w_linger_member(state: gunbc.spark_serving_membership.spark_serving_executor_linger_state_digest())],
  )
  plan_has_refused_address(plan: plan, address: gunbc.spark_serving_membership.SparkServingLingerAddress)
    && gunbc.membership_reconcile.membership_removal_count(plan: plan) == 0
    && gunbc.membership_reconcile.membership_refusal_count(plan: plan) == 1
}

test fn w_spark_serving_key_is_host_principal_address_not_value() -> Bool {
  let a = test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "content-a" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)
  let b = test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "content-b" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)
  gunbc.spark_serving_membership.spark_serving_member_key(member: a) == gunbc.spark_serving_membership.spark_serving_member_key(member: b)
    && string_contains(
      s: gunbc.spark_serving_membership.spark_serving_member_key(member: a),
      pattern: gunbc.spark_serving_membership.spark_serving_serving_principal() as String,
    )
    && string_contains(s: gunbc.spark_serving_membership.spark_serving_member_key(member: a), pattern: "runtime-root")
}

test fn w_spark_serving_key_differs_when_host_changes() -> Bool {
  let shared = "same-content" as std.types.NonEmptyStr
  let a = gunbc.spark_serving_membership.spark_serving_member(
    host: gunbc.fleet_intent_network.operator_host_srv5,
    principal: test.claim.spark_serving_membership_witness_test.w_principal(),
    address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress,
    state_digest: shared,
    ownership: gunbc.ownership.Owned,
  )
  let b = gunbc.spark_serving_membership.spark_serving_member(
    host: gunbc.fleet_intent_network.operator_host_srv6,
    principal: test.claim.spark_serving_membership_witness_test.w_principal(),
    address: gunbc.spark_serving_membership.SparkServingRuntimeRootAddress,
    state_digest: shared,
    ownership: gunbc.ownership.Owned,
  )
  gunbc.spark_serving_membership.spark_serving_member_key(member: a) != gunbc.spark_serving_membership.spark_serving_member_key(member: b)
}

test fn w_spark_serving_user_unit_path_uses_unit_identity_authority() -> Bool {
  string_contains(s: gunbc.spark_serving_install_paths.spark_serving_user_unit_path() as String, pattern: gunbc.spark_serving_unit_identity.spark_serving_unit_name)
}

test fn w_spark_serving_unit_write_intent_carries_typed_spec() -> Bool {
  let intent = gunbc.spark_serving_membership.spark_serving_user_unit_file_write_intent()
  intent.path == gunbc.spark_serving_install_paths.spark_serving_user_unit_path()
    && intent.spec.service_type == ("simple" as std.types.NonEmptyStr)
    && intent.spec.exec_subcommand == ("serve" as std.types.NonEmptyStr)
    && string_contains(s: intent.spec.bind_host_port as String, pattern: ":")
}

test fn w_spark_serving_change_projects_effect_replace() -> Bool {
  let plan = gunbc.spark_serving_membership.spark_serving_membership_reconcile(
    desired: [test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "v2" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)],
    observed: [test.claim.spark_serving_membership_witness_test.w_runtime_member(state: "v1" as std.types.NonEmptyStr, ownership: gunbc.ownership.Owned)],
  )
  match gunbc.spark_serving_membership.spark_serving_membership_effects(plan: plan) {
    gunbc.membership_reconcile.EffectsReady { effects: es } =>
      count(es) == 1
        && any(es, e =>
             match e {
               gunbc.membership_reconcile.EffectReplace { from: f, to: t } =>
                 f.address == gunbc.spark_serving_membership.SparkServingRuntimeRootAddress
                   && f.state_digest == ("v1" as std.types.NonEmptyStr)
                   && t.state_digest == ("v2" as std.types.NonEmptyStr)
               gunbc.membership_reconcile.EffectAdd { to: _ } => false
               gunbc.membership_reconcile.EffectRemove { from: _ } => false
             })
    ApplyRefused { refusals: _ } => false
  }
}

test fn w_spark_serving_model_slot_address_is_primary() -> Bool {
  match gunbc.spark_serving_desired.spark_serving_desired_release_admission() {
    gunbc.spark.serving_desired.SparkServingDesiredAdmitted { serving_release: r } =>
      let occ = gunbc.spark_serving_desired.spark_serving_occurrence(host: test.claim.spark_serving_membership_witness_test.w_host(), serving_release: r)
      let desired = gunbc.spark_serving_membership.spark_serving_desired_members(occurrence: occ, serving_release: r)
      any(
        desired,
        m =>
          match m.address {
            gunbc.spark.serving_membership.SparkServingModelSlotAddress { slot: slot } =>
              slot == gunbc.spark_serving_membership.spark_serving_primary_model_slot
            _ => false
          },
      )
    gunbc.spark.serving_desired.SparkServingDesiredRefused { cause: _ } => false
  }
}
