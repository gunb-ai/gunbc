module test.claim.spatial_projection_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn site() -> std.coordinate_frame.CoordinateFrameIdentity { coordinate_frame_identity(occurrence: 1) }
fn page() -> std.coordinate_frame.CoordinateFrameIdentity { coordinate_frame_identity(occurrence: 2) }
fn other_site() -> std.coordinate_frame.CoordinateFrameIdentity { coordinate_frame_identity(occurrence: 7) }

fn box(frame: std.coordinate_frame.CoordinateFrameIdentity, x0: Int, y0: Int, x1: Int, y1: Int, low: Int, high: Int) -> std.orthogonal_topology.EnclosedSpace? {
  match orthogonal_loop2(vertices: [
    point2(frame: frame, x: x0, y: y0),
    point2(frame: frame, x: x1, y: y0),
    point2(frame: frame, x: x1, y: y1),
    point2(frame: frame, x: x0, y: y1),
  ]) {
    OrthogonalRefused { cause: _ } => none
    OrthogonalReady { value: l } =>
      match orthogonal_prism3(footprint: l, low: low, high: high) {
        OrthogonalRefused { cause: _ } => none
        OrthogonalReady { value: pr } => Present { value: enclosed_space(shell: closed_shell_of_prism(prism: pr)) }
      }
  }
}

fn placed(name: String, frame: std.coordinate_frame.CoordinateFrameIdentity, x0: Int, y0: Int, x1: Int, y1: Int, low: Int, high: Int) -> product.spatial_world.PlacedSpace? {
  match box(frame: frame, x0: x0, y0: y0, x1: x1, y1: y1, low: low, high: high) {
    Absent => none
    Present { value: s } => Present { value: product.spatial_world.PlacedSpace { identity: (name as product.placement_supply.RoomIdentity), space: s } }
  }
}

fn world_of(a: product.spatial_world.PlacedSpace?, b: product.spatial_world.PlacedSpace?) -> product.spatial_world.World? {
  match a {
    Absent => none
    Present { value: pa } =>
      match b {
        Absent => none
        Present { value: pb } =>
          match world(rooms: [pa, pb]) {
            WorldRefused { cause: _ } => none
            WorldReady { value: w } => Present { value: w }
          }
      }
  }
}

fn view_of(kind: std.planar_projection.ProjectionKind, source: std.coordinate_frame.CoordinateFrameIdentity) -> std.planar_projection.ProjectionView? {
  match named_projection_view(kind: kind, source_frame: source, view_frame: page()) {
    ProjectionRefused { cause: _ } => none
    ProjectionReady { value: v } => Present { value: v }
  }
}

// Two rooms side by side on one floor: disjoint footprints, same heights.
fn side_by_side() -> product.spatial_world.World? {
  world_of(
    a: placed(name: "kitchen", frame: site(), x0: 0, y0: 0, x1: 3000, y1: 4000, low: 0, high: 2400),
    b: placed(name: "hall", frame: site(), x0: 4000, y0: 0, x1: 6000, y1: 4000, low: 0, high: 2400),
  )
}

// One room directly above the other: identical footprints, disjoint vertical ranges. Legal in the
// world model, and the case a plan's depth ordering exists to resolve.
fn stacked() -> product.spatial_world.World? {
  world_of(
    a: placed(name: "ground", frame: site(), x0: 0, y0: 0, x1: 3000, y1: 4000, low: 0, high: 2400),
    b: placed(name: "upper", frame: site(), x0: 0, y0: 0, x1: 3000, y1: 4000, low: 2400, high: 4800),
  )
}

// An L-shaped room and a small room in its notch: disjoint footprints at identical elevations, so
// the world admits them, and overlapping page bounding boxes, so the conservative order test
// contends. The L is the only non-rectangular fixture in this witness and it exists for exactly this
// reason.
fn notched() -> product.spatial_world.World? {
  match l_shape() {
    Absent => none
    Present { value: l } =>
      world_of(
        a: Present { value: product.spatial_world.PlacedSpace { identity: ("l-room" as product.placement_supply.RoomIdentity), space: l } },
        b: placed(name: "notch-room", frame: site(), x0: 1600, y0: 1600, x1: 2900, y1: 2900, low: 0, high: 2400),
      )
  }
}

fn l_shape() -> std.orthogonal_topology.EnclosedSpace? {
  match orthogonal_loop2(vertices: [
    point2(frame: site(), x: 0, y: 0),
    point2(frame: site(), x: 3000, y: 0),
    point2(frame: site(), x: 3000, y: 1500),
    point2(frame: site(), x: 1500, y: 1500),
    point2(frame: site(), x: 1500, y: 3000),
    point2(frame: site(), x: 0, y: 3000),
  ]) {
    OrthogonalRefused { cause: _ } => none
    OrthogonalReady { value: l } =>
      match orthogonal_prism3(footprint: l, low: 0, high: 2400) {
        OrthogonalRefused { cause: _ } => none
        OrthogonalReady { value: pr } => Present { value: enclosed_space(shell: closed_shell_of_prism(prism: pr)) }
      }
  }
}

fn scene_of(w: product.spatial_world.World?, kind: std.planar_projection.ProjectionKind) -> product.spatial_projection.ProjectedScene? {
  match w {
    Absent => none
    Present { value: world_value } =>
      match view_of(kind: kind, source: site()) {
        Absent => none
        Present { value: v } =>
          match project_world(w: world_value, v: v) {
            SceneRefused { cause: _ } => none
            SceneReady { value: s } => Present { value: s }
          }
      }
  }
}

fn ordered_names(s: product.spatial_projection.ProjectedScene) -> std.algebra.FreeMonoid<String> {
  match painter_order(s: s) {
    SceneRefused { cause: _ } => []
    SceneReady { value: rooms } => fold(rooms, init: [], f: (acc, r) => concat(acc, [(r.identity as String)]))
  }
}

fn names_are(actual: std.algebra.FreeMonoid<String>, first: String, second: String) -> Bool {
  match actual {
    Empty => false
    Cons { head: a, tail: rest } =>
      match rest {
        Empty => false
        Cons { head: b, tail: after } =>
          match after {
            Empty => a == first && b == second
            Cons { head: _, tail: _ } => false
          }
      }
  }
}

// The first room in world order, which is the one every single-room claim below reads. It is
// returned as an optional rather than defaulted, for the reason the world witness states: a
// fabricated empty room would make a claim pass for a reason unrelated to what it tests.
fn first_room(s: product.spatial_projection.ProjectedScene) -> product.spatial_projection.ProjectedRoom? {
  match scene_rooms(s: s) {
    Empty => none
    Cons { head: r, tail: _ } => Present { value: r }
  }
}

// IDENTITY SURVIVES. A drawing whose shapes cannot be traced back to rooms is a picture; this claim
// is the difference between the two.
test fn every_projected_room_keeps_the_identity_the_world_gave_it() -> Bool {
  match scene_of(w: side_by_side(), kind: PlanFromAbove) {
    Absent => false
    Present { value: s } =>
      names_are(actual: fold(scene_rooms(s: s), init: [], f: (acc, r) => concat(acc, [(r.identity as String)])), first: "kitchen", second: "hall")
  }
}

// A rectangular prism has four footprint vertices at each of two heights. Asserting the count keeps
// a later edit from projecting only the floor and calling the result a room.
test fn a_room_contributes_every_corner_of_its_prism() -> Bool {
  match scene_of(w: side_by_side(), kind: PlanFromAbove) {
    Absent => false
    Present { value: s } =>
      match first_room(s: s) {
        Absent => false
        Present { value: r } => length(r.corner_images) == 8
      }
  }
}

// Under a plan the two heights of one room collapse onto the same page point, and the room's depth
// range spans the two elevations. Depth grows away from an overhead camera, so the floor is the
// farthest point of the room.
test fn a_plan_collapses_a_rooms_height_into_a_depth_range() -> Bool {
  match scene_of(w: side_by_side(), kind: PlanFromAbove) {
    Absent => false
    Present { value: s } =>
      match first_room(s: s) {
        Absent => false
        Present { value: r } => r.nearest == (0 - 2400) && r.farthest == 0
      }
  }
}

// Rooms that share no page area never contend, whatever their depths, so an ordinary plan of a floor
// orders rather than refusing. This is the claim that keeps the conservative page test from being
// useless in the common case.
test fn a_plan_of_adjacent_rooms_orders_without_refusing() -> Bool {
  match scene_of(w: side_by_side(), kind: PlanFromAbove) {
    Absent => false
    Present { value: s } => names_are(actual: ordered_names(s: s), first: "kitchen", second: "hall")
  }
}

// Stacked rooms DO share page area, and their depth ranges are disjoint, so exactly one order is
// correct: the lower storey is farther from an overhead camera and is drawn first.
test fn a_plan_of_stacked_rooms_draws_the_lower_storey_first() -> Bool {
  match scene_of(w: stacked(), kind: PlanFromAbove) {
    Absent => false
    Present { value: s } => names_are(actual: ordered_names(s: s), first: "ground", second: "upper")
  }
}

// THE REFUSAL, AND IT IS THE CONSERVATIVE PAGE TEST FIRING RATHER THAN A REAL OCCLUSION. An
// L-shaped room and a small room sitting in its notch have disjoint footprints, so the world admits
// them at the same elevations - but their page BOUNDING BOXES overlap, because the L's box covers
// its own notch. Their depth ranges are identical, so no ordering of whole rooms is decided, and the
// pair is returned rather than an order being picked. An exact page-region test would order this
// pair; until one exists, refusing is the only answer that cannot be wrong.
test fn overlapping_page_boxes_at_one_depth_refuse_to_be_ordered() -> Bool {
  match scene_of(w: notched(), kind: PlanFromAbove) {
    Absent => false
    Present { value: s } =>
      match painter_order(s: s) {
        SceneReady { value: _ } => false
        SceneRefused { cause: c } =>
          match c {
            DepthOrderAmbiguous { nearer_candidate: n, farther_candidate: f } => (n as String) != (f as String)
            SceneProjectionRefused { cause: _ } => false
          }
      }
  }
}

// The horizontal half of the page test, which the plan claims above do not reach: seen from the
// south, two rooms side by side in the east-west direction occupy disjoint page columns at the same
// depth, so they order rather than refusing.
test fn an_elevation_of_adjacent_rooms_orders_without_refusing() -> Bool {
  match scene_of(w: side_by_side(), kind: ElevationFromSouth) {
    Absent => false
    Present { value: s } => names_are(actual: ordered_names(s: s), first: "kitchen", second: "hall")
  }
}

// A world whose geometry lives in a frame the camera does not read has no projection, and the
// refusal names the projection layer's cause rather than being re-spelled here.
test fn a_world_in_another_frame_has_no_projection() -> Bool {
  match world_of(
    a: placed(name: "kitchen", frame: other_site(), x0: 0, y0: 0, x1: 3000, y1: 4000, low: 0, high: 2400),
    b: placed(name: "hall", frame: other_site(), x0: 4000, y0: 0, x1: 6000, y1: 4000, low: 0, high: 2400),
  ) {
    Absent => false
    Present { value: w } =>
      match view_of(kind: PlanFromAbove, source: site()) {
        Absent => false
        Present { value: v } =>
          match project_world(w: w, v: v) {
            SceneReady { value: _ } => false
            SceneRefused { cause: c } =>
              match c {
                SceneProjectionRefused { cause: _ } => true
                DepthOrderAmbiguous { nearer_candidate: _, farther_candidate: _ } => false
              }
          }
      }
  }
}
