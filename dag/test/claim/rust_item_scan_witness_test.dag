module test.claim.rust_item_scan_witness_test

import gunbc.rust_item_identity {
  RustFunction,
  RustImplMethod,
  RustItemIdentity,
  rust_item_identity_key
}
import gunbc.rust_item_scan {
  AttributedToFileLevel,
  AttributedToItem,
  AttributedToUnnamedMacroBlock,
  AttributionOutOfRange,
  RustFileScanned,
  RustFileScanRefused,
  RustMacroRegion,
  attribute_scanned_line,
  rust_item_kind_keyword_mapping_is_total,
  scan_item_keys,
  scan_rust_source
}
import std.types { Bool, Int, List, String }
import v2.std.algebra { any, length }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// EVERY FIXTURE PLANTS WHAT IT ASSERTS, and the reds are authored rather than argued for. The scan
// is a recognizer over source text, so the discriminating inputs are source text: a file whose
// items are known by name, and files carrying exactly the shapes that would make a recognizer
// silently wrong -- a macro invocation at a scope boundary, and Rust-looking source inside a raw
// string literal, which is the defect the deleted Python census actually committed (nine phantom
// items in one diff, recorded in gunbc.bare_reference_scanner_admission).
data fixture_ordinary_source: String = "use std::fmt;\nuse std::io::Write;\n\npub struct Thing {\n    field: u32,\n}\n\n/// doc line\n#[derive(Debug)]\npub enum Mood {\n    Calm,\n    Loud,\n}\n\npub fn free_function(x: u32) -> u32 {\n    x + 1\n}\n\nimpl std::fmt::Display for Mood {\n    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n        write!(f, \"mood\")\n    }\n}\n\nmod inner_tests {\n    use super::*;\n\n    fn helper() -> bool {\n        true\n    }\n}\n"

data fixture_raw_string_reaching_column_zero: String = "pub fn fixture_text() -> u32 {\n    let src = r#\"\nfn phantom_item() -> u32 {\n    1\n}\n\"#;\n    src.len() as u32\n}\n\npub fn after_the_body_literal() -> u32 {\n    1\n}\n"

data fixture_ordinary_string_reaching_column_zero: String = "pub fn fixture_text() -> &'static str {\n    \"\nfn phantom_item() -> u32 {\n}\n\"\n}\n"

data fixture_continued_initializer: String = "static SKIPS: std::sync::atomic::AtomicUsize =\n    std::sync::atomic::AtomicUsize::new(0);\n\nfn record_skip() {\n    SKIPS.fetch_add(1, std::sync::atomic::Ordering::SeqCst);\n}\n"

data fixture_continued_string_literal: String = "const SRC: &str =\n    \"module m\\n\\n\\\n}\\n\\\n     fn tail() {}\\n\";\n\nfn after_the_string() -> u32 {\n    1\n}\n"

data fixture_trailing_comment_after_a_declaration: String = "const PART_LEN: usize = 8 + 16; // offset, digest\nconst HEADER_LEN: usize =\n    PART_LEN * 3;\n\nfn uses_the_url() -> &'static str {\n    \"https://example.invalid/a\"\n}\n"

data fixture_header_swallowed_by_an_open_item: String = "pub fn fixture_text() -> &'static str {\n    \"\nfn phantom() -> u32 { 1 }\n\"\n}\n"

data fixture_extern_block: String = "extern \"C\" {\n    fn getrusage(who: i32) -> i32;\n}\n"

data fixture_header_opened_raw_string: String = "pub const FIXTURE_SRC: &str = r#\"\nfn phantom_item() -> u32 {\n    1\n}\n\"#;\n\npub fn after_the_literal() -> u32 {\n    1\n}\n"

data fixture_const_and_const_fn: String = "pub const LIMIT: u32 = 4;\n\npub const fn doubled() -> u32 {\n    LIMIT * 2\n}\n"

// THE WRAPPED FORMS ARE THE POPULATION, NOT THE EXCEPTION. Measured over the seed's hand-maintained
// Rust before these three scopes existed, wrapped `use` lists alone put 58 files out of reach and
// multi-line `#[derive(...)]` a further dozen -- a reader that refused them would have been safe and
// useless, which is the other way a fail-closed recognizer fails. Each fixture carries the wrapped
// form AND a following item, because finding the following item is what separates a reader that
// consumed the continuation from one that swallowed the rest of the file.
data fixture_wrapped_use_and_derive: String = "use std::collections::{\n    HashMap, HashSet,\n};\n\n#[derive(\n    Debug, Clone, PartialEq,\n)]\npub struct Wrapped {\n    field: u32,\n}\n\npub fn after_the_wrapping() -> u32 {\n    1\n}\n"

data fixture_macro_block: String = "use std::fmt;\n\nmacro_rules! counter {\n    () => { 0 };\n}\n\npub fn after_the_macro() -> u32 {\n    1\n}\n"

data fixture_thread_local_block: String = "use std::cell::RefCell;\n\nmod probe_inner {\n    thread_local! {\n        #[allow(dead_code)]\n        pub static COUNTER: RefCell<u32> = RefCell::new(0);\n        static BIG: RefCell<Vec<u32>> = RefCell::new(vec![\n            1, 2,\n        ]);\n    }\n}\n\npub fn after_the_thread_local() -> u32 {\n    1\n}\n"

data fixture_thread_local_non_static: String = "thread_local! {\n    fn not_a_static() -> u32 {\n        1\n    }\n}\n"

data fixture_thread_local_one_line: String = "thread_local!(static ONE: u32 = 1);\n"

fn ordinary_scan_keys() -> List<String> {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_ordinary_source) {
    RustFileScanned { repo_path: _, items: items, macro_regions: _, line_count: _ } => scan_item_keys(items: items)
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => []
  }
}

fn key_present(keys: List<String>, key: String) -> Bool {
  any(xs: keys, predicate: fn(k) { k == key })
}

// THE ITEMS ARE REQUIRED BY NAME AND NOT BY COUNT. A count assertion is satisfied by a recognizer
// that finds the right NUMBER of wrong things -- which is exactly how the deleted census reported
// eighteen items for a nine-item diff -- so every arm here names the identity it expects.
test fn scan_recovers_every_item_by_name() -> Bool {
  let keys = ordinary_scan_keys()
  key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::struct::Thing")
    && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::enum::Mood")
    && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::free_function")
    && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::impl_block::std::fmt::Display for Mood")
    && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::impl_method::std::fmt::Display for Mood::fmt")
    && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::mod::inner_tests")
    && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::inner_tests.helper")
}

// THE INLINE MODULE'S MEMBER CARRIES ITS MODULE PATH, which is the fact that makes the citation
// vocabulary joinable: gunbc.declaration_index_seed_growth cites seven declarations under
// v1_compiler.cli_run.bare_reference_scanner_tests. A reader that recorded `helper` bare would
// collide it with any file-level `helper` in the same file, and the join would silently treat an
// addition as already justified.
test fn inline_module_members_are_qualified_not_bare() -> Bool {
  let keys = ordinary_scan_keys()
  key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::inner_tests.helper")
    && !key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::helper")
}

test fn a_wrapped_use_list_and_derive_attribute_do_not_hide_the_following_item() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_wrapped_use_and_derive) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } => {
      let keys = scan_item_keys(items: items)
      key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::struct::Wrapped")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::after_the_wrapping")
        && match attribute_scanned_line(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 5
        ) {
          AttributedToItem { item_key: key } => key == "src/v1/stage0/src/probe.rs::struct::Wrapped"
          AttributedToFileLevel => false
          AttributedToUnnamedMacroBlock { macro_name: _, line: _ } => false
          AttributionOutOfRange { line: _, line_count: _ } => false
        }
    }
  }
}

// AN UNMODELED MACRO BLOCK IS AN EXTENT WITH NO ITEM AND A CHANGE INSIDE IT IS NOT FILE-LEVEL. Three
// facts are required together and each is a different way to get this wrong: the file must scan
// (refusing it would put every file carrying a macro_rules! permanently out of the census); the
// macro must mint no item (the grammar authority has no macro item form, and inventing one here
// would be the second roster this reader exists not to author); and a line inside it must NOT come
// back file-level, because an arm added inside macro_rules! is hand-Rust growth and file-level is
// the answer that would admit it silently.
test fn a_macro_block_is_an_extent_with_no_item_and_its_lines_are_unattributed() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_macro_block) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } => {
      let keys = scan_item_keys(items: items)
      key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::after_the_macro")
        && length(xs: items) == 1
        && length(xs: macro_regions) == 1
        && match attribute_scanned_line(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 4
        ) {
          AttributedToUnnamedMacroBlock { macro_name: name, line: _ } => name == "macro_rules"
          AttributedToFileLevel => false
          AttributedToItem { item_key: _ } => false
          AttributionOutOfRange { line: _, line_count: _ } => false
        }
    }
  }
}

// thread_local! IS THE ONE MACRO WHOSE BODY IS NAMED, BECAUSE UPSTREAM NAMES IT. std documents its
// body as "any number of static declarations", each with optional attributes and visibility
// (extdeps.rust.std_thread_local, cited at the pinned 1.93.0 docs). So each static is an item of the
// ENCLOSING module -- here an inline module, so the key carries its path -- the attribute above a
// static belongs to that static's extent, a multi-line initializer closes at its own bracket, no
// macro region is recorded, and the item after the block is still found. A changed line inside a
// static attributes to that static BY NAME, which is the fact gunbc#12886's census could not report.
test fn a_thread_local_static_is_an_item_of_the_enclosing_module_and_its_lines_attribute_to_it() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_thread_local_block) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } => {
      let keys = scan_item_keys(items: items)
      key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::static::probe_inner.COUNTER")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::static::probe_inner.BIG")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::mod::probe_inner")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::after_the_thread_local")
        && length(xs: items) == 4
        && length(xs: macro_regions) == 0
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 5,
          key: "src/v1/stage0/src/probe.rs::static::probe_inner.COUNTER"
        )
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 8,
          key: "src/v1/stage0/src/probe.rs::static::probe_inner.BIG"
        )
    }
  }
}

// THE CITATION ADMITS STATICS AND NOTHING ELSE. A thread_local! body line that is not a static, an
// attribute or a comment is not something the upstream grammar describes, so it refuses rather than
// being read as an item of whatever keyword it happens to start with.
test fn a_non_static_line_inside_thread_local_refuses() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_thread_local_non_static) {
    RustFileScanRefused { repo_path: _, line: line, line_text: _, detail: _ } => line == 2
    RustFileScanned { repo_path: _, items: _, macro_regions: _, line_count: _ } => false
  }
}

// A ONE-LINE thread_local! DECLARES A STATIC THIS READER CANNOT SPLIT OUT WITHOUT A LEXER. Reading it
// as a file-level line -- which every other one-line macro invocation is -- would admit an added
// static silently, so it refuses.
test fn a_one_line_thread_local_refuses_rather_than_reading_file_level() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_thread_local_one_line) {
    RustFileScanRefused { repo_path: _, line: line, line_text: _, detail: _ } => line == 1
    RustFileScanned { repo_path: _, items: _, macro_regions: _, line_count: _ } => false
  }
}

// AN UNRECOGNIZED STRUCTURAL LINE STILL REFUSES, and this arm is what keeps the three continuation
// scopes above from having quietly become a catch-all. `lazy_static!` opens a macro block, so the
// fixture that used to make this point no longer does; a bare brace at a scope boundary is not a
// macro, not an item header, not a use and not an attribute, and there is no arm that admits it.
test fn an_unrecognized_structural_line_refuses() -> Bool {
  match scan_rust_source(
    repo_path: "src/v1/stage0/src/probe.rs",
    content: "use std::fmt;\n\n{\n    1\n}\n"
  ) {
    RustFileScanRefused { repo_path: _, line: line, line_text: _, detail: _ } => line == 3
    RustFileScanned { repo_path: _, items: _, macro_regions: _, line_count: _ } => false
  }
}

// THE PHANTOM-ITEM DEFECT, AUTHORED AS ITS OWN RED, IN BOTH OF ITS SHAPES. The deleted census read
// source as text and counted `fn phantom_item` inside a raw string literal as a Rust item, nine
// times in one diff.
//
// This fixture opens its literal inside a function BODY -- `let src = r#"` -- which is how every
// witness binary in the seed plants a .dag fixture, and it was the shape the reader did not track:
// the literal's own column-zero `}` (line 5) closed the fn early and its `"#;` then refused the
// file, which is what put interp_recorded_fixture_witness.rs out of gunbc#12886's census. An item
// ends at its own closing brace and a brace inside a literal is not one, so four facts are required
// together: the file scans; the fn spans its true extent through the literal to its real close; the
// declaration planted inside the literal is not an item; and a changed line inside the literal,
// INCLUDING the `"#;` line at the item's own indent, attributes to the fn that owns the literal.
// That last is the red for reading a body literal's terminator as the item's close, which a
// header-opened constant's `"#;` legitimately is.
test fn a_body_opened_raw_string_is_skipped_whole_and_its_lines_attribute_to_the_owning_fn() -> Bool {
  match scan_rust_source(
    repo_path: "src/v1/stage0/src/probe.rs",
    content: fixture_raw_string_reaching_column_zero
  ) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } => {
      let keys = scan_item_keys(items: items)
      key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::fixture_text")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::after_the_body_literal")
        && !key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::phantom_item")
        && length(xs: items) == 2
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 5,
          key: "src/v1/stage0/src/probe.rs::fn::fixture_text"
        )
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 6,
          key: "src/v1/stage0/src/probe.rs::fn::fixture_text"
        )
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 7,
          key: "src/v1/stage0/src/probe.rs::fn::fixture_text"
        )
    }
  }
}

fn fixture_line_attributes_to(
  items: List<RustItemIdentity>,
  macro_regions: List<RustMacroRegion>,
  line_count: Int,
  line: Int,
  key: String
) -> Bool {
  match attribute_scanned_line(items: items, macro_regions: macro_regions, line_count: line_count, line: line) {
    AttributedToItem { item_key: k } => k == key
    AttributedToFileLevel => false
    AttributedToUnnamedMacroBlock { macro_name: _, line: _ } => false
    AttributionOutOfRange { line: _, line_count: _ } => false
  }
}

// AN EXPRESSION-BODIED ITEM ENDS AT ITS OWN SEMICOLON EVEN WHEN rustfmt CONTINUES IT A LINE DOWN.
// `static NAME: T =` broken before its initializer puts the closing `;` at the continuation indent;
// a reader that asked only the item's own indent kept the static open, and the fn after it was
// swallowed until that fn's `}` -- never an item, and an edit to it attributed to the static. That
// was cli_run.rs `static PROVIDER_BOOTSTRAP_STORE_SKIPS` over `fn record_provider_bootstrap_store_skip`,
// a silent mis-attribution rather than a refusal. Line 5 is inside the fn and must say so.
test fn a_continued_static_initializer_ends_at_its_semicolon_and_the_next_fn_is_an_item() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_continued_initializer) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } =>
      length(xs: items) == 2
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 2,
          key: "src/v1/stage0/src/probe.rs::static::SKIPS"
        )
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 5,
          key: "src/v1/stage0/src/probe.rs::fn::record_skip"
        )
  }
}

// A LINE AFTER A BACKSLASH IS STRING TEXT AT WHATEVER INDENT ITS AUTHOR CHOSE. The fixture's const
// carries an ordinary string continued with `\`: a continued line that is exactly `}` at column
// zero (line 3), Rust-looking text at column five (line 4), and the `";` that ends the literal and the
// declaration. None of it is structure, the const ends at that `;`, and the fn after it is found.
test fn a_string_continued_with_a_backslash_is_text_and_the_const_ends_at_its_semicolon() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_continued_string_literal) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } => {
      let keys = scan_item_keys(items: items)
      length(xs: items) == 2
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::after_the_string")
        && !key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::tail")
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 3,
          key: "src/v1/stage0/src/probe.rs::const::SRC"
        )
    }
  }
}

// A TRAILING COMMENT DOES NOT HOLD A DECLARATION OPEN. `const PART_LEN: usize = 8 + 16; // ...` ends
// at its semicolon; read to the comment's last character it stayed open and swallowed the const
// after it, silently (resolved_graph_cache.rs PART_DESCRIPTOR_LEN over V3_HEADER_LEN). Three items,
// each where it really is: line 2 belongs to HEADER_LEN and not to PART_LEN.
test fn a_trailing_comment_does_not_hold_a_declaration_open() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_trailing_comment_after_a_declaration) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } =>
      length(xs: items) == 3
        && fixture_line_attributes_to(
          items: items,
          macro_regions: macro_regions,
          line_count: line_count,
          line: 2,
          key: "src/v1/stage0/src/probe.rs::const::HEADER_LEN"
        )
  }
}

// AN ITEM HEADER AT THE OPEN ITEM'S OWN INDENT REFUSES; IT IS NEVER READ AS BODY. This is the guard
// that makes the swallow class structural rather than a bug-by-bug hunt (gunbc.recurring_failure_mode
// census_instrument_silently_drops_items): whatever leaves an item open past its end -- a continued
// initializer, a trailing comment, an ordinary multi-line string -- next meets a sibling header at
// the open item's own indent, and a header there is not something an item's body contains. Before
// the guard the fixture's line 3 was silently body of fixture_text and `phantom` simply did not
// exist; now the file stops at line 3.
test fn an_item_header_at_the_open_items_own_indent_refuses_rather_than_being_swallowed() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_header_swallowed_by_an_open_item) {
    RustFileScanRefused { repo_path: _, line: line, line_text: _, detail: _ } => line == 3
    RustFileScanned { repo_path: _, items: _, macro_regions: _, line_count: _ } => false
  }
}

// THE RAW-STRING REPAIR IS NOT A CATCH-ALL FOR LITERALS. An ORDINARY string continued across lines
// carries no self-describing terminator this reader can recover without a lexer, so it is not
// tracked, and the file refuses. It now refuses at line 3, the literal's `fn phantom_item` header at
// the open fn's own indent, rather than at line 5 after the literal's `}` had already closed the fn
// early: the header guard stops the line at the first sibling header. Refusing is the named
// residual, and this arm is what keeps the repair from having quietly become "skip anything that
// looks like a literal".
test fn an_ordinary_string_reaching_column_zero_still_refuses() -> Bool {
  match scan_rust_source(
    repo_path: "src/v1/stage0/src/probe.rs",
    content: fixture_ordinary_string_reaching_column_zero
  ) {
    RustFileScanRefused { repo_path: _, line: line, line_text: _, detail: _ } => line == 3
    RustFileScanned { repo_path: _, items: _, macro_regions: _, line_count: _ } => false
  }
}

// AN UNRELATED UNSCANNABLE CONSTRUCT STILL REFUSES. `extern "C" { ... }` declares foreign items the
// grammar authority carries no form for (src/v1/stage0/src/phase_profile.rs carries one), and
// nothing in the literal repair reaches it.
test fn an_extern_block_still_refuses() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_extern_block) {
    RustFileScanRefused { repo_path: _, line: line, line_text: _, detail: _ } => line == 1
    RustFileScanned { repo_path: _, items: _, macro_regions: _, line_count: _ } => false
  }
}

// THE SECOND SHAPE IS THE COMMON ONE IN THIS TREE AND IT MUST NOT MERELY REFUSE. A `const … = r#"`
// fixture table is how most Rust source in this seed carries planted .dag and Rust text, and a
// reader that refused every such file would refuse most of the population it exists to census --
// safe, and useless. The literal's terminator is recovered from its own opening delimiter, so the
// constant closes where it really closes, the item after it is found, and the declaration planted
// inside the literal is not. All three are required together: finding the following item is what
// separates a reader that skipped the literal from one that swallowed the rest of the file.
test fn a_header_opened_raw_string_is_skipped_whole_and_mints_no_item() -> Bool {
  match scan_rust_source(
    repo_path: "src/v1/stage0/src/probe.rs",
    content: fixture_header_opened_raw_string
  ) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: _, line_count: _ } => {
      let keys = scan_item_keys(items: items)
      key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::const::FIXTURE_SRC")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::after_the_literal")
        && !key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::phantom_item")
    }
  }
}

// `const` IS BOTH A MODIFIER AND AN ITEM KEYWORD, and the two spellings must not collapse. A reader
// that peeled `const` unconditionally records the constant as a function named nothing; one that
// never peeled it records `const fn doubled` as a constant named `fn`. Both fixtures are in one
// file so a repair in either direction reds here.
test fn const_item_and_const_fn_are_distinguished() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_const_and_const_fn) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: _, line_count: _ } => {
      let keys = scan_item_keys(items: items)
      key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::const::LIMIT")
        && key_present(keys: keys, key: "src/v1/stage0/src/probe.rs::fn::doubled")
    }
  }
}

// THE INNERMOST CONTAINING ITEM WINS. A method's lines lie inside both the method and its impl
// block; reporting the impl block would attribute a method edit to the enclosing scope, which is
// how a new capability lands with nothing to report.
test fn attribution_reports_the_innermost_item() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_ordinary_source) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } =>
      match attribute_scanned_line(items: items, macro_regions: macro_regions, line_count: line_count, line: 20) {
        AttributedToItem { item_key: key } =>
          key == "src/v1/stage0/src/probe.rs::impl_method::std::fmt::Display for Mood::fmt"
        AttributedToFileLevel => false
        AttributedToUnnamedMacroBlock { macro_name: _, line: _ } => false
        AttributionOutOfRange { line: _, line_count: _ } => false
      }
  }
}

test fn a_use_line_attributes_to_file_level_and_not_to_an_item() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_ordinary_source) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } =>
      match attribute_scanned_line(items: items, macro_regions: macro_regions, line_count: line_count, line: 1) {
        AttributedToFileLevel => true
        AttributedToItem { item_key: _ } => false
        AttributedToUnnamedMacroBlock { macro_name: _, line: _ } => false
        AttributionOutOfRange { line: _, line_count: _ } => false
      }
  }
}

test fn a_line_beyond_the_file_is_out_of_range_and_not_file_level() -> Bool {
  match scan_rust_source(repo_path: "src/v1/stage0/src/probe.rs", content: fixture_const_and_const_fn) {
    RustFileScanRefused { repo_path: _, line: _, line_text: _, detail: _ } => false
    RustFileScanned { repo_path: _, items: items, macro_regions: macro_regions, line_count: line_count } =>
      match attribute_scanned_line(items: items, macro_regions: macro_regions, line_count: line_count, line: line_count + 50) {
        AttributionOutOfRange { line: _, line_count: _ } => true
        AttributedToFileLevel => false
        AttributedToUnnamedMacroBlock { macro_name: _, line: _ } => false
        AttributedToItem { item_key: _ } => false
      }
  }
}

// THE KEYWORD MAPPING IS CHECKED AGAINST THE GRAMMAR AUTHORITY RATHER THAN AGAINST ITSELF. A
// keyword added to extdeps.languages.rust.syntax rust_item_forms and not named in the kind mapping
// would otherwise acquire a plausible kind in silence.
test fn every_grammar_authority_item_keyword_has_a_named_kind() -> Bool {
  rust_item_kind_keyword_mapping_is_total()
}
