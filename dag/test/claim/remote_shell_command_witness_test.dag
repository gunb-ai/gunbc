module test.claim.remote_shell_command_witness

import gunbc.remote_shell_command {
  simple_command,
  emit_remote_shell,
  remote_exec_command_string,
  SimpleCommandBuilt,
  SimpleCommandRefused,
  RemoteExecCommandBuilt,
  RemoteExecCommandRefused,
  PosixShellInterpreted,
  Unknown,
}

data remote_shell_command_witness_note: String = "Hermetic proof that emit_remote_shell matches the cited IEEE 1003.1-2017 section 2.2.2 single-quote encoding exactly on fixtures, per gunbc.remote_shell_command remote_shell_command_single_quote_encoding_law_note -- an exact-string structural check against each fixture's known-correct encoding, not a round trip through a hand-rolled parser (that design was replaced: it was a self-consistent oracle over this module's own two halves). Fixtures cover a word containing a single quote (exercises the quote-backslash-quote-quote escape), a word containing a space, and a word containing shell metacharacters (both trivial under single-quote wrapping -- the point of the restricted encoding is that these stop being distinct hazards). No live SSH target is touched here -- see remote_exec_command_live_confirmation for the declared, unexecuted remote-side receipt."

fn emitted(argv: List<NonEmptyStr>) -> String {
  match simple_command(argv: argv) {
    SimpleCommandRefused { cause: _ } => "REFUSED"
    SimpleCommandBuilt { command: cmd } => emit_remote_shell(command: cmd) as String
  }
}

test fn witness_plain_word_holds() -> Bool {
  emitted(argv: ["whoami"]) == "'whoami'"
}

test fn witness_multi_word_argv_holds() -> Bool {
  emitted(argv: ["jq", "-r", ".status"]) == "'jq' '-r' '.status'"
}

test fn witness_single_quote_word_holds() -> Bool {
  emitted(argv: ["it's-a-test"]) == "'it'\\''s-a-test'"
}

test fn witness_space_word_holds() -> Bool {
  emitted(argv: ["a path with spaces/file.txt"]) == "'a path with spaces/file.txt'"
}

test fn witness_metacharacter_word_holds() -> Bool {
  emitted(argv: ["$(whoami); rm -rf / #"]) == "'$(whoami); rm -rf / #'"
}

test fn witness_jq_program_holds() -> Bool {
  emitted(argv: [".data[] | select(.ready == true) | .name"]) == "'.data[] | select(.ready == true) | .name'"
}

test fn witness_emit_remote_shell_produces_one_string_holds() -> Bool {
  match simple_command(argv: ["jq", "it's here"]) {
    SimpleCommandRefused { cause: _ } => false
    SimpleCommandBuilt { command: cmd } =>
      emit_remote_shell(command: cmd) as String == "'jq' 'it'\\''s here'"
  }
}

test fn witness_simple_command_refuses_empty_argv_holds() -> Bool {
  match simple_command(argv: []) {
    SimpleCommandBuilt { command: _ } => false
    SimpleCommandRefused { cause: _ } => true
  }
}

test fn witness_remote_exec_command_string_refuses_unknown_interpretation_holds() -> Bool {
  match remote_exec_command_string(argv: ["echo", "hi"], interpretation: Unknown) {
    RemoteExecCommandBuilt { command: _ } => false
    RemoteExecCommandRefused { cause: _ } => true
  }
}

test fn witness_remote_exec_command_string_builds_under_posix_shell_interpretation_holds() -> Bool {
  match remote_exec_command_string(argv: ["jq", ".status"], interpretation: PosixShellInterpreted) {
    RemoteExecCommandRefused { cause: _ } => false
    RemoteExecCommandBuilt { command: c } =>
      c as String == "'jq' '.status'"
  }
}
