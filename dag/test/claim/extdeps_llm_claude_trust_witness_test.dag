module test.claim.extdeps_llm_claude_trust_witness

import std.types { String, Bool }
import extdeps.llm.cli {
  claude_cli_program,
  claude_trust_store_path,
  claude_workspace_trust_seeded,
  shape_claude_invoke_argv,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn root() -> String { "/opt/gunbc/dispatch-worktrees" }

fn seeded(config: String) -> Bool {
  claude_workspace_trust_seeded(config_text: config, project_path: root())
}

test fn w_trust_store_path_shape() -> Bool {
  claude_trust_store_path(home: "/home/u") == "/home/u/.claude.json"
}

test fn w_minimal_seeded_entry_accepts() -> Bool {
  seeded(config: "\{\"projects\":\{\"/opt/gunbc/dispatch-worktrees\":\{\"hasTrustDialogAccepted\":true\}\}\}")
}

test fn w_whitespace_variant_accepts() -> Bool {
  seeded(config: "\{\n  \"projects\": \{\n    \"/opt/gunbc/dispatch-worktrees\": \{\n      \"hasTrustDialogAccepted\" : true\n    \}\n  \}\n\}")
}

test fn w_enriched_entry_with_nested_object_and_brace_in_string_accepts() -> Bool {
  seeded(config: "\{\"projects\":\{\"/opt/gunbc/dispatch-worktrees\":\{\"mcpServers\":\{\"a\":\{\}\},\"lastSessionFirstPrompt\":\"fix \} brace\",\"hasTrustDialogAccepted\":true\}\}\}")
}

test fn w_flag_false_refuses() -> Bool {
  !seeded(config: "\{\"projects\":\{\"/opt/gunbc/dispatch-worktrees\":\{\"hasTrustDialogAccepted\":false\}\}\}")
}

test fn w_flag_true_on_other_key_refuses() -> Bool {
  !seeded(config: "\{\"projects\":\{\"/opt/gunbc/dispatch-worktrees\":\{\"hasTrustDialogAccepted\":false,\"hasCompletedProjectOnboarding\":true\}\}\}")
}

test fn w_absent_root_refuses() -> Bool {
  !seeded(config: "\{\"projects\":\{\"/opt/other\":\{\"hasTrustDialogAccepted\":true\}\}\}")
}

test fn w_path_as_array_value_is_not_a_key() -> Bool {
  !seeded(config: "\{\"githubRepoPaths\":\{\"o/r\":[\"/opt/gunbc/dispatch-worktrees\"]\}\}")
}

test fn w_array_value_then_real_key_accepts() -> Bool {
  seeded(config: "\{\"githubRepoPaths\":\{\"o/r\":[\"/opt/gunbc/dispatch-worktrees\"]\},\"projects\":\{\"/opt/gunbc/dispatch-worktrees\":\{\"hasTrustDialogAccepted\":true\}\}\}")
}

test fn w_empty_and_garbage_refuse() -> Bool {
  !seeded(config: "")
    && !seeded(config: "not json at all")
    && !seeded(config: "\{\"projects\":\{\"/opt/gunbc/dispatch-worktrees\":")
}

test fn w_argv_head_is_program_authority() -> Bool {
  let argv = shape_claude_invoke_argv(
    session_id: "u",
    node_id: "n",
    effort: "high",
    settings_json: "\{\}",
    append_system_prompt: "brief",
    start_prompt: "go",
    permission_args: [],
  )
  match argv.first() {
    Present { value: head } => head == claude_cli_program
    Absent => false
  }
}

