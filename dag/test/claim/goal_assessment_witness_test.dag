module test.claim.goal_assessment_witness

import std.types { String, Bool }
import std.goal_assessment {
  ObservationAttempt, ObservationEstablished, ObservationRefused,
  GoalAssessment, GoalSatisfied, GoalDiverged, GoalIndeterminate,
  GoalInspected, GoalObservationRefused,
  inspect_goal,
  assess_by_deviations,
  assess_by_deviations_and_unknowns,
}

type FixtureSubject { key: String }
type FixtureObserved { value: String }
type FixtureEvidence { field: String }
type FixtureDeviation { field: String }
type FixtureUnknownFact { field: String }
// Two DISTINCT refusal types, one per layer. That is what makes the guard claim below
// discriminating: a root that reached the assessor on an unobserved subject could not return the
// observer's refusal at all.
type FixtureObserveRefusal = FixtureUnreadable { detail: String }
type FixtureAssessRefusal = FixtureAssessorShouldNotRun { detail: String }

fn fixture_observe(_: FixtureSubject, readable: Bool) -> ObservationAttempt<FixtureObserved, FixtureObserveRefusal> {
  if readable {
    ObservationEstablished { observed: FixtureObserved { value: "observed" } }
  } else {
    ObservationRefused { cause: FixtureUnreadable { detail: "fixture read refusal" } }
  }
}

// The assessor answers AGREEMENT through the mint rather than by writing the arm, so this fixture
// exercises the same construction every real binding uses.
fn fixture_assess(_: FixtureObserved) -> GoalAssessment<FixtureEvidence, FixtureDeviation, FixtureUnknownFact, FixtureAssessRefusal> {
  assess_by_deviations(evidence: FixtureEvidence { field: "unchanged" }, deviations: [])
}

// DISCRIMINATING RED for the layer guard. An unreadable subject must never reach the assessor. The
// refusal the assessor would answer with is a DIFFERENT type from the one the observer answers
// with, so a root that assessed an unobserved subject could not even return this arm -- and the
// arm it did return would name FixtureAssessorShouldNotRun, which is the located evidence that the
// guard was skipped rather than a bare false.
test fn unreadable_subject_refuses_before_the_assessor_runs() -> Bool {
  match inspect_goal(
    subject: FixtureSubject { key: "fixture" },
    scope: false,
    observe: fixture_observe,
    assess: fixture_assess,
  ) {
    GoalObservationRefused { subject: s, cause: FixtureUnreadable { detail: _ } } => s.key == "fixture"
    _ => false
  }
}

// The positive control the refusal above is measured against: same root, same operations, a
// readable subject in agreement. Without it the RED is satisfiable by a root that refuses
// everything.
test fn readable_subject_in_agreement_is_satisfied() -> Bool {
  match inspect_goal(
    subject: FixtureSubject { key: "fixture" },
    scope: true,
    observe: fixture_observe,
    assess: fixture_assess,
  ) {
    GoalInspected { subject: _, observed: _, assessment: GoalSatisfied { evidence: e } } => e.field == "unchanged"
    _ => false
  }
}

// LAW: a divergence is nonempty. The empty list must reach the SATISFIED arm and not a divergence
// naming nothing. This is the executing half of a wall whose other half is structural: the
// divergent arm carries FreeSemigroup, which has no empty inhabitant, so the state this test
// guards against has no constructor to reach. The test is what proves the mint routes rather than
// that the type exists.
test fn an_empty_deviation_list_is_agreement_not_an_empty_divergence() -> Bool {
  match assess_by_deviations(
    evidence: FixtureEvidence { field: "agreed" },
    deviations: [],
  ) {
    GoalSatisfied { evidence: e } => e.field == "agreed"
    _ => false
  }
}

// The other direction of the same mint: a nonempty list must arrive as a divergence whose head is
// the list's head. A mint that dropped the head, or that reordered, would still typecheck.
test fn deviations_reach_the_divergent_arm_head_first() -> Bool {
  match assess_by_deviations(
    evidence: FixtureEvidence { field: "unused" },
    deviations: [FixtureDeviation { field: "enforcement" }, FixtureDeviation { field: "target" }],
  ) {
    GoalDiverged { deviations: ds } => ds.head.field == "enforcement" && length(ds.tail) == 1
    _ => false
  }
}

// LAW: unknown is not absent, and an unknown does not erase what WAS proved. Two mismatches were
// established and one required fact was not. The assessment must be indeterminate -- so generic
// remediation is refused -- AND it must still carry both proved deviations, because an
// unestablished fact suppressing a known one is how a real drift goes unreported behind a
// transient read failure.
test fn an_unknown_outranks_deviations_and_still_carries_them() -> Bool {
  match assess_by_deviations_and_unknowns(
    evidence: FixtureEvidence { field: "unused" },
    deviations: [FixtureDeviation { field: "enforcement" }, FixtureDeviation { field: "target" }],
    unknowns: [FixtureUnknownFact { field: "bypass_roster" }],
  ) {
    GoalIndeterminate { known_deviations: ds, unknowns: us } =>
      length(ds) == 2 && us.head.field == "bypass_roster"
    _ => false
  }
}
