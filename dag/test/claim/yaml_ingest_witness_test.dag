module test.claim.yaml_ingest_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn round_trips(v: YamlValue) -> Bool {
  let original = extdeps.languages.yaml.emit.serialize_yaml(v: v)
  match extdeps.languages.yaml.ingest.ingest_yaml_source(src: original) {
    extdeps.languages.yaml.ingest.IngestedYaml { value: reparsed } => extdeps.languages.yaml.emit.serialize_yaml(v: reparsed) == original
    extdeps.languages.yaml.ingest.YamlIngestRejected { reason: _ } => false
  }
}

fn witness_scalar_mapping_round_trips() -> Bool {
  round_trips(v: extdeps.languages.yaml.types.yaml_mapping(entries: [
    extdeps.languages.yaml.types.kv(key: "name", value: extdeps.languages.yaml.types.yaml_string(s: "ci")),
    extdeps.languages.yaml.types.kv(key: "fetch-depth", value: extdeps.languages.yaml.types.yaml_int(n: 0)),
    extdeps.languages.yaml.types.kv(key: "quoted", value: extdeps.languages.yaml.types.yaml_bool(b: true))
  ]))
}

fn witness_nested_sequence_of_mappings_round_trips() -> Bool {
  round_trips(v: extdeps.languages.yaml.types.yaml_mapping(entries: [
    extdeps.languages.yaml.types.kv(key: "jobs", value: extdeps.languages.yaml.types.yaml_sequence(elements: [
      extdeps.languages.yaml.types.yaml_mapping(entries: [
        extdeps.languages.yaml.types.kv(key: "uses", value: extdeps.languages.yaml.types.yaml_string(s: "actions/checkout@v4")),
        extdeps.languages.yaml.types.kv(key: "with", value: extdeps.languages.yaml.types.yaml_mapping(entries: [
          extdeps.languages.yaml.types.kv(key: "fetch-depth", value: extdeps.languages.yaml.types.yaml_int(n: 1))
        ]))
      ])
    ]))
  ]))
}

fn witness_block_literal_round_trips() -> Bool {
  round_trips(v: extdeps.languages.yaml.types.yaml_mapping(entries: [
    extdeps.languages.yaml.types.kv(key: "run", value: extdeps.languages.yaml.types.yaml_string(s: "line one\nline two"))
  ]))
}

fn witness_empty_string_scalar_round_trips() -> Bool {
  round_trips(v: extdeps.languages.yaml.types.yaml_mapping(entries: [extdeps.languages.yaml.types.kv(key: "rustflags", value: extdeps.languages.yaml.types.yaml_string(s: ""))]))
}

fn witness_real_ci_yml_parses() -> Bool {
  extdeps.languages.yaml.ingest.yaml_source_parses(src: gunbc.ci_yaml_emit.expected_ci_yml())
}

fn witness_empty_document_rejected() -> Bool {
  extdeps.languages.yaml.ingest.yaml_source_parses(src: "") == false
}

fn witness_malformed_scalar_line_rejected() -> Bool {
  extdeps.languages.yaml.ingest.yaml_source_parses(src: "just a bare word\n") == false
}

fn witness_bad_nested_indent_rejected() -> Bool {
  extdeps.languages.yaml.ingest.yaml_source_parses(src: "a:\n   b: 1\n") == false
}

fn witness_rejection_discriminates_from_valid() -> Bool {
  extdeps.languages.yaml.ingest.yaml_source_parses(src: "a: 1\n") &&
    !extdeps.languages.yaml.ingest.yaml_source_parses(src: "just a bare word\n")
}

test fn yaml_ingest_keystone_holds() -> Bool {
  witness_scalar_mapping_round_trips() &&
    witness_nested_sequence_of_mappings_round_trips() &&
    witness_block_literal_round_trips() &&
    witness_empty_string_scalar_round_trips() &&
    witness_real_ci_yml_parses() &&
    witness_empty_document_rejected() &&
    witness_malformed_scalar_line_rejected() &&
    witness_bad_nested_indent_rejected() &&
    witness_rejection_discriminates_from_valid()
}
