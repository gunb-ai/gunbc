module test.claim.probe_union_member

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data unique_src: String = "module probe_um_a\n\ntype Solo {\n  n: Int\n}\n\ntype Nothing2 {\n  tag: Int\n}\n\ntype PickUnique = Solo | Nothing2\n\nfn pick_solo() -> PickUnique {\n  Solo { n: 1 }\n}\n"

data imported_src: String = "module probe_um_b\n\nimport std.nat { Nat }\n\ntype Nothing3 {\n  tag: Int\n}\n\ntype NatOrNone = Nat | Nothing3\n\nfn pick() -> NatOrNone {\n  Nothing3 { tag: 1 }\n}\n"

data fresh_src: String = "module probe_um_c\n\ntype Pick3 = Alpha | Beta\n\nfn pick() -> Pick3 {\n  Alpha\n}\n"

fn p_unique_accepted() -> Bool { blocking_count(unique_src) == 0 }
fn p_unique_enum_present() -> Bool { compile_dag_rust_emit_check(unique_src, "src/probe_um_a.rs", ["pub enum PickUnique"], []) }
fn p_unique_unit_struct_minted() -> Bool { compile_dag_rust_emit_check(unique_src, "src/probe_um_a.rs", ["pub struct Solo;"], []) }
fn p_unique_record_struct_present() -> Bool { compile_dag_rust_emit_check(unique_src, "src/probe_um_a.rs", ["pub struct Solo {"], []) }
fn p_imported_accepted() -> Bool { blocking_count(imported_src) == 0 }
fn p_imported_unit_struct_minted() -> Bool { compile_dag_rust_emit_check(imported_src, "src/probe_um_b.rs", ["pub struct Nat;"], []) }
fn p_fresh_accepted() -> Bool { blocking_count(fresh_src) == 0 }
fn p_fresh_unit_struct_minted() -> Bool { compile_dag_rust_emit_check(fresh_src, "src/probe_um_c.rs", ["pub struct Alpha;"], []) }
