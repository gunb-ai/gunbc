module test.claim.roadmap_register_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data roadmap_register_witness_note: String = "The roadmap dashboard as a register SITE INSTANCE (slice 1 of the roadmap-onto-register refactor, parent-acked 2026-07-21): the instance inherits the register laws by executing them over its own emission — themes_coherent over the exact Theme rows roadmap_css projects (totality, area coherence, chroma admissibility, WCAG contrast — one law set, N surfaces, never a roadmap fork); the unthemed-color census over the exact BuildRule rows the page serializes, with the RED a resurrection of the precise historical regression this refactor deleted (the hand-hex #0969da link blue) proving the census discriminates rather than vacuously passing; the shared Confluence mark consumed at nav depth from the one render authority (favicon/nav/hero cannot disagree, mark.dag). Slice 2 (manager-signed) flipped the response pin deliberately: the dispatch button's behaviors are declared rows (Approach->Brighten, Dispatch->Receipt) REALIZED through roadmap_realize_behavior — coverage total, unrealized census empty, both with located REDs (a dropped row NAMES its gap; a row with no realize arm is counted, never silently skipped) — and the reduced-motion collapse ships derived from the same rules. The Dashboard archetype rows are cross-checked BOTH directions against the shipped stylesheet: demanded-but-unused and used-but-undeclared each red (names-not-values made executable). Slice 3 is the PROPAGATION PROOF (the operator-named deliverable): one in-memory perturbation of a day-theme material moves the shared theme_root_css derivation both pages embed verbatim (embedding proven by string containment against each page's shipped css), and both surfaces consume the perturbed role — one authority edit, every site moves, by derivation not by hand-hunt. The scoped control: a FigureLitRole perturbation moves the shared var block but reaches PAINT only on the site (moodboard consumes var(--figure-lit); the roadmap's archetype demand excludes it and its rules carry no such var) — the demand profile executes as a real propagation boundary, not paperwork."

test fn witness_roadmap_theme_set_coherent() -> Bool {
  gunbc.design.theme.themes_coherent(themes: [gunbc.design.theme.day_theme, gunbc.design.theme.night_theme], roles: gunbc.design.theme.theme_roles)
}

test fn witness_roadmap_colors_all_routed() -> Bool {
  gunbc.design.theme_transition.unthemed_color_decls(rules: gunbc.roadmap_style.roadmap_rules()).length() == 0
}

fn rogue_hex_rule() -> gunbc.design.material.BuildRule {
  gunbc.design.material.StaticRule { selector: ClassSelector { name: "rogue-link" }, decls: [ gunbc.design.material.decl(prop: Color, value: "#0969da") ] }
}

test fn witness_local_hex_literal_refused() -> Bool {
  let caught = gunbc.design.theme_transition.unthemed_color_decls(rules: concat(gunbc.roadmap_style.roadmap_rules(), [rogue_hex_rule()]))
  caught.length() == 1
    && all(caught, c =>
      c.selector == ".rogue-link" && c.prop == "color" && c.value == "#0969da")
}

test fn witness_roadmap_lengths_all_tokened() -> Bool {
  gunbc.design.theme_transition.untokened_length_decls(rules: gunbc.roadmap_style.roadmap_instance_rules()).length() == 0
}

fn rogue_px_rule() -> gunbc.design.material.BuildRule {
  gunbc.design.material.StaticRule { selector: ClassSelector { name: "rogue-pad" }, decls: [ gunbc.design.material.decl(prop: Padding, value: "14px") ] }
}

test fn witness_local_px_literal_refused() -> Bool {
  let caught = gunbc.design.theme_transition.untokened_length_decls(rules: concat(gunbc.roadmap_style.roadmap_instance_rules(), [rogue_px_rule()]))
  caught.length() == 1
    && all(caught, c => c.selector == ".rogue-pad" && c.prop == "padding" && c.value == "14px")
}

test fn witness_scale_block_is_the_px_home() -> Bool {
  string_contains(s: gunbc.design.scale.scale_root_css(), pattern: "14px")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: "var(--text-14)")
    && gunbc.design.theme_transition.untokened_length_decls(rules: gunbc.roadmap_style.roadmap_instance_rules()).length() == 0
}

test fn witness_derived_responses_ship_with_reduced_motion_collapse() -> Bool {
  gunbc.design.material.reduced_motion_block(rules: gunbc.roadmap_style.roadmap_rules()) != ""
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: "@media (prefers-reduced-motion: reduce)")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".dispatch-btn:hover")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".dispatch-btn:focus-visible")
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".dispatch-btn:active")
}

test fn witness_roadmap_coverage_complete() -> Bool {
  gunbc.design.interaction.coverage_complete(elements: gunbc.roadmap_interaction.roadmap_elements, rows: gunbc.roadmap_interaction.roadmap_behaviors)
    && gunbc.roadmap_interaction.roadmap_unrealized_behaviors(rows: gunbc.roadmap_interaction.roadmap_behaviors).length() == 0
}

data dropped_row_witness_scope_note: String = "The drop is scoped to ONE element's ONE verb so the assertion stays a LOCATED-gap check as the roster grows. The earlier form dropped every dispatch row tree-wide and asserted exactly one gap, which was only true while one element declared that verb — adding the sound toggle made it two and the witness reddened for a reason that had nothing to do with the property under test. A count that tracks the roster is a count that has to be re-tuned on every unrelated addition, and a witness re-tuned that often stops being read. Dropping the dispatch button's dispatch rows specifically keeps the claim exactly what it was meant to be: a missing row names its own element and verb."

fn rows_without(element: gunbc.design.interaction.ElementId, verb_label: String) -> List<gunbc.design.interaction.BehaviorRow> {
  fold(gunbc.roadmap_interaction.roadmap_behaviors, init: [], f: (acc, r) =>
    if gunbc.design.interaction.element_id_eq(a: r.element, b: element) && gunbc.design.interaction.verb_key(v: r.verb) == verb_label {
      acc
    } else {
      concat(acc, [r])
    })
}

test fn witness_dropped_row_gap_is_located() -> Bool {
  let gaps = gunbc.design.interaction.coverage_gaps(
    elements: gunbc.roadmap_interaction.roadmap_elements,
    rows: rows_without(element: gunbc.design.interaction.DispatchBtnElement, verb_label: "dispatch"))
  gaps.length() == 1
    && all(gaps, g => gunbc.design.interaction.element_id_eq(a: g.element, b: gunbc.design.interaction.DispatchBtnElement) && gunbc.design.interaction.verb_key(v: g.verb) == "dispatch")
}

test fn witness_unrealized_row_is_counted() -> Bool {
  let rogue = gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Reveal, timing: gunbc.design.material.respond_fast }
  gunbc.roadmap_interaction.roadmap_unrealized_behaviors(rows: concat(gunbc.roadmap_interaction.roadmap_behaviors, [rogue])).length() == 1
}

fn demand_matches_for_role(r: gunbc.design.theme.ThemeRole) -> Bool {
  let demanded = gunbc.design.archetype.archetype_demands_role(a: gunbc.design.archetype.dashboard_archetype, r: r)
  let used = string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: join(["var(--", gunbc.design.theme.role_key(r: r), ")"], ""))
  demanded == used
}

test fn witness_archetype_demand_matches_shipped_css() -> Bool {
  all(gunbc.design.theme.theme_roles, r => demand_matches_for_role(r: r))
}

test fn witness_archetype_verbs_match_declared_elements() -> Bool {
  all(dashboard_archetype.verbs, v =>
    fold(gunbc.roadmap_interaction.roadmap_elements, init: false, f: (acc, e) =>
      acc || fold(e.verbs, init: false, f: (acc2, w) => acc2 || gunbc.design.interaction.verb_key(v: w) == gunbc.design.interaction.verb_key(v: v))))
    && all(gunbc.roadmap_interaction.roadmap_elements, e =>
      all(e.verbs, w => gunbc.design.archetype.archetype_admits_verb(a: gunbc.design.archetype.dashboard_archetype, v: w)))
}

data header_wordmark_witness_note: String = "Replaced witness_header_carries_shared_mark at A1 (presentation recon, operator-signed 2026-08-01): the header's brand element is the TEXT wordmark, not the site mark — the mark that stood here was gunbc.site.mark candidate A, an unselected brand experiment whose aria-label said gunb.ai on a gunbc tool surface (rationale on gunbc.roadmap_page.roadmap_wordmark_note). The structural claim is the same shape as before: the header Fragment contains the exact wordmark node, on both page instantiations."

data header_frame_scan_note: String = "Amended for the A2 hierarchy closeout: the header's children now sit inside one div.header-inner composition frame (header_composition_frame_note — header and content share the page measure), so the wordmark no longer sits at direct-child depth. The scan is a RECURSIVE descent over the header's Fragment subtree, not a depth-pinned adjacency check: the CLAIM is 'the header carries the wordmark', and a fixed depth constant would only be the accidental nesting pinned one level looser — the same re-pin the A1 header note warns against, and it would red spuriously the next time a wrapper lands. Descent is on the Fragment sub-value relation (a node's children), so it terminates on the tree it walks (the std.layout render_go shape)."

fn fragment_is_wordmark(c: std.markup.Fragment) -> Bool {
  c == gunbc.site.markup.el_class("span", "wordmark", [ gunbc.site.markup.txt("gunbc") ])
}

fn subtree_carries_wordmark(f: std.markup.Fragment) -> Bool {
  fragment_is_wordmark(c: f)
    || (match f {
      std.markup.Element { tag: _, attributes: _, children } =>
        fold(children, init: false, f: (acc, c) => acc || subtree_carries_wordmark(f: c))
      std.markup.FragmentText { content: _ } => false
      std.markup.RawNode { content: _ } => false
    })
}

fn header_subtree_carries_wordmark(h: std.markup.Fragment) -> Bool {
  match h {
    std.markup.Element { tag, attributes: _, children } =>
      tag == "header"
        && fold(children, init: false, f: (acc, c) => acc || subtree_carries_wordmark(f: c))
    std.markup.FragmentText { content: _ } => false
    std.markup.RawNode { content: _ } => false
  }
}

test fn witness_header_carries_wordmark() -> Bool {
  header_subtree_carries_wordmark(h: gunbc.roadmap_page.roadmap_header(page: "roadmap"))
    && header_subtree_carries_wordmark(h: gunbc.roadmap_page.roadmap_header(page: "daily workspace"))
}

data header_scan_discrimination_note: String = "An unbounded subtree search buys depth-independence at the cost of being easy to satisfy, so it owes a control proving the two bounds it still holds. Arm 1: the scan matches the wordmark NODE, not its text — a header carrying the bare string 'gunbc' at any depth is not a wordmark. Arm 2: the header tag guard still bites — the exact wordmark node under a non-header root does not satisfy 'the HEADER carries it'. Without both arms an always-true search would read identically to the real claim."

test fn witness_header_wordmark_scan_discriminates() -> Bool {
  !header_subtree_carries_wordmark(h: std.markup.Element {
    tag: "header",
    attributes: [],
    children: [
      std.markup.Element { tag: "div", attributes: [], children: [ gunbc.site.markup.txt("gunbc") ] },
    ],
  })
    && !header_subtree_carries_wordmark(h: std.markup.Element {
      tag: "div",
      attributes: [],
      children: [ gunbc.site.markup.el_class("span", "wordmark", [ gunbc.site.markup.txt("gunbc") ]) ],
    })
}

fn theme_with_role_material(t: gunbc.design.theme.Theme, target: gunbc.design.theme.ThemeRole, m: gunbc.design.material.Material) -> gunbc.design.theme.Theme {
  gunbc.design.theme.Theme {
    name: t.name,
    scheme: t.scheme,
    assignments: map(t.assignments, a =>
      if gunbc.design.theme.role_eq(a: a.role, b: target) {
        gunbc.design.theme.RoleAssignment { role: a.role, material: m, alpha_pct: a.alpha_pct }
      } else {
        a
      }),
  }
}

fn probe_canvas_material() -> gunbc.design.material.Material {
  gunbc.design.material.Material { name: "probe-canvas", hue: 41, sat_pct: 32, light_pct: 95, area: gunbc.design.material.FieldArea }
}

fn probe_figure_lit_material() -> gunbc.design.material.Material {
  gunbc.design.material.Material { name: "probe-figure-lit", hue: 227, sat_pct: 58, light_pct: 20, area: gunbc.design.material.PointArea }
}

test fn witness_upstream_edit_propagates_to_both_surfaces() -> Bool {
  let base = gunbc.design.theme.theme_root_css(base: gunbc.design.theme.day_theme, alternate: gunbc.design.theme.night_theme)
  let perturbed_day = theme_with_role_material(t: gunbc.design.theme.day_theme, target: gunbc.design.theme.CanvasRole, m: probe_canvas_material())
  let moved = gunbc.design.theme.theme_root_css(base: perturbed_day, alternate: gunbc.design.theme.night_theme)
  let unchanged = base == moved
  !unchanged
    && string_contains(s: moved, pattern: gunbc.design.material.paint(m: probe_canvas_material()))
    && string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: base)
    && string_contains(s: gunbc.site.moodboard.moodboard_css(), pattern: gunbc.design.theme.theme_root_css(base: gunbc.design.theme.night_theme, alternate: gunbc.design.theme.day_theme))
    && string_contains(s: gunbc.design.material.serialize_rules(rules: gunbc.roadmap_style.roadmap_rules()), pattern: "var(--canvas)")
    && string_contains(s: gunbc.design.material.serialize_rules(rules: gunbc.site.moodboard.moodboard_rules()), pattern: "var(--canvas)")
}

test fn witness_propagation_scoped_by_demand() -> Bool {
  let base = gunbc.design.theme.theme_root_css(base: gunbc.design.theme.day_theme, alternate: gunbc.design.theme.night_theme)
  let perturbed_day = theme_with_role_material(t: gunbc.design.theme.day_theme, target: gunbc.design.theme.FigureLitRole, m: probe_figure_lit_material())
  let moved = gunbc.design.theme.theme_root_css(base: perturbed_day, alternate: gunbc.design.theme.night_theme)
  let unchanged = base == moved
  !unchanged
    && string_contains(s: gunbc.design.material.serialize_rules(rules: gunbc.site.moodboard.moodboard_rules()), pattern: "var(--figure-lit)")
    && !string_contains(s: gunbc.design.material.serialize_rules(rules: gunbc.roadmap_style.roadmap_rules()), pattern: "var(--figure-lit)")
}

