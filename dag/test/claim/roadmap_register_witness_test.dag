module test.claim.roadmap_register_witness

import std.types { Int, String, Bool }
import std.markup { MarkupNode, ElementNode, TextNode }
import gunbc.design.material {
  BuildRule, StaticRule, CssDecl, decl,
  Material, FieldArea, PointArea, paint, reduced_motion_block, respond_fast,
  serialize_rules,
}
import gunbc.design.theme {
  ThemeRole, theme_roles, themes_coherent, day_theme, night_theme,
  role_key, role_eq,
  Theme, RoleAssignment,
  CanvasRole, FigureLitRole,
  theme_root_css,
}
import gunbc.site.moodboard { moodboard_rules, moodboard_css }
import gunbc.design.theme_transition { unthemed_color_decls }
import gunbc.site.mark { render_mark }
import gunbc.design.interaction {
  Approach, Reveal, Dispatch, BehaviorRow, InteractiveElement,
  DispatchBtnElement, element_id_eq, element_id_key,
  verb_key, coverage_gaps, coverage_complete,
}
import gunbc.roadmap_style { roadmap_rules, roadmap_css }
import gunbc.roadmap_page { roadmap_header }
import gunbc.roadmap_interaction {
  roadmap_elements, roadmap_behaviors,
  roadmap_unrealized_behaviors,
}
import gunbc.design.archetype {
  dashboard_archetype, archetype_demands_role, archetype_admits_verb,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data roadmap_register_witness_note: String = "The roadmap dashboard as a register SITE INSTANCE (slice 1 of the roadmap-onto-register refactor, parent-acked 2026-07-21): the instance inherits the register laws by executing them over its own emission — themes_coherent over the exact Theme rows roadmap_css projects (totality, area coherence, chroma admissibility, WCAG contrast — one law set, N surfaces, never a roadmap fork); the unthemed-color census over the exact BuildRule rows the page serializes, with the RED a resurrection of the precise historical regression this refactor deleted (the hand-hex #0969da link blue) proving the census discriminates rather than vacuously passing; the shared Confluence mark consumed at nav depth from the one render authority (favicon/nav/hero cannot disagree, mark.dag). Slice 2 (manager-signed) flipped the response pin deliberately: the dispatch button's behaviors are declared rows (Approach->Brighten, Dispatch->Receipt) REALIZED through roadmap_realize_behavior — coverage total, unrealized census empty, both with located REDs (a dropped row NAMES its gap; a row with no realize arm is counted, never silently skipped) — and the reduced-motion collapse ships derived from the same rules. The Dashboard archetype rows are cross-checked BOTH directions against the shipped stylesheet: demanded-but-unused and used-but-undeclared each red (names-not-values made executable). Slice 3 is the PROPAGATION PROOF (the operator-named deliverable): one in-memory perturbation of a day-theme material moves the shared theme_root_css derivation both pages embed verbatim (embedding proven by string containment against each page's shipped css), and both surfaces consume the perturbed role — one authority edit, every site moves, by derivation not by hand-hunt. The scoped control: a FigureLitRole perturbation moves the shared var block but reaches PAINT only on the site (moodboard consumes var(--figure-lit); the roadmap's archetype demand excludes it and its rules carry no such var) — the demand profile executes as a real propagation boundary, not paperwork."

fn witness_roadmap_theme_set_coherent() -> Bool {
  themes_coherent(themes: [day_theme, night_theme], roles: theme_roles)
}

fn witness_roadmap_colors_all_routed() -> Bool {
  unthemed_color_decls(rules: roadmap_rules()).length() == 0
}

fn rogue_hex_rule() -> BuildRule {
  StaticRule { selector: ".rogue-link", decls: [ decl(prop: "color", value: "#0969da") ] }
}

fn witness_local_hex_literal_refused() -> Bool {
  let caught = unthemed_color_decls(rules: concat(roadmap_rules(), [rogue_hex_rule()]))
  caught.length() == 1
    && all(caught, c =>
      c.selector == ".rogue-link" && c.prop == "color" && c.value == "#0969da")
}

fn witness_derived_responses_ship_with_reduced_motion_collapse() -> Bool {
  reduced_motion_block(rules: roadmap_rules()) != ""
    && string_contains(s: roadmap_css(), pattern: "@media (prefers-reduced-motion: reduce)")
    && string_contains(s: roadmap_css(), pattern: ".dispatch-btn:hover")
    && string_contains(s: roadmap_css(), pattern: ".dispatch-btn:focus-visible")
    && string_contains(s: roadmap_css(), pattern: ".dispatch-btn:active")
}

fn witness_roadmap_coverage_complete() -> Bool {
  coverage_complete(elements: roadmap_elements, rows: roadmap_behaviors)
    && roadmap_unrealized_behaviors(rows: roadmap_behaviors).length() == 0
}

fn approach_only_rows() -> List<BehaviorRow> {
  fold(roadmap_behaviors, init: [], f: (acc, r) =>
    if verb_key(v: r.verb) == "dispatch" { acc } else { concat(acc, [r]) })
}

fn witness_dropped_row_gap_is_located() -> Bool {
  let gaps = coverage_gaps(elements: roadmap_elements, rows: approach_only_rows())
  gaps.length() == 1
    && all(gaps, g => element_id_eq(a: g.element, b: DispatchBtnElement) && verb_key(v: g.verb) == "dispatch")
}

fn witness_unrealized_row_is_counted() -> Bool {
  let rogue = BehaviorRow { element: DispatchBtnElement, verb: Approach, response: Reveal, timing: respond_fast }
  roadmap_unrealized_behaviors(rows: concat(roadmap_behaviors, [rogue])).length() == 1
}

fn demand_matches_for_role(r: ThemeRole) -> Bool {
  let demanded = archetype_demands_role(a: dashboard_archetype, r: r)
  let used = string_contains(s: roadmap_css(), pattern: join(["var(--", role_key(r: r), ")"], ""))
  demanded == used
}

fn witness_archetype_demand_matches_shipped_css() -> Bool {
  all(theme_roles, r => demand_matches_for_role(r: r))
}

fn witness_archetype_verbs_match_declared_elements() -> Bool {
  all(dashboard_archetype.verbs, v =>
    fold(roadmap_elements, init: false, f: (acc, e) =>
      acc || fold(e.verbs, init: false, f: (acc2, w) => acc2 || verb_key(v: w) == verb_key(v: v))))
    && all(roadmap_elements, e =>
      all(e.verbs, w => archetype_admits_verb(a: dashboard_archetype, v: w)))
}

fn header_children_contain_mark(h: MarkupNode) -> Bool {
  match h {
    ElementNode { tag, attrs: _, children } =>
      tag == "header"
        && fold(children, init: false, f: (acc, c) => acc || c == render_mark(depth: 1))
    TextNode { text: _ } => false
  }
}

fn witness_header_carries_shared_mark() -> Bool {
  header_children_contain_mark(h: roadmap_header(title: "gunbc — roadmap"))
    && header_children_contain_mark(h: roadmap_header(title: "gunbc — daily workspace"))
}

fn theme_with_role_material(t: Theme, target: ThemeRole, m: Material) -> Theme {
  Theme {
    name: t.name,
    scheme: t.scheme,
    assignments: map(t.assignments, a =>
      if role_eq(a: a.role, b: target) {
        RoleAssignment { role: a.role, material: m, alpha_pct: a.alpha_pct }
      } else {
        a
      }),
  }
}

fn probe_canvas_material() -> Material {
  Material { name: "probe-canvas", hue: 41, sat_pct: 32, light_pct: 95, area: FieldArea }
}

fn probe_figure_lit_material() -> Material {
  Material { name: "probe-figure-lit", hue: 227, sat_pct: 58, light_pct: 20, area: PointArea }
}

fn witness_upstream_edit_propagates_to_both_surfaces() -> Bool {
  let base = theme_root_css(base: day_theme, alternate: night_theme)
  let perturbed_day = theme_with_role_material(t: day_theme, target: CanvasRole, m: probe_canvas_material())
  let moved = theme_root_css(base: perturbed_day, alternate: night_theme)
  let unchanged = base == moved
  !unchanged
    && string_contains(s: moved, pattern: paint(m: probe_canvas_material()))
    && string_contains(s: roadmap_css(), pattern: base)
    && string_contains(s: moodboard_css(), pattern: theme_root_css(base: night_theme, alternate: day_theme))
    && string_contains(s: serialize_rules(rules: roadmap_rules()), pattern: "var(--canvas)")
    && string_contains(s: serialize_rules(rules: moodboard_rules()), pattern: "var(--canvas)")
}

fn witness_propagation_scoped_by_demand() -> Bool {
  let base = theme_root_css(base: day_theme, alternate: night_theme)
  let perturbed_day = theme_with_role_material(t: day_theme, target: FigureLitRole, m: probe_figure_lit_material())
  let moved = theme_root_css(base: perturbed_day, alternate: night_theme)
  let unchanged = base == moved
  !unchanged
    && string_contains(s: serialize_rules(rules: moodboard_rules()), pattern: "var(--figure-lit)")
    && !string_contains(s: serialize_rules(rules: roadmap_rules()), pattern: "var(--figure-lit)")
}

test fn roadmap_register_keystone_holds() -> Bool {
  witness_roadmap_theme_set_coherent()
    && witness_roadmap_colors_all_routed()
    && witness_local_hex_literal_refused()
    && witness_derived_responses_ship_with_reduced_motion_collapse()
    && witness_roadmap_coverage_complete()
    && witness_dropped_row_gap_is_located()
    && witness_unrealized_row_is_counted()
    && witness_archetype_demand_matches_shipped_css()
    && witness_archetype_verbs_match_declared_elements()
    && witness_header_carries_shared_mark()
    && witness_upstream_edit_propagates_to_both_surfaces()
    && witness_propagation_scoped_by_demand()
}
