module test.claim.function_value_argument_binding_no_import_control

import std.types { Bool, List, Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE THIRD LEG OF THE ISOLATION, AND IT HAS TO BE A SEPARATE MODULE. Its sibling
// `test.claim.function_value_argument_binding_probe` shows that a parameter named `p` disagrees
// with its direct oracle while the same function with the parameter renamed agrees. That pair
// establishes the NAME matters; it cannot establish what makes the name matter, because both arms
// live in one import closure.
//
// THIS FILE IS THE SAME `p`-NAMED FUNCTION WITH THE IMPORT REMOVED, AND IT NOW MEASURES THE
// OPPOSITE OF WHAT IT WAS AUTHORED TO MEASURE. It was written as the leg that proves the import is
// load-bearing: green here, red in the sibling, so the closure decides. It IS green under
// `gunbc run --entry <this file>`, and it is RED under the required floor -- which is why it is
// enrolled expected-red.
//
// THE TWO PATHS RESOLVE DIFFERENTLY AND THAT IS THE FINDING. An entry-scoped run builds a closure
// from this entry, and `gunbc.plans.md_helpers` `p` is not in it. The floor folds every witness
// through ONE PREPARED SUBJECT OVER THE WHOLE CORPUS, where that symbol is in scope no matter what
// this module imports. So:
//
//   entry-scoped resolution    the collision depends on the module's import closure
//   whole-corpus preparation   the collision is UNCONDITIONAL
//
// The rungs are per path, and this row is the pair that shows it. It is kept, and kept in its own
// module, for that reason -- not for the reason it was written.
//
// IT MUST NOT BE "TIDIED UP" INTO THE SIBLING FILE. Moving it there would give it the sibling's
// imports and collapse the entry-scoped half of the pair, which is the half that still
// discriminates.
fn control_int_is_two(n: Int) -> Bool {
  n == 2
}

fn control_ints() -> List<Int> {
  [2, 2, 3]
}

fn control_count_direct(items: List<Int>) -> Int {
  fold(items, init: 0, f: (acc, n) => if control_int_is_two(n: n) { acc + 1 } else { acc })
}

fn control_count_via_p(items: List<Int>, p: fn(Int) -> Bool) -> Int {
  fold(items, init: 0, f: (acc, n) => if p(n) { acc + 1 } else { acc })
}

test fn control_direct_fold_counts_two() -> Bool {
  control_count_direct(items: control_ints()) == 2
}

test fn control_parameter_named_p_agrees_with_direct_fold_without_the_import() -> Bool {
  control_count_via_p(items: control_ints(), p: control_int_is_two) == 2
}
