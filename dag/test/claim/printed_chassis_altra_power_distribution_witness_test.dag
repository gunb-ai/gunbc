module test.claim.printed_chassis_altra_power_distribution_witness
import std.types {Bool,Int,List}
import std.measure {watt,watt_count,milliampere_count,percent,volt}
import std.optional {Present,Absent}
import std.decision {SelectedWithin,SelectionNeedsEvidence}
import extdeps.power.fsp800_50fs {fsp800_50fs_reference,fsp800_50fs_main_12v_power}
import extdeps.external_authority {TranscribedUncited}
import product.printed_chassis.server_power_interface {reference_main_power,server_power_interface_obligations,PairingCapacityOnly,PairingRefused}
import product.printed_chassis.node_power_feed {node_feed}
import product.printed_chassis.altra_power_distribution {
 altra_operator_policy,altra_capacity_screen,redundancy_holds,RedundancyRefused,LoadExceedsOneModule,NodeCountOutsidePolicy,AltraCapacityScreen,RedundancyWithinOneModule,
 altra_pdb_path_limit,PathLimitStated,altra_3x200,altra_2x300,altra_3x300,altra_3x280,node_loads,altra_pairing,altra_node,
 EvidenceState,Unresolved,ConservativeBound,MeasuredUnder,EstablishedOverEnvelope,supports_electrical_approval,evidence_state_label,
 altra_obligation_dispositions,dispositions_cover_every_obligation,obligation_established,pdb_pair_evidence,
 station_control_decision,StationControlPlan,StationController,NodeBoard,StationControlSingleOwner,StationControlRefused,NodeBoardDrivesSharedPsOn,PsOnNotExactlyOneOwner,PmbusNotExactlyOneMaster,PsOnAndPmbusOwnersDiffer,altra_station_control_plan,
 branch_protection,altra_branch_protection,altra_node_feed_inputs,altra_wire_ampacity,altra_leg_imbalance_allowance,WireAmpacityCited,ProtectionWindow,ProtectionRefused,WindowEmpty,connection_fault_exposure,integrity_open_count,connection_integrity_findings,
 select_connector,select_connector_cited_only,altra_load_case_200,altra_load_case_300,selected_label,altra_power_review,
}
import extdeps.connector.molex_mini_fit_jr {mini_fit_jr_standard_terminal_rating}

fn screen(nodes:List<product.printed_chassis.altra_power_distribution.AltraNode>) -> AltraCapacityScreen {
 altra_capacity_screen(scenario:"witness",node_loads:node_loads(nodes:nodes),policy:altra_operator_policy,path:altra_pdb_path_limit)
}
fn refused_for_load(s:AltraCapacityScreen) -> Bool {
 match s.claim {RedundancyRefused {cause:LoadExceedsOneModule {required:_,one_module:_}}=>true RedundancyRefused {cause:_}=>false RedundancyWithinOneModule {required:_,one_module:_,headroom:_}=>false}
}
fn refused_for_count(s:AltraCapacityScreen) -> Bool {
 match s.claim {RedundancyRefused {cause:NodeCountOutsidePolicy {nodes:_}}=>true RedundancyRefused {cause:_}=>false RedundancyWithinOneModule {required:_,one_module:_,headroom:_}=>false}
}
test fn module_rating_agrees_with_datasheet_780w_at_120v() -> Bool {
 match reference_main_power(reference:fsp800_50fs_reference,input:volt(count:120)) {Present {value:w}=>watt_count(w:w)==watt_count(w:fsp800_50fs_main_12v_power) Absent=>false}
}
test fn three_by_200_and_two_by_300_hold_within_one_module() -> Bool {
 redundancy_holds(s:screen(nodes:altra_3x200)) && redundancy_holds(s:screen(nodes:altra_2x300))
 && screen(nodes:altra_3x200).all_modules_adequate && screen(nodes:altra_2x300).all_modules_adequate
}
test fn three_by_300_refuses_redundancy() -> Bool {
 refused_for_load(s:screen(nodes:altra_3x300))
}
test fn load_fitting_two_modules_but_not_one_refuses_redundancy_claim() -> Bool {
 let s=screen(nodes:altra_3x280)
 s.all_modules_adequate && refused_for_load(s:s)
}
test fn node_count_outside_policy_refuses() -> Bool {
 refused_for_count(s:screen(nodes:[altra_node(name:"n0",branch:0,w:200)]))
 && refused_for_count(s:screen(nodes:[altra_node(name:"n0",branch:0,w:100),altra_node(name:"n1",branch:1,w:100),altra_node(name:"n2",branch:2,w:100),altra_node(name:"n3",branch:3,w:100)]))
}
test fn capacity_pass_is_never_approval() -> Bool {
 let s=screen(nodes:altra_2x300)
 redundancy_holds(s:s) && !supports_electrical_approval(e:s.electrical_approval)
}
test fn pairing_screen_agrees_with_the_capacity_screen() -> Bool {
 let ok=match altra_pairing(nodes:altra_2x300,policy:altra_operator_policy) {PairingCapacityOnly=>true PairingRefused=>false}
 let ok2=match altra_pairing(nodes:altra_3x200,policy:altra_operator_policy) {PairingCapacityOnly=>true PairingRefused=>false}
 let bad=match altra_pairing(nodes:altra_3x300,policy:altra_operator_policy) {PairingCapacityOnly=>false PairingRefused=>true}
 ok && ok2 && bad
}
test fn evidence_states_stay_distinct_and_only_established_supports_approval() -> Bool {
 let u:EvidenceState=Unresolved {read_obligation:"x"}
 let c:EvidenceState=ConservativeBound {basis:"x"}
 let m:EvidenceState=MeasuredUnder {conditions:"x"}
 let e:EvidenceState=EstablishedOverEnvelope {envelope:"x"}
 !supports_electrical_approval(e:u) && !supports_electrical_approval(e:c) && !supports_electrical_approval(e:m) && supports_electrical_approval(e:e)
 && evidence_state_label(e:u)!=evidence_state_label(e:c) && evidence_state_label(e:c)!=evidence_state_label(e:m) && evidence_state_label(e:m)!=evidence_state_label(e:e)
}
test fn every_obligation_has_one_disposition_and_none_is_established() -> Bool {
 dispositions_cover_every_obligation() && count(server_power_interface_obligations)==11 && count(filter(altra_obligation_dispositions(),obligation_established))==0
}
test fn single_module_pdb_leaves_the_matched_pair_unresolved() -> Bool {
 match pdb_pair_evidence() {Unresolved {read_obligation:_}=>true ConservativeBound {basis:_}=>false MeasuredUnder {conditions:_}=>false EstablishedOverEnvelope {envelope:_}=>false}
}
test fn station_control_has_one_owner_and_no_node_drives_ps_on() -> Bool {
 let ok=match station_control_decision(plan:altra_station_control_plan) {StationControlSingleOwner {controller:_}=>true StationControlRefused {cause:_}=>false}
 let node=match station_control_decision(plan:StationControlPlan {shared_supply:"s",ps_on_drivers:[StationController {id:"c"},NodeBoard {node:"n0"}],pmbus_masters:[StationController {id:"c"}]}) {StationControlRefused {cause:NodeBoardDrivesSharedPsOn}=>true StationControlRefused {cause:_}=>false StationControlSingleOwner {controller:_}=>false}
 let two=match station_control_decision(plan:StationControlPlan {shared_supply:"s",ps_on_drivers:[StationController {id:"c"},StationController {id:"d"}],pmbus_masters:[StationController {id:"c"}]}) {StationControlRefused {cause:PsOnNotExactlyOneOwner}=>true StationControlRefused {cause:_}=>false StationControlSingleOwner {controller:_}=>false}
 let nopmbus=match station_control_decision(plan:StationControlPlan {shared_supply:"s",ps_on_drivers:[StationController {id:"c"}],pmbus_masters:[]}) {StationControlRefused {cause:PmbusNotExactlyOneMaster}=>true StationControlRefused {cause:_}=>false StationControlSingleOwner {controller:_}=>false}
 let split=match station_control_decision(plan:StationControlPlan {shared_supply:"s",ps_on_drivers:[StationController {id:"c"}],pmbus_masters:[StationController {id:"d"}]}) {StationControlRefused {cause:PsOnAndPmbusOwnersDiffer}=>true StationControlRefused {cause:_}=>false StationControlSingleOwner {controller:_}=>false}
 ok && node && two && nopmbus && split
}
test fn fuse_window_for_300w_node_exists_and_is_a_bound_only() -> Bool {
 match altra_branch_protection(load:watt(count:300)) {
  ProtectionWindow {lower_exclusive_ma:l,upper_inclusive_ma:u,legs:g,wire:_,exposure_at_window_top:_,evidence:e}=>g==2 && l>13000 && l<13300 && u==14400 && !supports_electrical_approval(e:e)
  ProtectionRefused {cause:_}=>false
 }
}
test fn unequal_sharing_allowance_can_empty_the_window() -> Bool {
 match branch_protection(reading:node_feed(inputs:altra_node_feed_inputs(load:watt(count:300),rating:mini_fit_jr_standard_terminal_rating)),wire:altra_wire_ampacity,imbalance:percent(count:120)) {
  ProtectionRefused {cause:WindowEmpty {lower_exclusive_ma:l,upper_inclusive_ma:u}}=>l>=u
  ProtectionRefused {cause:_}=>false
  ProtectionWindow {lower_exclusive_ma:_,upper_inclusive_ma:_,legs:_,wire:_,exposure_at_window_top:_,evidence:_}=>false
 }
}
test fn cited_wire_ampacity_narrows_the_window() -> Bool {
 match branch_protection(reading:node_feed(inputs:altra_node_feed_inputs(load:watt(count:300),rating:mini_fit_jr_standard_terminal_rating)),wire:WireAmpacityCited {limit_ma:14000,source:TranscribedUncited {read_obligation:"witness"}},imbalance:altra_leg_imbalance_allowance) {
  ProtectionWindow {lower_exclusive_ma:_,upper_inclusive_ma:u,legs:_,wire:_,exposure_at_window_top:_,evidence:_}=>u==14000
  ProtectionRefused {cause:_}=>false
 }
}
test fn fuse_does_not_open_on_a_high_resistance_connection_fault() -> Bool {
 let x=connection_fault_exposure(fault_current_ma:15000,resistance_mohm:100,fuse_ma:20000)
 x.dissipation_mw==22500 && !x.fuse_opens && connection_fault_exposure(fault_current_ma:25000,resistance_mohm:100,fuse_ma:20000).fuse_opens
}
test fn connection_integrity_stays_open_after_protection() -> Bool {
 integrity_open_count()==count(connection_integrity_findings) && count(connection_integrity_findings)==4
}
test fn connector_selection_needs_evidence_for_the_full_field_and_selects_within_the_cited_field() -> Bool {
 let full200=match select_connector(case:altra_load_case_200) {SelectionNeedsEvidence {needs:_}=>true _=>false}
 let full300=match select_connector(case:altra_load_case_300) {SelectionNeedsEvidence {needs:_}=>true _=>false}
 let cited200=match select_connector_cited_only(case:altra_load_case_200) {SelectedWithin {candidate:c,receipt:_}=>selected_label(r:select_connector_cited_only(case:altra_load_case_200))=="Mini-Fit Jr standard terminal on 18 AWG" _=>false}
 let cited300=match select_connector_cited_only(case:altra_load_case_300) {SelectedWithin {candidate:c,receipt:_}=>true _=>false}
 full200 && full300 && cited200 && cited300
}
