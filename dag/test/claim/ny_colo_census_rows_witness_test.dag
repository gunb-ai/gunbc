module test.claim.ny_colo_census_rows_witness

import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import test.claim.colo_cabinet_density_witness { established_watts }
import extdeps.colo.types {
  CabinetDensityClaim, ColoFacilityRow,
  RetailGrainStanding, retail_grain_offers_single_cabinet,
  AddressStanding, address_is_listed,
}
import extdeps.colo.databank { databank_lga3_density, databank_lga3_retail_grain, databank_lga3_orangeburg }
import extdeps.colo.critical_systems_realty {
  csr_orny1_density, csr_orny1_retail_grain, csr_orny1_orangeburg,
}
import extdeps.colo.hivelocity {
  hivelocity_ogb1_density, hivelocity_ogb1_retail_grain, hivelocity_ogb1_orangeburg,
}
import extdeps.colo.long_island_interconnect {
  long_island_interconnect_density, long_island_interconnect_retail_grain,
  long_island_interconnect_westbury,
}
import extdeps.colo.nyi { nyi_long_island_density, nyi_long_island_retail_grain, nyi_long_island }
import extdeps.colo.stafford_associates {
  stafford_density, stafford_retail_grain, stafford_setauket,
}
import extdeps.colo.vastnet { vastnet_density, vastnet_retail_grain, vastnet_melville }
import extdeps.colo.continuity_centers {
  continuity_centers_density, continuity_centers_retail_grain, continuity_centers_woodbury,
}
import extdeps.colo.tierpoint {
  tierpoint_hawthorne_density, tierpoint_hawthorne_retail_grain,
  tierpoint_hawthorne_hwt, tierpoint_hawthorne_hw2,
}
import extdeps.colo.equinix { equinix_ny13_density, equinix_ny13_retail_grain, equinix_ny13 }
import extdeps.colo.three_sixty_five {
  three_sixty_five_commack_density, three_sixty_five_commack_retail_grain,
  three_sixty_five_commack,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE NEW YORK ROWS' CONSUMER, AND IT EXISTS BECAUSE THE ROWS OTHERWISE HAD NONE. The carrier's
// own witness reads the DataBank and Iron Mountain rows; the thirteen Westchester, Rockland and
// Long Island facilities this lane added were read by nothing at all. DESIGN section 3c is
// explicit that a data row no fold reads is red regardless of how well it is modelled, and that
// consumption described in a PR body rather than present in the diff is the tell of exactly that.
// The selection fold that will eventually rank these candidates is a workflow fact being reworked
// in another lane, so this file is not that fold: it is the execution that proves every row this
// lane authored flows through the carrier's accessors and lands on the arm its citation claims.
//
// TWO FOLDS, BOTH CONSUMED RATHER THAN RE-DECLARED - review 62870 found the first cut of this file
// carrying a byte-identical copy of established_watts and a second name for the single-cabinet
// predicate, which is DESIGN section 3's nicknaming failure and would have let a later change to
// the sentinel or to a RetailGrainStanding arm update one witness and silently miss the other. The
// grain predicate is now an accessor on the carrier, where its absence was what produced the fork.
// established_watts is imported from the carrier's own witness rather than lifted beside it: its
// minus-one is a TEST-HARNESS sentinel for an Optional that the carrier deliberately does not have,
// and pushing an in-band sentinel into extdeps would undo the very change that replaced the
// zero-for-unread accessor with Watt?.
//
// WHAT MAKES THESE ASSERTIONS SOMETHING OTHER THAN THE ROWS RESTATED. Each integer below is the
// numeral the operator published, quoted verbatim in that row's claim_wording and confirmed
// against the page's own bytes - an external authority, which is what section 5 requires of a
// literal in a merge-blocking test. Editing a row's watt value without the operator having
// changed its page turns one of these red, which is the discrimination the test exists for.

// THE FIVE READ DENSITIES, each against the numeral its operator published. Five and not six: the
// sixth reading in this region is DataBank LGA4, which was already on main before this lane began
// and is asserted by the carrier's own witness. Counting it here would have been this file claiming
// a row it does not read - the same shape as the coverage claim review 62890 found, which is why
// the numeral is stated against what the conjunction below actually contains. Rockland spans an order
// of magnitude across three independently governed operators, and two of those three - 1547 as
// landlord and Hivelocity as its in-building tenant - describe the SAME building at 1 Ramland Road
// while disagreeing by a factor of two. Both are asserted here because each is a faithful reading
// of its own operator's surface; a test that reconciled them would be inventing a fact neither
// page states.
test fn w_ny_read_densities_establish_the_published_watts() -> Bool {
  established_watts(d: databank_lga3_density) == 35000
    && established_watts(d: hivelocity_ogb1_density) == 20000
    && established_watts(d: csr_orny1_density) == 10000
    && established_watts(d: long_island_interconnect_density) == 3000
    && established_watts(d: nyi_long_island_density) == 3000
}

// THE SIX UNREAD ONES ESTABLISH NOTHING, AND THAT IS THE HALF THAT MATTERS MOST. Six unread and
// five read against TWELVE facility rows, because TierPoint HWT and HW2 are two buildings on one
// Hawthorne campus sharing a single density row: a density is a claim about a cabinet, and the
// operator publishes one claim over both halls. Facilities and density claims are deliberately not
// in bijection, so a reader who expects the two counts to match is expecting the wrong thing. An unread
// density is the census's fail-closed arm: no operator page states a figure, so no watt reading
// exists and a consumer that needs one must refuse rather than receive a plausible number. If any
// of these ever yields a value without its page having changed, someone has filled in a guess.
test fn w_ny_unread_densities_establish_nothing() -> Bool {
  established_watts(d: tierpoint_hawthorne_density) == 0 - 1
    && established_watts(d: equinix_ny13_density) == 0 - 1
    && established_watts(d: three_sixty_five_commack_density) == 0 - 1
    && established_watts(d: stafford_density) == 0 - 1
    && established_watts(d: vastnet_density) == 0 - 1
    && established_watts(d: continuity_centers_density) == 0 - 1
}

// DENSITY AND GRAIN ARE INDEPENDENT, and this region is where that independence is load-bearing
// rather than theoretical. Stafford and Vastnet publish the finest retail grain in the census -
// single rack units and thirds of a cabinet - while publishing no density at all; TierPoint and
// DataBank sell cabinets with a density read for one and absent for the other. A carrier that
// fused the two facts would have to invent one of them for every row below.
test fn w_ny_grain_is_published_where_density_is_not() -> Bool {
  retail_grain_offers_single_cabinet(g: stafford_retail_grain)
    && retail_grain_offers_single_cabinet(g: vastnet_retail_grain)
    && retail_grain_offers_single_cabinet(g: long_island_interconnect_retail_grain)
    && retail_grain_offers_single_cabinet(g: tierpoint_hawthorne_retail_grain)
    && retail_grain_offers_single_cabinet(g: databank_lga3_retail_grain)
    && established_watts(d: stafford_density) == 0 - 1
    && established_watts(d: vastnet_density) == 0 - 1
}

// THE GRAIN UNREADS, for the same reason as the density unreads: three operators in this region
// publish a facility page that never says whether one cabinet is a sellable unit, and Continuity
// Centers is the sharpest case - its own sitemap enumerates forty pages and none of them is a
// colocation page, against directory listings that describe cabinet-grain colocation. Reading a
// directory's product list onto an operator row is the failure this arm refuses.
//
// NYI IS THE DISCRIMINATING PAIR IN THIS FILE, and it was the row review 62890 found unenrolled.
// NYI and Long Island Interconnect publish the same Westbury street address and the same 3kW
// average; LII's page says cabinets and NYI's says nothing about product grain. So the two
// assertions that matter sit in DIFFERENT tests over the SAME building: LII's grain is an offer in
// w_ny_grain_is_published_where_density_is_not, NYI's is not one here. A reading transferred from
// the co-located operator - the single most tempting inference in the whole census - reds this
// witness rather than passing silently, which is the only reason the row is worth carrying.
test fn w_ny_unstated_grain_is_not_an_offer() -> Bool {
  retail_grain_offers_single_cabinet(g: equinix_ny13_retail_grain) == false
    && retail_grain_offers_single_cabinet(g: three_sixty_five_commack_retail_grain) == false
    && retail_grain_offers_single_cabinet(g: continuity_centers_retail_grain) == false
    && retail_grain_offers_single_cabinet(g: hivelocity_ogb1_retail_grain) == false
    && retail_grain_offers_single_cabinet(g: csr_orny1_retail_grain) == false
    && retail_grain_offers_single_cabinet(g: nyi_long_island_retail_grain) == false
}

// THE TWELVE FACILITY ROWS THEMSELVES, WHICH NOTHING READ UNTIL NOW. Review 62921: the density and
// grain rows were enrolled and the ColoFacilityRow declarations they hang off were not, so
// `ColoFacilityRow` was a type no fold outside its own carrier modules touched. That is DESIGN
// section 3c red - and it is the THIRD set this file has had to enrol, after its own duplicate
// folds and two grain rows. The pattern is worth naming rather than fixing quietly: each time I
// enrolled the rows I was thinking about and left the ones I was not, which is why the header's
// claim to prove "every row this lane authored" kept being false in a new place. It is now stated
// against what the conjunctions below contain rather than against what the file was written to do.
//
// REGION IS THE DISCRIMINATION, NOT A TAUTOLOGY. Every row here is asserted NY because this lane's
// subject is New York, and the census carries facilities in other regions in these same operator
// modules - TierPoint's Pennsylvania rows and DataBank's New Jersey obligation sit feet away. A row
// filed under the wrong region, or a New Jersey row copied here as a template and left unedited,
// reds this test. That has already happened once in this census: a Summit Secaucus figure was
// withdrawn after its wording proved to sit under a Chicago-area promotional block.
test fn w_ny_facility_rows_are_all_in_new_york() -> Bool {
  databank_lga3_orangeburg.region_code == "NY"
    && csr_orny1_orangeburg.region_code == "NY"
    && hivelocity_ogb1_orangeburg.region_code == "NY"
    && tierpoint_hawthorne_hwt.region_code == "NY"
    && tierpoint_hawthorne_hw2.region_code == "NY"
    && equinix_ny13.region_code == "NY"
    && long_island_interconnect_westbury.region_code == "NY"
    && nyi_long_island.region_code == "NY"
    && stafford_setauket.region_code == "NY"
    && vastnet_melville.region_code == "NY"
    && three_sixty_five_commack.region_code == "NY"
    && continuity_centers_woodbury.region_code == "NY"
}

// THE CO-LOCATION IS A FACT ABOUT THE BUILDING AND IS ASSERTED AS ONE. NYI and Long Island
// Interconnect are two operators selling in one Westbury building, which is why their density
// figures agree and their grain readings do not. Elsewhere in this file that pair is what makes a
// transferred grain reading go red; here it is the premise that makes the pair meaningful at all.
// If either row's municipality is ever edited apart from the other, the co-location claim the grain
// tests rest on has silently stopped being true, and this is where that surfaces.
test fn w_the_westbury_pair_is_one_municipality() -> Bool {
  long_island_interconnect_westbury.municipality == "Westbury"
    && nyi_long_island.municipality == "Westbury"
}

// A STREET IS READ OR IT IS AN OBLIGATION, AND VASTNET IS WHY THE ARM EXISTS. That operator
// publishes a PO box and no street, so its row is AddressUnread carrying what to ask for. Every
// other facility here published a street somebody read. The rule this defends is the census's
// oldest: an address is never reconstructed from a directory, a PO box, or a co-located operator's
// page. Filling Vastnet's street in from any of those - which is a five-minute temptation for
// whoever wants a complete-looking table - reds this test.
//
// Before this test the AddressStanding arms had NO consumer anywhere in the corpus, so that rule
// was enforced by authorial discipline alone. It is now enforced by execution.
test fn w_addresses_are_read_or_owed_never_reconstructed() -> Bool {
  address_is_listed(a: vastnet_melville.address) == false
    && address_is_listed(a: databank_lga3_orangeburg.address)
    && address_is_listed(a: long_island_interconnect_westbury.address)
    && address_is_listed(a: nyi_long_island.address)
    && address_is_listed(a: tierpoint_hawthorne_hwt.address)
    && address_is_listed(a: tierpoint_hawthorne_hw2.address)
    && address_is_listed(a: continuity_centers_woodbury.address)
}
