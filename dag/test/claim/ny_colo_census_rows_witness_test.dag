module test.claim.ny_colo_census_rows_witness

import std.types { Bool, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Present, Absent }
import test.claim.colo_cabinet_density_witness { established_watts, grain_offers_single_cabinet }
import extdeps.colo.types { ColoFacilityRow, AddressStanding, address_street }
import extdeps.colo.databank { databank_lga3_density, databank_lga3_retail_grain, databank_lga3_orangeburg }
import extdeps.colo.critical_systems_realty {
  csr_orny1_density, csr_orny1_retail_grain, csr_orny1_orangeburg,
}
import extdeps.colo.hivelocity {
  hivelocity_ogb1_density, hivelocity_ogb1_retail_grain, hivelocity_ogb1_orangeburg,
}
import extdeps.colo.long_island_interconnect {
  long_island_interconnect_density, long_island_interconnect_retail_grain,
  long_island_interconnect_westbury,
}
import extdeps.colo.nyi { nyi_long_island_density, nyi_long_island_retail_grain, nyi_long_island }
import extdeps.colo.stafford_associates {
  stafford_density, stafford_retail_grain, stafford_setauket,
}
import extdeps.colo.vastnet { vastnet_density, vastnet_retail_grain, vastnet_melville }
import extdeps.colo.continuity_centers {
  continuity_centers_density, continuity_centers_retail_grain, continuity_centers_woodbury,
}
import extdeps.colo.tierpoint {
  tierpoint_hawthorne_density, tierpoint_hawthorne_retail_grain,
  tierpoint_hawthorne_hwt, tierpoint_hawthorne_hw2,
}
import extdeps.colo.equinix { equinix_ny13_density, equinix_ny13_retail_grain, equinix_ny13 }
import extdeps.colo.three_sixty_five {
  three_sixty_five_commack_density, three_sixty_five_commack_retail_grain,
  three_sixty_five_commack,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE NEW YORK ROWS' CONSUMER, AND IT EXISTS BECAUSE THE ROWS OTHERWISE HAD NONE. The carrier's
// own witness reads the DataBank and Iron Mountain rows; the Westchester, Rockland and Long Island
// facilities this lane added were read by nothing at all. DESIGN section 3c is
// explicit that a data row no fold reads is red regardless of how well it is modelled, and that
// consumption described in a PR body rather than present in the diff is the tell of exactly that.
// The selection fold that will eventually rank these candidates is a workflow fact being reworked
// in another lane, so this file is not that fold: it is the execution that proves every row this
// lane authored flows through the carrier's accessors and lands on the arm its citation claims.
//
// TWO FOLDS, BOTH CONSUMED RATHER THAN RE-DECLARED - review 62870 found the first cut of this file
// carrying a byte-identical copy of established_watts and a second name for the single-cabinet
// predicate, which is DESIGN section 3's nicknaming failure and would have let a later change to
// the sentinel or to a RetailGrainStanding arm update one witness and silently miss the other. The
// grain predicate is now an accessor on the carrier, where its absence was what produced the fork.
// established_watts is imported from the carrier's own witness rather than lifted beside it: its
// minus-one is a TEST-HARNESS sentinel for an Optional that the carrier deliberately does not have,
// and pushing an in-band sentinel into extdeps would undo the very change that replaced the
// zero-for-unread accessor with Watt?.
//
// WHAT MAKES THESE ASSERTIONS SOMETHING OTHER THAN THE ROWS RESTATED, now that no New York row
// carries a watt: the discrimination has MOVED from the numeral to the arm. It used to be that
// editing a row's watt value without its page changing turned a test red. Every published New York
// figure is a floor or an average, so those numerals now live in obligation prose where no fold
// reads them - and the assertions below are that the carrier establishes NOTHING from them. What
// reds is re-typing a floor into a figure-bearing arm, which is the edit that would silently invert
// a bound. The external authority is unchanged: each numeral and its verbatim wording remain in the
// row, confirmed against the page's own bytes, so the reading survives its arm being wrong for it.

// FIVE FIGURES WERE READ AND NONE OF THEM ESTABLISHES A WATT, WHICH IS NOT A CONTRADICTION.
// Every New York page that publishes a per-cabinet number publishes a FLOOR or an AVERAGE:
// "35kW+", "100kW+", "20 kW+", "10KW +", and twice "Cooling level average is 3kW per cabinet".
// The carrier's figure-bearing arms are marketed MAXIMA. Typing a floor as a maximum asserts that a
// cabinet advertised at twenty kilowatts OR MORE refuses 20,001 W - the reading inverted, which is
// worse than no reading, and is the defect main corrected on databank_lga4 by moving it to
// DensityUnread with the numerals preserved in the obligation. These five follow that standard: the
// only rows left in a figure-bearing arm anywhere in the census are the two whose wording says
// "up to".
//
// SO THIS TEST ASSERTS THE FAIL-CLOSED HALF OF A READING THAT EXISTS. The pages were read, the
// numerals and verbatim wordings are carried in each obligation, and NO RE-FETCH IS REQUIRED to
// restore them - what is missing is a carrier that can say which direction a quantity points. Until
// then the honest answer to "how many watts does this cabinet take" is that the census does not
// know, and this is where that refusal is enforced rather than promised.
//
// IF ANY OF THESE STARTS YIELDING A VALUE WITHOUT ITS PAGE HAVING CHANGED, someone has re-typed a
// floor as a maximum and the census is asserting an inverted bound again.
test fn w_ny_read_figures_establish_nothing_until_the_carrier_carries_DIRECTION() -> Bool {
  established_watts(d: databank_lga3_density) == 0 - 1
    && established_watts(d: hivelocity_ogb1_density) == 0 - 1
    && established_watts(d: csr_orny1_density) == 0 - 1
    && established_watts(d: long_island_interconnect_density) == 0 - 1
    && established_watts(d: nyi_long_island_density) == 0 - 1
}

// THE UNREAD ONES ESTABLISH NOTHING, AND THAT IS THE HALF THAT MATTERS MOST. An unread density is
// the census's fail-closed arm: no operator page states a figure, so no watt reading exists and a
// consumer that needs one must refuse rather than receive a plausible number.
//
// DENSITY CLAIMS AND FACILITY ROWS ARE NOT IN BIJECTION, which is the fact a reader needs here and
// is stated as a relation rather than as two numerals. TierPoint HWT and HW2 are two buildings on
// one Hawthorne campus sharing a single density row, because a density is a claim about a CABINET
// and the operator publishes one claim across both halls. A reader who expects the facility fold
// below and the density folds above to have equal arity is expecting the wrong thing. If any of
// these ever yields a value without its page having changed, someone has filled in a guess.
test fn w_ny_unread_densities_establish_nothing() -> Bool {
  established_watts(d: tierpoint_hawthorne_density) == 0 - 1
    && established_watts(d: equinix_ny13_density) == 0 - 1
    && established_watts(d: three_sixty_five_commack_density) == 0 - 1
    && established_watts(d: stafford_density) == 0 - 1
    && established_watts(d: vastnet_density) == 0 - 1
    && established_watts(d: continuity_centers_density) == 0 - 1
}

// DENSITY AND GRAIN ARE INDEPENDENT, and this region is where that independence is load-bearing
// rather than theoretical. Stafford and Vastnet publish the finest retail grain in the census -
// single rack units and thirds of a cabinet - while publishing no density at all; TierPoint and
// DataBank sell cabinets with a density read for one and absent for the other. A carrier that
// fused the two facts would have to invent one of them for every row below.
test fn w_ny_grain_is_published_where_density_is_not() -> Bool {
  grain_offers_single_cabinet(g: stafford_retail_grain)
    && grain_offers_single_cabinet(g: vastnet_retail_grain)
    && grain_offers_single_cabinet(g: long_island_interconnect_retail_grain)
    && grain_offers_single_cabinet(g: tierpoint_hawthorne_retail_grain)
    && grain_offers_single_cabinet(g: databank_lga3_retail_grain)
    && established_watts(d: stafford_density) == 0 - 1
    && established_watts(d: vastnet_density) == 0 - 1
}

// THE GRAIN UNREADS, for the same reason as the density unreads: operators in this region whose
// facility page never says whether one cabinet is a sellable unit, and Continuity
// Centers is the sharpest case - its own sitemap enumerates forty pages and none of them is a
// colocation page, against directory listings that describe cabinet-grain colocation. Reading a
// directory's product list onto an operator row is the failure this arm refuses.
//
// NYI IS THE DISCRIMINATING PAIR IN THIS FILE, and it was the row review 62890 found unenrolled.
// NYI and Long Island Interconnect publish the same Westbury street address and the same 3kW
// average; LII's page says cabinets and NYI's says nothing about product grain. So the two
// assertions that matter sit in DIFFERENT tests over the SAME building: LII's grain is an offer in
// w_ny_grain_is_published_where_density_is_not, NYI's is not one here. A reading transferred from
// the co-located operator - the single most tempting inference in the whole census - reds this
// witness rather than passing silently, which is the only reason the row is worth carrying.
test fn w_ny_unstated_grain_is_not_an_offer() -> Bool {
  grain_offers_single_cabinet(g: equinix_ny13_retail_grain) == false
    && grain_offers_single_cabinet(g: three_sixty_five_commack_retail_grain) == false
    && grain_offers_single_cabinet(g: continuity_centers_retail_grain) == false
    && grain_offers_single_cabinet(g: hivelocity_ogb1_retail_grain) == false
    && grain_offers_single_cabinet(g: csr_orny1_retail_grain) == false
    && grain_offers_single_cabinet(g: nyi_long_island_retail_grain) == false
}

// THE FACILITY ROWS THEMSELVES, WHICH NOTHING READ UNTIL NOW. Review 62921: the density and
// grain rows were enrolled and the ColoFacilityRow declarations they hang off were not, so
// `ColoFacilityRow` was a type no fold outside its own carrier modules touched. That is DESIGN
// section 3c red - and it is the THIRD set this file has had to enrol, after its own duplicate
// folds and two grain rows. The pattern is worth naming rather than fixing quietly: each time I
// enrolled the rows I was thinking about and left the ones I was not, which is why the header's
// claim to prove "every row this lane authored" kept being false in a new place. It is now stated
// against what the conjunctions below contain rather than against what the file was written to do.
//
// REGION IS THE DISCRIMINATION, NOT A TAUTOLOGY. Every row here is asserted NY because this lane's
// subject is New York, and the census carries facilities in other regions in these same operator
// modules - TierPoint's Pennsylvania rows and DataBank's New Jersey obligation sit feet away. A row
// filed under the wrong region, or a New Jersey row copied here as a template and left unedited,
// reds this test. That has already happened once in this census: a Summit Secaucus figure was
// withdrawn after its wording proved to sit under a Chicago-area promotional block.
test fn w_ny_facility_rows_are_all_in_new_york() -> Bool {
  databank_lga3_orangeburg.region_code == "NY"
    && csr_orny1_orangeburg.region_code == "NY"
    && hivelocity_ogb1_orangeburg.region_code == "NY"
    && tierpoint_hawthorne_hwt.region_code == "NY"
    && tierpoint_hawthorne_hw2.region_code == "NY"
    && equinix_ny13.region_code == "NY"
    && long_island_interconnect_westbury.region_code == "NY"
    && nyi_long_island.region_code == "NY"
    && stafford_setauket.region_code == "NY"
    && vastnet_melville.region_code == "NY"
    && three_sixty_five_commack.region_code == "NY"
    && continuity_centers_woodbury.region_code == "NY"
}

// THE CO-LOCATION IS A FACT ABOUT THE BUILDING AND IS ASSERTED AS ONE. NYI and Long Island
// Interconnect are two operators selling in one Westbury building, which is why their density
// figures agree and their grain readings do not. Elsewhere in this file that pair is what makes a
// transferred grain reading go red; here it is the premise that makes the pair meaningful at all.
// If either row's municipality is ever edited apart from the other, the co-location claim the grain
// tests rest on has silently stopped being true, and this is where that surfaces.
test fn w_the_westbury_pair_is_one_municipality() -> Bool {
  long_island_interconnect_westbury.municipality == "Westbury"
    && nyi_long_island.municipality == "Westbury"
}

// A STREET IS READ OR IT IS AN OBLIGATION, AND VASTNET IS WHY THE ARM EXISTS. That operator
// publishes a PO box and no street, so its row is AddressUnread carrying what to ask for. The rule
// this defends is the census's oldest: an address is never reconstructed from a directory, a PO box,
// or a co-located operator's page. Filling Vastnet's street in from any of those - a five-minute
// temptation for whoever wants a complete-looking table - reds this test.
//
// Before this test the AddressStanding arms had NO consumer anywhere in the corpus, so that rule was
// enforced by authorial discipline alone. It is now enforced by execution.
//
// THE STREET EQUALITY IS THE ASSERTION THIS FILE COULD NOT WRITE BEFORE, and it is why the accessor
// returns the street rather than a Bool (review 62953). NYI and Long Island Interconnect carry
// BYTE-IDENTICAL streets because they are two operators selling in one building - that co-location
// is the premise the grain tests above rest on, and until now it was asserted only through
// municipality, which two different Westbury buildings would also satisfy. Comparing the two streets
// TO EACH OTHER tests a relation between two rows rather than a row against a transcribed literal,
// so it is not the self-comparison DESIGN section 5 warns about: nothing in this file supplies the
// expected value, and if either operator's page is re-read to a different street the pair stops
// agreeing and this reds.
//
// THE TWO not-equal-SENTINEL LINES ARE LOAD-BEARING AND WERE MISSING (review 62968). Without them,
// if BOTH Westbury rows were re-read to AddressUnread the two sides of the equality would both be
// "STREET-UNREAD" and the co-location assertion would PASS - vacuously, on the value the helper
// returns when it has nothing. That is the sentinel doubling as the failure value and as a value
// that satisfies the check, which is the worst shape an in-band marker can take: the assertion is
// strongest exactly when the data is present and silently strongest-looking when it is gone.
// Asserting each side is not the sentinel BEFORE comparing them is what makes the equality an
// assertion about two streets rather than about two absences.
fn street_or_unread(a: AddressStanding) -> NonEmptyStr {
  match address_street(a: a) {
    Present { value } => value,
    Absent => "STREET-UNREAD",
  }
}

test fn w_addresses_are_read_or_owed_never_reconstructed() -> Bool {
  street_or_unread(a: vastnet_melville.address) == "STREET-UNREAD"
    && street_or_unread(a: long_island_interconnect_westbury.address) != "STREET-UNREAD"
    && street_or_unread(a: nyi_long_island.address) != "STREET-UNREAD"
    && street_or_unread(a: long_island_interconnect_westbury.address)
       == street_or_unread(a: nyi_long_island.address)
    && street_or_unread(a: databank_lga3_orangeburg.address) != "STREET-UNREAD"
    && street_or_unread(a: tierpoint_hawthorne_hwt.address) != "STREET-UNREAD"
    && street_or_unread(a: tierpoint_hawthorne_hw2.address) != "STREET-UNREAD"
    && street_or_unread(a: continuity_centers_woodbury.address) != "STREET-UNREAD"
}
