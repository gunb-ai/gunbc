module test.claim.dag_parse_continuation_operator_witness_test

data dag_parse_continuation_operator_migration_note: String = "Migrated from src/v1/tests/claim/dag_parse_continuation_operator_witness_test.dag (dead witness tree triage, dashboard node adhoc-9b80ec49-d63; that file's only historical consumer, v1_claim_scoped_witness_batch, was deleted 2026-08-15, so none of its 9 tests had ever executed). 7 of the original 9 assertions were already black-box 'source parses cleanly' checks (w_leading_or, w_leading_eq, w_null_coalesce_newline_continuation, w_comparison_operator_newline_family, w_arithmetic_operator_newline_family, w_dot_newline_continuation, w_pipe_newline_continuation) and migrate directly onto compile_dag_rust_emit_check.

w_dual_role_minus_still_two_statements migrates by a type-level equivalence rather than a literal AST-shape re-check: its subject was 'let a = foo' followed on the next line by '-bar(1)' parses as TWO statements (foo bound as a function VALUE, then -bar(1) discarded, then a returned), never as the continuation 'let a = foo - bar(1)'. Those two parses are not merely different ASTs, they are different TYPES — foo is a zero-arg fn, so 'foo - bar(1)' subtracts an Int from a function reference and fails to typecheck, while the two-statement parse typechecks cleanly. So 'compiles clean' is exactly the discriminating black-box observation: a regression that let minus re-enter continuation role would turn this witness red via a type error, not merely leave it structurally unchecked.

w_dual_role_exclusion_intersection_is_singleton_minus is RETIRED, not migrated: it asserted pure operator-table facts (operator_continuation_dual_role_excluded_symbols == {\"-\"}, dag_operators has no bare '!' entry, '!=' does) with no compile-observable surface — nothing a source program can be written to distinguish, since '!' is not a legal infix token at all and its absence from the operator table cannot be probed by parsing a program that would use it as one. The family it protects (comparison/logical continuation, including '!=') stays covered black-box by w_comparison_operator_newline_family above; the table-shape invariant itself is left to the v1 unit tests already covering v1.compiler.parse's operator table, per this repo's ordinary compile-clean + local-test discipline rather than a floor-enrolled witness."

fn parse_ok(source: String, path: String) -> Bool {
  compile_dag_rust_emit_check(source, path, [], [])
}

test fn w_leading_or_test() -> Bool {
  parse_ok(
    "module leading_or\nfn leading_or() -> Bool {\n  let a = \"x\"\n  if a == \"\"\n    || a == \"y\" { false }\n  else { true }\n}\n",
    "src/leading_or.rs"
  )
}

test fn w_leading_eq_test() -> Bool {
  parse_ok(
    "module leading_eq\nfn leading_eq() -> Bool {\n  let a = \"x\"\n  a\n    == \"x\"\n}\n",
    "src/leading_eq.rs"
  )
}

test fn w_null_coalesce_newline_continuation_test() -> Bool {
  parse_ok(
    "module null_coalesce\nfn null_coalesce() -> Int {\n  none\n    ?? 1\n}\n",
    "src/null_coalesce.rs"
  )
}

test fn w_comparison_operator_newline_family_test() -> Bool {
  parse_ok(
    "module comparison_family\nfn cmp_family() -> Bool {\n  let a = 1\n  a\n    != 2\n    && a\n    < 3\n    && a\n    <= 3\n    && a\n    > 0\n    && a\n    >= 1\n}\n",
    "src/comparison_family.rs"
  )
}

test fn w_arithmetic_operator_newline_family_test() -> Bool {
  parse_ok(
    "module arithmetic_family\nfn arith_family() -> Int {\n  let a = 1\n  a\n    + 2\n    * 3\n    / 2\n    % 2\n}\n",
    "src/arithmetic_family.rs"
  )
}

test fn w_dot_newline_continuation_test() -> Bool {
  parse_ok(
    "module dot_newline\ntype Row { v: Int }\nfn dot() -> Int {\n  let r = Row { v: 1 }\n  r\n    .v\n}\n",
    "src/dot_newline.rs"
  )
}

test fn w_pipe_newline_continuation_test() -> Bool {
  parse_ok(
    "module pipe_newline\nfn demo(x: Int) -> Int { x }\nfn pipe() -> Int {\n  1\n    |> demo\n}\n",
    "src/pipe_newline.rs"
  )
}

test fn w_dual_role_minus_still_two_statements_test() -> Bool {
  parse_ok(
    "module dual_role_minus\nfn foo() -> Int { 0 }\nfn bar(x: Int) -> Int { x }\nfn demo() -> Int {\n  let a = foo\n  -bar(1)\n  a\n}\n",
    "src/dual_role_minus.rs"
  )
}
