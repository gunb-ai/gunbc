module test.claim.dag_parse_continuation_operator_witness_test

import std.types { Bool, String }

data witness_note: String = "HERMETIC: documents measured parser asymmetry — continuation lines may begin with || but not == (see std.language_target_identity continuation_eq_operator_shape_note). leading_or_continuation_parses is the positive || control; trailing_eq_continuation_parses is the legitimate == style (operator at end of prior line). A leading_eq repro cannot live in the corpus because it does not parse."

test fn leading_or_continuation_parses() -> Bool {
  let a = "x" as String
  if a == ""
    || a == "y" {
    false
  } else {
    true
  }
}

test fn trailing_eq_continuation_parses() -> Bool {
  let a = "x" as String
  let same = (a as String) ==
    ("x" as String)
  same
}
