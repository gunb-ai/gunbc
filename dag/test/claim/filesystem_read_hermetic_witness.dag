module test.claim.filesystem_read_hermetic_witness


func witness_read_via_builtin_roundtrip() -> Bool {
  let result = filesystem_read(path: "dag/std/filesystem.dag")
  return string_contains(result.content, "module std.filesystem")
}

func witness_read_host_state_fails_closed() -> Bool {
  let result = filesystem_read(path: "target/gunbc_hermetic_host_state_probe_should_not_exist")
  return string_contains(result.content, "unreachable")
}
