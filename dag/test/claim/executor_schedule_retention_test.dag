module test.claim.executor_schedule_retention


data witness_note: String = "In-corpus consumer of the schedule-derived retention policy carrier: asserts the modeled policy facts by execution (green-by-execution). The Rust realization in cli_run.rs mirrors these same facts and a Rust lockstep witness (schedule_retention_policy_matches_modeled_authority) pins the two together, so a policy edit that forgets either side reds."

test fn schedule_retention_exposes_no_tunables() -> Bool {
  gunbc.executor_schedule_retention.schedule_retention_tunable_count == 0
}

test fn schedule_retention_release_is_not_an_eviction() -> Bool {
  gunbc.executor_schedule_retention.schedule_retention_release_and_eviction_counted_apart
}

test fn schedule_retention_drain_line_claims_no_execution() -> Bool {
  gunbc.executor_schedule_retention.schedule_retention_entry_line_asserts_execution == false
}

test fn schedule_retention_policy_is_fail_closed() -> Bool {
  gunbc.executor_schedule_retention.schedule_retention_grain_is_per_module
    && gunbc.executor_schedule_retention.schedule_retention_heads_stay_resident
    && gunbc.executor_schedule_retention.schedule_retention_retain_on_unknown
    && gunbc.executor_schedule_retention.schedule_retention_underflow_refuses
}
