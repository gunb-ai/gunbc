module test.claim.react_jsx_emit


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn browse_page_jsx() -> String {
  extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "GunbhubBrowsePage", node: gunbc.gunbhub_serve.gunbhub_browse_page())
}

fn witness_browse_page_jsx_exact_bytes() -> Bool {
  browse_page_jsx() ==
    "export function GunbhubBrowsePage(): JSX.Element { return <html><head><title>gunbc</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Browse</a></nav></header><main><ul><li><a href=\"/dag\">dag</a></li><li><a href=\"/src\">src</a></li><li><a href=\"/ROADMAP.md\">ROADMAP.md</a></li></ul></main></body></html>; }"
}

fn witness_fn_name_in_output() -> Bool {
  let a = extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "PageA", node: gunbc.gunbhub_serve.gunbhub_browse_page())
  let b = extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "PageB", node: gunbc.gunbhub_serve.gunbhub_browse_page())
  a.starts_with(prefix: "export function PageA():") &&
  b.starts_with(prefix: "export function PageB():") &&
  !(a == b)
}

fn witness_hostile_href_rejected() -> Bool {
  match extdeps.languages.react_jsx.try_serialize_jsx_component(fn_name: "HostilePage", node: gunbc.gunbhub_serve.gunbhub_hostile_page()) {
    extdeps.languages.react_jsx.JsxRejected { reason: _ } => true
    extdeps.languages.react_jsx.JsxOk { tsx: _ } => false
  }
}

fn witness_safe_page_emits_ok() -> Bool {
  match extdeps.languages.react_jsx.try_serialize_jsx_component(fn_name: "GunbhubBrowsePage", node: gunbc.gunbhub_serve.gunbhub_browse_page()) {
    extdeps.languages.react_jsx.JsxOk { tsx: s } => s.starts_with(prefix: "export function GunbhubBrowsePage():")
    extdeps.languages.react_jsx.JsxRejected { reason: _ } => false
  }
}

test fn react_jsx_emit_keystone_holds() -> Bool {
  witness_browse_page_jsx_exact_bytes()
    && witness_fn_name_in_output()
    && witness_hostile_href_rejected()
    && witness_safe_page_emits_ok()
}
