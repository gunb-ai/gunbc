module test.claim.workspace_commissioning_seal_witness

import std.types { Bool, String, Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_census_probe { blocking_class_count_for, total_blocking_count_for }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data commissioning_forged_supply_source: String = "module test.probe.commissioning_forged_supply\nimport gunbc.workspace_commissioning_store { WorkspaceCommittedCommissioning }\nimport gunbc.workspace_commissioning { WorkspaceCommissionedSlot }\nimport gunbc.workspace_commissioning_transaction { WorkspaceCommissioningProvenance }\nfn forge(admitted: WorkspaceCommissionedSlot, provenance: WorkspaceCommissioningProvenance) -> WorkspaceCommittedCommissioning { WorkspaceCommittedCommissioning { admitted: admitted, provenance: provenance } }\n"

data commissioning_skipped_readback_source: String = "module test.probe.commissioning_skipped_readback\nimport gunbc.workspace_commissioning_store { WorkspaceCommissioningStoreSnapshot, WorkspaceCommissioningSupplyReadback, workspace_commissioning_current_supply }\nfn skip(snapshot: WorkspaceCommissioningStoreSnapshot) -> WorkspaceCommissioningSupplyReadback { workspace_commissioning_current_supply(snapshot: snapshot) }\n"

data commissioning_admitted_readback_source: String = "module test.probe.commissioning_admitted_readback\nimport gunbc.workspace_commissioning_store { WorkspaceCommissioningStoreSnapshot, WorkspaceCommissioningSupplyReadback, workspace_commissioning_store_admit_supply }\nfn read(snapshot: WorkspaceCommissioningStoreSnapshot) -> WorkspaceCommissioningSupplyReadback { workspace_commissioning_store_admit_supply(snapshot: snapshot) }\n"

test fn initial_admission_cannot_forge_committed_supply() -> Bool {
  blocking_class_count_for(source: commissioning_forged_supply_source, wanted_class: "SoleConstructorViolation") == 1
}

test fn supply_cannot_skip_fresh_provenance_readback() -> Bool {
  blocking_class_count_for(source: commissioning_skipped_readback_source, wanted_class: "ConstructorCallAdmissionRefused") == 1
}

test fn the_public_fresh_readback_route_is_callable() -> Bool {
  total_blocking_count_for(source: commissioning_admitted_readback_source) == 0
}
