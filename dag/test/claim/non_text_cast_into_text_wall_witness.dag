module test.claim.non_text_cast_into_text_wall_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count,
  census_count_at_key
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE EXECUTED EVIDENCE THAT A NON-TEXT KERNEL VALUE HAS NO ROUTE INTO NonEmptyStr, on the
// source -> .dag-acceptance path. validate_cast abstained on any source outside the dag_cast_rules
// domain, so `n as NonEmptyStr` over an Int, Bool, Float or Unit compiled clean and re-typed a
// number as text. The REDs are one per kernel arm of v1.compiler.infer host_text_source_reading. The GREEN arms keep
// the wall from being a wrecking ball: a string literal, a String value (the text-representation
// crossing is not this wall's question), a value already typed NonEmptyStr, and a non-text cast that
// is not into text (`as Float`) all still compile.
//
// PATH SCOPE (DESIGN section 4b): this measures compile acceptance only.

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data int_source: String = "module probe_non_text_cast_int\nimport std.types { Int, NonEmptyStr }\nfn label(n: Int) -> NonEmptyStr { n as NonEmptyStr }\n"

data bool_source: String = "module probe_non_text_cast_bool\nimport std.types { Bool, NonEmptyStr }\nfn label(b: Bool) -> NonEmptyStr { b as NonEmptyStr }\n"

data float_source: String = "module probe_non_text_cast_float\nimport std.types { Float, NonEmptyStr }\nfn label(x: Float) -> NonEmptyStr { x as NonEmptyStr }\n"

data unit_source: String = "module probe_non_text_cast_unit\nimport std.types { Unit, NonEmptyStr }\nfn label(u: Unit) -> NonEmptyStr { u as NonEmptyStr }\n"

data nat_source: String = "module probe_non_text_cast_nat\nimport std.types { NonEmptyStr }\nimport std.nat { Nat }\nfn label(k: Nat) -> NonEmptyStr { k as NonEmptyStr }\n"

data literal_source: String = "module probe_text_cast_literal\nimport std.types { NonEmptyStr }\nfn label() -> NonEmptyStr { \"ready\" as NonEmptyStr }\n"

data string_value_source: String = "module probe_text_cast_string\nimport std.types { String, NonEmptyStr }\nfn label(s: String) -> NonEmptyStr { s as NonEmptyStr }\n"

data identity_source: String = "module probe_text_cast_identity\nimport std.types { NonEmptyStr }\nfn label(s: NonEmptyStr) -> NonEmptyStr { s as NonEmptyStr }\n"

data user_declared_int_source: String = "module probe_user_declared_int\nimport std.types { String, NonEmptyStr }\ntype Int { label: String }\nfn label(x: Int) -> NonEmptyStr { x as NonEmptyStr }\n"

// THE SIBLING TARGET: `as String`. The same five kernel sources into the kernel String mint, which
// validate_cast left unjudged because String is outside dag_cast_rules; the emitter then fabricated a
// runtime panic for it. The declared route, std.integer int_to_decimal_string, is accepted as the control.
data int_as_string_source: String = "module probe_non_text_cast_int_string\nimport std.types { Int, String }\nfn label(n: Int) -> String { n as String }\n"

data bool_as_string_source: String = "module probe_non_text_cast_bool_string\nimport std.types { Bool, String }\nfn label(b: Bool) -> String { b as String }\n"

data float_as_string_source: String = "module probe_non_text_cast_float_string\nimport std.types { Float, String }\nfn label(x: Float) -> String { x as String }\n"

data unit_as_string_source: String = "module probe_non_text_cast_unit_string\nimport std.types { Unit, String }\nfn label(u: Unit) -> String { u as String }\n"

data nat_as_string_source: String = "module probe_non_text_cast_nat_string\nimport std.types { String }\nimport std.nat { Nat }\nfn label(k: Nat) -> String { k as String }\n"

data declared_route_source: String = "module probe_int_to_text_declared_route\nimport std.types { Int, String }\nimport std.integer { int_to_decimal_string }\nfn label(n: Int) -> String { int_to_decimal_string(value: n) }\n"

data bool_as_nat_source: String = "module probe_bool_as_nat_refused\nimport std.types { Bool }\nimport std.nat { Nat }\nfn count_of(b: Bool) -> Nat { b as Nat }\n"

data bool_as_record_source: String = "module probe_bool_as_record_refused\nimport std.types { Bool }\ntype Flag { on: Bool }\nfn flag_of(b: Bool) -> Flag { b as Flag }\n"

data bool_as_int_source: String = "module probe_bool_as_int_still_refused\nimport std.types { Bool, Int }\nfn indicator(b: Bool) -> Int { b as Int }\n"

data non_empty_text_as_string_source: String = "module probe_non_empty_text_as_string\nimport std.types { String, NonEmptyStr }\nfn widen(s: NonEmptyStr) -> String { s as String }\n"

data non_text_target_source: String = "module probe_non_text_cast_float_target\nimport std.types { Int, Float }\nfn widen(n: Int) -> Float { n as Float }\n"

test fn w_int_as_non_empty_text_is_refused() -> Bool { blocking_count(source: int_source) >= 1 }

test fn w_bool_as_non_empty_text_is_refused() -> Bool { blocking_count(source: bool_source) >= 1 }

test fn w_float_as_non_empty_text_is_refused() -> Bool { blocking_count(source: float_source) >= 1 }

test fn w_unit_as_non_empty_text_is_refused() -> Bool { blocking_count(source: unit_source) >= 1 }

test fn w_nat_as_non_empty_text_is_refused() -> Bool { blocking_count(source: nat_source) >= 1 }

test fn w_string_literal_cast_is_accepted() -> Bool { blocking_count(source: literal_source) == 0 }

test fn w_string_value_cast_is_not_this_wall() -> Bool { blocking_count(source: string_value_source) == 0 }

test fn w_non_empty_text_identity_cast_is_accepted() -> Bool { blocking_count(source: identity_source) == 0 }

test fn w_non_text_cast_not_into_text_is_still_accepted() -> Bool { blocking_count(source: non_text_target_source) == 0 }

// KEYED ON IDENTITY, NOT SPELLING: a corpus type that happens to be named Int is not the kernel Int,
// so the wall does not fire on it (a leaf-name check would). A record cast is outside the cast domain
// and this wall's question, so the fixture compiles with no blocking diagnostic.
// A user-declared type spelled Int is a nominal product, so the nominal-source wall (validate_cast's
// HostTextRouteAbsentNominal arm, test.claim.nominal_cast_wall_witness) refuses it -- but under ITS message, never
// this wall's. The discriminator is the subject: this wall's text (the census subject: 77 bytes and an ellipsis,
// compile_clean_internal_error_histogram_name) must not appear, and the nominal wall's must.
fn refusals_at(source: String, subject: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: "InternalError", subject_name: subject, blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn w_user_declared_type_spelled_int_is_not_the_kernel_int() -> Bool {
  refusals_at(source: user_declared_int_source, subject: "invalid cast: Int as NonEmptyStr -- a non-text value has no route into text; …") == 0
    && refusals_at(source: user_declared_int_source, subject: "invalid cast: Int as NonEmptyStr: a nominal value has no declared conversion") == 1
}


test fn w_int_as_string_is_refused() -> Bool { blocking_count(source: int_as_string_source) >= 1 }

test fn w_bool_as_string_is_refused() -> Bool { blocking_count(source: bool_as_string_source) >= 1 }

test fn w_float_as_string_is_refused() -> Bool { blocking_count(source: float_as_string_source) >= 1 }

test fn w_unit_as_string_is_refused() -> Bool { blocking_count(source: unit_as_string_source) >= 1 }

test fn w_nat_as_string_is_refused() -> Bool { blocking_count(source: nat_as_string_source) >= 1 }

// The refusal is THIS wall's, at the subject that names the cast the author wrote.
test fn w_int_as_string_refusal_names_the_cast() -> Bool {
  refusals_at(source: int_as_string_source, subject: "invalid cast: Int as String -- a non-text value has no route into text; build…") == 1
}

test fn w_declared_int_to_text_route_is_accepted() -> Bool { blocking_count(source: declared_route_source) == 0 }

test fn w_non_empty_text_as_string_is_accepted() -> Bool { blocking_count(source: non_empty_text_as_string_source) == 0 }

// `true as Int` still refuses: the Bool row was withdrawn from dag_cast_rules and this change adds
// no route (DESIGN section 4).
test fn w_bool_as_int_is_still_refused() -> Bool { blocking_count(source: bool_as_int_source) >= 1 }

// Bool is the declared coproduct True | False: a cast from it onto a target outside the cast table
// refuses as for every nominal, rather than abstaining because Bool sits in the table's domain
// (review 86355).
test fn w_bool_as_nat_is_refused() -> Bool { blocking_count(source: bool_as_nat_source) >= 1 }

test fn w_bool_as_record_is_refused() -> Bool { blocking_count(source: bool_as_record_source) >= 1 }
