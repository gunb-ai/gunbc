module test.claim.non_text_cast_into_text_wall_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count,
  census_count_at_key
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE EXECUTED EVIDENCE THAT A NON-TEXT KERNEL VALUE HAS NO ROUTE INTO NonEmptyStr, on the
// source -> .dag-acceptance path. validate_cast abstained on any source outside the dag_cast_rules
// domain, so `n as NonEmptyStr` over an Int, Bool, Float or Unit compiled clean and re-typed a
// number as text. The REDs are one per kernel mint in is_non_text_kernel_cast_source. The GREEN arms keep
// the wall from being a wrecking ball: a string literal, a String value (the text-representation
// crossing is not this wall's question), a value already typed NonEmptyStr, and a non-text cast that
// is not into text (`as Float`) all still compile.
//
// PATH SCOPE (DESIGN section 4b): this measures compile acceptance only.

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data int_source: String = "module probe_non_text_cast_int\nimport std.types { Int, NonEmptyStr }\nfn label(n: Int) -> NonEmptyStr { n as NonEmptyStr }\n"

data bool_source: String = "module probe_non_text_cast_bool\nimport std.types { Bool, NonEmptyStr }\nfn label(b: Bool) -> NonEmptyStr { b as NonEmptyStr }\n"

data float_source: String = "module probe_non_text_cast_float\nimport std.types { Float, NonEmptyStr }\nfn label(x: Float) -> NonEmptyStr { x as NonEmptyStr }\n"

data unit_source: String = "module probe_non_text_cast_unit\nimport std.types { Unit, NonEmptyStr }\nfn label(u: Unit) -> NonEmptyStr { u as NonEmptyStr }\n"

data nat_source: String = "module probe_non_text_cast_nat\nimport std.types { NonEmptyStr }\nimport std.nat { Nat }\nfn label(k: Nat) -> NonEmptyStr { k as NonEmptyStr }\n"

data literal_source: String = "module probe_text_cast_literal\nimport std.types { NonEmptyStr }\nfn label() -> NonEmptyStr { \"ready\" as NonEmptyStr }\n"

data string_value_source: String = "module probe_text_cast_string\nimport std.types { String, NonEmptyStr }\nfn label(s: String) -> NonEmptyStr { s as NonEmptyStr }\n"

data identity_source: String = "module probe_text_cast_identity\nimport std.types { NonEmptyStr }\nfn label(s: NonEmptyStr) -> NonEmptyStr { s as NonEmptyStr }\n"

data user_declared_int_source: String = "module probe_user_declared_int\nimport std.types { String, NonEmptyStr }\ntype Int { label: String }\nfn label(x: Int) -> NonEmptyStr { x as NonEmptyStr }\n"

data non_text_target_source: String = "module probe_non_text_cast_float_target\nimport std.types { Int, Float }\nfn widen(n: Int) -> Float { n as Float }\n"

test fn w_int_as_non_empty_text_is_refused() -> Bool { blocking_count(source: int_source) >= 1 }

test fn w_bool_as_non_empty_text_is_refused() -> Bool { blocking_count(source: bool_source) >= 1 }

test fn w_float_as_non_empty_text_is_refused() -> Bool { blocking_count(source: float_source) >= 1 }

test fn w_unit_as_non_empty_text_is_refused() -> Bool { blocking_count(source: unit_source) >= 1 }

test fn w_nat_as_non_empty_text_is_refused() -> Bool { blocking_count(source: nat_source) >= 1 }

test fn w_string_literal_cast_is_accepted() -> Bool { blocking_count(source: literal_source) == 0 }

test fn w_string_value_cast_is_not_this_wall() -> Bool { blocking_count(source: string_value_source) == 0 }

test fn w_non_empty_text_identity_cast_is_accepted() -> Bool { blocking_count(source: identity_source) == 0 }

test fn w_non_text_cast_not_into_text_is_still_accepted() -> Bool { blocking_count(source: non_text_target_source) == 0 }

// KEYED ON IDENTITY, NOT SPELLING: a corpus type that happens to be named Int is not the kernel Int,
// so the wall does not fire on it (a leaf-name check would). A record cast is outside the cast domain
// and this wall's question, so the fixture compiles with no blocking diagnostic.
// A user-declared type spelled Int is a nominal product, so the nominal-source wall (validate_cast
// source_is_nominal, test.claim.nominal_cast_wall_witness) refuses it -- but under ITS message, never
// this wall's. The discriminator is the subject: this wall's text (truncated at 80 chars, the census
// subject width) must not appear, and the nominal wall's must.
fn refusals_at(source: String, subject: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: "InternalError", subject_name: subject, blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn w_user_declared_type_spelled_int_is_not_the_kernel_int() -> Bool {
  refusals_at(source: user_declared_int_source, subject: "invalid cast: Int as NonEmptyStr -- a non-text value has no route into text; bui") == 0
    && refusals_at(source: user_declared_int_source, subject: "invalid cast: Int as NonEmptyStr: a nominal value has no declared conversion") == 1
}

