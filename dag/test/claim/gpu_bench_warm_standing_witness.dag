module test.claim.gpu_bench_warm_standing_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String }
import std.optional { Present, Absent }
import std.algebra { Cons, Empty }
import std.measure { token_count, token_count_value }
import extdeps.gpu_bench.request_v2 {
  gpu_bench_parse_jsonl, GpuBenchRequestV2Parsed, GpuBenchRequestV2StreamUnreadable,
  gpu_bench_request_v2_schema, GpuBenchRequestError, GpuBenchRequestOk,
}
import gunbc.serving.gpu_bench_warm_standing {
  gpu_bench_warm_standing, gpu_bench_warm_standing_with_ninfer_log,
  WarmValid, WarmOverCapacity, WarmRejected, WarmCapacityUnread,
}
import extdeps.gpu_bench.kit_log {
  gpu_bench_capacity_ok_tokens, CapacityOkRead, CapacityOkAbsent, CapacityOkMalformed,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fx_ok_prime: String = "{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":2,\"retained\":2,\"session\":0,\"max_tokens\":1,\"t_start\":1.0,\"t_first\":2.0,\"t_end\":2.1,\"prompt_tokens\":100,\"completion_tokens\":1,\"status\":\"ok\",\"error\":null}\n{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":2,\"retained\":2,\"session\":1,\"max_tokens\":1,\"t_start\":1.0,\"t_first\":2.0,\"t_end\":2.1,\"prompt_tokens\":80,\"completion_tokens\":1,\"status\":\"ok\",\"error\":null}\n{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"warm\",\"round\":1,\"n_active\":1,\"retained\":2,\"session\":0,\"max_tokens\":512,\"t_start\":3.0,\"t_first\":3.1,\"t_end\":4.0,\"prompt_tokens\":101,\"completion_tokens\":512,\"status\":\"ok\",\"error\":null}\n"

data fx_warm_error: String = "{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":1,\"retained\":1,\"session\":0,\"max_tokens\":1,\"t_start\":1.0,\"t_first\":2.0,\"t_end\":2.1,\"prompt_tokens\":50,\"completion_tokens\":1,\"status\":\"ok\",\"error\":null}\n{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"warm\",\"round\":1,\"n_active\":1,\"retained\":1,\"session\":0,\"max_tokens\":512,\"t_start\":3.0,\"t_first\":null,\"t_end\":4.0,\"prompt_tokens\":null,\"completion_tokens\":null,\"status\":\"error\",\"error\":\"TimeoutError: timed out\"}\n"

data fx_wrong_schema: String = "{\"schema\":\"gpu-bench/request/v1\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":1,\"retained\":1,\"session\":0,\"max_tokens\":1,\"t_start\":1.0,\"t_first\":2.0,\"t_end\":2.1,\"prompt_tokens\":50,\"completion_tokens\":1,\"status\":\"ok\",\"error\":null}\n"

data fx_prime_prompt_absent: String = "{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"prime\",\"round\":0,\"n_active\":1,\"retained\":1,\"session\":0,\"max_tokens\":1,\"t_start\":1.0,\"t_first\":2.0,\"t_end\":2.1,\"prompt_tokens\":null,\"completion_tokens\":1,\"status\":\"ok\",\"error\":null}\n"

data fx_error_detail_absent: String = "{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"warm\",\"round\":1,\"n_active\":1,\"retained\":1,\"session\":0,\"max_tokens\":512,\"t_start\":3.0,\"t_first\":null,\"t_end\":4.0,\"prompt_tokens\":null,\"completion_tokens\":null,\"status\":\"error\"}\n"

data fx_error_detail_malformed: String = "{\"schema\":\"gpu-bench/request/v2\",\"run\":\"fx\",\"phase\":\"warm\",\"round\":1,\"n_active\":1,\"retained\":1,\"session\":0,\"max_tokens\":512,\"t_start\":3.0,\"t_first\":null,\"t_end\":4.0,\"prompt_tokens\":null,\"completion_tokens\":null,\"status\":\"error\",\"error\":1}\n"

fn parsed_ok(text: String) -> Bool {
  match gpu_bench_parse_jsonl(text: text) {
    GpuBenchRequestV2Parsed { records: _ } => true
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
  }
}

test fn schema_identity_is_v2() -> Bool {
  (gpu_bench_request_v2_schema as String) == "gpu-bench/request/v2"
}

test fn wrong_schema_refuses() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_wrong_schema) {
    GpuBenchRequestV2StreamUnreadable { line: n, cause: c } => n == 1 && (c as String) == "schema is not gpu-bench/request/v2"
    GpuBenchRequestV2Parsed { records: _ } => false
  }
}

test fn working_set_under_capacity_is_valid() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing(records: rs, measured_kv: Present { value: token_count(count: 200) }) {
        WarmValid { working_set_tokens: w, measured_kv_tokens: k } =>
          token_count_value(t: w) == 180 && token_count_value(t: k) == 200
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn working_set_over_capacity_is_not_engine_evidence() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing(records: rs, measured_kv: Present { value: token_count(count: 100) }) {
        WarmOverCapacity { working_set_tokens: w, measured_kv_tokens: k } =>
          token_count_value(t: w) == 180 && token_count_value(t: k) == 100
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn warm_error_rejects() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_warm_error) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing(records: rs, measured_kv: Present { value: token_count(count: 1000) }) {
        WarmRejected { cause: c } => (c as String) == "a prime or warm request did not complete"
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn missing_measured_kv_is_unread() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing(records: rs, measured_kv: Absent) {
        WarmCapacityUnread { cause: _ } => true
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}

test fn capacity_ok_line_reads_tokens() -> Bool {
  match gpu_bench_capacity_ok_tokens(log: "CAPACITY_OK 1920000\n") {
    CapacityOkAbsent => false
    CapacityOkMalformed { cause: _ } => false
    CapacityOkRead { tokens: t } => token_count_value(t: t) == 1920000
  }
}

test fn ninfer_replay_uncited_is_unread() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK 1920000\nninfer_replayed_tokens_total 12\n") {
        WarmCapacityUnread { cause: c } => string_contains(s: c as String, pattern: "not an upstream-published contract")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}

test fn parsed_ok_prime_fixture() -> Bool {
  parsed_ok(text: fx_ok_prime)
}

test fn absent_prime_prompt_tokens_rejects() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_prime_prompt_absent) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing(records: rs, measured_kv: Present { value: token_count(count: 1000) }) {
        WarmRejected { cause: c } => (c as String) == "a prime-phase request carries no prompt_tokens"
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn error_detail_absent_is_typed() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_error_detail_absent) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match rs {
        Empty => false
        Cons { head: r, tail: _ } => match r.status {
          GpuBenchRequestOk => false
          GpuBenchRequestError { detail: d } => match d {
            Absent => true
            Present { value: _ } => false
          }
        }
      }
  }
}

test fn error_detail_malformed_refuses() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_error_detail_malformed) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => true
    GpuBenchRequestV2Parsed { records: _ } => false
  }
}

test fn missing_replay_counter_is_unread() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK 1920000\n") {
        WarmCapacityUnread { cause: c } => string_contains(s: c as String, pattern: "not observed")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}

test fn malformed_replay_counter_rejects() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK 1920000\nninfer_replayed_tokens_total not-a-nat\n") {
        WarmRejected { cause: c } => string_contains(s: c as String, pattern: "not a natural")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn malformed_capacity_ok_is_not_unsupplied() -> Bool {
  match gpu_bench_capacity_ok_tokens(log: "CAPACITY_OK xyz\n") {
    CapacityOkMalformed { cause: c } => string_contains(s: c as String, pattern: "CAPACITY_OK")
    CapacityOkAbsent => false
    CapacityOkRead { tokens: _ } => false
  }
}

test fn embedded_capacity_ok_marker_is_not_a_reading() -> Bool {
  match gpu_bench_capacity_ok_tokens(log: "INFO CAPACITY_OK 1920000\n") {
    CapacityOkAbsent => true
    CapacityOkMalformed { cause: _ } => false
    CapacityOkRead { tokens: _ } => false
  }
}

test fn malformed_capacity_ok_rejects_like_malformed_replay() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK xyz\nninfer_replayed_tokens_total 0\n") {
        WarmRejected { cause: c } => string_contains(s: c as String, pattern: "CAPACITY_OK")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn uncited_path_still_rejects_a_failed_warm() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_warm_error) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK 1920000\nninfer_replayed_tokens_total 0\n") {
        WarmRejected { cause: c } => (c as String) == "a prime or warm request did not complete"
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmCapacityUnread { cause: _ } => false
      }
  }
}

test fn uncited_path_still_reports_absent_capacity() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "ninfer_replayed_tokens_total 0\n") {
        WarmCapacityUnread { cause: c } => string_contains(s: c as String, pattern: "not supplied")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}

test fn two_replay_snapshots_uncited_are_unread() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK 1920000\nninfer_replayed_tokens_total 0\nninfer_replayed_tokens_total 12\n") {
        WarmCapacityUnread { cause: c } => string_contains(s: c as String, pattern: "not an upstream-published contract")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}

test fn conflicting_capacity_ok_snapshots_refuse() -> Bool {
  match gpu_bench_capacity_ok_tokens(log: "CAPACITY_OK 100\nCAPACITY_OK 200\n") {
    CapacityOkMalformed { cause: c } => string_contains(s: c as String, pattern: "disagree")
    CapacityOkAbsent => false
    CapacityOkRead { tokens: _ } => false
  }
}

test fn zero_replay_uncited_is_unread() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "CAPACITY_OK 1920000\nninfer_replayed_tokens_total 0\n") {
        WarmCapacityUnread { cause: c } => string_contains(s: c as String, pattern: "not an upstream-published contract")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}

test fn type_comment_line_does_not_malform_a_following_counter() -> Bool {
  match gpu_bench_parse_jsonl(text: fx_ok_prime) {
    GpuBenchRequestV2StreamUnreadable { line: _, cause: _ } => false
    GpuBenchRequestV2Parsed { records: rs } =>
      match gpu_bench_warm_standing_with_ninfer_log(records: rs, log: "# TYPE ninfer_replayed_tokens_total counter\nninfer_replayed_tokens_total 12\n") {
        WarmCapacityUnread { cause: c } => string_contains(s: c as String, pattern: "not an upstream-published contract")
        WarmValid { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmOverCapacity { working_set_tokens: _, measured_kv_tokens: _ } => false
        WarmRejected { cause: _ } => false
      }
  }
}
