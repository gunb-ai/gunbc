module test.claim.mt_collins_power_policy_witness

import std.types { Bool, String, NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.decl_ref { declaration_ref_eq }
import product.mt_collins_power_policy {
  mt_collins_power_policy_standing,
  mt_collins_power_policy_acceptance,
  obligation_memory_population_unread,
  obligation_bmc_power_cap_sweep,
  mt_collins_power_policy_subject,
  mt_collins_physical_model,
  objective_max_capacity_under_site_power,
  term_platform_power,
  term_service_capacity,
  term_fan_power,
  var_socket_power_cap,
  var_powered_chassis_count,
}
import std.decision {
  Deferred,
  Settled,
  DecisionRefused,
  SettledPolicyAccepted,
  SettledPolicyRejectedDeferred,
  SettledPolicyRejectedRefused,
  PhysicalModelEstablished,
  PhysicalModelUnestablished,
  ObjectiveUnderModeledCause,
  required_sensitivity_cells,
  term_set_join,
  TermSetsJoinComplete,
  ObjectiveUnderModeled,
  ObjectiveDeclaresUnwarrantedTerms,
}

test fn mt_collins_power_policy_acceptance_rejects_under_modeled() -> Bool {
  match mt_collins_power_policy_acceptance() {
    SettledPolicyRejectedRefused { cause: c } =>
      match c {
        ObjectiveUnderModeledCause { missing_from_objective: missing } =>
          any(missing, id => declaration_ref_eq(a: id, b: term_fan_power.identity))
        _ => false
      }
    SettledPolicyAccepted { policy: _ } => false
    SettledPolicyRejectedDeferred { obligations: _, reopen_trigger: _ } => false
  }
}

test fn mt_collins_power_policy_standing_is_refused_under_modeled() -> Bool {
  match mt_collins_power_policy_standing() {
    DecisionRefused { cause: c } =>
      match c {
        ObjectiveUnderModeledCause { missing_from_objective: missing } =>
          any(missing, id => declaration_ref_eq(a: id, b: term_fan_power.identity))
        _ => false
      }
    Deferred { obligations: _, reopen_trigger: _ } => false
    Settled { policy: _ } => false
  }
}

test fn mt_collins_names_memory_unread_and_bmc_sweep_obligations() -> Bool {
  string_contains(s: obligation_memory_population_unread as String, pattern: "PowerAssumedOnly")
    && string_contains(s: obligation_bmc_power_cap_sweep as String, pattern: "ACHIEVED frequency")
}

test fn mt_collins_objective_is_one_structural_measure() -> Bool {
  let terms = objective_max_capacity_under_site_power.terms
  (terms |> count) == 2
    && any(terms, t => declaration_ref_eq(a: t.identity, b: term_service_capacity.identity))
    && any(terms, t => declaration_ref_eq(a: t.identity, b: term_platform_power.identity))
}

test fn mt_collins_required_cells_cover_both_variables_and_both_terms() -> Bool {
  let cells = required_sensitivity_cells(subject: mt_collins_power_policy_subject)
  any(
    cells,
    c => declaration_ref_eq(a: c.variable, b: var_powered_chassis_count.identity)
      && declaration_ref_eq(a: c.term, b: term_platform_power.identity),
  )
    && any(
      cells,
      c => declaration_ref_eq(a: c.variable, b: var_socket_power_cap.identity)
        && declaration_ref_eq(a: c.term, b: term_service_capacity.identity),
    )
    && any(
      cells,
      c => declaration_ref_eq(a: c.variable, b: var_powered_chassis_count.identity)
        && declaration_ref_eq(a: c.term, b: term_service_capacity.identity),
    )
    && any(
      cells,
      c => declaration_ref_eq(a: c.variable, b: var_socket_power_cap.identity)
        && declaration_ref_eq(a: c.term, b: term_platform_power.identity),
    )
}

test fn mt_collins_fan_power_is_objective_under_modeling() -> Bool {
  match mt_collins_physical_model() {
    PhysicalModelEstablished { terms: ts } =>
      match term_set_join(
        terms: ts,
        objective: objective_max_capacity_under_site_power,
        subject: mt_collins_power_policy_subject.identity,
      ) {
        ObjectiveUnderModeled { subject: _, missing_from_objective: missing } =>
          any(missing, id => declaration_ref_eq(a: id, b: term_fan_power.identity))
        TermSetsJoinComplete => false
        ObjectiveDeclaresUnwarrantedTerms { subject: _, extras: _ } => false
      }
    PhysicalModelUnestablished { subject: _, read_obligation: _ } => false
  }
}

fn mt_collins_power_policy_witness_main() -> ProcessExit {
  let all_pass =
    mt_collins_power_policy_standing_is_refused_under_modeled()
      && mt_collins_power_policy_acceptance_rejects_under_modeled()
      && mt_collins_names_memory_unread_and_bmc_sweep_obligations()
      && mt_collins_objective_is_one_structural_measure()
      && mt_collins_required_cells_cover_both_variables_and_both_terms()
      && mt_collins_fan_power_is_objective_under_modeling()
  if all_pass {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "mt collins power policy witness failed" as NonEmptyStr }
  }
}
