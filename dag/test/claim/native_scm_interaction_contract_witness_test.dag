module test.claim.native_scm_interaction_contract_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn receipt_for(scenario: test.claim.native_scm_interaction_scenario_fixture.NativeScmScenario) -> gunbc.native_scm_interaction_contract.NativeScmReceipt {
  native_scm_receipt_for(scenario: scenario)
}

fn primary_label(receipt: gunbc.native_scm_interaction_contract.NativeScmReceipt) -> String {
  native_scm_primary_label(primary: receipt.primary)
}

fn fixture_compatibility_projection() -> gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
  gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
    realization: "git-r0",
    target: "refs/heads/main",
    generation_evidence: "git-generation-fixture",
    projection: "git-projection-fixture",
    read_back: "git-readback-fixture",
    advance: gunbc.scm_compatibility_shape.CompatibilityAdvanceUnavailable {
      cause: "C0 witness does not establish an executing transition",
    },
    fidelity: gunbc.scm_compatibility_shape.CompatibilityFidelityProfile {
      endpoint_state: CompatibilityFidelityPreserved,
      upstream_change_evidence: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry authored-change evidence",
      },
      native_proposal_contract: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry a proposal contract",
      },
      history: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry history",
      },
      publication: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry publication facts",
      },
      conflict_facts: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry conflict facts",
      },
      path_and_mode: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry path or mode facts",
      },
      availability: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry availability facts",
      },
      native_identity: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
        cause: "C0 fixture does not carry native identity",
      },
    },
  }
}

test fn witness_two_independent_changes_both_land() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: TwoIndependentChangesLand)
  primary_label(receipt: r) == "Landed"
    && match r.primary {
      Landed { result_preview } =>
        string_contains(s: result_preview, pattern: "both land")
      _ => false
    }
}

test fn witness_stale_target_auto_resynchronizes() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: StaleTargetAutoResync)
  primary_label(receipt: r) == "Landed"
    && match r.projections.target {
      v2.std.optional.Present { value: t } => t == "main"
      v2.std.optional.Absent => false
    }
    && match r.primary {
      Landed { result_preview } =>
        string_contains(s: result_preview, pattern: "current target")
      _ => false
    }
}

test fn witness_duplicate_submission_applies_once() -> Bool {
  let receipt = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: DuplicateSubmissionAppliesOnce)
  let ledger0 = native_scm_submission_ledger()
  let ledger1 = native_scm_apply_once(ledger: ledger0, receipt: receipt)
  let ledger2 = native_scm_apply_once(ledger: ledger1, receipt: receipt)
  native_scm_applied_count(ledger: ledger1) == 1
    && native_scm_applied_count(ledger: ledger2) == 1
}

test fn witness_same_name_distinct_attempts_apply_separately() -> Bool {
  let receipt_a = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: DuplicateSubmissionAppliesOnce)
  let receipt_b = native_scm_rekey_receipt(
    receipt: receipt_a,
    attempt_key: "attempt-duplicate-submission-second",
  )
  let ledger0 = native_scm_submission_ledger()
  let ledger1 = native_scm_apply_once(ledger: ledger0, receipt: receipt_a)
  let ledger2 = native_scm_apply_once(ledger: ledger1, receipt: receipt_b)
  native_scm_applied_count(ledger: ledger2) == 2
}

test fn witness_rename_and_reference_unique_meaning_lands() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: RenameReferenceUniqueMeaning)
  primary_label(receipt: r) == "Landed"
    && match r.primary {
      Landed { result_preview } =>
        string_contains(s: result_preview, pattern: "unique meaning")
      _ => false
    }
}

test fn witness_two_legitimate_meanings_ask_local_choice() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: TwoLegitimateMeaningsNeedChoice)
  primary_label(receipt: r) == "ChoiceRequired"
    && match r.primary {
      ChoiceRequired { question, continuation } =>
        string_contains(s: question, pattern: "rename")
          && count(native_scm_choice_previews(continuation: continuation)) == 2
          && continuation.options.first_option.label == "follow the rename"
          && continuation.options.second_option.label == "keep a separate name"
          && match native_scm_resolve_choice(
            continuation: continuation,
            choice: NativeScmFirstContinuationOption,
          ) {
            NativeScmContinuationChoiceMatched { selected } =>
              selected.identity.choice == NativeScmFirstContinuationOption
                && selected.option.resume_token == "resume-follow-the-rename"
                && string_contains(
                  s: selected.option.result_preview,
                  pattern: "follow the rename",
                )
            NativeScmContinuationChoiceNotOffered { choice: _ } => false
          }
          && match native_scm_resolve_choice(
            continuation: continuation,
            choice: NativeScmSecondContinuationOption,
          ) {
            NativeScmContinuationChoiceMatched { selected } =>
              selected.identity.choice == NativeScmSecondContinuationOption
                && selected.option.resume_token == "resume-keep-separate-name"
                && string_contains(
                  s: selected.option.result_preview,
                  pattern: "keep a separate name",
                )
            NativeScmContinuationChoiceNotOffered { choice: _ } => false
          }
      _ => false
    }
}

test fn witness_equal_labels_keep_structurally_distinct_choices() -> Bool {
  let receipt = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: TwoLegitimateMeaningsNeedChoice)
  let duplicate = match receipt.primary {
    ChoiceRequired { question, continuation } =>
      gunbc.native_scm_interaction_contract.NativeScmReceipt {
        identity: receipt.identity,
        transition: receipt.transition,
        review: receipt.review,
        access: receipt.access,
        check: receipt.check,
        operational: receipt.operational,
        projections: receipt.projections,
        primary: gunbc.native_scm_interaction_contract.ChoiceRequired {
          question: question,
          continuation: gunbc.native_scm_interaction_contract.NativeScmContinuation {
            proposal: continuation.proposal,
            options: gunbc.native_scm_interaction_contract.NativeScmContinuationOptions {
              first_option: continuation.options.first_option,
              second_option: gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
                label: continuation.options.first_option.label,
                result_preview: "a different result hidden behind the same choice",
                resume_token: "resume-duplicate-choice",
              },
              additional_options: [],
            },
          },
        },
        receipt_details: receipt.receipt_details,
      }
    _ => receipt
  }
  match duplicate.primary {
    ChoiceRequired { question: _, continuation } =>
      match native_scm_resolve_choice(
        continuation: continuation,
        choice: NativeScmSecondContinuationOption,
      ) {
        NativeScmContinuationChoiceMatched { selected } =>
          selected.identity.choice == NativeScmSecondContinuationOption
            && selected.option.resume_token == "resume-duplicate-choice"
            && string_contains(
              s: selected.option.result_preview,
              pattern: "different result",
            )
        NativeScmContinuationChoiceNotOffered { choice: _ } => false
      }
    _ => false
  }
}

test fn witness_incompatible_goals_ask_authorized_decider() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: IncompatibleGoalsNeedAuthorizedDecider)
  primary_label(receipt: r) == "ChoiceRequired"
    && match r.primary {
      ChoiceRequired { question, continuation } =>
        string_contains(s: question, pattern: "authorized decider")
          && count(native_scm_choice_previews(continuation: continuation)) == 2
          && continuation.options.first_option.label == "retain goal A"
          && continuation.options.second_option.label == "retain goal B"
          && match native_scm_resolve_choice(
            continuation: continuation,
            choice: NativeScmFirstContinuationOption,
          ) {
            NativeScmContinuationChoiceMatched { selected } =>
              selected.identity.choice == NativeScmFirstContinuationOption
                && selected.option.resume_token == "resume-retain-goal-a"
                && string_contains(
                  s: selected.option.result_preview,
                  pattern: "retain goal A",
                )
            NativeScmContinuationChoiceNotOffered { choice: _ } => false
          }
          && match native_scm_resolve_choice(
            continuation: continuation,
            choice: NativeScmSecondContinuationOption,
          ) {
            NativeScmContinuationChoiceMatched { selected } =>
              selected.identity.choice == NativeScmSecondContinuationOption
                && selected.option.resume_token == "resume-retain-goal-b"
                && string_contains(
                  s: selected.option.result_preview,
                  pattern: "retain goal B",
                )
            NativeScmContinuationChoiceNotOffered { choice: _ } => false
          }
      _ => false
    }
}

test fn witness_obtainable_evidence_is_gathered_internally() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: EvidenceGatheredInternally)
  primary_label(receipt: r) == "Landed"
    && match r.receipt_details {
      v2.std.optional.Present { value: d } => string_contains(s: d, pattern: "obtainable evidence")
      v2.std.optional.Absent => false
    }
}

test fn witness_tool_model_proof_deficits_stay_internal() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: ToolModelProofDeficitRoutesInternally)
  primary_label(receipt: r) == "InProgress"
    && match r.transition {
      NativeScmCommitTransitionUncommitted => true
      _ => false
    }
    && match r.primary {
      InProgress { progress_preview } =>
        string_contains(s: progress_preview, pattern: "internal")
      _ => false
    }
    && match native_scm_inspect_receipt(receipt: r, authorized: false) {
      v2.std.optional.Absent => true
      v2.std.optional.Present { value: _ } => false
    }
}

test fn witness_projection_failure_repairs_without_reinterpretation() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: ProjectionFailureRepairsWithoutReinterpretation)
  let outcome = native_scm_record_repaired_projection(
    receipt: r,
    projection: fixture_compatibility_projection(),
  )
  primary_label(receipt: r) == "Landed"
    && count(r.projections.realizations) == 0
    && match outcome {
      NativeScmProjectionRepaired { receipt: repaired } =>
        primary_label(receipt: repaired) == "Landed"
          && count(repaired.projections.realizations) == 1
          && repaired.projections.realizations
            |> any(row =>
              row.realization == "git-r0"
                && row.target == "refs/heads/main"
            )
          && match repaired.operational {
            NativeScmOperationalReady => true
            _ => false
          }
      _ => false
    }
}

test fn witness_projection_repair_cannot_clear_internal_deficit() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: ToolModelProofDeficitRoutesInternally)
  let outcome = native_scm_record_repaired_projection(
    receipt: r,
    projection: fixture_compatibility_projection(),
  )
  match outcome {
    NativeScmProjectionRepairBlockedByInternalWork { receipt: unchanged } =>
      primary_label(receipt: unchanged) == "InProgress"
        && count(unchanged.projections.realizations) == 0
        && match unchanged.operational {
          NativeScmInternalWorkPending => true
          _ => false
        }
        && match unchanged.check {
          NativeScmLifecyclePending => true
          _ => false
        }
    _ => false
  }
}

test fn witness_conventional_scm_import_without_manual_rewrite() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: ConventionalScmImportWithoutManualRewrite)
  primary_label(receipt: r) == "Landed"
    && match r.primary {
      Landed { result_preview } =>
        !string_contains(s: result_preview, pattern: "Git")
          && !string_contains(s: result_preview, pattern: "rebase")
      _ => false
    }
}

test fn witness_visibility_authorized_details_only_when_allowed() -> Bool {
  let r = test.claim.native_scm_interaction_contract_witness.receipt_for(scenario: VisibilityAuthorizedDetails)
  match native_scm_inspect_receipt(receipt: r, authorized: false) {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
    && match native_scm_inspect_receipt(receipt: r, authorized: true) {
      v2.std.optional.Present { value: details } =>
        string_contains(s: details, pattern: "visibility-authorized-details")
      v2.std.optional.Absent => false
    }
}
