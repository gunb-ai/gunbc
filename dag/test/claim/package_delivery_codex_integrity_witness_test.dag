module test.claim.package_delivery_codex_integrity_witness_test


data witness_note: String = "THREE STAGES. Wire decode → npm_registry_integrity_from_decode → codex_admit_npm_integrity(NpmRegistryIntegrity). Malformed wire never reaches Codex policy. Upstream may admit SHA-1; Codex refuses it. Pin is DERIVED from NpmRegistryArtifact — one exact-identity authority."

data claude_agent_sdk_integrity: String = "sha512-glc7SdwPkOkLw8oxwLo9PKTdLJGqW/PIR4urWXFoRtX9YllwozsEVc5Tc1+EvLSkfrsxPJqQWqOgpjUOQXf1oA=="

data claude_agent_sdk_integrity_hex: String = "82573b49dc0f90e90bc3ca31c0ba3d3ca4dd2c91aa5bf3c8478bab59716846d5fd625970a33b0455ce53735f84bcb4a47ebb313c9a905aa3a0a6350e4177f5a0"

test fn codex_admits_measured_sha512_integrity() -> Bool {
  match extdeps.npm.npm_decode_integrity(wire: claude_agent_sdk_integrity) {
    extdeps.npm.NpmSingleSha512Integrity { digest } =>
      match extdeps.npm.npm_registry_integrity_from_decode(
        decoded: extdeps.npm.NpmSingleSha512Integrity { digest: digest },
      ) {
        extdeps.npm.NpmRegistryIntegrityAdmitted { integrity } =>
          match gunbc.package_delivery.codex_admit_npm_integrity(integrity: integrity) {
            gunbc.package_delivery.CodexNpmIntegrityAdmitted { digest: admitted } =>
              (admitted.hex as String) == claude_agent_sdk_integrity_hex
            _ => false
          }
        extdeps.npm.NpmRegistryIntegrityWireRefused { cause: _ } => false
      }
    _ => false
  }
}

test fn codex_profile_refuses_sha1_integrity() -> Bool {
  match extdeps.npm.npm_decode_integrity(wire: "sha1-AAECAwQFBgcICQoLDA0ODxAREhM=") {
    extdeps.npm.NpmSingleSha1Integrity { digest } =>
      match extdeps.npm.npm_registry_integrity_from_decode(
        decoded: extdeps.npm.NpmSingleSha1Integrity { digest: digest },
      ) {
        extdeps.npm.NpmRegistryIntegrityAdmitted { integrity } =>
          match gunbc.package_delivery.codex_admit_npm_integrity(integrity: integrity) {
            gunbc.package_delivery.CodexNpmIntegritySha1Unsupported { digest: _ } => true
            _ => false
          }
        extdeps.npm.NpmRegistryIntegrityWireRefused { cause: _ } => false
      }
    _ => false
  }
}

test fn malformed_wire_never_reaches_codex_policy() -> Bool {
  let decoded = extdeps.npm.npm_decode_integrity(wire: "sha512-!!!")
  match decoded {
    extdeps.npm.NpmIntegrityMalformed { reason: _ } =>
      match extdeps.npm.npm_registry_integrity_from_decode(decoded: decoded) {
        extdeps.npm.NpmRegistryIntegrityWireRefused { cause: _ } => true
        extdeps.npm.NpmRegistryIntegrityAdmitted { integrity: _ } => false
      }
    _ => false
  }
}

test fn npm_registry_artifact_derives_exact_pin_from_native_integrity() -> Bool {
  match extdeps.npm.npm_decode_integrity(wire: claude_agent_sdk_integrity) {
    extdeps.npm.NpmSingleSha512Integrity { digest } =>
      match extdeps.npm.npm_registry_integrity_from_decode(
        decoded: extdeps.npm.NpmSingleSha512Integrity { digest: digest },
      ) {
        extdeps.npm.NpmRegistryIntegrityAdmitted { integrity } => {
          let artifact = extdeps.npm.NpmRegistryArtifact {
            package: extdeps.package.PackageCoordinate {
              ecosystem: extdeps.npm.NpmRegistry { registry: "https://registry.npmjs.org/" as std.types.NonEmptyStr },
              name: "@anthropic-ai/claude-agent-sdk" as std.types.NonEmptyStr,
            },
            version: "0.1.0" as std.types.NonEmptyStr,
            resolved: extdeps.npm.NpmResolvedRegistryArtifact {
              locator: "https://registry.npmjs.org/@anthropic-ai/claude-agent-sdk/-/claude-agent-sdk-0.1.0.tgz" as std.types.NonEmptyStr,
            },
            expected_integrity: integrity,
          }
          let pin = extdeps.npm.npm_registry_artifact_pin(artifact: artifact)
          match pin.selection {
            extdeps.pin.ExactPin =>
              match pin.expected_identity {
                std.content_hash.Sha512Hash(pinned) =>
                  (pinned.hex as String) == claude_agent_sdk_integrity_hex
                    && (pin.version as String) == "0.1.0"
                _ => false
              }
            _ => false
          }
        }
        extdeps.npm.NpmRegistryIntegrityWireRefused { cause: _ } => false
      }
    _ => false
  }
}
