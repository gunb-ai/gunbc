module test.claim.package_delivery_codex_integrity_witness_test

import std.types { Bool, String, NonEmptyStr }
import std.content_hash { Sha512Hash }
import extdeps.pin { ExactPin }
import extdeps.package { PackageCoordinate }
import extdeps.npm {
  npm_decode_integrity,
  npm_registry_integrity_from_decode,
  npm_registry_artifact_pin,
  NpmSingleSha512Integrity,
  NpmSingleSha1Integrity,
  NpmRegistryIntegrityAdmitted,
  NpmRegistryIntegrityWireRefused,
  NpmIntegrityMalformed,
  NpmRegistry,
  NpmRegistryArtifact,
  NpmResolvedRegistryArtifact,
}
import gunbc.package_delivery {
  codex_admit_npm_integrity,
  CodexNpmIntegrityAdmitted,
  CodexNpmIntegritySha1Unsupported,
}

data witness_note: String = "THREE STAGES. Wire decode → npm_registry_integrity_from_decode → codex_admit_npm_integrity(NpmRegistryIntegrity). Malformed wire never reaches Codex policy. Upstream may admit SHA-1; Codex refuses it. Pin is DERIVED from NpmRegistryArtifact — one exact-identity authority."

data claude_agent_sdk_integrity: String = "sha512-glc7SdwPkOkLw8oxwLo9PKTdLJGqW/PIR4urWXFoRtX9YllwozsEVc5Tc1+EvLSkfrsxPJqQWqOgpjUOQXf1oA=="

data claude_agent_sdk_integrity_hex: String = "82573b49dc0f90e90bc3ca31c0ba3d3ca4dd2c91aa5bf3c8478bab59716846d5fd625970a33b0455ce53735f84bcb4a47ebb313c9a905aa3a0a6350e4177f5a0"

test fn codex_admits_measured_sha512_integrity() -> Bool {
  match npm_decode_integrity(wire: claude_agent_sdk_integrity) {
    NpmSingleSha512Integrity { digest } =>
      match npm_registry_integrity_from_decode(
        decoded: NpmSingleSha512Integrity { digest: digest },
      ) {
        NpmRegistryIntegrityAdmitted { integrity } =>
          match codex_admit_npm_integrity(integrity: integrity) {
            CodexNpmIntegrityAdmitted { digest: admitted } =>
              (admitted.hex as String) == claude_agent_sdk_integrity_hex
            _ => false
          }
        NpmRegistryIntegrityWireRefused { cause: _ } => false
      }
    _ => false
  }
}

test fn codex_profile_refuses_sha1_integrity() -> Bool {
  match npm_decode_integrity(wire: "sha1-AAECAwQFBgcICQoLDA0ODxAREhM=") {
    NpmSingleSha1Integrity { digest } =>
      match npm_registry_integrity_from_decode(
        decoded: NpmSingleSha1Integrity { digest: digest },
      ) {
        NpmRegistryIntegrityAdmitted { integrity } =>
          match codex_admit_npm_integrity(integrity: integrity) {
            CodexNpmIntegritySha1Unsupported { digest: _ } => true
            _ => false
          }
        NpmRegistryIntegrityWireRefused { cause: _ } => false
      }
    _ => false
  }
}

test fn malformed_wire_never_reaches_codex_policy() -> Bool {
  let decoded = npm_decode_integrity(wire: "sha512-!!!")
  match decoded {
    NpmIntegrityMalformed { reason: _ } =>
      match npm_registry_integrity_from_decode(decoded: decoded) {
        NpmRegistryIntegrityWireRefused { cause: _ } => true
        NpmRegistryIntegrityAdmitted { integrity: _ } => false
      }
    _ => false
  }
}

test fn npm_registry_artifact_derives_exact_pin_from_native_integrity() -> Bool {
  match npm_decode_integrity(wire: claude_agent_sdk_integrity) {
    NpmSingleSha512Integrity { digest } =>
      match npm_registry_integrity_from_decode(
        decoded: NpmSingleSha512Integrity { digest: digest },
      ) {
        NpmRegistryIntegrityAdmitted { integrity } => {
          let artifact = NpmRegistryArtifact {
            package: PackageCoordinate {
              ecosystem: NpmRegistry { registry: "https://registry.npmjs.org/" as NonEmptyStr },
              name: "@anthropic-ai/claude-agent-sdk" as NonEmptyStr,
            },
            version: "0.1.0" as NonEmptyStr,
            resolved: NpmResolvedRegistryArtifact {
              locator: "https://registry.npmjs.org/@anthropic-ai/claude-agent-sdk/-/claude-agent-sdk-0.1.0.tgz" as NonEmptyStr,
            },
            expected_integrity: integrity,
          }
          let pin = npm_registry_artifact_pin(artifact: artifact)
          match pin.selection {
            ExactPin =>
              match pin.expected_identity {
                Sha512Hash(pinned) =>
                  (pinned.hex as String) == claude_agent_sdk_integrity_hex
                    && (pin.version as String) == "0.1.0"
                _ => false
              }
            _ => false
          }
        }
        NpmRegistryIntegrityWireRefused { cause: _ } => false
      }
    _ => false
  }
}
