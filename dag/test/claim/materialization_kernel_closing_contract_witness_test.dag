module test.claim.materialization_kernel_closing_contract_witness

import v2.std.optional { optional_absent, optional_present }
import gunbc.materialization_kernel_closing_contract {
  ClauseVerdict,
  ContractClause,
  closing_contract_clauses,
  clause_delivered,
  materialization_kernel_clause_count,
  materialization_kernel_closing_contract_holds,
  materialization_kernel_every_clause_has_evidence,
  materialization_kernel_progress_count,
}
import std.types { Bool }
import v2.std.algebra { length }

data materialization_kernel_closing_contract_witness_note: String = "Discriminating RED for the v1-materialization-kernel closing contract (brief origin: parent session still-bat-561, Lane F). materialization_kernel_closing_contract_holds_is_false_today is an EXPECT-RED control (DESIGN §4b): it asserts the AND-fold is false over the seven audited clauses, proving the contract can genuinely fail rather than being a vacuous always-true wrapper. It stays enrolled after any clause climbs to Delivered — a later regression that silently reverts a clause to NotDelivered is caught by this same assertion flipping true, not by a fresh test someone forgot to add."

test fn materialization_kernel_closing_contract_holds_is_false_today() -> Bool {
  materialization_kernel_closing_contract_holds(clauses: closing_contract_clauses()) == false
}

test fn materialization_kernel_seven_clauses_enrolled() -> Bool {
  materialization_kernel_clause_count(clauses: closing_contract_clauses()) == 7
    && length(xs: closing_contract_clauses()) == 7
}

test fn materialization_kernel_every_clause_carries_evidence() -> Bool {
  materialization_kernel_every_clause_has_evidence(clauses: closing_contract_clauses())
}

test fn materialization_kernel_progress_is_nonzero_and_incomplete() -> Bool {
  materialization_kernel_progress_count(clauses: closing_contract_clauses()) == 4
    && materialization_kernel_progress_count(clauses: closing_contract_clauses()) <
      materialization_kernel_clause_count(clauses: closing_contract_clauses())
}

fn find_clause(clauses: List<ContractClause>, id: String) -> ContractClause? {
  clauses
    |> fold(
      init: optional_absent(),
      f: (acc, c) => match acc {
        Present { value: _ } => acc
        Absent => if c.id == id { optional_present(value: c) } else { optional_absent() }
      }
    )
}

fn clause_delivered_by_id(clauses: List<ContractClause>, id: String) -> Bool {
  match find_clause(clauses: clauses, id: id) {
    Present { value: c } => clause_delivered(c: c)
    Absent => false
  }
}

test fn contract_exists_clause_delivered() -> Bool {
  clause_delivered_by_id(clauses: closing_contract_clauses(), id: "contract-exists-and-can-fail")
}

test fn warm_hit_clause_partially_delivered_not_falsely_green() -> Bool {
  clause_delivered_by_id(clauses: closing_contract_clauses(), id: "warm-hit-skips-semantic-recompute") == false
}

test fn refusal_clause_delivered() -> Bool {
  clause_delivered_by_id(
    clauses: closing_contract_clauses(),
    id: "corruption-identity-completeness-overcap-refuse"
  )
}

test fn eviction_clause_delivered() -> Bool {
  clause_delivered_by_id(clauses: closing_contract_clauses(), id: "bounded-eviction-and-full-store")
}

test fn lookup_reorder_clause_not_delivered() -> Bool {
  clause_delivered_by_id(clauses: closing_contract_clauses(), id: "lookup-ahead-of-index-construction") == false
}

test fn production_invocation_clause_not_delivered() -> Bool {
  clause_delivered_by_id(clauses: closing_contract_clauses(), id: "real-production-invocation") == false
}

test fn hand_rust_tracking_clause_delivered() -> Bool {
  clause_delivered_by_id(clauses: closing_contract_clauses(), id: "hand-rust-growth-tracked-live")
}
