data v_matchjoin_source: String = "module probe_v_matchjoin

import std.optional \{ Present, Absent \}

type Box
  = Full \{ n: Int \}

type R \{
  diags: List<Int>
\}

fn mk(b: Box) -> R \{
  R \{ diags: [] \}
\}

fn go(o: Box?) -> List<Int> \{
  let r = match o \{
    Present \{ value: b \} => Present \{ value: mk(b: b) \}
    Absent => none
  \}
  match r \{
    Present \{ value: x \} => x.diags
    Absent => []
  \}
\}
"

test fn v_matchjoin() -> Bool {
  outcome_clean(o: compile_one(name: "probe_v_matchjoin", src: v_matchjoin_source))
}

