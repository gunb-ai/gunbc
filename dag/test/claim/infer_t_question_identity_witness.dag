module test.claim.infer_t_question_identity_witness

import std.types { String, Bool, Int, List }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.instruments.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  FixtureSource,
  fixture_source,
  compile_fixture
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// OPERATOR RULING H3 (gunbc.roadmap.roadmap_authority, N3 HOME RULINGS): `none` stays syntax for optional
// absence and is LOWERED to the Absent arm of the Optional<payload> its position supplies -- the expected
// type, or the optional-typed sibling of a join. It is not typed by a default: with no expected Optional
// and no optional sibling it is not lowered here. Present is typed as the same declaration's instance, so
// the two arms of a join agree by the declaration with no bridge.

data mint_decl_source: String = "module std.optional\n\ntype Optional<T>\n  = Absent\n  | Present \{ value: T \}\n"

data present_none_join_source: String = "module probe_present_none_join\n\nimport std.optional \{ Present \}\n\nfn joined(b: Bool) -> Int \{\n  let x = if b \{ Present \{ value: 1 \} \} else \{ none \}\n  match x \{\n    Present \{ value: v \} => v\n    Absent => 0\n  \}\n\}\n"

data none_then_present_join_source: String = "module probe_none_then_present_join\n\nimport std.optional \{ Present \}\n\nfn joined(b: Bool) -> Int \{\n  let x = if b \{ none \} else \{ Present \{ value: 1 \} \}\n  match x \{\n    Present \{ value: v \} => v\n    Absent => 0\n  \}\n\}\n"

data none_beside_t_question_source: String = "module probe_none_beside_t_question\n\nfn joined(b: Bool, p: Int?) -> Int? \{\n  if b \{ p \} else \{ none \}\n\}\n"

data both_none_source: String = "module probe_both_none\n\nfn joined(b: Bool) -> Int? \{\n  if b \{ none \} else \{ none \}\n\}\n"

data present_none_field_read_source: String = "module probe_present_none_field_read\n\nimport std.optional \{ Present \}\n\ntype Box = \{ n: Int \}\n\nfn read(b: Bool) -> Int \{\n  let x = if b \{ Present \{ value: Box \{ n: 1 \} \} \} else \{ none \}\n  match x \{\n    Present \{ value: v \} => v.n\n    Absent => 0\n  \}\n\}\n"

fn compile_one(name: String, src: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [
      fixture_source("std/optional.dag", mint_decl_source),
      fixture_source(concat(name, ".dag"), src)
    ],
    entry: concat(name, ".dag")
  })
}

fn outcome_clean(o: MultiModuleCompileFixtureOutcome) -> Bool {
  match o {
    FixtureCompileCompleted { module_count: n, emitted_files: files, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(rows) == 0 && count(files) > 0 && n > 0,
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false,
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// RED: an if-join of Present and `none` types with no source edit (it refused with
// "if branches resolve to incompatible types: Product(Unit) vs Coproduct(Optional)" before the lowering).
test fn an_if_join_of_present_and_none_types_with_no_source_edit() -> Bool {
  outcome_clean(o: compile_one(name: "probe_present_none_join", src: present_none_join_source))
}

test fn an_if_join_of_none_and_present_types_with_no_source_edit() -> Bool {
  outcome_clean(o: compile_one(name: "probe_none_then_present_join", src: none_then_present_join_source))
}

test fn an_if_join_of_none_and_a_t_question_sibling_types() -> Bool {
  outcome_clean(o: compile_one(name: "probe_none_beside_t_question", src: none_beside_t_question_source))
}

// Positive control: `none` under the declared T? return, with no sibling, is lowered by the expected type.
test fn none_under_an_expected_t_question_types() -> Bool {
  outcome_clean(o: compile_one(name: "probe_both_none", src: both_none_source))
}

// The payload a lowered Optional carries is readable: matching the join binds the payload with its own
// type, not the declaration's unsubstituted formal.
test fn matching_a_present_none_join_reads_the_payload_fields() -> Bool {
  outcome_clean(o: compile_one(name: "probe_present_none_field_read", src: present_none_field_read_source))
}

// H3 / CardOptional RETIRED: `T?` is a compiler-generated reference to std.optional Optional, bound by the
// row's identity, so it needs no import and no user declaration can capture it.
data no_import_t_question_source: String = "module probe_no_import_t_question\n\nfn pass(p: Int?) -> Int? \{\n  p\n\}\n"

data shadowing_optional_source: String = "module probe_shadowing_optional\n\ntype Optional<T>\n  = Nope\n  | Some \{ value: T \}\n\nfn pass(p: Int?) -> Int? \{\n  p\n\}\n"

data shadowing_optional_arm_read_source: String = "module probe_shadowing_optional_arm_read\n\ntype Optional<T>\n  = Nope\n  | Some \{ value: T \}\n\nfn read(p: Int?) -> Int \{\n  match p \{\n    Some \{ value: v \} => v\n    Nope => 0\n  \}\n\}\n"

test fn t_question_needs_no_std_optional_import() -> Bool {
  outcome_clean(o: compile_one(name: "probe_no_import_t_question", src: no_import_t_question_source))
}

test fn t_question_is_not_captured_by_a_module_declaring_its_own_optional() -> Bool {
  outcome_clean(o: compile_one(name: "probe_shadowing_optional", src: shadowing_optional_source))
}

// RED: if the user's own Optional captured `T?`, reading its arms would type. It must refuse, because the
// parameter is std.optional's Optional.
test fn a_user_optional_arm_cannot_read_a_t_question_value() -> Bool {
  !outcome_clean(o: compile_one(name: "probe_shadowing_optional_arm_read", src: shadowing_optional_arm_read_source))
}

data call_arg_none_source: String = "module probe_call_arg_none\n\ntype Kind\n  = A\n  | B\n\nfn take(k: Kind?) -> Int \{\n  0\n\}\n\nfn go() -> Int \{\n  take(k: none)\n\}\n"

test fn none_as_a_call_argument_under_a_t_question_formal_types() -> Bool {
  outcome_clean(o: compile_one(name: "probe_call_arg_none", src: call_arg_none_source))
}

