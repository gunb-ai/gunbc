module test.claim.app_attest_verifier_witness_test

import std.logic { Bool }
import std.types { Int, String, List, NonEmptyStr, Timestamp }
import extdeps.apple.app_attest {
  AttestKeyId, AppIdPrefix, AppAttestDevelopment, AppAttestProduction, app_attest_app_id,
  AttestationExpectation, verify_attestation, AttestationVerified, AttestationRefused,
  AttestationFormatUnexpected, AttestationChainUntrusted, AttestationNonceMismatch, AttestationKeyIdMismatch, AttestationAppIdMismatch,
  AttestationCounterNonZero, AttestationEnvironmentUnexpected, AttestationCredentialIdMismatch, AttestationValidationCategoryAbsent,
  AttestationUndecodable,
  AssertionExpectation, verify_assertion, AssertionAuthentic, AssertionRefused, AssertionAppIdMismatch, AssertionValidationCategoryAbsent,
  assertion_signature_verifies_for, chain_link_verifies, base64_of,
  assertion_parts, AssertionPartsOk, AssertionPartsRefused,
  decode_attestation, AttestationDecodeOk, AttestationDecodeRefused, AttestationDecoded, attestation_structural_refusal,
  attestation_parts, AttestationPartsOk, AttestationPartsRefused, AttestationRefusal, app_attest_certificate,
}
import extdeps.standards.rfc_5280 { X509Certificate, X509TbsFields }
import extdeps.apple.app_attest_sample_ios_14_4 {
  sample_attestation_octets, sample_assertion_octets, sample_key_id_b64, sample_team_identifier, sample_bundle_identifier,
  sample_assertion_counter, sample_client_data,
}

// THE VERIFIER FOLDS OVER APPLE'S REAL OBJECT. The sample predates the two extension steps (9 and
// 10: apple_validation_category_01 and apple_bundle_version_01 in authData's extensions map), so
// the whole attestation fold REFUSES on it, correctly, with AttestationValidationCategoryAbsent --
// and because every check before that one in the fold's order is a step Apple names (nonce, key
// id, RP ID, counter, AAGUID, credentialId, chain names, validity), reaching that refusal IS the
// executed evidence that steps 2-8 pass on real bytes. TWO THINGS THIS DOES NOT ESTABLISH, each
// with its own reason: the whole-fold positive control needs an attestation carrying those
// extensions (the first object off the operator's phone); and step 1, the chain signatures, runs
// after the extension steps and so is not reached here at all -- it is claimed at its own producer
// below, where its refusing arms execute and its verifying arms are enrolled with the P-384 cost
// stated as the reason they do not.

fn sample_expectation() -> AttestationExpectation {
  AttestationExpectation {
    key_id: sample_key_id_b64 as AttestKeyId,
    client_data: sample_client_data,
    app_id: app_attest_app_id(prefix: sample_team_identifier as AppIdPrefix, bundle_id: sample_bundle_identifier),
    environment: AppAttestDevelopment,
    observed_at: "2021-01-23T12:13:35Z",
    admitted_validation_categories: [2, 3, 4],
    expected_bundle_version: "1" as NonEmptyStr,
  }
}

fn attestation_refusal_name(c: AttestationRefusal) -> String {
  match c {
    AttestationFormatUnexpected { declared: d } => "format:" + d
    AttestationChainUntrusted { detail: d } => "chain:" + d
    AttestationNonceMismatch => "nonce"
    AttestationKeyIdMismatch { declared: _ } => "key-id"
    AttestationAppIdMismatch { expected_app_id: _ } => "app-id"
    AttestationCounterNonZero { counter: _ } => "counter"
    AttestationEnvironmentUnexpected { expected: _ } => "environment"
    AttestationCredentialIdMismatch { declared: _ } => "credential-id"
    AttestationValidationCategoryAbsent => "category-absent"
    AttestationUndecodable { cause: d } => "undecodable:" + d
    _ => "other"
  }
}

// THE REAL PATH, end to end: Apple's bytes through decode_attestation and the whole verify fold.
fn sample_attestation_refusal_of(e: AttestationExpectation) -> String {
  match verify_attestation(object: sample_attestation_octets, e: e) {
    AttestationVerified { verified: _ } => "verified"
    AttestationRefused { cause: c } => attestation_refusal_name(c: c)
  }
}

// THE STEP FOLD ALONE, over the sample decoded ONCE in the calling claim. The subject is
// attestation_structural_refusal; decoding is not, so it is paid once rather than once per
// expectation. The carrier is decoded from the sample's bytes rather than transcribed as a literal:
// the sample module is the one authority for Apple's object, and a hand-written AttestationDecoded
// would be a second one. Cross-claim sharing is not available -- a data value is cached per claim
// context -- so once per claim is the floor this subject can reach.
fn structural_refusal_name(d: AttestationDecoded, e: AttestationExpectation) -> String {
  match attestation_structural_refusal(parts: d.parts, leaf: d.leaf, ca: d.ca, root: d.root, auth: d.auth, e: e) {
    Absent => "none"
    Present { value: c } => attestation_refusal_name(c: c)
  }
}

// INHABITANCE, THE ATTESTATION'S REAL PATH: Apple's bytes through decode_attestation and the whole
// verify fold. It asserts the ROUTE by the refusal it names -- steps 2-8 and the chain's names and
// validity pass on the real object, so the first refusal is step 9's absence, which the 2021 sample
// cannot satisfy. Every supplied-input claim below leans on this one for the real path.
test fn the_sample_passes_every_step_before_the_extension_steps() -> Bool {
  sample_attestation_refusal_of(e: sample_expectation()) == "category-absent"
}

// SUBJECT: the structural step fold (attestation_structural_refusal). Each earlier step reds by name
// when its expectation is wrong: client data (nonce), key id, App ID, environment; and observing it
// in 2026 finds the credential certificate expired. The object is decoded once for all five; the
// real path's inhabitance is the_sample_passes_every_step_before_the_extension_steps.
test fn each_expectation_reds_its_own_step() -> Bool {
  let e = sample_expectation()
  match decode_attestation(object: sample_attestation_octets) {
    AttestationDecodeRefused { cause: _ } => false
    AttestationDecodeOk { decoded: d } =>
      structural_refusal_name(d: d, e: AttestationExpectation { key_id: e.key_id, client_data: "wurzelpfropg" as NonEmptyStr, app_id: e.app_id, environment: e.environment, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) == "nonce"
        && structural_refusal_name(d: d, e: AttestationExpectation { key_id: "YmbJO4x5nEHUvncp9zdWuVZjNBEMgJn3cdSToAXQe3Q=" as AttestKeyId, client_data: e.client_data, app_id: e.app_id, environment: e.environment, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) == "key-id"
        && structural_refusal_name(d: d, e: AttestationExpectation { key_id: e.key_id, client_data: e.client_data, app_id: "6MURL8TA57.de.vincent-haupert.other" as NonEmptyStr, environment: e.environment, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) == "app-id"
        && structural_refusal_name(d: d, e: AttestationExpectation { key_id: e.key_id, client_data: e.client_data, app_id: e.app_id, environment: AppAttestProduction, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) == "environment"
        && structural_refusal_name(d: d, e: AttestationExpectation { key_id: e.key_id, client_data: e.client_data, app_id: e.app_id, environment: e.environment, observed_at: "2026-09-21T00:00:00Z", admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) == "chain:credential certificate expired at 2021-01-25T12:13:35Z"
  }
}

// The object with one octet of "apple-appattest" changed refuses as a format it does not know;
// cut to 100 octets it refuses as undecodable.
test fn a_malformed_object_refuses_before_any_step() -> Bool {
  let mutated = concat(sample_attestation_octets |> take(20), concat([117], sample_attestation_octets |> skip(21)))
  let cut = sample_attestation_octets |> take(100)
  match verify_attestation(object: mutated, e: sample_expectation()) {
    AttestationRefused { cause: AttestationFormatUnexpected { declared: "apple-appattesu" } } =>
      match verify_attestation(object: cut, e: sample_expectation()) {
        AttestationRefused { cause: AttestationUndecodable { cause: _ } } => true
        _ => false
      }
    _ => false
  }
}

// THE CREDENTIAL KEY IS READ FROM THE ATTESTATION, NOT TRANSCRIBED (review 69803 of gunbc#11989):
// the assertion's expectation carries the leaf's SubjectPublicKey rendered by the same base64_of
// verify_attestation emits, so the attestation-output -> assertion-input join is one chain rather
// than two islands agreeing by hand. Absent when the sample's leaf does not decode.
fn assertion_expectation() -> AssertionExpectation? {
  match sample_leaf() {
    Absent => none
    Present { value: leaf } =>
      match base64_of(octets: leaf.tbs.spki_public_key, url_safe: true) {
        Absent => none
        Present { value: point } => Present { value: AssertionExpectation {
          key_id: sample_key_id_b64 as AttestKeyId,
          public_key_point_b64url: point as NonEmptyStr,
          client_data: sample_client_data,
          app_id: app_attest_app_id(prefix: sample_team_identifier as AppIdPrefix, bundle_id: sample_bundle_identifier),
          admitted_validation_categories: [2, 3, 4],
          expected_bundle_version: "1" as NonEmptyStr,
        } }
      }
  }
}

// THE COUNTER THE FOLD CARRIES OUT: the sample assertion's authenticatorData signCount is the
// corpus's published counter, read at the parts grain because the whole fold refuses on absent
// extensions before it can hand the counter to step 5.
test fn the_sample_assertion_counter_is_the_published_one() -> Bool {
  match assertion_parts(object: sample_assertion_octets) {
    AssertionPartsOk { parts: p } => p.auth.prefix.sign_count == sample_assertion_counter
    AssertionPartsRefused { cause: _ } => false
  }
}

// INHABITANCE, THE ASSERTION'S REAL PATH, including the attestation -> assertion key join.
// The assertion fold: RP ID passes on real bytes and the first refusal is step 7's absence (the
// 37-octet prefix carries no extensions); the counter is carried out as 1 either way; a wrong App
// ID reds step 4 by name.
test fn the_sample_assertion_passes_rp_id_and_refuses_on_absent_extensions() -> Bool {
  match assertion_expectation() {
    Absent => false
    Present { value: e } =>
  match verify_assertion(object: sample_assertion_octets, e: e) {
    AssertionRefused { cause: AssertionValidationCategoryAbsent } =>
      match verify_assertion(object: sample_assertion_octets, e: AssertionExpectation { key_id: e.key_id, public_key_point_b64url: e.public_key_point_b64url, client_data: e.client_data, app_id: "6MURL8TA57.de.other" as NonEmptyStr, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) {
        AssertionRefused { cause: AssertionAppIdMismatch { expected_app_id: _ } } => true
        _ => false
      }
    _ => false
  }
  }
}

// STEPS 1-3 ON REAL BYTES: Apple's assertion signature verifies under the credential key for
// nonce = SHA-256(authenticatorData || SHA-256(sample_client_data)); and is false for other client
// data. One interpreted P-256 verification each (gunbc#11645's cost shape), and each crosses the
// floor's 8 s wall deadline -- a crossing the eval-step drop beside this file does not and may not
// cover, and that drop's own text says these two left the floor. They therefore ARE ordinary fns,
// so the floor does not plan them (review 69953 of gunbc#11989 found them still declared `test fn`,
// which made the drop's sentence false and left a wall crossing in no declared population). The
// same disposition the sibling test.claim.signature_verify_join_witness_test took. Their consumer
// is the native gunbc test row that gunbc.auth.approval_device_redemption
// ecdsa_verification_realization_frontier names; until it executes, a quiet host may run them by
// name through claim_batch's --functions, and they are not evidence the acceptance path has.
fn the_sample_assertion_signature_verifies_under_the_credential_key() -> Bool {
  match assertion_expectation() {
    Absent => false
    Present { value: e } =>
      match assertion_signature_verifies_for(object: sample_assertion_octets, e: e) {
        Present { value: v } => v
        Absent => false
      }
  }
}

fn the_sample_assertion_signature_is_false_for_other_client_data() -> Bool {
  match assertion_expectation() {
    Absent => false
    Present { value: e } =>
  match assertion_signature_verifies_for(object: sample_assertion_octets, e: AssertionExpectation { key_id: e.key_id, public_key_point_b64url: e.public_key_point_b64url, client_data: "wurzelpfropg" as NonEmptyStr, app_id: e.app_id, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }) {
    Present { value: v } => !v
    Absent => false
  }
  }
}


// A key the caller stored that is not a base64url point is an ENCODING refusal (Absent), never a
// verdict (review 69773 of gunbc#11989: the mapper carries it as AssertionUndecodable, not as
// AssertionSignatureInvalid) -- and it is cheap, refusing before any curve arithmetic or nonce hash.
// SUBJECT: assertion_signature_verifies' key decoding. The key is the value under test, so it is
// supplied; it is not read from the attestation, whose join to the assertion is carried by
// the_sample_assertion_passes_rp_id_and_refuses_on_absent_extensions.
test fn an_undecodable_stored_key_is_absent_not_a_false_verdict() -> Bool {
  match assertion_signature_verifies_for(object: sample_assertion_octets, e: AssertionExpectation {
    key_id: sample_key_id_b64 as AttestKeyId,
    public_key_point_b64url: "not*base64url" as NonEmptyStr,
    client_data: sample_client_data,
    app_id: app_attest_app_id(prefix: sample_team_identifier as AppIdPrefix, bundle_id: sample_bundle_identifier),
    admitted_validation_categories: [2, 3, 4],
    expected_bundle_version: "1" as NonEmptyStr,
  }) {
    Present { value: _ } => false
    Absent => true
  }
}

// ── The chain link (Apple's step 1), claimed at its own producer ─────────────────────────────

// The sample's two certificates, read from ONE parse of the attestation's parts: the chain-link
// claim needs both and the assertion claims need the leaf, and none of them needs the pinned root
// or the authenticator data, so none of them pays for decode_attestation.
type SampleCertificates {
  leaf: X509Certificate
  ca: X509Certificate
}

fn sample_certificates() -> SampleCertificates? {
  match attestation_parts(object: sample_attestation_octets) {
    AttestationPartsRefused { cause: _ } => none
    AttestationPartsOk { parts: p } =>
      match app_attest_certificate(octets: p.leaf) {
        Absent => none
        Present { value: leaf } =>
          match app_attest_certificate(octets: p.ca) {
            Absent => none
            Present { value: ca } => Present { value: SampleCertificates { leaf: leaf, ca: ca } }
          }
      }
  }
}

fn sample_leaf() -> X509Certificate? {
  match attestation_parts(object: sample_attestation_octets) {
    AttestationPartsRefused { cause: _ } => none
    AttestationPartsOk { parts: p } => app_attest_certificate(octets: p.leaf)
  }
}


// THE REFUSING ARMS, cheap and discriminating over the real leaf and CA: a subject whose signature
// algorithm is not an ECDSA one the verifier carries is Absent; an issuer whose key names no curve
// is Absent; an issuer on a curve the verifier does not carry is Absent. None is a verdict. The
// VERIFYING links -- Apple's step 1 on real bytes -- are the two computations
// test.claim.p384_dag_ecdsa_witness_test enrols over the same sample and are not re-made here
// (review 69668 of gunbc#11989); their executing route is the native gunbc test row the frontier
// names.
test fn chain_link_refuses_an_unsupported_algorithm_or_curve_by_absence() -> Bool {
  match sample_certificates() {
    Absent => false
    Present { value: certs } => {
          let leaf = certs.leaf
          let ca = certs.ca
          let other_alg = X509Certificate { tbs: leaf.tbs, signature_algorithm: "1.2.840.113549.1.1.11", signature_octets: leaf.signature_octets }
          let no_curve = X509Certificate { tbs: X509TbsFields {
            tbs_octets: ca.tbs.tbs_octets, serial: ca.tbs.serial, tbs_signature_algorithm: ca.tbs.tbs_signature_algorithm,
            issuer_octets: ca.tbs.issuer_octets, not_before: ca.tbs.not_before, not_after: ca.tbs.not_after, subject_octets: ca.tbs.subject_octets,
            spki_algorithm: ca.tbs.spki_algorithm, spki_named_curve: none, spki_public_key: ca.tbs.spki_public_key, extensions: ca.tbs.extensions,
          }, signature_algorithm: ca.signature_algorithm, signature_octets: ca.signature_octets }
          let other_curve = X509Certificate { tbs: X509TbsFields {
            tbs_octets: ca.tbs.tbs_octets, serial: ca.tbs.serial, tbs_signature_algorithm: ca.tbs.tbs_signature_algorithm,
            issuer_octets: ca.tbs.issuer_octets, not_before: ca.tbs.not_before, not_after: ca.tbs.not_after, subject_octets: ca.tbs.subject_octets,
            spki_algorithm: ca.tbs.spki_algorithm, spki_named_curve: Present { value: "1.3.132.0.35" }, spki_public_key: ca.tbs.spki_public_key, extensions: ca.tbs.extensions,
          }, signature_algorithm: ca.signature_algorithm, signature_octets: ca.signature_octets }
          match chain_link_verifies(subject: other_alg, issuer: ca) {
            Absent => match chain_link_verifies(subject: leaf, issuer: no_curve) {
              Absent => match chain_link_verifies(subject: leaf, issuer: other_curve) {
                Absent => true
                _ => false
              }
              _ => false
            }
            _ => false
          }
    }
  }
}
