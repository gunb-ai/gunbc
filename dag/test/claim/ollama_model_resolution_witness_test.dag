module test.claim.ollama_model_resolution_witness

import std.types { Bool, String, NonEmptyStr, Int }
import std.content_hash { ContentHash, serialize_content_hash, compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable, as_content_hash_cryptographic }
import extdeps.pin { tracked_reference_resolution_evidence }
import gunbc.ollama_model_resolution {
  gpt_oss_20b_resolution,
  gpt_oss_120b_resolution,
  gpt_oss_20b_resolution_wire,
  gpt_oss_20b_resolution_evidence_count,
  gpt_oss_20b_manifest_digest_2026_08_19,
  gpt_oss_20b_manifest_digest_2026_08_12,
}

// Three readings: the registry selection plus two independent srv6 confirmations. The count is the
// cheapest thing that reds if a future edit drops a confirmation into prose.
test fn the_resolution_carries_three_evidence_readings() -> Bool {
  gpt_oss_20b_resolution_evidence_count() == 3
    && length(tracked_reference_resolution_evidence(resolution: gpt_oss_20b_resolution())) == 3
}

// The registry is the SELECTION authority and therefore the required first evidence; the host
// readings confirm. A resolution whose primary evidence was a host reading would be circular -- it
// would prove srv6 holds what srv6 holds.
test fn the_primary_evidence_is_the_registry_not_a_host() -> Bool {
  string_contains(gpt_oss_20b_resolution().first_evidence.authority as String, "registry.ollama.ai")
    && !string_contains(gpt_oss_20b_resolution().first_evidence.authority as String, "srv6")
}

// Every reading agrees with the resolved identity. A resolution recording evidence that disagrees
// with what it resolved to would be worse than none, because the disagreement would read as support.
test fn every_reading_agrees_with_the_resolved_identity() -> Bool {
  (gpt_oss_20b_resolution().first_evidence.observed_identity.hex as String)
      == (gpt_oss_20b_manifest_digest_2026_08_19.hex as String)
    && length(filter(
      gpt_oss_20b_resolution().further_evidence,
      r => (r.observed_identity.hex as String) == (gpt_oss_20b_manifest_digest_2026_08_19.hex as String),
    )) == 2
}

// The wire carries the account, not only the answer: reference, identity, when, and on what.
test fn the_resolution_wire_carries_reference_identity_and_evidence() -> Bool {
  string_contains(gpt_oss_20b_resolution_wire(), "gpt-oss:20b")
    && string_contains(gpt_oss_20b_resolution_wire(), "17052f91a42e9793")
    && string_contains(gpt_oss_20b_resolution_wire(), "2026-08-19")
    && string_contains(gpt_oss_20b_resolution_wire(), "registry.ollama.ai")
}

