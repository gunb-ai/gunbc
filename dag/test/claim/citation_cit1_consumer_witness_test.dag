module test.claim.citation_cit1_consumer_witness

import extdeps.runtime.abi.sysv_amd64 {
  x86_64_abi_pdf_byte_extraction,
  x86_64_abi_pdf_pin,
  x86_64_abi_pdf_draft_version,
  x86_64_abi_pdf_wet_receipt_hex,
  x86_64_abi_syscall_convention_citation_fact,
  x86_64_abi_pdf_syscall_fragment_selector,
  x86_64_abi_pdf_version_navigable_uri_projection,
  x86_64_abi_pdf_syscall_navigable_uri_projection,
  x86_64_abi_pdf_navigable_uri_from_nameddest_scalar_code_points,
  x86_64_abi_pdf_expected_digest_from_extraction,
  x86_64_abi_syscall_evidence_link,
  x86_64_abi_pdf_authority,
  X86_64AbiPdfExpectedDigestConstructed,
  X86_64AbiPdfNavigableUriProjected,
  X86_64AbiPdfNavigableUriRefused,
}
import std.citation {
  RepresentationRetrieved,
  FragmentSelectorVariant,
  CitationRecordedFact,
  RetrievedRepresentation,
}
import std.claim_evidence { EvidenceSupports }
import std.content_hash { sha256_hex_digest, content_hash_eq_cryptographic }
import extdeps.version { VersionIdentity }
import extdeps.pin { pin_currency_gap, AuthoredPinHasNoReviewDate, ExactPin, Pin }
import std.types { Bool, NonEmptyStr, List }
import gunbc.citation.pdf_safe_profile { PdfOpenParameterPercentEncodeRefusedFromSafe }
import extdeps.uri { UriHexNibbleOutOfRange }
import extdeps.standards.rfc_8118 { OpenNamedDest }

data witness_unencodable_scalar_code_points: List<Int> = [1114112]

test fn x86_64_abi_pdf_extraction_receipt_mints_digest_via_validating_path() -> Bool {
  match sha256_hex_digest(hex: x86_64_abi_pdf_wet_receipt_hex) {
    Present { value: digest } =>
      match x86_64_abi_pdf_expected_digest_from_extraction(extraction: x86_64_abi_pdf_byte_extraction) {
        X86_64AbiPdfExpectedDigestConstructed(expected) =>
          content_hash_eq_cryptographic(left: digest, right: expected)
        _ => false
      }
    Absent => false
  }
}

test fn x86_64_abi_pdf_pin_carries_draft_edition_0_99_6() -> Bool {
  x86_64_abi_pdf_draft_version == ("0.99.6" as VersionIdentity)
    && match x86_64_abi_pdf_pin {
      Pin { selection: ExactPin, subject: _, version: _, expected_identity: _ } => true
      _ => false
    }
}

test fn x86_64_abi_version_cover_uri_uses_page_one() -> Bool {
  match x86_64_abi_pdf_version_navigable_uri_projection {
    X86_64AbiPdfNavigableUriProjected { uri: u } =>
      u.locator == "refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf#page=1"
    _ => false
  }
}

test fn x86_64_abi_syscall_convention_uri_uses_page_twenty_eight() -> Bool {
  match x86_64_abi_pdf_syscall_navigable_uri_projection {
    X86_64AbiPdfNavigableUriProjected { uri: u } =>
      u.locator == "refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf#page=28"
    _ => false
  }
}

test fn x86_64_abi_consumer_refuses_unencodable_nameddest_navigable_uri() -> Bool {
  match x86_64_abi_pdf_navigable_uri_from_nameddest_scalar_code_points(
    name: "plant" as NonEmptyStr,
    code_points: witness_unencodable_scalar_code_points,
  ) {
    X86_64AbiPdfNavigableUriRefused {
      cause: PdfOpenParameterPercentEncodeRefusedFromSafe {
        parameter: OpenNamedDest(_),
        cause: UriHexNibbleOutOfRange { digit: 1114112 },
      },
    } => true
    _ => false
  }
}

test fn x86_64_abi_syscall_citation_selector_conforms_to_rfc_8118() -> Bool {
  match x86_64_abi_pdf_syscall_fragment_selector {
    FragmentSelectorVariant(s) =>
      string_contains(s: s.conforms_to.uri.locator, pattern: "rfc8118")
        && s.value == ("page=28" as NonEmptyStr)
        && s.conforms_to.uri.locator != x86_64_abi_pdf_authority.uri.locator
    _ => false
  }
}

test fn x86_64_abi_syscall_citation_bound_to_evidence_link() -> Bool {
  x86_64_abi_syscall_evidence_link().fact.id == x86_64_abi_syscall_convention_citation_fact.id
    && x86_64_abi_syscall_evidence_link().direction == EvidenceSupports
}

test fn x86_64_abi_syscall_citation_fact_binds_extraction_observation() -> Bool {
  match x86_64_abi_pdf_byte_extraction {
    RepresentationRetrieved { observed: o, request: _, observed_at: _, http_status: _ } =>
      match x86_64_abi_syscall_convention_citation_fact.value {
        CitationRecordedFact { cited: c } =>
          match c.representation {
            RetrievedRepresentation { observed: obs } => obs.observed_identity == o.observed_identity
            none => false
          }
      }
    _ => false
  }
}

test fn pin_currency_gap_is_total_not_citation_current() -> Bool {
  match pin_currency_gap(pin: x86_64_abi_pdf_pin) {
    AuthoredPinHasNoReviewDate => true
    _ => false
  }
}
