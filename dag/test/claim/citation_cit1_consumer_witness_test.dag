module test.claim.citation_cit1_consumer_witness

import extdeps.runtime.abi.sysv_amd64 {
  x86_64_abi_pdf_byte_extraction_construction,
  x86_64_abi_pdf_pin_construction,
  x86_64_abi_pdf_draft_version,
  x86_64_abi_pdf_wet_receipt_hex,
  x86_64_abi_pdf_pin_establishment_run_identity,
  x86_64_abi_pdf_retrieval_run_identity,
  x86_64_abi_pdf_pin_establishment_digest_construction,
  x86_64_abi_syscall_convention_citation_fact_construction,
  x86_64_abi_pdf_syscall_fragment_selector,
  x86_64_abi_pdf_version_navigable_uri_projection,
  x86_64_abi_pdf_syscall_navigable_uri_projection,
  x86_64_abi_pdf_navigable_uri_from_nameddest_scalar_code_points,
  x86_64_abi_pdf_expected_digest_construction,
  x86_64_abi_syscall_evidence_link_construction,
  x86_64_abi_pdf_authority,
  x86_64_abi_syscall_convention_authoritative_page,
  x86_64_abi_syscall_citation_page_is_authoritative,
  x86_64_abi_pdf_fragment_selector_from_page,
  x86_64_abi_pdf_retrieval_observation_from_hex,
  witness_pin_establishment_and_retrieval_run_identities_differ,
  witness_syscall_citation_reconciles_pin_and_retrieval,
  X86_64AbiPdfExpectedDigestConstructed,
  X86_64AbiPdfPinEstablishmentDigestConstructed,
  X86_64AbiPdfCitationSelectorConstructed,
  X86_64AbiPdfNavigableUriProjected,
  X86_64AbiPdfNavigableUriRefused,
  X86_64AbiPdfPinConstructed,
  X86_64AbiCitationFactConstructed,
  X86_64AbiCitationFactRefused,
  X86_64AbiEvidenceLinkConstructed,
  X86_64AbiEvidenceLinkRefused,
  X86_64AbiPdfRetrievalObserved,
  X86_64AbiPdfRetrievalDigestHexRefused,
  WetReceiptHexMalformed,
}
import std.citation {
  RepresentationRetrieved,
  FragmentSelectorVariant,
  cited_representation_identity_eq,
  CitationAccessRefused,
  HttpAccessRefused,
}
import std.content_hash { content_hash_eq_cryptographic }
import std.claim_evidence { EvidenceSupports }
import extdeps.version { VersionIdentity }
import extdeps.pin { pin_currency_gap, AuthoredPinHasNoReviewDate, ExactPin, Pin }
import std.types { Bool, NonEmptyStr, List }
import gunbc.citation.pdf_safe_profile { PdfOpenParameterPercentEncodeRefusedFromSafe }
import extdeps.uri { UriPercentEncodeUnicodeScalarOutOfRangeRefused }
import extdeps.standards.rfc_8118 { OpenNamedDest }

data witness_unencodable_scalar_code_points: List<Int> = [1114112]

data witness_malformed_receipt_hex: String = "not-a-valid-sha256-hex"

test fn x86_64_abi_pin_establishment_and_retrieval_runs_are_independent() -> Bool {
  witness_pin_establishment_and_retrieval_run_identities_differ()
}

test fn x86_64_abi_pin_expected_digest_provenance_is_independent_of_retrieval() -> Bool {
  match x86_64_abi_pdf_pin_establishment_digest_construction {
    X86_64AbiPdfPinEstablishmentDigestConstructed(establishment_digest) =>
      match x86_64_abi_pdf_expected_digest_construction {
        X86_64AbiPdfExpectedDigestConstructed(expected) =>
          content_hash_eq_cryptographic(left: establishment_digest, right: expected)
            && match x86_64_abi_pdf_byte_extraction_construction {
              X86_64AbiPdfRetrievalObserved(RepresentationRetrieved { observed: o, request: _, observed_at: _, http_status: _ }) =>
                content_hash_eq_cryptographic(left: establishment_digest, right: o.observed_identity)
              X86_64AbiPdfRetrievalDigestHexRefused { hex: _, cause: _ } => false
            }
        _ => false
      }
    _ => false
  }
}

test fn x86_64_abi_syscall_citation_reconciles_independent_pin_and_retrieval() -> Bool {
  witness_syscall_citation_reconciles_pin_and_retrieval()
}

test fn x86_64_abi_malformed_receipt_hex_refuses_locally_not_http_RED() -> Bool {
  match x86_64_abi_pdf_retrieval_observation_from_hex(hex: witness_malformed_receipt_hex) {
    X86_64AbiPdfRetrievalDigestHexRefused {
      hex: _,
      cause: WetReceiptHexMalformed { hex: _ },
    } => true
    X86_64AbiPdfRetrievalObserved(CitationAccessRefused { cause: HttpAccessRefused { status: _ }, request: _, observed_at: _ }) => false
    X86_64AbiPdfRetrievalObserved(RepresentationRetrieved { request: _, observed_at: _, http_status: _, observed: _ }) => false
    _ => false
  }
}

test fn x86_64_abi_syscall_page_125_is_authoritative() -> Bool {
  x86_64_abi_syscall_citation_page_is_authoritative(page: x86_64_abi_syscall_convention_authoritative_page)
}

test fn x86_64_abi_syscall_page_28_does_not_authorize_convention_claim_RED() -> Bool {
  !x86_64_abi_syscall_citation_page_is_authoritative(page: 28)
}

test fn x86_64_abi_pdf_pin_carries_draft_edition_0_99_6() -> Bool {
  match x86_64_abi_pdf_pin_construction {
    X86_64AbiPdfPinConstructed(pin) =>
      x86_64_abi_pdf_draft_version == ("0.99.6" as VersionIdentity)
        && match pin {
          Pin { selection: ExactPin, subject: _, version: _, expected_identity: _ } => true
          _ => false
        }
    _ => false
  }
}

test fn x86_64_abi_version_cover_uri_uses_page_one() -> Bool {
  match x86_64_abi_pdf_version_navigable_uri_projection {
    X86_64AbiPdfNavigableUriProjected { uri: u } =>
      u.locator == "refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf#page=1"
    _ => false
  }
}

test fn x86_64_abi_syscall_convention_uri_uses_physical_page_125() -> Bool {
  match x86_64_abi_pdf_syscall_navigable_uri_projection {
    X86_64AbiPdfNavigableUriProjected { uri: u } =>
      u.locator == "refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf#page=125"
    _ => false
  }
}

test fn x86_64_abi_consumer_refuses_unencodable_nameddest_navigable_uri() -> Bool {
  match x86_64_abi_pdf_navigable_uri_from_nameddest_scalar_code_points(
    name: "plant" as NonEmptyStr,
    code_points: witness_unencodable_scalar_code_points,
  ) {
    X86_64AbiPdfNavigableUriRefused {
      cause: PdfOpenParameterPercentEncodeRefusedFromSafe {
        parameter: OpenNamedDest(_),
        cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: 1114112 },
      },
    } => true
    _ => false
  }
}

test fn x86_64_abi_syscall_citation_selector_conforms_to_rfc_8118() -> Bool {
  match x86_64_abi_pdf_syscall_fragment_selector {
    X86_64AbiPdfCitationSelectorConstructed(FragmentSelectorVariant(s)) =>
      s.value == ("page=125" as NonEmptyStr)
    _ => false
  }
}

test fn x86_64_abi_syscall_page_28_selector_does_not_match_authoritative_claim_RED() -> Bool {
  match x86_64_abi_pdf_fragment_selector_from_page(page: 28) {
    X86_64AbiPdfCitationSelectorConstructed(FragmentSelectorVariant(s)) =>
      s.value != ("page=125" as NonEmptyStr)
    _ => false
  }
}

test fn x86_64_abi_syscall_citation_bound_to_evidence_link() -> Bool {
  match x86_64_abi_syscall_evidence_link_construction() {
    X86_64AbiEvidenceLinkConstructed(link) =>
      match x86_64_abi_syscall_convention_citation_fact_construction {
        X86_64AbiCitationFactConstructed(fact) =>
          link.fact.id == fact.id && link.direction == EvidenceSupports
        X86_64AbiCitationFactRefused { pin: _, selector: _ } => false
      }
    X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactConstructed(_) } => false
    X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactRefused { pin: _, selector: _ } } => false
  }
}

test fn x86_64_abi_syscall_citation_fact_binds_extraction_observation() -> Bool {
  match x86_64_abi_pdf_byte_extraction_construction {
    X86_64AbiPdfRetrievalObserved(RepresentationRetrieved { observed: o, request: _, observed_at: _, http_status: _ }) =>
      match x86_64_abi_syscall_convention_citation_fact_construction {
        X86_64AbiCitationFactConstructed(fact) =>
          cited_representation_identity_eq(
            left: fact.value.cited.expected_pin.subject,
            right: o.identity,
          )
            && match x86_64_abi_pdf_expected_digest_construction {
              X86_64AbiPdfExpectedDigestConstructed(expected_digest) => o.observed_identity == expected_digest
              _ => false
            }
            && match x86_64_abi_pdf_syscall_fragment_selector {
              X86_64AbiPdfCitationSelectorConstructed(FragmentSelectorVariant(s)) => s.value == ("page=125" as NonEmptyStr)
              _ => false
            }
        _ => false
      }
    X86_64AbiPdfRetrievalDigestHexRefused { hex: _, cause: _ } => false
  }
}

test fn pin_currency_gap_is_total_not_citation_current() -> Bool {
  match x86_64_abi_pdf_pin_construction {
    X86_64AbiPdfPinConstructed(pin) =>
      match pin_currency_gap(pin: pin) {
        AuthoredPinHasNoReviewDate => true
        _ => false
      }
    _ => false
  }
}
