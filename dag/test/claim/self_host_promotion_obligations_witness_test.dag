module test.claim.self_host_promotion_obligations_witness

import gunbc.self_host_promotion_obligations {
  frontier_numerator_admits_seed_evidence,
  obligation_is_registered,
  obligation_reports_itself_fired
}
import std.types { Bool }

// Each registered obligation carries a condition, a claim it puts at risk, and a
// subject declaration. Asserted per row by name rather than as a count over the roster:
// a count against a hand-authored list is a change detector, and it would also pass
// vacuously if the roster were emptied.
test fn every_registered_obligation_carries_its_three_parts() -> Bool {
  obligation_is_registered(o: frontier_numerator_admits_seed_evidence)
}

// A BOUND condition names a declaration whose appearance retires the obligation.
// Converting this remaining row to unbound prose would make an inconvenient trigger
// stop being checkable; this claim reds if that happens.
test fn the_frontier_obligation_is_checkable() -> Bool {
  obligation_reports_itself_fired(o: frontier_numerator_admits_seed_evidence)
}
