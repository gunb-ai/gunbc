module test.claim.floor_discovery_exact_subject_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data tested_commit: extdeps.git.object_store.GitObjectId = extdeps.git.object_store.GitSha1ObjectId {
  digest: std.content_hash.Sha1Digest { hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
}
data other_commit: extdeps.git.object_store.GitObjectId = extdeps.git.object_store.GitSha1ObjectId {
  digest: std.content_hash.Sha1Digest { hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
}

data tested_tree: extdeps.git.object_store.GitObjectId = extdeps.git.object_store.GitSha1ObjectId {
  digest: std.content_hash.Sha1Digest { hex: "1111111111111111111111111111111111111111" }
}

data other_tree: extdeps.git.object_store.GitObjectId = extdeps.git.object_store.GitSha1ObjectId {
  digest: std.content_hash.Sha1Digest { hex: "2222222222222222222222222222222222222222" }
}

fn naming_identity() -> std.content_hash.Fnv1a64Structural {
  content_hash_atom(value: "floor-discovery-naming-authority-fixture")
}

fn tool_identity() -> std.content_hash.Fnv1a64Structural {
  content_hash_atom(value: "floor-discovery-tool-fixture")
}

fn subject_fx(
  commit: extdeps.git.object_store.GitObjectId,
  tree: extdeps.git.object_store.GitObjectId,
  roots: List<String>,
) -> v2.workflow.floor_discovery.FloorDiscoverySubject {
  v2.workflow.floor_discovery.FloorDiscoverySubject {
    tested_commit: v2.workflow.floor_discovery.floor_discovery_commit_id(object_id: commit),
    tested_tree: v2.workflow.floor_discovery.floor_discovery_tree_id(object_id: tree),
    source_roots: roots,
    execution_authority_source_roots: ["dag", "src/v2"],
    naming_authority_identity: naming_identity(),
    tool_identity: tool_identity(),
  }
}

fn request_fx(
  subject: v2.workflow.floor_discovery.FloorDiscoverySubject,
  scope: List<String>,
  mode: std.execution_mode.ExecutionMode,
) -> v2.workflow.floor_discovery.FloorDiscoveryRequest {
  v2.workflow.floor_discovery.FloorDiscoveryRequest {
    subject: subject,
    scan_dirs: ["dag/test/claim"],
    exclude_substrings: ["/long/"],
    discovery_scope_dirs: scope,
    execution_mode: mode,
  }
}

fn canonical_subject() -> v2.workflow.floor_discovery.FloorDiscoverySubject {
  test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: test.claim.floor_discovery_exact_subject_witness.tested_commit, tree: test.claim.floor_discovery_exact_subject_witness.tested_tree, roots: ["dag", "src/v1"])
}

fn canonical_request() -> v2.workflow.floor_discovery.FloorDiscoveryRequest {
  request_fx(subject: canonical_subject(), scope: ["dag/test/claim"], mode: Hermetic)
}

test fn exact_subject_binds() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_subject_bind(
    expected: canonical_subject(),
    observed: canonical_subject(),
  ) {
    FloorDiscoverySubjectBound { subject: _ } => true
    FloorDiscoverySubjectRefused { cause: _ } => false
  }
}

test fn wrong_commit_refuses_at_commit_coordinate() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_subject_bind(
    expected: canonical_subject(),
    observed: test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: other_commit, tree: test.claim.floor_discovery_exact_subject_witness.tested_tree, roots: ["dag", "src/v1"]),
  ) {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryTestedCommitMismatch { expected: _, observed: _ }
    } => true
    _ => false
  }
}

test fn wrong_tree_refuses_at_tree_coordinate() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_subject_bind(
    expected: canonical_subject(),
    observed: test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: test.claim.floor_discovery_exact_subject_witness.tested_commit, tree: other_tree, roots: ["dag", "src/v1"]),
  ) {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoveryTestedTreeMismatch { expected: _, observed: _ }
    } => true
    _ => false
  }
}

test fn source_root_order_is_part_of_the_subject() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_subject_bind(
    expected: canonical_subject(),
    observed: test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: test.claim.floor_discovery_exact_subject_witness.tested_commit, tree: test.claim.floor_discovery_exact_subject_witness.tested_tree, roots: ["src/v1", "dag"]),
  ) {
    FloorDiscoverySubjectRefused {
      cause: FloorDiscoverySourceRootsMismatch { expected: _, observed: _ }
    } => true
    _ => false
  }
}

test fn request_preserves_subject_refusal() -> Bool {
  let wrong_subject = test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: test.claim.floor_discovery_exact_subject_witness.tested_commit, tree: other_tree, roots: ["dag", "src/v1"])
  match v2.workflow.floor_discovery.floor_discovery_request_bind(
    expected: test.claim.floor_discovery_exact_subject_witness.canonical_request(),
    observed: request_fx(subject: wrong_subject, scope: ["dag/test/claim"], mode: Hermetic),
  ) {
    FloorDiscoveryRequestRefused {
      cause: FloorDiscoveryRequestSubjectMismatch {
        cause: FloorDiscoveryTestedTreeMismatch { expected: _, observed: _ }
      }
    } => true
    _ => false
  }
}

test fn wrong_scope_refuses_without_widening() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_request_bind(
    expected: test.claim.floor_discovery_exact_subject_witness.canonical_request(),
    observed: request_fx(subject: canonical_subject(), scope: [], mode: Hermetic),
  ) {
    FloorDiscoveryRequestRefused {
      cause: FloorDiscoveryScopeMismatch { expected: _, observed: _ }
    } => true
    _ => false
  }
}

test fn wrong_execution_mode_refuses() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_request_bind(
    expected: test.claim.floor_discovery_exact_subject_witness.canonical_request(),
    observed: request_fx(subject: canonical_subject(), scope: ["dag/test/claim"], mode: Wet),
  ) {
    FloorDiscoveryRequestRefused {
      cause: FloorDiscoveryExecutionModeMismatch { expected: _, observed: _ }
    } => true
    _ => false
  }
}

test fn exact_request_binds() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_request_bind(
    expected: test.claim.floor_discovery_exact_subject_witness.canonical_request(),
    observed: test.claim.floor_discovery_exact_subject_witness.canonical_request(),
  ) {
    FloorDiscoveryRequestBound { request: _ } => true
    FloorDiscoveryRequestRefused { cause: _ } => false
  }
}

test fn commit_and_tree_each_move_request_identity() -> Bool {
  let canonical = v2.workflow.floor_discovery.floor_discovery_request_identity(request: test.claim.floor_discovery_exact_subject_witness.canonical_request())
  let changed_commit = v2.workflow.floor_discovery.floor_discovery_request_identity(
    request: request_fx(
      subject: test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: other_commit, tree: test.claim.floor_discovery_exact_subject_witness.tested_tree, roots: ["dag", "src/v1"]),
      scope: ["dag/test/claim"],
      mode: Hermetic,
    )
  )
  let changed_tree = v2.workflow.floor_discovery.floor_discovery_request_identity(
    request: request_fx(
      subject: test.claim.floor_discovery_exact_subject_witness.subject_fx(commit: test.claim.floor_discovery_exact_subject_witness.tested_commit, tree: other_tree, roots: ["dag", "src/v1"]),
      scope: ["dag/test/claim"],
      mode: Hermetic,
    )
  )
  canonical.digest != changed_commit.digest
    && canonical.digest != changed_tree.digest
    && changed_commit.digest != changed_tree.digest
}

test fn canonical_request_identity_matches_bootstrap_golden() -> Bool {
  v2.workflow.floor_discovery.floor_discovery_request_identity(request: test.claim.floor_discovery_exact_subject_witness.canonical_request()).digest == "f8e90d00ba0ad7f8"
}

test fn transport_preserves_exact_subject_and_refuses_dirty_worktree() -> Bool {
  let request = test.claim.floor_discovery_exact_subject_witness.canonical_request()
  let after_commit = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: v2.workflow.floor_discovery_transport.floor_discovery_transport_initialize(request: request),
    observation: v2.workflow.floor_discovery_transport.CommitObserved { commit: v2.workflow.floor_discovery.floor_discovery_commit_id(object_id: test.claim.floor_discovery_exact_subject_witness.tested_commit) },
  )
  let after_tree = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: after_commit,
    observation: v2.workflow.floor_discovery_transport.TreeObserved { tree: v2.workflow.floor_discovery.floor_discovery_tree_id(object_id: test.claim.floor_discovery_exact_subject_witness.tested_tree) },
  )
  match v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: after_tree,
    observation: v2.workflow.floor_discovery_transport.TrackedWorktreeObserved { modified_paths: ["src/v1/stage0/src/cli_run/floor_discovery_snapshot.rs"] },
  ) {
    TransportRefused { cause: _ } => true
    _ => false
  }
}

test fn transport_requires_clean_worktree_before_publication() -> Bool {
  let request = test.claim.floor_discovery_exact_subject_witness.canonical_request()
  let s0 = v2.workflow.floor_discovery_transport.floor_discovery_transport_initialize(request: request)
  let s1 = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: s0,
    observation: v2.workflow.floor_discovery_transport.CommitObserved { commit: v2.workflow.floor_discovery.floor_discovery_commit_id(object_id: test.claim.floor_discovery_exact_subject_witness.tested_commit) },
  )
  let s2 = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: s1,
    observation: v2.workflow.floor_discovery_transport.TreeObserved { tree: v2.workflow.floor_discovery.floor_discovery_tree_id(object_id: test.claim.floor_discovery_exact_subject_witness.tested_tree) },
  )
  let s3 = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: s2,
    observation: v2.workflow.floor_discovery_transport.TrackedWorktreeObserved { modified_paths: [] },
  )
  let s4 = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: s3,
    observation: v2.workflow.floor_discovery_transport.UntrackedWorktreeObserved { paths: [] },
  )
  let s5 = v2.workflow.floor_discovery_transport.floor_discovery_transport_observe(
    state: s4,
    observation: v2.workflow.floor_discovery_transport.SnapshotPublished {
      receipt: v2.workflow.floor_discovery_transport.FloorDiscoverySnapshotWriteReceipt {
        artifact: v2.workflow.floor_discovery_transport.FloorDiscoverySnapshotArtifact {
          request_identity_digest: v2.workflow.floor_discovery.floor_discovery_request_identity(request: request),
          payload_digest: v2.workflow.floor_discovery.floor_discovery_request_identity(request: request),
        },
        walk_attempt_id: "attempt-test",
      },
    },
  )
  match s5 {
    TransportReady => true
    _ => false
  }
}

test fn all_floor_discovery_exact_subject_controls_hold() -> Bool {
  exact_subject_binds()
    && wrong_commit_refuses_at_commit_coordinate()
    && wrong_tree_refuses_at_tree_coordinate()
    && source_root_order_is_part_of_the_subject()
    && request_preserves_subject_refusal()
    && wrong_scope_refuses_without_widening()
    && wrong_execution_mode_refuses()
    && exact_request_binds()
    && commit_and_tree_each_move_request_identity()
    && canonical_request_identity_matches_bootstrap_golden()
    && transport_preserves_exact_subject_and_refuses_dirty_worktree()
    && transport_requires_clean_worktree_before_publication()
}
