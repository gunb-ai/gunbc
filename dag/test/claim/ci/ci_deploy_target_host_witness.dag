module test.claim.ci.ci_deploy_target_host_witness

import gunbc.runner.runner_user_session_receipt { ReceiptAbsent }
import gunbc.ci.ci_spec { gunbc_ci_deploy_srv1_stage }
import gunbc.ci.ci_deploy_target_host {
  deploy_local_apply_refused_for_observed_host,
  deploy_target_host_apply_permitted,
  deploy_target_host_observed_hostname,
  deploy_target_ssh_proof_structurally_valid,
  deploy_target_proof,
  gunbc_ci_deploy_srv1_runner_spec,
  host_pinned_runner_spec,
}
import gunbc.ci.ci_deploy_access {
  ci_deploy_srv1_access,
  deploy_access_with_ssh_transport,
  deploy_target_proof_from_access,
}
import gunbc.fleet.fleet_intent { srv1_host }
import gunbc.host.host_effect { SshShell }
import gunbc.ci.ci_fleet { srv3_offer, srv4_offer }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1,
  operator_host_srv2,
  operator_host_srv3,
  operator_host_srv4,
  operator_host_srv14,
}
import gunbc.host.host_effect { LocalShell }
import gunbc.runner.runner_slot_allocation { runner_labels_satisfy_selector }
import gunbc.runner.runner_registration_labels {
  runner_evidence_gated_registration_labels, RegistrationLabelsResolved, RegistrationLabelsRefused,
}
import product.host_identity { HostIdentity }
import extdeps.github.actions { RunnerSpec, SelfHosted }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn witness_srv1_hostname_proves_target() -> Bool {
  let proof = deploy_target_proof_from_access(access: ci_deploy_srv1_access)
  deploy_target_host_apply_permitted(
    proof: proof,
    observed_hostname: "srv1",
    observed_runner_name: "actions-runner@srv1-01.service"
  )
}

test fn witness_srv2_hostname_refused_for_srv1_deploy() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: ci_deploy_srv1_access.host.identity,
    transport: ci_deploy_srv1_access.transport,
    observed_hostname: "srv2",
    observed_runner_name: "actions-runner@srv2-09.service"
  )
}

test fn witness_srv12_runner_name_refused_for_srv1_deploy() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: ci_deploy_srv1_access.host.identity,
    transport: ci_deploy_srv1_access.transport,
    observed_hostname: "srv12",
    observed_runner_name: "actions-runner@srv12-01.service"
  )
}

test fn witness_ubicloud_runner_name_refused_for_local_apply() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: ci_deploy_srv1_access.host.identity,
    transport: ci_deploy_srv1_access.transport,
    observed_hostname: "ubicloud-runner",
    observed_runner_name: "ubicloud-standard-16-arm"
  )
}

// THE REAL PRODUCER PATH, ON A HOST THAT HAS A NAME. srv14 answers "butch" -- the deploy gate used to
// ask whether the observed spelling EQUALLED the target identity, which is true only of a host with no
// name of its own, so this exact deploy was refused while srv1 sat idle and srv14 went unconverged.
// The runner label here names a DIFFERENT host, so nothing but the resolved hostname can carry the
// proof: this test is the control that the site itself, not just the shared rule, runs on it.
test fn witness_a_named_host_proves_its_own_deploy_target() -> Bool {
  !deploy_local_apply_refused_for_observed_host(
    host: operator_host_srv14,
    transport: LocalShell,
    observed_hostname: "butch",
    observed_runner_name: "actions-runner@srv9-01.service"
  )
}

// AND THE REFUSAL IS STILL A REFUSAL: a spelling no roster answers to proves nothing, and the runner
// label pointing at another host cannot smuggle it through. It is not read as a host, cast to one, or
// compared to one.
test fn witness_an_unresolved_hostname_proves_no_deploy_target() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: operator_host_srv14,
    transport: LocalShell,
    observed_hostname: "totch",
    observed_runner_name: "actions-runner@srv9-01.service"
  )
}

// TWO NAMES, TWO MACHINES: srv14's own deploy refuses a kernel answering srv15's name, even though
// both are real hosts the roster knows -- and the runner label cannot rescue it, because that label
// names srv15 too. The identity each side resolves to is what is compared, on both proofs.
test fn witness_a_named_host_refuses_another_hosts_name() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: operator_host_srv14,
    transport: LocalShell,
    observed_hostname: "bobo",
    observed_runner_name: "actions-runner@srv15-01.service"
  ) && !deploy_local_apply_refused_for_observed_host(
    host: operator_host_srv14,
    transport: LocalShell,
    observed_hostname: "srv14",
    observed_runner_name: "actions-runner@srv14-01.service"
  )
}

test fn witness_ssh_transport_structural_proof_holds() -> Bool {
  let ssh_access = deploy_access_with_ssh_transport(
    access: ci_deploy_srv1_access,
    ssh_host: operator_host_srv1
  )
  deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof_from_access(access: ssh_access)
  )
}

test fn witness_ssh_transport_mismatch_refused() -> Bool {
  let ssh_access = deploy_access_with_ssh_transport(
    access: ci_deploy_srv1_access,
    ssh_host: operator_host_srv2
  )
  !deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof_from_access(access: ssh_access)
  )
}

// deploy_runner_label_list_contains carries a qualified name because the bare one was a homonym
// and this module declares no imports, so every reference resolves out of whatever pool the run
// assembled. gunbc.design.component declares a byte-identical label_list_contains under different
// parameter names (xs, x), and a run whose pool contained that module bound THIS module's call
// sites to it — the witness failed with "no parameter named 'labels' (declared: [xs, x])", a local
// declaration losing to a pool member. The rename removes the collision at this site. It does not
// fix the underlying class: one concept (membership in a List<String>) still has three
// declarations in the corpus — the component one, this one, and std.materialization_ladder
// string_list_contains — and reference binding still varies with which unrelated files a run
// loads. Both are recorded on the namespace lane; neither is repaired here.
fn deploy_runner_label_list_contains(labels: List<String>, needle: String) -> Bool {
  fold(labels, init: false, f: (acc, l) => acc || (l == needle))
}

test fn witness_deploy_stage_pins_srv1_runner_label() -> Bool {
  gunbc_ci_deploy_srv1_stage.runner == gunbc_ci_deploy_srv1_runner_spec()
    && match gunbc_ci_deploy_srv1_stage.runner {
      SelfHosted { labels: labels } =>
        deploy_runner_label_list_contains(labels: labels, needle: "srv1")
          && deploy_runner_label_list_contains(labels: labels, needle: "self-hosted")
      _ => false
    }
}

test fn witness_deploy_job_not_on_ubicloud_runner() -> Bool {
  match gunbc_ci_deploy_srv1_stage.runner {
    RunsOnExpression { expression: _ } => false
    SelfHosted { labels: _ } => true
    _ => false
  }
}

test fn witness_local_proof_requires_host_identity() -> Bool {
  match deploy_target_proof_from_access(access: ci_deploy_srv1_access) {
    RunnerIdentityOnHost { host: id } => id == operator_host_srv1
    _ => false
  }
}

test fn witness_access_host_is_srv1() -> Bool {
  ci_deploy_srv1_access.host == srv1_host
    && match ci_deploy_srv1_access.transport {
      LocalShell => true
      _ => false
    }
}

test fn witness_observed_hostname_reads_typed_op_hermetic() -> Bool {
  deploy_target_host_observed_hostname() == "localhost"
}


// ── registration vs host-pinned selector: one host-identity-to-label projection ──────────────────
// The selector a host-pinned workflow names and the labels a runner registers with both spell the
// host through gunbc.runner.runner_slot_allocation runner_host_label; a selector is satisfied by set
// membership. The positive control is the pair on the same host; the RED is the pair across hosts.
fn selector_labels(spec: RunnerSpec) -> List<String> {
  match spec {
    SelfHosted { labels: labels } => labels
    _ => []
  }
}

// A host whose labels do not resolve holds NO label, so it satisfies no selector.
fn registered(host: HostIdentity) -> List<String> {
  match runner_evidence_gated_registration_labels(host: host, receipt: ReceiptAbsent) {
    RegistrationLabelsResolved { labels: labels } => labels
    RegistrationLabelsRefused { host: _, cause: _ } => []
  }
}

test fn srv4_registration_satisfies_the_srv4_host_pinned_selector() -> Bool {
  let selector = selector_labels(spec: host_pinned_runner_spec(offer: srv4_offer, host: operator_host_srv4))
  count(selector) > 0
    && runner_labels_satisfy_selector(held: registered(host: operator_host_srv4), selector: selector)
}

test fn srv3_registration_does_not_satisfy_the_srv4_host_pinned_selector() -> Bool {
  !runner_labels_satisfy_selector(
    held: registered(host: operator_host_srv3),
    selector: selector_labels(spec: host_pinned_runner_spec(offer: srv4_offer, host: operator_host_srv4)),
  )
}

// The registration carries platform, class and host labels, spelled here independently of the
// composition.
test fn srv3_registration_carries_platform_class_and_host_labels() -> Bool {
  runner_labels_satisfy_selector(held: registered(host: operator_host_srv3), selector: ["gunbc-heavy", "srv3", "self-hosted", "linux", "arm64"])
    && !runner_labels_satisfy_selector(held: registered(host: operator_host_srv3), selector: ["srv4"])
}

// PLATFORM LABELS ARE THE HOST'S OWN, NOT A FLEET DEFAULT. A host with no compute offer has no
// observed OS or architecture, so it refuses instead of being registered as linux/arm64.
test fn host_without_a_compute_offer_refuses_registration_labels() -> Bool {
  match runner_evidence_gated_registration_labels(host: "not-an-enrolled-host" as HostIdentity, receipt: ReceiptAbsent) {
    RegistrationLabelsRefused { host: _, cause: _ } => true
    RegistrationLabelsResolved { labels: _ } => false
  }
}

// THE SSH DESTINATION IS RESOLVED, NOT EQUALLED. srv14's kernel answers "butch"; the proof built from an
// SshShell aimed at "butch" used to be structurally INVALID, because the check asked whether the destination
// character-for-character equalled the identity srv14. A machine with a name could not be deployed to over
// ssh at all. The join accepts it now, and the two refusals below are why that is not a loosening: a
// destination that belongs to somebody else, and one that belongs to nobody, both still refuse.
test fn an_ssh_destination_naming_the_named_machine_proves_the_target() -> Bool {
  deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof(
      host: operator_host_srv14,
      transport: SshShell { ssh_host: "butch" as NonEmptyStr }
    )
  )
}

test fn an_ssh_destination_naming_another_machine_is_refused() -> Bool {
  !deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof(
      host: operator_host_srv14,
      transport: SshShell { ssh_host: "srv1" as NonEmptyStr }
    )
  )
}

test fn an_ssh_destination_that_is_nobody_s_is_refused() -> Bool {
  !deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof(
      host: operator_host_srv14,
      transport: SshShell { ssh_host: "srv-nobody" as NonEmptyStr }
    )
  )
}
