module test.claim.ci_budget_tree_witness

import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.session_reservation_policy { session_reservation_bytes, ReservationBytes, ReservationBytesNotApplicable, ReservationBytesUnestablished }
import gunbc.ci_runner_placement { resolve_session_slice }
import gunbc.ci_runner_target { FleetSelfHosted, ci_runner_target_ram_speed_budget }
import gunbc.ci_budget_tree {
  srv1_budget_tree,
  srv1_gha_runner_pool_budget,
  srv1_ci_run_container_hard_cap,
  srv1_fixed_overhead_bytes,
  srv1_floor_memory_budget,
  host_overhead_bytes,
  host_ram_of,
  host_budget_tree_at,
  witness_floor_budget_equals_selected_target_budget,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn fitting_slice() -> Int {
  53687091200
}

// OVERSIZED MUST BE OVERSIZED BY CONSTRUCTION, NOT BY A LITERAL CHOSEN AGAINST ONE HOST SIZE.
// This was 214748364800 (200 GiB), which overcommitted srv1 while srv1 had 128 GiB of RAM. srv1
// was upgraded to 8 x 64 GiB on 2026-08-22, and 200 GiB stopped overcommitting a ~502 GiB host --
// so the fixture silently stopped testing overcommit and witness_overcommit_fails_conservation
// went red on main. The literal was never grounded in a controlled fixture; it was grounded in the
// live host's RAM, which is the oracle failure DESIGN 5 names: a number copied from the tree it is
// asserting about. Deriving it from the same allocatable authority the tree divides makes it
// exceed the host for ANY host size, so no future RAM change can quietly disarm this arm.
fn oversized_slice() -> Int {
  byte_size_count(b: host_allocatable_bytes(offer: srv1_offer)) + 1
}

test fn witness_live_trees_conserve() -> Bool {
  node_conserves(node: srv1_budget_tree)
    && node_conserves(node: srv2_budget_tree)
    && node_conserves(node: srv3_budget_tree)
}

// THE LIVE POOLS FOLLOW THE ARM srv1's SESSION RESERVATION ACTUALLY RESOLVES TO. This claim asserted
// the Unestablished arm unconditionally (runner pool 0, session pool = all allocatable), which was
// the fail-closed answer while srv1 had no reservation sizing. srv1 now resolves ReservationBytes
// (gunbc.session_reservation_policy), so a positive runner pool is the CORRECT derivation and the
// claim was red for a premise that had stopped holding. Each arm's relation is asserted instead,
// so the fail-closed half still bites the day srv1 falls back to Unestablished.
test fn witness_live_is_fail_closed() -> Bool {
  let alloc = byte_size_count(b: host_allocatable_bytes(offer: srv1_offer))
  let gha = byte_size_count(b: srv1_gha_runner_pool_budget())
  let sess = byte_size_count(b: srv1_dashboard_session_pool_budget())
  match session_reservation_bytes(host: srv1_offer.supply.physical.identity) {
    ReservationBytes { bytes: b } =>
      sess == byte_size_count(b: b) && gha == alloc - byte_size_count(b: b) && gha > 0
    ReservationBytesNotApplicable => sess == 0 && gha == alloc
    ReservationBytesUnestablished { cause: _ } => gha == 0 && sess == alloc
  }
}

test fn witness_measured_fixture_derives_positive_runner_pool() -> Bool {
  let tree = host_budget_tree_at(name: "srv1", offer: srv1_offer, session_slice: byte_size(fitting_slice()))
  let runner_pool = match budget_tree_gha_runner_pool_node(tree: tree) {
    BudgetChildFound { node: n } => byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let expected = byte_size_count(b: host_allocatable_bytes(offer: srv1_offer)) - fitting_slice()
  node_conserves(node: tree) && runner_pool > 0 && runner_pool == expected
}

test fn witness_overcommit_fails_conservation() -> Bool {
  let tree = host_budget_tree_at(name: "srv1", offer: srv1_offer, session_slice: byte_size(oversized_slice()))
  let runner_pool = match budget_tree_gha_runner_pool_node(tree: tree) {
    BudgetChildFound { node: n } => byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  runner_pool == 0 && !node_conserves(node: tree)
}

test fn witness_three_way_conservation_live() -> Bool {
  let overhead = byte_size_count(b: srv1_fixed_overhead_bytes())
  let gha = byte_size_count(b: srv1_gha_runner_pool_budget())
  let dash = byte_size_count(b: srv1_dashboard_session_pool_budget())
  overhead + gha + dash <= byte_size_count(b: srv1_host_ram())
}

// srv1 AND srv2 SHARE ONE OVERHEAD (the legacy allowance; witness_managed_hosts_share_one_overhead_
// and_legacy_hosts_share_another) BUT NOT ONE AMOUNT OF RAM: srv1 was rebuilt to 8 x 64 GiB on
// 2026-08-22 and srv2 was not, and the trees read OS-usable RAM per host since #11625. So equal pools
// stopped being true; what symmetry still means is that the two pools differ by EXACTLY the RAM
// difference -- same overhead, same slice, nothing else charged differently.
test fn witness_srv2_symmetric_to_srv1() -> Bool {
  let s1 = host_budget_tree_at(name: "srv1", offer: srv1_offer, session_slice: byte_size(fitting_slice()))
  let s2 = host_budget_tree_at(name: "srv2", offer: srv2_offer, session_slice: byte_size(fitting_slice()))
  let p1 = match budget_tree_gha_runner_pool_node(tree: s1) {
    BudgetChildFound { node: n } => byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let p2 = match budget_tree_gha_runner_pool_node(tree: s2) {
    BudgetChildFound { node: n } => byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let ram_gap = byte_size_count(b: host_ram_of(offer: srv1_offer)) - byte_size_count(b: host_ram_of(offer: srv2_offer))
  p2 > 0 && (p1 - p2) == ram_gap
}

test fn witness_two_pools_present() -> Bool {
  let gha_found = match budget_tree_gha_runner_pool_node(tree: srv1_budget_tree) {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
  let dash_found = match budget_tree_dashboard_session_pool_node(tree: srv1_budget_tree) {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
  return gha_found && dash_found
}

test fn witness_unknown_child_is_absent() -> Bool {
  match budget_child_named(node: srv1_budget_tree, name: "__no_such_child__") {
    BudgetChildFound { node: _ } => false
    BudgetChildMissing => true
  }
}

test fn witness_spawn_width_budget_within_per_runner_cap() -> Bool {
  let fleet_budget = byte_size_count(b: ci_runner_target_ram_speed_budget(target: FleetSelfHosted))
  byte_size_count(b: srv1_floor_memory_budget()) > 0
    && fleet_budget <= byte_size_count(b: gunbc_ci_runner_slot_memory_max_live)
    && fleet_budget <= byte_size_count(b: gunbc_per_runner_memory_cap)
    && fleet_budget < byte_size_count(b: srv1_host_ram())
}

test fn witness_hard_cap_is_runner_cgroup_cap() -> Bool {
  byte_size_count(b: srv1_ci_run_container_hard_cap()) == byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
}

test fn witness_floor_budget_equals_selected_target_budget_holds() -> Bool {
  witness_floor_budget_equals_selected_target_budget()
}

// THIS WITNESS ASSERTED THE OPPOSITE UNTIL 2026-08-05 and the inversion is the change, not a broken
// test. witness_srv3_symmetric_to_srv1 held that srv1 and srv3 derive the SAME runner pool from the
// same session slice, which was true while every host shared one fixed-overhead number, and it was
// worth asserting then: srv3 had just been stood up and the claim being defended was that a
// FreshStandup host is budgeted identically to an established one rather than getting a special
// case.
//
// What changed is not the claim's importance but its truth. gunbc.ci_floor_measurement now carries
// a MEASURED overhead bound for the managed hosts (srv3/srv4) and an operator ALLOWANCE for the
// legacy pair (srv1/srv2), because srv1 and srv2 host hand-built deployments the corpus does not
// model and srv3 does not. Same board, same RAM, same per-slot row — different unmodeled residents,
// so different allocatable memory. Asserting equality now would require charging srv3 for srv1's
// mess, which is exactly the 10.4GiB per host this split exists to stop spending.
//
// What is asserted instead is STRICTLY STRONGER than the old equality: not merely that the two
// differ, but that they differ in the right DIRECTION and by exactly the overhead gap. A witness
// that only checked p1 != p3 would pass if the numbers were swapped — srv1 handed the measured
// bound and srv3 the legacy allowance — which is the same bug with the hosts transposed and is
// precisely the failure a bare inequality cannot see.

// THE GAP NOW INCLUDES THE USABLE-RAM DIFFERENCE. Since #11625 each tree reads its own host's
// OS-usable RAM, and srv1 and srv3 -- same board, same DIMMs -- differ by firmware reservation
// (host_ram_of names the instrument; the figure is not transcribed here). The claim assumed equal
// usable RAM, so it was off by exactly that difference. Both terms are read from the producers rather than transcribed.
test fn witness_srv3_outbudgets_srv1_by_exactly_the_overhead_gap() -> Bool {
  let s1 = host_budget_tree_at(name: "srv1", offer: srv1_offer, session_slice: byte_size(fitting_slice()))
  let s3 = host_budget_tree_at(name: "srv3", offer: srv3_offer, session_slice: byte_size(fitting_slice()))
  let p1 = match budget_tree_gha_runner_pool_node(tree: s1) {
    BudgetChildFound { node: n } => byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let p3 = match budget_tree_gha_runner_pool_node(tree: s3) {
    BudgetChildFound { node: n } => byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let gap = byte_size_count(b: host_overhead_bytes(offer: srv1_offer)) - byte_size_count(b: host_overhead_bytes(offer: srv3_offer))
  let ram_gap = byte_size_count(b: host_ram_of(offer: srv3_offer)) - byte_size_count(b: host_ram_of(offer: srv1_offer))
  p3 > p1 && p3 > 0 && (p3 - p1) == gap + ram_gap && gap > 0
}

test fn witness_managed_hosts_share_one_overhead_and_legacy_hosts_share_another() -> Bool {
  let legacy1 = byte_size_count(b: host_overhead_bytes(offer: srv1_offer))
  let legacy2 = byte_size_count(b: host_overhead_bytes(offer: srv2_offer))
  let managed3 = byte_size_count(b: host_overhead_bytes(offer: srv3_offer))
  let managed4 = byte_size_count(b: host_overhead_bytes(offer: srv4_offer))
  legacy1 == legacy2 && managed3 == managed4 && legacy1 > managed3
}

