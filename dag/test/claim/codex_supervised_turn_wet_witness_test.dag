module test.claim.codex_supervised_turn_wet_witness_test

import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.types { Bool, String, FilePath, NonEmptyStr }
import std.temporal_effect { LeaseAbsent, LeaseRunningExpected }
import gunbc.package_delivery {
  codex_runtime_lock_path,
  codex_runtime_manifest_path,
  materialize_codex_runtime_bundle,
  admit_codex_package_lock_text,
  CodexPackageLockAdmitted,
  AdmittedCodexRuntimeSource,
  CodexRuntimeMaterialized,
}
import gunbc.codex_app_server_press {
  observe_codex_account_preflight,
  ProviderProbeKey,
  CodexPressAccountReady,
  CodexPressLoginRequired,
  CodexPressUnavailable,
  CodexPressRefused,
}
import gunbc.codex_runtime_bundle { codex_bundle_executable_path }
import gunbc.roadmap_workflow_command { WorkerTurn }
import gunbc.codex_supervised_turn {
  CodexSupervisedTurnOk,
  CodexSupervisedTurnRefused,
  CodexSupervisedTurnUnavailable,
  CodexRunnerTurnTerminalReceipt,
  codex_supervised_turn_binding,
  codex_supervised_turn_client_command_id,
  run_codex_supervised_turn,
}
import gunbc.provider_turn_adjudication { press_display_finished }
import extdeps.shell

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data witness_note: String = "WET BISECT + FULL CHAIN (operator-bounded srv1 only). srv1 2026-08-14: supervised_turn_materialized_bundle_writes_terminal_receipt hit ~89 GiB RSS / 22 min CPU, zero child processes — never spawned npm or codex (press-0-step2 wet receipt). Bisect under MemoryMax: wet_committed_admitted_source_lock_admits (2G), wet_materialize_codex_runtime_bundle_only (8G), then full chain (12G cap until root cause located). Full fn is OfflineLocalRecipe — NOT on falsifier roster until envelope + bisect characterize the burn. See wet_supervised_turn_memory_envelope_note."

data wet_supervised_turn_memory_envelope_note: String = "MEMORY ENVELOPE (srv1 kill receipt 2026-08-14, ac5f031d9). Operator enforces caps; these are declared expectations for refusal-not-OOM, not measured yet on bisect: wet_committed_admitted_source_lock_admits — MemoryMax=2G (filesystem_read + admit_codex_package_lock_text only; shared package_delivery path); wet_materialize_codex_runtime_bundle_only — MemoryMax=8G (materialize class ~150s wall on falsifier, spawns npm); supervised_turn_materialized_bundle_writes_terminal_receipt — MemoryMax=12G REFUSED until bisect passes and interpreter burn is characterized (full run killed at 89G with no children — likely interpreter eval before shell spawn, not npm RSS). Example: systemd-run --scope -p MemoryMax=2G -- gunbc run --source-root dag --source-root src/v2 --entry dag/test/claim/codex_supervised_turn_wet_witness_test.dag --function wet_committed_admitted_source_lock_admits"

data wet_supervised_turn_oom_receipt_note: String = "srv1 bounded wet 2026-08-14: parse clean; compile phases ~5s; decl eval 22 min at 98.7% CPU; RSS ~89 GiB at kill; pgrep showed no app-server/npm/mktemp children. Diagnosis: unbounded interpreter work BEFORE process spawn — upstream of run_codex_supervised_turn shell effects. If bisect step 1 OOMs, package_delivery admit_codex_package_lock_text is a shared production defect. If step 2 OOMs, materialize_codex_runtime_bundle is shared. If step 1-2 pass under cap but full chain OOMs without children, codex_app_server_press + codex_supervised_turn eval path is the suspect."

data wet_supervised_turn_probe_key: ProviderProbeKey = "wet-supervised-turn-1" as ProviderProbeKey

fn committed_codex_lock_text() -> String {
  filesystem_read(path: codex_runtime_lock_path as String).content
}

fn committed_admitted_codex_runtime_source() -> AdmittedCodexRuntimeSource {
  AdmittedCodexRuntimeSource {
    manifest_bytes: filesystem_read(path: codex_runtime_manifest_path as String).content,
    lock_bytes: committed_codex_lock_text(),
  }
}

fn wet_codex_home_from_env() -> FilePath? {
  match shell.Env.Get(name: "CODEX_HOME" as NonEmptyStr).value {
    Present { value: home } => {
      if home == "" {
        none
      } else {
        Present { value: home as FilePath }
      }
    }
    Absent => none
  }
}

fn wet_supervised_turn_terminal_ok(
  turn: WorkerTurn,
  terminal: CodexRunnerTurnTerminalReceipt,
) -> Bool {
  (terminal.client_command_id as String) ==
    (codex_supervised_turn_client_command_id(turn: turn) as String)
    && match terminal.binding.lease.observed {
      LeaseAbsent => true
      LeaseRunningExpected => false
      LeaseRunningStale => false
      LeasePortForeign => false
      LeaseInaccessible => false
    }
    && press_display_finished(disposition: terminal.disposition)
}

fn wet_supervised_turn() -> WorkerTurn {
  WorkerTurn {
    turn_key: "wet-turn-1",
    attempt_key: "wet-attempt-1",
    consumed_feedback: "Reply with exactly: wet-supervised-turn-ok",
    resulting_head: none,
  }
}

test fn wet_committed_admitted_source_lock_admits() -> Bool {
  match admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    CodexPackageLockAdmitted { graph: _, nodes, registry_artifacts } =>
      count(nodes) > 0 && count(registry_artifacts) > 0
    _ => false
  }
}

test fn wet_materialize_codex_runtime_bundle_only() -> Bool {
  let release_tmp = shell.Mktemp.Dir()
  if release_tmp.success == false {
    false
  } else {
    match materialize_codex_runtime_bundle(
      source: committed_admitted_codex_runtime_source(),
      release_parent: release_tmp.path,
    ) {
      CodexRuntimeMaterialized { bundle } =>
        shell.Test.IsFile(path: codex_bundle_executable_path(bundle: bundle)).is_file
      _ => false
    }
  }
}

test fn supervised_turn_materialized_bundle_writes_terminal_receipt() -> Bool {
  let release_tmp = shell.Mktemp.Dir()
  let evidence = shell.Mktemp.Dir()
  let cwd = shell.Mktemp.Dir()
  if release_tmp.success == false
    || evidence.success == false
    || cwd.success == false {
    false
  } else {
    match wet_codex_home_from_env() {
      Absent => false
      Present { value: codex_home } => {
        match materialize_codex_runtime_bundle(
          source: committed_admitted_codex_runtime_source(),
          release_parent: release_tmp.path,
        ) {
          CodexRuntimeMaterialized { bundle } => {
            let path = codex_bundle_executable_path(bundle: bundle)
            if shell.Test.IsFile(path: path).is_file == false {
              false
            } else {
              let turn = wet_supervised_turn()
              let credential = observe_codex_account_preflight(
                bundle: bundle,
                probe_key: wet_supervised_turn_probe_key,
                evidence_root: evidence.path,
                codex_home: codex_home,
              )
              match credential {
                CodexPressAccountReady { receipt } => {
                  let binding = codex_supervised_turn_binding(
                    turn: turn,
                    credential: receipt.subject.credential,
                    observed: LeaseAbsent,
                    standing_receipt: Present { value: receipt },
                  )
                  match run_codex_supervised_turn(
                    bundle: bundle,
                    credential: receipt.subject.credential,
                    binding: binding,
                    cwd: cwd.path,
                    evidence_root: evidence.path,
                  ) {
                    CodexSupervisedTurnOk { receipt: terminal } =>
                      wet_supervised_turn_terminal_ok(turn: turn, terminal: terminal)
                    CodexSupervisedTurnRefused { reason: _ } => false
                    CodexSupervisedTurnUnavailable { reason: _, process: _ } => false
                  }
                }
                CodexPressLoginRequired { reason: _, receipt: _ } => false
                CodexPressRefused { reason: _, receipt: _ } => false
                CodexPressUnavailable { reason: _, process: _ } => false
              }
            }
          }
          _ => false
        }
      }
    }
  }
}
