data wet_materialize_bisect_release_parent: std.types.FilePath = "/tmp/gunbc-wet-materialize-bisect-release" as std.types.FilePath

fn wet_materialize_codex_runtime_bundle_only() -> std.types.Bool {
  match gunbc.package_delivery.materialize_codex_runtime_bundle(
    source: committed_admitted_codex_runtime_source(),
    release_parent: wet_materialize_bisect_release_parent,
  ) {
    CodexRuntimeMaterialized { bundle } =>
      shell.Test.IsFile(path: gunbc.codex_runtime_bundle.codex_bundle_executable_path(bundle: bundle)).is_file
    _ => false
  }
}

fn supervised_turn_materialized_bundle_writes_terminal_receipt() -> std.types.Bool {
  let release_tmp = shell.Mktemp.Dir()
  let evidence = shell.Mktemp.Dir()
  let cwd = shell.Mktemp.Dir()
  if release_tmp.success == false
    || evidence.success == false
    || cwd.success == false {
    false
  } else {
    match wet_codex_home_from_env() {
      Absent => false
      Present { value: codex_home } => {
        match gunbc.package_delivery.materialize_codex_runtime_bundle(
          source: committed_admitted_codex_runtime_source(),
          release_parent: release_tmp.path,
        ) {
          CodexRuntimeMaterialized { bundle } => {
            let path = gunbc.codex_runtime_bundle.codex_bundle_executable_path(bundle: bundle)
            if shell.Test.IsFile(path: path).is_file == false {
              false
            } else {
              let turn = wet_supervised_turn()
              let credential = gunbc.codex_app_server_press.observe_codex_account_preflight(
                bundle: bundle,
                probe_key: wet_supervised_turn_probe_key,
                evidence_root: evidence.path,
                codex_home: codex_home,
              )
              match credential {
                CodexPressAccountReady { receipt } => {
                  match gunbc.codex_supervised_turn.prepare_codex_supervised_turn_binding(
                    turn: turn,
                    credential: receipt.subject.credential,
                    evidence_root: evidence.path,
                    observed: std.temporal_effect.LeaseAbsent,
                    standing_receipt: none,
                  ) {
                    CodexSupervisedTurnBindingPrepared { binding: binding } =>
                      match gunbc.codex_supervised_turn_run.run_codex_supervised_turn(
                        bundle: bundle,
                        credential: receipt.subject.credential,
                        binding: binding,
                        cwd: cwd.path,
                        evidence_root: evidence.path,
                      ) {
                        CodexSupervisedTurnOk { receipt: terminal } =>
                          wet_supervised_turn_terminal_ok(turn: turn, terminal: terminal)
                        CodexSupervisedTurnRefused { reason: _ } => false
                        CodexSupervisedTurnUnavailable { reason: _, process: _ } => false
                      }
                    CodexSupervisedTurnBindingPrepareRefused { reason: _ } => false
                  }
                }
                CodexPressLoginRequired { reason: _, receipt: _ } => false
                CodexPressRefused { reason: _, receipt: _ } => false
                CodexPressUnavailable { reason: _, process: _ } => false
              }
            }
          }
          _ => false
        }
      }
    }
  }
}
