module test.claim.fleet_known_hosts_anchor_witness_test


// The constructor is partial, so a fixture must decide what an unsafe id means. Refusing to a
// distinguishable sentinel rather than a plausible-looking default keeps a construction failure from
// silently becoming a passing comparison between two identical fallbacks.
fn attempt(raw: String) -> gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity {
  match fleet_ssh_attempt_identity(raw: raw) {
    Present { value: a } => a
    Absent => "REFUSED-UNSAFE-ATTEMPT-ID" as gunbc.fleet_known_hosts_anchor.FleetSshAttemptIdentity
  }
}

fn row(host: String, endpoint: String, key: String) -> gunbc.fleet_host_key_enrollment.KnownHostKeyRow {
  gunbc.fleet_host_key_enrollment.KnownHostKeyRow {
    host: host as product.placement_supply.HostIdentity,
    endpoint: endpoint,
    key_type: "ssh-ed25519",
    public_key_base64: key,
    sha256_fingerprint: concat("SHA256:", key),
    provenance: gunbc.fleet_host_key_enrollment.ScannedFirstContact { scanned_from: "synthetic fixture" as std.types.NonEmptyStr },
  }
}

// The SAME registry authored in two orders. These are one set of trusted keys, so they must be one
// registry -- and before canonicalization they were two, because the identity was a function of the
// list's traversal rather than of the enrollments it denotes.
fn forward_rows() -> List<gunbc.fleet_host_key_enrollment.KnownHostKeyRow> {
  [row(host: "a", endpoint: "alpha", key: "AAAA"), row(host: "b", endpoint: "bravo", key: "BBBB"), row(host: "c", endpoint: "charlie", key: "CCCC")]
}

fn reversed_rows() -> List<gunbc.fleet_host_key_enrollment.KnownHostKeyRow> {
  [row(host: "c", endpoint: "charlie", key: "CCCC"), row(host: "b", endpoint: "bravo", key: "BBBB"), row(host: "a", endpoint: "alpha", key: "AAAA")]
}

fn identities_agree(left: List<gunbc.fleet_host_key_enrollment.KnownHostKeyRow>, right: List<gunbc.fleet_host_key_enrollment.KnownHostKeyRow>) -> Bool {
  match compare_content_hash(
    left: canonical_known_hosts_identity(rows: left),
    right: canonical_known_hosts_identity(rows: right),
  ) {
    ContentHashEqual => true
    ContentHashDifferent => false
    ContentHashCrossFamilyIncomparable => false
  }
}

// THE REVERSAL CONTROL. Reordering the enrollments must change neither the anchor's identity nor the
// bytes ssh reads. Asserting BOTH matters: canonicalizing only the hash would give one identity to
// two different files, which is strictly worse than the defect it replaced -- the digest would then
// certify bytes it did not describe, and the anchor's whole claim is that its identity IS its
// content.
test fn w_reordered_registry_is_the_same_registry() -> Bool {
  identities_agree(left: forward_rows(), right: reversed_rows()) && canonical_known_hosts_fragment(rows: forward_rows()) == canonical_known_hosts_fragment(rows: reversed_rows())
}

// POSITIVE CONTROL, without which the reversal claim is satisfiable by a constant. A registry that
// differs in CONTENT rather than order must still receive a different identity.
test fn w_a_different_registry_is_a_different_registry() -> Bool {
  !identities_agree(
    left: forward_rows(),
    right: [row(host: "a", endpoint: "alpha", key: "DDDD"), row(host: "b", endpoint: "bravo", key: "BBBB"), row(host: "c", endpoint: "charlie", key: "CCCC")],
  )
}

// A duplicate endpoint is a CONFLICT, not a redundancy: known_hosts accepts a key matching any line
// for that endpoint, so two rows naming one endpoint widen what is trusted while the registry reads
// as if it pinned one key. Refusing is the only honest arm -- hashing it would mint an anchor
// certifying a widened trust set.
test fn w_duplicate_endpoint_refuses() -> Bool {
  match known_hosts_endpoint_conflict(rows: [
    row(host: "a", endpoint: "alpha", key: "AAAA"),
    row(host: "impostor", endpoint: "alpha", key: "EVIL"),
  ]) {
    Present { value: _ } => true
    Absent => false
  }
}

// The refusal must not fire on a registry that is merely varied -- otherwise the arm above would
// pass by refusing everything, and the live six-row registry could never materialize.
test fn red_control_distinct_endpoints_do_not_conflict() -> Bool {
  match known_hosts_endpoint_conflict(rows: forward_rows()) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE ATTEMPT OWNS THE PATH. An earlier revision derived the anchor path from the registry digest
// alone and argued in-source that identical content made a shared path safe. That argument was
// wrong: identical content does not establish immutability -- a later writer can modify the path
// after another attempt has sealed its anchor, so the sealed value proves what was read at
// construction rather than what ssh reads when the leg runs. Two attempts holding the SAME registry
// must therefore still receive different paths, which is exactly what this asserts and what the old
// derivation could not satisfy.
test fn w_two_attempts_do_not_share_one_anchor_path() -> Bool {
  fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a")) != fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-b"))
}

// POSITIVE CONTROL: the digest half still does its work. One attempt asking twice must land on one
// path -- otherwise the claim above is satisfiable by any per-call unique name, and the filename
// would stop being a claim about content that the readback checks.
test fn w_one_attempt_derives_one_stable_path() -> Bool {
  fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a")) == fleet_known_hosts_anchor_path(attempt: attempt(raw: "attempt-a"))
}

// THE OWNERSHIP BOUNDARY IS THE POINT OF THE SEGMENT, so an id that would escape it must refuse
// rather than be sanitized. A traversal component or a separator would put one attempt's anchor
// outside its own directory -- which is exactly the shared-mutable-path failure the attempt scoping
// exists to close, reintroduced through the identity instead of the path.
test fn w_unsafe_attempt_identity_refuses() -> Bool {
  match fleet_ssh_attempt_identity(raw: "../escape") {
    Absent => true
    Present { value: _ } => false
  }
}

// Positive control: the refusal is discriminating, not total. Without it the claim above passes by
// refusing every id and no anchor could ever be materialized.
test fn w_ordinary_attempt_identity_is_admitted() -> Bool {
  match fleet_ssh_attempt_identity(raw: "run-31469703605-attempt-1") {
    Present { value: _ } => true
    Absent => false
  }
}
