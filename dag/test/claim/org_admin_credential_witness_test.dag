module test.claim.org_admin_credential_witness_test

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.org_admin_auth {
  OrgAdminCredentialShape,
  FineGrainedPersonalAccessToken,
  GitHubAppInstallationAccessToken,
  FineGrainedOrganizationSelfHostedRunnersWrite,
  FineGrainedOrganizationAdministrationWrite,
  HumanWebAcquired,
  ProgrammaticallyMintedFromGitHubAppKey,
  ConfigurablePersonalTokenLifetime,
  OneHourInstallationToken,
  PersonalTokenSettingsOrOrganizationPolicy,
  GitHubAppInstallationOrPrivateKey
}
import gunbc.auth.org_admin_credential {
  SecretMaterial,
  SecretMaterialIdentity,
  LocalOperatorCredentialStore,
  OperatorReadOnlyValidationLane,
  FleetOrgActionsApplyLane,
  RotateBeforeExpiry,
  SecretProtectionContract,
  RevokeUpstreamThenDeleteStoredVersion,
  RotateAndRevalidate,
  CredentialCurrent,
  CredentialMissing,
  OrgAdminCredentialValidationReceipt,
  ListOrganizationRunnerGroups,
  OrgAdminCredentialAdmitted,
  OrgAdminCredentialRefused,
  OrgAdminCredentialMissing,
  OrgAdminCredentialStandingNotCurrent,
  admit_org_admin_credential
}

fn interim_shape() -> OrgAdminCredentialShape {
  OrgAdminCredentialShape {
    kind: FineGrainedPersonalAccessToken,
    grants: [
      FineGrainedOrganizationSelfHostedRunnersWrite,
      FineGrainedOrganizationAdministrationWrite
    ],
    acquisition: HumanWebAcquired,
    lifetime: ConfigurablePersonalTokenLifetime { expires_at: Present { value: "2026-09-30T00:00:00Z" } },
    revocation: PersonalTokenSettingsOrOrganizationPolicy
  }
}

fn admitted_material() -> SecretMaterial {
  let identity = SecretMaterialIdentity { name: "github-org-admin" }
  SecretMaterial {
    identity: identity,
    credential: interim_shape(),
    store: LocalOperatorCredentialStore { profile: "gunbc-org-admin" },
    readers: [OperatorReadOnlyValidationLane, FleetOrgActionsApplyLane],
    rotation: RotateBeforeExpiry { latest_rotation_at: "2026-09-29T00:00:00Z" },
    protection: SecretProtectionContract {
      deletion: RevokeUpstreamThenDeleteStoredVersion,
      loss_remedy: RotateAndRevalidate,
      restore_test_cadence: "at every rotation"
    },
    standing: CredentialCurrent {
      evidence_digest: "sha256:fixture",
      exact_producer: DeclarationRef {
        module_path: "test.claim.org_admin_credential_witness_test",
        decl_name: "validated_fresh_credential_admits_holds",
        field: WholeDeclaration
      },
      valid_until: "2026-09-30T00:00:00Z"
    },
    validation: Present { value: OrgAdminCredentialValidationReceipt {
      material: identity,
      credential_kind: FineGrainedPersonalAccessToken,
      endpoint: ListOrganizationRunnerGroups,
      organization: "gunb-ai",
      validated_at: "2026-08-30T00:00:00Z"
    } }
  }
}

fn absent_refuses_holds() -> Bool {
  match admit_org_admin_credential(material: none, reader: FleetOrgActionsApplyLane) {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialMissing { identity: _ } } => true
    _ => false
  }
}

fn unobserved_expiry_refuses_holds() -> Bool {
  let held = admitted_material()
  let unobserved = SecretMaterial {
    identity: held.identity,
    credential: held.credential,
    store: held.store,
    readers: held.readers,
    rotation: held.rotation,
    protection: held.protection,
    standing: CredentialMissing,
    validation: held.validation
  }
  match admit_org_admin_credential(material: Present { value: unobserved }, reader: FleetOrgActionsApplyLane) {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialStandingNotCurrent } => true
    _ => false
  }
}

fn validated_fresh_credential_admits_holds() -> Bool {
  match admit_org_admin_credential(material: Present { value: admitted_material() }, reader: FleetOrgActionsApplyLane) {
    OrgAdminCredentialAdmitted { material: _ } => true
    _ => false
  }
}

fn terminal_shape_is_programmatically_renewable_holds() -> Bool {
  let terminal = OrgAdminCredentialShape {
    kind: GitHubAppInstallationAccessToken,
    grants: [FineGrainedOrganizationSelfHostedRunnersWrite, FineGrainedOrganizationAdministrationWrite],
    acquisition: ProgrammaticallyMintedFromGitHubAppKey,
    lifetime: OneHourInstallationToken { expires_at: "2026-08-30T01:00:00Z" },
    revocation: GitHubAppInstallationOrPrivateKey
  }
  terminal.kind == GitHubAppInstallationAccessToken
}
