module test.claim.org_admin_credential_witness_test

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.org_admin_auth {
  OrgAdminCredentialShape,
  FineGrainedPersonalAccessToken,
  GitHubAppInstallationAccessToken,
  FineGrainedOrganizationSelfHostedRunnersWrite,
  FineGrainedOrganizationAdministrationWrite,
  HumanWebAcquired,
  ProgrammaticallyMintedFromGitHubAppKey,
  ConfigurablePersonalTokenLifetime,
  OneHourInstallationToken,
  PersonalTokenSettingsOrOrganizationPolicy,
  GitHubAppInstallationOrPrivateKey
}
import gunbc.auth.org_admin_credential {
  SecretMaterial,
  SecretMaterialIdentity,
  LocalOperatorCredentialStore,
  OperatorReadOnlyValidationLane,
  FleetOrgActionsObserveLane,
  FleetOrgActionsApplyLane,
  RotateBeforeExpiry,
  SecretProtectionContract,
  RevokeUpstreamThenDeleteStoredVersion,
  RotateAndRevalidate,
  RestoreTestAtEveryRotation,
  CredentialCurrent,
  CredentialMissing,
  HumanBootstrapReceipt,
  HumanCredentialBootstrap,
  GitHubOrganizationOwner,
  GitHubTokenSettingsWebPage,
  GitHubPasswordSecondFactorAndOrganizationRole,
  RuntimeCredentialRoot,
  RuntimeCredentialDerived,
  CredentialAcquiredFrom,
  MintGitHubAppInstallationToken,
  CredentialStale,
  CredentialRevoked,
  CredentialChainStale,
  acquisition_genealogy_is_well_founded,
  runtime_dependency_standing,
  OrgAdminCredentialValidationReceipt,
  list_organization_runner_groups_probe,
  OrgAdminCredentialAdmitted,
  OrgAdminCredentialRefused,
  OrgAdminCredentialMissing,
  OrgAdminCredentialStandingNotCurrent,
  admit_org_admin_credential
}
import gunbc.fleet.org_actions_standing {
  ObservedGroupAccess,
  SettingsRead
}
import gunbc.fleet.org_actions_converge {
  OrgActionsConverged,
  OrgActionsConvergeRefused,
  OrgActionsCredentialRefused,
  OrgActionsDiverged,
  decode_runner_groups_json,
  RunnerGroupListDecoded,
  RunnerGroupListDecodeRefused,
  org_actions_converge_phase
}

fn interim_shape() -> OrgAdminCredentialShape {
  OrgAdminCredentialShape {
    kind: FineGrainedPersonalAccessToken,
    grants: [
      FineGrainedOrganizationSelfHostedRunnersWrite,
      FineGrainedOrganizationAdministrationWrite
    ],
    acquisition: HumanWebAcquired,
    lifetime: ConfigurablePersonalTokenLifetime { expires_at: Present { value: "2026-09-30T00:00:00Z" } },
    revocation: PersonalTokenSettingsOrOrganizationPolicy
  }
}

fn admitted_material() -> SecretMaterial {
  let identity = SecretMaterialIdentity { name: "github-org-admin" }
  SecretMaterial {
    identity: identity,
    credential: interim_shape(),
    acquisition_genealogy: HumanCredentialBootstrap { receipt: HumanBootstrapReceipt {
      actor_role: GitHubOrganizationOwner,
      surface: GitHubTokenSettingsWebPage,
      proof: GitHubPasswordSecondFactorAndOrganizationRole,
      completed_at: "2026-08-30T00:00:00Z",
      stale_after: "2026-09-30T00:00:00Z"
    } },
    runtime_dependency: RuntimeCredentialRoot {
      material: identity,
      standing: CredentialCurrent {
        evidence_digest: "sha256:fixture",
        exact_producer: DeclarationRef {
          module_path: "test.claim.org_admin_credential_witness_test",
          decl_name: "validated_fresh_credential_admits_holds",
          field: WholeDeclaration
        },
        valid_until: "2026-09-30T00:00:00Z"
      }
    },
    store: LocalOperatorCredentialStore { profile: "gunbc-org-admin" },
    readers: [OperatorReadOnlyValidationLane, FleetOrgActionsObserveLane, FleetOrgActionsApplyLane],
    rotation: RotateBeforeExpiry { latest_rotation_at: "2026-09-29T00:00:00Z" },
    protection: SecretProtectionContract {
      deletion: RevokeUpstreamThenDeleteStoredVersion,
      loss_remedy: RotateAndRevalidate,
      restore_test_cadence: RestoreTestAtEveryRotation
    },
    validation: Present { value: OrgAdminCredentialValidationReceipt {
      material: identity,
      credential_kind: FineGrainedPersonalAccessToken,
      endpoint: list_organization_runner_groups_probe,
      organization: "gunb-ai",
      validated_at: "2026-08-30T00:00:00Z"
    } }
  }
}

test fn absent_refuses_holds() -> Bool {
  match admit_org_admin_credential(material: none, reader: FleetOrgActionsApplyLane) {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialMissing { identity: _ } } => true
    _ => false
  }
}

test fn unobserved_expiry_refuses_holds() -> Bool {
  let held = admitted_material()
  let unobserved = SecretMaterial {
    identity: held.identity,
    credential: held.credential,
    acquisition_genealogy: held.acquisition_genealogy,
    runtime_dependency: RuntimeCredentialRoot { material: held.identity, standing: CredentialMissing },
    store: held.store,
    readers: held.readers,
    rotation: held.rotation,
    protection: held.protection,
    validation: held.validation
  }
  match admit_org_admin_credential(material: Present { value: unobserved }, reader: FleetOrgActionsApplyLane) {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialStandingNotCurrent } => true
    _ => false
  }
}

test fn validated_fresh_credential_admits_holds() -> Bool {
  match admit_org_admin_credential(material: Present { value: admitted_material() }, reader: FleetOrgActionsApplyLane) {
    OrgAdminCredentialAdmitted { material: _ } => true
    _ => false
  }
}

test fn terminal_shape_is_programmatically_renewable_holds() -> Bool {
  let terminal = OrgAdminCredentialShape {
    kind: GitHubAppInstallationAccessToken,
    grants: [FineGrainedOrganizationSelfHostedRunnersWrite, FineGrainedOrganizationAdministrationWrite],
    acquisition: ProgrammaticallyMintedFromGitHubAppKey,
    lifetime: OneHourInstallationToken { expires_at: "2026-08-30T01:00:00Z" },
    revocation: GitHubAppInstallationOrPrivateKey
  }
  match terminal.acquisition {
    ProgrammaticallyMintedFromGitHubAppKey => match terminal.lifetime {
      OneHourInstallationToken { expires_at: _ } => true
      _ => false
    }
    _ => false
  }
}

test fn runner_group_decoder_rejects_missing_public_flag_holds() -> Bool {
  match decode_runner_groups_json(body: "{\"runner_groups\":[{\"id\":1,\"name\":\"fleet\"}]}") {
    RunnerGroupListDecodeRefused { reason: _ } => true
    RunnerGroupListDecoded { groups: _ } => false
  }
}

test fn org_actions_phase_absent_credential_refuses_before_observation_holds() -> Bool {
  match org_actions_converge_phase(material: none, observation: none) {
    OrgActionsConvergeRefused { cause: OrgActionsCredentialRefused { cause: _ } } => true
    _ => false
  }
}

test fn org_actions_phase_current_matching_observation_converges_holds() -> Bool {
  let observed = SettingsRead {
    groups: [ObservedGroupAccess {
      group_name: "fleet",
      allows_public_repositories: false,
      repositories: ["gunb-ai/gunbc", "gunb-ai/gunbc-private"]
    }],
    observed_on: "2026-08-30T00:00:00Z"
  }
  match org_actions_converge_phase(
    material: Present { value: admitted_material() },
    observation: Present { value: observed }
  ) {
    OrgActionsConverged { observed_on: _ } => true
    _ => false
  }
}

test fn org_actions_phase_divergence_refuses_holds() -> Bool {
  let observed = SettingsRead {
    groups: [ObservedGroupAccess {
      group_name: "fleet",
      allows_public_repositories: true,
      repositories: ["gunb-ai/gunbc"]
    }],
    observed_on: "2026-08-30T00:00:00Z"
  }
  match org_actions_converge_phase(
    material: Present { value: admitted_material() },
    observation: Present { value: observed }
  ) {
    OrgActionsConvergeRefused { cause: OrgActionsDiverged { access_count, public_exposure_count } } =>
      access_count == 1 && public_exposure_count == 1
    _ => false
  }
}

test fn installation_token_genealogy_terminates_in_one_human_bootstrap_holds() -> Bool {
  let genealogy = CredentialAcquiredFrom {
    parent: HumanCredentialBootstrap { receipt: HumanBootstrapReceipt {
      actor_role: GitHubOrganizationOwner,
      surface: GitHubTokenSettingsWebPage,
      proof: GitHubPasswordSecondFactorAndOrganizationRole,
      completed_at: "2026-08-30T00:00:00Z",
      stale_after: "2026-09-30T00:00:00Z"
    } },
    derivation: MintGitHubAppInstallationToken,
    programmatically_renewable: true
  }
  acquisition_genealogy_is_well_founded(genealogy: genealogy)
}

test fn revoked_runtime_parent_invalidates_installation_token_holds() -> Bool {
  let parent = RuntimeCredentialRoot {
    material: SecretMaterialIdentity { name: "github-app-private-key" },
    standing: CredentialStale { invalidating_fact: CredentialRevoked { observed_at: "2026-08-30T00:00:00Z" } }
  }
  let token = RuntimeCredentialDerived {
    material: SecretMaterialIdentity { name: "github-app-installation-token" },
    parent: parent,
    derivation: MintGitHubAppInstallationToken,
    standing: CredentialCurrent {
      evidence_digest: "sha256:token",
      exact_producer: DeclarationRef {
        module_path: "test.claim.org_admin_credential_witness_test",
        decl_name: "revoked_runtime_parent_invalidates_installation_token_holds",
        field: WholeDeclaration
      },
      valid_until: "2026-08-30T01:00:00Z"
    }
  }
  match runtime_dependency_standing(dependency: token) {
    CredentialChainStale { invalidating_fact: Present { value: CredentialRevoked { observed_at: _ } } } => true
    _ => false
  }
}
