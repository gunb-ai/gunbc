module test.claim.org_admin_credential_witness_test

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.org_admin_auth {
  OrgAdminCredentialShape, FineGrainedPersonalAccessToken,
  FineGrainedOrganizationSelfHostedRunnersRead, FineGrainedOrganizationSelfHostedRunnersWrite,
  FineGrainedOrganizationAdministrationWrite, HumanWebAcquired,
  ConfigurablePersonalTokenLifetime, PersonalTokenSettingsOrOrganizationPolicy,
  RunnerGroupsRead, RunnerGroupsWrite, RunnerGroupRepositoriesRead, OrgActionsCapability
}
import gunbc.auth.org_admin_credential {
  SecretMaterial, SecretMaterialIdentity, CredentialArtifact, CredentialArtifactIdentity,
  AcquisitionTransactionIdentity, CredentialGenealogyComplete,
  HumanAuthorizationCeremonyRoot, CeremonyIdentity, ExternalAccountRecoveryBoundary,
  LocalOperatorCredentialStore, FleetOrgActionsObserveLane, FleetOrgActionsApplyLane,
  RotateBeforeExpiry, SecretProtectionContract, RevokeUpstreamThenDeleteStoredVersion,
  RotateAndRevalidate, RestoreTestAtEveryRotation, CredentialAvailableToExactPrincipal,
  NoRenewalCandidate, CredentialContinuityDue, CredentialOperationUsable,
  CredentialOperationProbeRequired, CredentialOperationRevoked,
  CredentialOperationStanding,
  CredentialCapabilityProbeReceipt, list_organization_runner_groups_probe,
  TargetResourceReadOnly, ProviderAuditEventPossible, CredentialLastUsedMayAdvance,
  OrgAdminCredentialAdmitted, OrgAdminCredentialRefused, OrgAdminCredentialMissing,
  OrgAdminCredentialCapabilityProbeRequired, OrgAdminCredentialOperationNotUsable,
  CurrentUseRequires, DependencyIdentity, InvalidatesCurrentUse, HistoricalOnly,
  admit_org_admin_credential
}
import gunbc.fleet.org_actions_standing { ObservedGroupAccess, SettingsRead }
import gunbc.fleet.org_actions_converge {
  OrgActionsConverged, OrgActionsConvergeRefused, OrgActionsCredentialRefused,
  OrgActionsDiverged, decode_runner_groups_json, RunnerGroupListDecodeRefused,
  org_actions_converge_phase
}

fn interim_shape() -> OrgAdminCredentialShape {
  OrgAdminCredentialShape {
    kind: FineGrainedPersonalAccessToken,
    grants: [FineGrainedOrganizationSelfHostedRunnersWrite, FineGrainedOrganizationAdministrationWrite],
    acquisition: HumanWebAcquired,
    lifetime: ConfigurablePersonalTokenLifetime { expires_at: Present { value: "2026-09-30T00:00:00Z" } },
    revocation: PersonalTokenSettingsOrOrganizationPolicy
  }
}

fn probe_receipt(exact_operation: OrgActionsCapability) -> CredentialCapabilityProbeReceipt {
  CredentialCapabilityProbeReceipt {
    material: SecretMaterialIdentity { name: "github-org-admin" },
    credential_kind: FineGrainedPersonalAccessToken,
    exact_capability: exact_operation,
    endpoint: list_organization_runner_groups_probe,
    organization: "gunb-ai",
    observed_at: "2026-08-30T00:00:00Z",
    producer: DeclarationRef { module_path: "gunbc.fleet.org_actions_converge", decl_name: "observe_github_runner_groups", field: WholeDeclaration },
    effects: [TargetResourceReadOnly, ProviderAuditEventPossible, CredentialLastUsedMayAdvance]
  }
}

fn usable(exact_operation: OrgActionsCapability) -> CredentialOperationStanding {
  CredentialOperationUsable { capability: exact_operation, target: "gunb-ai", valid_through: "2026-09-30T00:00:00Z", probe_receipt: probe_receipt(exact_operation: exact_operation) }
}

fn admitted_material() -> SecretMaterial {
  let artifact = CredentialArtifact {
    identity: CredentialArtifactIdentity { name: "interim-pat" }, credential: interim_shape(),
    issuer_identity: "github", subject_identity: "operator", target_identity: "gunb-ai",
    acquisition_transaction: AcquisitionTransactionIdentity { name: "human-pat-create" }
  }
  SecretMaterial {
    identity: SecretMaterialIdentity { name: "github-org-admin" }, artifact: artifact,
    genealogy: CredentialGenealogyComplete {
      acquisition_roots: [
        HumanAuthorizationCeremonyRoot { ceremony: CeremonyIdentity { name: "pat-create" } },
        ExternalAccountRecoveryBoundary { provider_account: "github:operator" }
      ],
      transaction_set_digest: "fnv1a64:fixture"
    },
    current_use_requirements: [CurrentUseRequires {
      credential: artifact.identity, dependency: DependencyIdentity { name: "github-accepts-token" },
      exact_capability: RunnerGroupsRead, invalidation_effect: InvalidatesCurrentUse
    }],
    renewal_requirements: [], renewal_candidate: NoRenewalCandidate,
    continuity: CredentialContinuityDue { latest_safe_start: "2026-09-20T00:00:00Z" },
    store: LocalOperatorCredentialStore { profile: "gunbc-org-admin" },
    readers: [FleetOrgActionsObserveLane, FleetOrgActionsApplyLane],
    custody: CredentialAvailableToExactPrincipal { principal: FleetOrgActionsObserveLane },
    rotation: RotateBeforeExpiry { latest_rotation_at: "2026-09-29T00:00:00Z" },
    protection: SecretProtectionContract { deletion: RevokeUpstreamThenDeleteStoredVersion, loss_remedy: RotateAndRevalidate, restore_test_cadence: RestoreTestAtEveryRotation },
    operation_standings: [usable(exact_operation: RunnerGroupsRead), usable(exact_operation: RunnerGroupRepositoriesRead)]
  }
}

test fn absent_refuses_holds() -> Bool {
  match admit_org_admin_credential(material: none, reader: FleetOrgActionsObserveLane, required_capabilities: [RunnerGroupsRead], observed_at: "2026-08-30T00:00:00Z") {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialMissing { identity: _ } } => true
    _ => false
  }
}

test fn exact_read_capability_admits_holds() -> Bool {
  match admit_org_admin_credential(material: Present { value: admitted_material() }, reader: FleetOrgActionsObserveLane, required_capabilities: [RunnerGroupsRead, RunnerGroupRepositoriesRead], observed_at: "2026-08-30T00:00:00Z") {
    OrgAdminCredentialAdmitted { material: _ } => true
    _ => false
  }
}

test fn read_capability_does_not_authorize_write_holds() -> Bool {
  match admit_org_admin_credential(material: Present { value: admitted_material() }, reader: FleetOrgActionsObserveLane, required_capabilities: [RunnerGroupsWrite], observed_at: "2026-08-30T00:00:00Z") {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: RunnerGroupsWrite, standing: _ } } => true
    _ => false
  }
}

test fn stale_probe_requests_refresh_holds() -> Bool {
  let held = admitted_material()
  let due = SecretMaterial {
    identity: held.identity, artifact: held.artifact, genealogy: held.genealogy,
    current_use_requirements: held.current_use_requirements, renewal_requirements: held.renewal_requirements,
    renewal_candidate: held.renewal_candidate, continuity: held.continuity, store: held.store,
    readers: held.readers, custody: held.custody, rotation: held.rotation, protection: held.protection,
    operation_standings: [CredentialOperationProbeRequired { capability: RunnerGroupsRead }]
  }
  match admit_org_admin_credential(material: Present { value: due }, reader: FleetOrgActionsObserveLane, required_capabilities: [RunnerGroupsRead], observed_at: "2026-08-30T00:00:00Z") {
    OrgAdminCredentialRefused { cause: OrgAdminCredentialCapabilityProbeRequired { capability: RunnerGroupsRead } } => true
    _ => false
  }
}

test fn revoked_operation_standing_refuses_holds() -> Bool {
  let held = admitted_material()
  let revoked = SecretMaterial {
    identity: held.identity, artifact: held.artifact, genealogy: held.genealogy,
    current_use_requirements: held.current_use_requirements, renewal_requirements: held.renewal_requirements,
    renewal_candidate: held.renewal_candidate, continuity: held.continuity, store: held.store,
    readers: held.readers, custody: held.custody, rotation: held.rotation, protection: held.protection,
    operation_standings: [CredentialOperationRevoked]
  }
  match admit_org_admin_credential(material: Present { value: revoked }, reader: FleetOrgActionsObserveLane, required_capabilities: [RunnerGroupsRead], observed_at: "2026-08-30T00:00:00Z") {
    OrgAdminCredentialRefused { cause: _ } => true
    _ => false
  }
}

test fn historical_edge_has_no_current_use_effect_holds() -> Bool { HistoricalOnly != InvalidatesCurrentUse }

test fn decoder_refuses_incomplete_observation_holds() -> Bool {
  match decode_runner_groups_json(body: "{\"runner_groups\":[{\"id\":1,\"name\":\"fleet\"}]}") { RunnerGroupListDecodeRefused { reason: _ } => true _ => false }
}

test fn phase_missing_credential_is_not_divergence_holds() -> Bool {
  match org_actions_converge_phase(material: none, observation: none, observed_at: "2026-08-30T00:00:00Z") {
    OrgActionsConvergeRefused { cause: OrgActionsCredentialRefused { cause: _ } } => true
    _ => false
  }
}

test fn phase_matching_read_converges_holds() -> Bool {
  let observed = SettingsRead { groups: [ObservedGroupAccess { group_name: "fleet", allows_public_repositories: false, repositories: ["gunb-ai/gunbc", "gunb-ai/gunbc-private"] }], observed_on: "2026-08-30T00:00:00Z" }
  match org_actions_converge_phase(material: Present { value: admitted_material() }, observation: Present { value: observed }, observed_at: "2026-08-30T00:00:00Z") { OrgActionsConverged { observed_on: _ } => true _ => false }
}

test fn phase_divergence_remains_distinct_holds() -> Bool {
  let observed = SettingsRead { groups: [ObservedGroupAccess { group_name: "fleet", allows_public_repositories: true, repositories: ["gunb-ai/gunbc"] }], observed_on: "2026-08-30T00:00:00Z" }
  match org_actions_converge_phase(material: Present { value: admitted_material() }, observation: Present { value: observed }, observed_at: "2026-08-30T00:00:00Z") {
    OrgActionsConvergeRefused { cause: OrgActionsDiverged { access_count, public_exposure_count } } => access_count == 1 && public_exposure_count == 1
    _ => false
  }
}
