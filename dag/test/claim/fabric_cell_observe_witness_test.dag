// ROUTED, BECAUSE AN UNROUTED WITNESS IS DISCOVERED AND NEVER RUN. A module that does not declare
// its live-tree disposition defaults to ReadsLiveTree and the floor declines it -- counted, never
// executed. Every row in this file reads only values the fixture authors, so the honest
// declaration is also the one that makes the rows gate anything.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THESE ROWS ARE LAWS OVER THE OBSERVER, AUTHORED BEFORE THE HOST TRANSPORT EXISTS, and that order
// is the point rather than an accident of scheduling. Every defect this family has shipped was
// found by a law and missed by a scenario: the drift-versus-absence collapse, the silently excluded
// unexpected readback, and the unordered supplied side were all states no hand-authored fixture
// thought to write down. So the adversarial inputs come first here and the transport is bound to
// the shape they pin, rather than the shape being read back off whatever the first probe returned.

fn observe_slot() -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv3, slot_index: 6 }
}

fn observe_root_entries() -> List<String> {
  [runner_slot_instance_name(slot: observe_slot())]
}

fn enumerated(ns: FabricCellNamespace, entries: List<String>) -> FabricCellNamespaceProbeEntry {
  FabricCellNamespaceProbeEntry { namespace: ns, probe: NamespaceEnumerated { entries: entries } }
}

fn enumeration_refused(ns: FabricCellNamespace, cause: String) -> FabricCellNamespaceProbeEntry {
  FabricCellNamespaceProbeEntry { namespace: ns, probe: NamespaceEnumerationRefused { cause: cause } }
}

fn state_read(address: FabricCellResourceAddress, digest: NonEmptyStr) -> FabricCellAddressProbeEntry {
  FabricCellAddressProbeEntry { slot: observe_slot(), address: address, probe: AddressStateRead { state_digest: digest } }
}

fn desired_digest_at(address: FabricCellResourceAddress) -> NonEmptyStr {
  fabric_cell_desired_state_digest(slot: observe_slot(), address: address)
}

// A FULLY PROVISIONED HOST AS THE OBSERVER WOULD SEE IT: all three namespaces enumerated, every
// entry present, every state read agreeing with the desired digest.
fn converged_probe() -> FabricCellHostProbe {
  FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: [
      enumerated(ns: FabricCellsRootNamespace, entries: observe_root_entries()),
      enumerated(ns: FabricCellChildNamespace { slot: observe_slot() }, entries: ["attempts"]),
      enumerated(ns: FabricCellSliceNamespace, entries: [fabric_cell_slice_name(slot: observe_slot())]),
    ],
    addresses: map(
      fabric_cell_resource_addresses(),
      a => state_read(address: a, digest: desired_digest_at(address: a))
    ),
  }
}

fn observation_is_absent(o: FabricCellAddressObservation) -> Bool {
  match o {
    AddressAbsent { slot: _, address: _ } => true
    AddressObserved { member: _ } => false
    AddressObservationRefused { slot: _, address: _, cause: _ } => false
  }
}

fn observation_is_refused(o: FabricCellAddressObservation) -> Bool {
  match o {
    AddressObservationRefused { slot: _, address: _, cause: _ } => true
    AddressAbsent { slot: _, address: _ } => false
    AddressObserved { member: _ } => false
  }
}

fn observation_is_observed(o: FabricCellAddressObservation) -> Bool {
  match o {
    AddressObserved { member: _ } => true
    AddressAbsent { slot: _, address: _ } => false
    AddressObservationRefused { slot: _, address: _, cause: _ } => false
  }
}

fn count_absent(os: List<FabricCellAddressObservation>) -> Int {
  fold(os, init: 0, f: (acc, o) => if observation_is_absent(o: o) { acc + 1 } else { acc })
}

fn count_refused(os: List<FabricCellAddressObservation>) -> Int {
  fold(os, init: 0, f: (acc, o) => if observation_is_refused(o: o) { acc + 1 } else { acc })
}

fn count_observed(os: List<FabricCellAddressObservation>) -> Int {
  fold(os, init: 0, f: (acc, o) => if observation_is_observed(o: o) { acc + 1 } else { acc })
}

// LAW 0 -- A FULLY PROVISIONED PROBE OBSERVES EVERY ADDRESS. The baseline every other row is read
// against: without it, "never reports absence" and "refuses when ignorant" are both satisfied by an
// observer that observes nothing at all.
test fn witness_observer_converged_probe_observes_every_address() -> Bool {
  let r = fabric_cell_observe_slot(probe: converged_probe(), slot: observe_slot())
  count_observed(os: r.observations) == 3
}

fn probe_with_namespaces(ns: List<FabricCellNamespaceProbeEntry>) -> FabricCellHostProbe {
  FabricCellHostProbe { host: operator_host_srv3, namespaces: ns, addresses: converged_probe().addresses }
}

// LAW 1 -- A REFUSED ENUMERATION NEVER PRODUCES AN ABSENCE. This is the empty-observation narrow,
// and it is the failure this family has produced in a new position every time it grew: a probe that
// could not say what is there rendered as the verdict "nothing is there". A mutation restoring the
// tempting arm -- treat a refused listing as an empty listing -- reds this row and only this row,
// because every other law here supplies a successful enumeration.
test fn witness_observer_refused_enumeration_never_reports_absence() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: probe_with_namespaces(ns: [
      enumeration_refused(ns: FabricCellsRootNamespace, cause: "permission denied"),
      enumerated(ns: FabricCellChildNamespace { slot: observe_slot() }, entries: ["attempts"]),
      enumerated(ns: FabricCellSliceNamespace, entries: [fabric_cell_slice_name(slot: observe_slot())]),
    ]),
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 0
    && count_refused(os: readback.observations) == 1
}

// LAW 2 -- A NAMESPACE NOBODY PROBED IS ALSO NEVER AN ABSENCE. Distinct from law 1 because the
// producer differs: there the observer ran and was refused, here it never ran. Both are ignorance,
// neither is evidence about the host, and an observer that conflated them would report a host it
// never touched as entirely unprovisioned.
test fn witness_observer_unprobed_namespace_never_reports_absence() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: FabricCellHostProbe { host: operator_host_srv3, namespaces: [], addresses: [] },
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 0
    && count_refused(os: readback.observations) == 3
}

// LAW 3 -- ABSENCE IS REPORTED, AND ONLY, AFTER A SUCCESSFUL PARENT OBSERVATION. The positive
// control for laws 1 and 2: without it those two are satisfied by an observer that never reports
// absence at all, which would be a different defect wearing the same green.
//
// THE FIXTURE HERE WAS ONCE AN IMPOSSIBLE FILESYSTEM STATE AND THAT WAS THE TELL. It supplied an
// empty cells-root listing -- so the cell root is absent -- AND a child-namespace enumeration for a
// cell that therefore does not exist. Nothing on a real host produces that pair, and the only
// reason the row needed it was that the carrier had no way to say a child of an absent parent is
// absent. Once absence descends (law 19), the shape below is the realizable one: the cell root IS
// present, and its child namespace is enumerated WITHOUT `attempts`.
test fn witness_observer_successful_enumeration_without_the_entry_is_absence() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: probe_with_namespaces(ns: [
      enumerated(ns: FabricCellsRootNamespace, entries: observe_root_entries()),
      enumerated(ns: FabricCellChildNamespace { slot: observe_slot() }, entries: []),
      enumerated(ns: FabricCellSliceNamespace, entries: [fabric_cell_slice_name(slot: observe_slot())]),
    ]),
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 1
    && count_observed(os: readback.observations) == 2
}

// LAW 4 -- A PRESENT ENTRY WHOSE STATE COULD NOT BE READ IS A REFUSAL, NOT AN ABSENCE AND NOT A
// PRESENCE. The listing established the resource exists; the state read established nothing. An
// observer collapsing this into absence plans a creation over a resource that is already there.
test fn witness_observer_unreadable_present_entry_is_refused_not_absent() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: converged_probe().namespaces,
      addresses: [
        FabricCellAddressProbeEntry {
          slot: observe_slot(),
          address: FabricCellResourceBoundaryAddress,
          probe: AddressStateReadRefused { cause: "cgroup unreadable" },
        },
        state_read(address: FabricCellRootAddress, digest: desired_digest_at(address: FabricCellRootAddress)),
        state_read(address: FabricCellAttemptRootAddress, digest: desired_digest_at(address: FabricCellAttemptRootAddress)),
      ],
    },
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 0
    && count_refused(os: readback.observations) == 1
    && count_observed(os: readback.observations) == 2
}

// LAW 5 -- A PRESENT ENTRY WITH NO STATE PROBE IS A REFUSAL. The third way to be ignorant about a
// present entry, and the one an observer is most likely to leave as a silent gap: the listing ran,
// the name is there, and nobody asked what state it is in.
test fn witness_observer_present_entry_with_no_state_probe_is_refused() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: converged_probe().namespaces,
      addresses: [],
    },
    slot: observe_slot(),
  )
  count_refused(os: readback.observations) == 3
    && count_absent(os: readback.observations) == 0
}

// LAW 6 -- EVERY EXPECTED ADDRESS RECEIVES EXACTLY ONE OBSERVATION, whatever the probe carried.
// Conservation of the expected side: an observer that reports on what it probed rather than on what
// the authority expects can silently shrink its own denominator, and a shrunken denominator reads
// as a converged host.
test fn witness_observer_conserves_every_expected_address() -> Bool {
  let full = fabric_cell_observe_slot(probe: converged_probe(), slot: observe_slot())
  let empty = fabric_cell_observe_slot(
    probe: FabricCellHostProbe { host: operator_host_srv3, namespaces: [], addresses: [] },
    slot: observe_slot(),
  )
  list_length(items: full.observations) == list_length(items: fabric_cell_resource_addresses())
    && list_length(items: empty.observations) == list_length(items: fabric_cell_resource_addresses())
}

// LAW 7 -- TWO ENUMERATIONS THAT DISAGREE REFUSE RATHER THAN LETTING THE FIRST WIN. The same rule
// the address evidence fold already holds, applied one layer up where the observer would otherwise
// reintroduce the order-dependence that fold exists to forbid. Both orders are asserted, so an
// implementation taking either end passes neither.
test fn witness_observer_disagreeing_enumerations_refuse_in_both_orders() -> Bool {
  let forward = fabric_cell_observe_address(
    probe: probe_with_namespaces(ns: [
      enumerated(ns: FabricCellsRootNamespace, entries: observe_root_entries()),
      enumerated(ns: FabricCellsRootNamespace, entries: []),
    ]),
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  let reverse = fabric_cell_observe_address(
    probe: probe_with_namespaces(ns: [
      enumerated(ns: FabricCellsRootNamespace, entries: []),
      enumerated(ns: FabricCellsRootNamespace, entries: observe_root_entries()),
    ]),
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  observation_is_refused(o: forward) && observation_is_refused(o: reverse)
}

// LAW 8 -- TWO STATE READS THAT DISAGREE REFUSE IN BOTH ORDERS, for the same reason and at the
// address grain. A favourable digest arriving first must not decide that the cell is converged.
test fn witness_observer_disagreeing_state_reads_refuse_in_both_orders() -> Bool {
  let a = state_read(address: FabricCellRootAddress, digest: desired_digest_at(address: FabricCellRootAddress))
  let b = state_read(address: FabricCellRootAddress, digest: "some-other-digest" as NonEmptyStr)
  let forward = fabric_cell_observe_address(
    probe: FabricCellHostProbe { host: operator_host_srv3, namespaces: converged_probe().namespaces, addresses: [a, b] },
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  let reverse = fabric_cell_observe_address(
    probe: FabricCellHostProbe { host: operator_host_srv3, namespaces: converged_probe().namespaces, addresses: [b, a] },
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  observation_is_refused(o: forward) && observation_is_refused(o: reverse)
}

// LAW 9 -- AGREEING DUPLICATE READS ARE ONE OBSERVATION, NOT A CONTRADICTION. The positive control
// for law 8: without it, "refuse on two reads" is satisfied by refusing whenever anything is read
// twice, which would make an idempotent probe unusable.
test fn witness_observer_agreeing_duplicate_reads_are_one_observation() -> Bool {
  let a = state_read(address: FabricCellRootAddress, digest: desired_digest_at(address: FabricCellRootAddress))
  let o = fabric_cell_observe_address(
    probe: FabricCellHostProbe { host: operator_host_srv3, namespaces: converged_probe().namespaces, addresses: [a, a] },
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  observation_is_observed(o: o)
}

// LAW 10 -- A DISCOVERED NAME MATCHING NO COMMITTED IDENTITY IS FOREIGN, NEVER A MINTED SLOT AND
// NEVER DROPPED. `srv3-99` is shaped exactly like a slot name and is not one; an observer that
// reverse-parses it produces a RunnerSlotIdentity the slot authority never committed, and one that
// drops it makes an out-of-band artifact unobservable. The row asserts the foreign arm AND the
// count, so dropping fails on the count and minting fails on the arm.
test fn witness_observer_unknown_name_is_foreign_never_a_minted_slot() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-99"])])
  ) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } =>
      list_length(items: ss) == 1
        && fold(ss, init: false, f: (acc, s) => acc || fabric_cell_discovered_subject_wire(s: s) == "foreign:fabric-cells-root:srv3-99")
  }
}

// LAW 11 -- A COMMITTED SLOT THAT IS NOT A FABRIC SLOT IS DISCOVERED AS THAT SLOT, NOT AS FOREIGN.
// A fabric artifact occupying a GitHub-purpose slot is the interesting out-of-band case, and its
// remedy needs the exact identity: reported foreign, an operator is told an unknown thing exists
// where the truth is that a known slot is being used for the wrong purpose.
test fn witness_observer_committed_non_fabric_slot_is_discovered_as_that_slot() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-01"])])
  ) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } =>
      fold(ss, init: false, f: (acc, s) => acc || fabric_cell_discovered_subject_wire(s: s) == "unexpected-committed:srv3-01")
  }
}

// LAW 12 -- THE EXPECTED FABRIC CELL IS DISCOVERED AS EXPECTED. Positive control for laws 10 and
// 11: without it, all three arms are satisfied by an implementation that calls everything foreign.
test fn witness_observer_expected_fabric_cell_is_discovered_as_expected() -> Bool {
  match fabric_cell_discovered_subjects(probe: converged_probe()) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } =>
      fold(ss, init: false, f: (acc, s) => acc || fabric_cell_discovered_subject_wire(s: s) == "expected:srv3-06")
  }
}

// LAW 13 -- A REFUSED ROOT ENUMERATION DISCOVERS NOTHING RATHER THAN DISCOVERING AN EMPTY HOST.
// Law 1 at the discovery seam. "The root listed and held no cells" licenses teardown reasoning;
// "the root could not be listed" licenses none, and an empty subject list would read as the first.
test fn witness_observer_refused_root_enumeration_discovers_nothing_not_an_empty_host() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumeration_refused(ns: FabricCellsRootNamespace, cause: "permission denied")])
  ) {
    DiscoveryEnumerated { host: _, subjects: _ } => false
    DiscoveryRefused { host: _, cause: _ } => true
  }
}

// LAW 14 -- DISCOVERY IS ORDER-INDEPENDENT. The supplied side of the classification kernel had no
// spine until a reversal law found it; this asserts the observer does not hand the kernel a
// different subject set depending on the order the host listed its entries.
test fn witness_observer_discovery_is_order_independent() -> Bool {
  let forward = fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-06", "srv3-99"])])
  )
  let reverse = fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-99", "srv3-06"])])
  )
  discovery_wire_set(d: forward) == discovery_wire_set(d: reverse)
}

// AND ONE ARTIFACT LISTED TWICE IS ONE SUBJECT. The idempotence half of the same obligation: a
// listing that repeats a name (two probes of one namespace merged, a filesystem returning a name
// under two links) must not double the discovered population, or the observer hands the kernel a
// count that moves with probe multiplicity rather than with the host.
test fn witness_observer_duplicate_listed_names_are_one_subject() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-99", "srv3-99"])])
  ) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } => list_length(items: ss) == 1
  }
}

// AND TWO DISTINCT NAMES STAY TWO. The non-degeneracy control: without it, the two rows above are
// satisfied by an observer that collapses every listing to a single subject.
test fn witness_observer_distinct_listed_names_stay_distinct() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-99", "srv3-06"])])
  ) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } => list_length(items: ss) == 2
  }
}

fn discovery_wire_set(d: FabricCellDiscovery) -> String {
  match d {
    DiscoveryRefused { host: _, cause: c } => join(["refused:", c], "")
    DiscoveryEnumerated { host: _, subjects: ss } =>
      fold(
        ss,
        init: "",
        f: (acc, s) => join([acc, "|", fabric_cell_discovered_subject_wire(s: s)], "")
      )
  }
}

// LAW 15 -- THE OBSERVER'S OUTPUT IS WHAT THE CLASSIFICATION KERNEL CONSUMES, AND A CONVERGED HOST
// CLASSIFIES AS SATISFIED THROUGH IT. The end-to-end join: the two halves were built a PR apart and
// this is the row that fails if the observer's vocabulary drifts from the kernel's.
test fn witness_observer_converged_probe_classifies_as_satisfied() -> Bool {
  let readback = fabric_cell_observe_host(probe: converged_probe())
  let classified = classify_fabric_cell_host(
    expected_slots: [observe_slot()],
    readback: readback,
  )
  list_length(items: classified.unexpected) == 0
    && fold(classified.standings, init: true, f: (acc, s) => acc && standing_is_satisfied(s: s))
    && list_length(items: classified.standings) == list_length(items: fabric_cell_resource_addresses())
}

// LAW 16 -- A DRIFTED STATE READ REACHES THE KERNEL AS DRIFT, NOT AS ABSENCE. The defect this
// family shipped to main once already, asserted at the observer boundary this time: the observer
// must hand the kernel the observed digest rather than dropping it, or the kernel's CHANGE arm is
// unreachable no matter how correct the kernel is.
test fn witness_observer_drifted_state_read_reaches_the_kernel_as_drift() -> Bool {
  let drifted = FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: converged_probe().namespaces,
    addresses: [
      state_read(address: FabricCellRootAddress, digest: "drifted-digest" as NonEmptyStr),
      state_read(address: FabricCellAttemptRootAddress, digest: desired_digest_at(address: FabricCellAttemptRootAddress)),
      state_read(address: FabricCellResourceBoundaryAddress, digest: desired_digest_at(address: FabricCellResourceBoundaryAddress)),
    ],
  }
  let classified = classify_fabric_cell_host(
    expected_slots: [observe_slot()],
    readback: fabric_cell_observe_host(probe: drifted),
  )
  count_drift(ss: classified.standings) == 1
    && count_absent_standings(ss: classified.standings) == 0
}

fn count_drift(ss: List<FabricCellAddressStanding>) -> Int {
  fold(ss, init: 0, f: (acc, s) => if standing_is_drift(s: s) { acc + 1 } else { acc })
}

fn count_absent_standings(ss: List<FabricCellAddressStanding>) -> Int {
  fold(ss, init: 0, f: (acc, s) => if standing_is_absent(s: s) { acc + 1 } else { acc })
}

fn standing_is_satisfied(s: FabricCellAddressStanding) -> Bool {
  match s {
    StandingSatisfied { ref: _ } => true
    StandingObservedDrift { ref: _, observed_state_digest: _ } => false
    StandingExplicitlyAbsent { ref: _ } => false
    StandingBlocked { disposition: _ } => false
  }
}

fn standing_is_drift(s: FabricCellAddressStanding) -> Bool {
  match s {
    StandingObservedDrift { ref: _, observed_state_digest: _ } => true
    StandingSatisfied { ref: _ } => false
    StandingExplicitlyAbsent { ref: _ } => false
    StandingBlocked { disposition: _ } => false
  }
}

fn standing_is_absent(s: FabricCellAddressStanding) -> Bool {
  match s {
    StandingExplicitlyAbsent { ref: _ } => true
    StandingSatisfied { ref: _ } => false
    StandingObservedDrift { ref: _, observed_state_digest: _ } => false
    StandingBlocked { disposition: _ } => false
  }
}

// LAW 19 -- THE FIRST REAL OBSERVATION OF AN UNPROVISIONED CELL IS ACTIONABLE ABSENCE, NOT A BLOCK.
// This is the row the observer's original carrier could not make green without an impossible
// fixture. The cells root lists and does not hold srv3-06; `/opt/fabric-cells/srv3-06` therefore
// does not exist and its child namespace cannot be enumerated. With only enumerated-or-refused, the
// attempt root came back REFUSED and the host was blocked -- so the three ADD actions the first
// realization needs were unreachable, on the exact input the whole family exists to serve.
//
// ABSENCE DESCENDS FROM A SUCCESSFUL PARENT OBSERVATION, which is the parent-observation law one
// level up rather than a weakening of it. A REFUSED parent derives nothing (law 20).
test fn witness_observer_unprovisioned_cell_is_absent_not_blocked() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [
        enumerated(ns: FabricCellsRootNamespace, entries: []),
        enumerated(ns: FabricCellSliceNamespace, entries: []),
      ],
      addresses: [],
    },
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 3 && count_refused(os: readback.observations) == 0
}

// LAW 20 -- A REFUSED PARENT DERIVES NO ABSENCE FOR ITS CHILD. The discriminating control for law
// 19: if ancestry were applied without checking that the parent observation SUCCEEDED, a refused
// cells-root listing would silently make every attempt root absent, which is the empty-observation
// narrow rebuilt inside the repair for it.
test fn witness_observer_refused_parent_derives_no_child_absence() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [
        enumeration_refused(ns: FabricCellsRootNamespace, cause: "permission denied"),
        enumerated(ns: FabricCellSliceNamespace, entries: []),
      ],
      addresses: [],
    },
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 1 && count_refused(os: readback.observations) == 2
}

// LAW 21 -- A NAMESPACE OBSERVED ABSENT IS EVIDENCE, AND ITS ADDRESSES ARE ABSENT. The bootstrap
// case: `/opt/fabric-cells` itself does not exist yet. An explicit not-found is a SUCCESSFUL
// observation whose content is absence -- it is not missing output, so the governing law is intact.
test fn witness_observer_namespace_observed_absent_makes_its_addresses_absent() -> Bool {
  let readback = fabric_cell_observe_slot(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [
        FabricCellNamespaceProbeEntry { namespace: FabricCellsRootNamespace, probe: NamespaceObservedAbsent },
        FabricCellNamespaceProbeEntry { namespace: FabricCellSliceNamespace, probe: NamespaceObservedAbsent },
      ],
      addresses: [],
    },
    slot: observe_slot(),
  )
  count_absent(os: readback.observations) == 3 && count_refused(os: readback.observations) == 0
}

// LAW 22 -- OBSERVED-ABSENT AND ENUMERATED ARE A CONTRADICTION, NOT A PRECEDENCE. A namespace cannot
// both not exist and list entries. Asserted in both orders so no implementation passes by taking an
// end.
test fn witness_observer_absent_and_enumerated_namespace_refuses_in_both_orders() -> Bool {
  let forward = fabric_cell_observe_address(
    probe: probe_with_namespaces(ns: [
      FabricCellNamespaceProbeEntry { namespace: FabricCellsRootNamespace, probe: NamespaceObservedAbsent },
      enumerated(ns: FabricCellsRootNamespace, entries: observe_root_entries()),
    ]),
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  let reverse = fabric_cell_observe_address(
    probe: probe_with_namespaces(ns: [
      enumerated(ns: FabricCellsRootNamespace, entries: observe_root_entries()),
      FabricCellNamespaceProbeEntry { namespace: FabricCellsRootNamespace, probe: NamespaceObservedAbsent },
    ]),
    slot: observe_slot(),
    address: FabricCellRootAddress,
  )
  observation_is_refused(o: forward) && observation_is_refused(o: reverse)
}

// LAW 23 -- ANOTHER HOST'S COMMITTED NAME FOUND HERE IS NOT THIS HOST'S EXPECTED CELL. An artifact
// named srv3-06 in srv4's cells root says an artifact named srv3-06 exists ON srv4; it is not
// evidence that srv3's expected cell exists. The earlier classifier searched the whole fleet with
// no host argument and returned DiscoveredExpectedCell for exactly this input -- one host's listing
// satisfying another host's expectation, which is the cross-host join class the classification
// kernel repaired one layer later.
test fn witness_observer_other_hosts_committed_name_is_not_this_hosts_expected_cell() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: FabricCellHostProbe {
      host: operator_host_srv4,
      namespaces: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-06"])],
      addresses: [],
    }
  ) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } =>
      list_length(items: ss) == 1
        && fold(ss, init: true, f: (acc, sub) => acc && !discovered_is_expected(s: sub))
        && fold(ss, init: false, f: (acc, sub) => acc || discovered_is_cross_host(s: sub))
  }
}

fn discovered_is_expected(s: FabricCellDiscoveredSubject) -> Bool {
  match s {
    DiscoveredExpectedCell { slot: _ } => true
    DiscoveredUnexpectedCommittedSlot { slot: _ } => false
    DiscoveredCrossHostNamedArtifact { observed_name: _, named_slot: _, observed_on: _ } => false
    DiscoveredForeignArtifact { observed_name: _, location: _ } => false
  }
}

fn discovered_is_cross_host(s: FabricCellDiscoveredSubject) -> Bool {
  match s {
    DiscoveredCrossHostNamedArtifact { observed_name: _, named_slot: _, observed_on: _ } => true
    DiscoveredExpectedCell { slot: _ } => false
    DiscoveredUnexpectedCommittedSlot { slot: _ } => false
    DiscoveredForeignArtifact { observed_name: _, location: _ } => false
  }
}

// LAW 24 -- AND A NAME NOTHING COMMITTED ANYWHERE IS STILL FOREIGN, NOT CROSS-HOST. The control that
// keeps the fourth arm from absorbing the third: `srv3-99` matches no committed slot on any host,
// so it stays a foreign artifact rather than being reported as another host's cell.
test fn witness_observer_uncommitted_name_stays_foreign_not_cross_host() -> Bool {
  match fabric_cell_discovered_subjects(
    probe: FabricCellHostProbe {
      host: operator_host_srv4,
      namespaces: [enumerated(ns: FabricCellsRootNamespace, entries: ["srv3-99"])],
      addresses: [],
    }
  ) {
    DiscoveryRefused { host: _, cause: _ } => false
    DiscoveryEnumerated { host: _, subjects: ss } =>
      fold(ss, init: true, f: (acc, sub) => acc && !discovered_is_cross_host(s: sub))
        && fold(ss, init: false, f: (acc, sub) => acc || fabric_cell_discovered_subject_wire(s: sub) == "foreign:fabric-cells-root:srv3-99")
  }
}

// LAW 25 -- DISCOVERY CARRIES THE HOST IT OBSERVED, in both arms. A discovery result whose host is
// dropped can be joined to the wrong readback by any consumer, which is the same writable
// disagreement the readback carrier was narrowed to prevent.
test fn witness_observer_discovery_carries_its_host_in_both_arms() -> Bool {
  let enumerated_arm = fabric_cell_discovered_subjects(probe: converged_probe())
  let refused_arm = fabric_cell_discovered_subjects(
    probe: probe_with_namespaces(ns: [enumeration_refused(ns: FabricCellsRootNamespace, cause: "permission denied")])
  )
  discovery_host_wire(d: enumerated_arm) == "srv3" && discovery_host_wire(d: refused_arm) == "srv3"
}

fn discovery_host_wire(d: FabricCellDiscovery) -> String {
  match d {
    DiscoveryEnumerated { host: h, subjects: _ } => h as String
    DiscoveryRefused { host: h, cause: _ } => h as String
  }
}

// LAW 26 -- A FOREIGN ARTIFACT REACHES THE POPULATION AS A REFUSAL, WHICH IS THE SEAM THE EARLIER
// SHAPE LEFT OPEN. Discovery and the expected fold were separately callable, so a caller could read
// the authority's cells, never enumerate the host, and obtain a fully `Observed` population while
// an out-of-band artifact sat on disk. Conservation held inside each function and nowhere between
// them -- which is how a conservation law actually fails: not by losing a subject, but by having a
// caller who never asks for one of the populations.
test fn witness_observer_foreign_artifact_refuses_the_population() -> Bool {
  population_is_refused(p: admit_fabric_cell_probe(probe: converged_probe_with_foreign()))
}

// AND THE DISCRIMINATING PAIR: the same host, read completely and converged, is OBSERVED when
// nothing foreign is present. Without this the row above passes on an implementation that refuses
// everything.
test fn witness_observer_converged_projection_is_an_observed_population() -> Bool {
  !population_is_refused(p: admit_fabric_cell_probe(probe: converged_probe()))
}

// LAW 27 -- A REFUSED ROOT ENUMERATION REFUSES BOTH POPULATIONS, and the row exists to record that
// they CANNOT disagree rather than to catch a case where they do. I first wrote this as "a refused
// discovery refuses an otherwise converged population" and it would have been a decoration: the
// cell-root address and discovery consume the SAME root enumeration, so a discovery that refused
// while every expected address observed is unreachable by construction, and a row asserting it
// could never go red. What is authorable, and asserted here, is that one refused enumeration
// surfaces on both sides -- so no consumer can take the observed half of a host whose listing
// failed.
test fn witness_observer_refused_root_enumeration_refuses_both_populations() -> Bool {
  let projection = fabric_cell_observe(probe: converged_probe_with_unreadable_root())
  let discovery_refusals = fabric_cell_discovery_refusals(discovery: projection.discovery)
  list_length(items: discovery_refusals) == 1
    && count_refused(os: fabric_cell_readback_observations(r: projection.expected_readback)) > 0
    && population_is_refused(p: admit_fabric_cell_probe(probe: converged_probe_with_unreadable_root()))
}

fn fabric_cell_readback_observations(r: FabricCellHostReadback) -> List<FabricCellAddressObservation> {
  fold(r.cell_readbacks, init: [], f: (acc, c) => concat(acc, c.observations))
}

// LAW 28 -- AN EXPECTED CELL AND A COMMITTED SLOT ARE NOT COUNTED TWICE. Both already reach the
// classification kernel through the readback, so projecting them again from discovery would
// double-count one subject in the plan identity. The converged probe's own root listing holds
// exactly the expected cell, and it contributes no refusal.
test fn witness_observer_expected_cell_is_not_double_counted_from_discovery() -> Bool {
  list_length(items: fabric_cell_discovery_refusals(
    discovery: fabric_cell_discovered_subjects(probe: converged_probe())
  )) == 0
}

fn converged_probe_with_foreign() -> FabricCellHostProbe {
  FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: [
      enumerated(ns: FabricCellsRootNamespace, entries: concat(observe_root_entries(), ["srv3-99"])),
      enumerated(ns: FabricCellChildNamespace { slot: observe_slot() }, entries: ["attempts"]),
      enumerated(ns: FabricCellSliceNamespace, entries: [fabric_cell_slice_name(slot: observe_slot())]),
    ],
    addresses: converged_probe().addresses,
  }
}

fn converged_probe_with_unreadable_root() -> FabricCellHostProbe {
  FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: [
      enumeration_refused(ns: FabricCellsRootNamespace, cause: "permission denied"),
      enumerated(ns: FabricCellChildNamespace { slot: observe_slot() }, entries: ["attempts"]),
      enumerated(ns: FabricCellSliceNamespace, entries: [fabric_cell_slice_name(slot: observe_slot())]),
    ],
    addresses: converged_probe().addresses,
  }
}

fn population_is_refused(p: FabricCellObservationDecision) -> Bool {
  match p {
    FabricCellObservationDenied { host: _, blocked: _ } => true
    FabricCellObservationNotApplicable { host: _ } => false
    FabricCellObservationAdmitted { population: _ } => false
  }
}

// LAW 29 -- A PROBE SUPPLIED FOR A SLOT THIS HOST DOES NOT DECLARE IS REFUSED, NOT DROPPED. The
// input-side twin of the conservation the classification kernel got: the projection consumed only
// the pairs the authority expects, so a state read for an undeclared slot, or a child namespace for
// a cell nobody asked about, had no output position and vanished. The observer was conserving what
// it PRODUCED while silently dropping part of what it was GIVEN.
test fn witness_observer_unconsumed_probe_entries_refuse_rather_than_vanishing() -> Bool {
  let stray = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 7 }
  let refusals = fabric_cell_unconsumed_probe_refusals(probe: FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: concat(
      converged_probe().namespaces,
      [enumerated(ns: FabricCellChildNamespace { slot: stray }, entries: ["attempts"])],
    ),
    addresses: concat(
      converged_probe().addresses,
      [FabricCellAddressProbeEntry {
        slot: stray,
        address: FabricCellRootAddress,
        probe: AddressStateRead { state_digest: "stray" as NonEmptyStr },
      }],
    ),
  })
  list_length(items: refusals) == 2
}

// AND THE PROBE THAT MATCHES THE AUTHORITY LEAVES NOTHING OVER. The control: without it the row
// above passes on an implementation that refuses every supplied entry, which would make a correct
// probe unusable.
test fn witness_observer_matching_probe_leaves_nothing_unconsumed() -> Bool {
  list_length(items: fabric_cell_unconsumed_probe_refusals(probe: converged_probe())) == 0
}

// AND AN UNCONSUMED ENTRY REACHES THE POPULATION, not merely a list nobody reads. The seam again:
// the projection carries it, and fabric_cell_projection_refusals is the only way to get the
// discovery half, so a caller cannot take one and skip the other.
test fn witness_observer_unconsumed_probe_refuses_the_population() -> Bool {
  let stray = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 7 }
  population_is_refused(p: admit_fabric_cell_probe(probe: FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: converged_probe().namespaces,
    addresses: concat(
      converged_probe().addresses,
      [FabricCellAddressProbeEntry {
        slot: stray,
        address: FabricCellRootAddress,
        probe: AddressStateRead { state_digest: "stray" as NonEmptyStr },
      }],
    ),
  }))
}

// LAW 32 -- THE MINT IS THE ONLY ROUTE, AND IT DISCRIMINATES. This row once compared the joined
// helper against a hand-assembled population to prove they agreed; that comparison is no longer
// authorable, because the hand-assembled route does not exist -- gunbc.fabric_cell_converge no
// longer exports a population constructor and the mint takes one probe. So what remains to assert
// is the part that was ever load-bearing: the same mint refuses the host holding a foreign artifact
// and admits the converged one, from probes that differ only in that artifact.
test fn witness_observer_mint_refuses_foreign_and_admits_converged() -> Bool {
  population_is_refused(p: admit_fabric_cell_probe(probe: converged_probe_with_foreign()))
    && !population_is_refused(p: admit_fabric_cell_probe(probe: converged_probe()))
}

// LAW 33 -- AN ENTRY MISSING FROM ITS NAMESPACE WHILE ITS STATE WAS READ IS A CONTRADICTION, NEVER AN
// ABSENCE. The two facts are a JOIN, not a precedence: taking whichever the control flow reached
// first let a physically impossible pair -- the root listing does not hold the cell, and a state
// read for that cell's root returned a digest -- resolve as a clean absence, which then licenses an
// ADD against a host that may already hold the resource.
test fn witness_observer_absent_entry_with_a_state_read_is_contradicted_not_absent() -> Bool {
  observation_is_refused(o: fabric_cell_observe_address(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [enumerated(ns: FabricCellsRootNamespace, entries: [])],
      addresses: [state_read(address: FabricCellRootAddress, digest: "d" as NonEmptyStr)],
    },
    slot: observe_slot(),
    address: FabricCellRootAddress,
  ))
}

// AND THE CONTROL THAT KEEPS LAW 33 FROM BANNING ABSENCE OUTRIGHT. Same missing entry, no state
// read supplied: that is an ordinary absence and must stay one, or the first unprovisioned host can
// never plan.
test fn witness_observer_absent_entry_without_a_state_read_is_still_absent() -> Bool {
  observation_is_absent(o: fabric_cell_observe_address(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [enumerated(ns: FabricCellsRootNamespace, entries: [])],
      addresses: [],
    },
    slot: observe_slot(),
    address: FabricCellRootAddress,
  ))
}

// LAW 34 -- AND THE SAME JOIN ONE LEVEL UP: ANCESTRY-DERIVED ABSENCE LOSES TO DESCENDANT EVIDENCE.
// A cell root that does not exist cannot hold an enumerated child namespace or a readable attempt
// root. Both contradictions are measured, because they arrive through different probe lists and an
// implementation can close one while leaving the other.
test fn witness_observer_absent_ancestor_with_an_enumerated_child_is_contradicted() -> Bool {
  observation_is_refused(o: fabric_cell_observe_address(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [
        enumerated(ns: FabricCellsRootNamespace, entries: []),
        enumerated(ns: FabricCellChildNamespace { slot: observe_slot() }, entries: ["attempts"]),
      ],
      addresses: [],
    },
    slot: observe_slot(),
    address: FabricCellAttemptRootAddress,
  ))
}

test fn witness_observer_absent_ancestor_with_a_descendant_state_read_is_contradicted() -> Bool {
  observation_is_refused(o: fabric_cell_observe_address(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [enumerated(ns: FabricCellsRootNamespace, entries: [])],
      addresses: [state_read(address: FabricCellAttemptRootAddress, digest: "d" as NonEmptyStr)],
    },
    slot: observe_slot(),
    address: FabricCellAttemptRootAddress,
  ))
}

// AND AN EXPLICIT CHILD ABSENCE AGREES WITH ITS PARENT, so it is not descendant evidence and must
// not be read as a contradiction. Without this control law 34 would refuse the ordinary
// fully-unprovisioned observation, which is the state the first realization has to plan from.
test fn witness_observer_absent_ancestor_with_an_absent_child_stays_absent() -> Bool {
  observation_is_absent(o: fabric_cell_observe_address(
    probe: FabricCellHostProbe {
      host: operator_host_srv3,
      namespaces: [
        enumerated(ns: FabricCellsRootNamespace, entries: []),
        FabricCellNamespaceProbeEntry {
          namespace: FabricCellChildNamespace { slot: observe_slot() },
          probe: NamespaceObservedAbsent,
        },
      ],
      addresses: [],
    },
    slot: observe_slot(),
    address: FabricCellAttemptRootAddress,
  ))
}

// LAW 35 -- A COMMITTED SLOT THE FABRIC DOES NOT EXPECT REFUSES THE POPULATION. It was classified
// correctly in discovery and then projected to nothing, on the reasoning that committed slots reach
// the kernel through the readback. Only EXPECTED slots do, so the typed distinction existed in
// discovery and vanished before the plan -- the population accepted a host holding a cell artifact
// nobody asked for.
test fn witness_observer_unexpected_committed_slot_refuses_the_population() -> Bool {
  let probe = FabricCellHostProbe {
    host: operator_host_srv3,
    namespaces: [enumerated(
      ns: FabricCellsRootNamespace,
      entries: concat(observe_root_entries(), ["srv3-01"]),
    )],
    addresses: converged_probe().addresses,
  }
  let refusals = fabric_cell_projection_refusals(projection: fabric_cell_observe(probe: probe))
  list_length(items: refusals) == 1
    && population_is_refused(p: admit_fabric_cell_probe(probe: probe))
}

// LAW 36 -- A CROSS-HOST NAMED ARTIFACT IS ITS OWN REFUSAL, NOT THE FOREIGN ONE. Both were once
// ForeignArtifactObserved: exhaustive over the discovery type, blind to the distinction that decides
// the remedy. The identity is what a remedy router reads, so the law is stated over the identity
// rather than over the rendered sentence.
test fn witness_observer_cross_host_artifact_is_not_the_foreign_refusal() -> Bool {
  let cross = refusal_identities(host: operator_host_srv4, entries: ["srv3-06"])
  let foreign = refusal_identities(host: operator_host_srv4, entries: ["srv3-99"])
  list_length(items: cross) == 1
    && list_length(items: foreign) == 1
    && !fold(cross, init: false, f: (acc, c) =>
         acc || fold(foreign, init: false, f: (seen, g) => seen || c == g))
}

fn refusal_identities(host: HostIdentity, entries: List<String>) -> List<String> {
  map(
    fabric_cell_projection_refusals(projection: fabric_cell_observe(probe: FabricCellHostProbe {
      host: host,
      namespaces: [enumerated(ns: FabricCellsRootNamespace, entries: entries)],
      addresses: [],
    })),
    r => fabric_cell_observation_refusal_identity(refusal: r),
  )
}

// LAW 37 -- THE FOURTH SUPPLIED POPULATION IS ORDER-INDEPENDENT TOO. Three populations had already
// been canonicalized, each where it was built and each with its own key; the unconsumed probes were
// still folded in caller order and carried that order into the blocked list, the rendered lines and
// the plan body. Two probes describing the same host in a different sequence must not produce two
// plan identities.
test fn witness_observer_unconsumed_refusals_are_order_independent() -> Bool {
  let a = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 7 }
  let b = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 8 }
  let forward = stray_probe_identities(first: a, second: b)
  let reverse = stray_probe_identities(first: b, second: a)
  list_length(items: forward) == 2 && identity_lists_equal(a: forward, b: reverse)
}

// AND DUPLICATES OF ONE SUBJECT ARE ONE REFUSAL, which is the same population question asked the
// other way: an order that is stable but double-counts is no better than one that reorders.
test fn witness_observer_duplicate_unconsumed_probes_are_one_refusal() -> Bool {
  let a = RunnerSlotIdentity { host: operator_host_srv3, slot_index: 7 }
  list_length(items: stray_probe_identities(first: a, second: a)) == 1
}

fn stray_probe_identities(first: RunnerSlotIdentity, second: RunnerSlotIdentity) -> List<String> {
  map(
    fabric_cell_canonical_refusals(refusals: fabric_cell_unconsumed_probe_refusals(
      probe: FabricCellHostProbe {
        host: operator_host_srv3,
        namespaces: converged_probe().namespaces,
        addresses: concat(
          converged_probe().addresses,
          [
            FabricCellAddressProbeEntry {
              slot: first,
              address: FabricCellRootAddress,
              probe: AddressStateRead { state_digest: "one" as NonEmptyStr },
            },
            FabricCellAddressProbeEntry {
              slot: second,
              address: FabricCellRootAddress,
              probe: AddressStateRead { state_digest: "two" as NonEmptyStr },
            },
          ],
        ),
      },
    )),
    r => fabric_cell_observation_refusal_identity(refusal: r),
  )
}

fn identity_lists_equal(a: List<String>, b: List<String>) -> Bool {
  list_length(items: a) == list_length(items: b)
    && join(a, "\n") == join(b, "\n")
}
