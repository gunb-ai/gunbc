  fabric_cell_observe_host,
  fabric_cell_discovered_subjects,
  FabricCellDiscovery,
  DiscoveryEnumerated,
  DiscoveryRefused,
  FabricCellDiscoveredSubject,
  DiscoveredExpectedCell,
  DiscoveredUnexpectedCommittedSlot,
  DiscoveredForeignArtifact,
  DiscoveredCrossHostNamedArtifact,
  fabric_cell_discovered_subject_wire,
