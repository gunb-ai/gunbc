module test.claim.language_emit_template_derivation_witness_test

import extdeps.filesystem.filesystem_io
import extdeps.languages.rust.emit {
  rt_functions,
  rt_wraps_result,
  rt_bridge_function_names,
  rust_method_templates,
  rust_method_wraps_result,
}
import extdeps.languages.python.emit { python_method_templates_flat }
import extdeps.languages.go.emit { go_method_templates_flat }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree



data language_emit_template_derivation_retirement_note: String = "RETIREMENT RECEIPT AND RENAME, v1 cut 2026-08-15. THE FILE WAS v1_source_audit_witness_test.dag and was renamed in the same motion as the split, because a partial retirement leaves the residue wearing a name that LIES: eight guards remained and NONE audits v1 source, so a file called v1_source_audit_witness_test.dag containing zero v1 source audits is a trap armed for the next cut, which would confirm v1 is gone and delete it. That is the vanishing-guard class, and leaving the old name would have re-armed on the way out the same trap this split was careful to avoid on the way in. Original subject and disposition follow. (tree: integration/v1-cut). This file audited v1 COMPILER SOURCE through 25 hard-coded src/v1/*.dag path literals; that source is deleted, so 35 of its 43 rows lost their subject and were retired here. THE FILE IS NOT RETIRED, because it was a MIXED CARRIER and resolving it per file would have vanished eight live guards: the surviving rows audit extdeps.languages.\{rust,python,go}.emit template derivation and the rust syntax spec at dag/extdeps/languages/rust/syntax.dag, none of which is v1. All eight execute green after the split. HOW THE 35 FAILED IS WORTH RECORDING because the diagnostic named the wrong class: each reported 'hermetic mode: no mock_response for operation Read - refusing to fabricate Unit', which reads as a harness-configuration fault and is actually what a MISSING FILE produces on this path - the substrate refusing to fabricate a value for a read it cannot perform. That is the correct fail-closed behavior (DESIGN 5) and the good outcome: a subject-less guard refused loudly instead of greening on nothing. Attribution was measured, not inferred - the same five rows PASS at fork base 8a799b61c4 and FAIL at head under the SAME binary, only the tree moving. Retained deliberately: live_tree_disposition stays ReadsLiveTree because the surviving syntax-spec row still reads the live tree, and it is consumed by the discovery harness rather than by any in-file reference, so an orphan sweep counting in-file uses would wrongly call it dead."

data rust_syntax_spec_path: String = "dag/extdeps/languages/rust/syntax.dag"

fn src_has(path: String, needle: String) -> Bool {
  let r = filesystem_read(path: path)
  string_contains(s: r.content, pattern: needle)
}


fn map_has_key(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}

fn str_map_has_key(m: Map<String, String>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}


































test fn second_syntax_spec_exists() -> Bool {
  src_has(rust_syntax_spec_path, "rust_syntax_spec: SyntaxSpec")
    && src_has(rust_syntax_spec_path, "rust_item_forms")
    && src_has(rust_syntax_spec_path, "rust_operators")
    && src_has(rust_syntax_spec_path, "rust_keyword_literals")
    && src_has(rust_syntax_spec_path, "\"struct\"")
    && src_has(rust_syntax_spec_path, "\"enum\"")
    && src_has(rust_syntax_spec_path, "\"impl\"")
}


test fn rt_functions_derived_from_registry() -> Bool {
  map_has_key(rt_functions(), "filesystem_read")
    && map_has_key(rt_functions(), "concat")
    && map_has_key(rt_functions(), "index_by")
}

test fn rt_bridge_function_names_derived_from_registry() -> Bool {
  let overridden = match map_get(rt_bridge_function_names(), "index_by") {
    Present { value: b } => b == "rc_index_by"
    Absent => false
  }
  overridden && !str_map_has_key(rt_bridge_function_names(), "concat")
}

test fn rt_wraps_result_derived_from_registry() -> Bool {
  map_has_key(rt_wraps_result(), "append")
    && map_has_key(rt_wraps_result(), "map_keys")
    && !map_has_key(rt_wraps_result(), "concat")
}

test fn method_wraps_result_derived_from_specs() -> Bool {
  map_has_key(rust_method_wraps_result(), "split")
    && !map_has_key(rust_method_wraps_result(), "last")
}

test fn method_templates_derived_from_specs() -> Bool {
  str_map_has_key(rust_method_templates(), "split")
    && str_map_has_key(rust_method_templates(), "last")
    && str_map_has_key(rust_method_templates(), "first")
}

test fn python_flat_method_templates_exclude_bridge_routed() -> Bool {
  !str_map_has_key(python_method_templates_flat(), "map")
    && !str_map_has_key(python_method_templates_flat(), "fold")
    && !str_map_has_key(python_method_templates_flat(), "concat")
}

test fn go_flat_method_templates_exclude_bridge_routed() -> Bool {
  !str_map_has_key(go_method_templates_flat(), "map")
    && !str_map_has_key(go_method_templates_flat(), "fold")
    && !str_map_has_key(go_method_templates_flat(), "concat")
}

