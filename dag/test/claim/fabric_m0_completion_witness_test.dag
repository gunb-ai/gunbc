module test.claim.fabric_m0_completion_witness

import std.types { Bool, List, String, NonEmptyStr }
import std.measure { hardware_thread_count }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import std.scoped_authorization { AttemptIdentity }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import product.fabric.identity { WorkKey }
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { shared_kernel_sandbox_profile }
import product.fabric.work {
  WorkContract, WorkStep, ReceiptSatisfiable, ExecutionRequirements,
  Shape, HardRequirements, ControlPlaneCapacity, derive_work_key,
  OutputObligation, OutputArtifactObligation, TerminalResultObligation,
  DeclaredOutputObligations,
  resolve_output_obligations, ObligationsJudgedAtJobStart,
  OutputObligationsResolution,
}
import gunbc.fabric_m0_origin_readback {
  OriginReading,
  OriginReadingOutcome,
  OriginReadingTaken,
  OriginReadingUnavailable,
  origin_reading_digest,
  read_origin_staged_file,
}
import gunbc.fabric_m0_completion {
  ComputationOutcome,
  ComputationSucceeded,
  ComputationFailed,
  OriginReadback,
  ReadbackConfirmed,
  ReadbackAbsent,
  ReadbackUnknown,
  ObservationSubject,
  ObligationSubject,
  CommitManifestSubject,
  OriginObservation,
  CommittedOutput,
  CommitManifest,
  JobPublication,
  PublishSuccess,
  PublishComputationFailed,
  PublishFinalizationFailed,
  PublishObligationsUnreadable,
  PublishPendingReconciliation,
  ObligationVerdict,
  ManifestMember,
  admit_job_publication,
}

// READS THE LIVE TREE, AND THE STAMP HAD TO CHANGE WITH THE BODY. This file previously declared
// SubstrateInputsOnly and was correct to: it was a pure fold over authored fixtures. Deleting the
// fixture mint makes it call read_origin_staged_file over a committed repository path, which reaches
// a live-checkout sink, so the old stamp would be a declaration asserting something its own body
// contradicts -- and nothing in the toolchain compares the two. A stamp that outlives the body it
// describes is the same stale-evidence class this PR repairs everywhere else, one scale down.
data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE TWO SUBJECTS EXERCISE BOTH KINDS, which the earlier two-roster shape could not: an artifact
// obligation and a terminal-result obligation are different owed subjects even under one id, so a
// fixture that only ever used one kind could not tell a kind-blind join from a correct one.
fn build_output() -> OutputObligation {
  OutputObligation { id: "build-output", kind: OutputArtifactObligation {} }
}

fn execution_receipt() -> OutputObligation {
  OutputObligation { id: "execution-receipt", kind: TerminalResultObligation {} }
}

// The same id under the OTHER kind. Nothing may let this discharge build_output().
fn build_output_as_terminal() -> OutputObligation {
  OutputObligation { id: "build-output", kind: TerminalResultObligation {} }
}

fn fixture_requirements() -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(8) },
      envelope: unstated_envelope(),
    },
    capabilities: "linux-arm64",
    trust_domain: "fleet-owned",
    isolation: shared_kernel_sandbox_profile(),
  }
}

fn contract_owing(required: List<OutputObligation>) -> WorkContract {
  WorkContract {
    program: "gunbc.fabric-m0.program:1",
    steps: [WorkStep { step_id: "fabric-m0", resumability: ReceiptSatisfiable }],
    source: "source:1",
    inputs: "inputs:1",
    runtime_closure: "runtime:1",
    effect_contract: "effects:1",
    output_contract: "outputs:1",
    output_obligations: DeclaredOutputObligations { required: required },
  }
}

fn the_work() -> WorkKey {
  derive_work_key(contract: contract_owing(required: both_required()), requirements: fixture_requirements())
}

fn both_required() -> List<OutputObligation> {
  [build_output(), execution_receipt()]
}

// A REAL RESOLUTION, NOT A HAND-BUILT ONE. ResolvedOutputObligations is sole_constructor, so these
// fixtures must go through resolve_output_obligations -- which is the point: the gate cannot be fed
// a roster that no resolution produced.
fn resolution_for(required: List<OutputObligation>, work: WorkKey) -> OutputObligationsResolution {
  resolve_output_obligations(
    contract: contract_owing(required: required),
    requirements: fixture_requirements(),
    work_key: work,
    judgment: ObligationsJudgedAtJobStart,
  )
}

fn the_resolution() -> OutputObligationsResolution {
  resolution_for(required: both_required(), work: the_work())
}

// Two distinct fixture digests. The witness needs a SECOND value so the digest comparison is shown
// to separate rather than answer true for everything -- an equality that never fails would satisfy
// the positive control on its own.
// EVERY CONFIRMING READ BELOW IS A REAL READ, and the fixture mint that used to stand here is
// deleted. It took a caller-chosen digest, and because .dag has no module-private the wrapper that
// called it was itself an exported unrestricted constructor: a foreign module could import it and
// reach ReadbackConfirmed with any digest at all. Measured, not argued -- that probe compiled with
// 0 blocking errors. Sealing the wrapper would only have moved the proxy one hop, because every
// helper returning a value that CARRIES a reading is the same escape.
//
// A reading now comes from digesting a file, which is the only way anything can obtain one. Under
// the hermetic envelope crypto.Sha256Sum.File replays one constant digest for every path, and that
// is sufficient here: these witnesses are about the verdict algebra, and the axis that separates a
// matching arm from a mismatching one is the RECORDED digest, not the observed one. An authority
// cannot choose what it reads back, which is the point.
data fixture_staged_subject: NonEmptyStr = "dag/test/fixture/fabric_m0_origin_readback/staged_manifest.txt"

fn read_outcome() -> OriginReadingOutcome {
  read_origin_staged_file(staged_path: fixture_staged_subject)
}

// The digest the origin actually returned, DERIVED from the reading and never authored, so a
// success arm cannot drift away from what was read.
fn digest_a(rd: OriginReading) -> Sha256Digest {
  origin_reading_digest(reading: rd)
}

fn digest_b() -> Sha256Digest {
  Sha256Digest { hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" as Sha256DigestHex }
}

fn the_attempt() -> AttemptIdentity {
  "attempt-1" as AttemptIdentity
}

fn other_attempt() -> AttemptIdentity {
  "attempt-2" as AttemptIdentity
}

fn full_membership(rd: OriginReading) -> List<ManifestMember> {
  [
    ManifestMember { obligation: build_output(), content: digest_a(rd: rd) },
    ManifestMember { obligation: execution_receipt(), content: digest_a(rd: rd) },
  ]
}

fn good_manifest(rd: OriginReading) -> CommitManifest {
  CommitManifest {
    attempt: the_attempt(),
    manifest_digest: digest_a(rd: rd),
    members: full_membership(rd: rd),
  }
}

fn manifest_with(rd: OriginReading, members: List<ManifestMember>) -> CommitManifest {
  CommitManifest {
    attempt: the_attempt(),
    manifest_digest: digest_a(rd: rd),
    members: members,
  }
}

// THE READ POPULATION, SUPPLIED SEPARATELY FROM THE WRITE POPULATION. Every fixture below states
// which subjects were actually read back at the origin; a subject absent from this list was never
// read, which is the state the previous shape could not express.
fn obs_of(subject: ObservationSubject, r: OriginReadback) -> OriginObservation {
  OriginObservation { subject: subject, readback: r }
}

fn confirmed(rd: OriginReading, subject: ObservationSubject) -> OriginObservation {
  obs_of(subject: subject, r: ReadbackConfirmed { reading: rd })
}

fn all_confirmed(rd: OriginReading) -> List<OriginObservation> {
  [confirmed(rd: rd, subject: ObligationSubject { obligation: build_output() }), confirmed(rd: rd, subject: ObligationSubject { obligation: execution_receipt() }), confirmed(rd: rd, subject: CommitManifestSubject {})]
}

fn reads_with_output(rd: OriginReading, r: OriginReadback) -> List<OriginObservation> {
  [obs_of(subject: ObligationSubject { obligation: build_output() }, r: r), confirmed(rd: rd, subject: ObligationSubject { obligation: execution_receipt() }), confirmed(rd: rd, subject: CommitManifestSubject {})]
}

fn reads_with_receipt(rd: OriginReading, r: OriginReadback) -> List<OriginObservation> {
  [confirmed(rd: rd, subject: ObligationSubject { obligation: build_output() }), obs_of(subject: ObligationSubject { obligation: execution_receipt() }, r: r), confirmed(rd: rd, subject: CommitManifestSubject {})]
}

fn reads_with_manifest(rd: OriginReading, r: OriginReadback) -> List<OriginObservation> {
  [confirmed(rd: rd, subject: ObligationSubject { obligation: build_output() }), confirmed(rd: rd, subject: ObligationSubject { obligation: execution_receipt() }), obs_of(subject: CommitManifestSubject {}, r: r)]
}

fn committed_both(rd: OriginReading) -> List<CommittedOutput> {
  [
    CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
    CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
  ]
}

fn is_success(p: JobPublication) -> Bool {
  match p {
    PublishSuccess { attempt: _, manifest_digest: _ } => true
    other => false
  }
}

fn is_obligations_unreadable(p: JobPublication) -> Bool {
  match p {
    PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: _ } => true
    other => false
  }
}

fn is_finalization_failure(p: JobPublication) -> Bool {
  match p {
    PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: _ } => true
    other => false
  }
}

fn is_pending(p: JobPublication) -> Bool {
  match p {
    PublishPendingReconciliation { attempt: _, subject: _, cause: _, unresolved: _ } => true
    other => false
  }
}

fn committed_receipt_only(rd: OriginReading) -> List<CommittedOutput> {
  [CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) }]
}

fn committed_build_only(rd: OriginReading) -> List<CommittedOutput> {
  [CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) }]
}

fn second_output() -> OutputObligation {
  OutputObligation { id: "second-output", kind: OutputArtifactObligation {} }
}

// A resolution whose work_key does not derive from its contract. resolve_output_obligations refuses
// it with WorkKeyDoesNotMatchContract, which is the only Unreadable cause that exists.
fn unreadable_resolution() -> OutputObligationsResolution {
  resolution_for(required: both_required(), work: "not-the-derived-work-key" as WorkKey)
}

// A VALID resolution for a DIFFERENT work. The seal is intact and the roster is real; only the
// binding is foreign. This is the substitution the seal cannot catch.
fn foreign_work_resolution() -> OutputObligationsResolution {
  let foreign_contract = contract_owing(required: [second_output()])
  let foreign_key = derive_work_key(contract: foreign_contract, requirements: fixture_requirements())
  resolve_output_obligations(
    contract: foreign_contract,
    requirements: fixture_requirements(),
    work_key: foreign_key,
    judgment: ObligationsJudgedAtJobStart,
  )
}

fn publish_judging(
  computation: ComputationOutcome,
  resolution: OutputObligationsResolution,
  judged_work: WorkKey,
  committed: List<CommittedOutput>,
  obs: List<OriginObservation>,
  manifest: CommitManifest
) -> JobPublication {
  admit_job_publication(
    attempt: the_attempt(),
    computation: computation,
    resolution: resolution,
    judged_work: judged_work,
    committed: committed,
    observations: obs,
    manifest: manifest,
  )
}

fn publish(
  computation: ComputationOutcome,
  resolution: OutputObligationsResolution,
  committed: List<CommittedOutput>,
  obs: List<OriginObservation>,
  manifest: CommitManifest
) -> JobPublication {
  publish_judging(
    computation: computation,
    resolution: resolution,
    judged_work: the_work(),
    committed: committed,
    obs: obs,
    manifest: manifest,
  )
}

// The two rosters below are owed by DIFFERENT contracts, so they derive different work keys. Judging
// them against the_work() is not a test of anything but the work-key wall, so each names its own.
fn empty_contract_work() -> WorkKey {
  derive_work_key(contract: contract_owing(required: []), requirements: fixture_requirements())
}

fn three_required() -> List<OutputObligation> {
  [build_output(), execution_receipt(), second_output()]
}

fn three_contract_work() -> WorkKey {
  derive_work_key(contract: contract_owing(required: three_required()), requirements: fixture_requirements())
}

// THE POSITIVE CONTROL. Without it every refusal below is satisfied by an authority that never
// publishes anything, which is the shape the brief names explicitly: an implementation refusing
// every job does not satisfy M0.
test fn a_complete_attempt_publishes_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_success(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// WITHHOLD THE REQUIRED ARTIFACT. The obligation set must not shrink to match what arrived.
test fn a_withheld_required_artifact_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_receipt_only(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

test fn a_withheld_required_receipt_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_build_only(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// AN UNREADABLE DECLARATION IS NOT AN EMPTY ONE. This is the pair the module's constructor split
// exists for, and it is checked in BOTH directions: the declared-empty roster must still succeed,
// or the refusal above would be satisfied by an authority that simply rejects every zero-length
// roster and the distinction would carry no information.
test fn an_unreadable_artifact_declaration_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_obligations_unreadable(p: publish(
        computation: ComputationSucceeded,
        resolution: unreadable_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

test fn a_declared_empty_artifact_roster_still_succeeds() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_success(p: publish_judging(
        computation: ComputationSucceeded,
        resolution: resolution_for(required: [], work: empty_contract_work()),
        judged_work: empty_contract_work(),
        committed: [],
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

test fn an_unreadable_receipt_declaration_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_obligations_unreadable(p: publish(
        computation: ComputationSucceeded,
        resolution: unreadable_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// A SUCCESSFUL STORAGE FINALIZATION MUST NOT INVERT A FAILED BUILD.
test fn a_failed_build_stays_failed_though_every_receipt_commits() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      match publish(
        computation: ComputationFailed { cause: "compile error" },
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ) {
        PublishComputationFailed { attempt: _, cause: c } => c == "compile error"
        other => false
      }
  }
}

// A READBACK THAT DISAGREES WITH THE COMMITTED RECORD IS NOT A HIT.
test fn a_readback_digest_mismatch_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: concat([
          CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_b() },
        ], committed_receipt_only(rd: rd)),
        obs: reads_with_output(rd: rd, r: ReadbackConfirmed { reading: rd }),
        manifest: good_manifest(rd: rd),
      ))
  }
}

test fn an_absent_object_at_origin_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: concat([
          CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
        ], committed_receipt_only(rd: rd)),
        obs: reads_with_output(rd: rd, r: ReadbackAbsent),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// A LOST ACKNOWLEDGEMENT IS NEITHER SUCCESS NOR FAILURE. This is the arm that would disappear if
// unknown were folded into either decided outcome, so it is asserted as pending specifically --
// not merely as not-success, which ReadbackAbsent already satisfies.
test fn a_lost_acknowledgement_is_pending_not_decided() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_pending(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: concat([
          CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
        ], committed_receipt_only(rd: rd)),
        obs: reads_with_output(rd: rd, r: ReadbackUnknown { cause: "upload acknowledgement lost" }),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// A DEFINITELY-MISSING OBJECT DOMINATES AN UNKNOWN ONE, so a job that is already incomplete is not
// parked in pending forever waiting on a reconcile that cannot complete it.
test fn a_missing_object_dominates_an_unknown_one() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish_judging(
        computation: ComputationSucceeded,
        resolution: resolution_for(required: three_required(), work: three_contract_work()),
        judged_work: three_contract_work(),
        committed: committed_both(rd: rd),
        obs: reads_with_output(rd: rd, r: ReadbackUnknown { cause: "upload acknowledgement lost" }),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// EVIDENCE FROM A FOREIGN ATTEMPT DOES NOT DISCHARGE THIS ATTEMPT'S OBLIGATIONS.
test fn a_foreign_attempts_artifact_does_not_satisfy_this_one() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: concat([
          CommittedOutput { obligation: build_output(), attempt: other_attempt(), recorded_digest: digest_a(rd: rd) },
        ], committed_receipt_only(rd: rd)),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

test fn a_manifest_bound_to_another_attempt_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: CommitManifest {
          attempt: other_attempt(),
          manifest_digest: digest_a(rd: rd),
          members: full_membership(rd: rd),
        },
      ))
  }
}

test fn an_uncommitted_manifest_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: reads_with_manifest(rd: rd, r: ReadbackAbsent),
        manifest: CommitManifest {
          attempt: the_attempt(),
          manifest_digest: digest_a(rd: rd),
          members: full_membership(rd: rd),
        },
      ))
  }
}

// THE AGGREGATE MUST NOT ERASE THE EVIDENCE UNDERNEATH IT. One output absent and one receipt
// undetermined is a failed job WITH work left to reconcile, and a verdict that reported only the
// absent one left the reconciler nothing to act on.
test fn a_dominating_failure_still_reports_the_unresolved_receipt() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      match publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: [
          CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
        ],
        obs: reads_with_receipt(rd: rd, r: ReadbackUnknown { cause: "receipt upload acknowledgement lost" }),
        manifest: good_manifest(rd: rd),
      ) {
        PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: u } => u.count() == 2
        other => false
      }
  }
}

// AND THE WORK LIST IS THE UNRESOLVED OBLIGATIONS, NOT EVERY OBLIGATION. One missing artifact
// beside a committed receipt and a committed manifest must report exactly one item; a field that
// simply echoed the whole roster would report three and satisfy the test above just as well.
test fn the_work_list_carries_only_the_unresolved_obligations() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      match publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_receipt_only(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ) {
        PublishFinalizationFailed { attempt: _, subject: _, cause: _, unresolved: u } => u.count() == 1
        other => false
      }
  }
}

// A RECEIPT'S CONTENT IS CHECKED, NOT MERELY ITS PRESENCE. The receipt branch used to discard the
// observed digest, so any confirmed readback satisfied it -- the artifact path's exact check, absent
// one carrier over.
test fn a_receipt_content_mismatch_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: concat(committed_build_only(rd: rd), [
          CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_b() },
        ]),
        obs: reads_with_receipt(rd: rd, r: ReadbackConfirmed { reading: rd }),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// THE MANIFEST MUST NAME THE POPULATION. Every object check passing does not establish that the
// manifest names those objects, and reconstruction after the worker is gone needs the relation.
test fn a_manifest_omitting_a_required_object_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: manifest_with(rd: rd, members: [ManifestMember { obligation: execution_receipt(), content: digest_a(rd: rd) }]),
      ))
  }
}

test fn a_manifest_naming_the_wrong_content_prevents_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: manifest_with(rd: rd, members: [
          ManifestMember { obligation: build_output(), content: digest_b() },
          ManifestMember { obligation: execution_receipt(), content: digest_a(rd: rd) },
        ]),
      ))
  }
}

// TWO ROWS CLAIMING ONE IDENTITY REFUSE RATHER THAN LETTING POSITION DECIDE.
test fn conflicting_rows_for_one_identity_refuse() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: concat([
          CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
          CommittedOutput { obligation: build_output(), attempt: the_attempt(), recorded_digest: digest_b() },
        ], committed_receipt_only(rd: rd)),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// A FAILED BUILD KEEPS ITS CAUSE AND STILL REPORTS THE RECONCILIATION WORK.
test fn a_failed_build_still_reports_an_unresolved_receipt() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      match publish(
        computation: ComputationFailed { cause: "compile error" },
        resolution: the_resolution(),
        committed: concat(committed_build_only(rd: rd), [
          CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
        ]),
        obs: reads_with_receipt(rd: rd, r: ReadbackUnknown { cause: "receipt upload acknowledgement lost" }),
        manifest: good_manifest(rd: rd),
      ) {
        PublishComputationFailed { attempt: _, cause: c, unresolved: u } => (c == "compile error") && (u.count() == 1)
        other => false
      }
  }
}

// AND A FAILED BUILD WHOSE STORAGE IS WHOLLY RESOLVED CARRIES AN EMPTY WORK LIST, so the field above
// is not satisfied by always reporting something.
test fn a_failed_build_with_resolved_storage_reports_no_work() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      match publish(
        computation: ComputationFailed { cause: "compile error" },
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ) {
        PublishComputationFailed { attempt: _, cause: c, unresolved: u } => (c == "compile error") && (u.count() == 0)
        other => false
      }
  }
}

// AN UNENUMERABLE ROSTER DOES NOT STOP THE MANIFEST BEING ASSESSED. The earlier form of this
// witness said "the other roster", which the one-roster collapse retired -- there is no sibling
// roster to assess any more. The property that survives is the one that mattered: "cannot enumerate
// this population" is not "stop examining every other population", so an undetermined manifest must
// still reach the work list beside an unenumerable roster. Asserting a count of 2 is what
// distinguishes that from an early return.
test fn an_unenumerable_roster_still_assesses_the_manifest() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      match publish(
        computation: ComputationSucceeded,
        resolution: unreadable_resolution(),
        committed: committed_both(rd: rd),
        obs: reads_with_manifest(rd: rd, r: ReadbackUnknown { cause: "manifest upload acknowledgement lost" }),
        manifest: good_manifest(rd: rd),
      ) {
        PublishObligationsUnreadable { attempt: _, subject: _, cause: _, unresolved: u } => u.count() == 2
        other => false
      }
  }
}

// THE READ MUST HAVE HAPPENED. These three are the discriminating reds for splitting the read
// population out of the committed rows: while `readback` was a FIELD of each committed row, an
// object that nobody read had no representation, so "every required object was confirmed at the
// origin" and "every required object carries a confirmation somebody wrote down" were the same
// sentence. Success must now be reachable only when a read is RECORDED for each subject, and an
// unperformed read reconciles rather than fails, because it says nothing about whether the object
// is there.
test fn a_required_object_never_read_back_cannot_publish_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_pending(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: [confirmed(rd: rd, subject: ObligationSubject { obligation: execution_receipt() }), confirmed(rd: rd, subject: CommitManifestSubject {})],
        manifest: good_manifest(rd: rd),
      ))
  }
}

// THE MANIFEST IS SUBJECT TO THE SAME RULE, and separately, because it is the root a result is
// reconstructed from: every required object confirmed beneath an unread manifest is a set of
// objects nobody can prove belong to one another.
test fn an_unread_manifest_cannot_publish_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_pending(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: [confirmed(rd: rd, subject: ObligationSubject { obligation: build_output() }), confirmed(rd: rd, subject: ObligationSubject { obligation: execution_receipt() })],
        manifest: good_manifest(rd: rd),
      ))
  }
}

// TWO READS CLAIMING ONE SUBJECT REFUSE rather than letting position pick the agreeable one -- the
// same law the committed rows already obey, applied to the population that now carries the reads.
test fn two_reads_claiming_one_subject_refuse() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: [
          confirmed(rd: rd, subject: ObligationSubject { obligation: build_output() }),
          obs_of(subject: ObligationSubject { obligation: build_output() }, r: ReadbackAbsent),
          confirmed(rd: rd, subject: ObligationSubject { obligation: execution_receipt() }),
          confirmed(rd: rd, subject: CommitManifestSubject {}),
        ],
        manifest: good_manifest(rd: rd),
      ))
  }
}

// THE SUBSTITUTION THE SEAL CANNOT CATCH. sole_constructor makes a forged resolution unwritable,
// and resolve_output_obligations refuses a work_key that does not derive from its own contract. Both
// hold here: this resolution is genuine, internally consistent, and sealed. It is simply about a
// DIFFERENT work than the one the gate was asked to judge. Nothing upstream can detect that, because
// only the gate knows which work it was asked about -- so if this publishes anything but a refusal,
// a caller can discharge job A's obligations with job B's roster.
test fn a_resolution_for_another_work_cannot_publish_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_obligations_unreadable(p: publish(
        computation: ComputationSucceeded,
        resolution: foreign_work_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// AND THE POSITIVE CONTROL FOR IT: the same shape with the CORRECT work still succeeds, so the
// refusal above is not satisfied by a gate that rejects every resolution.
test fn a_resolution_for_the_judged_work_publishes_success() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_success(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: committed_both(rd: rd),
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}

// KIND IS PART OF THE KEY. The committed row carries the right id under the WRONG kind, so a join
// on id alone would discharge the artifact obligation with a terminal-result row.
test fn the_same_id_under_another_kind_does_not_discharge_it() -> Bool {
  match read_outcome() {
    OriginReadingUnavailable { staged_path: _, cause: _ } => false
    OriginReadingTaken { reading: rd } =>
      is_finalization_failure(p: publish(
        computation: ComputationSucceeded,
        resolution: the_resolution(),
        committed: [
          CommittedOutput { obligation: build_output_as_terminal(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
          CommittedOutput { obligation: execution_receipt(), attempt: the_attempt(), recorded_digest: digest_a(rd: rd) },
        ],
        obs: all_confirmed(rd: rd),
        manifest: good_manifest(rd: rd),
      ))
  }
}
