module test.claim.sig_unresolved_fallthrough_witness

import std.types { String, Bool, Int, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

import gunbc.recurring_failure_mode.unresolved_callee_conflated_with_dispatched_elsewhere {
  unresolved_callee_conflated_with_dispatched_elsewhere,
}

import gunbc.instruments.multi_module_compile_fixture {
  MultiModuleCompileFixture,
  MultiModuleCompileFixtureOutcome,
  FixtureInstrumentRefused,
  FixtureCompileRefused,
  FixtureCompileCompleted,
  fixture_source,
  compile_fixture,
  fixture_blocking_rows,
  fixture_has_class,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SIG-UNRESOLVED FALLEN THROUGH BLIND SPOT: an executed control pair.
//
// THIS WITNESS IS A TRIPWIRE ON A HOLE, NOT A WALL. It asserts that the hole exists today.
// When the hole is closed — by the namespace lane's resolution coverage improving so that
// bare calls to kernel method template names resolve their signatures via func_env or
// parent_closure_callable_candidates rather than falling through to CallableUnresolved —
// this witness's RED leg (unimported_kernel_name_mislabeled_call_compiles_clean) will go
// red because the compiler will start REFUSING the mislabeled call. That red is THE POINT:
// it means the hole is being closed and the test must then invert its assertion (expect
// refusal, matching the licensed twin). DO NOT DELETE THE RED TEST TO MAKE IT PASS. Invert
// the assertion instead: the licensed twin becomes the only behavior.
//
// THE NODE THAT CLOSES THE HOLE: namespace-lane resolution coverage — the work item that
// makes func_env_declared_func_sig (or parent_closure_callable_candidates) resolve sigs for
// bare names matching kernel method templates without requiring an explicit import. Once that
// lands, the unimported path no longer produces CallableUnresolved for these names, the
// method bridge is never reached, and the shape wall fires uniformly.
//
// WHAT THIS WITNESS PROVES AND HOW IT IS DIFFERENT FROM call_target_partition_witness.
//
// A call whose callee resolves NO signature bypasses every call-shape judgment. The landed
// direct_call_shape_wall_note checks labels only when the sig resolves (the sig != none branch);
// an absent signature falls through to the method bridge, which binds args positionally and never
// validates labels against the callee's declared parameters. The wall note itself states this:
// "the method-call path binds its arguments through its own inference arms and is the method
// wall's territory."
//
// THIS WITNESS IS THE EXECUTED PROOF that the method wall does not currently close that gap:
// a mislabeled bare call to a kernel method template name (unimported, so CallableUnresolved)
// compiles CLEAN. The licensed twin — the same call where the name IS declared locally in the
// fixture module (so sig resolves) — is REFUSED by the direct-call shape wall. The asymmetry IS
// the blind spot.
//
// WHAT THIS WITNESS DOES NOT PROVE: that the fix is correct. The red side asserts the compiler
// ACCEPTS the mislabeled call (0 blocking diagnostics at the call). Once coverage lands and the
// sig resolves for the unimported case, this test would FAIL (the mislabeled call would be refused)
// and the assertion must flip to expect refusal. That inversion is the node's red control: the
// fallthrough count monotonically falls as coverage lands.
//
// CENSUS BASELINE (the input this witness's row actually parsed — name it, per §6 consumption):
//   Committed artifact: docs/measurements/sig_unresolved_fallthrough_census.tsv
//   Producer (byte-deterministic): scripts/sig_unresolved_fallthrough_census.sh
//     — kernel name roster DERIVED from the algebra authority dag/std/algebra.dag (the same
//     AlgebraFieldTemplate rows algebra_method_template_name consults), not hand-typed.
//   Baseline measured at main 1d8a1d3976758e7b22b2f7361b3ef45b1f09a752:
//     5890 sites / 1327 modules / 31 distinct names (aggregate sha256 of the committed TSV is
//     printed by the producer at run time; the per-name table is the TSV itself — read it there,
//     do not transcribe it here, a hand-typed copy drifts from its source silently).
//   Consumer: this row's red_control "fallthrough count monotonically falls" (node
//     call-signature-resolution-coverage in dag/gunbc/roadmap/roadmap_authority.dag) falls FROM
//     this baseline. Future coverage legs re-run the producer and diff against the committed file.
//
// OLD (invalidated by the executed control): 4597 sites — imported-and-not-locally-declared
//   calls. These resolve via parent_closure_callable_candidates, the wall fires, they are
//   PROTECTED. Counting them as blind spot was wrong (the executed control proves it; see the
//   run link in the PR).
//
// PREDICATE FILTERS and error direction: not locally declared (fn NAME( absent from file);
//   not imported (import line does not list the name). Not filtered statically: parent_closure
//   reachability beyond explicit imports (the import filter subsumes it for the corpus);
//   builtin/kernel table (the builtin positional arity check ignores labeled args by
//   construction, so labels remain unchecked whichever path handles the call; error direction:
//   conservative — sites the resolver can still answer are excluded via the import filter, and
//   the kernel-table route keeps labels unchecked anyway, so the count does not overstate the
//   hole).

// THE FIXTURE: calls 'length' with a deliberately wrong argument label, WITHOUT importing it.
// 'length' is a kernel method template name (FreeMonoidCollection profile, ReceiverSelf param).
// Without the import, call_target_for_direct_call reaches CallableUnresolved → sig=Absent →
// method bridge → positional binding → labels unchecked → compiles clean.

data unimported_mislabel_entry: String = "module suft.red\nfn probe(xs: List<Int>) -> Int { length(wrong_label: xs) }\n"

// THE LICENSED TWIN: the same call where 'length' is declared LOCALLY (not imported — the
// compile_fixture compiles in isolation with no module index, so imports cannot resolve).
// A local declaration puts the name in func_env.local, func_env_declared_func_sig finds it,
// sig=Present, and direct_call_shape_wall_note fires:
// "call shape mismatch calling 'length': no parameter named 'wrong_label' (declared: [xs])".
// The compiler IS capable of catching this at the shape layer; it simply does not when the name
// is unresolved (CallableUnresolved → method bridge).

data locally_declared_mislabel_entry: String = "module suft.green\nfn length(xs: List<Int>) -> Int { 0 }\nfn probe(xs: List<Int>) -> Int { length(wrong_label: xs) }\n"

fn compile_probe(entry: String) -> MultiModuleCompileFixtureOutcome {
  compile_fixture(MultiModuleCompileFixture {
    sources: [fixture_source("suft/probe.dag", entry)],
    entry: "suft/probe.dag"
  })
}

// THE RED CONTROL: the unimported mislabeled call compiles clean (0 blocking diagnostics).
// This IS the blind spot — the shape wall does not fire because sig=Absent.
test fn unimported_kernel_name_mislabeled_call_compiles_clean() -> Bool {
  match compile_probe(unimported_mislabel_entry) {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// THE LICENSED TWIN: the locally-declared mislabeled call IS refused by the shape wall.
// This proves the compiler is CAPABLE of catching this at the shape layer — it simply does not
// when the name is unresolved. The pairing makes the red a guarantee, not a complaint.
test fn locally_declared_kernel_name_mislabeled_call_is_refused() -> Bool {
  match compile_probe(locally_declared_mislabel_entry) {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "CallArgumentNameUnknown")
    FixtureCompileRefused { module_count: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      fixture_has_class(rows: rows, wanted: "CallArgumentNameUnknown")
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// NEGATIVE CONTROL: the correctly-labeled locally-declared call compiles clean (the wall does
// not over-refuse). This catches an over-refusing repair that breaks correct programs.
data locally_declared_correct_entry: String = "module suft.control\nfn length(xs: List<Int>) -> Int { 0 }\nfn probe(xs: List<Int>) -> Int { length(xs: xs) }\n"

test fn locally_declared_correctly_labeled_call_compiles_clean() -> Bool {
  match compile_probe(locally_declared_correct_entry) {
    FixtureCompileCompleted { module_count: _, emitted_files: _, resolved_rust_functions: _, diagnostics: rows, source_digest: _, compiler_digest: _ } =>
      count(fixture_blocking_rows(rows: rows)) == 0
    FixtureCompileRefused { module_count: _, diagnostics: _, source_digest: _, compiler_digest: _ } => false
    FixtureInstrumentRefused { cause: _ } => false
  }
}

// THE TYPED CLASS ROW LINK. The recurring failure mode this witness trips is the unresolved-callee
// absorber row; asserting its identity here ties the tripwire to the row in a typed, CI-checked
// position (a comment-only link can rot silently when the row is renamed; this leg goes red).
test fn class_row_link_is_current() -> Bool {
  (unresolved_callee_conflated_with_dispatched_elsewhere.identity as String)
    == "unresolved_callee_conflated_with_dispatched_elsewhere"
}
