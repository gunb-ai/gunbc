module test.claim.secret_access_admission_witness_test

import extdeps.cloud.gcp.iam {
  RolePermissionAuthority, RolePermissionsObserved, RolePermissionsUnobserved,
  GcpPredefinedRole,
}
import extdeps.cloud.gcp.secret_manager { SmAccessVersionEffect, SmSetSecretIamPolicyEffect, SmCreateSecretEffect }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.auth.github_apps { gunbai_ci_app_pem_secret }
import gunbc.auth.secret_access_admission {
  SecretAccessRequest, SecretAccessAdmission, AdmittedSecretAccessGrant,
  SecretAccessAdmitted, SecretAccessRoleInsufficient,
  SecretAccessRoleGrantsExcessAuthority, SecretAccessRoleUndetermined,
  SecretAccessRoleScopeUnclassified,
  SecretAccessBeneficiaryUnnamed, SecretAccessEffectResourceMismatch,
  SecretAccessEffectIsNotSecretScoped,
  admit_secret_access,
}
import std.types { String }
import std.logic { Bool }

data convergence_member: String = "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com"

fn read_request() -> SecretAccessRequest {
  SecretAccessRequest {
    effect: SmAccessVersionEffect { secret: "ci-github-app-private-key" },
    target: gunbai_ci_app_pem_secret,
    beneficiary: convergence_member
  }
}

// THE ACCESSOR ROLE AS GOOGLE ACTUALLY REPORTS IT, project permissions included. The first draft of
// this fixture declared it with a single permission, which made a wrong admission rule look correct:
// flat granted-minus-required subtraction would refuse this role for carrying
// resourcemanager.projects.get, and a one-permission fixture hid that. A fabricated observation is
// not evidence about the real role, which is the same defect the conditioned version-1 policy
// fixture carried in gunbc#10514.
fn observed_accessor() -> RolePermissionAuthority {
  RolePermissionsObserved {
    role: GcpPredefinedRole {
      name: "roles/secretmanager.secretAccessor",
      title: "Secret Manager Secret Accessor",
      included_permissions: [
        "resourcemanager.projects.get",
        "resourcemanager.projects.list",
        "secretmanager.versions.access"
      ],
      stage: "GA"
    },
    observed_at_revision: "roles-get-2026-09-05"
  }
}

// THE ROLE THIS WHOLE MODULE EXISTS TO REFUSE. It DOES include the permission the read requires, so
// a sufficiency check admits it -- and it also carries policy modification and destruction.
fn observed_admin() -> RolePermissionAuthority {
  RolePermissionsObserved {
    role: GcpPredefinedRole {
      name: "roles/secretmanager.admin",
      title: "Secret Manager Admin",
      included_permissions: [
        "resourcemanager.projects.get",
        "resourcemanager.projects.list",
        "secretmanager.versions.access",
        "secretmanager.secrets.setIamPolicy",
        "secretmanager.versions.destroy",
        "secretmanager.secrets.delete"
      ],
      stage: "GA"
    },
    observed_at_revision: "roles-get-2026-09-05"
  }
}

fn observed_viewer() -> RolePermissionAuthority {
  RolePermissionsObserved {
    role: GcpPredefinedRole {
      name: "roles/secretmanager.viewer",
      title: "Secret Manager Viewer",
      included_permissions: [
        "resourcemanager.projects.get",
        "secretmanager.secrets.get"
      ],
      stage: "GA"
    },
    observed_at_revision: "roles-get-2026-09-05"
  }
}

test fn the_minimal_role_for_the_requested_read_is_admitted() -> Bool {
  match admit_secret_access(request: read_request(), authority: observed_accessor()) {
    SecretAccessAdmitted { admitted: a } =>
      a.grant.role == "roles/secretmanager.secretAccessor"
        && a.grant.target.secret as String == "ci-github-app-private-key"
        && a.request.beneficiary == convergence_member
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// THE TEST THAT SEPARATES MINIMUM PRIVILEGE FROM SUFFICIENCY, and the one this module was built
// for. roles/secretmanager.admin GRANTS secretmanager.versions.access, so a check asking only
// "does this role include what the read needs" answers yes and writes an admin binding for a read.
// Admission must refuse it, and must say WHICH authority was excess rather than answering a bare
// false -- the excess list is what an operator reads to see what they were nearly given.
test fn a_role_that_is_sufficient_but_not_minimal_is_refused_with_its_excess_named() -> Bool {
  match admit_secret_access(request: read_request(), authority: observed_admin()) {
    SecretAccessRoleGrantsExcessAuthority { role: rl, excess: ex } =>
      rl == "roles/secretmanager.admin"
        && count(ex) == 3
        && any(ex, p => p == "secretmanager.secrets.setIamPolicy")
        && any(ex, p => p == "secretmanager.versions.destroy")
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// The positive control on the sufficiency half: without this the module could be refusing every
// role for excess and the admitted test above would be the only thing standing between it and a
// detector that answers "no" to everything.
test fn a_role_missing_the_required_permission_is_refused_as_insufficient() -> Bool {
  match admit_secret_access(request: read_request(), authority: observed_viewer()) {
    SecretAccessRoleInsufficient { role: rl, missing: ms } =>
      rl == "roles/secretmanager.viewer"
        && count(ms) == 1
        && any(ms, p => p == "secretmanager.versions.access")
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// UNOBSERVED IS NOT "DOES NOT GRANT". extdeps.cloud.gcp.iam refuses to collapse those two, and
// admission inherits that refusal: a role nobody looked up must not be admitted, and must not be
// reported as insufficient either, because the remedies differ -- observe it, versus pick another
// role.
test fn an_unobserved_role_is_undetermined_and_never_admitted() -> Bool {
  match admit_secret_access(
    request: read_request(),
    authority: RolePermissionsUnobserved {
      role_name: "roles/secretmanager.secretAccessor",
      cause: "roles.get was not called on this revision"
    }
  ) {
    SecretAccessRoleUndetermined { role: rl, cause: _ } => rl == "roles/secretmanager.secretAccessor"
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// An unnamed beneficiary must refuse before any role reasoning happens. The reconciler already
// refuses to write a policy naming a member that does not exist; this refuses one request earlier,
// where the operator can still be told what was missing.
test fn a_request_with_no_beneficiary_is_refused_before_any_role_is_considered() -> Bool {
  match admit_secret_access(
    request: SecretAccessRequest {
      effect: SmAccessVersionEffect { secret: "ci-github-app-private-key" },
      target: gunbai_ci_app_pem_secret,
      beneficiary: ""
    },
    authority: observed_accessor()
  ) {
    SecretAccessBeneficiaryUnnamed => true
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
  }
}

// THE REQUEST DECIDES THE ROLE, WHICH IS THE POINT. Asking to CHANGE a policy is a different
// request from asking to READ a secret, so the accessor role must not be admitted for it -- and it
// is refused as insufficient, naming the setIamPolicy permission it lacks, rather than quietly
// being handed the role the previous request used.
test fn a_different_requested_effect_does_not_inherit_the_read_role() -> Bool {
  match admit_secret_access(
    request: SecretAccessRequest {
      effect: SmSetSecretIamPolicyEffect { secret: "ci-github-app-private-key" },
      target: gunbai_ci_app_pem_secret,
      beneficiary: convergence_member
    },
    authority: observed_accessor()
  ) {
    SecretAccessRoleInsufficient { role: _, missing: ms } =>
      any(ms, p => p == "secretmanager.secrets.setIamPolicy")
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}


// THE REGRESSION THAT WOULD HAVE CAUGHT THE FIRST DRAFT. The project-scoped permissions Google ships
// inside the accessor role are not authority over this secret -- a role bound AT one secret grants
// nothing at the project -- so they must not count as excess. Flat subtraction reports two excess
// permissions here and refuses the only role this module exists to admit.
test fn project_scoped_permissions_in_the_accessor_role_are_not_excess_authority() -> Bool {
  match admit_secret_access(request: read_request(), authority: observed_accessor()) {
    SecretAccessAdmitted { admitted: a } => a.grant.role == "roles/secretmanager.secretAccessor"
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// AND THE ADMIN REFUSAL STILL HOLDS AT THE NEW GRAIN, which is what makes the fix a repair rather
// than a loosening: admin's excess is now measured only over its SECRET-scoped permissions, and
// there are still three of them.
test fn the_admin_excess_is_measured_over_secret_scoped_permissions_only() -> Bool {
  match admit_secret_access(request: read_request(), authority: observed_admin()) {
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: ex } =>
      count(ex) == 3
        && !any(ex, p => p == "resourcemanager.projects.get")
        && any(ex, p => p == "secretmanager.secrets.setIamPolicy")
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// A PERMISSION THIS MODEL CANNOT PLACE REFUSES, rather than being assumed harmless. Treating an
// unrecognised permission as out-of-scope is the widening that would let a future service's
// secret-reaching permission through unread.
test fn a_role_carrying_an_unplaceable_permission_refuses_rather_than_assuming_it_is_harmless() -> Bool {
  match admit_secret_access(
    request: read_request(),
    authority: RolePermissionsObserved {
      role: GcpPredefinedRole {
        name: "roles/some.futureRole",
        title: "Future",
        included_permissions: ["secretmanager.versions.access", "futureservice.secrets.read"],
        stage: "GA"
      },
      observed_at_revision: "roles-get-2026-09-05"
    }
  ) {
    SecretAccessRoleScopeUnclassified { role: _, unclassified: us } =>
      count(us) == 1 && any(us, p => p == "futureservice.secrets.read")
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// ── The effect and the target must name the same secret ──────────────────────────────────────
// The role is derived from the EFFECT and the binding is written against the TARGET. They are two
// independent fields, so a request can name a need on one secret and a grant on another; because
// secret_manager_effect_required_permissions discards the effect's secret name, nothing downstream
// notices. The admission that results is a correct role on the WRONG resource, and every other arm
// of admit_secret_access is satisfied, so it lands silently.

fn cross_secret_request() -> SecretAccessRequest {
  SecretAccessRequest {
    effect: SmAccessVersionEffect { secret: "some-other-secret" },
    target: gunbai_ci_app_pem_secret,
    beneficiary: convergence_member
  }
}

// THE DISCRIMINATING RED. Same beneficiary, same legitimately-observed accessor role, same target
// as the admitted read above -- ONLY the effect's secret differs. Without the check this returns
// SecretAccessAdmitted, because the accessor role does satisfy "access a version" and the target is
// a real secret. Both names are reported, because the caller cannot tell which half was the typo.
test fn an_effect_naming_a_different_secret_than_the_target_is_refused() -> Bool {
  match admit_secret_access(request: cross_secret_request(), authority: observed_accessor()) {
    SecretAccessEffectResourceMismatch { effect_secret: e, target_secret: t } =>
      e == "some-other-secret" && t == "ci-github-app-private-key"
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
  }
}

// THE PROJECT-SCOPED EFFECT GETS ITS OWN REFUSAL, AND THIS IS THE ROW THAT KEEPS THEM APART. A
// CreateSecret effect names no secret at all, so the secret-scoped join above has nothing to compare
// and must refuse for a DIFFERENT reason than "these two names disagree". Asserting the operation
// here is what would go red if a later edit collapsed this back onto the mismatch arm, which would
// send a reader hunting for a second name that does not exist.
test fn a_project_scoped_creation_effect_is_refused_as_not_secret_scoped() -> Bool {
  match admit_secret_access(
    request: SecretAccessRequest {
      effect: SmCreateSecretEffect { project: "gunbai-secrets" as GcpProjectId },
      target: gunbai_ci_app_pem_secret,
      beneficiary: convergence_member
    },
    authority: observed_accessor()
  ) {
    SecretAccessEffectIsNotSecretScoped { operation: op } => op == "CreateSecret"
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
  }
}

// THE POSITIVE CONTROL ON THE DETECTOR. Without this the rule could be "always mismatch" and the
// test above would still pass. An agreeing request must still reach the role reasoning and be
// admitted -- which is what every other admitted test in this file already exercises, asserted here
// against the mismatch arm specifically so the check cannot go permanently red unnoticed.
test fn an_agreeing_effect_and_target_still_reaches_admission() -> Bool {
  match admit_secret_access(request: read_request(), authority: observed_accessor()) {
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
    SecretAccessAdmitted { admitted: a } =>
      a.grant.role == "roles/secretmanager.secretAccessor"
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
    SecretAccessBeneficiaryUnnamed => false
  }
}

// THE ORDER MATTERS. An unnamed beneficiary refuses BEFORE the resource comparison, so a request
// that is wrong in both ways reports the beneficiary. This pins the precedence rather than leaving
// it to whichever branch happened to be written first.
test fn an_unnamed_beneficiary_refuses_before_the_resource_comparison() -> Bool {
  match admit_secret_access(
    request: SecretAccessRequest {
      effect: SmAccessVersionEffect { secret: "some-other-secret" },
      target: gunbai_ci_app_pem_secret,
      beneficiary: ""
    },
    authority: observed_accessor()
  ) {
    SecretAccessBeneficiaryUnnamed => true
    SecretAccessEffectResourceMismatch { effect_secret: _, target_secret: _ } => false
    SecretAccessEffectIsNotSecretScoped { operation: _ } => false
    SecretAccessAdmitted { admitted: _ } => false
    SecretAccessRoleInsufficient { role: _, missing: _ } => false
    SecretAccessRoleGrantsExcessAuthority { role: _, excess: _ } => false
    SecretAccessRoleUndetermined { role: _, cause: _ } => false
    SecretAccessRoleScopeUnclassified { role: _, unclassified: _ } => false
  }
}
