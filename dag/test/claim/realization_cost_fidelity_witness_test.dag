module test.claim.realization_cost_fidelity_witness

// THE SPECIMEN IS THE FIRST WITNESS, AND IT IS WRITTEN WITH A CONSTRUCTOR THAT ALREADY EXISTED.
// gunbc.recurring_failure_mode lens_prices_the_authority_while_the_lane_runs_the_realization
// measured a contract declaring work over BOTH operands against a realization charging the right
// one only. std.induction cost_graph_linear IS that shape, already in the corpus, which is the
// plainest possible evidence that the cost grammar this join needed was never missing.
import std.algebra { Equal, Greater, Less, ShapeIterateBody, ShapeLinearScan, ShapeSortBody }
import std.induction {
  ConstantBound,
  ForeverBound,
  ErrorBound,
  CostBound,
  CallerBodyCost,
  LogCost,
  PolyCost,
  ProductBound,
  SumBound,
  SumOfProductsBound,
  GrowthNotOrderable,
  OrderableGrowth,
  cost_bound_growth_in_param,
  cost_bound_to_shape,
  cost_graph_linear,
  cost_iterate_body,
  cost_linear,
  cost_log,
  cost_nlogn,
  cost_sqrt,
  param_growth_order,
  poly_exp_degree_one,
  shape_for_param_growth,
}
import std.realization_cost_fidelity {
  CostShapePreserved,
  ModeledCostNotStructured,
  ModeledCostBoundFact,
  CostGrowthNotOrderable,
  RealizationCostBodyDependent,
  FidelityInputRefused,
  FidelityRows,
  PrimitiveIsBothStructuredAndUnstructured,
  RealizationCostFact,
  RealizationCostFidelityReport,
  StructuredPrimitiveDuplicated,
  UnstructuredPrimitiveDuplicated,
  count_cost_facts_contradicted,
  cost_fidelity_counts,
  RealizationCostUnknown,
  RealizationDivergesByOperand,
  RealizationFasterThanModeled,
  RealizationSlowerThanModeled,
  cost_fidelity_of,
  count_cost_body_dependent,
  count_cost_not_orderable,
  count_cost_fidelity_findings,
  count_cost_fidelity_unmeasured,
  count_cost_model_unmigrated,
  realization_cost_fidelity_rows,
}
import std.primitive_identity { EmitRust, InterpreterHost }
import std.primitive_projection { PrimitiveIdentity }
import std.types { Bool, List, String }

fn concat_modeled_cost() -> CostBound {
  cost_graph_linear(v_param: "left", e_param: "right")
}

fn concat_realized_cost() -> CostBound {
  cost_linear(param: "right")
}

fn log_squared(param: String) -> CostBound {
  ProductBound { factors: [LogCost { param: param }, LogCost { param: param }] }
}

fn quadratic(param: String) -> CostBound {
  ProductBound { factors: [
    PolyCost { param: param, exponent: poly_exp_degree_one() },
    PolyCost { param: param, exponent: poly_exp_degree_one() }
  ] }
}

// THE CASE THE AUTHORITY EXISTS FOR. Both bounds are "linear"; a rank-only comparison calls them
// equal. Per parameter they are not: the realization does no work in the left operand, so it is
// cheaper there and identical on the right, and the model is the thing that is wrong.
// EVERY CONTROL READS ITS ROWS THROUGH THIS, and the refusal arm returns NO ROWS ON PURPOSE. A
// refused report means the INPUT was contradictory, so there is no honest row set to count; handing
// back an empty list makes every population assertion below fail loudly rather than quietly reading
// as "nothing to report", which is the one reading that would hide a refusal.
fn rows_of(report: RealizationCostFidelityReport) -> List<RealizationCostFidelityRow> {
  match report {
    FidelityRows { rows: r } => r
    FidelityInputRefused { cause: _ } => []
  }
}

fn refusal_kind(report: RealizationCostFidelityReport) -> String {
  match report {
    FidelityRows { rows: _ } => "rows"
    FidelityInputRefused { cause: c } =>
      match c {
        PrimitiveIsBothStructuredAndUnstructured { primitive: _ } => "both-structured-and-unstructured"
        StructuredPrimitiveDuplicated { primitive: _ } => "structured-duplicated"
        UnstructuredPrimitiveDuplicated { primitive: _ } => "unstructured-duplicated"
      }
  }
}

test fn concat_model_over_prices_the_left_operand() -> Bool {
  match cost_fidelity_of(modeled: concat_modeled_cost(), realized: concat_realized_cost()) {
    RealizationFasterThanModeled => true
    CostShapePreserved => false
    RealizationSlowerThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostBodyDependent => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// THE DISCRIMINATOR, kept in the corpus rather than in a PR description: read as a single rank the
// two bounds are indistinguishable on the operand they share, and the modeled bound has no CostShape
// at all because it spans two parameters. That is the reading a rank-only join would have produced.
test fn the_rank_only_reading_cannot_see_the_concat_divergence() -> Bool {
  match cost_bound_to_shape(b: concat_modeled_cost()) {
    Present { value: _ } => false
    Absent =>
      match cost_bound_growth_in_param(b: concat_modeled_cost(), param: "right") {
        GrowthNotOrderable => false
        OrderableGrowth { rank: modeled_rank } =>
          match cost_bound_growth_in_param(b: concat_realized_cost(), param: "right") {
            GrowthNotOrderable => false
            OrderableGrowth { rank: realized_rank } =>
              match param_growth_order(a: modeled_rank, b: realized_rank) {
                Equal => true
                Less => false
                Greater => false
              }
          }
      }
  }
}

test fn slower_realization_is_reported() -> Bool {
  match cost_fidelity_of(modeled: cost_linear(param: "n"), realized: cost_nlogn(param: "n")) {
    RealizationSlowerThanModeled => true
    CostShapePreserved => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostBodyDependent => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

test fn identical_costs_are_preserved() -> Bool {
  match cost_fidelity_of(modeled: concat_modeled_cost(), realized: concat_modeled_cost()) {
    CostShapePreserved => true
    RealizationSlowerThanModeled => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostBodyDependent => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// A PROVEN TRADE-OFF IS A FINDING, NOT AN ABSENCE: cheaper in one parameter and dearer in another is
// its own verdict, and collapsing it into Unknown would report "nothing to see" about two facts that
// are both established.
test fn per_operand_tradeoff_is_its_own_verdict() -> Bool {
  match cost_fidelity_of(
    modeled: SumOfProductsBound { terms: [
      [PolyCost { param: "left", exponent: poly_exp_degree_one() }, LogCost { param: "left" }],
      [PolyCost { param: "right", exponent: poly_exp_degree_one() }]
    ] },
    realized: SumOfProductsBound { terms: [
      [PolyCost { param: "left", exponent: poly_exp_degree_one() }],
      [PolyCost { param: "right", exponent: poly_exp_degree_one() }, LogCost { param: "right" }]
    ] },
  ) {
    RealizationDivergesByOperand => true
    CostShapePreserved => false
    RealizationSlowerThanModeled => false
    RealizationFasterThanModeled => false
    RealizationCostBodyDependent => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// THE COLLISION CONTROL. log-squared and linear are both "rank 2" under any single-ordinal encoding,
// and they are not the same growth: n beats (log n)^k for every k.
test fn log_squared_and_linear_do_not_collide() -> Bool {
  match cost_fidelity_of(modeled: log_squared(param: "n"), realized: cost_linear(param: "n")) {
    RealizationSlowerThanModeled => true
    CostShapePreserved => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostBodyDependent => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

test fn log_squared_has_no_shape() -> Bool {
  match cost_bound_to_shape(b: log_squared(param: "n")) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn quadratic_in_one_operand_has_no_shape() -> Bool {
  match cost_bound_to_shape(b: quadratic(param: "n")) {
    Absent => true
    Present { value: _ } => false
  }
}

// A LOGARITHMIC COST HAS NO CostShape SPELLING, so the projection answers absent rather than
// reporting a cost that grows as one that does not.
test fn logarithmic_cost_has_no_shape_and_does_not_round_to_constant() -> Bool {
  match cost_bound_to_shape(b: cost_log(param: "n")) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn linear_and_sorting_single_operand_costs_still_project() -> Bool {
  match cost_bound_to_shape(b: cost_linear(param: "n")) {
    Absent => false
    Present { value: linear } =>
      match cost_bound_to_shape(b: cost_nlogn(param: "n")) {
        Absent => false
        Present { value: sorting } => linear == ShapeLinearScan && sorting == ShapeSortBody
      }
  }
}

// ShapeIterateBody HAS A PREIMAGE, and it is why CallerBodyCost was added to AtomicCost: fold_list
// and index_by carry ShapeIterateBody today, and without a body atom the only spelling for them was
// a plain linear bound, which projects back as ShapeLinearScan — a different arm, silently.
test fn iterate_body_and_linear_scan_project_to_different_arms() -> Bool {
  match cost_bound_to_shape(b: cost_iterate_body(param: "n")) {
    Absent => false
    Present { value: with_body } =>
      match cost_bound_to_shape(b: cost_linear(param: "n")) {
        Absent => false
        Present { value: without_body } =>
          with_body == ShapeIterateBody && without_body == ShapeLinearScan
      }
  }
}

// A PER-ELEMENT BODY IS NOT KNOWN TO BE WORSE THAN NO BODY: the body may be O(1). Two costs agreeing
// on growth in every parameter and differing only in the body are UNDECIDED on evidence.
test fn a_per_element_body_difference_is_undecided_not_preserved() -> Bool {
  match cost_fidelity_of(modeled: cost_linear(param: "n"), realized: cost_iterate_body(param: "n")) {
    RealizationCostBodyDependent => true
    CostGrowthNotOrderable => false
    CostShapePreserved => false
    RealizationSlowerThanModeled => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// THIS CONTROL WAS AUTHORED ASSERTING THE WRONG ANSWER, and the correction is the point of it.
// It used to require RealizationSlowerThanModeled for n x body(n) against n log n, on the reasoning
// that a real growth difference outranks a body. That reasoning is false in exactly one direction
// and this is it: the body is unbounded by anything this carrier knows, so a body delta OPPOSING
// the growth delta can outweigh it by any amount. With a body of O(n^2) the modeled side is n^3 and
// the realization is dramatically FASTER, and the module was answering "slower" with confidence --
// the same fabrication class as sqrt-ordered-as-constant, one arm over.
test fn an_opposing_body_and_growth_delta_is_body_dependent() -> Bool {
  match cost_fidelity_of(modeled: cost_iterate_body(param: "n"), realized: cost_nlogn(param: "n")) {
    RealizationCostBodyDependent => true
    RealizationSlowerThanModeled => false
    CostShapePreserved => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// THE MIRROR, and it is the more dangerous direction because the answer flatters the realization:
// a realization that runs an unbounded caller body per element, against a modeled quadratic, used
// to report FASTER on the strength of a degree it wins while the body it runs is unbounded.
test fn an_opposing_body_does_not_make_a_realization_faster() -> Bool {
  match cost_fidelity_of(modeled: quadratic(param: "n"), realized: cost_iterate_body(param: "n")) {
    RealizationCostBodyDependent => true
    RealizationFasterThanModeled => false
    CostShapePreserved => false
    RealizationSlowerThanModeled => false
    RealizationDivergesByOperand => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// THE OTHER SIDE OF THE RULE, so the repair is not a blanket retreat into undecided: when the body
// delta AGREES with the growth delta, or is zero, nothing opposes and the axis stays decided. A
// realization that is worse on growth AND runs a body the model does not is worse, full stop.
test fn an_agreeing_body_and_growth_delta_stays_decided() -> Bool {
  let worse = ProductBound { factors: [
    PolyCost { param: "n", exponent: poly_exp_degree_one() },
    LogCost { param: "n" },
    CallerBodyCost { param: "n" },
  ] }
  match cost_fidelity_of(modeled: cost_linear(param: "n"), realized: worse) {
    RealizationSlowerThanModeled => true
    RealizationCostBodyDependent => false
    CostShapePreserved => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    CostGrowthNotOrderable => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}


// THE BODY SURVIVES A LOSING TERM. Growth comes from the largest term; a body is a fact about the
// COST, not about the winning term, and taking the winner whole dropped it.
test fn a_body_in_a_losing_term_is_not_dropped() -> Bool {
  match cost_fidelity_of(
    modeled: quadratic(param: "n"),
    realized: SumOfProductsBound { terms: [
      [PolyCost { param: "n", exponent: poly_exp_degree_one() },
       PolyCost { param: "n", exponent: poly_exp_degree_one() }],
      [CallerBodyCost { param: "n" }]
    ] },
  ) {
    RealizationCostBodyDependent => true
    CostGrowthNotOrderable => false
    CostShapePreserved => false
    RealizationSlowerThanModeled => false
    RealizationFasterThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

data probe_primitive_a: PrimitiveIdentity = PrimitiveIdentity { slug: "cost_fidelity_probe_a" }
data probe_primitive_b: PrimitiveIdentity = PrimitiveIdentity { slug: "cost_fidelity_probe_b" }

test fn unmeasured_and_unmigrated_are_counted_separately() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: concat_modeled_cost() }],
    unstructured: [probe_primitive_b],
    target: EmitRust,
    facts: [],
  ))
  count_cost_fidelity_unmeasured(rows: rows) == 1
    && count_cost_model_unmigrated(rows: rows) == 1
    && count_cost_fidelity_findings(rows: rows) == 0
}

test fn realization_fact_does_not_cross_targets() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: concat_modeled_cost() }],
    unstructured: [],
    target: EmitRust,
    facts: [
      RealizationCostFact {
        primitive: probe_primitive_a,
        target: InterpreterHost,
        cost: concat_realized_cost(),
      },
    ],
  ))
  count_cost_fidelity_unmeasured(rows: rows) == 1 && count_cost_fidelity_findings(rows: rows) == 0
}

test fn measured_target_reports_the_finding() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: concat_modeled_cost() }],
    unstructured: [],
    target: InterpreterHost,
    facts: [
      RealizationCostFact {
        primitive: probe_primitive_a,
        target: InterpreterHost,
        cost: concat_realized_cost(),
      },
    ],
  ))
  count_cost_fidelity_findings(rows: rows) == 1 && count_cost_fidelity_unmeasured(rows: rows) == 0
}

// AN ARM THAT NO REPORTED POPULATION COUNTS IS AN ANSWER NOBODY READS: all four counts asserted on
// one ledger, so the type cannot gain an arm without the accounting being revisited.
test fn the_undecided_arm_appears_in_a_reported_population() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") }],
    unstructured: [],
    target: InterpreterHost,
    facts: [
      RealizationCostFact {
        primitive: probe_primitive_a,
        target: InterpreterHost,
        cost: cost_iterate_body(param: "n"),
      },
    ],
  ))
  count_cost_body_dependent(rows: rows) == 1
    && count_cost_fidelity_findings(rows: rows) == 0
    && count_cost_fidelity_unmeasured(rows: rows) == 0
    && count_cost_model_unmigrated(rows: rows) == 0
}

// A FRACTIONAL EXPONENT IS A REAL BOUND THIS READING CANNOT ORDER, and std.induction already carries
// it (cost_sqrt). It answers unrepresentable rather than rounding to constant or to linear, and the
// projection refuses with it.
test fn a_fractional_exponent_is_not_rounded_to_a_shape() -> Bool {
  match cost_bound_to_shape(b: cost_sqrt(param: "n")) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE TWO FABRICATIONS THIS ARM EXISTS TO STOP, both reproduced by execution before the repair.
//
// A FRACTIONAL EXPONENT WAS ORDERED AS CONSTANT: representable:false zeroes the growth to (0,0),
// param_growth_order never consulted the flag, and sqrt(n) therefore compared CHEAPER than n. The
// module's own annotation said a reader reporting constant or linear for such a bound "would be
// fabricating"; the join did it three lines of indirection away.
test fn a_fractional_exponent_is_not_ordered_as_cheaper_than_linear() -> Bool {
  match cost_fidelity_of(modeled: cost_linear(param: "n"), realized: cost_sqrt(param: "n")) {
    CostGrowthNotOrderable => true
    RealizationFasterThanModeled => false
    CostShapePreserved => false
    RealizationSlowerThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostBodyDependent => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

// AN UNBOUNDED COST WAS ORDERED AS EQUAL TO A CONSTANT: ForeverBound names no parameters, so the
// axis list was empty, and an empty axis list is Equivalent in std.pareto. "No axes" and "no
// difference" are not the same fact.
test fn an_unbounded_cost_is_not_preserved_against_a_constant() -> Bool {
  match cost_fidelity_of(modeled: ForeverBound, realized: ConstantBound) {
    CostGrowthNotOrderable => true
    CostShapePreserved => false
    RealizationFasterThanModeled => false
    RealizationSlowerThanModeled => false
    RealizationDivergesByOperand => false
    RealizationCostBodyDependent => false
    RealizationCostUnknown => false
    RealizationCostFactsContradict { count: _ } => false
    ModeledCostNotStructured => false
  }
}

test fn a_malformed_bound_is_not_orderable() -> Bool {
  match cost_fidelity_of(modeled: cost_linear(param: "n"), realized: ErrorBound) {
    CostGrowthNotOrderable => true
    _ => false
  }
}

// TWO GENUINE CONSTANTS STILL COMPARE, so the gate is about orderability rather than about having
// no parameters: the empty-axis case is only wrong when a side was unorderable.
test fn two_constants_still_compare_as_preserved() -> Bool {
  match cost_fidelity_of(modeled: ConstantBound, realized: ConstantBound) {
    CostShapePreserved => true
    _ => false
  }
}

// AND THE ARM IS COUNTED: an answer no population reports is an answer nobody reads, which is the
// defect this module shipped one round earlier.
test fn the_unorderable_arm_appears_in_a_reported_population() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") }],
    unstructured: [],
    target: InterpreterHost,
    facts: [
      RealizationCostFact {
        primitive: probe_primitive_a,
        target: InterpreterHost,
        cost: cost_sqrt(param: "n"),
      },
    ],
  ))
  count_cost_not_orderable(rows: rows) == 1
    && count_cost_fidelity_findings(rows: rows) == 0
    && count_cost_body_dependent(rows: rows) == 0
    && count_cost_fidelity_unmeasured(rows: rows) == 0
    && count_cost_model_unmigrated(rows: rows) == 0
}

// THE CONSTRUCTION ITSELF, exercised where the old flag was readable: an unplaceable growth now has
// no rank to hand param_growth_order, so these controls check the arm rather than a boolean field.
// The behavioural claims are the same two fabrications that were measured before the gate existed --
// sqrt(n) read as cheaper than n, an unbounded cost read as equal to a constant -- and they are kept
// here as permanent regression controls even though the ordering that produced them is now
// unwritable (DESIGN section 4b(4): a climb dissolves the production handling, never the evidence).
test fn a_fractional_exponent_growth_has_no_rank() -> Bool {
  match cost_bound_growth_in_param(b: cost_sqrt(param: "n"), param: "n") {
    GrowthNotOrderable => true
    OrderableGrowth { rank: _ } => false
  }
}

test fn an_unbounded_growth_has_no_rank() -> Bool {
  match cost_bound_growth_in_param(b: ForeverBound, param: "n") {
    GrowthNotOrderable => true
    OrderableGrowth { rank: _ } => false
  }
}

test fn a_linear_growth_has_a_rank() -> Bool {
  match cost_bound_growth_in_param(b: cost_linear(param: "n"), param: "n") {
    OrderableGrowth { rank: r } => r.degree == 1 && r.logs == 0 && r.bodies == 0
    GrowthNotOrderable => false
  }
}

// AN UNORDERABLE FACTOR ABSORBS ITS PRODUCT AND ITS SUM, which is the property the old `&&` on the
// flag had and the arm must keep: a term nobody can place does not become placeable by sitting
// beside one that can.
test fn an_unorderable_factor_absorbs_the_whole_bound() -> Bool {
  let mixed = SumBound { terms: [cost_linear(param: "n"), cost_sqrt(param: "n")] }
  match cost_bound_growth_in_param(b: mixed, param: "n") {
    GrowthNotOrderable => true
    OrderableGrowth { rank: _ } => false
  }
}

test fn an_unorderable_growth_projects_to_no_shape() -> Bool {
  match shape_for_param_growth(growth: cost_bound_growth_in_param(b: cost_sqrt(param: "n"), param: "n")) {
    Absent => true
    Present { value: _ } => false
  }
}

// ---- ORDER INDEPENDENCE, AND THE PARTITION ----

// THE RED FOR FIRST-PICK, AND IT IS THE SAME TWO FACTS IN BOTH ORDERS. The lookup used to stop at
// the first matching (primitive, target) fact, so a key carrying a linear and a quadratic
// realization answered whichever the caller happened to list first -- a verdict decided by the
// accumulator's order rather than by the realization. Reversing the list is the whole discriminator:
// under first-pick these two calls disagree, and a fidelity that changes when nothing about the
// subject changed is the fabricated plausible output section 5 forbids.
fn contradicted_report(first: CostBound, second: CostBound) -> RealizationCostFidelityReport {
  realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") }],
    unstructured: [],
    target: InterpreterHost,
    facts: [
      RealizationCostFact { primitive: probe_primitive_a, target: InterpreterHost, cost: first },
      RealizationCostFact { primitive: probe_primitive_a, target: InterpreterHost, cost: second },
    ],
  )
}

test fn two_facts_for_one_key_contradict_in_either_order() -> Bool {
  let forward = rows_of(report: contradicted_report(first: cost_linear(param: "n"), second: quadratic(param: "n")))
  let reversed = rows_of(report: contradicted_report(first: quadratic(param: "n"), second: cost_linear(param: "n")))
  count_cost_facts_contradicted(rows: forward) == 1
    && count_cost_facts_contradicted(rows: reversed) == 1
    && count_cost_fidelity_findings(rows: forward) == count_cost_fidelity_findings(rows: reversed)
    && count_cost_fidelity_unmeasured(rows: forward) == 0
    && count_cost_fidelity_unmeasured(rows: reversed) == 0
}

// A CONTRADICTED KEY IS NOT AN UNMEASURED ONE. Both are "no usable realized cost", and collapsing
// them would file a repair against the wrong lane: unmeasured means nobody looked, contradicted
// means two people looked and disagreed.
test fn a_contradicted_key_is_not_counted_as_unmeasured() -> Bool {
  let rows = rows_of(report: contradicted_report(first: cost_linear(param: "n"), second: quadratic(param: "n")))
  count_cost_facts_contradicted(rows: rows) == 1 && count_cost_fidelity_unmeasured(rows: rows) == 0
}

// ONE FACT PER KEY STILL ANSWERS NORMALLY, so the repair did not turn every lookup into a refusal.
test fn a_single_fact_for_one_key_still_compares() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") }],
    unstructured: [],
    target: InterpreterHost,
    facts: [
      RealizationCostFact { primitive: probe_primitive_a, target: InterpreterHost, cost: cost_nlogn(param: "n") },
    ],
  ))
  count_cost_facts_contradicted(rows: rows) == 0 && count_cost_fidelity_findings(rows: rows) == 1
}

// THE PARTITION IS ENFORCED, NOT ASSUMED. A primitive in BOTH lists is a contradiction about the
// same key -- it would have produced two rows, one with a real fidelity and one
// ModeledCostNotStructured -- so the whole report refuses rather than emitting rows from a premise
// that does not hold.
test fn a_primitive_in_both_lists_refuses_the_report() -> Bool {
  refusal_kind(
    report: realization_cost_fidelity_rows(
      modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") }],
      unstructured: [probe_primitive_a],
      target: InterpreterHost,
      facts: [],
    )
  ) == "both-structured-and-unstructured"
}

test fn a_duplicated_structured_primitive_refuses_the_report() -> Bool {
  refusal_kind(
    report: realization_cost_fidelity_rows(
      modeled: [
        ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") },
        ModeledCostBoundFact { primitive: probe_primitive_a, cost: quadratic(param: "n") },
      ],
      unstructured: [],
      target: InterpreterHost,
      facts: [],
    )
  ) == "structured-duplicated"
}

test fn a_duplicated_unstructured_primitive_refuses_the_report() -> Bool {
  refusal_kind(
    report: realization_cost_fidelity_rows(
      modeled: [],
      unstructured: [probe_primitive_b, probe_primitive_b],
      target: InterpreterHost,
      facts: [],
    )
  ) == "unstructured-duplicated"
}

// THE BOUNDARY: a well-formed partition still reports rows, so the refusals above are arms rather
// than a report that refuses whenever two lists are non-empty.
test fn a_disjoint_partition_still_reports_rows() -> Bool {
  refusal_kind(
    report: realization_cost_fidelity_rows(
      modeled: [ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") }],
      unstructured: [probe_primitive_b],
      target: InterpreterHost,
      facts: [],
    )
  ) == "rows"
}

// THE PARTITION IS TOTAL, AND NOTHING ASSERTED THAT BEFORE. Six independent counting folds could
// each have skipped the same arm and every population assertion would still have passed, because
// each checked its own count in isolation and none checked that they exhaust the rows. One
// classifier makes the partition total by construction; this asserts it by execution, over a row
// set built to land in several populations at once.
test fn the_reported_populations_exhaust_the_rows() -> Bool {
  let rows = rows_of(report: realization_cost_fidelity_rows(
    modeled: [
      ModeledCostBoundFact { primitive: probe_primitive_a, cost: cost_linear(param: "n") },
    ],
    unstructured: [probe_primitive_b],
    target: InterpreterHost,
    facts: [
      RealizationCostFact { primitive: probe_primitive_a, target: InterpreterHost, cost: cost_nlogn(param: "n") },
    ],
  ))
  let c = cost_fidelity_counts(rows: rows)
  c.preserved + c.findings + c.body_dependent + c.not_orderable + c.contradicted + c.unmeasured + c.unmigrated
    == count(rows)
}
