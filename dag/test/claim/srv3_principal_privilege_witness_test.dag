module test.claim.srv3_principal_privilege_witness

import std.logic { Bool }
import std.types { String, NonEmptyStr }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.posix.identity {
  PosixUserId,
  PosixGroupId,
  PosixOwnerSpec,
  posix_user_id_from_text,
  posix_group_id_from_text,
  posix_owner_spec_text,
}
import extdeps.tools.chown { chown_argv, chown_binary_path }
import extdeps.tools.mkdir { mkdir_parents_argv }
import extdeps.sudo.elevation { sudo_elevate, sudo_binary_path }
import gunbc.host_effect_realize {
  Srv3EffectiveOwner,
  Srv3EffectiveOwnerObserved,
  Srv3EffectiveOwnerUnobserved,
  srv3_owner_from_texts,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHAT THESE WITNESS. The predecessor composed a privileged chown's owner argument as
// uid + ":" + gid from two raw stdout captures, so there was no state in which a bad `id` read
// could be noticed -- concatenation always succeeds. The tests below are about the states that
// used to be unrepresentable, not about the happy path.

test fn a_decimal_uid_decodes() -> Bool {
  match posix_user_id_from_text(text: "1000") {
    Absent => false
    Present { value: u } => u.value == 1000
  }
}

// `id` terminates its output with a newline. The ssh arms trimmed and the local arm did not, so
// the two transports disagreed about what the same command returned.
test fn surrounding_whitespace_is_trimmed_before_decoding() -> Bool {
  match posix_user_id_from_text(text: " 1000\n") {
    Absent => false
    Present { value: u } => u.value == 1000
  }
}

// THE DISCRIMINATING RED FOR THE DECODE. Each of these composed into a syntactically plausible
// owner argument under the String predecessor.
test fn non_numeric_output_does_not_decode() -> Bool {
  match posix_user_id_from_text(text: "id: cannot find name for user ID 1000") {
    Present { value: _ } => false
    Absent => true
  }
}

// THIS ONE WENT RED WHEN FIRST RUN, AND IT IS THE MOST DANGEROUS CASE IN THE FILE.
// integer_lexeme_to_int_optional answers Present { value: 0 } for "", and 0 is root -- so an `id`
// that printed nothing decoded to the most privileged principal on the host and was chowned to.
// The decode alone did not close the hole; the decoder's empty case had to be answered.
test fn empty_output_does_not_decode() -> Bool {
  match posix_group_id_from_text(text: "") {
    Present { value: _ } => false
    Absent => true
  }
}

// POSIX ids are non-negative. A negative lexeme decodes cleanly and means nothing, which is the
// same shape as the empty case: a decode that succeeds is not the same as a value that is real.
test fn a_negative_id_does_not_decode() -> Bool {
  match posix_user_id_from_text(text: "-1") {
    Present { value: _ } => false
    Absent => true
  }
}

// Whitespace-only is the empty case after trimming, and it is spelled separately because that is
// what a probe that captured a newline and nothing else actually produces.
test fn whitespace_only_output_does_not_decode() -> Bool {
  match posix_user_id_from_text(text: "  \n ") {
    Present { value: _ } => false
    Absent => true
  }
}

// THE LAW IS NOT "ZERO IS INVALID" -- root is a real principal and uid 0 is a real id. It is that
// only the explicit lexical representation of zero may construct it. Absence of text may not.
test fn an_explicit_zero_decodes_to_root() -> Bool {
  match posix_user_id_from_text(text: "0") {
    Absent => false
    Present { value: u } => u.value == 0
  }
}

test fn owner_spec_renders_as_uid_colon_gid() -> Bool {
  posix_owner_spec_text(
    spec: PosixOwnerSpec {
      user: PosixUserId { value: 1000 },
      group: PosixGroupId { value: 2000 },
    },
  ) == "1000:2000"
}

test fn chown_argv_names_the_binary_then_the_owner_then_the_path() -> Bool {
  chown_argv(
    owner: PosixOwnerSpec {
      user: PosixUserId { value: 1000 },
      group: PosixGroupId { value: 1000 },
    },
    path: "/opt/gunbc",
  ) == ["/usr/bin/chown", "1000:1000", "/opt/gunbc"]
}

// ELEVATION IS APPLIED TO A COMMAND, so the elevated form is the unelevated argv with sudo and its
// flag in front -- one place, rather than the four call sites that each spelled both.
test fn elevation_prefixes_sudo_and_the_non_interactive_flag() -> Bool {
  let elevated = sudo_elevate(command: ["/usr/bin/chown", "1000:1000", "/opt/gunbc"])
  elevated.bin_path == sudo_binary_path as String &&
    elevated.args == ["-n", "/usr/bin/chown", "1000:1000", "/opt/gunbc"]
}

test fn elevating_an_empty_command_is_the_flag_alone() -> Bool {
  sudo_elevate(command: []).args == ["-n"]
}

test fn mkdir_parents_argv_is_the_idempotent_form() -> Bool {
  mkdir_parents_argv(path: "/opt/gunbc/bin") == ["/usr/bin/mkdir", "-p", "/opt/gunbc/bin"]
}

// THE CENTRAL RED. An undecodable id must refuse before any privileged mutation is attempted, and
// the refusal is structural rather than positional: srv3_ensure_directory_owned_by_current_user
// cannot reach its chown at all unless the effective owner was OBSERVED, because the owner is what
// the whole ensure is parameterised on. Under the predecessor these same inputs produced
// `chown -n "id: cannot find name for user ID 1000":1000 /opt/gunbc` and reported whatever sudo
// made of it.
//
// These three previously called srv3_chown_to_decoded_owner, which the ownership-ensure cut
// deleted -- so on that branch the file's load-bearing evidence imported a symbol that no longer
// existed and could not resolve. Caught in review of #8760 (review 54354), not by me: I ran the new
// witness file after that change and not the neighbouring one whose subject I had just removed.
test fn an_undecodable_uid_refuses_the_owner() -> Bool {
  match srv3_owner_from_texts(
    uid_text: "id: cannot find name for user ID 1000",
    gid_text: "1000",
  ) {
    Srv3EffectiveOwnerObserved { owner: _ } => false
    Srv3EffectiveOwnerUnobserved { reason: _ } => true
  }
}

test fn an_undecodable_gid_refuses_the_owner() -> Bool {
  match srv3_owner_from_texts(uid_text: "1000", gid_text: "") {
    Srv3EffectiveOwnerObserved { owner: _ } => false
    Srv3EffectiveOwnerUnobserved { reason: _ } => true
  }
}

// The refusal NAMES the text it could not read. A bare "unobserved" would leave an operator with an
// ensure that refuses and no way to see that `id` is the thing that is wrong.
test fn the_refusal_carries_the_text_it_could_not_decode() -> Bool {
  match srv3_owner_from_texts(uid_text: "not-a-uid", gid_text: "1000") {
    Srv3EffectiveOwnerObserved { owner: _ } => false
    Srv3EffectiveOwnerUnobserved { reason: why } => string_contains(s: why, pattern: "not-a-uid")
  }
}

// THE POSITIVE CONTROL for the three above: without it they are satisfied by a function that
// refuses every input.
test fn two_decodable_ids_observe_an_owner() -> Bool {
  match srv3_owner_from_texts(uid_text: "1000", gid_text: "2000") {
    Srv3EffectiveOwnerUnobserved { reason: _ } => false
    Srv3EffectiveOwnerObserved { owner: o } => o.user.value == 1000 && o.group.value == 2000
  }
}
