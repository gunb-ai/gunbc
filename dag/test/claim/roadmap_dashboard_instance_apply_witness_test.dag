test fn dashboard_provider_runtime_and_auth_share_one_state_binding() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  match gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable(instance: lab) {
    Absent => false
    Present { value: codex_path } => {
  let codex_program = codex_path as String
  let runtime_argv = concat(
    ["/usr/bin/env"],
    extdeps.llm.cli.shape_codex_version_env_args_for_program(
      program: codex_program,
      codex_home: gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: lab) as String,
    ),
  )
  let auth_argv = concat(
    ["/usr/bin/env"],
    extdeps.llm.cli.shape_codex_login_status_env_args_for_program(
      program: codex_program,
      codex_home: gunbc.roadmap_dashboard_instance.dashboard_instance_provider_state_root(instance: lab) as String,
    ),
  )
  runtime_argv == [
    "/usr/bin/env",
    "CODEX_HOME=/home/briansrls/.codex@gunbc-roadmap",
    codex_program,
    "--version",
  ]
    && auth_argv == [
    "/usr/bin/env",
    "CODEX_HOME=/home/briansrls/.codex@gunbc-roadmap",
    codex_program,
    "login",
    "status",
  ]
    && match gunbc.host_layout.srv1_codex_bundled_executable() {
      Present { value: executable } => codex_program == (executable as String)
      Absent => false
    }
    && match gunbc.typed_argv_exec.typed_argv_shell_safe_refusal_argv(argv: runtime_argv) {
      Absent => true
      Present { value: _ } => false
    }
    && match gunbc.typed_argv_exec.typed_argv_shell_safe_refusal_argv(argv: auth_argv) {
      Absent => true
      Present { value: _ } => false
    }
    }
  }
}

// THE CHMOD LITERAL MOVED FROM /usr/bin TO /bin AND THAT IS A REPAIR, NOT A LOOSENING. This roster
// and the install step that execs chmod each spelled their own absolute path, and they disagreed:
// the roster demanded /usr/bin/chmod while extdeps.tools.chmod -- the tool's authority, and the
// path this repository actually recorded for these hosts -- says /bin/chmod. The preflight was
// therefore gating a path no sanctioned caller runs, and it passed only because usrmerge makes
// both resolve. Both sites now read the authority, so this literal is the one independent
// statement of the value left, and it reds if that authority moves without anyone looking here.
test fn dashboard_target_preflight_derives_dispatch_platform_dependencies() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let required = gunbc.roadmap_dashboard_instance_apply.dashboard_required_target_executables(instance: lab)
  all(
    gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_platform_executables(instance: lab),
    platform_path => any(required, path => path == platform_path),
  )
    && count(required) == 16
    && any(required, path => path == ("/usr/bin/sh" as std.types.FilePath))
    && any(required, path => path == ("/usr/bin/tee" as std.types.FilePath))
    && any(required, path => path == ("/usr/bin/env" as std.types.FilePath))
    && any(required, path => path == ("/usr/bin/install" as std.types.FilePath))
    && any(required, path => path == ("/usr/bin/ln" as std.types.FilePath))
    && any(required, path => path == ("/usr/bin/dirname" as std.types.FilePath))
    && any(required, path => path == ("/bin/chmod" as std.types.FilePath))
    && !any(required, path => path == lab.serve_binary)
    && !any(
      required,
      path => path == ("/home/briansrls/.cargo/bin/cargo" as std.types.FilePath),
    )
    && !any(
      required,
      path => path == ("/home/briansrls/.cargo/bin/rustc" as std.types.FilePath),
    )
    && !any(
      required,
      path => path == ("/home/briansrls/.cargo/bin/rustfmt" as std.types.FilePath),
    )
}

data dashboard_poll_interval_witness_note: String = "This witness exists because a data row can typecheck and still fail to EVALUATE: dashboard_health_poll_seconds was authored as `2 as Seconds` and no single-entry witness run forced the row, so it went green locally and reded only in CI's affected-set re-eval leg, which evaluates changed data items (`cannot cast Int to Seconds` — the interpreter has no cast into a branded scalar; the corpus idiom is a bare literal, as in srv3_install_hang_no_installer_progress_ms: Milliseconds). Reading the value here forces the evaluation locally, so the same authoring mistake reds in the witness run rather than 15 minutes into the floor."

test fn dashboard_poll_interval_is_a_usable_duration() -> Bool {
  gunbc.roadmap_dashboard_instance_apply.dashboard_health_poll_seconds == 2
    && to_string(gunbc.roadmap_dashboard_instance_apply.dashboard_health_poll_seconds) == "2"
    && gunbc.roadmap_dashboard_instance_apply.dashboard_health_poll_attempts == 31
}

data dashboard_health_identity_witness_note: String = "review 44058. The served document is the oracle, so the green arm feeds dashboard_instance_json's real output rather than a hand-spelled stub — a stub is exactly what let the previous scan look correct while accepting anything. The REDs are the two ways a wrong server passes a scan but must fail positional identity: a different instance, and a document that merely MENTIONS the wanted id in a nested value."

fn health_result(body: String) -> gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
  gunbc.roadmap_dashboard_instance_apply.DashboardExecResult { success: true, stdout: body, stderr: "" }
}

test fn dashboard_health_requires_intended_instance_identity() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let live = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let mentions_lab_id_in_a_nested_value = join([
    "{\"schema\": \"roadmap-dashboard-instance/v1\", \"instance_id\": \"srv1-live\", ",
    "\"note\": \"\\\"instance_id\\\": \\\"",
    lab.instance_id as String,
    "\\\"\"}",
  ], "")
  gunbc.roadmap_dashboard_instance_apply.dashboard_instance_health_url(instance: lab) == "http://127.0.0.1:18081/instance.json"
    && gunbc.roadmap_dashboard_instance_apply.dashboard_health_names_instance(
      instance: lab,
      result: health_result(body: gunbc.roadmap_serve.dashboard_instance_json(instance: lab)),
    )
    && !gunbc.roadmap_dashboard_instance_apply.dashboard_health_names_instance(
      instance: lab,
      result: health_result(body: gunbc.roadmap_serve.dashboard_instance_json(instance: live)),
    )
    && !gunbc.roadmap_dashboard_instance_apply.dashboard_health_names_instance(
      instance: lab,
      result: health_result(body: mentions_lab_id_in_a_nested_value),
    )
}

test fn dashboard_plan_is_end_to_end_and_production_disjoint() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let rows = gunbc.roadmap_dashboard_instance.dashboard_instance_provision_plan_rows(instance: lab)
  count(rows) == 16
    && any(rows, row => row.kind == "ensure-provider-state-root")
    && any(rows, row => row.kind == "ensure-serve-binary")
    && any(rows, row => row.kind == "hydrate-controller-history")
    && any(rows, row => row.kind == "prepare-git-bundle")
    && any(rows, row => row.kind == "stage-git-bundle")
    && any(
      rows,
      row =>
        row.kind == "ensure-directory"
          && row.target == gunbc.roadmap_dashboard_instance.dashboard_instance_dispatch_attempt_state_root(instance: lab) as String,
    )
    && any(rows, row => row.kind == "verify-provider-runtime")
    && any(rows, row => row.kind == "verify-provider-auth")
    && any(rows, row => row.kind == "verify-health")
    && gunbc.roadmap_dashboard_instance.dashboard_instances_have_disjoint_owned_paths(
      a: lab,
      b: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
    )
    && lab.listen_port != gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance().listen_port
}

test fn dashboard_refusal_receipt_is_typed_and_located() -> Bool {
  let result = gunbc.roadmap_dashboard_instance_apply.DashboardApplyRefused {
    instance_id: "srv1-lab-codex-feedback-v0",
    step: "verify-provider-auth",
    detail: "codex login status exited nonzero",
    receipts: [
      gunbc.roadmap_dashboard_instance_apply.DashboardProvisionStepReceipt {
        kind: "verify-provider-auth",
        target: "/home/briansrls/.codex@gunbc-roadmap",
        success: false,
        detail: "codex login status exited nonzero",
      },
    ],
  }
  let wire = extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_dashboard_instance_apply.dashboard_apply_result_json_value(result: result))
  string_contains(s: wire, pattern: "\"status\": \"refused\"")
    && string_contains(s: wire, pattern: "\"step\": \"verify-provider-auth\"")
    && string_contains(s: wire, pattern: "\"success\": false")
}

test fn dashboard_dirty_controller_source_refuses_before_apply() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let dirty = gunbc.roadmap_dashboard_instance_apply.dashboard_source_preflight_decision(
    instance: lab,
    ref_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "deadbeef",
      stderr: "",
    },
    status_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: " M dag/gunbc/roadmap_dashboard_instance.dag",
      stderr: "",
    },
    shallow_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "true",
      stderr: "",
    },
    history_remote_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "configured",
      stderr: "",
    },
  )
  let clean = gunbc.roadmap_dashboard_instance_apply.dashboard_source_preflight_decision(
    instance: lab,
    ref_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "deadbeef",
      stderr: "",
    },
    status_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "",
      stderr: "",
    },
    shallow_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "false",
      stderr: "",
    },
    history_remote_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: false,
      stdout: "",
      stderr: "unused when history is complete",
    },
  )
  let missing_remote = gunbc.roadmap_dashboard_instance_apply.dashboard_source_preflight_decision(
    instance: lab,
    ref_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "deadbeef",
      stderr: "",
    },
    status_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "",
      stderr: "",
    },
    shallow_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "true",
      stderr: "",
    },
    history_remote_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: false,
      stdout: "",
      stderr: "No such remote",
    },
  )
  let empty_revision = gunbc.roadmap_dashboard_instance_apply.dashboard_source_preflight_decision(
    instance: lab,
    ref_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "",
      stderr: "",
    },
    status_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "",
      stderr: "",
    },
    shallow_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "false",
      stderr: "",
    },
    history_remote_read: gunbc.roadmap_dashboard_instance_apply.DashboardExecResult {
      success: true,
      stdout: "unused",
      stderr: "",
    },
  )
  let dirty_ok = match dirty {
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightRefused { instance_id: _, step, detail } =>
      step == "controller-source-dirty"
        && string_contains(s: detail, pattern: "bundle carries committed objects only")
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightReady {
      instance_id: _,
      source_revision: _,
    } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root: _,
      remediation: _,
    } => false
  }
  let clean_ok = match clean {
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightReady { instance_id, source_revision } =>
      instance_id == lab.instance_id
        && source_revision == "deadbeef"
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightRefused { instance_id: _, step: _, detail: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root: _,
      remediation: _,
    } => false
  }
  let missing_remote_ok = match missing_remote {
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightRefused { instance_id: _, step, detail } =>
      step == "controller-history-remote"
        && string_contains(s: detail, pattern: "modeled hydration remote")
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightReady {
      instance_id: _,
      source_revision: _,
    } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root: _,
      remediation: _,
    } => false
  }
  let empty_revision_ok = match empty_revision {
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightRefused { instance_id: _, step, detail } =>
      step == "controller-source-ref"
        && string_contains(s: detail, pattern: "empty revision")
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightReady {
      instance_id: _,
      source_revision: _,
    } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root: _,
      remediation: _,
    } => false
  }
  dirty_ok
    && clean_ok
    && missing_remote_ok
    && empty_revision_ok
    && string_contains(
      s: extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_dashboard_instance_apply.dashboard_apply_preflight_json_value(result: dirty)),
      pattern: "\"status\": \"refused\"",
    )
    && string_contains(
      s: extdeps.languages.json.emit.serialize_json(v: gunbc.roadmap_dashboard_instance_apply.dashboard_apply_preflight_json_value(result: clean)),
      pattern: "\"source_revision\": \"deadbeef\"",
    )
}

data bootstrap_unobserved_discriminates_note: String = "THE THIRD CASE IS THE POINT OF THIS CLAIM (review 45213). The first two arms passed before the fix and pass after it, so on their own they cannot tell the two versions apart — the collapse was invisible to them precisely because absent and unobservable both arrived as the same Bool.\\n\\nThe unobserved case is the discriminator: against the predecessor it is unconstructible, because there was no third value to pass, and against a regression that re-collapses the observation it lands in DashboardBootstrapRefused carrying not writable — which this claim asserts it does NOT. The transport reason must survive into the verdict, so the assertion checks the reason text reaches the operator rather than merely that some refusal occurred.\\n\\nThe reason string is a realistic transport failure rather than a placeholder, because the failure mode being guarded is an unreachable host being described as a permissions problem on a directory."

test fn dashboard_bootstrap_parent_writability_is_a_preflight_fact() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let ready = gunbc.roadmap_dashboard_instance_apply.dashboard_bootstrap_preflight_decision(
    instance: lab,
    root: gunbc.roadmap_dashboard_instance_apply.PathObservedAbsent,
    bootstrap_present: gunbc.roadmap_dashboard_instance_apply.PathObservedPresent,
    bootstrap_writable: gunbc.roadmap_dashboard_instance_apply.PathObservedPresent,
  )
  let refused = gunbc.roadmap_dashboard_instance_apply.dashboard_bootstrap_preflight_decision(
    instance: lab,
    root: gunbc.roadmap_dashboard_instance_apply.PathObservedAbsent,
    bootstrap_present: gunbc.roadmap_dashboard_instance_apply.PathObservedPresent,
    bootstrap_writable: gunbc.roadmap_dashboard_instance_apply.PathObservedAbsent,
  )
  let unobserved = gunbc.roadmap_dashboard_instance_apply.dashboard_bootstrap_preflight_decision(
    instance: lab,
    root: gunbc.roadmap_dashboard_instance_apply.PathObservedAbsent,
    bootstrap_present: gunbc.roadmap_dashboard_instance_apply.PathObservedPresent,
    bootstrap_writable: gunbc.roadmap_dashboard_instance_apply.PathObservationRefused {
      reason: "ssh: connect to host srv1 port 22: No route to host",
    },
  )
  let ready_ok = match ready {
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapReady { bootstrap_root } =>
      bootstrap_root == "/home/briansrls/.local/share"
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapRefused { bootstrap_root: _, reason: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapUnobserved { path: _, reason: _ } => false
  }
  let refused_ok = match refused {
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapReady { bootstrap_root: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapRefused { bootstrap_root, reason } =>
      bootstrap_root == "/home/briansrls/.local/share"
        && string_contains(s: reason as String, pattern: "not writable")
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapUnobserved { path: _, reason: _ } => false
  }
  let unobserved_ok = match unobserved {
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapReady { bootstrap_root: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapRefused { bootstrap_root: _, reason: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapUnobserved { path, reason } =>
      path == "/home/briansrls/.local/share"
        && string_contains(s: reason, pattern: "No route to host")
        && !string_contains(s: reason, pattern: "not writable")
  }
  ready_ok && refused_ok && unobserved_ok
}

// THE ROOT PROBE HAS THE SAME THREE ANSWERS, and it is the one whose collapse chose the WRONG PATH rather than the wrong verdict. Which directory is the bootstrap parent depends on whether the instance root exists — present means bootstrap into the root itself, absent means bootstrap into the provisioning parent — so a refused root observation does not merely lose a fact, it makes the subsequent question meaningless. The predecessor answered false and proceeded to describe the provisioning parent, which is a claim about a directory selected on evidence that was never gathered.\n\nThe claim asserts the refusal names the instance root, because that is the path whose observation actually failed.
test fn dashboard_unreachable_root_refuses_before_choosing_a_parent() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  match gunbc.roadmap_dashboard_instance_apply.dashboard_bootstrap_preflight_decision(
    instance: lab,
    root: gunbc.roadmap_dashboard_instance_apply.PathObservationRefused { reason: "ssh transport refused" },
    bootstrap_present: gunbc.roadmap_dashboard_instance_apply.PathObservedPresent,
    bootstrap_writable: gunbc.roadmap_dashboard_instance_apply.PathObservedPresent,
  ) {
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapReady { bootstrap_root: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapRefused { bootstrap_root: _, reason: _ } => false
    gunbc.roadmap_dashboard_instance_apply.DashboardBootstrapUnobserved { path, reason } =>
      (path as String) == (lab.instance_root as String)
        && string_contains(s: reason, pattern: "ssh transport refused")
  }
}

// THE ARM THAT MATTERS IS THE MIXED ONE. An unpeered host has no production liveness to compare, so the tempting shortcut is to let an absent reading compare equal to anything and move on — which would let an apply that STARTED with production served and ENDED with it unreachable report untouched, the precise reading the post-apply check exists to prevent. Equality is therefore required to agree on the arm as well as the contents: two reads compare their snapshots, two unpeered readings compare their hosts, and one of each is never equal regardless of what happened in between.\n\nThe isolation claim is the counterpart. NoProductionPeer discharges the disjointness obligation because there is no peer to overlap with, but it must not discharge the instance's OWN ownership requirement — an unowned path is unowned whether or not a production dashboard shares the machine, and preflight checks the two separately for that reason.
fn witness_peered() -> gunbc.roadmap_dashboard_instance_apply.DashboardProductionPeer {
  gunbc.roadmap_dashboard_instance_apply.ProductionPeer { instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance() }
}

fn witness_unpeered() -> gunbc.roadmap_dashboard_instance_apply.DashboardProductionPeer {
  gunbc.roadmap_dashboard_instance_apply.NoProductionPeer { host: "srv2" as std.types.NonEmptyStr }
}

fn witness_reading_read() -> gunbc.roadmap_dashboard_instance_apply.DashboardProductionReading {
  gunbc.roadmap_dashboard_instance_apply.ProductionRead {
    snapshot: gunbc.roadmap_dashboard_instance_apply.DashboardProductionSnapshot {
      observed: true,
      head: "abc123",
      health: "ok",
      detail: "",
    },
  }
}

test fn production_reading_never_equates_absent_with_observed() -> Bool {
  let read = witness_reading_read()
  let unpeered = gunbc.roadmap_dashboard_instance_apply.ProductionUnpeered { host: "srv2" as std.types.NonEmptyStr }
  gunbc.roadmap_dashboard_instance_apply.dashboard_production_readings_equal(before: read, after: read)
    && gunbc.roadmap_dashboard_instance_apply.dashboard_production_readings_equal(before: unpeered, after: unpeered)
    && !gunbc.roadmap_dashboard_instance_apply.dashboard_production_readings_equal(before: read, after: unpeered)
    && !gunbc.roadmap_dashboard_instance_apply.dashboard_production_readings_equal(before: unpeered, after: read)
    && !gunbc.roadmap_dashboard_instance_apply.dashboard_production_readings_equal(
      before: unpeered,
      after: gunbc.roadmap_dashboard_instance_apply.ProductionUnpeered { host: "srv1" as std.types.NonEmptyStr },
    )
}

test fn unpeered_host_refuses_nothing_and_reads_nothing() -> Bool {
  !gunbc.roadmap_dashboard_instance_apply.dashboard_production_reading_refused(reading: gunbc.roadmap_dashboard_instance_apply.dashboard_production_read(peer: witness_unpeered()))
    && string_contains(
      s: gunbc.roadmap_dashboard_instance_apply.dashboard_production_reading_detail(
        reading: gunbc.roadmap_dashboard_instance_apply.dashboard_production_read(peer: witness_unpeered()),
      ),
      pattern: "no production peer on srv2",
    )
}

test fn peer_isolation_still_requires_the_instance_to_own_its_paths() -> Bool {
  gunbc.roadmap_dashboard_instance_apply.dashboard_peer_isolation_ok(
    instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
    peer: witness_peered(),
  )
    && gunbc.roadmap_dashboard_instance_apply.dashboard_peer_isolation_ok(
      instance: gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance(),
      peer: witness_unpeered(),
    )
    && !gunbc.roadmap_dashboard_instance_apply.dashboard_peer_isolation_ok(
      instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
      peer: witness_peered(),
    )
}

test fn dashboard_instance_apply_model_keystone_holds() -> Bool {
  production_reading_never_equates_absent_with_observed()
    && unpeered_host_refuses_nothing_and_reads_nothing()
    && peer_isolation_still_requires_the_instance_to_own_its_paths()
    && dashboard_source_transport_argv_is_exact_and_atomic()
    && dashboard_local_origin_ref_translation_is_exact()
    && dashboard_service_is_named_and_scoped_off_production()
    && dashboard_provider_runtime_and_auth_share_one_state_binding()
    && dashboard_target_preflight_derives_dispatch_platform_dependencies()
    && dashboard_health_requires_intended_instance_identity()
    && dashboard_plan_is_end_to_end_and_production_disjoint()
    && dashboard_refusal_receipt_is_typed_and_located()
    && dashboard_dirty_controller_source_refuses_before_apply()
    && dashboard_bootstrap_parent_writability_is_a_preflight_fact()
    && dashboard_unreachable_root_refuses_before_choosing_a_parent()
    && dashboard_poll_interval_is_a_usable_duration()
}
