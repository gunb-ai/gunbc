    && extdeps.git.shape_git_bare_fetch_argv(
      repo: origin,
      bundle: bundle,
      source_ref: "refs/heads/session/codex-provider-feedback-v0" as std.types.GitRef,
    ) == [
      "--git-dir",
      "/instance/origin.git",
      "fetch",
      "--force",
      "/instance/inbox/source.bundle",
      "refs/heads/session/codex-provider-feedback-v0",
