module test.claim.roadmap_dashboard_instance_apply_witness


data dashboard_target_preflight_platform_drift_note: String = "The preflight roster count is a no-silent-growth ratchet over a hand-authored base list, so it is stated as a literal. The recurring drift it must not re-absorb: adding a dispatch-platform capability (ProviderEventProjectionCapability/jq, c37e4505d2) changes the derived half of the roster and silently reds the literal. The all(platform executables are required) law states that half structurally, so a new platform capability moves the derived side and the literal only guards the base list it actually describes.\\n\\nTHE SERVE BINARY LEFT THIS ROSTER AND ITS ABSENCE IS NOW ASSERTED, which is the substantive half of the 15-to-16 move. This branch gives apply an ensure-serve-binary step, so the binary is something the deployment INSTALLS rather than a precondition it demands — and a roster that still required it would refuse every first apply to a host that does not yet have one, which is the exact bootstrap this change exists to perform. dirname and chmod entered for the same reason: they are what installing it costs.\\n\\nThe negative conjunct is the one that would catch the regression. Re-adding the binary as a required executable keeps the count at 16 by displacing something else, so the literal alone cannot see it; asserting the binary is NOT required states the precondition/product distinction directly."

test fn dashboard_source_transport_argv_is_exact_and_atomic() -> Bool {
  let lab = gunbc.roadmap_dashboard_instance.srv1_lab_dashboard_instance()
  let local = "/tmp/dashboard-source.bundle" as std.types.FilePath
  let staged = "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/inbox/source.bundle" as std.types.FilePath
  let next = gunbc.roadmap_dashboard_instance_apply.dashboard_next_path(path: staged)
  extdeps.git.shape_git_bundle_create_argv(
    repo: "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0" as std.types.FilePath,
    bundle: local,
    source_ref: "refs/heads/session/codex-provider-feedback-v0" as std.types.GitRef,
  ) == [
    "-C",
    "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0",
    "bundle",
    "create",
    "/tmp/dashboard-source.bundle",
    "refs/heads/session/codex-provider-feedback-v0",
  ]
    && extdeps.git.shape_git_is_shallow_repository_argv(
      repo: "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0" as std.types.FilePath,
    ) == [
      "-C",
      "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0",
      "rev-parse",
      "--is-shallow-repository",
    ]
    && extdeps.git.shape_git_remote_get_url_argv(
      repo: "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0" as std.types.FilePath,
      remote: "origin",
    ) == [
      "-C",
      "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0",
      "remote",
      "get-url",
      "origin",
    ]
    && extdeps.git.shape_git_fetch_unshallow_argv(
      repo: "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0" as std.types.FilePath,
      remote: "origin",
    ) == [
      "-C",
      "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0",
      "fetch",
      "--no-tags",
      "--unshallow",
      "origin",
    ]
    && next == concat(staged as String, ".next")
    && extdeps.ssh.session.shape_scp_copy_to_argv(
      host: "srv1",
      local_path: local,
      remote_path: next,
    ) == [
      "/tmp/dashboard-source.bundle",
      "srv1:/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/inbox/source.bundle.next",
    ]
}

test fn dashboard_local_origin_ref_translation_is_exact() -> Bool {
  let origin = "/instance/origin.git" as std.types.FilePath
  let bundle = "/instance/inbox/source.bundle" as std.types.FilePath
