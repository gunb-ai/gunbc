module test.claim.emission_provenance_test

import std.algebra { Cons, Empty }
import std.decl_ref { decl_ref, declaration_ref_eq }
import std.types { NonEmptyStr, String }
import std.emission_provenance {
  EmissionAuthoredFragment, EmissionSourceComposition, EmissionUnobservedFragment,
  EmissionOriginsObserved, EmissionOriginsIncomplete,
  emission_contribution_read, emission_contribution_source, emission_contribution_origins, emission_contribution_unobserved
}

test fn emission_nested_contributor_survives_flattening() -> Bool {
  let wrapper = decl_ref(module_path: "fixture.runtime", decl_name: "wrapper")
  let leaf = decl_ref(module_path: "fixture.upstream", decl_name: "canonical_block")
  let contribution = EmissionSourceComposition {
    origin: wrapper,
    parts: [EmissionAuthoredFragment { origin: leaf, source: "implementation" }]
  }
  match emission_contribution_origins(contribution: contribution) {
    EmissionOriginsObserved { origins } =>
      emission_contribution_source(contribution: contribution) == "implementation"
        && (origins |> count == 2)
        && match origins {
          Cons { head, tail } =>
            declaration_ref_eq(a: head, b: leaf)
              || match tail {
                Cons { head: rest, tail: _ } => declaration_ref_eq(a: rest, b: leaf)
                Empty => false
              }
          Empty => false
        }
    _ => false
  }
}

// Combined product read through emission_contribution_read. Assertions use count and
// FreeSemigroup head access, not a lambda over a match-bound FreeMonoid — that is the
// compile-time mask retained at test.manual.emission_provenance_specimen_red
// emission_combined_read_preserves_content_order_and_origin_multiplicity.
test fn emission_combined_read_matches_standalone_layers_on_all_three_arms() -> Bool {
  let wrapper = decl_ref(module_path: "fixture.runtime", decl_name: "wrapper")
  let leaf = decl_ref(module_path: "fixture.upstream", decl_name: "canonical_block")
  let unknown = decl_ref(module_path: "fixture.runtime", decl_name: "untraced")
  let contribution = EmissionSourceComposition {
    origin: wrapper,
    parts: [
      EmissionAuthoredFragment { origin: leaf, source: "A" },
      EmissionUnobservedFragment {
        producer: unknown,
        cause: "producer returned flattened text" as NonEmptyStr,
        source: "B"
      }
    ]
  }
  let result = emission_contribution_read(contribution: contribution)
  result.source == emission_contribution_source(contribution: contribution)
    && result.source == "AB"
    && match result.origins {
      EmissionOriginsIncomplete { observed, missing } =>
        (observed |> count == 2)
          && declaration_ref_eq(a: missing.head.producer, b: unknown)
          && missing.head.cause == ("producer returned flattened text" as NonEmptyStr)
          && (missing.tail |> count == 0)
          && match emission_contribution_origins(contribution: contribution) {
            EmissionOriginsIncomplete { observed: origin_observed, missing: origin_missing } =>
              (origin_observed |> count == 2)
                && declaration_ref_eq(a: origin_missing.head.producer, b: unknown)
            _ => false
          }
      _ => false
    }
}

test fn emission_nested_unobserved_producer_remains_named() -> Bool {
  let wrapper = decl_ref(module_path: "fixture.runtime", decl_name: "wrapper")
  let unknown = decl_ref(module_path: "fixture.runtime", decl_name: "untraced")
  let contribution = EmissionSourceComposition {
    origin: wrapper,
    parts: [EmissionUnobservedFragment {
      producer: unknown,
      cause: "producer returned flattened text" as NonEmptyStr,
      source: "implementation"
    }]
  }
  let missing = emission_contribution_unobserved(contribution: contribution)
  (missing |> count == 1) && match missing {
    Cons { head, tail: Empty } => declaration_ref_eq(a: head, b: unknown)
    _ => false
  }
    && match emission_contribution_origins(contribution: contribution) {
      EmissionOriginsIncomplete { observed, missing: gaps } =>
        (observed |> count == 1) && declaration_ref_eq(a: gaps.head.producer, b: unknown)
      _ => false
    }
}
