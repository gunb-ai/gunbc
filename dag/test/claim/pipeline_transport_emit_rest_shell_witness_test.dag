  compile_dag_rust_emit_check(
    "module re4b\n\nservice test.Shell {\n  config {}\n  operation Check {\n    input { cmd: String }\n    output { success: Bool }\n    transport shell { argv: [\"sh\", \"-c\", \"\{cmd\}\"] }\n  }\n}\n",
