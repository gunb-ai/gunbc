module test.claim.pipeline_transport_emit_rest_shell_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Present, Absent }
import std.types { Bool, Int, String }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn w_rest_uses_transport_method() -> Bool {
  compile_dag_rust_emit_check(
    "module re1a\n\nservice test.Svc {\n  config {\n    endpoint: \"https://api.example.com\"\n  }\n  operation GetItems {\n    output { items: List<String> }\n    transport rest { method: GET, path: \"/items\" }\n    response {\n      200 => List<String>\n    }\n    mock_response {\n      200 => [\"a\"] \"items\"\n    }\n  }\n}\n",
    "src/re1a.rs",
    ["client.get("],
    []
  )
}

fn w_rest_substitutes_path_template() -> Bool {
  compile_dag_rust_emit_check(
    "module re1b\n\nservice test.Svc {\n  config {\n    endpoint: \"https://api.example.com\"\n  }\n  operation GetItem {\n    input { owner: String, repo: String }\n    output { name: String }\n    transport rest { method: GET, path: \"/repos/\{owner\}/\{repo\}\" }\n    response {\n      200 => String\n    }\n    mock_response {\n      200 => \"ok\" \"item\"\n    }\n  }\n}\n",
    "src/re1b.rs",
    ["format!(\"{}", "self.base_url"],
    []
  )
}

