  compile_dag_rust_emit_check(
    "module re4a\n\nservice test.Shell {\n  config {}\n  operation Probe {\n    input { cmd: String }\n    output { code: Int from \"exit_code\", ok: Bool from \"exit_success\" }\n    transport shell { argv: [\"sh\", \"-c\", \"\{cmd\}\"] }\n  }\n}\n",
    "src/re4a.rs",
    ["output.status.code().unwrap_or(-1) as i64", "output.status.success()"],
    ["stdout.clone()"]
  )
}

