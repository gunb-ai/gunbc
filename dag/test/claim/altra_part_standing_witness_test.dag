  AccessRefused,
  PatternOutstanding,
  SelectionNeverAttempted,
  TypeNamed,
  AuthorityUnresolved,
  JustificationOutstanding,
  ReferenceDesignPrecedent,
}
import extdeps.land_pattern.types {
  VendorPatternEstablished,
  VendorPatternNotEstablished,
}
import extdeps.memory.te_ddr4_dimm_socket { ddr4_dimm_socket_solder_tail_288 }
import extdeps.memory.microchip_at24cm02 { at24cm02 }
import extdeps.memory.macronix_mx25l25673g { mx25l25673g }
import extdeps.storage.amphenol_mdt420m01001 { mdt420m01001 }
import extdeps.connector.samtec_ftsh_105_01_l_dv { ftsh_105_01_l_dv }
import extdeps.ocp.mt_jade { ilm4926_designation }
import extdeps.cpu.ampere_altra_package { altra_package_body_designator }
import extdeps.power.ti_tps3808 { tps3808g01dbvr }
import extdeps.clock.ti_cdce913 { cdce913pwr }
import extdeps.network.ti_dp83867 { dp83867irrgz }
import extdeps.power.ti_tps53688 { tps53688rsbr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn standing_tag(r: BoardComponentRole) -> String {
  match obligation_standing_for(r: r) {
    Absent => "none"
    Present { value: s } =>
      match s {
        PatternOutstanding { standing: _ } => "pattern-outstanding"
        TypeNamed { type_name: _, because: _ } => "type-named"
        SelectionNeverAttempted { because: _ } => "never-attempted"
        AccessRefused { observed_on: _ } => "access-refused"
        AuthorityUnresolved { because: _ } => "unresolved"
      }
  }
}

test fn w_the_four_ti_roles_bind_the_cited_mountable_parts() -> Bool {
  match established_mountable_part(r: ResetController) {
    Absent => false
    Present { value: p } => (p.ordering_part_number as String) == (tps3808g01dbvr.ordering_part_number as String)
  }
    && match established_mountable_part(r: ClockGenerator) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (cdce913pwr.ordering_part_number as String)
    }
    && match established_mountable_part(r: NetworkEndpoint) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (dp83867irrgz.ordering_part_number as String)
    }
    && match established_mountable_part(r: PowerController) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (tps53688rsbr.ordering_part_number as String)
    }
}

test fn w_dimm_standing_is_the_vendor_pattern_standing() -> Bool {
  standing_tag(r: MemoryModuleSlot { channel: 0 }) == "pattern-outstanding"
    && standing_tag(r: MemoryModuleSlot { channel: 3 }) == "pattern-outstanding"
    && match dimm_socket_pattern_standing() {
      VendorPatternEstablished { pattern: _ } => false
      VendorPatternNotEstablished { what_is_missing: w } =>
        match ddr4_dimm_socket_solder_tail_288.board_pattern {
          VendorPatternEstablished { pattern: _ } => false
          VendorPatternNotEstablished { what_is_missing: expected } =>
            (w as String) == (expected as String)
        }
    }
}

test fn w_the_processor_socket_is_a_named_type_not_a_part() -> Bool {
  standing_tag(r: ProcessorSocket) == "type-named"
    && standing_tag(r: StorageEndpoint) == "pattern-outstanding"
    && standing_tag(r: ProcessorSocket) != standing_tag(r: StorageEndpoint)
    && match obligation_standing_for(r: ProcessorSocket) {
      Absent => false
      Present { value: s } =>
        match s {
          TypeNamed { type_name: n, because: b } =>
            (n as String) == (ilm4926_designation as String)
              && (n as String) != (altra_package_body_designator as String)
              && (b as String) == (processor_socket_type_named_because() as String)
          PatternOutstanding { standing: _ } => false
          SelectionNeverAttempted { because: _ } => false
          AccessRefused { observed_on: _ } => false
          AuthorityUnresolved { because: _ } => false
        }
    }
}

test fn w_the_four_unread_catalog_roles_are_pattern_outstanding() -> Bool {
  standing_tag(r: BootFirmwareEeprom) == "pattern-outstanding"
    && standing_tag(r: FirmwareFlash) == "pattern-outstanding"
    && standing_tag(r: StorageEndpoint) == "pattern-outstanding"
    && standing_tag(r: DebugConnector) == "pattern-outstanding"
    && match selected_catalog_part(r: BootFirmwareEeprom) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (at24cm02.ordering_part_number as String)
    }
    && match selected_catalog_part(r: FirmwareFlash) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (mx25l25673g.ordering_part_number as String)
    }
    && match selected_catalog_part(r: StorageEndpoint) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (mdt420m01001.ordering_part_number as String)
    }
    && match selected_catalog_part(r: DebugConnector) {
      Absent => false
      Present { value: p } => (p.ordering_part_number as String) == (ftsh_105_01_l_dv.ordering_part_number as String)
    }
}

test fn w_unread_catalog_standing_is_the_vendor_pattern_standing() -> Bool {
  match obligation_standing_for(r: StorageEndpoint) {
    Absent => false
    Present { value: s } =>
      match s {
        PatternOutstanding { standing: st } =>
          match st {
            VendorPatternEstablished { pattern: _ } => false
            VendorPatternNotEstablished { what_is_missing: w } =>
              match mdt420m01001.board_pattern {
                VendorPatternEstablished { pattern: _ } => false
                VendorPatternNotEstablished { what_is_missing: expected } =>
                  (w as String) == (expected as String)
              }
          }
        TypeNamed { type_name: _, because: _ } => false
        SelectionNeverAttempted { because: _ } => false
        AccessRefused { observed_on: _ } => false
        AuthorityUnresolved { because: _ } => false
      }
  }
}

test fn w_established_roles_have_no_obligation_standing() -> Bool {
  standing_tag(r: ProcessorPackage) == "none"
    && standing_tag(r: BoardControlCpld) == "none"
    && standing_tag(r: ResetController) == "none"
    && standing_tag(r: ClockGenerator) == "none"
    && standing_tag(r: NetworkEndpoint) == "none"
    && standing_tag(r: PowerController) == "none"
}

test fn w_document_attempts_are_keyed_on_documents_not_roles() -> Bool {
  let boot = receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: BootFirmwareEeprom)))
  let flash = receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: FirmwareFlash)))
  let debug = receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: DebugConnector)))
  let dimm = receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: MemoryModuleSlot { channel: 0 })))
  let storage = receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: StorageEndpoint)))
  boot == 2 && flash == 2 && debug == 3 && dimm == 2 && storage == 1
    && (boot + flash + debug + dimm + storage) == document_attempt_count()
    && document_attempt_count() == 10
}

test fn w_selected_part_documents_are_cited_by_declaration_not_locator() -> Bool {
  roster_cites_declaration(d: at24cm02_declaration)
    && roster_cites_declaration(d: mx25l25673g_declaration)
    && roster_cites_declaration(d: mdt420m01001_declaration)
    && roster_cites_declaration(d: ftsh_105_01_l_dv_declaration)
    && !roster_has_locator(loc: "www.amphenol-cs.com/product/mdt420m01001.html")
    && !roster_has_locator(loc: "ww1.microchip.com/downloads/aemDocuments/documents/MPD/ProductDocuments/DataSheets/AT24CM02-2-Mbit-I2C-Serial-EEPROM-DS20006197.pdf")
    && open_cited_attempt_count() == 4
}

test fn w_uncited_locators_remain_only_for_superseded_alternatives() -> Bool {
  roster_has_locator(loc: "www.digikey.com/htmldatasheets/production/473879/0/0/1/24aa02-5-e48-24aa02-5-e64.html")
    && roster_has_locator(loc: "www.winbond.com/resource-files/W25Q128JV%20RevH%2003102021%20Plus.pdf")
    && roster_has_locator(loc: "suddendocs.samtec.com/prints/ftsh-1xx-xx-xxx-dv-xx%20footprint.pdf")
    && roster_has_locator(loc: "suddendocs.samtec.com/prints/ftsh-1xx-xx-xx-dv-xx-mkt.pdf")
    && roster_has_locator(loc: "cdn.amphenol-cs.com/media/wysiwyg/files/documentation/datasheet/ssio/ssio_ddr4.pdf")
    && roster_has_locator(loc: "molex.com/content/dam/molex/molex-dot-com/products/automated/en-us/applicationspecificationspdf/787/78730/AS-78730-001-001.pdf")
}

test fn w_amphenol_and_molex_are_superseded_dimm_attempts() -> Bool {
  receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: MemoryModuleSlot { channel: 0 }))) == 2
    && fold(document_attempts_for_role_name(name: role_tag(r: MemoryModuleSlot { channel: 0 })), init: true, f: fn(acc, r) {
      acc
        && match r.disposition {
          AttemptOpen => false
          AttemptSuperseded { selected_instead: s } =>
            (s as String) == (te_ddr4_socket_selected_row as String)
        }
    })
}

test fn w_debug_connector_keeps_the_reconstructed_paths_distinct_from_the_sibling_print() -> Bool {
  let tags = fold(document_attempts_for_role_name(name: role_tag(r: DebugConnector)), init: [], f: fn(acc, r) {
    concat(acc, [observation_tag(o: r.observation) as String])
  })
  fold(tags, init: false, f: fn(acc, t) { acc || t == "sibling-document-observed" })
    && fold(tags, init: false, f: fn(acc, t) { acc || t == "url-unconfirmed-forbidden" })
    && standing_tag(r: DebugConnector) == "pattern-outstanding"
}

test fn w_boot_eeprom_documents_keep_distinct_observations() -> Bool {
  let tags = fold(document_attempts_for_role_name(name: role_tag(r: BootFirmwareEeprom)), init: [], f: fn(acc, r) {
    concat(acc, [observation_tag(o: r.observation) as String])
  })
  fold(tags, init: false, f: fn(acc, t) { acc || t == "vendor-extraction-failure" })
    && fold(tags, init: false, f: fn(acc, t) { acc || t == "gone" })
    && !fold(tags, init: false, f: fn(acc, t) { acc || t == "text-not-extractable" })
    && receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: BootFirmwareEeprom))) == 2
}

test fn w_the_selected_te_socket_document_is_not_duplicated_here() -> Bool {
  !roster_has_locator(loc: "www.te.com/commerce/DocumentDelivery/DDEController?Action=showdoc&DocId=Specification+Or+Standard%7F114-115012%7FA%7Fpdf%7FEnglish%7FENG_SS_114-115012_A.pdf%7F2308107-5")
    && match ddr4_dimm_socket_solder_tail_288.board_pattern {
      VendorPatternNotEstablished { what_is_missing: _ } => true
      VendorPatternEstablished { pattern: _ } => false
    }
}

test fn w_processor_socket_has_no_document_attempt() -> Bool {
  receipt_count(rs: document_attempts_for_role_name(name: role_tag(r: ProcessorSocket))) == 0
}

test fn w_firmware_flash_macronix_is_not_a_microchip_vendor_failure() -> Bool {
  fold(document_attempts_for_role_name(name: role_tag(r: FirmwareFlash)), init: true, f: fn(acc, r) {
    acc && (observation_tag(o: r.observation) as String) == "text-not-extractable"
  })
    && standing_tag(r: FirmwareFlash) == "pattern-outstanding"
    && standing_tag(r: BootFirmwareEeprom) == "pattern-outstanding"
}

test fn w_every_open_attempt_is_dated() -> Bool {
  fold(altra_parts_document_attempts, init: true, f: fn(acc, r) {
    acc && (r.observed_on as String) == (altra_parts_access_observed_on as String)
  })
}

test fn w_mutation_control_socket_type_named_must_not_share_the_storage_arm() -> Bool {
  standing_tag(r: ProcessorSocket) == "type-named"
    && standing_tag(r: StorageEndpoint) == "pattern-outstanding"
}

test fn w_only_the_processor_socket_carries_mt_jade_precedent() -> Bool {
  match justification_for(r: ProcessorSocket) {
    ReferenceDesignPrecedent { document: d, section: s } =>
      (d as String) == (mt_jade_spec_document as String)
        && (s as String) == "12 Mechanical"
    JustificationOutstanding { because: _ } => false
  }
    && match justification_for(r: ResetController) {
      JustificationOutstanding { because: _ } => true
      ReferenceDesignPrecedent { document: _, section: _ } => false
    }
    && match justification_for(r: MemoryModuleSlot { channel: 0 }) {
      JustificationOutstanding { because: _ } => true
      ReferenceDesignPrecedent { document: _, section: _ } => false
    }
    && match justification_for(r: StorageEndpoint) {
      JustificationOutstanding { because: _ } => true
      ReferenceDesignPrecedent { document: _, section: _ } => false
    }
    && match justification_for(r: BootFirmwareEeprom) {
      JustificationOutstanding { because: _ } => true
      ReferenceDesignPrecedent { document: _, section: _ } => false
    }
    && match justification_for(r: DebugConnector) {
      JustificationOutstanding { because: b } =>
        string_contains(s: b as String, pattern: "session candidate")
      ReferenceDesignPrecedent { document: _, section: _ } => false
    }
}

test fn w_mutation_control_open_cited_attempts_must_be_four() -> Bool {
  open_cited_attempt_count() == 4
    && receipt_count(rs: superseded_document_attempts()) == 6
}
