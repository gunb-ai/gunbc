module test.claim.stage0_emit_model_witness

import gunbc.stage0_emit_model {
  stage0_module_emit_basename,
  stage0_module_emit_filename,
  is_generated_stage0_file,
  generated_stage0_file_count
}

fn w_generated_roster_count() -> Bool {
  generated_stage0_file_count() == 90
}

fn w_hand_maintained_not_classified_generated() -> Bool {
  !is_generated_stage0_file(basename: "cli_run.rs") &&
  !is_generated_stage0_file(basename: "v1_interpreter.rs") &&
  !is_generated_stage0_file(basename: "main.rs")
}

fn w_emit_naming_rule() -> Bool {
  stage0_module_emit_basename(module_path: "v1.compiler.emit_rust") == "v1_compiler_emit_rust" &&
  stage0_module_emit_filename(module_path: "gunbc.stage0_emit_model") == "gunbc_stage0_emit_model.rs"
}

fn w_roster_module_not_yet_in_generated_set() -> Bool {
  !is_generated_stage0_file(basename: "gunbc_stage0_emit_model.rs")
}

test fn stage0_emit_model_witnesses() -> Bool {
  w_generated_roster_count() &&
  w_hand_maintained_not_classified_generated() &&
  w_emit_naming_rule() &&
  w_roster_module_not_yet_in_generated_set()
}
