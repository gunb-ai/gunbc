module test.claim.stage0_emit_model_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data stage0_emit_model_witness_note: String = "Authority: gunbc.stage0_emit_plan -> enrolled gunbc.stage0_emit_plan_generated projection. Positives catch missing derived basenames; negatives prove frontier-classified seed-retained files stay out. Regen's independent EmitResult agreement rejects both modeled-but-not-produced and produced-but-unmodeled paths."

test fn w_hand_maintained_not_classified_generated() -> Bool {
  !is_generated_stage0_file(basename: "cli_run.rs") &&
  !is_generated_stage0_file(basename: "v1_interpreter.rs") &&
  !is_generated_stage0_file(basename: "main.rs")
}

test fn w_occurrence_binding_identity_emit_enrolled_generated() -> Bool {
  is_generated_stage0_file(basename: "std_occurrence_identity.rs")
}

test fn w_generated_files_classified_generated() -> Bool {
  is_generated_stage0_file(basename: "std_execution_mode.rs") &&
  is_generated_stage0_file(basename: "v1_compiler_closure_stub_v2_std_integer_rust.rs") &&
  is_generated_stage0_file(basename: "v1_compiler_closure_stub_v2_std_text_rust.rs") &&
  is_generated_stage0_file(basename: "extdeps_units_dimensionless.rs") &&
  is_generated_stage0_file(basename: "extdeps_units_iec_80000_13.rs") &&
  is_generated_stage0_file(basename: "extdeps_units_iso8601.rs") &&
  is_generated_stage0_file(basename: "lib.rs") &&
  is_generated_stage0_file(basename: "std_algebra.rs") &&
  is_generated_stage0_file(basename: "std_keyed_row.rs") &&
  is_generated_stage0_file(basename: "std_keyed_roster.rs")
}

test fn w_enrolled_manifest_equals_typed_emission_plan_derivation() -> Bool {
  match generated_stage0_files_from_emission_plan() {
    GeneratedStage0FilesRefused { cause: _ } => false
    GeneratedStage0FilesAvailable { files } =>
      (files |> sort_by(file => file)) == (generated_stage0_files |> sort_by(file => file))
  }
}
test fn w_emit_naming_rule() -> Bool {
  stage0_module_emit_basename(module_path: "v1.compiler.emit_rust") == "v1_compiler_emit_rust" &&
  stage0_module_emit_filename(module_path: "gunbc.stage0_emit_model") == "gunbc_stage0_emit_model.rs"
}

fn fixture_source_identity(module_path: String, storage_path: String) -> gunbc.stage0_emit_plan.Stage0SourceModuleIdentity {
  gunbc.stage0_emit_plan.Stage0SourceModuleIdentity {
    module_path: module_path,
    storage_path: storage_path,
    source_tree: V1SourceTree,
    provenance: ParsedFromRegenSourceClosure
  }
}

data fixture_source_identities: List<gunbc.stage0_emit_plan.Stage0SourceModuleIdentity> = [
  fixture_source_identity(module_path: "std.algebra", storage_path: "src/v1/std/algebra.dag"),
  fixture_source_identity(module_path: "v1.compiler.emit_rust", storage_path: "src/v1/compiler/emit_rust.dag")
]

test fn w_source_supply_baseline_exact_agreement() -> Bool {
  match stage0_emission_plan_from_source(identities: fixture_source_identities) {
    Stage0EmissionPlanRefused { cause: _ } => false
    Stage0EmissionPlanAccepted { rows } => {
      let modeled = generated_stage0_files_from_plan_rows(rows: rows)
      stage0_generated_output_sets_agree(modeled: modeled, observed: modeled)
    }
  }
}

test fn w_source_supply_missing_identity_red_control() -> Bool {
  match stage0_emission_plan_from_source(identities: fixture_source_identities) {
    Stage0EmissionPlanRefused { cause: _ } => false
    Stage0EmissionPlanAccepted { rows: observed_rows } => match stage0_emission_plan_from_source(identities: [first(fixture_source_identities)]) {
      Stage0EmissionPlanRefused { cause: _ } => false
      Stage0EmissionPlanAccepted { rows: modeled_rows } => !stage0_generated_output_sets_agree(
        modeled: generated_stage0_files_from_plan_rows(rows: modeled_rows),
        observed: generated_stage0_files_from_plan_rows(rows: observed_rows)
      )
    }
  }
}

test fn w_source_supply_extra_identity_red_control() -> Bool {
  match stage0_emission_plan_from_source(identities: fixture_source_identities) {
    Stage0EmissionPlanRefused { cause: _ } => false
    Stage0EmissionPlanAccepted { rows: observed_rows } => match stage0_emission_plan_from_source(identities: concat(
      fixture_source_identities,
      [fixture_source_identity(module_path: "std.logic", storage_path: "src/v1/std/logic.dag")]
    )) {
      Stage0EmissionPlanRefused { cause: _ } => false
      Stage0EmissionPlanAccepted { rows: modeled_rows } => !stage0_generated_output_sets_agree(
        modeled: generated_stage0_files_from_plan_rows(rows: modeled_rows),
        observed: generated_stage0_files_from_plan_rows(rows: observed_rows)
      )
    }
  }
}

test fn w_output_path_collision_refuses_before_projection() -> Bool {
  match stage0_emission_plan_from_source(identities: [
    fixture_source_identity(module_path: "std.a_b", storage_path: "src/v1/std/a_b.dag"),
    fixture_source_identity(module_path: "std.a.b", storage_path: "src/v1/std/a/b.dag")
  ]) {
    Stage0EmissionPlanRefused { cause: Stage0OutputPathCollision { path, first_producer, duplicate_producer } } =>
      path == "src/v1/stage0/src/std_a_b.rs" && first_producer == "std.a_b" && duplicate_producer == "std.a.b"
    Stage0EmissionPlanAccepted { rows: _ } => false
    Stage0EmissionPlanRefused { cause: _ } => false
  }
}

test fn w_source_identity_unavailable_refuses_before_plan_rows() -> Bool {
  match stage0_emission_plan_from_source(identities: [
    gunbc.stage0_emit_plan.Stage0SourceModuleIdentity {
      module_path: "std.unavailable",
      storage_path: "src/v1/std/unavailable.dag",
      source_tree: V1SourceTree,
      provenance: SourceIdentityUnavailable
    }
  ]) {
    Stage0EmissionPlanRefused {
      cause: SourceIdentityUnavailableRefusal { module_path, storage_path }
    } => module_path == "std.unavailable" && storage_path == "src/v1/std/unavailable.dag"
    Stage0EmissionPlanAccepted { rows: _ } => false
  }
}

test fn w_absent_host_supply_cannot_generate_artifact_bytes() -> Bool {
  let outcome = stage0_emission_plan_from_supply(supply: gunbc.stage0_emit_plan.Stage0SourceIdentitySupplyUnavailable { cause: "synthetic absent host realization" })
  let plan_refuses = match outcome {
    Stage0EmissionPlanRefused { cause: SourceIdentitySupplyUnavailableRefusal { cause } } => length(cause) > 0
    _ => false
  }
  let generation_refuses = match stage0_emit_plan_generation_from_outcome(outcome: outcome) {
    Stage0EmitPlanGenerationRefused => true
    _ => false
  }
  plan_refuses && generation_refuses
}

test fn w_frontier_classifies_seed_retained_candidate() -> Bool {
  match stage0_emission_plan_from_source(identities: [
    fixture_source_identity(module_path: "v1.interpreter", storage_path: "src/v1/99_interpreter.dag")
  ]) {
    Stage0EmissionPlanRefused { cause: _ } => false
    Stage0EmissionPlanAccepted { rows } => rows |> any(row =>
      row.produced.basename == "v1_interpreter.rs"
        && match row.disposition { HandMaintainedCandidate => true  _ => false }
    )
  }
}
