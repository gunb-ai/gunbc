module test.claim.spark_provisioning_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Controlled fixtures. Every credential ref, environment standing and observation below is
// authored HERE, in the witness, so each count and verdict is grounded in an input this
// file states rather than in a measurement of the tree.
data fixture_project: GcpProjectId = "gunbai-secrets"

fn fixture_credentials() -> SparkProvisioningCredentials {
  spark_credentials(
    hotspot: spark_secret_ref(project: fixture_project, name: "fixture-hotspot"),
    administrator: spark_secret_ref(project: fixture_project, name: "fixture-administrator"),
  )
}

fn fixture_bootstrap() -> SparkFactoryBootstrap {
  SparkFactoryBootstrap {
    access_point_identity: spark_bootstrap_ssid_a3ee,
    credentials: fixture_credentials(),
    documented_surface: dgx_spark_oobe_surface,
  }
}

fn oobe_strategy() -> SparkProvisioningStrategy {
  FactoryOobe { bootstrap: fixture_bootstrap() }
}

fn pxe_strategy() -> SparkProvisioningStrategy {
  PxeAutoinstall {
    environment: "fixture-boot-network" as PxeEnvironmentIdentity,
    image: "fixture-base-os" as InstallationImageIdentity,
    install_spec: SparkAutoinstallSpec {
      parameters: DgxSparkPxeInstallParameters {
        unattended: true,
        user_interface_disabled: true,
        skip_firmware_update: false,
      }
    },
  }
}

fn fixture_intent() -> SparkProvisioningIntent {
  spark_provisioning_intent(
    host: srv5_reserved,
    credentials: fixture_credentials(),
    address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222),
    strategy: oobe_strategy(),
  )
}

fn environment(
  controller: BootstrapControllerStanding,
  credentials: BootstrapCredentialStanding,
  pxe: PxePrerequisiteStanding
) -> SparkProvisioningEnvironment {
  SparkProvisioningEnvironment { controller: controller, credentials: credentials, pxe: pxe }
}

fn outcome_tag(o: SparkProvisioningOutcome) -> String {
  match o {
    SparkProvisioned { receipt: _ } => "provisioned"
    SparkProvisioningInterrupted { phase: _, cause: _ } => "interrupted"
    SparkProvisioningHumanInterventionRequired { intervention: _ } => "human"
    SparkProvisioningRefused { phase: _, cause: _ } => "refused"
  }
}

fn classify_tag(progress: SparkProvisioningProgress) -> String {
  outcome_tag(o: classify_spark_progress(
    intent: fixture_intent(),
    phase: PhaseOperatorConfiguration,
    progress: progress
  ))
}

fn sample_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-witness-pending-human-step",
    frequency: DeviceOnce,
    subject: "witness fixture",
    instruction: "A step that has not been performed yet. It is not a refusal and it is not a pending transition."
  )
}

fn complete_observation() -> PostSetupObservation {
  PostSetupObservation {
    account: AccountObserved { name: "briansrls" },
    lan_reach: LanReachObserved {
      address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222)
    },
    setup_surface: SetupSurfaceCompleted,
    software: InitialUpdateAppliedDuringSetup,
  }
}

fn observation_missing_account() -> PostSetupObservation {
  PostSetupObservation {
    account: AccountNotObserved,
    lan_reach: LanReachObserved {
      address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222)
    },
    setup_surface: SetupSurfaceCompleted,
    software: InitialUpdateAppliedDuringSetup,
  }
}

fn observation_missing_software() -> PostSetupObservation {
  PostSetupObservation {
    account: AccountObserved { name: "briansrls" },
    lan_reach: LanReachObserved {
      address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 222)
    },
    setup_surface: SetupSurfaceCompleted,
    software: InitialUpdateBehaviorUnobserved,
  }
}

// THE LOAD-BEARING CLAIM OF THE WHOLE MODULE: completion cannot be manufactured from an
// intent. A fully-specified intent plus an incomplete observation is NOT provisioned, and
// the arm it lands on is interrupted rather than refused — nothing rejected anything.
// The receipt exists only on the far side of a complete observation.
test fn spark_completion_requires_observation_never_intent() -> Bool {
  let complete = classify_tag(progress: ProgressPostSetupObserved { observation: complete_observation() })
  let no_account = classify_tag(progress: ProgressPostSetupObserved { observation: observation_missing_account() })
  let no_software = classify_tag(progress: ProgressPostSetupObserved { observation: observation_missing_software() })

  complete == "provisioned"
    && no_account == "interrupted"
    && no_software == "interrupted"
    && no_account != "provisioned"
    && no_account != "refused"
    && no_software != "provisioned"
}

fn update_tag(d: InitialUpdateDisposition) -> String {
  match d {
    InitialUpdateAppliedDuringSetup => "applied"
    InitialUpdateDeferredToOperator => "deferred"
    InitialUpdateBehaviorUnobserved => "unobserved"
  }
}

// The receipt's software baseline is the DEVICE's, never the vendor documentation's. The
// documented row is Unobserved, so a receipt echoing it would be claiming an observation
// nobody made — here the observed value is Applied and the receipt carries Applied.
test fn spark_receipt_software_comes_from_the_device() -> Bool {
  let outcome = classify_spark_progress(
    intent: fixture_intent(),
    phase: PhasePostSetupAccess,
    progress: ProgressPostSetupObserved { observation: complete_observation() }
  )
  let documented = update_tag(d: dgx_spark_documented_initial_update)

  match outcome {
    SparkProvisioned { receipt: receipt } => {
      let observed = update_tag(d: receipt.initial_update)
      observed == "applied" && documented == "unobserved" && observed != documented
    }
    SparkProvisioningInterrupted { phase: _, cause: _ } => false
    SparkProvisioningHumanInterventionRequired { intervention: _ } => false
    SparkProvisioningRefused { phase: _, cause: _ } => false
  }
}

// The four outcome arms stay four.
test fn spark_outcome_arms_stay_distinct() -> Bool {
  let success = classify_tag(progress: ProgressPostSetupObserved { observation: complete_observation() })
  let reboot = classify_tag(progress: ProgressAwaitingDocumentedReboot)
  let prerequisite = classify_tag(progress: ProgressPrerequisiteNotYetReached { prerequisite: "network join" })
  let human = classify_tag(progress: ProgressAwaitingHuman { intervention: sample_intervention() })
  let rejected = classify_tag(progress: ProgressDeviceRejectedField { field: "username" })

  success == "provisioned"
    && reboot == "interrupted"
    && prerequisite == "interrupted"
    && human == "human"
    && rejected == "refused"
    && reboot != rejected
    && human != rejected
    && human != reboot
    && human != success
}

fn burden_tag(d: HumanBurdenDerivation) -> String {
  match d {
    BurdenDerived { burden: _ } => "derived"
    BurdenUndecidable { cause: _ } => "undecidable"
  }
}

fn burden_count_at(d: HumanBurdenDerivation, frequency: HumanInterventionFrequency) -> Int {
  match d {
    BurdenDerived { burden: burden } =>
      human_intervention_count_at(burden: burden, frequency: frequency)
    BurdenUndecidable { cause: _ } => 0 - 1
  }
}

// THE WORLD AS IT ACTUALLY IS TODAY: no controller established, no Secret Manager path in
// any workflow, no PXE observation. Every lane is undecidable, and the module asserts NO
// human-step count for the factory lane — a number here would be theater, since the thing
// that determines it does not exist yet.
test fn spark_current_environment_is_undecidable_not_counted() -> Bool {
  let factory = spark_strategy_human_burden(strategy: oobe_strategy(), env: spark_current_environment)
  let pxe = spark_strategy_human_burden(strategy: pxe_strategy(), env: spark_current_environment)

  burden_tag(d: factory) == "undecidable"
    && burden_tag(d: pxe) == "undecidable"
    && selection_tag(env: spark_current_environment) == "undecidable"
}

// Wi-Fi association is a MACHINE capability, so the human OOBE burden is a function of the
// controller, not of the strategy. Ready controller with materialized credentials => ZERO
// human actions. Absent controller => the manual portal step appears, and it is
// EveryProvision because a person repeats it for every provision the controller cannot do.
test fn spark_factory_human_burden_derives_from_controller() -> Bool {
  let ready = factory_oobe_human_burden(env: environment(
    controller: BootstrapControllerReady,
    credentials: BootstrapCredentialsMaterialized,
    pxe: PxePrerequisitesUnknown
  ))
  let unbound = factory_oobe_human_burden(env: environment(
    controller: BootstrapControllerReady,
    credentials: BootstrapCredentialsNotMaterialized,
    pxe: PxePrerequisitesUnknown
  ))
  let absent = factory_oobe_human_burden(env: environment(
    controller: BootstrapControllerAbsent,
    credentials: BootstrapCredentialsMaterialized,
    pxe: PxePrerequisitesUnknown
  ))

  burden_count_at(d: ready, frequency: EveryProvision) == 0
    && burden_count_at(d: ready, frequency: DeviceOnce) == 0
    && burden_count_at(d: ready, frequency: FleetOnce) == 0
    && burden_count_at(d: unbound, frequency: DeviceOnce) == 1
    && burden_count_at(d: unbound, frequency: EveryProvision) == 0
    && burden_count_at(d: absent, frequency: EveryProvision) == 1
}

// RED control for the derivation: the SAME strategy value produces different burdens under
// different environments. A burden authored as a property of the strategy could not do
// this, so the two readings provably disagree.
test fn spark_burden_is_not_a_property_of_the_strategy_red_control() -> Bool {
  let ready = factory_oobe_human_burden(env: environment(
    controller: BootstrapControllerReady,
    credentials: BootstrapCredentialsMaterialized,
    pxe: PxePrerequisitesUnknown
  ))
  let absent = factory_oobe_human_burden(env: environment(
    controller: BootstrapControllerAbsent,
    credentials: BootstrapCredentialsMaterialized,
    pxe: PxePrerequisitesUnknown
  ))
  let ready_count = burden_count_at(d: ready, frequency: EveryProvision)
  let absent_count = burden_count_at(d: absent, frequency: EveryProvision)

  ready_count != absent_count
}

fn selection_tag(env: SparkProvisioningEnvironment) -> String {
  match select_spark_strategy(a: oobe_strategy(), b: pxe_strategy(), env: env) {
    StrategySelectionUndecidable { cause: _ } => "undecidable"
    StrategySelected { strategy: strategy } => match strategy {
      FactoryOobe { bootstrap: _ } => "oobe"
      PxeAutoinstall { environment: _, image: _, install_spec: _ } => "pxe"
    }
  }
}

// Selection consumes the environment: with a ready controller and materialized credentials
// the factory lane costs zero routine human actions and wins, while under an absent
// controller the manual EveryProvision step makes ready-PXE the cheaper routine lane.
// Static costs could not produce both answers from the same two strategy values.
test fn spark_strategy_selection_consumes_the_environment() -> Bool {
  let favors_oobe = environment(
    controller: BootstrapControllerReady,
    credentials: BootstrapCredentialsMaterialized,
    pxe: PxePrerequisitesAbsent
  )
  let favors_pxe = environment(
    controller: BootstrapControllerAbsent,
    credentials: BootstrapCredentialsMaterialized,
    pxe: PxePrerequisitesReady
  )

  selection_tag(env: favors_oobe) == "oobe"
    && selection_tag(env: favors_pxe) == "pxe"
    && selection_tag(env: favors_oobe) != selection_tag(env: favors_pxe)
}

// BreakGlassOnly is never priced as routine: the ready-PXE burden carries exactly one
// intervention and it is the emergency one, so all three routine counts are zero.
test fn spark_break_glass_is_not_priced_as_routine() -> Bool {
  let pxe_ready = pxe_autoinstall_human_burden(env: environment(
    controller: BootstrapControllerUnknown,
    credentials: BootstrapCredentialStandingUnknown,
    pxe: PxePrerequisitesReady
  ))

  burden_count_at(d: pxe_ready, frequency: BreakGlassOnly) == 1
    && burden_count_at(d: pxe_ready, frequency: EveryProvision) == 0
    && burden_count_at(d: pxe_ready, frequency: DeviceOnce) == 0
    && burden_count_at(d: pxe_ready, frequency: FleetOnce) == 0
}

// Credentials are carried refs rather than names rebuilt from a rendered host identity,
// the two refs are independent, and the intent carries no hostname at all.
test fn spark_credentials_are_carried_never_derived() -> Bool {
  let intent = fixture_intent()

  intent.credentials.hotspot_password.secret == "fixture-hotspot"
    && intent.credentials.administrator_password.secret == "fixture-administrator"
    && intent.credentials.hotspot_password.secret != intent.credentials.administrator_password.secret
    && intent.host == srv5_reserved
    && intent.timezone == "America/New_York"
    && intent.administrator.name == "briansrls"
    && intent.license.accepted_by == intent.administrator.name
}

// The SSIDs are established nonsecret display aliases, and they are NOT fleet identity:
// the two units' aliases differ from each other and from the host identity beside them.
test fn spark_bootstrap_ssids_are_established_aliases() -> Bool {
  spark_bootstrap_ssid_a3ee.ssid == "spark-a3ee"
    && spark_bootstrap_ssid_3bd5.ssid == "spark-3bd5"
    && spark_bootstrap_ssid_a3ee.ssid != spark_bootstrap_ssid_3bd5.ssid
    && (spark_bootstrap_ssid_a3ee.ssid as String) != (srv5_reserved as String)
}

fn completion_evidence_tag(e: InterventionCompletionEvidence) -> String {
  match e {
    DischargedAt { evidence: _ } => "discharged-at"
    NoDischargeSiteModeled => "no-discharge-site"
  }
}

// No per-intervention discharge site exists in the repository today, and every intervention
// says so rather than citing a shared placeholder.
test fn spark_interventions_declare_no_discharge_site() -> Bool {
  completion_evidence_tag(e: spark_manual_oobe_intervention().completion_evidence) == "no-discharge-site"
    && completion_evidence_tag(e: spark_credential_materialization_intervention().completion_evidence) == "no-discharge-site"
    && completion_evidence_tag(e: spark_pxe_firmware_intervention().completion_evidence) == "no-discharge-site"
    && completion_evidence_tag(e: spark_pxe_recovery_intervention().completion_evidence) == "no-discharge-site"
}

data clean_sensitive_run: SensitiveRunObservation = SensitiveRunObservation {
  secret_present_in_argv: false,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: false,
}

data leaking_sensitive_run: SensitiveRunObservation = SensitiveRunObservation {
  secret_present_in_argv: false,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: true,
}

data argv_leaking_run: SensitiveRunObservation = SensitiveRunObservation {
  secret_present_in_argv: true,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: false,
}

fn sensitive_use() -> SensitiveBrowserInputUse {
  SensitiveBrowserInputUse {
    secret_ref: spark_secret_ref(project: fixture_project, name: "fixture-hotspot"),
    field_identity: "captive-portal-wifi-password" as SensitiveFieldIdentity,
    evidence_policy: RetainNoDomNoHarNoTrace { retain_transition_result_only: true },
  }
}

fn admission_tag(obs: SensitiveRunObservation) -> String {
  match admit_sensitive_browser_input(use: sensitive_use(), observation: obs) {
    SensitiveInputAdmitted { use: _ } => "admitted"
    SensitiveInputRefused { cause: _, evidence_disposition: d } =>
      match d { EvidenceBundleDestroyed => "refused-destroyed"  EvidenceBundleRetained => "refused-retained" }
  }
}

// Positive control plus two discriminating REDs: a corpus scan that finds the credential
// must refuse AND destroy the bundle, while a secret that reached argv refuses without a
// bundle to destroy.
test fn spark_sensitive_browser_input_admission() -> Bool {
  admission_tag(obs: clean_sensitive_run) == "admitted"
    && admission_tag(obs: leaking_sensitive_run) == "refused-destroyed"
    && admission_tag(obs: argv_leaking_run) == "refused-retained"
}

// The cited OOBE field list has a real consumer: every configuration subject the intent
// carries is one the wizard actually offers.
test fn spark_cited_setup_surface_holds() -> Bool {
  spark_oobe_covers_intent_subjects()
    && update_tag(d: dgx_spark_documented_initial_update) == "unobserved"
    && post_setup_route_requires_existing_account(route: PostSetupSsh)
    && post_setup_route_requires_existing_account(route: PostSetupNvidiaSync)
}

// The PXE parameter tokens are the cited ones, and the three switches are independent.
test fn spark_pxe_parameter_tokens_are_independent() -> Bool {
  join(dgx_spark_pxe_parameter_tokens(params: DgxSparkPxeInstallParameters {
    unattended: true, user_interface_disabled: true, skip_firmware_update: false
  }), " ") == "autoinstall noui"
    && join(dgx_spark_pxe_parameter_tokens(params: DgxSparkPxeInstallParameters {
         unattended: true, user_interface_disabled: false, skip_firmware_update: true
       }), " ") == "autoinstall usb.skipfw"
    && join(dgx_spark_pxe_parameter_tokens(params: DgxSparkPxeInstallParameters {
         unattended: false, user_interface_disabled: false, skip_firmware_update: false
       }), " ") == ""
}
