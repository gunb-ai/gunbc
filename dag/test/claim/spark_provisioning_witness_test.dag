module test.claim.spark_provisioning_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data pxe_strategy: SparkProvisioningStrategy = PxeAutoinstall {
  environment: "gunbc-lan-boot" as PxeEnvironmentIdentity,
  image: "dgx-base-os-7.0.0" as InstallationImageIdentity,
  install_spec: SparkAutoinstallSpec {
    parameters: DgxSparkPxeInstallParameters {
      unattended: true,
      user_interface_disabled: true,
      skip_firmware_update: false,
    }
  },
}

data oobe_strategy: SparkProvisioningStrategy = srv5_spark_intent.strategy

fn outcome_tag(o: SparkProvisioningOutcome) -> String {
  match o {
    SparkProvisioned { receipt: _ } => "provisioned"
    SparkProvisioningInterrupted { phase: _, cause: _ } => "interrupted"
    SparkProvisioningHumanInterventionRequired { intervention: _ } => "human"
    SparkProvisioningRefused { phase: _, cause: _ } => "refused"
  }
}

fn classify_tag(progress: SparkProvisioningProgress) -> String {
  outcome_tag(o: classify_spark_progress(
    intent: srv5_spark_intent,
    phase: PhaseOperatorConfiguration,
    progress: progress
  ))
}

fn residue_count(strategy: SparkProvisioningStrategy) -> Int {
  match spark_hostname_residue(strategy: strategy) {
    Present { value: _ } => 1
    Absent => 0
  }
}

// The load-bearing claim: the four outcome arms are genuinely distinct, and specifically
// that the three non-success arms do not collapse into each other. A documented reboot, an
// unreached prerequisite, an unperformed human step and a rejected field must land on three
// different tags — if any pair collapsed, two of these equalities would fail.
test fn spark_outcome_arms_stay_distinct() -> Bool {
  let success = classify_tag(progress: ProgressReachedPostSetupAccess)
  let reboot = classify_tag(progress: ProgressAwaitingDocumentedReboot)
  let prerequisite = classify_tag(progress: ProgressPrerequisiteNotYetReached { prerequisite: "network join" })
  let human = classify_tag(progress: ProgressAwaitingHuman { intervention: sample_intervention() })
  let rejected = classify_tag(progress: ProgressDeviceRejectedField { field: "username" })

  success == "provisioned"
    && reboot == "interrupted"
    && prerequisite == "interrupted"
    && human == "human"
    && rejected == "refused"
    && reboot != rejected
    && human != rejected
    && human != reboot
    && human != success
}

fn sample_intervention() -> HumanIntervention {
  spark_intervention(
    identity: "spark-witness-pending-human-step",
    frequency: DeviceOnce,
    subject: "witness fixture",
    instruction: "A step that has not been performed yet. It is not a refusal and it is not a pending transition."
  )
}

// Frequency is the axis, and the counts are DERIVED from the lists. A stored count would
// pass this by being edited; these numbers can only move by adding or removing an
// intervention.
test fn spark_human_burden_is_frequency_classified() -> Bool {
  let oobe = factory_oobe_human_burden()
  let pxe = pxe_autoinstall_human_burden()

  human_intervention_count_at(burden: oobe, frequency: EveryProvision) == 0
    && human_intervention_count_at(burden: oobe, frequency: DeviceOnce) == 2
    && human_intervention_count_at(burden: oobe, frequency: FleetOnce) == 0
    && human_intervention_count_at(burden: oobe, frequency: BreakGlassOnly) == 0
    && human_intervention_count_at(burden: pxe, frequency: EveryProvision) == 0
    && human_intervention_count_at(burden: pxe, frequency: DeviceOnce) == 1
    && human_intervention_count_at(burden: pxe, frequency: FleetOnce) == 1
    && human_intervention_count_at(burden: pxe, frequency: BreakGlassOnly) == 1
}

// Selection is lexicographic and BreakGlassOnly is not priced. PXE wins on DeviceOnce
// (1 < 2) despite carrying MORE total interventions than OOBE (3 vs 2) — which is exactly
// the discrimination a scalar burden could not make, and the RED below proves the scalar
// reading would have chosen the other way.
test fn spark_strategy_selection_is_lexicographic_not_total() -> Bool {
  let oobe = factory_oobe_human_burden()
  let pxe = pxe_autoinstall_human_burden()

  list_length(items: pxe.interventions) > list_length(items: oobe.interventions)
    && match compare_routine_human_burden(a: pxe, b: oobe) { Less => true  Equal => false  Greater => false }
    && match compare_routine_human_burden(a: oobe, b: pxe) { Less => false  Equal => false  Greater => true }
    && strategy_tag(s: select_spark_strategy(a: oobe_strategy, b: pxe_strategy)) == "pxe"
    && strategy_tag(s: select_spark_strategy(a: pxe_strategy, b: oobe_strategy)) == "pxe"
}

fn strategy_tag(s: SparkProvisioningStrategy) -> String {
  match s {
    FactoryOobe { bootstrap: _ } => "oobe"
    PxeAutoinstall { environment: _, image: _, install_spec: _ } => "pxe"
  }
}

// RED control for the selection claim: a burden compared by TOTAL count would rank OOBE
// (2 interventions) ahead of PXE (3), the opposite of the lexicographic verdict above.
// This test asserts the disagreement, so if the frequency axis were ever collapsed into a
// scalar the two tests could not both hold.
test fn spark_scalar_burden_would_choose_differently_red_control() -> Bool {
  let oobe = factory_oobe_human_burden()
  let pxe = pxe_autoinstall_human_burden()
  let scalar_prefers_oobe = list_length(items: oobe.interventions) < list_length(items: pxe.interventions)
  let lexicographic_prefers_pxe =
    match compare_routine_human_burden(a: pxe, b: oobe) { Less => true  Equal => false  Greater => false }

  scalar_prefers_oobe && lexicographic_prefers_pxe
}

// The bootstrap credential is a reference, never a value, and the admin secret name is
// derived per device rather than authored.
test fn spark_bootstrap_credential_is_a_reference() -> Bool {
  srv5_spark_bootstrap.access_point_identity.ssid == "spark-srv5-setup"
    && srv5_spark_bootstrap.access_point_password_ref.secret == "spark-srv5-bootstrap-hotspot-password"
    && srv5_spark_bootstrap.access_point_password_ref.version == "latest"
    && spark_admin_password_secret_name(host: "srv5") == "spark-srv5-admin-password"
    && spark_admin_password_secret_name(host: "srv6") == "spark-srv6-admin-password"
}

data clean_sensitive_run: SensitiveRunObservation = SensitiveRunObservation {
  secret_present_in_argv: false,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: false,
}

data leaking_sensitive_run: SensitiveRunObservation = SensitiveRunObservation {
  secret_present_in_argv: false,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: true,
}

data argv_leaking_run: SensitiveRunObservation = SensitiveRunObservation {
  secret_present_in_argv: true,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: false,
}

data sensitive_use: SensitiveBrowserInputUse = SensitiveBrowserInputUse {
  secret_ref: spark_secret_ref(name: "spark-srv5-bootstrap-hotspot-password"),
  field_identity: "captive-portal-wifi-password" as SensitiveFieldIdentity,
  evidence_policy: RetainNoDomNoHarNoTrace { retain_transition_result_only: true },
}

fn admission_tag(obs: SensitiveRunObservation) -> String {
  match admit_sensitive_browser_input(use: sensitive_use, observation: obs) {
    SensitiveInputAdmitted { use: _ } => "admitted"
    SensitiveInputRefused { cause: _, evidence_disposition: d } =>
      match d { EvidenceBundleDestroyed => "refused-destroyed"  EvidenceBundleRetained => "refused-retained" }
  }
}

// Positive control plus two discriminating REDs: a corpus scan that finds the credential
// must refuse AND destroy the bundle, while a secret that reached argv refuses without a
// bundle to destroy. A single boolean verdict could not tell those apart.
test fn spark_sensitive_browser_input_admission() -> Bool {
  admission_tag(obs: clean_sensitive_run) == "admitted"
    && admission_tag(obs: leaking_sensitive_run) == "refused-destroyed"
    && admission_tag(obs: argv_leaking_run) == "refused-retained"
}

// The cited surface says what it says. The initial-update disposition is Unobserved, not
// applied and not deferred; OOBE offers no hostname, so FactoryOobe carries a residue and
// PxeAutoinstall does not; and every documented post-setup route presupposes the account
// provisioning creates, so none of them can be the provisioning authority.
test fn spark_cited_setup_surface_holds() -> Bool {
  update_tag(d: dgx_spark_documented_initial_update) == "unobserved"
    && update_tag(d: InitialUpdateAppliedDuringSetup) != update_tag(d: dgx_spark_documented_initial_update)
    && update_tag(d: InitialUpdateDeferredToOperator) != update_tag(d: dgx_spark_documented_initial_update)
    && dgx_spark_oobe_offers_field(field: OobeHostnameAssignment) == false
    && residue_count(strategy: oobe_strategy) == 1
    && residue_count(strategy: pxe_strategy) == 0
    && post_setup_route_requires_existing_account(route: PostSetupSsh)
    && post_setup_route_requires_existing_account(route: PostSetupNvidiaSync)
}

fn update_tag(d: InitialUpdateDisposition) -> String {
  match d {
    InitialUpdateAppliedDuringSetup => "applied"
    InitialUpdateDeferredToOperator => "deferred"
    InitialUpdateBehaviorUnobserved => "unobserved"
  }
}

// The PXE parameter tokens are the cited ones, and the three switches are independent:
// asking for noui without skipping firmware is expressible.
test fn spark_pxe_parameter_tokens_are_independent() -> Bool {
  join(dgx_spark_pxe_parameter_tokens(params: DgxSparkPxeInstallParameters {
    unattended: true, user_interface_disabled: true, skip_firmware_update: false
  }), " ") == "autoinstall noui"
    && join(dgx_spark_pxe_parameter_tokens(params: DgxSparkPxeInstallParameters {
         unattended: true, user_interface_disabled: false, skip_firmware_update: true
       }), " ") == "autoinstall usb.skipfw"
    && join(dgx_spark_pxe_parameter_tokens(params: DgxSparkPxeInstallParameters {
         unattended: false, user_interface_disabled: false, skip_firmware_update: false
       }), " ") == ""
}

// The two reserved units carry distinct LAN placements and derive one administrator from
// the existing fleet operator principal rather than minting a second one.
test fn spark_intents_are_grounded() -> Bool {
  render_ipv4_address(addr: srv5_spark_intent.network.address) == "192.168.1.222"
    && render_ipv4_address(addr: srv6_spark_intent.network.address) == "192.168.1.223"
    && srv5_spark_intent.administrator.name == "briansrls"
    && srv5_spark_intent.administrator.uid == 1000
    && srv6_spark_intent.administrator.uid == 1000
    && srv5_spark_intent.desired_hostname == "srv5"
}
