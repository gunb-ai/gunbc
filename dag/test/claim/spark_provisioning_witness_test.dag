module test.claim.spark_provisioning_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// Controlled fixtures. Every credential ref, environment standing and observation below is
// authored HERE, in the witness, so each count and verdict is grounded in an input this
// file states rather than in a measurement of the tree.
data fixture_project: extdeps.cloud.gcp.gcp.GcpProjectId = "gunbai-secrets"

// A fixture host identity authored HERE rather than imported. This lane needs no fleet
// identity authority: nothing in gunbc.spark.provisioning binds one, and importing another
// module's private rows to fill a witness would have coupled this branch to whichever lane
// happens to own those rows this week.
data fixture_host: product.placement_supply.HostIdentity = "fixture-spark-unit"

// Stands in for a SECRET-MATERIALIZE-0 producer receipt, which does not exist yet. The
// witness authors it so the materialized path is exercised; nothing in the production tree
// can construct this arm today.
fn fixture_materialized(name: std.types.NonEmptyStr) -> gunbc.spark_bootstrap_credential.SparkCredentialStanding {
  gunbc.spark_bootstrap_credential.CredentialMaterialized { ref: spark_secret_ref(project: fixture_project, name: name) }
}

fn fixture_credentials() -> gunbc.spark_bootstrap_credential.SparkProvisioningCredentials {
  spark_credentials(
    hotspot: fixture_materialized(name: "fixture-hotspot"),
    administrator: fixture_materialized(name: "fixture-administrator"),
  )
}

fn fixture_pending_credentials() -> gunbc.spark_bootstrap_credential.SparkProvisioningCredentials {
  spark_credentials(
    hotspot: fixture_materialized(name: "fixture-hotspot"),
    administrator: gunbc.spark.bootstrap_credential.CredentialMaterializationPending,
  )
}

fn fixture_bootstrap() -> gunbc.spark_bootstrap_credential.SparkFactoryBootstrap {
  gunbc.spark_bootstrap_credential.SparkFactoryBootstrap {
    access_point_identity: spark_bootstrap_ssid_a3ee,
    documented_surface: dgx_spark_oobe_surface,
  }
}

fn oobe_strategy() -> gunbc.spark_provisioning.SparkProvisioningStrategy {
  gunbc.spark_provisioning.FactoryOobe { bootstrap: fixture_bootstrap() }
}

fn pxe_strategy() -> gunbc.spark_provisioning.SparkProvisioningStrategy {
  gunbc.spark_provisioning.PxeAutoinstall {
    environment: "fixture-boot-network" as gunbc.spark_provisioning.PxeEnvironmentIdentity,
    image: "fixture-base-os" as gunbc.spark_provisioning.InstallationImageIdentity,
    install_spec: gunbc.spark_provisioning.SparkAutoinstallSpec {
      parameters: extdeps.systems.nvidia_dgx_spark_setup.DgxSparkPxeInstallParameters {
        unattended: true,
        user_interface_disabled: true,
        skip_firmware_update: false,
      }
    },
  }
}

// RFC 5737 TEST-NET-1, and it stays synthetic even though the real allocation is now decided
// (srv5 = .222, srv6 = .223, on #7952's authority row). A fixture that happened to match the
// live allocation would be indistinguishable from one asserting it, so the next reader could
// not tell whether this file DEPENDS on the mapping — and nothing here does. A
// documentation-range address cannot be mistaken for a claim about the fleet.
fn fixture_address() -> extdeps.network.ipv4.Ipv4Address {
  ipv4_address(octet1: 192, octet2: 0, octet3: 2, octet4: 10)
}

fn fixture_intent() -> gunbc.spark_provisioning.SparkProvisioningIntent {
  spark_provisioning_intent(
    host: test.claim.spark_provisioning_witness.fixture_host,
    credentials: fixture_credentials(),
    address: fixture_address(),
    strategy: oobe_strategy(),
  )
}

fn environment(
  controller: gunbc.spark_provisioning.BootstrapControllerStanding,
  pxe: gunbc.spark_provisioning.PxePrerequisiteStanding
) -> gunbc.spark_provisioning.SparkProvisioningEnvironment {
  gunbc.spark_provisioning.SparkProvisioningEnvironment { controller: controller, pxe: pxe }
}

fn outcome_tag(o: gunbc.spark_provisioning.SparkProvisioningOutcome) -> String {
  match o {
    SparkProvisioned { receipt: _ } => "provisioned"
    SparkProvisioningInterrupted { phase: _, cause: _ } => "interrupted"
    SparkProvisioningHumanInterventionRequired { intervention: _ } => "human"
    SparkProvisioningRefused { phase: _, cause: _ } => "refused"
  }
}

fn classify_tag(progress: gunbc.spark_provisioning.SparkProvisioningProgress) -> String {
  test.claim.spark_provisioning_witness.outcome_tag(o: classify_spark_progress(
    intent: fixture_intent(),
    phase: gunbc.spark.provisioning.PhaseOperatorConfiguration,
    progress: progress
  ))
}

fn sample_intervention() -> std.human_intervention.HumanIntervention {
  spark_intervention(
    identity: "spark-witness-pending-human-step",
    frequency: std.human_intervention.DeviceOnce,
    subject: "witness fixture",
    instruction: "A step that has not been performed yet. It is not a refusal and it is not a pending transition."
  )
}

fn complete_observation() -> gunbc.spark_provisioning.PostSetupObservation {
  gunbc.spark_provisioning.PostSetupObservation {
    account: gunbc.spark_provisioning.AccountObserved { name: "briansrls" },
    lan_reach: gunbc.spark_provisioning.LanReachObserved {
      address: fixture_address()
    },
    setup_surface: gunbc.spark.provisioning.SetupSurfaceCompleted,
    software: extdeps.systems.nvidia_dgx_spark_setup.InitialUpdateAppliedDuringSetup,
  }
}

fn observation_missing_account() -> gunbc.spark_provisioning.PostSetupObservation {
  gunbc.spark_provisioning.PostSetupObservation {
    account: gunbc.spark.provisioning.AccountNotObserved,
    lan_reach: gunbc.spark_provisioning.LanReachObserved {
      address: fixture_address()
    },
    setup_surface: gunbc.spark.provisioning.SetupSurfaceCompleted,
    software: extdeps.systems.nvidia_dgx_spark_setup.InitialUpdateAppliedDuringSetup,
  }
}

fn observation_missing_software() -> gunbc.spark_provisioning.PostSetupObservation {
  gunbc.spark_provisioning.PostSetupObservation {
    account: gunbc.spark_provisioning.AccountObserved { name: "briansrls" },
    lan_reach: gunbc.spark_provisioning.LanReachObserved {
      address: fixture_address()
    },
    setup_surface: gunbc.spark.provisioning.SetupSurfaceCompleted,
    software: extdeps.systems.nvidia_dgx_spark_setup.InitialUpdateBehaviorUnobserved,
  }
}

// THE LOAD-BEARING CLAIM OF THE WHOLE MODULE: completion cannot be manufactured from an
// intent. A fully-specified intent plus an incomplete observation is NOT provisioned, and
// the arm it lands on is interrupted rather than refused — nothing rejected anything.
// The receipt exists only on the far side of a complete observation.
test fn spark_completion_requires_observation_never_intent() -> Bool {
  let complete = classify_tag(progress: gunbc.spark_provisioning.ProgressPostSetupObserved { observation: complete_observation() })
  let no_account = classify_tag(progress: gunbc.spark_provisioning.ProgressPostSetupObserved { observation: observation_missing_account() })
  let no_software = classify_tag(progress: gunbc.spark_provisioning.ProgressPostSetupObserved { observation: observation_missing_software() })

  complete == "provisioned"
    && no_account == "interrupted"
    && no_software == "interrupted"
    && no_account != "provisioned"
    && no_account != "refused"
    && no_software != "provisioned"
}

fn update_tag(d: extdeps.systems.nvidia_dgx_spark_setup.InitialUpdateDisposition) -> String {
  match d {
    InitialUpdateAppliedDuringSetup => "applied"
    InitialUpdateDeferredToOperator => "deferred"
    InitialUpdateBehaviorUnobserved => "unobserved"
  }
}

// The receipt's software baseline is the DEVICE's, never the vendor documentation's. The
// documented row is Unobserved, so a receipt echoing it would be claiming an observation
// nobody made — here the observed value is Applied and the receipt carries Applied.
test fn spark_receipt_software_comes_from_the_device() -> Bool {
  let outcome = classify_spark_progress(
    intent: fixture_intent(),
    phase: gunbc.spark.provisioning.PhasePostSetupAccess,
    progress: gunbc.spark_provisioning.ProgressPostSetupObserved { observation: complete_observation() }
  )
  let documented = update_tag(d: dgx_spark_documented_initial_update)

  match outcome {
    SparkProvisioned { receipt: receipt } => {
      let observed = update_tag(d: receipt.initial_update)
      observed == "applied" && documented == "unobserved" && observed != documented
    }
    SparkProvisioningInterrupted { phase: _, cause: _ } => false
    SparkProvisioningHumanInterventionRequired { intervention: _ } => false
    SparkProvisioningRefused { phase: _, cause: _ } => false
  }
}

// The four outcome arms stay four.
test fn spark_outcome_arms_stay_distinct() -> Bool {
  let success = classify_tag(progress: gunbc.spark_provisioning.ProgressPostSetupObserved { observation: complete_observation() })
  let reboot = classify_tag(progress: gunbc.spark.provisioning.ProgressAwaitingDocumentedReboot)
  let prerequisite = classify_tag(progress: gunbc.spark_provisioning.ProgressPrerequisiteNotYetReached { prerequisite: "network join" })
  let human = classify_tag(progress: ProgressAwaitingHuman { intervention: sample_intervention() })
  let rejected = classify_tag(progress: gunbc.spark_provisioning.ProgressDeviceRejectedField { field: "username" })

  success == "provisioned"
    && reboot == "interrupted"
    && prerequisite == "interrupted"
    && human == "human"
    && rejected == "refused"
    && reboot != rejected
    && human != rejected
    && human != reboot
    && human != success
}

fn burden_tag(d: gunbc.spark_provisioning.HumanBurdenDerivation) -> String {
  match d {
    BurdenDerived { burden: _ } => "derived"
    BurdenUndecidable { cause: _ } => "undecidable"
  }
}

fn burden_count_at(d: gunbc.spark_provisioning.HumanBurdenDerivation, frequency: std.human_intervention.HumanInterventionFrequency) -> Int {
  match d {
    BurdenDerived { burden: burden } =>
      human_intervention_count_at(burden: burden, frequency: frequency)
    BurdenUndecidable { cause: _ } => 0 - 1
  }
}

// THE WORLD AS IT ACTUALLY IS TODAY: no controller established, no Secret Manager path in
// any workflow, no PXE observation. Every lane is undecidable, and the module asserts NO
// human-step count for the factory lane — a number here would be theater, since the thing
// that determines it does not exist yet.
test fn spark_current_environment_is_undecidable_not_counted() -> Bool {
  let factory = spark_strategy_human_burden(strategy: oobe_strategy(), env: spark_current_environment, credentials: fixture_credentials())
  let pxe = spark_strategy_human_burden(strategy: pxe_strategy(), env: spark_current_environment, credentials: fixture_credentials())

  burden_tag(d: factory) == "undecidable"
    && burden_tag(d: pxe) == "undecidable"
    && selection_tag(env: spark_current_environment) == "undecidable"
}

// Wi-Fi association is a MACHINE capability, so the human OOBE burden is a function of the
// controller, not of the strategy. Ready controller with materialized credentials => ZERO
// human actions. Absent controller => the manual portal step appears, and it is
// EveryProvision because a person repeats it for every provision the controller cannot do.
test fn spark_factory_human_burden_derives_from_controller() -> Bool {
  let ready = factory_oobe_human_burden(credentials: fixture_credentials(), env: environment(controller: gunbc.spark.provisioning.BootstrapControllerReady, pxe: gunbc.spark.provisioning.PxePrerequisitesUnknown))
  let unbound = factory_oobe_human_burden(credentials: fixture_pending_credentials(), env: environment(controller: gunbc.spark.provisioning.BootstrapControllerReady, pxe: gunbc.spark.provisioning.PxePrerequisitesUnknown))
  let absent = factory_oobe_human_burden(credentials: fixture_credentials(), env: environment(controller: gunbc.spark.provisioning.BootstrapControllerAbsent, pxe: gunbc.spark.provisioning.PxePrerequisitesUnknown))

  burden_count_at(d: ready, frequency: std.human_intervention.EveryProvision) == 0
    && burden_count_at(d: ready, frequency: std.human_intervention.DeviceOnce) == 0
    && burden_count_at(d: ready, frequency: std.human_intervention.FleetOnce) == 0
    && burden_count_at(d: unbound, frequency: std.human_intervention.DeviceOnce) == 1
    && burden_count_at(d: unbound, frequency: std.human_intervention.EveryProvision) == 0
    && burden_count_at(d: absent, frequency: std.human_intervention.EveryProvision) == 1
}

// RED control for the derivation: the SAME strategy value produces different burdens under
// different environments. A burden authored as a property of the strategy could not do
// this, so the two readings provably disagree.
test fn spark_burden_is_not_a_property_of_the_strategy_red_control() -> Bool {
  let ready = factory_oobe_human_burden(credentials: fixture_credentials(), env: environment(controller: gunbc.spark.provisioning.BootstrapControllerReady, pxe: gunbc.spark.provisioning.PxePrerequisitesUnknown))
  let absent = factory_oobe_human_burden(credentials: fixture_credentials(), env: environment(controller: gunbc.spark.provisioning.BootstrapControllerAbsent, pxe: gunbc.spark.provisioning.PxePrerequisitesUnknown))
  let ready_count = burden_count_at(d: ready, frequency: std.human_intervention.EveryProvision)
  let absent_count = burden_count_at(d: absent, frequency: std.human_intervention.EveryProvision)

  ready_count != absent_count
}

fn selection_tag(env: gunbc.spark_provisioning.SparkProvisioningEnvironment) -> String {
  match select_spark_strategy(a: oobe_strategy(), b: pxe_strategy(), env: env, credentials: fixture_credentials()) {
    StrategySelectionUndecidable { cause: _ } => "undecidable"
    StrategySelected { strategy: strategy } => match strategy {
      FactoryOobe { bootstrap: _ } => "oobe"
      PxeAutoinstall { environment: _, image: _, install_spec: _ } => "pxe"
    }
  }
}

// Selection consumes the environment: with a ready controller and materialized credentials
// the factory lane costs zero routine human actions and wins, while under an absent
// controller the manual EveryProvision step makes ready-PXE the cheaper routine lane.
// Static costs could not produce both answers from the same two strategy values.
test fn spark_strategy_selection_consumes_the_environment() -> Bool {
  let favors_oobe = environment(controller: gunbc.spark.provisioning.BootstrapControllerReady, pxe: gunbc.spark.provisioning.PxePrerequisitesAbsent)
  let favors_pxe = environment(controller: gunbc.spark.provisioning.BootstrapControllerAbsent, pxe: gunbc.spark.provisioning.PxePrerequisitesReady)

  selection_tag(env: favors_oobe) == "oobe"
    && selection_tag(env: favors_pxe) == "pxe"
    && selection_tag(env: favors_oobe) != selection_tag(env: favors_pxe)
}

// BreakGlassOnly is never priced as routine: the ready-PXE burden carries exactly one
// intervention and it is the emergency one, so all three routine counts are zero.
test fn spark_break_glass_is_not_priced_as_routine() -> Bool {
  let pxe_ready = pxe_autoinstall_human_burden(env: environment(controller: gunbc.spark.provisioning.BootstrapControllerUnknown, pxe: gunbc.spark.provisioning.PxePrerequisitesReady))

  burden_count_at(d: pxe_ready, frequency: std.human_intervention.BreakGlassOnly) == 1
    && burden_count_at(d: pxe_ready, frequency: std.human_intervention.EveryProvision) == 0
    && burden_count_at(d: pxe_ready, frequency: std.human_intervention.DeviceOnce) == 0
    && burden_count_at(d: pxe_ready, frequency: std.human_intervention.FleetOnce) == 0
}

// Credentials are carried refs rather than names rebuilt from a rendered host identity,
// the two refs are independent, and the intent carries no hostname at all.
test fn spark_credentials_are_carried_never_derived() -> Bool {
  let intent = fixture_intent()

  let hotspot = credential_secret_name(standing: intent.credentials.hotspot_password)
  let administrator = credential_secret_name(standing: intent.credentials.administrator_password)

  hotspot == "fixture-hotspot"
    && administrator == "fixture-administrator"
    && hotspot != administrator
    && credential_secret_name(standing: gunbc.spark.bootstrap_credential.CredentialMaterializationPending) == "<pending>"
    && intent.host == test.claim.spark_provisioning_witness.fixture_host
    && intent.timezone == "America/New_York"
    && intent.administrator.name == "briansrls"
    && intent.license.accepted_by == intent.administrator.name
    && strategy_carries_no_second_credential_copy(s: intent.strategy)
}

// The single-authority half, stated so it stays true: the FactoryOobe payload carries the
// bootstrap NETWORK facts and no credential copy, so there is exactly one pair of refs to
// edit and no second one to drift away from it.
// A pending standing has NO secret name to read, which is the point: nothing can extract a
// reference from a credential no producer has materialized.
fn credential_secret_name(standing: gunbc.spark_bootstrap_credential.SparkCredentialStanding) -> String {
  match standing {
    CredentialMaterialized { ref: r } => r.secret as String
    CredentialMaterializationPending => "<pending>"
  }
}

// The production default is PENDING for both refs: SECRET-MATERIALIZE-0 has not landed, no
// secret exists, and nothing in the tree outside a witness fixture can reach the
// materialized arm.
test fn spark_production_credentials_are_pending() -> Bool {
  credential_secret_name(standing: spark_credentials_pending.hotspot_password) == "<pending>"
    && credential_secret_name(standing: spark_credentials_pending.administrator_password) == "<pending>"
    && match spark_credentials_standing(c: spark_credentials_pending) {
         BootstrapCredentialsMaterialized => false
         BootstrapCredentialsNotMaterialized => true
       }
    && match spark_credentials_standing(c: fixture_credentials()) {
         BootstrapCredentialsMaterialized => true
         BootstrapCredentialsNotMaterialized => false
       }
}

fn strategy_carries_no_second_credential_copy(s: gunbc.spark_provisioning.SparkProvisioningStrategy) -> Bool {
  match s {
    FactoryOobe { bootstrap: bootstrap } =>
      (bootstrap.access_point_identity.ssid as String) == "spark-a3ee"
    PxeAutoinstall { environment: _, image: _, install_spec: _ } => true
  }
}

// The SSIDs are established nonsecret display aliases, and they are NOT fleet identity:
// the two units' aliases differ from each other and from the host identity beside them.
test fn spark_bootstrap_ssids_are_established_aliases() -> Bool {
  spark_bootstrap_ssid_a3ee.ssid == "spark-a3ee"
    && spark_bootstrap_ssid_3bd5.ssid == "spark-3bd5"
    && spark_bootstrap_ssid_a3ee.ssid != spark_bootstrap_ssid_3bd5.ssid
    && (spark_bootstrap_ssid_a3ee.ssid as String) != (test.claim.spark_provisioning_witness.fixture_host as String)
}

fn completion_evidence_tag(e: std.human_intervention.InterventionCompletionEvidence) -> String {
  match e {
    DischargedAt { evidence: _ } => "discharged-at"
    NoDischargeSiteModeled => "no-discharge-site"
  }
}

// No per-intervention discharge site exists in the repository today, and every intervention
// says so rather than citing a shared placeholder.
test fn spark_interventions_declare_no_discharge_site() -> Bool {
  completion_evidence_tag(e: spark_manual_oobe_intervention().completion_evidence) == "no-discharge-site"
    && completion_evidence_tag(e: spark_credential_materialization_intervention().completion_evidence) == "no-discharge-site"
    && completion_evidence_tag(e: spark_pxe_firmware_intervention().completion_evidence) == "no-discharge-site"
    && completion_evidence_tag(e: spark_pxe_recovery_intervention().completion_evidence) == "no-discharge-site"
}

data clean_sensitive_run: gunbc.spark_bootstrap_credential.SensitiveRunObservation = gunbc.spark_bootstrap_credential.SensitiveRunObservation {
  secret_present_in_argv: false,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: false,
}

data leaking_sensitive_run: gunbc.spark_bootstrap_credential.SensitiveRunObservation = gunbc.spark_bootstrap_credential.SensitiveRunObservation {
  secret_present_in_argv: false,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: true,
}

data argv_leaking_run: gunbc.spark_bootstrap_credential.SensitiveRunObservation = gunbc.spark_bootstrap_credential.SensitiveRunObservation {
  secret_present_in_argv: true,
  secret_present_in_standard_streams: false,
  trace_active_during_fill: false,
  har_body_retained: false,
  dom_snapshot_retained_after_fill: false,
  screenshot_masks_password_controls: true,
  credential_found_in_evidence_corpus_scan: false,
}

fn sensitive_use() -> gunbc.spark_bootstrap_credential.SensitiveBrowserInputUse {
  gunbc.spark_bootstrap_credential.SensitiveBrowserInputUse {
    secret_ref: spark_secret_ref(project: fixture_project, name: "fixture-hotspot"),
    field_identity: "captive-portal-wifi-password" as gunbc.spark_bootstrap_credential.SensitiveFieldIdentity,
    evidence_policy: gunbc.spark_bootstrap_credential.RetainNoDomNoHarNoTrace { retain_transition_result_only: true },
  }
}

fn admission_tag(obs: gunbc.spark_bootstrap_credential.SensitiveRunObservation) -> String {
  match admit_sensitive_browser_input(use: sensitive_use(), observation: obs) {
    SensitiveInputAdmitted { use: _ } => "admitted"
    SensitiveInputRefused { cause: _, evidence_disposition: d } =>
      match d { gunbc.spark.bootstrap_credential.EvidenceBundleDestroyed => "refused-destroyed"  gunbc.spark.bootstrap_credential.EvidenceBundleRetained => "refused-retained" }
  }
}

// Positive control plus two discriminating REDs: a corpus scan that finds the credential
// must refuse AND destroy the bundle, while a secret that reached argv refuses without a
// bundle to destroy.
test fn spark_sensitive_browser_input_admission() -> Bool {
  admission_tag(obs: clean_sensitive_run) == "admitted"
    && admission_tag(obs: leaking_sensitive_run) == "refused-destroyed"
    && admission_tag(obs: argv_leaking_run) == "refused-retained"
}

// The cited OOBE field list has a real consumer: every configuration subject the intent
// carries is one the wizard actually offers.
test fn spark_cited_setup_surface_holds() -> Bool {
  spark_oobe_covers_intent_subjects()
    && update_tag(d: dgx_spark_documented_initial_update) == "unobserved"
    && post_setup_route_requires_existing_account(route: extdeps.systems.nvidia_dgx_spark_setup.PostSetupSsh)
    && post_setup_route_requires_existing_account(route: extdeps.systems.nvidia_dgx_spark_setup.PostSetupNvidiaSync)
}

// The PXE parameter tokens are the cited ones, and the three switches are independent.
test fn spark_pxe_parameter_tokens_are_independent() -> Bool {
  join(dgx_spark_pxe_parameter_tokens(params: extdeps.systems.nvidia_dgx_spark_setup.DgxSparkPxeInstallParameters {
    unattended: true, user_interface_disabled: true, skip_firmware_update: false
  }), " ") == "autoinstall noui"
    && join(dgx_spark_pxe_parameter_tokens(params: extdeps.systems.nvidia_dgx_spark_setup.DgxSparkPxeInstallParameters {
         unattended: true, user_interface_disabled: false, skip_firmware_update: true
       }), " ") == "autoinstall usb.skipfw"
    && join(dgx_spark_pxe_parameter_tokens(params: extdeps.systems.nvidia_dgx_spark_setup.DgxSparkPxeInstallParameters {
         unattended: false, user_interface_disabled: false, skip_firmware_update: false
       }), " ") == ""
}
