module test.claim.fl_wait_emit_probe

import std.types { Bool, String, List }
import std.algebra { string_contains }
import v2.std.node { Node }
import std.optional { Present, Absent }
import v2.std.diagnostic { Accepted, Rejected }
import gunbc.read_set_restore { fl_wait_script_statements }
import v2.workflow.bash_emit { bash_emit_stmts }

test fn fl_wait_emit_probe_accepted() -> Bool {
  match fl_wait_script_statements() {
    Absent => false
    Present { value: stmts } =>
      match bash_emit_stmts(statements: stmts, set_e: false) {
        Accepted { value: v, diagnostics: _ } =>
          string_contains(s: v, pattern: "fl_poll") && string_contains(s: v, pattern: "fl_done")
        Rejected { diagnostics: _ } => false
      }
  }
}
