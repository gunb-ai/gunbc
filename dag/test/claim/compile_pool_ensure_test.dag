module test.claim.compile_pool_ensure


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn derived_size() -> ByteSize {
  byte_size(17179869184)
}

fn sized() -> CompilePoolResolution {
  CompilePoolDerived { bytes: derived_size() }
}

fn observed_converged() -> CompilePoolObservation {
  CompilePoolSliceObserved {
    slice_unit: gunbc_managed_compile_pool_slice,
    limits: CgroupMemoryLimits {
      memory_max: derived_size(),
      memory_high: derived_size(),
      memory_current: byte_size(0),
    },
  }
}

fn ensure_for(
  topology: CompilePoolPlacement,
  sizing: CompilePoolResolution,
  cache_placement: BuildCacheServerPlacement,
  observed: CompilePoolObservation,
) -> EnsureCompilePoolAdmission {
  admit_ensure_compile_pool_slice(
    topology: topology,
    sizing: sizing,
    cache_placement: cache_placement,
    observed: observed,
  )
}

test fn witness_undeclared_topology_refuses() -> Bool {
  let a = ensure_for(
    topology: CompilePoolInRunnerSlots,
    sizing: sized(),
    cache_placement: ServerPlacementAbsent,
    observed: CompilePoolSliceAbsent { slice_unit: gunbc_managed_compile_pool_slice },
  )
  (ensure_yields_slice(admission: a) == false) && (gunbc.compile_pool_ensure.compile_pool_ensure_is_converged(admission: a) == false)
}

test fn witness_unknown_cache_placement_refuses_before_slice_mutation() -> Bool {
  let a = ensure_for(
    topology: CompilePoolSliceDeclared { slice_unit: gunbc_managed_compile_pool_slice as String },
    sizing: sized(),
    cache_placement: ServerPlacementUnknown { detail: "owner cgroup unclassifiable" as NonEmptyStr },
    observed: CompilePoolSliceAbsent { slice_unit: gunbc_managed_compile_pool_slice },
  )
  (ensure_yields_slice(admission: a) == false) && (gunbc.compile_pool_ensure.compile_pool_ensure_is_converged(admission: a) == false)
}

test fn witness_an_absent_slice_is_admitted_with_rendered_lines() -> Bool {
  let a = ensure_for(
    topology: CompilePoolSliceDeclared { slice_unit: gunbc_managed_compile_pool_slice as String },
    sizing: sized(),
    cache_placement: ServerPlacementAbsent,
    observed: CompilePoolSliceAbsent { slice_unit: gunbc_managed_compile_pool_slice },
  )
  ensure_yields_slice(admission: a)
    && unit_declares_line(
      lines: match a {
        EnsureCompilePoolAdmitted { slice_unit: _, sized_bytes: _, slice_unit_file: f } =>
          systemd_unit_file_lines(file: f)
        _ => [],
      },
      needle: "MemoryMax=17179869184",
    )
}

test fn witness_a_matching_slice_is_converged_and_emits_nothing() -> Bool {
  let a = ensure_for(
    topology: CompilePoolSliceDeclared { slice_unit: gunbc_managed_compile_pool_slice as String },
    sizing: sized(),
    cache_placement: ServerManagedUnitOwned { unit: "gunbc-build-cache-ci.service" as NonEmptyStr },
    observed: observed_converged(),
  )
  gunbc.compile_pool_ensure.compile_pool_ensure_is_converged(admission: a) && (ensure_yields_slice(admission: a) == false)
}

test fn witness_an_undersized_observed_slice_is_admitted_for_resize() -> Bool {
  let a = ensure_for(
    topology: CompilePoolSliceDeclared { slice_unit: gunbc_managed_compile_pool_slice as String },
    sizing: sized(),
    cache_placement: ServerPlacementAbsent,
    observed: CompilePoolSliceObserved {
      slice_unit: gunbc_managed_compile_pool_slice,
      limits: CgroupMemoryLimits {
        memory_max: byte_size(512),
        memory_high: byte_size(512),
        memory_current: byte_size(0),
      },
    },
  )
  ensure_yields_slice(admission: a)
}

test fn witness_a_differently_named_slice_refuses() -> Bool {
  let a = ensure_for(
    topology: CompilePoolSliceDeclared { slice_unit: gunbc_managed_compile_pool_slice as String },
    sizing: sized(),
    cache_placement: ServerPlacementAbsent,
    observed: CompilePoolSliceObserved {
      slice_unit: "other.slice" as NonEmptyStr,
      limits: CgroupMemoryLimits {
        memory_max: derived_size(),
        memory_high: derived_size(),
        memory_current: byte_size(0),
      },
    },
  )
  ensure_yields_slice(admission: a) == false
}

test fn witness_unresolved_sizing_refuses() -> Bool {
  let a = ensure_for(
    topology: CompilePoolSliceDeclared { slice_unit: gunbc_managed_compile_pool_slice as String },
    sizing: CompilePoolUnresolved { reason: "jobserver config citation absent" },
    cache_placement: ServerPlacementAbsent,
    observed: CompilePoolSliceAbsent { slice_unit: gunbc_managed_compile_pool_slice },
  )
  ensure_yields_slice(admission: a) == false
}
