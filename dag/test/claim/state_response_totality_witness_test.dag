module test.claim.state_response_totality_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data state_response_totality_witness_note: String = "Composition slice 1's census consumer (the interaction-totality law): every (dispatch state x stateful channel) cell resolves in-family over the EMITTED stylesheet or sits under a declared ConstantByLaw ruling; cells counted, zero undeclared, cross-family and dropped-member REDs live below as planted fixtures. Shaped for later StandingIntent enrollment per gunbc.design.state_response.state_response_census_note; the registry is deliberately not built here."

test fn state_response_family_census_clean_on_live_emission() -> Bool {
  return gunbc.design.state_response.family_census_clean(css: gunbc.roadmap_style.roadmap_css(), f: gunbc.roadmap_interaction.dispatch_state_family, channels: gunbc.roadmap_interaction.dispatch_stateful_channels)
}

// The counted product: 5 family members (rest + requested/ok/refused/loud) x 4 per-family channels (rest ink, rest fill, rest border, press fill) = 20 cells, plus 2 signed constants (approach emphasis, engage sound) each carrying a located ruling ref. A widening family or channel table moves these numbers — the assertion is the count being CONSCIOUS, not the count being eternal.
test fn state_response_census_counts_hold() -> Bool {
  return gunbc.design.state_response.family_census_cell_count(f: gunbc.roadmap_interaction.dispatch_state_family, channels: gunbc.roadmap_interaction.dispatch_stateful_channels) == 20
    && count(gunbc.design.state_response.constant_by_law_rulings(channels: gunbc.roadmap_interaction.dispatch_stateful_channels)) == 2
    && gunbc.design.state_response.constant_rulings_all_located(channels: gunbc.roadmap_interaction.dispatch_stateful_channels)
}

data cross_wired_family_note: String = "The planted cross-family fixture: the ok member's selector bound to the FAIL band key — the round-5 flash class, synthesized at the roster grain. Emitting this family through the same realize folds and running the census with the TRUE roster must locate the ok cells as CrossFamilyValue naming fail. The var roots come from the real band_root_css. The fixture is selector-scoped (no base rule in the synthetic emission), so the rest member's cells also count ChannelValueMissing there — the assertion targets the located cross-family defect, never a defect-count of one."

data cross_wired_family: gunbc.design.state_response.StateFamily = gunbc.design.state_response.StateFamily {
  component_class: "dispatch-btn",
  var_prefix: "band-",
  members: [
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.RestBinding, key: "invite" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-requested" }, key: "in-progress" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-ok" }, key: "fail" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-refused" }, key: "fail" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-loud" }, key: "loud" },
  ],
}

fn synthetic_emission(f: gunbc.design.state_response.StateFamily) -> String {
  join([
    gunbc.roadmap_style.band_root_css(),
    gunbc.design.material.serialize_rules(rules: gunbc.design.state_response.state_paint_rules(f: f, channels: gunbc.roadmap_interaction.dispatch_stateful_channels)),
    gunbc.design.material.serialize_rules(rules: gunbc.design.state_response.family_response_rules(f: f, channels: gunbc.roadmap_interaction.dispatch_stateful_channels, timing: gunbc.design.material.respond_fast)),
  ], "\n")
}

fn defect_is_cross_family_ok_to_fail(d: gunbc.design.state_response.FamilyCensusDefect) -> Bool {
  d.member_key == "ok" && match d.fault {
    gunbc.design.state_response.CrossFamilyValue { foreign_key } => foreign_key == "fail"
    gunbc.design.state_response.FamilyVarUndefined { var_name: _ } => false
    gunbc.design.state_response.ChannelValueMissing => false
  }
}

test fn state_response_census_reds_on_cross_family_press() -> Bool {
  let poisoned = synthetic_emission(f: cross_wired_family)
  let defects = gunbc.design.state_response.family_census_defects(css: poisoned, f: gunbc.roadmap_interaction.dispatch_state_family, channels: gunbc.roadmap_interaction.dispatch_stateful_channels)
  return count(defects) > 0
    && count(defects |> filter(d => defect_is_cross_family_ok_to_fail(d: d))) > 0
}

data dropped_member_family_note: String = "The planted dropped-member fixture: the loud member absent from the roster the emission was realized from. The census with the TRUE roster must count every loud cell ChannelValueMissing — the totality question the round-5 defect never got asked (one pressed var presenting as total), now a standing red. Same selector-scoped caveat as the cross-wired fixture: rest cells also count Missing in the synthetic; the assertion targets the located loud defect."

data dropped_member_family: gunbc.design.state_response.StateFamily = gunbc.design.state_response.StateFamily {
  component_class: "dispatch-btn",
  var_prefix: "band-",
  members: [
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.RestBinding, key: "invite" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-requested" }, key: "in-progress" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-ok" }, key: "ok" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: "dispatch-refused" }, key: "fail" },
  ],
}

fn defect_is_loud_missing(d: gunbc.design.state_response.FamilyCensusDefect) -> Bool {
  d.member_key == "loud" && match d.fault {
    gunbc.design.state_response.ChannelValueMissing => true
    gunbc.design.state_response.CrossFamilyValue { foreign_key: _ } => false
    gunbc.design.state_response.FamilyVarUndefined { var_name: _ } => false
  }
}

test fn state_response_census_reds_on_dropped_member() -> Bool {
  let partial = synthetic_emission(f: dropped_member_family)
  let defects = gunbc.design.state_response.family_census_defects(css: partial, f: gunbc.roadmap_interaction.dispatch_state_family, channels: gunbc.roadmap_interaction.dispatch_stateful_channels)
  return count(defects) > 0
    && count(defects |> filter(d => defect_is_loud_missing(d: d))) > 0
}

data receipt_totality_note: String = "The fold-totality claim proven structurally, not by reading: the receipt realization must yield exactly one response rule per roster member — the shape whose absence let one pressed var present as total. This reds if the fold ever gains a filter or an arm that skips a member."

test fn state_response_receipt_rules_cover_the_roster() -> Bool {
  return count(gunbc.roadmap_interaction.dispatch_btn_receipt_rules(timing: gunbc.design.material.respond_fast)) == count(dispatch_state_family.members)
}
