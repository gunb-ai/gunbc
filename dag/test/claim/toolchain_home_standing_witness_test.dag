module test.claim.toolchain_home_standing_witness

import std.types { Bool, List, String }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  SelfHosted, HostedRunner, UbuntuLatest, RunsOnExpression,
  checkout_action, setup_rust_action
}
import extdeps.languages.yaml.types { yaml_string, kv }
import gunbc.toolchain_home_standing {
  ToolchainHomeClassification,
  ToolchainHomeClassified, ToolchainHomeUnclassified,
  PrivateMutableHome, ImmutableToolchain,
  ToolchainInstalledIntoSharedHome,
  ToolchainHomeIsolatedWithoutInstall,
  ToolchainHomeRunnerKindUndecidable,
  classify_job_toolchain_home,
  admit_workflow_toolchain_homes,
  WorkflowToolchainHomesAdmitted,
  WorkflowToolchainHomeRefused,
}
import gunbc.toolchain_workflow_steps { toolchain_home_isolation_step }
import gunbc.witness_floor_workflow { witness_floor_workflow }
import gunbc.fleet_converge_workflow { fleet_converge_workflow }
import gunbc.fleet_desired_admission_workflow { fleet_desired_admission_workflow }
import v2.std.optional { Present }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// EVERY FIXTURE BELOW IS BUILT FROM THE PRODUCTION CONSTRUCTORS, NOT FROM TRANSCRIBED SHELL. A
// fixture that spelled its own isolation script would be testing that this file agrees with itself:
// the predicate reads the authority's command rows, so a hand-typed copy would either pass for the
// wrong reason or diverge silently the first time a row is edited.

fn fixture_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: none,
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn fixture_install_step() -> Step {
  UsesStep {
    name: Present { value: "Install Rust toolchain" },
    id: none,
    uses: setup_rust_action,
    with: none,
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn fixture_job(job_id: String, steps: List<Step>) -> Job {
  Job {
    id: job_id,
    name: none,
    runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
    steps: steps,
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }
}

fn classification_is(c: ToolchainHomeClassification, standing_is_private: Bool) -> Bool {
  match c {
    ToolchainHomeClassified { job_id: _, standing: s } =>
      match s {
        PrivateMutableHome => standing_is_private
        ImmutableToolchain => !standing_is_private
      }
    ToolchainHomeUnclassified { job_id: _, refusal: _ } => false
  }
}

// ═══ THE RED. This is the shape that took the fleet down: a self-hosted job that installs a
// toolchain with no isolation ahead of it. It must not classify.
test fn a_self_hosted_install_into_the_shared_home_is_unclassified() -> Bool {
  match classify_job_toolchain_home(job: fixture_job(
    job_id: "admit",
    steps: [fixture_checkout_step(), fixture_install_step()]
  )) {
    ToolchainHomeClassified { job_id: _, standing: _ } => false
    ToolchainHomeUnclassified { job_id: id, refusal: r } =>
      id == "admit" && match r {
        ToolchainInstalledIntoSharedHome => true
        ToolchainHomeIsolatedWithoutInstall => false
        ToolchainHomeRunnerKindUndecidable => false
      }
  }
}

// ═══ THE POSITIVE CONTROL, and without it the red above is worthless: a classifier that refused
// every job would pass it. The same job with the isolation step ahead of the install is admitted.
test fn a_self_hosted_install_behind_isolation_is_private_mutable_home() -> Bool {
  classification_is(
    c: classify_job_toolchain_home(job: fixture_job(
      job_id: "admit",
      steps: [fixture_checkout_step(), toolchain_home_isolation_step(), fixture_install_step()]
    )),
    standing_is_private: true
  )
}

// ═══ THE ORDERING DISCRIMINATOR. A check asking only "does this job contain an isolation step
// anywhere" passes this job, and this job is broken exactly as the unisolated one is: the install
// wrote into the shared home before anything rebound it. Order is the content of the claim.
test fn isolation_after_the_install_does_not_classify() -> Bool {
  match classify_job_toolchain_home(job: fixture_job(
    job_id: "admit",
    steps: [fixture_checkout_step(), fixture_install_step(), toolchain_home_isolation_step()]
  )) {
    ToolchainHomeClassified { job_id: _, standing: _ } => false
    ToolchainHomeUnclassified { job_id: _, refusal: r } =>
      match r {
        ToolchainInstalledIntoSharedHome => true
        ToolchainHomeIsolatedWithoutInstall => false
        ToolchainHomeRunnerKindUndecidable => false
      }
  }
}

// ═══ THE OTHER STANDING. A job that installs nothing mutates no toolchain, so it inherits the
// host's and needs no isolation. Without this witness the classifier could be "refuse unless
// isolated" and every arm above would still pass.
test fn a_job_that_installs_nothing_is_immutable_toolchain() -> Bool {
  classification_is(
    c: classify_job_toolchain_home(job: fixture_job(
      job_id: "fleet-converge",
      steps: [fixture_checkout_step()]
    )),
    standing_is_private: false
  )
}

// ═══ ISOLATION WITHOUT AN INSTALL IS A REFUSAL, NOT A COURTESY. The step wipes and rebinds three
// homes for a job that puts nothing in them; either the install was dropped and the job is about to
// resolve a toolchain out of an empty directory, or the step is dead. Both are worth stopping for,
// and they are not the same repair as the outage above -- hence a separate cause.
test fn isolation_without_an_install_is_unclassified() -> Bool {
  match classify_job_toolchain_home(job: fixture_job(
    job_id: "admit",
    steps: [fixture_checkout_step(), toolchain_home_isolation_step()]
  )) {
    ToolchainHomeClassified { job_id: _, standing: _ } => false
    ToolchainHomeUnclassified { job_id: _, refusal: r } =>
      match r {
        ToolchainInstalledIntoSharedHome => false
        ToolchainHomeIsolatedWithoutInstall => true
        ToolchainHomeRunnerKindUndecidable => false
      }
  }
}

// ═══ AN EXPRESSION RUNNER FAILS CLOSED. Its labels resolve at dispatch, so this layer cannot know
// whether the home persists between runs; unknown is refused rather than assumed ephemeral.
test fn an_expression_runner_installing_unisolated_fails_closed() -> Bool {
  match classify_job_toolchain_home(job: Job {
    id: "fleet-converge",
    name: none,
    runner: RunsOnExpression { expression: "${{ fromJSON(inputs.host) }}" },
    steps: [fixture_checkout_step(), fixture_install_step()],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }) {
    ToolchainHomeClassified { job_id: _, standing: _ } => false
    ToolchainHomeUnclassified { job_id: _, refusal: r } =>
      match r {
        ToolchainInstalledIntoSharedHome => false
        ToolchainHomeIsolatedWithoutInstall => false
        ToolchainHomeRunnerKindUndecidable => true
      }
  }
}

// ═══ A HOSTED RUNNER NEEDS NO STEP. GitHub destroys the machine after the run, so the home is
// private by construction of the runner. Demanding an isolation step there would be ceremony, and
// this witness is what keeps someone from "tightening" the rule into one.
test fn a_hosted_runner_install_is_private_by_construction() -> Bool {
  classification_is(
    c: classify_job_toolchain_home(job: Job {
      id: "hosted",
      name: none,
      runner: HostedRunner { label: UbuntuLatest },
      steps: [fixture_checkout_step(), fixture_install_step()],
      needs: [],
      env: none,
      outputs: none,
      if_condition: none,
      timeout_minutes: none,
      continue_on_error: none,
      concurrency: none,
      permissions: none
    }),
    standing_is_private: true
  )
}

// ═══ THE LIVE CONSUMERS, not fixtures. Every job of every workflow this repository generates must
// carry a standing. These three are the whole population of generated workflows -- .github/workflows
// holds exactly witnesses.yml, fleet-converge.yml and fleet-desired.yml -- and each is joined here
// by its own emitted Workflow value rather than by a roster naming its jobs, so a job added to any
// of them enters this check by construction rather than by someone remembering to enrol it.
//
// THE ASSERTION MATCHES THE TYPED VERDICT rather than a Bool the production module hands over. A
// `*_holds` predicate on the production side would have been a second representation of the
// coproduct existing only so a witness could read it (review 56168); a witness necessarily returns
// Bool, so the collapse belongs HERE, at the assertion, where the discarded job_id and refusal have
// no remaining consumer.
fn workflow_is_admitted(workflow: Workflow) -> Bool {
  match admit_workflow_toolchain_homes(workflow: workflow) {
    WorkflowToolchainHomesAdmitted => true
    WorkflowToolchainHomeRefused { job_id: _, refusal: _ } => false
  }
}

test fn every_witnesses_yml_job_carries_a_toolchain_home_standing() -> Bool {
  workflow_is_admitted(workflow: witness_floor_workflow)
}

test fn every_fleet_converge_yml_job_carries_a_toolchain_home_standing() -> Bool {
  workflow_is_admitted(workflow: fleet_converge_workflow)
}

test fn every_fleet_desired_yml_job_carries_a_toolchain_home_standing() -> Bool {
  workflow_is_admitted(workflow: fleet_desired_admission_workflow)
}
