module test.claim.hosted_ci_secrets_custody_witness

// THE WITNESSES FOR THE HOSTED-CI CREDENTIAL CUSTODY (work item node://adhoc-b86ed674-9a1, 2026-11-20).
//
// What they hold the model to: BOTH hosted-CI remote-build credentials are held in GCP Secret Manager at
// their single home (project gunbai-secrets, matched against fleet_secrets_gcp_project -- never a GitHub
// Actions secret), the secret VERSION is "pending" rather than a guessed number (review 95989: a version
// written before it was read was a guessed number in a security row), the OAuth client identity matches the
// values the operator verified, and the gate's dedicated low-privilege reader (gunbc.auth.hosted_ci_secrets_-
// federation, the native-product-read shape the operator ruled (A)) holds EXACTLY the two cells it reads --
// no more, no less -- on the repository's WIDE github-oidc provider, so it cannot be the fleet convergence
// principal the shadow gate is forbidden to be on pull_request.
//
// The two SecretRefs and the federation's grants are the custody model (PR#1); their executing consumer is
// the hosted-runner shadow gate reading Secret Manager over WIF (PR#2), named in the PR#1 body per the
// Consumption rule. Provenance is cited from gentle-crab-832's 2026-11-20 verification, not re-derived here.

import std.logic { Bool }
import std.types { String }
import gunbc.compute.remote_build { remote_build_ci_ssh_privkey_secret }
import gunbc.tailscale_ci_oauth_client {
  tailscale_oauth_client_secret_ref, ci_oauth_client_id, ci_oauth_client_scope, ci_oauth_client_tags,
  ci_oauth_client_ephemeral,
}
import gunbc.fleet.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.auth.hosted_ci_secrets_federation {
  hosted_ci_secrets_federation, hosted_ci_secrets_service_account, hosted_ci_ssh_key_secret_version,
  tailscale_oauth_client_secret_version, hosted_ci_secrets_attribute_condition,
  hosted_ci_secrets_attribute_mapping,
}
import extdeps.tailscale.acl { tag_ci_dispatch }

// ── THE CI SSH PRIVATE HALF: Secret Manager at its single home, version pending ────────────────────────

test fn w_ci_ssh_key_is_secret_manager_not_github() -> Bool {
  (remote_build_ci_ssh_privkey_secret.project as String) == (fleet_secrets_gcp_project as String)
    && (fleet_secrets_gcp_project as String) == "gunbai-secrets"
    && (remote_build_ci_ssh_privkey_secret.secret as String) == "remote-build-ci-ssh-key"
}

// The version is the operator's relay, held "pending" rather than guessed; it is never "latest", which would
// let the credential the gate reads change underneath a run.
test fn w_ci_ssh_key_version_is_pinned_not_latest() -> Bool {
  (remote_build_ci_ssh_privkey_secret.version as String) == "pending"
    && (remote_build_ci_ssh_privkey_secret.version as String) != "latest"
}

// ── THE OAUTH CLIENT SECRET: Secret Manager at its single home, version pending ────────────────────────

test fn w_oauth_secret_is_secret_manager_not_github() -> Bool {
  (tailscale_oauth_client_secret_ref.project as String) == (fleet_secrets_gcp_project as String)
    && (tailscale_oauth_client_secret_ref.secret as String) == "tailscale-oauth-client-secret"
}

test fn w_oauth_secret_version_is_pinned_not_latest() -> Bool {
  (tailscale_oauth_client_secret_ref.version as String) == "pending"
    && (tailscale_oauth_client_secret_ref.version as String) != "latest"
}

// ── THE OAUTH CLIENT IDENTITY, as the operator verified it (2026-11-20) ───────────────────────────────

test fn w_oauth_client_identity_matches_the_relay() -> Bool {
  (ci_oauth_client_id as String) == "kNQLY8UpZK11CNTRL"
    && (ci_oauth_client_scope as String) == "auth_keys:write"
    && ci_oauth_client_ephemeral == true
    && ci_oauth_client_tags.count() == 1
    && ci_oauth_client_tags.any(t => (t as String) == (tag_ci_dispatch as String))
}

// ── THE GATE'S READER: one dedicated low-privilege account, exactly the two cells, a PINNED dedicated provider ──

// The reader is its OWN account (never the fleet convergence principal), on its OWN pool/provider
// (the manager's 2026-11-20 shape, recorded at #gunbc.design_ruling::hosted_ci_credentials_federate_over_wif_dispatch_only):
// one provider pinned to exactly one population -- this repository, this owner, this workflow file at
// refs/heads/main, event workflow_dispatch, ref refs/heads/main -- so the dispatch-at-main arm is the
// only run that can ever mint a token. One provider shared with fleet-converge would mean one pin for
// neither workflow.
test fn w_reader_is_dedicated_account_on_pinned_dedicated_provider() -> Bool {
  (hosted_ci_secrets_service_account as String)
    == "hosted-ci-secrets@gunbai-secrets.iam.gserviceaccount.com"
    && (hosted_ci_secrets_federation().service_account as String) == (hosted_ci_secrets_service_account as String)
    && (hosted_ci_secrets_federation().pool_id as String) == "github-hosted-shadow-gate"
    && (hosted_ci_secrets_federation().provider_id as String) == "github-hosted-shadow-gate-oidc"
    && contains(haystack: hosted_ci_secrets_attribute_condition(), needle: "workflow_dispatch")
    && contains(haystack: hosted_ci_secrets_attribute_condition(), needle: "refs/heads/main")
    && hosted_ci_secrets_attribute_mapping.count() == 6
}

// The reader holds EXACTLY the two cells -- one per credential -- and each is the credential's own secret in
// the fleet's project, pinned to the relay constant. No third cell, no missing cell: an extra grant is a
// widened blast radius and a missing one is a dangling model.
test fn w_reader_grants_are_exactly_the_two_cells() -> Bool {
  hosted_ci_secrets_federation().secret_grants.count() == 2
    && hosted_ci_secrets_federation().secret_grants.any(g =>
      (g.target.project as String) == (fleet_secrets_gcp_project as String)
        && (g.target.secret as String) == "remote-build-ci-ssh-key"
        && (g.target.version as String) == (hosted_ci_ssh_key_secret_version as String))
    && hosted_ci_secrets_federation().secret_grants.any(g =>
      (g.target.project as String) == (fleet_secrets_gcp_project as String)
        && (g.target.secret as String) == "tailscale-oauth-client-secret"
        && (g.target.version as String) == (tailscale_oauth_client_secret_version as String))
}
