module test.claim.accelerator_demo_model_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_integer_contract_maps_to_lossless_fidelity() -> Bool {
  match extdeps.communication.numerical_fidelity.lowering_fidelity_verdict_for_contract(contract: std.numerical_contract.integer_exact_contract()) {
    LoweringAccepted { fidelity: f } => match f {
      Lossless => true
      Lossy => false
    }
    LoweringRefused { reason: _ } => false
  }
}

fn witness_float_no_contraction_maps_to_lossless_fidelity() -> Bool {
  let contract = std.numerical_contract.float_contract(rounding: std.approximate_field.ToNearestEven, fma: std.numerical_contract.FmaContractionRefused)
  match extdeps.communication.numerical_fidelity.decode_fidelity_for_contract(contract: contract) {
    Lossless => true
    Lossy => false
  }
}

fn witness_float_contraction_permitted_maps_to_lossy_fidelity() -> Bool {
  let contract = std.numerical_contract.float_contract(rounding: std.approximate_field.ToNearestEven, fma: std.numerical_contract.FmaContractionPermitted)
  match extdeps.communication.numerical_fidelity.decode_fidelity_for_contract(contract: contract) {
    Lossy => true
    Lossless => false
  }
}

test fn accelerator_demo_modeling_lane_witnesses() -> Bool {
  gunbc.accelerator_demo_plan.witness_integer_demo_emits_realization_plan_value()
    && gunbc.accelerator_demo_plan.witness_integer_demo_plan_has_local_accelerator_placement()
    && gunbc.accelerator_demo_plan.witness_demo_device_identity_grounds_on_accelerator_facts()
    && gunbc.accelerator_demo_plan.witness_effectful_subgraph_refused()
    && gunbc.accelerator_demo_plan.witness_data_dependent_gather_refused()
    && gunbc.accelerator_demo_plan.witness_float_no_contraction_contract_accepted_lossless()
    && gunbc.accelerator_demo_plan.witness_float_fma_fused_kernel_refused_when_contraction_refused()
    && gunbc.accelerator_demo_plan.witness_simd_target_medium_is_inspectable()
    && gunbc.accelerator_demo_plan.witness_lowering_fma_refusal_maps_to_accelerator_refusal()
    && gunbc.accelerator_demo_plan.witness_lowering_unsupported_domain_maps_to_accelerator_refusal()
    && witness_integer_contract_maps_to_lossless_fidelity()
    && witness_float_no_contraction_maps_to_lossless_fidelity()
    && witness_float_contraction_permitted_maps_to_lossy_fidelity()
}
