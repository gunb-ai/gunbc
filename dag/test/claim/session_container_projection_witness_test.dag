module test.claim.session_container_projection_witness_test

import std.types { Bool, String, NonEmptyStr }
import std.measure { byte_size, byte_size_count }
import gunbc.fleet_intent_network {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}
import gunbc.session_container_projection {
  SessionAggregateProjected, SessionAggregateNotOwed, SessionAggregateUnprojectable,
  PerContainerCapProjected, PerContainerCapNotOwed, PerContainerCapUnderivable,
  ConcurrencyAdmitted, ConcurrencyObserved, ConcurrencyUnestablished,
  session_aggregate_projection_for, per_container_cap_for, per_container_cap_from,
  derive_per_container_cap, session_concurrency_basis, concurrency_basis_of,
}
import gunbc.session_admission_policy {
  SessionAdmissionDeclared, ConcurrencyEnforcedBy,
}

// THE AGGREGATE PROJECTION SPLITS THE FOUR HOSTS THREE WAYS, and the discriminating pair is srv2
// against srv3: both yield no number, and a carrier with one "no value" arm would render them
// identically while their remedies are opposite -- srv2 owes a measurement nobody took, srv3 owes
// nothing at all. Asserting only that neither projects bytes would pass against that collapse.
test fn the_aggregate_projection_separates_not_owed_from_unprojectable() -> Bool {
  let srv1_projects = match session_aggregate_projection_for(host: operator_host_srv1) {
    SessionAggregateProjected { bytes: b } => byte_size_count(b: b) == 55834574848
    SessionAggregateNotOwed { cause: _ } => false
    SessionAggregateUnprojectable { cause: _ } => false
  }
  let srv2_unprojectable = match session_aggregate_projection_for(host: operator_host_srv2) {
    SessionAggregateUnprojectable { cause: _ } => true
    SessionAggregateProjected { bytes: _ } => false
    SessionAggregateNotOwed { cause: _ } => false
  }
  let srv3_not_owed = match session_aggregate_projection_for(host: operator_host_srv3) {
    SessionAggregateNotOwed { cause: _ } => true
    SessionAggregateProjected { bytes: _ } => false
    SessionAggregateUnprojectable { cause: _ } => false
  }
  let srv4_not_owed = match session_aggregate_projection_for(host: operator_host_srv4) {
    SessionAggregateNotOwed { cause: _ } => true
    SessionAggregateProjected { bytes: _ } => false
    SessionAggregateUnprojectable { cause: _ } => false
  }
  srv1_projects && srv2_unprojectable && srv3_not_owed && srv4_not_owed
}

// NO HOST PROJECTS A PER-CONTAINER CAP TODAY, and this witness records that as the measured live
// state rather than as an aspiration. It goes red the moment an admitted limit is declared for any
// host, which is exactly when someone must revisit it -- the refusal is not meant to be permanent.
test fn no_live_host_projects_a_per_container_cap() -> Bool {
  let none_projected = fold(
    [operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4],
    init: true,
    f: (acc, h) => acc && match per_container_cap_for(host: h) {
      PerContainerCapProjected { bytes: _, aggregate: _, admitted: _ } => false
      PerContainerCapNotOwed { cause: _ } => true
      PerContainerCapUnderivable { cause: _ } => true
    },
  )
  let srv1_underivable = match per_container_cap_for(host: operator_host_srv1) {
    PerContainerCapUnderivable { cause: _ } => true
    PerContainerCapProjected { bytes: _, aggregate: _, admitted: _ } => false
    PerContainerCapNotOwed { cause: _ } => false
  }
  let srv3_not_owed = match per_container_cap_for(host: operator_host_srv3) {
    PerContainerCapNotOwed { cause: _ } => true
    PerContainerCapProjected { bytes: _, aggregate: _, admitted: _ } => false
    PerContainerCapUnderivable { cause: _ } => false
  }
  none_projected && srv1_underivable && srv3_not_owed
}

// THE POSITIVE CONTROL. Without it the refusal above could be a decoration over a derivation that
// does not work: every host refusing is equally consistent with a function that can never project.
// This authors the admitted limit the live table lacks and asserts the exact quotient.
test fn an_admitted_limit_derives_an_exact_cap() -> Bool {
  match per_container_cap_from(
    a: SessionAggregateProjected { bytes: byte_size(55834574848) },
    c: ConcurrencyAdmitted { limit: 16, operator_reason: "fixture-authored admitted limit" },
  ) {
    PerContainerCapProjected { bytes: b, aggregate: agg, admitted: n } =>
      byte_size_count(b: b) == 3489660928
        && byte_size_count(b: agg) == 55834574848
        && n == 16
    PerContainerCapNotOwed { cause: _ } => false
    PerContainerCapUnderivable { cause: _ } => false
  }
}

// THE DISCRIMINATING RED, and it is the reason the basis is a coproduct rather than an Int. The
// aggregate and the integer are IDENTICAL to the positive control above; only the variant differs.
// A carrier that stored concurrency as a bare Int could not express this pair at all, so the two
// witnesses together prove the distinction is load-bearing rather than nominal.
test fn an_observed_count_is_not_an_admitted_limit() -> Bool {
  match per_container_cap_from(
    a: SessionAggregateProjected { bytes: byte_size(55834574848) },
    c: ConcurrencyObserved { count: 16, receipt: "fixture-authored observation of the present population" },
  ) {
    PerContainerCapUnderivable { cause: _ } => true
    PerContainerCapProjected { bytes: _, aggregate: _, admitted: _ } => false
    PerContainerCapNotOwed { cause: _ } => false
  }
}

// FLOOR DIVISION IS THE SOUND DIRECTION, and 100 over 3 is chosen because it does not divide: a
// ceiling or a rounding would put 3 * 34 = 102 over an aggregate of 100, over-issuing the whole
// reservation. The assertion is the conservation property itself, not the quotient.
test fn the_admitted_population_never_exceeds_its_aggregate() -> Bool {
  match derive_per_container_cap(aggregate: byte_size(100), limit: 3) {
    PerContainerCapProjected { bytes: b, aggregate: agg, admitted: n } =>
      byte_size_count(b: b) * n <= byte_size_count(b: agg) && byte_size_count(b: b) == 33
    PerContainerCapNotOwed { cause: _ } => false
    PerContainerCapUnderivable { cause: _ } => false
  }
}

// A DEGENERATE LIMIT REFUSES RATHER THAN PRODUCING AN UNBOUNDED CAP.
test fn a_non_positive_limit_refuses() -> Bool {
  match derive_per_container_cap(aggregate: byte_size(55834574848), limit: 0) {
    PerContainerCapUnderivable { cause: _ } => true
    PerContainerCapProjected { bytes: _, aggregate: _, admitted: _ } => false
    PerContainerCapNotOwed { cause: _ } => false
  }
}

// THE LIVE BASIS IS UNESTABLISHED BECAUSE NOTHING ENFORCES THE LIMIT, not because no limit exists.
// The distinction is the whole content of the row: gunbc.session_admission_policy DOES declare
// sixteen, so an assertion that merely reached ConcurrencyUnestablished would pass equally under the
// superseded state where no carrier existed at all, and would keep passing if the enforcement axis
// were quietly dropped. Matching the cause pins WHICH absence this is.
test fn the_live_basis_is_unestablished_because_nothing_enforces_the_limit() -> Bool {
  match session_concurrency_basis() {
    ConcurrencyUnestablished { cause: why } => string_contains(s: why, pattern: "enforces")
    ConcurrencyAdmitted { limit: _, operator_reason: _ } => false
    ConcurrencyObserved { count: _, receipt: _ } => false
  }
}

// AND THE ADMITTED ARM IS REACHABLE, which is what stops the refusal above from being a permanently
// green decoration. A fixture policy whose only difference is the enforcement arm yields
// ConcurrencyAdmitted, so the live refusal is attributable to enforcement alone -- and the day an
// actuator lands, this pair is already the discriminating evidence that the flip was real.
test fn an_enforced_policy_yields_an_admitted_basis() -> Bool {
  match concurrency_basis_of(p: SessionAdmissionDeclared {
    oomd_eviction_ceiling: byte_size(10737418240),
    admitted_concurrency: 16,
    enforcement: ConcurrencyEnforcedBy { actuator: "witness fixture: a hypothetical spawn-time admission actuator" as NonEmptyStr },
  }) {
    ConcurrencyAdmitted { limit: n, operator_reason: _ } => n == 16
    ConcurrencyUnestablished { cause: _ } => false
    ConcurrencyObserved { count: _, receipt: _ } => false
  }
}
