module test.claim.realization_vocab_confinement_census_test

import std.types { String, NonEmptyStr, Bool, Int, List }
import std.content_hash { content_hash_eq_structural }
import gunbc.repository_census_observation {
  CensusSubjectKey,
  repository_census_row_count,
  repository_census_subject_keys,
}
import gunbc.repository_census_coverage {
  CoverageEstablished,
  CoverageRefused,
  census_denominator_subject_count,
  census_distinct_subject_keys,
  census_receipt_is_self_join,
  census_ceiling_is_floor_only,
}
import gunbc.realization_vocab_confinement_census {
  ConfinementSurfaceAxis,
  ExactVocabularyModule,
  VocabularyModulePrefix,
  RealizationEdgePathPrefix,
  DeclaredExceptionUnit,
  confinement_axis_is_prefix_grain,
  confinement_census_revision,
  confinement_surface_declared_keys,
  confinement_surface_axis_of_declared_key,
  confinement_surface_observation,
  confinement_surface_denominator,
  confinement_surface_coverage,
  confinement_surface_ceiling,
  confinement_surface_population_claim,
  confinement_surface_declared_key_count,
  confinement_surface_claimed_keys,
  confinement_surface_supports_undeclared_key_absence,
  confinement_surface_prefix_grain_keys,
}
import v2.lens.realization_vocabulary_containment {
  target_ast_vocab_modules,
  target_ast_vocab_module_prefixes,
  realization_edge_path_prefixes,
  realization_vocab_exception_paths,
}
import gunbc.guarantee_measurement { MeasurementRevision }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data confinement_census_witness_note: String = "THE SUBJECT ROSTERS ARE READ FROM THE REAL LENS MODULE, not restated here. Every expected key in this file is taken from v2.lens.realization_vocabulary_containment's own declared data, so a roster edit moves both the census and its expectation together and this file never becomes a second copy of the confinement surface. What it does independently is COUNT and CROSS-CHECK: the arithmetic below sums the four rosters, which is a different assembly than either the census enumeration or its classification performs."

data confinement_census_witness_revision_commit: String = "0000000000000000000000000000000000000b0b"

fn confinement_witness_revision() -> MeasurementRevision {
  confinement_census_revision(commit: confinement_census_witness_revision_commit)
}

fn confinement_witness_roster_total() -> Int {
  let exact = count(target_ast_vocab_modules)
  let prefixes = count(target_ast_vocab_module_prefixes)
  let edges = count(realization_edge_path_prefixes)
  let exceptions = count(realization_vocab_exception_paths())
  exact + prefixes + edges + exceptions
}

test fn witness_the_confinement_census_enumerates_every_declared_roster() -> Bool {
  count(confinement_surface_declared_keys()) == confinement_witness_roster_total()
}

test fn witness_the_confinement_census_classifies_every_enumerated_key() -> Bool {
  count(confinement_surface_axis_of_declared_key()) == confinement_witness_roster_total()
}

test fn witness_the_declared_confinement_keys_are_distinct() -> Bool {
  let keys = confinement_surface_declared_keys()
  count(census_distinct_subject_keys(keys: keys)) == count(keys)
}

test fn witness_the_real_confinement_surface_reconciles_exactly() -> Bool {
  match confinement_surface_coverage(revision: confinement_witness_revision()) {
    CoverageEstablished { receipt: _ } => true
    CoverageRefused { reconciliation: _ } => false
  }
}

test fn witness_the_confinement_receipt_is_not_a_self_join() -> Bool {
  match confinement_surface_coverage(revision: confinement_witness_revision()) {
    CoverageEstablished { receipt: receipt } => !census_receipt_is_self_join(receipt: receipt)
    CoverageRefused { reconciliation: _ } => false
  }
}

test fn witness_the_confinement_ceiling_is_not_a_floor() -> Bool {
  !census_ceiling_is_floor_only(
    ceiling: confinement_surface_ceiling(revision: confinement_witness_revision()),
  )
}

test fn witness_the_confinement_population_claim_exists_at_this_revision() -> Bool {
  match confinement_surface_population_claim(revision: confinement_witness_revision()) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn witness_the_claimed_key_count_is_the_real_roster_total() -> Bool {
  match confinement_surface_population_claim(revision: confinement_witness_revision()) {
    Present { value: claim } =>
      confinement_surface_declared_key_count(claim: claim) == confinement_witness_roster_total()
    Absent => false
  }
}

test fn witness_the_claim_carries_every_declared_key_by_identity() -> Bool {
  match confinement_surface_population_claim(revision: confinement_witness_revision()) {
    Present { value: claim } => {
      let claimed = confinement_surface_claimed_keys(claim: claim)
      let declared = confinement_surface_declared_keys()
      all(declared, key => any(claimed, seen => (seen as String) == (key as String)))
    }
    Absent => false
  }
}

test fn witness_the_claim_supports_absence_of_an_undeclared_key() -> Bool {
  match confinement_surface_population_claim(revision: confinement_witness_revision()) {
    Present { value: claim } => confinement_surface_supports_undeclared_key_absence(claim: claim)
    Absent => false
  }
}

test fn witness_an_undeclared_key_is_absent_from_the_claimed_population() -> Bool {
  match confinement_surface_population_claim(revision: confinement_witness_revision()) {
    Present { value: claim } => {
      let claimed = confinement_surface_claimed_keys(claim: claim)
      !any(claimed, seen => (seen as String) == "v2.workflow.definitely_not_confined")
    }
    Absent => false
  }
}

data confinement_prefix_grain_witness_note: String = "THE GRAIN CHECK, RUN AGAINST THE REAL ROSTER. 'v2.workflow.bash' is a declared confinement key and 'v2.workflow.bash_command_fold_serialize' is a real module the bash lane names — the second is matched by the first as a STRING PREFIX while being no namespace descendant of it at all. This witness asserts that relationship holds on the live roster rather than on a fixture, because a sweep that read those keys as namespace containment is precisely how a phantom was manufactured in this lane."

test fn witness_a_confinement_prefix_key_matches_a_non_descendant_by_string_prefix() -> Bool {
  let prefix = "v2.workflow.bash"
  let sibling = "v2.workflow.bash_command_fold_serialize"
  let declared = any(target_ast_vocab_module_prefixes, key => key == prefix)
  let matches_as_string_prefix = starts_with(sibling, prefix)
  let is_not_namespace_descendant = !starts_with(sibling, concat(prefix, "."))
  declared && matches_as_string_prefix && is_not_namespace_descendant
}

test fn witness_the_prefix_grain_axes_are_the_prefix_matching_ones() -> Bool {
  let module_prefix_grain = confinement_axis_is_prefix_grain(axis: VocabularyModulePrefix)
  let edge_prefix_grain = confinement_axis_is_prefix_grain(axis: RealizationEdgePathPrefix)
  module_prefix_grain && edge_prefix_grain
}

test fn witness_the_exact_module_axis_is_not_prefix_grain() -> Bool {
  !confinement_axis_is_prefix_grain(axis: ExactVocabularyModule)
}

test fn witness_the_exception_unit_axis_is_not_prefix_grain() -> Bool {
  !confinement_axis_is_prefix_grain(axis: DeclaredExceptionUnit)
}

test fn witness_the_prefix_grain_keys_are_a_proper_part_of_the_surface() -> Bool {
  count(confinement_surface_prefix_grain_keys()) < confinement_witness_roster_total()
}

test fn witness_the_denominator_subject_count_matches_the_real_rosters() -> Bool {
  census_denominator_subject_count(
    denominator: confinement_surface_denominator(revision: confinement_witness_revision()),
  ) == confinement_witness_roster_total()
}
