module test.claim.resolved_call_emission_identity_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// PERMANENT REGRESSION CONTROL for post-resolution callable identity at Rust emission (v1.std.core
// CallTargetIdentity, v1.compiler.infer_lookup resolved_plain_call_target_for_outcome, v1.compiler.emit_rust
// emit_typed_call). THE DEFECT: a call's target was decided TWICE. Inference resolved the callee
// with the module's imports in hand; emission then re-decided it from the authored LEAF SPELLING --
// map_contains_key(rt_functions(), func) -- at a grain where those imports no longer exist. An
// explicitly imported v2 declaration whose name collides with a v1_rt bridge name was therefore
// emitted as the unrelated primitive. That is DESIGN's authority-substitution class: resolution
// held the answer and a second mechanism answered for it. THE REPAIR: the resolver records what it
// chose, and emission reads it. WHAT MAKES THESE ROWS DISCRIMINATING RATHER THAN A SNAPSHOT: the
// positive traps and the negative traps differ only in whether the called name resolves to a
// declaration, so an emitter that reverted to name matching would flip the imported-declaration
// rows red while leaving the runtime-primitive rows green, and an emitter that stopped consulting
// the primitive projection roster at all would do the opposite. Neither direction can be satisfied
// by editing one arm. map_insert is deliberately unclassified here: v2.std.collection carries both
// a host-binding row and an authored modeled body and no authority decides which owns a call, so
// this control consumes the existing projection roster and does not reclassify that specimen.
// dissolve-on: never -- emission may change target SPELLING, but it may never reintroduce name
// lookup after source resolution.

// BOUNDARY CONTROL 1. The real two-String substring primitive has no declaration to resolve to,
// so it stays runtime-bound. This is the arm that would go red if the repair had made emission
// stop reaching the bridge at all.
test fn w_two_string_substring_contains_stays_runtime_bound() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.runtime_substring_contains_probe\nimport std.types { Bool, String }\nfn probe(s: String, sub: String) -> Bool { contains(s, sub) }\n",
    "src/test_claim_runtime_substring_contains_probe.rs",
    ["v1_rt::contains("],
    []
  )
}

// BOUNDARY CONTROL 2. An EXACT declaration carrying a primitive projection row stays
// host-lowered -- the identity is what selects the bridge, and it selects it here.
test fn w_primitive_bound_empty_map_stays_runtime_bound() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.runtime_empty_map_probe\nimport std.types { Int, String, Map }\nimport std.occurrence_identity { OccurrenceId }\nimport std.algebra { empty_map }\nfn probe() -> Map<String, Int> { empty_map() }\n",
    "src/test_claim_runtime_empty_map_probe.rs",
    ["v1_rt::rc_empty_map"],
    ["v2_std_collection::empty_map("]
  )
}

// THE DISCRIMINATING RED, in its first live name. `contains` is both a v1_rt bridge name and an
// imported std.algebra declaration; before the repair the leaf spelling won and this emitted
// the unrelated two-String primitive. The declaration's emitted path is crate::std_algebra since
// gunbc#13860 retired v2.std.algebra into std.algebra; the positive expectation named the retired
// module and so failed on a correct emission until it was repointed.
test fn w_imported_generic_contains_keeps_declared_identity() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.declared_contains_probe\nimport std.types { Int, Bool }\nimport std.occurrence_identity { OccurrenceId }\nimport std.algebra { FreeMonoid, contains }\nfn int_eq(left: Int, right: Int) -> Bool { left == right }\nfn probe(xs: FreeMonoid<Int>) -> Bool { contains(xs: xs, item: 1, eq: int_eq) }\n",
    "src/test_claim_declared_contains_probe.rs",
    ["crate::std_algebra::contains("],
    ["v1_rt::contains("]
  )
}

// THE SAME MECHANISM IN ITS SECOND LIVE NAME, AND THE ONE THAT PROVES ProjectionFidelity IS
// READ. `map_get` HAS a projection roster row, so a repair that treated any roster row as
// "lower to the bridge" would go red here: the row is DivergentProjection -- the declaration
// returns Outcome<Optional<V>> and the primitive returns Optional<V> -- and the declaration is
// what the author called. It is emitted from v2.std.witness since gunbc#13872 moved map_get_checked
// there out of the retired v2.std.collection.
test fn w_divergent_map_get_checked_keeps_declared_outcome_identity() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.declared_map_get_probe\nimport std.types { Int, String, Map }\nimport std.occurrence_identity { OccurrenceId }\nimport v2.std.witness { map_get_checked }\nimport v2.std.diagnostic { Outcome }\nimport std.optional { Optional }\nfn probe(m: Map<String, Int>) -> Outcome<Optional<Int>> { map_get_checked(m: m, key: \"key\") }\n",
    "src/test_claim_declared_map_get_probe.rs",
    ["crate::v2_std_witness::map_get_checked("],
    ["v1_rt::map_get("]
  )
}

// A LOCAL DECLARATION UNRELATED TO ANY PRIMITIVE. Three Int parameters against the bridge's two
// Strings: nothing about this call is the primitive except the four letters of its name.
test fn w_unrelated_same_named_declaration_never_becomes_runtime_primitive() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.local_contains_probe\nimport std.types { Int }\nfn contains(left: Int, right: Int, third: Int) -> Int { left + right + third }\nfn probe() -> Int { contains(1, 2, 3) }\n",
    "src/test_claim_local_contains_probe.rs",
    ["contains(1, 2, 3)"],
    ["v1_rt::contains("]
  )
}

// A CARRIER DEFECT THE REPAIR EXPOSED RATHER THAN INTRODUCED. Recording a target on ExprCall
// made call-initialized product data reach the literal/mock path, because the cross-reference
// classifier did not name ExprCall as cross-referencing. It is, and the excluded string is the
// mock path's own refusal text, so this row cannot pass by the call simply vanishing.
test fn w_product_data_call_initializer_reaches_typed_call_emission() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.product_data_call_probe\nimport std.types { String }\ntype ProbeIdentity { slug: String }\nfn make_probe_identity() -> ProbeIdentity { ProbeIdentity { slug: \"probe\" } }\ndata probe_identity: ProbeIdentity = make_probe_identity()\n",
    "src/test_claim_product_data_call_probe.rs",
    ["make_probe_identity()"],
    ["unsupported mock expression"]
  )
}

// THE REFUSAL IS REACHABLE AND IS NOT WHAT AN ORDINARY CALL GETS. An unqualified builtin call
// resolves to a runtime primitive and lowers through the bridge; the excluded string is the
// emitter's own Undetermined refusal, so this row goes red if a resolved call ever falls through
// to that arm.
test fn w_resolved_signature_owner_selects_runtime_primitive() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.resolved_signature_owner_probe\nimport std.types { Int, String, Map }\nfn probe(m: Map<String, Int>) -> Map<String, Int> { map_insert(m, \"key\", 1) }\n",
    "src/test_claim_resolved_signature_owner_probe.rs",
    ["v1_rt::rc_map_insert("],
    ["call target identity was not established"]
  )
}

// Homonym vs the std.algebra HostRealizedSeam: a same-named ordinary fn must keep its authored
// body. The name-keyed rust_host_string_op_fn_emit arm would have written v1_rt::string_contains
// here; selection is the projection row for std.algebra string_contains only.
test fn w_homonym_string_contains_keeps_authored_body() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.homonym_string_contains_probe\nimport std.types { Bool, String }\nfn string_contains(s: String, pattern: String) -> Bool { false }\nfn probe() -> Bool { string_contains(s: \"haystack\", pattern: \"stack\") }\n",
    "src/test_claim_homonym_string_contains_probe.rs",
    ["false"],
    ["v1_rt::string_contains("]
  )
}

// The rostered declaration reaches the bridge.
test fn w_algebra_string_contains_delegate_reaches_the_bridge() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.algebra_string_contains_probe\nimport std.types { Bool, String }\nimport std.algebra { string_contains }\nfn probe() -> Bool { string_contains(s: \"haystack\", pattern: \"stack\") }\n",
    "src/test_claim_algebra_string_contains_probe.rs",
    ["v1_rt::string_contains("],
    []
  )
}

// std.host_text chars (operator ruling H4) reaches its Rust realization BY DECLARATION: the imported
// HostRealizedSeam is emitted as the v1_rt::chars bridge, selected by its projection row.
test fn w_host_text_chars_reaches_the_bridge() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.host_text_chars_probe\nimport std.types { Char, List }\nimport std.host_text { chars }\nfn probe() -> List<Char> { chars(text: \"a\") }\n",
    "src/test_claim_host_text_chars_probe.rs",
    ["v1_rt::chars("],
    []
  )
}

// A same-named ordinary fn keeps its authored body: realization is keyed by std.host_text's
// declaration, never by the spelling `chars`.
test fn w_homonym_chars_keeps_authored_body() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.homonym_chars_probe\nimport std.integer { Int }\nfn chars(text: Int) -> Int { 424242 }\nfn probe() -> Int { chars(text: 1) }\n",
    "src/test_claim_homonym_chars_probe.rs",
    ["424242"],
    ["v1_rt::chars("]
  )
}


// std.algebra list_push (the #14751 declaration) reaches its Rust realization BY DECLARATION: the
// imported HostRealizedSeam is emitted as the v1_rt::rc_list_push bridge, selected by its projection
// row, and is NOT emitted as a self-recursive call to itself.
test fn w_algebra_list_push_reaches_the_bridge() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.algebra_list_push_probe\nimport std.types { Int, List }\nimport std.algebra { list_push }\nfn probe() -> List<Int> { list_push(xs: [1], item: 2) }\n",
    "src/test_claim_algebra_list_push_probe.rs",
    ["v1_rt::rc_list_push("],
    []
  )
}

// A same-named ordinary fn keeps its authored body: the bridge is keyed by std.algebra's declaration
// through its projection row, never by the spelling `list_push`.
test fn w_homonym_list_push_keeps_authored_body() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.homonym_list_push_probe\nimport std.integer { Int }\nfn list_push(xs: Int, item: Int) -> Int { 424243 }\nfn probe() -> Int { list_push(xs: 1, item: 2) }\n",
    "src/test_claim_homonym_list_push_probe.rs",
    ["424243"],
    ["v1_rt::rc_list_push("]
  )
}

// std.integer parse_int (the parse_int home wave) reaches its Rust realization BY DECLARATION: the imported
// HostRealizedSeam is emitted as the v1_rt::parse_int bridge, selected by its projection row, and is NOT
// emitted as a self-recursive call to itself.
test fn w_integer_parse_int_reaches_the_bridge() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.integer_parse_int_probe\nimport std.types { Int, String }\nimport std.integer { parse_int }\nfn probe(t: String) -> Int? { parse_int(s: t) }\n",
    "src/test_claim_integer_parse_int_probe.rs",
    ["v1_rt::parse_int("],
    []
  )
}

// A same-named ordinary fn keeps its authored body: the bridge is keyed by std.integer's declaration through
// its projection row, never by the spelling `parse_int`.
test fn w_homonym_parse_int_keeps_authored_body() -> Bool {
  compile_dag_rust_emit_check(
    "module test.claim.homonym_parse_int_probe\nimport std.integer { Int }\nfn parse_int(s: Int) -> Int { 424247 }\nfn probe() -> Int { parse_int(s: 1) }\n",
    "src/test_claim_homonym_parse_int_probe.rs",
    ["424247"],
    ["v1_rt::parse_int("]
  )
}
