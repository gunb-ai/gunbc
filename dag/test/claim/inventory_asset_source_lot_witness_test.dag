module test.claim.inventory_asset_source_lot_witness_test

import product.inventory {
  AssetSourceLotStanding,
  AssetSourceLotUnobserved,
  AssetSourceLotResolved,
  AssetSourceLotEvidenceDuplicate,
  AssetSourceLotConflict,
  asset_source_lot_standing,
  InventoryEvent,
  InventoryLotIdentity,
  QuantityInstalled,
  InstallFromAvailable,
  inventory_lot_allocator_initial,
  mint_inventory_lot_identity,
}
import product.placement_supply { PhysicalAssetIdentity }
import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.minted_identity { minted_id_eq }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE DISCRIMINATOR POPULATION FOR asset_source_lot_standing, and the first two rows are the reason
// this file exists rather than a single happy-path check. QuantityInstalled deliberately permits
// fewer named assets than units installed, so an implementation that required
// `identified count == quantity` before resolving ANY asset's provenance would still satisfy every
// obvious test while refusing a named asset because its SIBLING is anonymous. Row 1 is exactly that
// case and it must RESOLVE; row 2 is the same question where the population happens to be fully
// individuated. The pair is what states that full-population individuation is not a prerequisite for
// one asset's lot, and that the two properties are separate questions.

fn lot_a() -> InventoryLotIdentity {
  mint_inventory_lot_identity(alloc: inventory_lot_allocator_initial()).id
}

fn lot_b() -> InventoryLotIdentity {
  let first = mint_inventory_lot_identity(alloc: inventory_lot_allocator_initial())
  mint_inventory_lot_identity(alloc: first.alloc).id
}

fn requested() -> PhysicalAssetIdentity {
  "spool-a" as PhysicalAssetIdentity
}

fn other() -> PhysicalAssetIdentity {
  "spool-b" as PhysicalAssetIdentity
}

fn install(lot: InventoryLotIdentity, quantity: Nat, assets: List<PhysicalAssetIdentity>) -> InventoryEvent {
  QuantityInstalled { lot: lot, quantity: quantity, origin: InstallFromAvailable, assets: assets }
}

fn resolves_to_lot(events: List<InventoryEvent>, lot: InventoryLotIdentity) -> Bool {
  match asset_source_lot_standing(events: events, asset: requested()) {
    AssetSourceLotResolved { asset: a, lot: l, event_ordinal: _ } =>
      a as String == "spool-a" && minted_id_eq(left: l, right: lot)
    AssetSourceLotUnobserved { asset: _ } => false
    AssetSourceLotEvidenceDuplicate { asset: _, occurrences: _ } => false
    AssetSourceLotConflict { asset: _, first_lot: _, further_lots: _ } => false
  }
}

// ROW 1 -- the load-bearing one. Two units installed, only the requested asset named. Its provenance
// is unambiguous and must resolve; the anonymous sibling is evidence about a different subject.
test fn w_a_named_asset_resolves_even_when_its_sibling_is_anonymous() -> Bool {
  resolves_to_lot(events: [install(lot: lot_a(), quantity: 2, assets: [requested()])], lot: lot_a())
}

// ROW 2 -- the same question with the population fully individuated. Pairing it with row 1 is what
// proves the two properties were not fused.
test fn w_a_named_asset_resolves_when_the_population_is_fully_individuated() -> Bool {
  resolves_to_lot(events: [install(lot: lot_a(), quantity: 2, assets: [requested(), other()])], lot: lot_a())
}

// ROW 3 -- the same asset named twice in one event list is malformed evidence, not one sighting.
test fn w_an_asset_named_twice_in_one_event_refuses_as_duplicate() -> Bool {
  match asset_source_lot_standing(
    events: [install(lot: lot_a(), quantity: 2, assets: [requested(), requested()])],
    asset: requested()
  ) {
    AssetSourceLotEvidenceDuplicate { asset: _, occurrences: n } => n == 2
    AssetSourceLotResolved { asset: _, lot: _, event_ordinal: _ } => false
    AssetSourceLotUnobserved { asset: _ } => false
    AssetSourceLotConflict { asset: _, first_lot: _, further_lots: _ } => false
  }
}

// ROW 4 -- two lots claim the asset. Conflict outranks duplicate because naming both lots is the
// more actionable statement; reporting only "seen twice" would discard what a reader needs.
test fn w_an_asset_claimed_by_two_lots_refuses_naming_both() -> Bool {
  match asset_source_lot_standing(
    events: [
      install(lot: lot_a(), quantity: 1, assets: [requested()]),
      install(lot: lot_b(), quantity: 1, assets: [requested()]),
    ],
    asset: requested()
  ) {
    AssetSourceLotConflict { asset: _, first_lot: f, further_lots: r } =>
      minted_id_eq(left: f, right: lot_a()) && count(r) == 1
    AssetSourceLotEvidenceDuplicate { asset: _, occurrences: _ } => false
    AssetSourceLotResolved { asset: _, lot: _, event_ordinal: _ } => false
    AssetSourceLotUnobserved { asset: _ } => false
  }
}

// ROW 5 -- an installation that names only a DIFFERENT asset says nothing about this one. Absent is
// not the same as resolved-to-nothing, and it must not borrow the sibling's lot.
test fn w_an_unnamed_asset_is_unobserved_not_resolved() -> Bool {
  match asset_source_lot_standing(
    events: [install(lot: lot_a(), quantity: 2, assets: [other()])],
    asset: requested()
  ) {
    AssetSourceLotUnobserved { asset: a } => a as String == "spool-a"
    AssetSourceLotResolved { asset: _, lot: _, event_ordinal: _ } => false
    AssetSourceLotEvidenceDuplicate { asset: _, occurrences: _ } => false
    AssetSourceLotConflict { asset: _, first_lot: _, further_lots: _ } => false
  }
}

// ROW 6 -- the day-one positive control: one event per spool, quantity 1, singleton asset list. At
// this shape exact attribution and full individuation coincide, which is precisely why the rows
// above exist rather than this one standing alone.
test fn w_the_day_one_singleton_event_resolves() -> Bool {
  resolves_to_lot(events: [install(lot: lot_a(), quantity: 1, assets: [requested()])], lot: lot_a())
}

// The empty ledger observes nothing. Without it every arm above could be satisfied by a function
// that answered Unobserved only because it never iterated.
test fn w_an_empty_ledger_observes_nothing() -> Bool {
  match asset_source_lot_standing(events: [], asset: requested()) {
    AssetSourceLotUnobserved { asset: a } => a as String == "spool-a"
    AssetSourceLotResolved { asset: _, lot: _, event_ordinal: _ } => false
    AssetSourceLotEvidenceDuplicate { asset: _, occurrences: _ } => false
    AssetSourceLotConflict { asset: _, first_lot: _, further_lots: _ } => false
  }
}
