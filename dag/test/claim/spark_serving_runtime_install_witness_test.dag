module test.claim.spark_serving_runtime_install_witness


// THE INSTALL SEQUENCE, ASSERTED AS A SEQUENCE. Every claim below would pass on a realizer that
// emitted the right COMMANDS in the wrong ORDER, so the ordering claims are stated separately and
// against exact positions -- publishing before the digest is admitted is the failure this effect
// exists to prevent, and it is invisible to a set comparison.

fn install_steps() -> std.types.List<std.types.NonEmptyStr> {
  match realize_spark_serving_install_effect_command(
    effect: gunbc.spark.serving_realization.InstallOwnedRuntimeClosure,
    executor_login: spark_serving_default_executor_login(),
  ) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => []
    SparkServingInstallRemoteCommandsPresent { steps: sts } => map(sts, st => st.identity)
  }
}

fn step_argv(identity: String) -> std.types.List<String> {
  match realize_spark_serving_install_effect_command(
    effect: gunbc.spark.serving_realization.InstallOwnedRuntimeClosure,
    executor_login: spark_serving_default_executor_login(),
  ) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => []
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      fold(sts, init: [], f: fn(acc, st) {
        if (st.identity as String) == identity {
          match remote_operation_argv(operation: st.operation) {
            Present { value: words } => words
            Absent => acc
          }
        } else { acc }
      })
  }
}

// THE INSTRUMENT, AND WHY IT HAS ITS OWN CONTROL BELOW.
//
// The first version of this counted every element that did not match -- including the ones AFTER the
// match -- so for any identity appearing exactly once it returned `length - 2`, the same number for
// every step. Every ordering comparison was therefore between two equal values, `<` was false
// everywhere, and three claims that read as order assertions were measuring nothing. They failed in
// CI rather than passing, which is the lucky direction; an off-by-one that made them all TRUE would
// have shipped three green claims about an order nobody checked.
//
// The lesson is the general one about instruments: these three claims were only ever as good as
// index_of, and nothing asserted index_of. So it stops scanning once it matches, and returns -1 for
// an absent identity so a typo'd step name reads as a loud failure rather than a plausible index.
type IndexScan { found: Bool, idx: Int }

fn pull_steps() -> std.types.List<std.types.NonEmptyStr> {
  match realize_spark_serving_install_effect_command(
    effect: gunbc.spark.serving_realization.MaterializeModelArtifact,
    executor_login: spark_serving_default_executor_login(),
  ) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => []
    SparkServingInstallRemoteCommandsPresent { steps: sts } => map(sts, st => st.identity)
  }
}

// Returns Absent when the step is not present at all, so a claim over a missing step refuses rather
// than reading an empty argv as a satisfied condition.
fn pull_step_argv(identity: String) -> std.types.List<String>? {
  match realize_spark_serving_install_effect_command(
    effect: gunbc.spark.serving_realization.MaterializeModelArtifact,
    executor_login: spark_serving_default_executor_login(),
  ) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => none
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      fold(sts, init: none, f: fn(acc, st) {
        if (st.identity as String) == identity {
          remote_operation_argv(operation: st.operation)
        } else {
          acc
        }
      })
  }
}

fn index_of(identity: String) -> Int {
  let scan = fold(
    install_steps(),
    init: IndexScan { found: false, idx: 0 },
    f: fn(acc, id) {
      if acc.found {
        acc
      } else {
        if (id as String) == identity {
          IndexScan { found: true, idx: acc.idx }
        } else {
          IndexScan { found: false, idx: acc.idx + 1 }
        }
      }
    },
  )
  if scan.found { scan.idx } else { 0 - 1 }
}

// THE CONTROL ON THE INSTRUMENT ITSELF. Distinct constants, not a Boolean: asserting only that two
// indices differ would pass on the broken version for any two identities where one was absent.
// THE EXPECTATIONS ARE DERIVED FROM THE SEQUENCE, not spelled beside it.
//
// This control pinned literal step names and literal positions, so it broke when the publication
// split renamed `reset-attempt-staging` and moved the receipt from index 9 to 10 -- and it broke as a
// silent `false`, not as a missing name, because `index_of` answers -1 for a step that is not there.
// That is a control failing for a reason unrelated to what it controls.
//
// The subject here is the HELPER's contract, and the sequence is pinned exactly once, by
// `install_steps_are_named_in_execution_order`. So the positions are read back from the sequence
// itself: first is 0, last is length-1, an interior step reports its own index, and an absent one
// reports -1. That still proves `index_of` reports REAL positions rather than a constant -- the bug
// it was written for, where it returned length-2 for every identity -- while surviving any rename
// that leaves the ordering claim to catch the ordering.
// Indexing a list answers `NonEmptyStr?`, and reading the step back with `as String` did not
// eliminate that: an out-of-range index handed `index_of` the literal text `Absent`, which reports
// -1 and fails the assertion for a reason that has nothing to do with the helper under test. The
// compiler now refuses the cast; the absent arm keeps that failure mode visible by name rather than
// disguising it as a position mismatch.
fn install_step_at(steps: List<NonEmptyStr>, index: Int) -> String {
  match steps[index] {
    Present { value: step } => step as String
    Absent => "install-step-index-out-of-range"
  }
}

test fn index_of_reports_real_positions_and_refuses_absent_ones() -> Bool {
  let steps = install_steps()
  let n = length(steps)
  match steps.first() {
    Absent => false
    Present { value: head } =>
      index_of(identity: head as String) == 0
        && index_of(identity: install_step_at(steps: steps, index: n - 1)) == n - 1
        && index_of(identity: install_step_at(steps: steps, index: 3)) == 3
        && index_of(identity: "no-such-step") == 0 - 1
        && n > 4
  }
}

// THE EFFECT REALIZES AT ALL. It refused entirely until this change, so the plan could never select
// it however well the rest of the vertical worked.
test fn install_owned_runtime_closure_realizes() -> Bool {
  length(install_steps()) == 14
}

// The named steps, in order. Asserted positionally because order is the load-bearing property.
test fn install_steps_are_named_in_execution_order() -> Bool {
  join(map(install_steps(), id => id as String), ",")
    == "ensure-runtimes-parent,reset-attempt-workspace,create-attempt-workspace,download-archive,write-checksum-manifest,admit-archive-digest,reset-staging-tree,create-staging-tree,extract-archive,require-staged-entrypoint,write-materialization-receipt,reset-unpublished-runtime-root,publish-runtime-root,discard-attempt-workspace"
}

// THE DISCRIMINATING CLAIM. `sha256sum <archive>` exits zero on any readable file and puts its answer
// on stdout, so a realizer that froze THAT would pass every other claim in this file while verifying
// nothing. The verifying argv must carry --check and --status, and must NOT name the archive.
test fn the_digest_step_compares_rather_than_computes() -> Bool {
  let argv = step_argv(identity: "admit-archive-digest")
  length(argv) == 4
    && argv[0] == "sha256sum"
    && argv[1] == "--check"
    && argv[2] == "--status"
    && string_contains(argv[3], "archive.sha256")
    && !any(argv, w => string_contains(w, ".tar."))
}

// And the expectation is FILE BYTES, not an argv word: the manifest step carries no argv at all.
test fn the_expected_digest_travels_as_frozen_bytes() -> Bool {
  length(step_argv(identity: "write-checksum-manifest")) == 0
}

// The download names the cited locator, so the bytes fetched are the bytes the release row admits.
test fn the_download_names_the_cited_release_locator() -> Bool {
  let argv = step_argv(identity: "download-archive")
  any(argv, w => string_contains(w, ollama_required_release.version as String))
    && any(argv, w => w == "-fsSL")
}

// PUBLISH HAPPENS AFTER ADMISSION. A sequence that published first would still contain every command
// this file names.
test fn publication_follows_digest_admission_and_entrypoint_check() -> Bool {
  index_of(identity: "admit-archive-digest") < index_of(identity: "publish-runtime-root")
    && index_of(identity: "require-staged-entrypoint") < index_of(identity: "publish-runtime-root")
    && index_of(identity: "download-archive") < index_of(identity: "admit-archive-digest")
}

// RETIRED, WITH ITS REASON: `the_materialization_receipt_is_written_last`.
//
// It asserted the receipt occupied the final position, which was true of a sequence that wrote the
// receipt INTO THE PUBLISHED ROOT after publishing. That sequence had a hole: publish could succeed
// and the receipt write fail, leaving a complete runtime every observer reports incomplete. The
// receipt is now written into staging and arrives by the publishing rename, so it is no longer last
// and the old assertion is false of the correct sequence. Renumbering it would have preserved the
// spelling of a claim whose subject moved; the obligation it carried -- a receipt cannot exist unless
// the tree completed -- is carried below, and carried more strongly.

// THE RECEIPT CANNOT OUTLIVE A FAILED PUBLISH, which is the property the retired claim was reaching
// for. It is written after the entrypoint check (so it names a tree that passed it) and before the
// publish (so it travels with the rename). Both bounds are asserted: written after the check alone
// would allow a post-publish write, and before the publish alone would allow it to precede extraction.
test fn the_materialization_receipt_travels_with_the_publish() -> Bool {
  index_of(identity: "require-staged-entrypoint") < index_of(identity: "write-materialization-receipt")
    && index_of(identity: "write-materialization-receipt") < index_of(identity: "publish-runtime-root")
}

// PUBLICATION CAN REPLACE AN EXISTING TREE. `mv -T` refuses a populated destination, so without the
// reset step a host interrupted once could never republish and the incomplete state would be
// permanent rather than repairable. Asserted as an ordering, because a reset AFTER the publish is
// the same commands in an order that deletes the runtime it just installed.
test fn publication_can_replace_an_incomplete_tree() -> Bool {
  index_of(identity: "reset-unpublished-runtime-root") < index_of(identity: "publish-runtime-root")
    && index_of(identity: "reset-unpublished-runtime-root") > index_of(identity: "require-staged-entrypoint")
}

// THE ACQUISITION WORKSPACE IS NOT PUBLISHED. The archive and its checksum manifest used to live
// inside the staging tree, so `mv -T` published a ~1.5 GB tarball into a content-addressed runtime
// root.
//
// The claim reads PATHS, not step names, and it reads the two ends: the archive lands in the
// workspace, and the tree handed to `mv` is the staging root with no workspace path in it. Extraction
// is deliberately not asserted to avoid the workspace -- it reads the archive FROM there and writes
// INTO staging, so naming both roots is correct for that step and only that step. Asserting its
// absence would have been a claim about the wrong thing that happened to be false.
test fn the_downloaded_archive_is_not_published_into_the_runtime() -> Bool {
  let download = step_argv(identity: "download-archive")
  let publish = step_argv(identity: "publish-runtime-root")
  any(download, w => string_contains(w, "/.workspace-"))
    && !any(download, w => string_contains(w, "/.staging-"))
    && any(publish, w => string_contains(w, "/.staging-"))
    && !any(publish, w => string_contains(w, "/.workspace-"))
    && index_of(identity: "discard-attempt-workspace") > index_of(identity: "publish-runtime-root")
}

// BOTH SCRATCH ROOTS ARE RESET BEFORE THEY ARE USED. Without this a previous interrupted attempt's
// partial contents are written over, producing a tree that is neither attempt. Asserted for the
// workspace and the staging tree separately, because they are now separate locations with separate
// lifetimes and a single claim over one would leave the other unguarded.
test fn both_scratch_roots_are_reset_before_they_are_created() -> Bool {
  index_of(identity: "reset-attempt-workspace") < index_of(identity: "create-attempt-workspace")
    && index_of(identity: "create-attempt-workspace") < index_of(identity: "download-archive")
    && index_of(identity: "reset-staging-tree") < index_of(identity: "create-staging-tree")
    && index_of(identity: "create-staging-tree") < index_of(identity: "extract-archive")
}

// THE FRONTIER MOVED, AND THIS CLAIM MOVED WITH IT. It previously asserted MaterializeModelArtifact was
// unrealized, and said in its own comment that landing the realizer must fail it rather than let a
// stale frontier description stand. The realizer landed, so this now asserts the opposite.
//
// THE EXECUTABLE MUST BE THE PLANNED ONE. A bare "ollama" would resolve through ambient PATH -- a
// second unmodeled runtime authority, and on a bare host it resolves to nothing at all, which is the
// exact host this branch exists to restore. The claim asserts the content-addressed path AND that it
// RETIRED WITH A RECEIPT: five claims stood here -- one on `ollama pull`'s argv and four on the
// readiness ladder that preceded it. They are gone because the remedy they described is gone.
//
// WHAT REPLACED IT. MaterializeModelArtifact fetches the manifest and every blob it names and writes
// them into the model store directly, verifying each against the digest frozen in
// gunbc.ollama_model_resolution. It is not an API client, so there is no server to wait for and the
// readiness ladder has nothing left to protect -- keeping it would have been a wait for a condition
// no step in the sequence depends on. The claims that replace these live in
// test.claim.spark_serving_model_materialization_witness, asserted against the sequence that now
// exists rather than against the one that used to.
//
// WHAT IS NOT ESTABLISHED, AND IS NOT BEING QUIETLY ASSUMED: whether a RUNNING ollama picks up a
// model whose manifest and blobs appeared on disk beneath it, or whether it holds a cached view
// until it restarts. The old pull went through the API and so could not raise the question; direct
// file placement does. The model-store observation reads the filesystem and would report convergence
// either way, so the fact that would expose a stale in-memory view is the TERMINAL HEALTH generation
// -- which is exactly the probe this lane already runs after an empty replan. The first srv5
// materialization decides it, and if the answer is that a restart is owed, the remedy belongs on the
// activity member (a materialized model invalidates a running server's view) rather than as a
// readiness wait bolted to the front.

// PULLING IS NOT PART OF INSTALLING THE RUNTIME. The two effects are separate members with separate
// remedies, and fusing them would make a model repair reinstall the runtime -- so the runtime
// closure's step list must not contain the pull.
test fn the_runtime_install_sequence_does_not_pull_the_model() -> Bool {
  index_of(identity: "pull-model-artifact") == 0 - 1
    && index_of(identity: "await-serving-api") == 0 - 1
    && length(install_steps()) == 14
}
