module test.claim.srv3_host_effect_realize_witness

import std.logic { Bool }
import gunbc.host_effect {
  OsInstallActuatorToolchainEnsure,
  HostOs,
  BmcController,
  host_effect_identity_evidence,
  LocalShell,
  EmitArtifactThenThinRun,
  BootstrapFragment,
  ThinInvocation,
}
import gunbc.host_effect_realize { host_effect_apply }
import gunbc.fleet_intent { srv1_host }
import std.realization_reconcile { NotConverged }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn os_install_actuator_toolchain_ensure_rejects_bmc_controller_target() -> Bool {
  match host_effect_apply(
    target: BmcController { node: srv1_host },
    effect: OsInstallActuatorToolchainEnsure {},
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "OsInstallActuatorToolchainEnsure")
    _ => false
  }
}

test fn os_install_actuator_toolchain_ensure_rejects_emit_artifact_transport() -> Bool {
  match host_effect_apply(
    target: HostOs { node: srv1_host },
    effect: OsInstallActuatorToolchainEnsure {},
    evidence: host_effect_identity_evidence,
    transport: EmitArtifactThenThinRun {
      bootstrap: BootstrapFragment { script: "true" },
      invocation: ThinInvocation { argv: ["true"] },
    },
  ) {
    NotConverged { reason: why, applied: _ } =>
      string_contains(s: why, pattern: "EmitArtifactThenThinRun")
    _ => false
  }
}
