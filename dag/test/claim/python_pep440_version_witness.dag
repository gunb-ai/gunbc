module test.claim.python_pep440_version_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn release_1() -> Pep440ReleaseSegments {
  Pep440ReleaseSegments { first: 1, rest: [] }
}

fn release_1_0() -> Pep440ReleaseSegments {
  Pep440ReleaseSegments { first: 1, rest: [0] }
}

fn release_2_0() -> Pep440ReleaseSegments {
  Pep440ReleaseSegments { first: 2, rest: [0] }
}

fn release_2_2() -> Pep440ReleaseSegments {
  Pep440ReleaseSegments { first: 2, rest: [2] }
}

fn v_final_1_0() -> Pep440Version {
  Pep440Version {
    public: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: none,
      post_release: none,
      dev_release: none
    },
    local: []
  }
}

fn v_alpha_1_0a1() -> Pep440Version {
  Pep440Version {
    public: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: Present {
        value: Pep440PreRelease { phase: Pep440Alpha, number: 1 }
      },
      post_release: none,
      dev_release: none
    },
    local: []
  }
}

fn v_epoch_1_2_0() -> Pep440Version {
  Pep440Version {
    public: Pep440PublicVersion {
      epoch: 1,
      release_segments: release_2_0(),
      pre_release: none,
      post_release: none,
      dev_release: none
    },
    local: []
  }
}

fn v_post_1_0_post1() -> Pep440Version {
  Pep440Version {
    public: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: none,
      post_release: Present { value: 1 },
      dev_release: none
    },
    local: []
  }
}

fn v_dev_1_0_dev456() -> Pep440Version {
  Pep440Version {
    public: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: none,
      post_release: none,
      dev_release: Present { value: 456 }
    },
    local: []
  }
}

fn v_local_1_0_abc_5() -> Pep440Version {
  Pep440Version {
    public: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: none,
      post_release: none,
      dev_release: none
    },
    local: [
      Pep440LocalLexicographic { label: "abc" },
      Pep440LocalNumeric { value: 5 }
    ]
  }
}

test fn w_final_release_label() -> Bool {
  pep440_version_label(v: v_final_1_0()) == "1.0"
}

test fn w_alpha_pre_release_label() -> Bool {
  pep440_version_label(v: v_alpha_1_0a1()) == "1.0a1"
}

test fn w_epoch_prefix_label() -> Bool {
  pep440_version_label(v: v_epoch_1_2_0()) == "1!2.0"
}

test fn w_post_release_label() -> Bool {
  pep440_version_label(v: v_post_1_0_post1()) == "1.0.post1"
}

test fn w_dev_release_label() -> Bool {
  pep440_version_label(v: v_dev_1_0_dev456()) == "1.0.dev456"
}

test fn w_local_version_label() -> Bool {
  pep440_version_label(v: v_local_1_0_abc_5()) == "1.0+abc.5"
}

test fn w_spec_citation_present() -> Bool {
  string_contains(s: pep440_spec_url, pattern: "packaging.python.org")
    && string_contains(s: pep440_spec_label, pattern: "PEP 440")
}

test fn w_version_specifier_clause_label() -> Bool {
  pep440_version_specifier_label(spec: [
    {
      op: Pep440CompatibleRelease,
      version: Pep440PublicVersion {
        epoch: 0,
        release_segments: release_2_2(),
        pre_release: none,
        post_release: none,
        dev_release: none
      }
    },
    {
      op: Pep440InclusiveAtLeast,
      version: Pep440PublicVersion {
        epoch: 0,
        release_segments: release_1_0(),
        pre_release: none,
        post_release: none,
        dev_release: none
      }
    }
  ]) == "~= 2.2, >= 1.0"
}

test fn w_discriminates_pre_release_numbers() -> Bool {
  let a1 = pep440_version_label(v: v_alpha_1_0a1())
  let a2 = pep440_version_label(v: Pep440Version {
    public: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: Present {
        value: Pep440PreRelease { phase: Pep440Alpha, number: 2 }
      },
      post_release: none,
      dev_release: none
    },
    local: []
  })
  a1 == "1.0a1" && a2 == "1.0a2" && a1 != a2
}

test fn w_version_identity_projection() -> Bool {
  pep440_version_identity(v: v_final_1_0()) == "1.0"
}

test fn w_version_specifier_constraint_projection() -> Bool {
  pep440_version_specifier_constraint(spec: [
    {
      op: Pep440InclusiveAtLeast,
      version: Pep440PublicVersion {
        epoch: 0,
        release_segments: release_1_0(),
        pre_release: none,
        post_release: none,
        dev_release: none
      }
    }
  ]) == ">= 1.0"
}

test fn w_release_segments_zero_pad_equal() -> Bool {
  pep440_compare_public(
    a: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1(),
      pre_release: none,
      post_release: none,
      dev_release: none
    },
    b: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: none,
      post_release: none,
      dev_release: none
    }
  ) == Equal
}

test fn w_structural_alpha_before_final() -> Bool {
  pep440_compare_public(
    a: v_alpha_1_0a1().public,
    b: v_final_1_0().public
  ) == Less
}

test fn w_a2_dev1_greater_than_a1() -> Bool {
  pep440_compare_public(
    a: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: Present {
        value: Pep440PreRelease { phase: Pep440Alpha, number: 2 }
      },
      post_release: none,
      dev_release: Present { value: 1 }
    },
    b: v_alpha_1_0a1().public
  ) == Greater
}

test fn w_bare_dev_before_alpha() -> Bool {
  pep440_compare_public(
    a: v_dev_1_0_dev456().public,
    b: v_alpha_1_0a1().public
  ) == Less
}

test fn w_dev_on_pre_before_same_pre() -> Bool {
  pep440_compare_public(
    a: Pep440PublicVersion {
      epoch: 0,
      release_segments: release_1_0(),
      pre_release: Present {
        value: Pep440PreRelease { phase: Pep440Alpha, number: 1 }
      },
      post_release: none,
      dev_release: Present { value: 1 }
    },
    b: v_alpha_1_0a1().public
  ) == Less
}

test fn w_min_python_interpreter_grounded() -> Bool {
  min_python_interpreter == ">= 3.11"
}

