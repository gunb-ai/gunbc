module test.claim.extdeps_round2_grounding_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn w_sql_dialect_postgres_label() -> Bool {
  extdeps.sql.migration.sql_dialect_wire_label(Postgres) == "postgres"
}

fn w_sql_dialect_mysql_not_postgres() -> Bool {
  extdeps.sql.migration.sql_dialect_wire_label(Mysql) == "mysql"
    && extdeps.sql.migration.sql_dialect_wire_label(Mysql) != extdeps.sql.migration.sql_dialect_wire_label(Postgres)
}

fn w_sql_migration_step_carries_dialect_enum() -> Bool {
  let test.claim.materialization_ladder_witness.step = SqlMigrationStep {
    name: "init",
    operation: extdeps.sql.migration.CreateTable,
    dialect: Sqlite,
    statement: "CREATE TABLE t(id INT);",
    reversible: false,
  }
  test.claim.materialization_ladder_witness.step.dialect == Sqlite
}

fn w_http_content_type_html_label() -> Bool {
  extdeps.http.server.http_content_type_wire_label(extdeps.http.server.TextHtmlUtf8) == "text/html; charset=utf-8"
}

fn w_http_content_type_plain_not_html() -> Bool {
  extdeps.http.server.http_content_type_wire_label(extdeps.http.server.TextPlainUtf8) == "text/plain; charset=utf-8"
    && extdeps.http.server.http_content_type_wire_label(extdeps.http.server.TextPlainUtf8) != extdeps.http.server.http_content_type_wire_label(extdeps.http.server.TextHtmlUtf8)
}

fn w_served_static_route_content_type_enum() -> Bool {
  let gunbc.plans.md_helpers.row = extdeps.http.server.ServedStaticRoute {
    method: v2.std.network.GET,
    path_pattern: std.http_path.PathTemplate { tokens: [] },
    body: "<html></html>",
    content_type: extdeps.http.server.TextHtmlUtf8,
    status_on_hit: 200,
  }
  gunbc.plans.md_helpers.row.content_type == extdeps.http.server.TextHtmlUtf8
}

fn w_sigv4_grounded_region_service() -> Bool {
  extdeps.cloud.cloud.aws_region_wire_label(extdeps.cloud.cloud.UsEast1) == "us-east-1"
    && extdeps.cloud.cloud.aws_service_wire_label(extdeps.cloud.cloud.S3) == "s3"
}

fn w_sigv4_auth_scheme_carries_enums() -> Bool {
  match extdeps.cloud.cloud.SigV4 { region: extdeps.cloud.cloud.UsEast1, service: extdeps.cloud.cloud.S3 } {
    SigV4 => true
    Protocol => false
    OidcToken => false
  }
}

fn w_gcp_api_endpoint_service_enum() -> Bool {
  let endpoint = extdeps.cloud.gcp.gcp.GcpApiEndpoint {
    service: extdeps.cloud.gcp.gcp.GcpStorage,
    base_url: "https://storage.googleapis.com/storage/v1",
    version: "v1",
  }
  endpoint.service == extdeps.cloud.gcp.gcp.GcpStorage
    && extdeps.cloud.gcp.gcp.gcp_service_wire_label(extdeps.cloud.gcp.gcp.GcpStorage) == "storage"
    && extdeps.cloud.gcp.gcp.gcp_service_wire_label(extdeps.cloud.gcp.gcp.GcpSts) == "sts"
}

fn w_gcp_project_id_refinement() -> Bool {
  let project = extdeps.cloud.gcp.gcp.GcpProject {
    project_id: "my-gcp-project",
    project_number: 123456789,
    name: "My Project",
  }
  project.project_id == "my-gcp-project"
}

fn w_gcp_rpc_code_grounded_and_other() -> Bool {
  let example_ok = match extdeps.cloud.gcp.errors.gcp_error_example.error.status {
    Present { value: c } => c == extdeps.cloud.gcp.errors.GcpRpcCodePermissionDenied
    Absent => false
  }
  let label_ok = extdeps.cloud.gcp.errors.gcp_rpc_code_label(extdeps.cloud.gcp.errors.GcpRpcCodePermissionDenied) == "PERMISSION_DENIED"
  let known_routes_to_known = match extdeps.cloud.gcp.errors.parse_gcp_rpc_code("NOT_FOUND") {
    GcpRpcCodeNotFound => true
    extdeps.cloud.gcp.errors.GcpRpcCodeOther { raw: _ } => false
    _ => false
  }
  let unknown_routes_to_other = match extdeps.cloud.gcp.errors.parse_gcp_rpc_code("FUTURE_CODE_X") {
    extdeps.cloud.gcp.errors.GcpRpcCodeOther { raw: r } => r == "FUTURE_CODE_X"
    _ => false
  }
  example_ok && label_ok && known_routes_to_known && unknown_routes_to_other
}

fn w_service_account_email_grounded() -> Bool {
  let sa_row = extdeps.cloud.gcp.gcp.GcpServiceAccount {
    email: "runner@my-project.iam.gserviceaccount.com",
    unique_id: "123456789",
    display_name: none,
    disabled: false,
  }
  sa_row.email == "runner@my-project.iam.gserviceaccount.com"
}

fn w_gpu_compute_capability_sm_label() -> Bool {
  let test.claim.roadmap_belt_witness.cap = extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.nvidia.nvidia, major: 8, minor: 9 }
  match extdeps.gpu.types.gpu_compute_capability_sm_label(test.claim.roadmap_belt_witness.cap) {
    extdeps.gpu.types.GpuCapabilityLabelOk { label: label } => label == "sm_8_9"
    extdeps.gpu.types.GpuCapabilityLabelRejected { reason: _ } => false
  }
}

fn w_gpu_amd_label_distinct_from_nvidia() -> Bool {
  let test.claim.roadmap_belt_witness.cap = extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.amd.amd, major: 11, minor: 0 }
  match extdeps.gpu.types.gpu_compute_capability_sm_label(test.claim.roadmap_belt_witness.cap) {
    extdeps.gpu.types.GpuCapabilityLabelOk { label: label } => label == "gfx110"
    extdeps.gpu.types.GpuCapabilityLabelRejected { reason: _ } => false
  }
}

fn w_intel_capability_label_refuses_fail_closed() -> Bool {
  let test.claim.roadmap_belt_witness.cap = extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.intel.intel, major: 1, minor: 0 }
  match extdeps.gpu.types.gpu_compute_capability_sm_label(test.claim.roadmap_belt_witness.cap) {
    extdeps.gpu.types.GpuCapabilityLabelOk { label: _ } => false
    extdeps.gpu.types.GpuCapabilityLabelRejected { reason: r } => r.vendor == extdeps.vendor.intel.intel
  }
}

fn w_gpu_facts_structured_compute_capability() -> Bool {
  let gpu = extdeps.gpu.types.GpuFacts {
    vendor: extdeps.vendor.nvidia.nvidia,
    model: "H100",
    compute_capability: extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.nvidia.nvidia, major: 9, minor: 0 },
    memory: extdeps.memory.types.MemoryFacts {
      capacity: std.measure.byte_size(80),
      memory_kind: Hbm,
    },
    supported_runtimes: [],
  }
  gpu.vendor == extdeps.vendor.nvidia.nvidia
    && match extdeps.gpu.types.gpu_compute_capability_sm_label(
      extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.nvidia.nvidia, major: 9, minor: 0 }
    ) {
      extdeps.gpu.types.GpuCapabilityLabelOk { label: label } => label == "sm_9_0"
      extdeps.gpu.types.GpuCapabilityLabelRejected { reason: _ } => false
    }
}

fn w_ampere_capability_label_refuses_fail_closed() -> Bool {
  let test.claim.roadmap_belt_witness.cap = extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.ampere.ampere, major: 1, minor: 0 }
  match extdeps.gpu.types.gpu_compute_capability_sm_label(test.claim.roadmap_belt_witness.cap) {
    extdeps.gpu.types.GpuCapabilityLabelOk { label: _ } => false
    extdeps.gpu.types.GpuCapabilityLabelRejected { reason: r } => r.vendor == extdeps.vendor.ampere.ampere
  }
}

fn w_hardware_vendor_single_authority() -> Bool {
  let accel = extdeps.gpu.types.AcceleratorFacts { vendor: extdeps.vendor.amd.amd, model: "MI300X" }
  let gpu_cap = extdeps.gpu.types.GpuComputeCapability { vendor: extdeps.vendor.amd.amd, major: 11, minor: 0 }
  accel.vendor == gpu_cap.vendor
}

test fn extdeps_round2_grounding_witnesses() -> Bool {
  w_sql_dialect_postgres_label()
    && w_sql_dialect_mysql_not_postgres()
    && w_sql_migration_step_carries_dialect_enum()
    && w_http_content_type_html_label()
    && w_http_content_type_plain_not_html()
    && w_served_static_route_content_type_enum()
    && w_sigv4_grounded_region_service()
    && w_sigv4_auth_scheme_carries_enums()
    && w_gcp_api_endpoint_service_enum()
    && w_gcp_project_id_refinement()
    && w_gcp_rpc_code_grounded_and_other()
    && w_service_account_email_grounded()
    && w_gpu_compute_capability_sm_label()
    && w_gpu_amd_label_distinct_from_nvidia()
    && w_intel_capability_label_refuses_fail_closed()
    && w_gpu_facts_structured_compute_capability()
    && w_ampere_capability_label_refuses_fail_closed()
    && w_hardware_vendor_single_authority()
}
