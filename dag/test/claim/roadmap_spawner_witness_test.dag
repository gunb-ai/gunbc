test fn witness_json_schema_field_present() -> Bool {
  let node = test.claim.roadmap_spawner.sized_derivable(id: "test-json", prs: [77], title: "Json Node")
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node], edges: [])
  let json = roadmap_spawn_request_json(doc: doc, merged: [], anchor_commit: "abc123")
  string_contains(s: json, pattern: "roadmap-spawn-request/v1")
    && string_contains(s: json, pattern: "abc123")
    && string_contains(s: json, pattern: "test-json")
    && string_contains(s: json, pattern: "Json Node")
    && string_contains(s: json, pattern: "prs_merged")
    && string_contains(s: json, pattern: "\"owner\": null")
}

test fn witness_json_satisfied_dep_in_ready() -> Bool {
  let node_a = test.claim.roadmap_spawner.accepted_node(base: test.claim.roadmap_spawner.sized_derivable(id: "parent-done-node", prs: [100], title: "A2"))
  let node_b = test.claim.roadmap_spawner.sized_derivable(id: "child-ready-node", prs: [200], title: "B2")
  let edges = [gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "child-ready-node"), parent: roadmap_spawner_nid(s: "parent-done-node") }]
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node_a, node_b], edges: edges)
  let json = roadmap_spawn_request_json(doc: doc, merged: [100], anchor_commit: "sha1")
  string_contains(s: json, pattern: "child-ready-node")
    && !string_contains(s: json, pattern: "\"node_id\": \"parent-done-node\"")
}

test fn witness_json_title_escaping() -> Bool {
  let node = test.claim.roadmap_spawner.sized_derivable(id: "escape-test", prs: [1], title: "Title \"quoted\" and \\back")
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node], edges: [])
  let json = roadmap_spawn_request_json(doc: doc, merged: [], anchor_commit: "x")
  string_contains(s: json, pattern: "Title \\\"quoted\\\" and \\\\back")
}

test fn witness_json_newline_escaping() -> Bool {
  let node = test.claim.roadmap_spawner.sized_derivable(id: "newline-test", prs: [1], title: "line one\nline two")
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node], edges: [])
  let json = roadmap_spawn_request_json(doc: doc, merged: [], anchor_commit: "x")
  string_contains(s: json, pattern: "line one\\nline two")
    && !string_contains(s: json, pattern: "line one\nline two")
}

test fn witness_spawn_frontier_ready_matches_next_spawnable() -> Bool {
  let node = test.claim.roadmap_spawner.sized_derivable(id: "frontier-ready", prs: [88], title: "Frontier Ready")
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node], edges: [])
  let frontier = spawn_frontier(doc: doc, merged: [])
  count(frontier.ready) == count(next_spawnable(doc: doc, merged: []))
    && any(frontier.ready, n => n.node == roadmap_spawner_nid(s: "frontier-ready"))
}

test fn witness_all_parents_gate_spawnability() -> Bool {
  let node_a = test.claim.roadmap_spawner.accepted_node(base: test.claim.roadmap_spawner.sized_derivable(id: "mp-a", prs: [100], title: "Node A"))
  let node_b_open = test.claim.roadmap_spawner.sized_derivable(id: "mp-b", prs: [200], title: "Node B")
  let node_b_done = test.claim.roadmap_spawner.accepted_node(base: node_b_open)
  let node_c = test.claim.roadmap_spawner.sized_derivable(id: "mp-c", prs: [300], title: "Node C")
  let edges = [
    gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "mp-c"), parent: roadmap_spawner_nid(s: "mp-a") },
    gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "mp-c"), parent: roadmap_spawner_nid(s: "mp-b") },
  ]
  let one_parent_done = next_spawnable(
    doc: test.claim.roadmap_spawner.fixture_doc(nodes: [node_a, node_b_open, node_c], edges: edges),
    merged: [100, 200])
  let both_parents_done = next_spawnable(
    doc: test.claim.roadmap_spawner.fixture_doc(nodes: [node_a, node_b_done, node_c], edges: edges),
    merged: [100, 200])
  !any(one_parent_done, n => n.node == roadmap_spawner_nid(s: "mp-c"))
    && any(both_parents_done, n => n.node == roadmap_spawner_nid(s: "mp-c"))
}

test fn witness_dispatch_json_partitions_ready_upcoming_done() -> Bool {
  let node_done = test.claim.roadmap_spawner.accepted_node(base: test.claim.roadmap_spawner.sized_derivable(id: "dj-done", prs: [100], title: "Done Node"))
  let node_ready = test.claim.roadmap_spawner.sized_derivable(id: "dj-ready", prs: [200], title: "Ready Node")
  let node_gated = test.claim.roadmap_spawner.sized_derivable(id: "dj-gated", prs: [300], title: "Gated Node")
  let edges = [
    gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "dj-ready"), parent: roadmap_spawner_nid(s: "dj-done") },
    gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "dj-gated"), parent: roadmap_spawner_nid(s: "dj-ready") },
  ]
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node_done, node_ready, node_gated], edges: edges)
  let json = roadmap_dispatch_json(doc: doc, merged: [100])
  string_contains(s: json, pattern: "roadmap-dispatch/v1")
    && string_contains(s: json, pattern: "\"node_id\": \"dj-ready\"")
    && !string_contains(s: json, pattern: "\"node_id\": \"dj-done\"")
    && string_contains(s: json, pattern: "\"node_id\": \"dj-gated\", \"title\": \"Gated Node\", \"unmet_parents\": [\"dj-ready\"]")
    && string_contains(s: json, pattern: "\"done\": [\"dj-done\"]")
}

fn superseded_node(id: String, by: String, content: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_3RQ5SZ48Q7R3RWGH84BY" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: roadmap_spawner_nid(s: id),
    line: gunbc.roadmap_status.SupersededLine { by: by, content: content },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

test fn witness_superseded_unblocks_child_and_never_dispatches() -> Bool {
  let node_old = superseded_node(id: "sp-old", by: "sp-successor-lane", content: "Old Lane Row")
  let node_child = test.claim.roadmap_spawner.sized_derivable(id: "sp-child", prs: [200], title: "Child Node")
  let edges = [gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "sp-child"), parent: roadmap_spawner_nid(s: "sp-old") }]
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node_old, node_child], edges: edges)
  let spawnable = next_spawnable(doc: doc, merged: [])
  let json = roadmap_dispatch_json(doc: doc, merged: [])
  any(spawnable, n => n.node == roadmap_spawner_nid(s: "sp-child"))
    && !any(spawnable, n => n.node == roadmap_spawner_nid(s: "sp-old"))
    && string_contains(s: json, pattern: "\"superseded\": ")
    && string_contains(s: json, pattern: "\"superseded_by\": \"sp-successor-lane\"")
    && !string_contains(s: json, pattern: "\"node_id\": \"sp-old\", \"title\"")
}

test fn witness_superseded_control_open_parent_still_gates() -> Bool {
  let node_open = gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_DY0Y547BC2HK2V12KA6T" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: roadmap_spawner_nid(s: "sp-old"),
    line: gunbc.roadmap_status.AuthoredLine { done: false, content: "Old Lane Row" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
  let node_child = test.claim.roadmap_spawner.sized_derivable(id: "sp-child", prs: [200], title: "Child Node")
  let edges = [gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "sp-child"), parent: roadmap_spawner_nid(s: "sp-old") }]
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node_open, node_child], edges: edges)
  !any(next_spawnable(doc: doc, merged: []), n => n.node == roadmap_spawner_nid(s: "sp-child"))
}
