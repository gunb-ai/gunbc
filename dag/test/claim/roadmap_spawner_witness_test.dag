module test.claim.roadmap_spawner


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn roadmap_spawner_nid(s: String) -> gunbc.roadmap_model.RoadmapNodeId { s }

fn sized_derivable(id: String, prs: List<Int>, title: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_AEFPP8RJQ523MPCZQ7WR" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: roadmap_spawner_nid(s: id),
    line: gunbc.roadmap_status.DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    sizing: gunbc.roadmap_model.Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn accepted_node(base: gunbc.roadmap_model.RoadmapNode) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_Z9KZSNBGMW86W36XPHHP" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: base.node,
    line: base.line,
    carriers: base.carriers,
    sizing: base.sizing,
    execution: base.execution,
    owner: base.owner,
    signoff: gunbc.roadmap_status.SignedOff { by: "operator", works: gunbc.roadmap_status.RedControlExecuted { witness_module: "test.fixture", witness_fn: "fixture_red_control", executed_on: "2026-07-28" }, scope_equivalent: gunbc.roadmap_status.HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] }, as_expected: true },
  }
}

fn rejected_node(base: gunbc.roadmap_model.RoadmapNode) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_BDFRJM5H1F0VB3E58P5N" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: base.node,
    line: base.line,
    carriers: base.carriers,
    sizing: base.sizing,
    execution: base.execution,
    owner: base.owner,
    signoff: gunbc.roadmap_status.SignedOff { by: "operator", works: gunbc.roadmap_status.RedControlExecuted { witness_module: "test.fixture", witness_fn: "fixture_red_control", executed_on: "2026-07-28" }, scope_equivalent: HandbackNotDelivered, as_expected: true },
  }
}

fn unsized_derivable(id: String, prs: List<Int>, title: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_NHF9FERTMRDJHGNW226Y" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: roadmap_spawner_nid(s: id),
    line: gunbc.roadmap_status.DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    sizing: Unsized,
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn fixture_section(nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>) -> gunbc.roadmap_document.RoadmapSection {
  gunbc.roadmap_document.RoadmapSection {
    title: "Test",
    elements: [std.algebra.Group { group: gunbc.roadmap_model.SectionGroup { label: "test", nodes: nodes, edges: edges } }],
  }
}

fn fixture_doc(nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>) -> gunbc.roadmap_document.RoadmapDocument {
  gunbc.roadmap_document.RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [test.claim.roadmap_spawner.fixture_section(nodes: nodes, edges: edges)],
  }
}

test fn witness_satisfied_dep_is_spawnable() -> Bool {
  let node_a = test.claim.roadmap_spawner.accepted_node(base: test.claim.roadmap_spawner.sized_derivable(id: "test-a", prs: [100], title: "Node A"))
  let node_b = test.claim.roadmap_spawner.sized_derivable(id: "test-b", prs: [200], title: "Node B")
  let edges = [gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "test-b"), parent: roadmap_spawner_nid(s: "test-a") }]
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node_a, node_b], edges: edges)
  let spawnable = next_spawnable(doc: doc, merged: [100])
  any(spawnable, n => n.node == roadmap_spawner_nid(s: "test-b"))
}

test fn witness_unsatisfied_dep_not_spawnable() -> Bool {
  let node_a = test.claim.roadmap_spawner.sized_derivable(id: "test-a", prs: [100], title: "Node A")
  let node_b = test.claim.roadmap_spawner.sized_derivable(id: "test-b", prs: [200], title: "Node B")
  let edges = [gunbc.roadmap_model.RoadmapEdge { child: roadmap_spawner_nid(s: "test-b"), parent: roadmap_spawner_nid(s: "test-a") }]
  let doc = test.claim.roadmap_spawner.fixture_doc(nodes: [node_a, node_b], edges: edges)
  let spawnable = next_spawnable(doc: doc, merged: [100])
  !any(spawnable, n => n.node == roadmap_spawner_nid(s: "test-b"))
}

