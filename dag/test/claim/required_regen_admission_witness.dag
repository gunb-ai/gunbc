module test.claim.required_regen_admission_witness

// THE HOST COPY IS PINNED HERE, not only in prose. The admission is modeled in this corpus and
// realized a second time, by hand, in the stage0 host -- which is the copy the merge gate executes,
// because the gate runs in the crate that emits v2. That fork is DECLARED, with reason, owning lane
// and trigger, at dag/gunbc/missing_mirror_admission_seed_growth.dag; these witnesses are what keeps
// the declared copy from drifting out of agreement with the modeled one, which is the failure a
// declared-but-unwitnessed fork actually produces.
import extdeps.filesystem.filesystem_io
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

// Read from the AUTHORITY itself, not assumed here: witness_every_declared_stage0_module_name_is_already_flat
// asks the partition what it actually declares, so the gap between the merge path and the belt in
// this file is a checked fact rather than prose.
import v2.workflow.rust_crate_partition { stage0_all_partitioned_modules }

import v2.workflow.required_regen {
  CommittedNotEmitted,
  EmittedNotCommitted,
  EmittedNotCommittedShadowsHandMaintained,
  MirrorMissingShadowsHandMaintainedSource,
  EmptyCommittedPopulation,
  EmptyEmitResult,
  CommittedMirrorNoLongerEmitted,
  GeneratedDrift,
  HandDrifted,
  MirrorMissingForEmittedSurface,
  HandMatches,
  HandUnverifiable,
  HandUnverifiableRefused,
  PlannedExecutedMismatch,
  CandidateTree,
  CandidateTreeProduced,
  CandidateTreeUnproduced,
  RegenProducedRefused,
  RegenProducedRunnable,
  RegenUnproduced,
  RequiredRegenSyncRefused,
  RequiredRegenSyncRunnable,
  required_regen_run,
  SurfaceDrifted,
  SurfaceMatches,
  required_regen_sync_admission,
  AdmittedAuthorIntroducedMirror,
  DeclaredPartitionModules,
  DeclaredPartitionUnavailable,
  AdmittedAuthorIntroducedModule,
  RefusedUndeclaredModuleBasename,
  RefusedAmbiguousDerivation,
  RefusedAuthorityUnavailable,
  declared_mirror_basename,
  missing_mirror_admission,
  missing_mirror_admissions,
  missing_mirror_refused_basenames,
  collect_admitted_new_mirror_paths
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data required_regen_host_path: String = "src/v1/stage0/src/required_regen_host.rs"

fn host_source_contains(pattern: String) -> Bool {
  let src = filesystem_read(path: required_regen_host_path())
  string_contains(s: src.content, pattern: pattern)
}

data witness_note: String = "Discriminating RED controls for the required-regen admission wall: zero planned or executed populations must refuse rather than vacuously agree; a genuine match with independent denominators may admit."

// The population arms above answer 'did the fold compare anything'; these answer 'does the fold
// refuse what it was built to catch' — a committed surface whose bytes disagree with the emitter
// is the stale-mirror class that let main's v1_compiler_infer.rs sit behind its own .dag authority
// through #8513..#8579. The refusal must NAME the drifted path; a bare refusal is
// indistinguishable from one fired by any of the other seven variants. Discriminating RED controls
// for the drift arms: a drifted surface, an emitted/committed population asymmetry, and an
// unverifiable hand-maintained row must each refuse and name their subject; hand-maintained DRIFT
// alone must still admit — what separates this wall from one refusing on any non-match.

test fn witness_zero_planned_population_refuses() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 0,
    executed_surfaces: 0
  ) {
    RequiredRegenSyncRefused { refusals } =>
      refusals |> any(r => match r { EmptyCommittedPopulation => true _ => false })
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

test fn witness_zero_executed_population_refuses() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 3,
    executed_surfaces: 0
  ) {
    RequiredRegenSyncRefused { refusals } =>
      refusals |> any(r => match r { EmptyEmitResult => true _ => false })
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

test fn witness_planned_executed_mismatch_refuses() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 3,
    executed_surfaces: 2
  ) {
    RequiredRegenSyncRefused { refusals } =>
      refusals |> any(r => match r {
        PlannedExecutedMismatch { planned: 3, executed: 2 } => true
        _ => false
      })
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

test fn witness_nonempty_matching_population_admits() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [SurfaceMatches { relative_path: "std_algebra.rs" }],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 1,
    executed_surfaces: 1
  ) {
    RequiredRegenSyncRunnable { attempt: attempt } =>
      attempt.authority_digest == "fnv1a64:deadbeefdeadbeef"
    RequiredRegenSyncRefused { refusals: _ } => false
  }
}

test fn witness_drifted_surface_refuses_naming_the_path() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [
      SurfaceMatches { relative_path: "std_algebra.rs" },
      SurfaceDrifted {
        relative_path: "v1_compiler_infer.rs",
        committed_digest: "fnv1a64:1111111111111111",
        candidate_digest: "fnv1a64:2222222222222222"
      }
    ],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 2,
    executed_surfaces: 2
  ) {
    RequiredRegenSyncRefused { refusals } =>
      refusals |> any(r => match r {
        GeneratedDrift { paths } =>
          (paths |> any(p => p == "v1_compiler_infer.rs"))
            && (paths |> any(p => p == "std_algebra.rs")) == false
        _ => false
      })
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

// THE CONFLATION CONTROL. This test used to ASSERT the defect: it required an emitted-with-no-mirror
// path and a committed-no-longer-emitted path to land in one GeneratedDrift list — the union
// refusal that made a module's first landing indistinguishable from the emitter losing a surface.
// It now asserts the opposite: three states, three refusals, no path under a remedy that does not
// apply to it. Written as a separation check, not membership: it fails if ANY of the three lists
// contains a path belonging to another state, which is what a re-fusion would look like.
test fn witness_three_population_states_refuse_separately() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [
      SurfaceDrifted {
        relative_path: "drifted_surface.rs",
        committed_digest: "fnv1a64:1111111111111111",
        candidate_digest: "fnv1a64:2222222222222222"
      },
      EmittedNotCommitted { relative_path: "brand_new_surface.rs" },
      CommittedNotEmitted { relative_path: "deleted_surface.rs" }
    ],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 3,
    executed_surfaces: 3
  ) {
    RequiredRegenSyncRefused { refusals } =>
      (refusals |> any(r => match r {
        GeneratedDrift { paths } =>
          (paths |> any(p => p == "drifted_surface.rs"))
            && !(paths |> any(p => p == "brand_new_surface.rs"))
            && !(paths |> any(p => p == "deleted_surface.rs"))
        _ => false
      }))
        && (refusals |> any(r => match r {
          MirrorMissingForEmittedSurface { paths } =>
            (paths |> any(p => p == "brand_new_surface.rs"))
              && !(paths |> any(p => p == "deleted_surface.rs"))
              && !(paths |> any(p => p == "drifted_surface.rs"))
          _ => false
        }))
        && (refusals |> any(r => match r {
          CommittedMirrorNoLongerEmitted { paths } =>
            (paths |> any(p => p == "deleted_surface.rs"))
              && !(paths |> any(p => p == "brand_new_surface.rs"))
              && !(paths |> any(p => p == "drifted_surface.rs"))
          _ => false
        }))
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

// THE ANTI-ADMISSION CONTROL, the one that must never flip. A new surface with no committed mirror
// REFUSES, alone, with nothing else wrong. If a first mirror is later admitted automatically
// because the author obviously just added a module, this goes red — the point, because that same
// population is what the emitter inventing an unauthored surface looks like; the two are
// indistinguishable from the populations alone.
//
// THE DISCRIMINATOR ADDED BELOW DOES NOT FLIP THIS, AND THAT IS THE TEST'S WHOLE JOB. The arm it
// carries is `EmittedNotCommitted`, which is what the join produces when NOTHING declared the
// surface; the admitted arm is a different outcome, reachable only with a declared module behind it
// (see `witness_a_declared_module_admits_its_projected_mirror`). An admission that decided from
// these two populations would have to take this case with it, and this witness would go red.
test fn witness_new_surface_alone_still_refuses() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [
      SurfaceMatches { relative_path: "std_algebra.rs" },
      EmittedNotCommitted { relative_path: "brand_new_surface.rs" }
    ],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 2,
    executed_surfaces: 2
  ) {
    RequiredRegenSyncRefused { refusals } =>
      refusals |> any(r => match r {
        MirrorMissingForEmittedSurface { paths } =>
          paths |> any(p => p == "brand_new_surface.rs")
        _ => false
      })
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

// THE DAMAGING-REMEDY CONTROL; two halves that must hold TOGETHER. An emitted basename colliding
// with hand-authored source under a hand-maintained directory refuses under its OWN cause, naming
// the directory — both remedies attached to MirrorMissingForEmittedSurface (install the mirror, or
// investigate an invented surface) destroy hand-authored code when applied here. The RED half is
// the second assertion: a genuine orphan mirror in the SAME run must STILL refuse as
// MirrorMissingForEmittedSurface. A fix silencing the collision by excluding it from the compared
// population would take the orphan with it, and this test would green on a fallen wall.
// Separation, not membership: neither path may appear under the other's cause.
test fn witness_hand_maintained_collision_refuses_under_its_own_remedy() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [
      SurfaceMatches { relative_path: "std_algebra.rs" },
      EmittedNotCommitted { relative_path: "brand_new_surface.rs" },
      EmittedNotCommittedShadowsHandMaintained {
        relative_path: "shared_fill.rs",
        hand_maintained_homes: ["cli_run"]
      },
      EmittedNotCommittedShadowsHandMaintained {
        relative_path: "mod.rs",
        hand_maintained_homes: ["cli_run", "module_path_index"]
      }
    ],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 4,
    executed_surfaces: 4
  ) {
    RequiredRegenSyncRefused { refusals } =>
      (refusals |> any(r => match r {
        MirrorMissingShadowsHandMaintainedSource { entries } =>
          (entries |> any(e => e == "shared_fill.rs (hand-maintained under cli_run)"))
            && (entries |> any(e =>
              e == "mod.rs (hand-maintained under cli_run, module_path_index)"))
            && !(entries |> any(e => e == "brand_new_surface.rs"))
        _ => false
      }))
        && (refusals |> any(r => match r {
          MirrorMissingForEmittedSurface { paths } =>
            (paths |> any(p => p == "brand_new_surface.rs"))
              && !(paths |> any(p => p == "shared_fill.rs"))
          _ => false
        }))
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

test fn witness_hand_unverifiable_refuses_naming_the_entry() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [SurfaceMatches { relative_path: "std_algebra.rs" }],
    hand_outcomes: [
      HandUnverifiable {
        filename: "main.rs",
        reason: "no emitter candidate produced"
      }
    ],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 1,
    executed_surfaces: 1
  ) {
    RequiredRegenSyncRefused { refusals } =>
      refusals |> any(r => match r {
        HandUnverifiableRefused { entries } =>
          entries |> any(e => string_contains(e, "main.rs"))
            && (entries |> any(e => string_contains(e, "no emitter candidate produced")))
        _ => false
      })
    RequiredRegenSyncRunnable { attempt: _ } => false
  }
}

// The near-miss positive control. HandDrifted is one variant from HandUnverifiable and must NOT
// refuse: hand-maintained drift is expected on a clean tree, so a wall refusing here would refuse
// on any non-match and the RED above would prove nothing about which distinction it draws.
test fn witness_hand_drift_alone_admits() -> Bool {
  match required_regen_sync_admission(
    generated_outcomes: [SurfaceMatches { relative_path: "std_algebra.rs" }],
    hand_outcomes: [
      HandMatches { filename: "cli_run.rs" },
      HandDrifted { filename: "main.rs" }
    ],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 1,
    executed_surfaces: 1
  ) {
    RequiredRegenSyncRunnable { attempt: attempt } =>
      attempt.authority_digest == "fnv1a64:deadbeefdeadbeef"
    RequiredRegenSyncRefused { refusals: _ } => false
  }
}

// Discriminating RED controls for the production-before-adjudication ordering. The subject is the
// one population asymmetry an author can actually cause: a module added to the v1 seed closure
// emits a mirror the committed tree lacks, so the run REFUSES — and the author's only remedy is the
// very file the refusing run produced. The pre-#8663 host sequenced that refusal ahead of the write
// and returned with the tree unwritten, while regen_stage0 (which used to write it unconditionally)
// had been deleted at the root, so the refusal named a file no route in the repository produced.
// These controls go red against a carrier whose refusal arms can omit the tree.

// THE DISCRIMINATING RED. That the asymmetry refuses is already proven above; what must hold is
// that the refusal arrives WITH the candidate tree, containing the mirror the committed population
// lacks. A carrier permitting a bare `RequiredRegenSyncRefused` here would fail to typecheck this
// test at all — the wall being asserted.
test fn witness_new_seed_module_refuses_and_carries_the_first_mirror() -> Bool {
  match required_regen_run(
    production: CandidateTreeProduced {
      tree: CandidateTree {
        root: "target/stage0-regen-candidate/src",
        produced_paths: ["std_algebra.rs", "brand_new_surface.rs"]
      }
    },
    generated_outcomes: [
      SurfaceMatches { relative_path: "std_algebra.rs" },
      EmittedNotCommitted { relative_path: "brand_new_surface.rs" }
    ],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 2,
    executed_surfaces: 2
  ) {
    RegenProducedRefused { tree: tree, refusals: refusals } =>
      (tree.root == "target/stage0-regen-candidate/src")
        && (tree.produced_paths |> any(p => p == "brand_new_surface.rs"))
        && (refusals |> any(r => match r {
          MirrorMissingForEmittedSurface { paths } =>
            paths |> any(p => p == "brand_new_surface.rs")
          _ => false
        }))
    _ => false
  }
}

// The near-miss control on the other side: emit producing nothing is NOT a verdict about a tree,
// so it lands on the one arm carrying none. Without this, the test above would be satisfied by a
// carrier that always carries a tree, including one fabricated for a run that produced no files.
test fn witness_unproduced_run_carries_no_tree_and_names_its_cause() -> Bool {
  match required_regen_run(
    production: CandidateTreeUnproduced { cause: EmptyEmitResult },
    generated_outcomes: [],
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 0,
    executed_surfaces: 0
  ) {
    RegenUnproduced { cause: cause } => match cause {
      EmptyEmitResult => true
      _ => false
    }
    _ => false
  }
}

// The positive control: a clean tree admits, and the admitting arm carries the tree too
// — so the tree is a fact about every run that reached a verdict, not a decoration
// attached to failures.
test fn witness_clean_run_admits_and_still_carries_the_tree() -> Bool {
  match required_regen_run(
    production: CandidateTreeProduced {
      tree: CandidateTree {
        root: "target/stage0-regen-candidate/src",
        produced_paths: ["std_algebra.rs"]
      }
    },
    generated_outcomes: [SurfaceMatches { relative_path: "std_algebra.rs" }],
    hand_outcomes: [HandDrifted { filename: "main.rs" }],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 1,
    executed_surfaces: 1
  ) {
    RegenProducedRunnable { tree: tree, attempt: attempt } =>
      (attempt.authority_digest == "fnv1a64:deadbeefdeadbeef")
        && (tree.produced_paths |> any(p => p == "std_algebra.rs"))
    _ => false
  }
}

// THE AUTHORED DISCRIMINANT: five arms of one decision, each with the case it must NOT confuse.
// Authority: `v2.workflow.required_regen` `MissingMirrorAuthority` / `MissingMirrorAdmission`; the
// host realization is `missing_mirror_admission` in src/v1/stage0/src/required_regen_host.rs, and
// the merge-path verdict is the srv1 heal receipt on
// `gunbc.recurring_failure_mode.adding_a_seed_module_refuses_convergence_on_an_unowned_lib_rs`.
// Together these five are the whole of what the two populations cannot tell you: which absences a
// declaration earns and which it does not.

// THE CAPABILITY, ARM FOR ARM. The module's row is the only thing the author wrote; the mirror is
// absent from the tree and present in the emit. The admission must both ADMIT and NAME THE MODULE
// — an admission that returned only the basename would not be checkable against the declaration,
// and could not be distinguished from one minted from the file name.
test fn witness_a_declared_module_admits_its_projected_mirror() -> Bool {
  match missing_mirror_admission(
    basename: "v1_compiler_a_new_cause.rs",
    authority: DeclaredPartitionModules {
      names: ["v1.compiler.still", "v1.compiler.a_new_cause"]
    }
  ) {
    AdmittedAuthorIntroducedModule { module: module, basename: basename } =>
      (module == "v1.compiler.a_new_cause") && (basename == "v1_compiler_a_new_cause.rs")
    _ => false
  }
}

// THE SAME POPULATION WITHOUT THE DECLARATION IS THE BUG THIS WALL EXISTS TO CATCH. Two halves:
// a name no module spells, and the `main` -> `main_mod` collision answered the wrong way round.
// The second is the shape-only trap in its purest form — `main.rs` LOOKS like the module `main`, and
// the declared projection says its mirror is `main_mod.rs`, so admitting on appearance would
// install a surface the emitter was never authorized to produce.
test fn witness_an_undeclared_basename_refuses_however_plausible_its_shape() -> Bool {
  let names = ["v1.compiler.still"]
  match missing_mirror_admission(
    basename: "v1_compiler_never_authored.rs",
    authority: DeclaredPartitionModules { names: names }
  ) {
    RefusedUndeclaredModuleBasename { basename: refused } =>
      (refused == "v1_compiler_never_authored.rs")
        && (match missing_mirror_admission(
          basename: "main.rs",
          authority: DeclaredPartitionModules { names: ["main"] }
        ) {
          RefusedUndeclaredModuleBasename { basename: _ } =>
            declared_mirror_basename(module: "main") == "main_mod.rs"
          _ => false
        })
    _ => false
  }
}

// NO FALLBACK ARM. An authority that cannot be read is not an absence of declaration, and it is
// certainly not permission to consult the rows compiled into the running binary — those belong to
// the previous build and cannot contain the module being introduced. The reason has to SURVIVE into
// the arm, because a refusal that cannot say which arm fired is DEFECT 2 of the same row.
test fn witness_an_unavailable_authority_admits_nothing_and_says_why() -> Bool {
  match missing_mirror_admission(
    basename: "v1_compiler_a_new_cause.rs",
    authority: DeclaredPartitionUnavailable { reason: "partition row unreadable" }
  ) {
    RefusedAuthorityUnavailable { basename: basename, reason: reason } =>
      (basename == "v1_compiler_a_new_cause.rs") && (reason == "partition row unreadable")
    _ => false
  }
}

// THE PROJECTION IS NOT INJECTIVE, SO THE RUN MUST NOT PICK. `a.b_c` and `a.b.c` are different
// modules and one filename; a first-match search would silently admit whichever row came first,
// which is an admission decided by row ORDER — the same authority vacuum in a new place. The refusal
// has to name every module it is refusing between.
test fn witness_an_ambiguous_projection_refuses_and_names_both_modules() -> Bool {
  match missing_mirror_admission(
    basename: "a_b_c.rs",
    authority: DeclaredPartitionModules { names: ["still", "a.b_c", "a.b.c"] }
  ) {
    RefusedAmbiguousDerivation { basename: basename, modules: modules } =>
      (basename == "a_b_c.rs")
        && (modules |> any(m => m == "a.b_c"))
        && (modules |> any(m => m == "a.b.c"))
    _ => false
  }
}

// THE ADMISSION IS NOT A SILENT EXCLUSION. An admitted surface stays in the compared population —
// it is a surface the candidate has and the tree lacks, so it is planned and installed — while being
// kept OUT of the missing-mirror remedy list, whose two moves (install the produced mirror, or
// investigate an invented surface) are addressed to an author who has not declared anything. The
// RED half is the second assertion: had the admission been implemented by dropping the path from the
// population, the admitted list would be empty and the wall would read green on a surface nobody
// installed.
test fn witness_an_admitted_mirror_is_planned_installed_and_kept_out_of_the_refusal() -> Bool {
  let outcomes = [
    SurfaceMatches { relative_path: "std_algebra.rs" },
    AdmittedAuthorIntroducedMirror {
      relative_path: "src/v1/stage0/src/v1_compiler_a_new_cause.rs",
      module: "v1.compiler.a_new_cause"
    }
  ]
  let admissions = missing_mirror_admissions(
    basenames: ["v1_compiler_a_new_cause.rs", "v1_compiler_never_authored.rs"],
    authority: DeclaredPartitionModules { names: ["v1.compiler.a_new_cause"] }
  )
  (match required_regen_sync_admission(
    generated_outcomes: outcomes,
    hand_outcomes: [],
    authority_digest: "fnv1a64:deadbeefdeadbeef",
    planned_surfaces: 2,
    executed_surfaces: 2
  ) {
    RequiredRegenSyncRunnable { attempt: _ } => true
    RequiredRegenSyncRefused { refusals: _ } => false
  })
    && (collect_admitted_new_mirror_paths(
      acc: [],
      o: AdmittedAuthorIntroducedMirror {
        relative_path: "src/v1/stage0/src/v1_compiler_a_new_cause.rs",
        module: "v1.compiler.a_new_cause"
      }
    )
      |> any(p => p == "src/v1/stage0/src/v1_compiler_a_new_cause.rs"))
    && (missing_mirror_refused_basenames(xs: admissions)
      |> any(b => b == "v1_compiler_never_authored.rs"))
    && !(missing_mirror_refused_basenames(xs: admissions)
      |> any(b => b == "v1_compiler_a_new_cause.rs"))
}

// THE TWO SIBLINGS IN THE PROJECTION CARRIER ARE NOT INTERCHANGEABLE, and this is the line that says
// which one a MIRROR belongs to. `rust_module_emit_filename` answers "main_mod" for the module `main`
// for a reason the carrier itself gives -- an emitted MODULE FILE called main.rs would collide with
// the crate's own entry file (dag/gunbc/rust_emitted_edge.dag:49-62). A stage0 seed mirror is never
// that entry file: the crate root is lib.rs and every mirror is a `pub mod` beside it. So the module
// whose projection spells `main` owns `main.rs`, and a gate built on the entry-file sibling would
// refuse the mirror that module really has while admitting a `main_mod.rs` no emitter ever writes.
// Swapping the import in v2.workflow.required_regen::declared_mirror_basename reddens this witness --
// which is the point: the wrong sibling is a plausible-looking one-line change, and this is the only
// thing in the lane that tells them apart.
test fn witness_a_module_projecting_to_main_keeps_the_entry_file_rule_out_of_its_mirror() -> Bool {
  (declared_mirror_basename(module: "main") == "main.rs")
    && (match missing_mirror_admission(
      basename: "main.rs",
      authority: DeclaredPartitionModules { names: ["still", "main"] }
    ) {
      AdmittedAuthorIntroducedModule { module: module, basename: basename } =>
        (module == "main") && (basename == "main.rs")
      _ => false
    })
    && (match missing_mirror_admission(
      basename: "main_mod.rs",
      authority: DeclaredPartitionModules { names: ["main"] }
    ) {
      RefusedUndeclaredModuleBasename { basename: basename } => basename == "main_mod.rs"
      _ => false
    })
}

// WHAT THE AUTHORITY ACTUALLY CARRIES, read FROM the authority instead of assumed by a comment: every
// stage0 module name a partition row declares is already flat, so on real data the projection is the
// identity and the join is the row string plus the extension. The dotted fixtures above, and the
// ambiguous arm that depends on two spellings meeting at one basename, are then defense in depth
// against a row that names a dotted module -- a shape the partition does not emit today. Without this
// witness the distinction lives only in prose, and a reader could not tell the merge path from the
// belt.
test fn witness_every_declared_stage0_module_name_is_already_flat() -> Bool {
  count(stage0_all_partitioned_modules()) > 0
    && !(stage0_all_partitioned_modules() |> any(n => string_contains(s: n, pattern: ".")))
}

// THE DECLARED FORK, WITNESSED. dag/gunbc/missing_mirror_admission_seed_growth.dag declares that
// src/v1/stage0/src/required_regen_host.rs carries a second, hand-written copy of this admission --
// the copy the merge gate runs, since the gate lives in the crate that EMITS v2 and cannot call a
// v2-emitted realization of its own gate. A declared fork with no witness on the host side is the
// failure mode a declaration alone does not prevent: the modeled arms get edited, the host arms do
// not, and the lane stays green because the lane only ever asked the model. These two witnesses ask
// the host, so renaming or dropping an arm on either side reddens the required gate.
test fn witness_the_host_realization_spells_every_modeled_arm() -> Bool {
  host_source_contains(pattern: "enum MissingMirrorVerdict")
    && host_source_contains(pattern: "MissingMirrorVerdict::AdmittedAuthorIntroducedModule")
    && host_source_contains(pattern: "MissingMirrorVerdict::RefusedUndeclaredModuleBasename")
    && host_source_contains(pattern: "MissingMirrorVerdict::RefusedAmbiguousDerivation")
    && host_source_contains(pattern: "MissingMirrorVerdict::RefusedAuthorityUnavailable")
    // The four clauses the refusal carries. A refusal that lost which arm fired is DEFECT 2 of the
    // row this change came out of -- the planner payload rendering empty -- so the clauses are pinned
    // as text, not inferred from the arm names.
    && host_source_contains(pattern: "is admitted as an author-introduced mirror of")
    && host_source_contains(pattern: "is not the mirror of any module declared in the change")
    && host_source_contains(pattern: "is the mirror of more than one declared module")
    && host_source_contains(pattern: "the declared partition could not be read")
}

// THE ONE CALL THAT MUST NOT BE SWAPPED FOR ITS PLAUSIBLE SIBLING. The host asks the emitted mirror
// of module_to_filename for a mirror name; the carrier's other projection, rust_module_emit_filename,
// is the entry-file rule (main to main_mod) and substituting it would admit a basename no emitter
// writes while refusing the mirror a module really has. The negative pins are on the CALL FORM, so
// the comments that discuss the sibling by name do not false-positive them.
test fn witness_the_host_asks_the_projection_and_never_the_entry_file_sibling() -> Bool {
  host_source_contains(pattern: "gunbc_rust_emitted_edge::module_to_filename(")
    && !host_source_contains(pattern: "gunbc_rust_emitted_edge::rust_module_emit_filename(")
    && !host_source_contains(pattern: "rust_module_emit_filename(")
    // No hand-rolled spelling of the join anywhere in the gate: the projection is asked, once, and
    // compared_mirror_rows -- which used to spell it -- now goes through the same helper.
    && !host_source_contains(pattern: "module.replace(")
}
