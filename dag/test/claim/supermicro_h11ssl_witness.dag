module test.claim.supermicro_h11ssl_witness

import std.types { Bool }
import gunbc.machine_intake.bmc_operator_credential_inventory {
  OperatorHeldSecretRef, operator_held_bmc_credential_inventory, operator_attested_bmc_inventory_roster,
  operator_inventory_attests, FactoryLoginCredential,
}
import extdeps.network.mac { mac_address }
import std.optional { Present, Absent }
import std.measure { megatransfers_per_second, gigabyte }
import extdeps.boards.types { PopulationSupported, PopulationUnsupported }
import extdeps.boards.supermicro_h11ssl {
  Epyc7001, Epyc7002,
  Jbt1ClearCmos, Jpb1BmcEnable, BmcAccountResetNotStated,
  supermicro_h11ssl_admit_population,
  supermicro_h11ssl_max_data_rate,
  supermicro_h11ssl_jpwr2_pin, supermicro_h11ssl_jpwr1_pin, AtxGround, Atx12V, Atx5Vsb,
  supermicro_h11ssl_jumper_resets_bmc_accounts,
  supermicro_h11ssl_lan_option_rom_choices, Lan1, Lan2,
  OptionRomDisabled, OptionRomPxe, OptionRomIscsi, OptionRomLegacy, OptionRomEfi,
  supermicro_h11ssl_fan_pin, FanPwm,
  supermicro_h11ssl_dimm_capacity_stated, Rdimm2R, Rdimm2Dr, Lrdimm3ds4R, Lrdimm3ds8R,
  supermicro_h11ssl_storage_support, VariantI, VariantC, VariantNc,
}
import gunbc.machine_intake.supermicro_h11ssl_first_contact {
  supermicro_h11ssl_first_contact_receipt, supermicro_h11ssl_factory_login_producer_admitted,
  supermicro_h11ssl_redfish_root_answered_after_activation, H11sslFirstContactReceipt,
  OperatorHeldCertificate, H11sslObservation, H11sslObservedInstant, BmcClockReading,
  WebLoginObservation, RedfishRootObservation, LicenceActivationObservation,
  ServiceRootRefused, ServiceRootAnswered,
  UnitVariantObserved, UnitStorageProjected, UnitStorageRefusedVariantUnread,
  supermicro_h11ssl_unit_variant_standing, supermicro_h11ssl_unit_storage_projection,
}

// The 4-DIMM guides differ by CPU family: the 7001 guide is C1,A1,E1,H1 and the 7002 guide is
// D1,C1,G1,H1, so one candidate is supported under one family and refused under the other.
test fn w_four_dimm_population_is_family_specific() -> Bool {
  let seven_thousand_one = ["C1", "A1", "E1", "H1"]
  let seven_thousand_two = ["D1", "C1", "G1", "H1"]
  let a = match supermicro_h11ssl_admit_population(family: Epyc7001, candidate: seven_thousand_one) { PopulationSupported => true  PopulationUnsupported { slots: _ } => false }
  let b = match supermicro_h11ssl_admit_population(family: Epyc7002, candidate: seven_thousand_one) { PopulationSupported => false  PopulationUnsupported { slots: _ } => true }
  let c = match supermicro_h11ssl_admit_population(family: Epyc7002, candidate: seven_thousand_two) { PopulationSupported => true  PopulationUnsupported { slots: _ } => false }
  a && b && c
}

// One-per-two-channel adjacent slots and an unlisted six-DIMM population are refused.
test fn w_undocumented_populations_are_refused() -> Bool {
  let adjacent = match supermicro_h11ssl_admit_population(family: Epyc7002, candidate: ["A1", "B1"]) { PopulationSupported => false  PopulationUnsupported { slots: _ } => true }
  let six = match supermicro_h11ssl_admit_population(family: Epyc7001, candidate: ["A1", "B1", "C1", "D1", "E1", "F1"]) { PopulationSupported => false  PopulationUnsupported { slots: _ } => true }
  adjacent && six
}

test fn w_rates_differ_by_family() -> Bool {
  supermicro_h11ssl_max_data_rate(family: Epyc7001) == megatransfers_per_second(count: 2666)
    && supermicro_h11ssl_max_data_rate(family: Epyc7002) == megatransfers_per_second(count: 3200)
}

test fn w_jpwr2_pins() -> Bool {
  let p9 = match supermicro_h11ssl_jpwr2_pin(pin: 9) { Present { value: Atx5Vsb } => true  _ => false }
  let p25 = match supermicro_h11ssl_jpwr2_pin(pin: 25) { Absent => true  Present { value: _ } => false }
  let c1 = match supermicro_h11ssl_jpwr1_pin(pin: 1) { Present { value: AtxGround } => true  _ => false }
  let c8 = match supermicro_h11ssl_jpwr1_pin(pin: 8) { Present { value: Atx12V } => true  _ => false }
  p9 && p25 && c1 && c8
}

test fn w_fan_pin_four_is_pwm_and_five_refused() -> Bool {
  let p4 = match supermicro_h11ssl_fan_pin(pin: 4) { Present { value: FanPwm } => true  _ => false }
  let p5 = match supermicro_h11ssl_fan_pin(pin: 5) { Absent => true  Present { value: _ } => false }
  p4 && p5
}

test fn w_manual_states_no_jumper_bmc_account_reset() -> Bool {
  match supermicro_h11ssl_jumper_resets_bmc_accounts(j: Jbt1ClearCmos) { BmcAccountResetNotStated => true  _ => false }
    && match supermicro_h11ssl_jumper_resets_bmc_accounts(j: Jpb1BmcEnable) { BmcAccountResetNotStated => true  _ => false }
}

// Both BIOS surfaces, cell by cell: EPYC 7001 (p.75) and EPYC 7002 (LAN1 p.104, LAN2 p.105) differ, and a family
// that collapsed to one vocabulary would drop iSCSI/Legacy.
test fn w_lan_option_rom_matrices_by_cpu_family() -> Bool {
  supermicro_h11ssl_lan_option_rom_choices(family: Epyc7001, lan: Lan1) == [OptionRomDisabled, OptionRomPxe, OptionRomIscsi, OptionRomLegacy, OptionRomEfi]
    && supermicro_h11ssl_lan_option_rom_choices(family: Epyc7001, lan: Lan2) == [OptionRomDisabled, OptionRomPxe, OptionRomIscsi]
    && supermicro_h11ssl_lan_option_rom_choices(family: Epyc7002, lan: Lan1) == [OptionRomDisabled, OptionRomPxe, OptionRomEfi]
    && supermicro_h11ssl_lan_option_rom_choices(family: Epyc7002, lan: Lan2) == [OptionRomDisabled, OptionRomPxe]
}

test fn w_rejected_default_login_does_not_admit_factory_producer() -> Bool {
  !supermicro_h11ssl_factory_login_producer_admitted(r: supermicro_h11ssl_first_contact_receipt)
}

fn without_outcome(r: H11sslFirstContactReceipt, drop_activation: Bool) -> H11sslFirstContactReceipt {
  H11sslFirstContactReceipt {
    board: r.board, bmc_address: r.bmc_address, bmc_mac: r.bmc_mac,
    observations: filter(r.observations, o => match o {
      LicenceActivationObservation { credential: _, instant: _, observed_by: _, check_attribute: _, unit_state_changed: _ } => !drop_activation
      RedfishRootObservation { instant: _, observed_by: _, outcome: ServiceRootRefused { message_id: _ }, unit_state_changed: _ } => drop_activation
      RedfishRootObservation { instant: _, observed_by: _, outcome: ServiceRootAnswered { redfish_version: _, root_schema: _, uuid: _, members: _ }, unit_state_changed: _ } => true
      WebLoginObservation { credential: _, instant: _, observed_by: _, outcome: _, unit_state_changed: _ } => true
    }),
    licences: r.licences, label: r.label,
  }
}

// The receipt with its licence activation replaced by `f` of it (instrument and arm unchanged).
fn with_activation(r: H11sslFirstContactReceipt, f: fn(H11sslObservation) -> H11sslObservation) -> H11sslFirstContactReceipt {
  H11sslFirstContactReceipt {
    board: r.board, bmc_address: r.bmc_address, bmc_mac: r.bmc_mac,
    observations: map(r.observations, o => match o {
      LicenceActivationObservation { credential: _, instant: _, observed_by: _, check_attribute: _, unit_state_changed: _ } => f(o)
      _ => o
    }),
    licences: r.licences, label: r.label,
  }
}

fn activation_on_bmc_clock(o: H11sslObservation) -> H11sslObservation {
  match o {
    LicenceActivationObservation { credential: c, instant: i, observed_by: by, check_attribute: k, unit_state_changed: ch } =>
      LicenceActivationObservation { credential: c, instant: H11sslObservedInstant { at: i.at, basis: BmcClockReading }, observed_by: by, check_attribute: k, unit_state_changed: ch }
    _ => o
  }
}

fn activation_that_changed_nothing(o: H11sslObservation) -> H11sslObservation {
  match o {
    LicenceActivationObservation { credential: c, instant: i, observed_by: by, check_attribute: k, unit_state_changed: _ } =>
      LicenceActivationObservation { credential: c, instant: i, observed_by: by, check_attribute: k, unit_state_changed: false }
    _ => o
  }
}

fn activation_refused_check(o: H11sslObservation) -> H11sslObservation {
  match o {
    LicenceActivationObservation { credential: c, instant: i, observed_by: by, check_attribute: _, unit_state_changed: ch } =>
      LicenceActivationObservation { credential: c, instant: i, observed_by: by, check_attribute: 0, unit_state_changed: ch }
    _ => o
  }
}

// The ordered transition (refusal, then activation, then answer) holds on the receipt and is
// false once the activation or the refusal is deleted, once the activation is timed on the BMC
// clock between two transcript-timed steps, or once the activation did not answer CHECK=1 or
// changed nothing. An instrument carrying another instrument's outcome has no constructor, so
// that mismatch is structurally impossible rather than checked.
test fn w_redfish_root_answered_only_after_ordered_activation() -> Bool {
  let r = supermicro_h11ssl_first_contact_receipt
  supermicro_h11ssl_redfish_root_answered_after_activation(r: r)
    && !supermicro_h11ssl_redfish_root_answered_after_activation(r: without_outcome(r: r, drop_activation: true))
    && !supermicro_h11ssl_redfish_root_answered_after_activation(r: without_outcome(r: r, drop_activation: false))
    && !supermicro_h11ssl_redfish_root_answered_after_activation(r: with_activation(r: r, f: activation_on_bmc_clock))
    && !supermicro_h11ssl_redfish_root_answered_after_activation(r: with_activation(r: r, f: activation_that_changed_nothing))
    && !supermicro_h11ssl_redfish_root_answered_after_activation(r: with_activation(r: r, f: activation_refused_check))
}

// The manual's 7001 table lists 4R under LRDIMM 3DS (beside 8R), not under RDIMM, and the 7002
// RDIMM row reads '2R or 2DR'; each cell answers its own maximum and not its neighbour's.
test fn w_dimm_module_kinds_and_capacities_per_family() -> Bool {
  supermicro_h11ssl_dimm_capacity_stated(family: Epyc7001, module_kind: Lrdimm3ds4R, per_dimm_max: gigabyte(count: 64))
    && supermicro_h11ssl_dimm_capacity_stated(family: Epyc7001, module_kind: Lrdimm3ds8R, per_dimm_max: gigabyte(count: 128))
    && !supermicro_h11ssl_dimm_capacity_stated(family: Epyc7001, module_kind: Lrdimm3ds4R, per_dimm_max: gigabyte(count: 128))
    && supermicro_h11ssl_dimm_capacity_stated(family: Epyc7002, module_kind: Rdimm2R, per_dimm_max: gigabyte(count: 64))
    && supermicro_h11ssl_dimm_capacity_stated(family: Epyc7002, module_kind: Rdimm2Dr, per_dimm_max: gigabyte(count: 64))
    && !supermicro_h11ssl_dimm_capacity_stated(family: Epyc7002, module_kind: Rdimm2Dr, per_dimm_max: gigabyte(count: 32))
    && !supermicro_h11ssl_dimm_capacity_stated(family: Epyc7001, module_kind: Rdimm2Dr, per_dimm_max: gigabyte(count: 64))
}

// p.40 'Number of Supported Drives on Different Models', cell by cell; the unit's variant is
// unread, so its storage projection refuses and a stated variant projects its own column.
test fn w_storage_support_by_variant_and_unit_projection_requires_observed_variant() -> Bool {
  let i = supermicro_h11ssl_storage_support(variant: VariantI)
  let c = supermicro_h11ssl_storage_support(variant: VariantC)
  let nc = supermicro_h11ssl_storage_support(variant: VariantNc)
  let columns = i.sata_ports == 16 && i.sas3_ports == 0 && i.nvme_drives == 0
    && c.sata_ports == 8 && c.sas3_ports == 8 && c.nvme_drives == 0
    && nc.sata_ports == 8 && nc.sas3_ports == 8 && nc.nvme_drives == 2
  let unread = match supermicro_h11ssl_unit_storage_projection(standing: supermicro_h11ssl_unit_variant_standing) {
    UnitStorageRefusedVariantUnread { read_obligation: _ } => true
    UnitStorageProjected { variant: _, support: _ } => false
  }
  let observed = match supermicro_h11ssl_unit_storage_projection(standing: UnitVariantObserved { variant: VariantNc }) {
    UnitStorageProjected { variant: _, support: s } => s.nvme_drives == 2
    UnitStorageRefusedVariantUnread { read_obligation: _ } => false
  }
  columns && unread && observed
}

// The receipt's secret references are attested by the declared roster for the declared inventory,
// keyed by BMC MAC and kind; another MAC is not attested.
test fn w_receipt_secret_refs_are_attested_by_the_declared_roster() -> Bool {
  let r = supermicro_h11ssl_first_contact_receipt
  let other = OperatorHeldSecretRef { bmc_mac: mac_address(octet1: 172, octet2: 31, octet3: 107, octet4: 0, octet5: 0, octet6: 0), secret: FactoryLoginCredential }
  operator_inventory_attests(roster: operator_attested_bmc_inventory_roster, inventory: operator_held_bmc_credential_inventory, ref: r.label.bmc_factory_credential)
    && !operator_inventory_attests(roster: operator_attested_bmc_inventory_roster, inventory: operator_held_bmc_credential_inventory, ref: other)
    && any(r.licences, l => match l.source {
      OperatorHeldCertificate { certificate_number: _, inventory_row: ref } => operator_inventory_attests(roster: operator_attested_bmc_inventory_roster, inventory: operator_held_bmc_credential_inventory, ref: ref)
    })
}
