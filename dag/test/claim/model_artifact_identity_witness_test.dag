module test.claim.model_artifact_identity_witness_test


fn gpt_oss_20b() -> OllamaModelRef {
  ollama_gpt_oss_20b_model_ref
}

// Two DIFFERENT digests carrying the SAME reference -- which is exactly what upstream repointing a
// tag produces, and the situation a tag-pinned deployment cannot detect.
data digest_a: String = "aaaaaaaabbbbbbbbccccccccddddddddeeeeeeeeffffffff0000000011111111"
data digest_b: String = "ffffffffeeeeeeeeddddddddccccccccbbbbbbbbaaaaaaaa9999999988888888"

// A tuned artifact's identity must be in the SAME hash family as a stock one, so the fixture mints a
// real sha256 rather than a structural hash -- the first draft used content_hash_of_value and the
// lineage claim failed as ContentHashCrossFamilyIncomparable, which is what narrowed the carrier's
// parameter.
data tuned_digest_hex: String = "1111111122222222333333334444444455555555666666667777777788888888"

fn tuned_digest() -> Sha256Digest {
  match sha256_hex_digest(hex: tuned_digest_hex) {
    Present { value: d } => d
    Absent => tuned_digest()
  }
}

fn artifact_with(hex: String) -> ModelArtifact? {
  match ollama_model_digest_from_wire(ref: gpt_oss_20b(), hex: hex) {
    Present { value: d } => Present {
      value: model_artifact_from_observed_digest(publisher: "ollama" as NonEmptyStr, observed: d),
    }
    Absent => none
  }
}

test fn w_wire_digest_parses_and_the_sha256_prefix_is_serialization_not_identity() -> Bool {
  match ollama_model_digest_from_wire(ref: gpt_oss_20b(), hex: digest_a) {
    Absent => false
    Present { value: bare } =>
      match ollama_model_digest_from_wire(ref: gpt_oss_20b(), hex: concat("sha256:", digest_a)) {
        Absent => false
        Present { value: prefixed } =>
          match compare_model_artifact(
            desired: model_artifact_from_observed_digest(publisher: "ollama" as NonEmptyStr, observed: bare),
            loaded: model_artifact_from_observed_digest(publisher: "ollama" as NonEmptyStr, observed: prefixed),
          ) {
            ArtifactIdentical => true
            ArtifactDiffers { desired: _, loaded: _ } => false
            ArtifactIncomparable { cause: _ } => false
          }
      }
  }
}

// THE CLAIM THE WHOLE CARRIER EXISTS FOR. Same reference, different bytes: a deployment pinned to
// `gpt-oss:20b` would call these the same model. Keyed by digest, they differ -- and the labels
// still collide, which is the fact a receipt needs in order to report drift rather than silence.
test fn w_same_tag_different_bytes_is_a_different_model() -> Bool {
  match artifact_with(hex: digest_a) {
    Absent => false
    Present { value: a } =>
      match artifact_with(hex: digest_b) {
        Absent => false
        Present { value: b } =>
          match compare_model_artifact(desired: a, loaded: b) {
            ArtifactDiffers { desired: _, loaded: _ } => model_label_collision(left: a, right: b)
            ArtifactIdentical => false
            ArtifactIncomparable { cause: _ } => false
          }
      }
  }
}

// POSITIVE CONTROL, without which the claim above is satisfiable by a comparison that always
// differs: the same digest twice must agree, and must NOT report a label collision.
test fn w_same_bytes_agree_and_do_not_collide() -> Bool {
  match artifact_with(hex: digest_a) {
    Absent => false
    Present { value: a } =>
      match artifact_with(hex: digest_a) {
        Absent => false
        Present { value: a2 } =>
          match compare_model_artifact(desired: a, loaded: a2) {
            ArtifactIdentical => !model_label_collision(left: a, right: a2)
            ArtifactDiffers { desired: _, loaded: _ } => false
            ArtifactIncomparable { cause: _ } => false
          }
      }
  }
}

// THE FINE-TUNING CLAIM, which is why this carrier lands before anything serves. A tuned artifact
// must be expressible with no schema change and must carry a WALKABLE lineage to its base -- if this
// needed a new field, the argument for modeling identity early was wrong.
test fn w_a_tuned_artifact_carries_walkable_lineage_to_its_base() -> Bool {
  match artifact_with(hex: digest_a) {
    Absent => false
    Present { value: base } => {
      let tuned = model_artifact_from_tuning_run(
        produced_digest: tuned_digest(),
        base: base,
        dataset_identity: content_hash_of_value(value: "dataset-v1" as NonEmptyStr),
        run_identity: "run-2026-08-12-a" as NonEmptyStr,
        serving_label: "gunbc-tuned:v1" as NonEmptyStr,
      )
      match model_artifact_base_identity(artifact: tuned) {
        Absent => false
        Present { value: recorded_base } =>
          match compare_content_hash(left: recorded_base, right: base.identity) {
            ContentHashEqual =>
              match compare_model_artifact(desired: base, loaded: tuned) {
                ArtifactDiffers { desired: _, loaded: _ } => true
                ArtifactIdentical => false
                ArtifactIncomparable { cause: _ } => false
              }
            ContentHashDifferent => false
            ContentHashCrossFamilyIncomparable => false
          }
      }
    }
  }
}

// A stock artifact has NO base, and that must be Absent rather than a self-reference or a zero --
// "this came from upstream" and "this was tuned from something" are different facts, and a fabricated
// base would make every lineage walk terminate in a lie.
test fn w_a_stock_artifact_has_no_base() -> Bool {
  match artifact_with(hex: digest_a) {
    Absent => false
    Present { value: a } =>
      match model_artifact_base_identity(artifact: a) {
        Absent => true
        Present { value: _ } => false
      }
  }
}

// RED CONTROL: a malformed digest must REFUSE rather than produce an artifact with a placeholder
// identity. An artifact whose identity is wrong is worse than one that is missing, because every
// downstream comparison trusts it.
test fn red_control_malformed_digest_refuses_rather_than_placeholding() -> Bool {
  match ollama_model_digest_from_wire(ref: gpt_oss_20b(), hex: "not-a-digest") {
    Absent => true
    Present { value: _ } => false
  }
}
