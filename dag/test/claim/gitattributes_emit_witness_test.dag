module test.claim.gitattributes_emit_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data witness_note: String = "Lane 2 executable model surface for the .gitattributes Git compatibility projection (generated-file conflict policy charter). The load-bearing claims: (1) every gunbc.generated_artifact.committed_generated_artifact_paths() entry — including .gitattributes itself — carries merge=generated-artifact derived from registry membership, not a hand-maintained roster; (2) the **/*.dag linguist row is an independent presentation-policy fact; (3) committed bytes match gunbc.gitattributes_emit.expected_gitattributes() (drift-gated via gunbc.generated_artifact.GitattributesArtifact). RED controls: dropping a path from the emission while it remains committed, or omitting the linguist row, must fail."

fn emitted_content_has_merge_row_for(content: String, path: String) -> Bool {
  string_contains(
    s: content,
    pattern: concat(concat(path, " "), gunbc.gitattributes_emit.generated_projection_merge_attribute)
  )
}

fn expected_gitattributes_has_merge_row_for(path: String) -> Bool {
  match gunbc.gitattributes_emit.expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => emitted_content_has_merge_row_for(content: content, path: path)
  }
}

fn all_generated_projection_paths_have_merge_rows() -> Bool {
  match gunbc.generated_projection_paths.deterministic_generated_projection_paths() {
    GeneratedProjectionPathsRefused { cause: _ } => false
    GeneratedProjectionPathsAccepted { paths } => all(paths, p => expected_gitattributes_has_merge_row_for(path: p))
  }
}

test fn witness_all_committed_paths_have_merge_rows_holds() -> Bool {
  count(gunbc.generated_artifact.committed_generated_artifact_paths()) > 0
    && all_generated_projection_paths_have_merge_rows()
    && expected_gitattributes_has_merge_row_for(path: ".gitattributes")
    && expected_gitattributes_has_merge_row_for(path: "src/v1/stage0/src/v1_interpreter_dispatch_generated.rs")
}

test fn witness_projection_population_contains_dispatch_generated() -> Bool {
  match gunbc.generated_projection_paths.deterministic_generated_projection_paths() {
    GeneratedProjectionPathsRefused { cause: _ } => false
    GeneratedProjectionPathsAccepted { paths } =>
      paths |> any(path => path == "src/v1/stage0/src/v1_interpreter_dispatch_generated.rs")
  }
}

test fn witness_duplicate_projection_path_refuses_before_emission() -> Bool {
  match gunbc.generated_projection_paths.deterministic_generated_projection_paths_from_rows(rows: [
    gunbc.generated_projection_paths.GeneratedProjectionPathRow { path: "same/path.rs" },
    gunbc.generated_projection_paths.GeneratedProjectionPathRow { path: "same/path.rs" }
  ]) {
    gunbc.generated_projection_paths.GeneratedProjectionPathsRefused { cause: gunbc.generated_projection_paths.GeneratedProjectionPathCollision { path } } =>
      path == "same/path.rs"
    GeneratedProjectionPathsAccepted { paths: _ } => false
  }
}

test fn witness_presentation_policy_row_present_holds() -> Bool {
  match gunbc.gitattributes_emit.expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => string_contains(
      s: content,
      pattern: concat(concat(gunbc.gitattributes_emit.dag_linguist_presentation_policy_pattern, " "), gunbc.gitattributes_emit.dag_linguist_presentation_policy_attribute)
    )
  }
}

test fn witness_committed_matches_emit_holds() -> Bool {
  let committed = Filesystem.Read(path: gunbc.generated_artifact.artifact_path(a: gunbc.generated_artifact.GitattributesArtifact))
  match gunbc.gitattributes_emit.expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => committed.success && committed.content == content
  }
}

test fn witness_red_missing_merge_row_fails() -> Bool {
  !expected_gitattributes_has_merge_row_for(path: "__gunbc_red_control_missing_path__")
}

test fn witness_red_perturbed_emit_drifts() -> Bool {
  let committed = Filesystem.Read(path: gunbc.generated_artifact.artifact_path(a: gunbc.generated_artifact.GitattributesArtifact))
  match gunbc.gitattributes_emit.expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => committed.success && !(concat(committed.content, "\n# perturb") == content)
  }
}

test fn witness_holds() -> Bool {
  witness_all_committed_paths_have_merge_rows_holds()
    && witness_projection_population_contains_dispatch_generated()
    && witness_duplicate_projection_path_refuses_before_emission()
    && witness_presentation_policy_row_present_holds()
    && witness_committed_matches_emit_holds()
    && witness_red_missing_merge_row_fails()
    && witness_red_perturbed_emit_drifts()
}
