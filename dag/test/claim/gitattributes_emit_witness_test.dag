module test.claim.gitattributes_emit_witness

import gunbc.generated_artifact {
  GitattributesArtifact,
  committed_generated_artifact_paths,
  artifact_path
}
import gunbc.gitattributes_emit {
  expected_gitattributes,
  all_committed_paths_have_merge_rows,
  dag_linguist_presentation_policy_pattern,
  dag_linguist_presentation_policy_attribute,
  generated_projection_merge_attribute,
  gitattributes_has_merge_row_for
}
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data witness_note: String = "Lane 2 executable model surface for the .gitattributes Git compatibility projection (generated-file conflict policy charter). The load-bearing claims: (1) every committed_generated_artifact_paths() entry — including .gitattributes itself — carries merge=generated-artifact derived from registry membership, not a hand-maintained roster; (2) the **/*.dag linguist row is an independent presentation-policy fact; (3) committed bytes match expected_gitattributes() (drift-gated via GitattributesArtifact). RED controls: dropping a path from the emission while it remains committed, or omitting the linguist row, must fail."

test fn witness_all_committed_paths_have_merge_rows_holds() -> Bool {
  count(committed_generated_artifact_paths()) > 0
    && all_committed_paths_have_merge_rows()
    && gitattributes_has_merge_row_for(path: ".gitattributes")
}

test fn witness_presentation_policy_row_present_holds() -> Bool {
  string_contains(
    s: expected_gitattributes(),
    pattern: concat(
      concat(dag_linguist_presentation_policy_pattern, " "),
      dag_linguist_presentation_policy_attribute
    )
  )
}

test fn witness_committed_matches_emit_holds() -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: GitattributesArtifact))
  committed.success && (committed.content == expected_gitattributes())
}

test fn witness_red_missing_merge_row_fails() -> Bool {
  !gitattributes_has_merge_row_for(path: "__gunbc_red_control_missing_path__")
}

test fn witness_red_perturbed_emit_drifts() -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: GitattributesArtifact))
  committed.success
    && !(concat(committed.content, "\n# perturb") == expected_gitattributes())
}

test fn witness_holds() -> Bool {
  witness_all_committed_paths_have_merge_rows_holds()
    && witness_presentation_policy_row_present_holds()
    && witness_committed_matches_emit_holds()
    && witness_red_missing_merge_row_fails()
    && witness_red_perturbed_emit_drifts()
}
