module test.claim.gitattributes_emit_witness

import gunbc.generated_artifact {
  GitattributesArtifact,
  committed_generated_artifact_paths,
  artifact_path
}
import gunbc.gitattributes_emit {
  GitattributesGenerated,
  GitattributesGenerationRefused,
  expected_gitattributes,
  dag_linguist_presentation_policy_pattern,
  dag_linguist_presentation_policy_attribute,
  generated_projection_merge_attribute
}
import gunbc.generated_projection_paths {
  GeneratedProjectionPathCollision,
  GeneratedProjectionPathRow,
  GeneratedProjectionPathsAccepted,
  GeneratedProjectionPathsRefused,
  deterministic_generated_projection_paths,
  deterministic_generated_projection_paths_from_rows
}
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data witness_note: String = "Lane 2 executable model surface for the .gitattributes Git compatibility projection (generated-file conflict policy charter). The load-bearing claims: (1) every committed_generated_artifact_paths() entry — including .gitattributes itself — carries merge=generated-artifact derived from registry membership, not a hand-maintained roster; (2) the **/*.dag linguist row is an independent presentation-policy fact; (3) committed bytes match expected_gitattributes() (drift-gated via GitattributesArtifact). RED controls: dropping a path from the emission while it remains committed, or omitting the linguist row, must fail."

fn emitted_content_has_merge_row_for(content: String, path: String) -> Bool {
  string_contains(
    s: content,
    pattern: concat(concat(path, " "), generated_projection_merge_attribute)
  )
}

fn expected_gitattributes_has_merge_row_for(path: String) -> Bool {
  match expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => emitted_content_has_merge_row_for(content: content, path: path)
  }
}

fn all_generated_projection_paths_have_merge_rows() -> Bool {
  match deterministic_generated_projection_paths() {
    GeneratedProjectionPathsRefused { cause: _ } => false
    GeneratedProjectionPathsAccepted { paths } => all(paths, p => expected_gitattributes_has_merge_row_for(path: p))
  }
}

test fn witness_all_committed_paths_have_merge_rows_holds() -> Bool {
  count(committed_generated_artifact_paths()) > 0
    && all_generated_projection_paths_have_merge_rows()
    && expected_gitattributes_has_merge_row_for(path: ".gitattributes")
}

data stage0_projection_retirement_control_note: String = "INVERTED, NOT DELETED. This position formerly asserted that the projection population CONTAINS src/v1/stage0/src/std_algebra.rs, and the sibling claim above asserted the same path carries a merge row. Both were true while regen_stage0 re-derived that file; the v1 cut deleted the generator, so a frozen .rs is a projection of nothing and its auto-resolve licence retires. The claim is inverted rather than dropped so the retirement keeps an executing consumer: if the stage0 half of the join is ever restored by reflex, this reds. std_algebra.rs is named specifically because it was the prior claim's own witness path, so the two readings cannot drift apart."

test fn witness_stage0_rust_absent_from_projection_population() -> Bool {
  match deterministic_generated_projection_paths() {
    GeneratedProjectionPathsRefused { cause: _ } => false
    GeneratedProjectionPathsAccepted { paths } =>
      count(paths) > 0
        && !(paths |> any(path => path == "src/v1/stage0/src/std_algebra.rs"))
  }
}

test fn witness_duplicate_projection_path_refuses_before_emission() -> Bool {
  match deterministic_generated_projection_paths_from_rows(rows: [
    GeneratedProjectionPathRow { path: "same/path.rs" },
    GeneratedProjectionPathRow { path: "same/path.rs" }
  ]) {
    GeneratedProjectionPathsRefused { cause: GeneratedProjectionPathCollision { path } } =>
      path == "same/path.rs"
    GeneratedProjectionPathsAccepted { paths: _ } => false
  }
}

test fn witness_presentation_policy_row_present_holds() -> Bool {
  match expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => string_contains(
      s: content,
      pattern: concat(concat(dag_linguist_presentation_policy_pattern, " "), dag_linguist_presentation_policy_attribute)
    )
  }
}

test fn witness_committed_matches_emit_holds() -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: GitattributesArtifact))
  match expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => committed.success && committed.content == content
  }
}

test fn witness_red_missing_merge_row_fails() -> Bool {
  !expected_gitattributes_has_merge_row_for(path: "__gunbc_red_control_missing_path__")
}

test fn witness_red_perturbed_emit_drifts() -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: GitattributesArtifact))
  match expected_gitattributes() {
    GitattributesGenerationRefused => false
    GitattributesGenerated { content } => committed.success && !(concat(committed.content, "\n# perturb") == content)
  }
}

test fn witness_holds() -> Bool {
  witness_all_committed_paths_have_merge_rows_holds()
    && witness_stage0_rust_absent_from_projection_population()
    && witness_duplicate_projection_path_refuses_before_emission()
    && witness_presentation_policy_row_present_holds()
    && witness_committed_matches_emit_holds()
    && witness_red_missing_merge_row_fails()
    && witness_red_perturbed_emit_drifts()
}
