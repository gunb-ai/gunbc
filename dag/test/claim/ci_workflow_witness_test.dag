module test.claim.ci_workflow_witness_test

import std.types { Bool, Int }
import std.measure { minute_count }
import gunbc.ci_workflow {
  ci_workflow,
  gunbc_ci_job_backstop_timeout_minutes,
  gunbc_ci_build_job_backstop_timeout_minutes,
  gunbc_ci_artifact_transfer_step_timeout_minutes,
  gunbc_ci_aux_step_timeout_minutes,
  gunbc_ci_workflow_wrapper_timeout_minutes,
  gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes,
  gunbc_ci_stage0_partition_compile_gate_timeout_minutes,
  gunbc_ci_release_build_step_timeout_minutes,
  gunbc_ci_prelude_allowance_minutes,
}
import gunbc.ci_workflow_expressions { ci_fleet_job_if }
import gunbc.ci_spec {
  gunbc_ci_ordinary_floor_budget_minutes,
  gunbc_ci_admission_postcondition_budget_minutes,
  gunbc_ci_walk_overhead_allowance_minutes,
  gunbc_ci_workflow_wrapper_budget_minutes,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ci_job_backstop_is_step_sum_plus_prelude() -> Bool {
  gunbc_ci_job_backstop_timeout_minutes() == (gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_workflow_wrapper_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes)
}

fn ci_build_job_backstop_is_step_sum_plus_prelude() -> Bool {
  gunbc_ci_build_job_backstop_timeout_minutes() == (gunbc_ci_aux_step_timeout_minutes + gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes + gunbc_ci_stage0_partition_compile_gate_timeout_minutes + gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes)
}

data backstop_magnitude_pin_deleted_note: String = "ci_job_backstop_equals_one_hundred_minutes DELETED (the live-state count-transcription class, operator ruling 2026-07-30 — same class as the roadmap 63-declared pin): it mirrored the derived step-sum as a literal, so any legitimate step roster change redded it and the reviewer's move was editing the number until it matched. It redded here when the two receipt-gate steps moved in-executor (100 -> 90) — a correct change reported as a failure. The invariant that MATTERS is magnitude-independent and stays asserted: the backstop equals the exact step-sum + prelude.\n\nSECOND DELETION, same class, caught by execution rather than by reading (2026-08-11): ci_job_backstop_dropped_the_selection_control_term asserted !(backstop == 115), encoding as a SENTINEL the value that would obtain if the 15-minute selection-control term were still summed. That is a magnitude pin wearing a structural name — it does not read the roster, it reads a number — and it survived the first deletion only because 115 happened to be unreachable by any other route. It stopped being unreachable when the floor-receipts upload step added one 5-minute aux term to a 110-minute base, landing on exactly 115 by a path that has nothing to do with selection control. The witness would have redded on a correct change and the reviewer's move would again have been editing the number, which is the whole failure mode the first deletion was ruled on.\n\nWHY DELETING IT LOSES NOTHING: ci_job_backstop_is_step_sum_plus_prelude asserts EXACT equality against an enumeration that contains no selection-control term, so any sum that included one is unequal to it and reds there. Absence of the term is therefore proven structurally, at a grain a magnitude comparison cannot express — a sentinel can only ever say 'not this one number', while the equality says 'exactly these terms and no others'. The sentinel was strictly weaker than a check already present beside it, which is why the correct repair is deletion rather than picking a fresh number."

test fn ci_workflow_witness_holds() -> Bool {
  ci_job_backstop_is_step_sum_plus_prelude()
    && ci_build_job_backstop_is_step_sum_plus_prelude()
    && (minute_count(m: gunbc_ci_ordinary_floor_budget_minutes) == 80)
    && (minute_count(m: gunbc_ci_admission_postcondition_budget_minutes) == 5)
    && (minute_count(m: gunbc_ci_walk_overhead_allowance_minutes) == 15)
    && (minute_count(m: gunbc_ci_workflow_wrapper_budget_minutes()) == minute_count(m: gunbc_ci_ordinary_floor_budget_minutes) + minute_count(m: gunbc_ci_admission_postcondition_budget_minutes) + minute_count(m: gunbc_ci_walk_overhead_allowance_minutes))
    && (gunbc_ci_workflow_wrapper_timeout_minutes == minute_count(m: gunbc_ci_workflow_wrapper_budget_minutes()))
}

// RED control for the push-to-main skip cascade (measured 2026-08-09: >=30 main pushes
// silently skipped deploy_dashboard_srv1 — and later advance/collect — because
// heal_generated_artifacts skips on ordinary pushes and a needs:[ci] job whose if
// carries NO status function gets GitHub's implicit success() ANDed in, which is false
// downstream of any transitively skipped job). The wall: every job gating on the
// main-push event must carry its OWN status guard, so a skipped dependency can never
// silently read as 'condition false'. This test REDS if the guard is removed from the
// authority row, if any push-to-main job's condition drops it, or if the family
// becomes vacuously empty.
//
// CONSOLIDATION (operator request 2026-08-10): the deploy/collect/advance family (and
// the workflow_dispatch toolbox) collapsed into ONE `fleet` job (gunbc.ci_workflow
// ci_fleet_job) whose job-level if is ci_fleet_job_if — carrying the same !cancelled()
// + needs.ci.result guard on its push arm. The guard-bearing count is therefore 1 now,
// not >= 2; the per-job status-guard check still holds on that one job, and >= 1 keeps
// the "not vacuously empty" protection (a fleet job that drops its main-push arm or its
// status guard still REDs).
test fn push_to_main_family_carries_explicit_status_guard() -> Bool {
  string_contains(s: ci_fleet_job_if, pattern: "!cancelled()")
    && string_contains(s: ci_fleet_job_if, pattern: "needs.ci.result == 'success'")
    && fold_list(
      xs: ci_workflow.jobs,
      empty: true,
      cons: fn(ok, j) {
        if !ok {
          false
        } else {
          match j.if_condition {
            Present { value: c } =>
              if string_contains(s: c, pattern: "refs/heads/main") && string_contains(s: c, pattern: "github.event_name == 'push'") {
                string_contains(s: c, pattern: "!cancelled()") && string_contains(s: c, pattern: "needs.ci.result == 'success'")
              } else {
                true
              }
            _ => true
          }
        }
      }
    )
    && fold_list(
      xs: ci_workflow.jobs,
      empty: 0,
      cons: fn(n, j) {
        match j.if_condition {
          Present { value: c } =>
            if string_contains(s: c, pattern: "refs/heads/main") && string_contains(s: c, pattern: "github.event_name == 'push'") {
              n + 1
            } else {
              n
            }
          _ => n
        }
      }
    ) >= 1
}
