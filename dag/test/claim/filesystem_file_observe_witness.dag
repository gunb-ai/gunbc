module test.claim.filesystem_file_observe_witness

import gunbc.filesystem_file_observe {
  filesystem_path_decomposition,
  FilesystemPathDecomposed,
  FilesystemPathUndecomposable,
  filesystem_file_observation_of_path,
}
import extdeps.filesystem.filesystem_io {
  FilesystemFileObservation,
  FilesystemFileAbsent,
  FilesystemFileRead,
  FilesystemFileIndeterminate,
  FilesystemFileObservationsDisagree,
  FilesystemFileSubjectRefused,
  FilesystemEntryPresence,
  FilesystemEntryAbsent,
  FilesystemEntryListed,
  FilesystemEntryPresenceIndeterminate,
  FilesystemReadRefused,
  FilesystemReadSucceeded,
  filesystem_listing_observation,
  filesystem_entry_presence,
  filesystem_file_observation,
  filesystem_file_observation_below_ancestor,
}
import std.types { Bool, String }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

// These execute the pure path-decomposition authority that fronts every
// filesystem_file_observation_of_path call (review on the head of the helper's introduction). The
// authority must name, as directory plus entry name, the same subject the caller's read names -- so
// a single-component absolute operand observes the root, not the empty string -- and it must refuse
// the operand shapes it cannot decompose BEFORE the wet operation lists or reads anything. Native
// acquisition is exercised by the wet operation's own callers; the wet operation holds no path
// semantics of its own to discriminate here.

test fn a_two_component_absolute_path_decomposes_to_its_directory_and_entry() -> Bool {
  match filesystem_path_decomposition(path: "/tmp/token") {
    FilesystemPathDecomposed { directory: d, name: n } => d == "/tmp" && n == "token"
    FilesystemPathUndecomposable { cause: _ } => false
  }
}

test fn a_root_level_absolute_path_decomposes_to_the_root_not_the_empty_string() -> Bool {
  match filesystem_path_decomposition(path: "/token") {
    FilesystemPathDecomposed { directory: d, name: n } => d == "/" && n == "token"
    FilesystemPathUndecomposable { cause: _ } => false
  }
}

test fn a_two_component_relative_path_decomposes_to_its_directory_and_entry() -> Bool {
  match filesystem_path_decomposition(path: "target/token") {
    FilesystemPathDecomposed { directory: d, name: n } => d == "target" && n == "token"
    FilesystemPathUndecomposable { cause: _ } => false
  }
}

test fn a_dot_prefixed_path_decomposes_to_the_dot_directory_and_entry() -> Bool {
  match filesystem_path_decomposition(path: "./token") {
    FilesystemPathDecomposed { directory: d, name: n } => d == "." && n == "token"
    FilesystemPathUndecomposable { cause: _ } => false
  }
}

test fn a_bare_entry_name_is_refused_for_having_no_directory_operand() -> Bool {
  match filesystem_path_decomposition(path: "token") {
    FilesystemPathUndecomposable { cause: c } =>
      string_contains(s: c, pattern: "no directory operand to list")
    FilesystemPathDecomposed { directory: _, name: _ } => false
  }
}

test fn the_empty_operand_is_refused() -> Bool {
  match filesystem_path_decomposition(path: "") {
    FilesystemPathUndecomposable { cause: c } => string_contains(s: c, pattern: "operand is empty")
    FilesystemPathDecomposed { directory: _, name: _ } => false
  }
}

test fn an_operand_ending_in_a_separator_is_refused_for_naming_a_directory() -> Bool {
  match filesystem_path_decomposition(path: "/") {
    FilesystemPathUndecomposable { cause: c } =>
      string_contains(s: c, pattern: "names a directory rather than an entry in one")
    FilesystemPathDecomposed { directory: _, name: _ } => false
  }
}

test fn a_relative_operand_ending_in_a_separator_is_refused_the_same_way() -> Bool {
  match filesystem_path_decomposition(path: "a/") {
    FilesystemPathUndecomposable { cause: c } =>
      string_contains(s: c, pattern: "names a directory rather than an entry in one")
    FilesystemPathDecomposed { directory: _, name: _ } => false
  }
}

test fn a_dot_cursor_entry_name_is_refused() -> Bool {
  match filesystem_path_decomposition(path: "a/.") {
    FilesystemPathUndecomposable { cause: c } => string_contains(s: c, pattern: "'.' directory cursor")
    FilesystemPathDecomposed { directory: _, name: _ } => false
  }
}

test fn a_dot_dot_cursor_entry_name_is_refused() -> Bool {
  match filesystem_path_decomposition(path: "a/..") {
    FilesystemPathUndecomposable { cause: c } =>
      string_contains(s: c, pattern: "'..' directory cursor")
    FilesystemPathDecomposed { directory: _, name: _ } => false
  }
}

// ANCESTOR-ABSENCE CONTROLS over supplied boundary values: a file whose parent directory is missing
// (operations/<node>/ of a first operation) is absent when the grandparent's successful listing
// lacks the parent, and stays indeterminate when that ancestor could not be listed.
fn missing_parent_listing() -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/w/operations/n", success: false, entries: "", error: "No such file or directory (os error 2)"),
    name: "op.json",
    path: "/w/operations/n/op.json",
    read: FilesystemReadRefused { error: "No such file or directory (os error 2)" },
  )
}

fn ancestor_listed_as(success: Bool, entries: String) -> FilesystemEntryPresence {
  filesystem_entry_presence(
    listing: filesystem_listing_observation(directory: "/w/operations", success: success, entries: entries, error: "Permission denied (os error 13)"),
    name: "n",
  )
}

test fn a_missing_parent_proven_by_a_successful_ancestor_listing_is_an_absence() -> Bool {
  match filesystem_file_observation_below_ancestor(
    observation: missing_parent_listing(),
    ancestor: ancestor_listed_as(success: true, entries: "other\n"),
    path: "/w/operations/n/op.json",
    read: FilesystemReadRefused { error: "No such file or directory (os error 2)" },
  ) {
    FilesystemFileAbsent(_) => true
    FilesystemFileIndeterminate { cause: _ } => false
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

test fn an_unlistable_ancestor_leaves_the_observation_indeterminate() -> Bool {
  match filesystem_file_observation_below_ancestor(
    observation: missing_parent_listing(),
    ancestor: ancestor_listed_as(success: false, entries: ""),
    path: "/w/operations/n/op.json",
    read: FilesystemReadRefused { error: "No such file or directory (os error 2)" },
  ) {
    FilesystemFileIndeterminate { cause: _ } => true
    FilesystemFileAbsent(_) => false
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

test fn a_listed_parent_whose_own_listing_failed_stays_indeterminate() -> Bool {
  match filesystem_file_observation_below_ancestor(
    observation: missing_parent_listing(),
    ancestor: ancestor_listed_as(success: true, entries: "n\n"),
    path: "/w/operations/n/op.json",
    read: FilesystemReadRefused { error: "Permission denied (os error 13)" },
  ) {
    FilesystemFileIndeterminate { cause: _ } => true
    FilesystemFileAbsent(_) => false
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

test fn a_read_that_succeeded_below_an_absent_ancestor_is_a_disagreement() -> Bool {
  match filesystem_file_observation_below_ancestor(
    observation: missing_parent_listing(),
    ancestor: ancestor_listed_as(success: true, entries: "other\n"),
    path: "/w/operations/n/op.json",
    read: FilesystemReadSucceeded { content: "x" },
  ) {
    FilesystemFileObservationsDisagree { path: _, cause: _ } => true
    FilesystemFileAbsent(_) => false
    FilesystemFileIndeterminate { cause: _ } => false
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

test fn an_existing_receipt_is_still_read_not_touched_by_the_ancestor_fold() -> Bool {
  let listed = filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/w/operations/n", success: true, entries: "op.json\n", error: ""),
    name: "op.json",
    path: "/w/operations/n/op.json",
    read: FilesystemReadSucceeded { content: "{}" },
  )
  match filesystem_file_observation_below_ancestor(
    observation: listed,
    ancestor: ancestor_listed_as(success: true, entries: "other\n"),
    path: "/w/operations/n/op.json",
    read: FilesystemReadSucceeded { content: "{}" },
  ) {
    FilesystemFileRead { path: _, content: c } => c == "{}"
    FilesystemFileAbsent(_) => false
    FilesystemFileIndeterminate { cause: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

test fn an_existing_directory_without_the_file_is_absent_as_before() -> Bool {
  let listed = filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/w/operations/n", success: true, entries: "other.json\n", error: ""),
    name: "op.json",
    path: "/w/operations/n/op.json",
    read: FilesystemReadRefused { error: "No such file or directory (os error 2)" },
  )
  match listed {
    FilesystemFileAbsent(_) => true
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileIndeterminate { cause: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

// INHABITANCE: the real wet producer, over a checkout directory that exists and two missing levels below it.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn the_real_producer_establishes_a_file_two_missing_levels_deep_absent() -> Bool {
  match filesystem_file_observation_of_path(path: "dag/std/gunbc-no-such-level-one/no-such-level-two/op.json") {
    FilesystemFileAbsent(_) => true
    FilesystemFileIndeterminate { cause: _ } => false
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}
