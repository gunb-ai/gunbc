module test.claim.parameter_default_at_declared_type_witness

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}

// A PARAMETER DEFAULT IS JUDGED AGAINST ITS PARAMETER'S DECLARED TYPE (v1.compiler.infer PositionParameterDefault via
// parameter_default_emissions). Before it, `fn f(v: Nat = "x")` was accepted silently: gunbc.recurring_failure_mode
// a_parameter_default_value_is_never_judged_against_its_parameter_type, executed by sunny-newt-661 on binary f6c9e59c3d84
// (defaults `3`, `"x"`, `0 - 5`, `Wrap { n: 1 }` all gave blocking-rows zero, indistinguishable from the control).
//
// UNRUN: authored, not executed. The two REDs are expected to FAIL on a tree without the producer; the control is expected
// to PASS before and after. An authoring defect shows as the control failing.
//
// NOT ASSERTED: `0 - 5` at Nat. Whether it refuses depends on the arithmetic-over-grounded-carriers decision (Q1e), so no
// cell here claims either answer.
//
// dissolve-on: none -- permanent regression control per DESIGN 4b(4).

fn pdw_refusal_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "DeclaredTypeNotInhabited")))
        + census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch")))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn pdw_source(default: String) -> String {
  "module pdw.probe\n\nimport std.types { String }\n\nimport std.nat { Nat }\n\ntype Wrap {\n  n: Nat\n}\n\nfn f(v: Nat = " + default + ") -> Nat {\n  v\n}\n"
}

// RED: a String default at a Nat parameter must refuse.
test fn a_string_default_at_a_nat_parameter_must_refuse() -> Bool {
  pdw_refusal_count(source: pdw_source(default: "\"x\"")) >= 1
}

// RED: a record default at a Nat parameter must refuse.
test fn a_record_default_at_a_nat_parameter_must_refuse() -> Bool {
  pdw_refusal_count(source: pdw_source(default: "Wrap { n: 1 }")) >= 1
}

// CONTROL: a non-negative literal default at Nat is accepted (the refusal is not a blanket one).
test fn a_non_negative_literal_default_at_a_nat_parameter_is_accepted() -> Bool {
  pdw_refusal_count(source: pdw_source(default: "3")) == 0
}
