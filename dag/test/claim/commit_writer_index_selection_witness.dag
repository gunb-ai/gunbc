module test.claim.commit_writer_index_selection_witness

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.integer { UInt8 }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.content_hash { Sha1Digest, Sha1DigestHex }
import extdeps.git.object_store {
  GitPath,
  GitPathDecoded,
  GitPathDecodeRefused,
  GitTreeEntryName,
  GitTreeEntryNameOctetAfterSlash,
  GitTreeEntryNameAfterSlashValue,
  GitIndexEntry,
  GitIndexStage,
  GitIndexStageNormal,
  GitIndexStageBase,
  GitIndexStageOurs,
  GitIndexStageTheirs,
  GitObjectId,
  GitSha1ObjectId,
  GitRegularBlobMode,
  git_decode_path_octets,
  git_object_id_wire_hex,
}
import gunbc.commit_workflow { commit_writer_index_entries_for_path }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// BEHAVIOURAL CONTROL for gunbc.commit_workflow commit_writer_index_entries_for_path, owed by the
// operator verdict on gunbc#7480 (2026-08-02). Production now uses index |> filter(entry =>
// entry.path == path): the algebra FreeMonoid filter capture that forced the flat_map keep-or-drop
// spelling is gone with the retirement onto the collection roster (census #13541). These rows stay
// enrolled (DESIGN §4b: dissolve production handling, never the evidence). Coverage is the
// verdict's list: two or more entries, matching AND nonmatching paths, and preservation of both
// the ORDER and the STAGE of matching entries -- order and stage are asserted rather than counted
// because a selection that returned the right NUMBER of entries while reordering them, dropping a
// duplicate-path stage, or rewriting a stage would still be wrong, and a count alone cannot see
// any of that. The closure is live: importing gunbc.commit_workflow still pulls
// v2.compiler.source_authority.

fn oid_of(hex: String) -> GitObjectId {
  GitSha1ObjectId { digest: Sha1Digest { hex: hex as Sha1DigestHex } }
}

data oid_a1: String = "aa11111111111111111111111111111111111111"
data oid_b1: String = "bb11111111111111111111111111111111111111"
data oid_a2: String = "aa22222222222222222222222222222222222222"
data oid_b2: String = "bb22222222222222222222222222222222222222"

fn fallback_path() -> GitPath {
  GitPath {
    first: GitTreeEntryName {
      first: GitTreeEntryNameOctetAfterSlash {
        value: 120 as GitTreeEntryNameAfterSlashValue
      },
      rest: []
    },
    rest: []
  }
}

fn path_of(octets: List<UInt8>) -> GitPath {
  match git_decode_path_octets(octets: octets) {
    GitPathDecoded { path } => path
    GitPathDecodeRefused { cause: _ } => fallback_path()
  }
}

fn path_a() -> GitPath {
  path_of(octets: [97, 47, 97, 46, 100, 97, 103])
}

fn path_b() -> GitPath {
  path_of(octets: [98, 47, 98, 46, 100, 97, 103])
}

fn path_absent() -> GitPath {
  path_of(octets: [122, 47, 122, 46, 100, 97, 103])
}

fn entry_of(path: GitPath, oid_hex: String, stage: GitIndexStage) -> GitIndexEntry {
  GitIndexEntry {
    path: path,
    mode: GitRegularBlobMode,
    oid: oid_of(hex: oid_hex),
    stage: stage
  }
}

fn stage_tag(entry: GitIndexEntry) -> String {
  match entry.stage {
    GitIndexStageNormal => "N"
    GitIndexStageBase => "B"
    GitIndexStageOurs => "O"
    GitIndexStageTheirs => "T"
  }
}

fn stage_trace(entries: List<GitIndexEntry>) -> String {
  fold(entries, init: "", f: (acc, e) => concat(acc, stage_tag(entry: e)))
}

fn oid_trace(entries: List<GitIndexEntry>) -> String {
  fold(entries, init: "", f: (acc, e) => concat(acc, git_object_id_wire_hex(oid: e.oid) as String))
}

fn mixed_index() -> List<GitIndexEntry> {
  [
    entry_of(path: path_a(), oid_hex: oid_a1, stage: GitIndexStageNormal),
    entry_of(path: path_b(), oid_hex: oid_b1, stage: GitIndexStageBase),
    entry_of(path: path_a(), oid_hex: oid_a2, stage: GitIndexStageOurs),
    entry_of(path: path_b(), oid_hex: oid_b2, stage: GitIndexStageNormal)
  ]
}

test fn selection_keeps_only_the_matching_path() -> Bool {
  count(commit_writer_index_entries_for_path(index: mixed_index(), path: path_a())) == 2
    && count(commit_writer_index_entries_for_path(index: mixed_index(), path: path_b())) == 2
}

test fn selection_preserves_matching_order_and_identity() -> Bool {
  let selected = commit_writer_index_entries_for_path(index: mixed_index(), path: path_a())
  oid_trace(entries: selected) == concat(oid_a1, oid_a2)
}

test fn selection_preserves_matching_stage() -> Bool {
  stage_trace(entries: commit_writer_index_entries_for_path(index: mixed_index(), path: path_a())) == "NO"
    && stage_trace(entries: commit_writer_index_entries_for_path(index: mixed_index(), path: path_b())) == "BN"
}

test fn selection_of_a_nonmatching_path_is_empty() -> Bool {
  count(commit_writer_index_entries_for_path(index: mixed_index(), path: path_absent())) == 0
}

test fn selection_of_an_empty_index_is_empty() -> Bool {
  count(commit_writer_index_entries_for_path(index: [], path: path_a())) == 0
}

test fn the_two_paths_select_disjoint_entries() -> Bool {
  let from_a = oid_trace(entries: commit_writer_index_entries_for_path(index: mixed_index(), path: path_a()))
  let from_b = oid_trace(entries: commit_writer_index_entries_for_path(index: mixed_index(), path: path_b()))
  from_a != from_b
}
