module test.claim.kernel_declaration_binding_native

import std.types { Bool, List, String }
import std.optional { Present, Absent }
import std.decl_ref { decl_ref }
import std.occurrence_identity { OccurrenceSynthetic }
import v1.std.core { leaf_node_with_span, kernel_span }
import v1.compiler.infer_resolve { node_with_declaration }
import v1.compiler.infer_env { empty_type_env, kernel_settled_name }
import v2.extdeps.languages.dag { dag_kernel_type_declaration_binding_optional, dag_kernel_type_binding_optional }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.node { symbol_intern_lexeme }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimHeld, NativeClaimNotHeld }
import v2.test.claim.compiler.kernel_value_type_roster_witness {
  kvr_every_kernel_value_type_is_denoted_by_its_own_identity_holds,
  kvr_a_spelling_and_its_declarations_bind_what_the_join_denotes_holds,
  kvr_symbol_and_char_are_a_recorded_fork_that_binds_no_spelling_holds
}

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

fn kernel_seed_read(module_path: String, name: String) -> String? {
  let env = empty_type_env()
  let subject = node_with_declaration(
    n: leaf_node_with_span(occurrence_identity: OccurrenceSynthetic, name: name, span: kernel_span(name: name)),
    declaration: decl_ref(module_path: module_path, decl_name: name)
  )
  kernel_settled_name(n: subject, source_indices: env.source_indices, env: env, fuel: 16)
}

fn kernel_readers_agree(module_path: String, name: String, spelling: String) -> Bool {
  let v2 = dag_kernel_type_declaration_binding_optional(path: qualified_name_from_dotted_string(dotted: concat(module_path, ".", name)))
  let expected = dag_kernel_type_binding_optional(sym: symbol_intern_lexeme(lexeme: spelling))
  expected != Absent && v2 == expected && kernel_seed_read(module_path: module_path, name: name) == Present { value: spelling }
}

fn kernel_foreign_is_not_int() -> Bool {
  kernel_seed_read(module_path: "test.foreign", name: "Int") == Absent
    && dag_kernel_type_declaration_binding_optional(path: qualified_name_from_dotted_string(dotted: "test.foreign.Int")) == Absent
}

type KernelBindingCase {
  name: String
  held: Bool
}

fn kernel_binding_cases() -> List<KernelBindingCase> {
  [
    KernelBindingCase { name: "std_integer_Int_same_kernel", held: kernel_readers_agree(module_path: "std.integer", name: "Int", spelling: "Int") },
    KernelBindingCase { name: "v2_std_integer_Int_same_kernel", held: kernel_readers_agree(module_path: "v2.std.integer", name: "Int", spelling: "Int") },
    KernelBindingCase { name: "std_types_Bool_same_kernel", held: kernel_readers_agree(module_path: "std.types", name: "Bool", spelling: "Bool") },
    KernelBindingCase { name: "v2_node_Symbol_same_kernel", held: kernel_readers_agree(module_path: "v2.std.node", name: "Symbol", spelling: "Symbol") },
    KernelBindingCase { name: "legacy_String_same_kernel", held: kernel_readers_agree(module_path: "v2.std.node", name: "String", spelling: "String") },
    KernelBindingCase { name: "HostText_same_kernel", held: kernel_readers_agree(module_path: "std.host_text", name: "HostText", spelling: "String") },
    KernelBindingCase { name: "foreign_Int_not_kernel", held: kernel_foreign_is_not_int() },
    KernelBindingCase { name: "v2_binding_denotations_unchanged", held: kvr_every_kernel_value_type_is_denoted_by_its_own_identity_holds() },
    KernelBindingCase { name: "v2_declaration_join_unchanged", held: kvr_a_spelling_and_its_declarations_bind_what_the_join_denotes_holds() },
    KernelBindingCase { name: "v2_unspelled_forks_unchanged", held: kvr_symbol_and_char_are_a_recorded_fork_that_binds_no_spelling_holds() }
  ]
}

fn native_claim_report() -> NativeClaimReport {
  let cases = kernel_binding_cases()
  NativeClaimReport {
    stdout: join(map(cases, c => concat("case ", c.name, if c.held { " held\n" } else { " not_held\n" })), ""),
    terminal: if all(cases, c => c.held) { NativeClaimHeld } else { NativeClaimNotHeld { reason: "seed/v2 kernel declaration readings disagree" } }
  }
}
