module test.claim.plan_citation_census

import std.types { Bool, Int, List, String }
import std.algebra { Cons, Empty, string_contains }
import v2.std.decl_index { DeclFact, decl_facts, decl_facts_at, qualified_name_from_module }

// The one citation reader for plan witnesses (DESIGN section 3: cite the symbol, not the
// position). A plan witness serializes its carrier with `serialize_markdown_source` and asks
// these functions two questions: does the text carry a positional citation, and which
// `module::decl` pieces does it cite, each looked up in the declaration census through
// `qualified_name_from_module`, the function that owns the census key. Hoisted out of
// `test.claim.p4_home_serving_power_semantics_witness` when the serving-fleet plan witness
// became the second reader, so that the rule has one home rather than two copies.

type PlanCitationPositionScan {
  index: Int
  prev_ends_in_digit: Bool
  found_positional: Bool
}

fn plan_citation_is_digit(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789", pattern: c)
}

fn plan_citation_last_is_digit(s: String) -> Bool {
  plan_citation_is_digit(c: substring(s: s, start: s.length() - 1, end: s.length()))
}

fn plan_citation_positional_step(acc: PlanCitationPositionScan, segment: String) -> PlanCitationPositionScan {
  let begins_in_digit = plan_citation_is_digit(c: substring(s: segment, start: 0, end: 1))
  PlanCitationPositionScan {
    index: acc.index + 1,
    prev_ends_in_digit: plan_citation_last_is_digit(s: segment),
    found_positional: acc.found_positional || (acc.index > 0 && begins_in_digit && !acc.prev_ends_in_digit)
  }
}

fn plan_citation_has_positional_citation(t: String) -> Bool {
  fold(
    t.split(delimiter: ":"),
    init: PlanCitationPositionScan { index: 0, prev_ends_in_digit: false, found_positional: false },
    f: plan_citation_positional_step
  ).found_positional
}

type PlanCitation {
  module_path: String
  decl_name: String
  field_name: String
  has_field: Bool
}

fn plan_citation_pieces(t: String) -> List<String> {
  filter(
    flat_map(t.split(delimiter: "\n"), line =>
      flat_map(line.split(delimiter: " "), word => word.split(delimiter: "`"))),
    w => w != ""
  )
}

fn plan_citation_char_of(s: String) -> String {
  substring(s: s, start: s.length() - 1, end: s.length())
}

fn plan_citation_body_is_clean(body: String) -> Bool {
  !(string_contains(s: body, pattern: "/")
    || string_contains(s: body, pattern: "(")
    || string_contains(s: body, pattern: ")")
    || string_contains(s: body, pattern: "[")
    || string_contains(s: body, pattern: "]")
    || string_contains(s: body, pattern: "{")
    || string_contains(s: body, pattern: "}")
    || string_contains(s: body, pattern: ",")
    || string_contains(s: body, pattern: ";")
    || string_contains(s: body, pattern: "*")
    || string_contains(s: body, pattern: "?")
    || string_contains(s: body, pattern: "=")
    || string_contains(s: body, pattern: "+")
    || string_contains(s: body, pattern: "<")
    || string_contains(s: body, pattern: ">")
    || string_contains(s: body, pattern: "&")
    || string_contains(s: body, pattern: "!")
    || string_contains(s: body, pattern: "\"")
    || string_contains(s: body, pattern: "'")
    || string_contains(s: body, pattern: "~")
    || string_contains(s: body, pattern: "^")
    || string_contains(s: body, pattern: "|")
    || string_contains(s: body, pattern: "#")
    || string_contains(s: body, pattern: "\\")
    || plan_citation_char_of(s: body) == "."
    || substring(s: body, start: 0, end: 1) == ".")
}

fn plan_citation_is_citation_shape(w: String) -> Bool {
  match w.split(delimiter: "::") {
    Cons { head: m, tail: Cons { head: d, tail: Empty } } => m != "" && d != "" && plan_citation_body_is_clean(body: concat(m, d))
    _ => false
  }
}

fn plan_citation_parse(w: String) -> PlanCitation {
  // Bound with an explicit element type rather than matched in place: a List produced straight
  // off `split` in a pattern leaves the element type as a bare variable, and `rest.split` then
  // fails to resolve (the receiver's type is T, which establishes no method surface). The repo's
  // own readers annotate the bind -- materialization_store_local.dag does exactly this.
  let parts: List<String> = w.split(delimiter: "::")
  match parts {
    Cons { head: m, tail: Cons { head: rest, tail: Empty } } =>
      {
      let dots: List<String> = rest.split(delimiter: ".")
      match dots {
        Cons { head: d, tail: Cons { head: fld, tail: Empty } } =>
          PlanCitation { module_path: m, decl_name: d, field_name: fld, has_field: true }
        _ => PlanCitation { module_path: m, decl_name: rest, field_name: "", has_field: false }
      }
      }
    _ => PlanCitation { module_path: "", decl_name: "", field_name: "", has_field: false }
  }
}

fn plan_citation_roster_step(acc: List<String>, w: String) -> List<String> {
  if plan_citation_is_citation_shape(w) && !any(acc, a => a == w) { Cons { head: w, tail: acc } } else { acc }
}

fn plan_citation_citation_roster(t: String) -> List<String> {
  fold(plan_citation_pieces(t), init: Empty {}, f: plan_citation_roster_step)
}

fn plan_citation_occurrences(t: String, cite: String) -> Int {
  // n occurrences of a separator produce n+1 pieces, so occurrences = pieces - 1. The
  // obvious `filter(non-empty).length()` undercounts (two occurrences with an empty piece
  // between them give 1, not 2) -- caught by running the roster arithmetic, not by reading it.
  t.split(delimiter: cite).length() - 1
}

fn plan_citation_census_pool_roots() -> List<String> {
  ["dag", "src/v1", "src/v2"]
}

// The census key of a citation, built only by the function that owns that key.
fn plan_citation_census_key(c: PlanCitation) -> String {
  qualified_name_from_module(module_name: c.module_path, name: c.decl_name)
}

fn plan_citation_census_rows_parsed(c: PlanCitation) -> List<DeclFact> {
  decl_facts_at(pool_roots: plan_citation_census_pool_roots(), qualified_name: plan_citation_census_key(c: c))
}

// MANY CITATIONS, ONE READ. A keyed read rebuilds the declaration pool on every call: measured on
// BuildBuddy 2026-10-25, one lookup took 91s and six took 506s in one process, while one full
// read joined against the same six (and a name no module declares) took 114s. A claim that
// resolves a population reads the census once and joins each citation against it; the key is
// the same `plan_citation_census_key`, so the two routes cannot disagree about a citation.
fn plan_citation_census_facts() -> List<DeclFact> {
  decl_facts(pool_roots: plan_citation_census_pool_roots())
}

fn plan_citation_census_rows_in(facts: List<DeclFact>, cite: String) -> List<DeclFact> {
  let k = plan_citation_census_key(c: plan_citation_parse(w: cite))
  filter(facts, f => f.qualified_name == k)
}

fn plan_citation_census_rows(cite: String) -> List<DeclFact> {
  plan_citation_census_rows_parsed(c: plan_citation_parse(w: cite))
}
