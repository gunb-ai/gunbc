module test.claim.descent_evidence_lattice

import std.logic { Bool }
import std.termination {
  DescentEvidence
  Strict
  NonIncreasing
  DescentUnknown
  evidence_rank
  descent_evidence_lattice_meet
  descent_evidence_lattice_join
  promote_to_strict
}

fn rank_of_meet(a: DescentEvidence, b: DescentEvidence) -> Int {
  evidence_rank(e: descent_evidence_lattice_meet(a: a, b: b))
}

fn rank_of_join(a: DescentEvidence, b: DescentEvidence) -> Int {
  evidence_rank(e: descent_evidence_lattice_join(a: a, b: b))
}

fn meet_agrees_with_lattice() -> Bool {
  rank_of_meet(a: Strict, b: Strict) == 2
    && rank_of_meet(a: Strict, b: NonIncreasing) == 1
    && rank_of_meet(a: Strict, b: DescentUnknown) == 0
    && rank_of_meet(a: NonIncreasing, b: NonIncreasing) == 1
    && rank_of_meet(a: NonIncreasing, b: DescentUnknown) == 0
    && rank_of_meet(a: DescentUnknown, b: DescentUnknown) == 0
}

fn join_agrees_with_lattice() -> Bool {
  rank_of_join(a: DescentUnknown, b: DescentUnknown) == 0
    && rank_of_join(a: DescentUnknown, b: NonIncreasing) == 1
    && rank_of_join(a: NonIncreasing, b: Strict) == 2
    && rank_of_join(a: Strict, b: Strict) == 2
}

fn promote_never_fabricates_strict() -> Bool {
  evidence_rank(e: promote_to_strict(evidence: NonIncreasing)) == 1
    && evidence_rank(e: promote_to_strict(evidence: DescentUnknown)) == 0
    && evidence_rank(e: promote_to_strict(evidence: Strict)) == 2
}

fn meet_is_not_join_red_control() -> Bool {
  rank_of_meet(a: Strict, b: DescentUnknown) == 0
    && rank_of_join(a: Strict, b: DescentUnknown) == 2
}

test fn descent_evidence_lattice_witnesses() -> Bool {
  meet_agrees_with_lattice()
    && join_agrees_with_lattice()
    && promote_never_fabricates_strict()
    && meet_is_not_join_red_control()
}
