module test.claim.descent_evidence_lattice


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn rank_of_meet(a: std.termination.DescentEvidence, b: std.termination.DescentEvidence) -> Int {
  std.termination.evidence_rank(e: std.termination.descent_evidence_lattice_meet(a: a, b: b))
}

fn rank_of_join(a: std.termination.DescentEvidence, b: std.termination.DescentEvidence) -> Int {
  std.termination.evidence_rank(e: std.termination.descent_evidence_lattice_join(a: a, b: b))
}

fn meet_agrees_with_lattice() -> Bool {
  rank_of_meet(a: std.termination.Strict, b: std.termination.Strict) == 2
    && rank_of_meet(a: std.termination.Strict, b: std.termination.NonIncreasing) == 1
    && rank_of_meet(a: std.termination.Strict, b: std.termination.DescentUnknown) == 0
    && rank_of_meet(a: std.termination.NonIncreasing, b: std.termination.NonIncreasing) == 1
    && rank_of_meet(a: std.termination.NonIncreasing, b: std.termination.DescentUnknown) == 0
    && rank_of_meet(a: std.termination.DescentUnknown, b: std.termination.DescentUnknown) == 0
}

fn join_agrees_with_lattice() -> Bool {
  rank_of_join(a: std.termination.DescentUnknown, b: std.termination.DescentUnknown) == 0
    && rank_of_join(a: std.termination.DescentUnknown, b: std.termination.NonIncreasing) == 1
    && rank_of_join(a: std.termination.NonIncreasing, b: std.termination.Strict) == 2
    && rank_of_join(a: std.termination.Strict, b: std.termination.Strict) == 2
}

fn promote_never_fabricates_strict() -> Bool {
  std.termination.evidence_rank(e: std.termination.promote_to_strict(evidence: std.termination.NonIncreasing)) == 1
    && std.termination.evidence_rank(e: std.termination.promote_to_strict(evidence: std.termination.DescentUnknown)) == 0
    && std.termination.evidence_rank(e: std.termination.promote_to_strict(evidence: std.termination.Strict)) == 2
}

fn meet_is_not_join_red_control() -> Bool {
  rank_of_meet(a: std.termination.Strict, b: std.termination.DescentUnknown) == 0
    && rank_of_join(a: std.termination.Strict, b: std.termination.DescentUnknown) == 2
}

test fn descent_evidence_lattice_witnesses() -> Bool {
  meet_agrees_with_lattice()
    && join_agrees_with_lattice()
    && promote_never_fabricates_strict()
    && meet_is_not_join_red_control()
}
