module test.claim.host_thermal_admission_gate_witness

// EXECUTED RED/GREEN FOR THE THERMAL ADMISSION GATE.
//
// The gate is the pure predicate gunbc.plans.host_thermal_operating_point.thermal_activatable_units: it
// returns the units a converge may bring UP, given the live active NAMES, the desired units and the fabric
// members. It lives in the plans module (the admitted-concurrency table's home) so the actuation step, the
// cap bracket (restart/release) and this witness all read ONE truth (DESIGN §3). This witness runs in a tiny
// closure (the plans module reaches no fleet/ssh/compiler subtree), so the gate has an executed discriminator
// even while the whole-closure runner witnesses are interpreter-untypecheckable behind the #15175 equality
// refusal.
//
// THE CLAIMS, one per path rung (DESIGN 4b):
//   * an over-count (cooling-held) unit is NOT started;
//   * an admitted unit with headroom IS started;
//   * a unit already active is returned unchanged (its state is restored, never re-started);
//   * a fabric execution member is NEVER started here, even when the host is uncapped (fabric exclusion is
//     about what a CI converge may start, independent of the admitted count);
//   * an uncapped host (no thermal entry) starts every non-fabric desired unit.

import gunbc.plans.host_thermal_operating_point { thermal_activatable_units, ThermalAdmission, ThermalAdmitted, ThermalAdmissionRefused, ThermalActiveReading, ThermalActiveObserved, ThermalActiveUnobserved }
import product.host_identity { HostIdentity }
import extdeps.systemd { Active, Activating, Reloading, Deactivating, Failed, Inactive, SystemdUnitActiveState }
import gunbc.plans.host_thermal_operating_point { thermal_active_reading_from_units, ThermalUnitReading, ThermalUnitRead, ThermalUnitUnread }
import std.types { List, String, Bool, NonEmptyStr }
import std.algebra { string_contains }

data live_tree_disposition: std.live_tree.LiveTreeDisposition = std.live_tree.SubstrateInputsOnly

fn started(names: List<NonEmptyStr>, name: String) -> Bool {
  any(names, u => (u as String) == name)
}

fn units_of(a: ThermalAdmission) -> List<NonEmptyStr> {
  match a {
    ThermalAdmitted { units: us } => us
    ThermalAdmissionRefused { cause: _ } => []
  }
}

fn is_refused(a: ThermalAdmission) -> Bool {
  match a {
    ThermalAdmitted { units: _ } => false
    ThermalAdmissionRefused { cause: _ } => true
  }
}

fn ns(xs: List<String>) -> List<NonEmptyStr> {
  map(xs, x => x as NonEmptyStr)
}

// srv4: admitted concurrency 12. The 12 live runners are 01-05 and 08-14 (06/07 are masked fabric members,
// never active). Desired still names the full width through 14; 13 and 14 are the cooling-held slots.
data srv4_host: HostIdentity = "srv4" as HostIdentity
data srv4_active: List<String> = [
  "srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05",
  "srv4-08", "srv4-09", "srv4-10", "srv4-11", "srv4-12", "srv4-13", "srv4-14",
]
data srv4_desired: List<NonEmptyStr> = ns([
  "srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05",
  "srv4-06", "srv4-07", "srv4-08", "srv4-09", "srv4-10", "srv4-11", "srv4-12", "srv4-13", "srv4-14",
])
data srv4_fabric: List<NonEmptyStr> = ns(["srv4-06", "srv4-07"])

// A cooling-held slot is NOT started. All 12 admitted slots are already active, so the budget is 0 and
// nothing inactive may be brought up; the fabric members 06/07 (named in desired) must not appear either.
test fn w_srv4_over_count_held_not_started() -> Bool {
  let r = units_of(a: thermal_activatable_units(
    host: srv4_host, active: ThermalActiveObserved { names: srv4_active }, desired: srv4_desired, fabric: srv4_fabric))
  !started(r, "srv4-15") && !started(r, "srv4-16") && !started(r, "srv4-06") && !started(r, "srv4-07")
}

// The 12 already-active units are returned unchanged (a converge restores their state; it does not stop
// and re-start a running slot).
test fn w_srv4_admitted_active_returned() -> Bool {
  let r = units_of(a: thermal_activatable_units(
    host: srv4_host, active: ThermalActiveObserved { names: srv4_active }, desired: srv4_desired, fabric: srv4_fabric))
  started(r, "srv4-01") && started(r, "srv4-12") && started(r, "srv4-14")
    && length(r) == 12
}

// srv4 with headroom: only 10 of the 12 admitted slots are live. The two cooling slots 13/14 are now WITHIN
// the admitted count, so the gate must START them -- the same predicate, the count moving across the line.
data srv4_headroom_active: List<String> = [
  "srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05",
  "srv4-08", "srv4-09", "srv4-10", "srv4-11", "srv4-12",
]
test fn w_srv4_admitted_headroom_started() -> Bool {
  let r = units_of(a: thermal_activatable_units(
    host: srv4_host, active: ThermalActiveObserved { names: srv4_headroom_active }, desired: srv4_desired, fabric: srv4_fabric))
  started(r, "srv4-13") && started(r, "srv4-14") && !started(r, "srv4-06") && !started(r, "srv4-07")
}

// srv1: no thermal entry, so the host is uncapped. Even uncapped, a fabric execution member is never started
// by a CI converge -- fabric exclusion is independent of the admitted count.
data srv1_host: HostIdentity = "srv1" as HostIdentity
test fn w_uncapped_host_starts_all_nonfabric() -> Bool {
  let r = units_of(a: thermal_activatable_units(
    host: srv1_host, active: ThermalActiveObserved { names: [] }, desired: ns(["srv1-01", "srv1-02", "srv1-06"]), fabric: ns(["srv1-06"])))
  started(r, "srv1-01") && started(r, "srv1-02") && !started(r, "srv1-06")
}

// RED 1: a capped host whose live population was not read is REFUSED, not admitted from an assumed-empty set.
test fn w_capped_unobserved_population_refused() -> Bool {
  is_refused(a: thermal_activatable_units(
    host: srv4_host, active: ThermalActiveUnobserved { reason: "systemctl exit=255" }, desired: srv4_desired, fabric: srv4_fabric))
}

// An uncapped host needs no count, so an unread population does not refuse it.
test fn w_uncapped_unobserved_not_refused() -> Bool {
  let a = thermal_activatable_units(
    host: srv1_host, active: ThermalActiveUnobserved { reason: "x" }, desired: ns(["srv1-01", "srv1-02"]), fabric: [])
  !is_refused(a: a) && length(units_of(a: a)) == 2
}

// RED 3: 12 live runners, two of them (srv4-15, srv4-16) outside the desired list. They count against the
// budget, so nothing inactive may be started even though only 10 desired units are active.
data srv4_surplus_active: List<String> = [
  "srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05",
  "srv4-08", "srv4-09", "srv4-10", "srv4-11", "srv4-12", "srv4-15", "srv4-16",
]
test fn w_surplus_active_unit_counts_against_budget() -> Bool {
  let r = units_of(a: thermal_activatable_units(
    host: srv4_host, active: ThermalActiveObserved { names: srv4_surplus_active }, desired: srv4_desired, fabric: srv4_fabric))
  !started(r, "srv4-13") && !started(r, "srv4-14") && length(r) == 10
}

// Readings for srv4's 12 admitted slots: the first ten are Active, srv4-11 and srv4-12 take the given states.
fn reading(u: String, st: SystemdUnitActiveState) -> ThermalUnitReading {
  ThermalUnitRead { unit: u as NonEmptyStr, state: st }
}
fn ten_active() -> List<ThermalUnitReading> {
  map(["srv4-01", "srv4-02", "srv4-03", "srv4-04", "srv4-05", "srv4-08", "srv4-09", "srv4-10", "srv4-11", "srv4-12"], u => reading(u: u, st: Active))
}
fn admit_from(rs: List<ThermalUnitReading>) -> List<NonEmptyStr> {
  units_of(a: thermal_activatable_units(
    host: srv4_host, active: thermal_active_reading_from_units(units: rs, fabric: srv4_fabric), desired: srv4_desired, fabric: srv4_fabric))
}

// RED A (review 91956 finding 1): activating, reloading and deactivating runners are hot. Ten Active plus
// surplus srv4-15 Activating and srv4-16 Reloading is 12 live, so the inactive srv4-13/14 must NOT start; the
// bare "active" string match counted only ten and admitted both.
test fn w_activating_and_reloading_units_count_as_live() -> Bool {
  let r = admit_from(concat(ten_active(), [reading(u: "srv4-15", st: Activating), reading(u: "srv4-16", st: Reloading),
    reading(u: "srv4-13", st: Inactive), reading(u: "srv4-14", st: Inactive)]))
  !started(r, "srv4-13") && !started(r, "srv4-14") && length(r) == 10
}
test fn w_deactivating_unit_counts_as_live() -> Bool {
  let r = admit_from(concat(ten_active(), [reading(u: "srv4-15", st: Deactivating), reading(u: "srv4-16", st: Activating),
    reading(u: "srv4-13", st: Inactive)]))
  !started(r, "srv4-13")
}
// Positive control: one hot non-Active unit leaves headroom for exactly one more start.
test fn w_one_reloading_unit_leaves_one_headroom() -> Bool {
  let r = admit_from(concat(ten_active(), [reading(u: "srv4-15", st: Reloading), reading(u: "srv4-13", st: Inactive), reading(u: "srv4-14", st: Inactive)]))
  started(r, "srv4-13") && !started(r, "srv4-14") && length(r) == 11
}

// Failed is decided NOT live (no process runs; extdeps.systemd systemd_unit_active_state_is_stopped). It must
// consume headroom when re-activated, not pass free as "already active": with 11 live, only ONE of the two
// failed desired slots may start.
test fn w_failed_unit_is_not_live_and_consumes_headroom() -> Bool {
  let r = admit_from(concat(ten_active(), [reading(u: "srv4-13", st: Failed), reading(u: "srv4-14", st: Failed)]))
  // 10 live, headroom 2: both failed slots start, and each consumed budget (result = 10 live + 2 started).
  length(r) == 12 && started(r, "srv4-13") && started(r, "srv4-14")
}
test fn w_failed_unit_does_not_pass_free_past_the_cap() -> Bool {
  // 12 live (ten Active + two more Active surplus srv4-15/16 outside desired) and srv4-13 Failed: headroom 0,
  // so the failed slot must NOT start. Counting Failed as live would have returned it as already-active.
  let rs = concat(ten_active(), [reading(u: "srv4-15", st: Active), reading(u: "srv4-16", st: Active), reading(u: "srv4-13", st: Failed)])
  let r = admit_from(rs)
  !started(r, "srv4-13")
}

// RED B (finding 2): a unit inside an observed population whose ActiveState was not read refuses admission;
// it is never counted as stopped. A fabric member's unread state is irrelevant (it is never counted).
test fn w_unread_unit_refuses_admission() -> Bool {
  let rs = concat(ten_active(), [ThermalUnitUnread { unit: "srv4-13" as NonEmptyStr }])
  is_refused(a: thermal_activatable_units(
    host: srv4_host, active: thermal_active_reading_from_units(units: rs, fabric: srv4_fabric), desired: srv4_desired, fabric: srv4_fabric))
}
test fn w_unread_fabric_member_does_not_refuse() -> Bool {
  let rs = concat(ten_active(), [ThermalUnitUnread { unit: "srv4-06" as NonEmptyStr }])
  !is_refused(a: thermal_activatable_units(
    host: srv4_host, active: thermal_active_reading_from_units(units: rs, fabric: srv4_fabric), desired: srv4_desired, fabric: srv4_fabric))
}
test fn w_unread_reason_names_the_unit() -> Bool {
  match thermal_active_reading_from_units(units: [ThermalUnitUnread { unit: "srv4-13" as NonEmptyStr }], fabric: []) {
    ThermalActiveUnobserved { reason: r } => string_contains(s: r, pattern: "srv4-13")
    ThermalActiveObserved { names: _ } => false
  }
}
