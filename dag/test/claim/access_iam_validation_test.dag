module test.claim.access_iam_validation


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn decision_is_permit(d: AccessDecision) -> Bool {
  match d { Permit => true  Deny { refusal: _ } => false }
}

fn decision_is_deny(d: AccessDecision) -> Bool {
  match d { Deny { refusal: _ } => true  Permit => false }
}

type IamRequestContext {}
type IamRequestEvidence {}

type IamPrincipal {
  arn: NonEmptyStr
  source_locality: NetworkLocality
  mfa_present: Bool
}

type S3Action {
  operation: NonEmptyStr
  prefix: NonEmptyStr
}

fn locality_is_internal(l: NetworkLocality) -> Bool {
  match l {
    Internet => false
    Loopback => true
    Lan => true
    WslNat => true
    WslBridged => true
    DockerBridge => true
    TailscaleOverlay => true
  }
}

fn iam_decide(request: AccessRequest<IamPrincipal, S3Action, NonEmptyStr, IamRequestContext, IamRequestEvidence>) -> AccessDecision {
  if locality_is_internal(l: request.subject.source_locality)
     && request.action.prefix == "reports/"
     && request.subject.mfa_present {
    Permit
  } else {
    access_policy_refusal(profile: "iam", subject: request.subject.arn, action: request.action.operation, object: request.object, reason: "IAM condition not satisfied")
  }
}

data iam_access_policy: AccessPolicy<IamPrincipal, S3Action, NonEmptyStr, IamRequestContext, IamRequestEvidence> = {
  decide: iam_decide
}

test fn iam_internal_prefix_mfa_permits() -> Bool {
  decision_is_permit(d: iam_decide(request: {
    subject: { arn: "arn:aws:iam::1:user/alice", source_locality: Lan, mfa_present: true },
    action: { operation: "s3:extdeps.object_storage.GetObject", prefix: "reports/" }, object: "arn:aws:s3:::bucket/reports/q3.csv",
    context: AccessContext { value: IamRequestContext {} }, evidence: AccessEvidence { value: IamRequestEvidence {} }
  }))
}

test fn iam_external_source_denies() -> Bool {
  decision_is_deny(d: iam_decide(request: {
    subject: { arn: "arn:aws:iam::1:user/alice", source_locality: Internet, mfa_present: true },
    action: { operation: "s3:extdeps.object_storage.GetObject", prefix: "reports/" }, object: "arn:aws:s3:::bucket/reports/q3.csv",
    context: AccessContext { value: IamRequestContext {} }, evidence: AccessEvidence { value: IamRequestEvidence {} }
  }))
}

test fn iam_wrong_prefix_denies() -> Bool {
  decision_is_deny(d: iam_decide(request: {
    subject: { arn: "arn:aws:iam::1:user/alice", source_locality: Lan, mfa_present: true },
    action: { operation: "s3:extdeps.object_storage.GetObject", prefix: "secrets/" }, object: "arn:aws:s3:::bucket/secrets/key.pem",
    context: AccessContext { value: IamRequestContext {} }, evidence: AccessEvidence { value: IamRequestEvidence {} }
  }))
}

test fn iam_no_mfa_denies() -> Bool {
  decision_is_deny(d: iam_decide(request: {
    subject: { arn: "arn:aws:iam::1:user/alice", source_locality: Lan, mfa_present: false },
    action: { operation: "s3:extdeps.object_storage.GetObject", prefix: "reports/" }, object: "arn:aws:s3:::bucket/reports/q3.csv",
    context: AccessContext { value: IamRequestContext {} }, evidence: AccessEvidence { value: IamRequestEvidence {} }
  }))
}
