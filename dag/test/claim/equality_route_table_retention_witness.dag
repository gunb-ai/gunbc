module test.claim.equality_route_table_retention_witness

import extdeps.filesystem.filesystem_io
import std.algebra { Cons, Empty, FreeSemigroup, fold_list, length, list_map, string_concat_join, string_contains, zip_map }
import std.coercion { unicode_scalar_fold, unicode_scalar_unfold }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.types { Bool, Char, Int, List, String }
import v2.std.text { string_split }
import gunbc.equality_route_table_retention { equality_route_table_retention }

// EXECUTES gunbc.equality_route_table_retention, the typed carrier for the derived-equality routing table's
// seed retention. That row states where the table lives, what its rows route, and what must hold while it
// stays in the seed. This claim reads the two files the row NAMES against the row and goes red when the row
// stops describing them, or when a second copy of the table reappears.
//
// The row is the authority: the claim holds no copy of the file names, carrier names, function names or
// trigger text it checks, so a drifted row fails here rather than being quietly agreed with by a private
// duplicate of itself. DESIGN section 3: "Minimization holds only if each fact lives in exactly one place."
// Section 3c: a declaration is judged by its consumer, and the consumer of that row is this claim.
// Section 7: a retention is "a declared row with reason and migration trigger, never a silent escape hatch"
// -- so reason and trigger are asserted non-blank, not merely present.

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data newline_char: Char = 10

// The same intrinsic the other source-reading witnesses use. An unreadable file yields empty text, which
// fails the positive checks below rather than passing them.
fn read_or_empty(path: String) -> String {
  filesystem_read(path: path).content
}

fn table_text() -> String {
  read_or_empty(path: equality_route_table_retention.table_file)
}

fn copy_text() -> String {
  read_or_empty(path: equality_route_table_retention.forbidden_copy_file)
}

// One crossing, as the kernel wants it: the file unfolds to scalars, splits on the newline scalar, and each
// line folds back to the kernel text the checks below are keyed in.
fn text_lines(text: String) -> List<String> {
  list_map(
    xs: string_split(
      source: unicode_scalar_unfold(s: text),
      delimiter: FreeSemigroup { head: newline_char, tail: Empty }
    ),
    f: fn(line) { unicode_scalar_fold(xs: line) }
  )
}

// How many LINES contain `needle`. The seed writes the table one row per line, so this counts rows rather
// than mentions: a second table inside the same file is caught here instead of excused by a substring hit.
fn lines_containing(text: String, needle: String) -> Int {
  fold_list(
    xs: text_lines(text: text),
    empty: 0,
    cons: fn(n, line) { if string_contains(s: line, pattern: needle) { n + 1 } else { n } }
  )
}

fn all_true(flags: List<Bool>) -> Bool {
  fold_list(xs: flags, empty: true, cons: fn(so_far, flag) { so_far && flag })
}

fn count_true(flags: List<Bool>) -> Int {
  fold_list(xs: flags, empty: 0, cons: fn(n, flag) { if flag { n + 1 } else { n } })
}

fn quoted(value: String) -> String {
  string_concat_join(fields: ["\"", value, "\""], separator: "")
}

// The table is present, exactly once, in the file the row names. Absent (renamed, moved) and duplicated both
// refuse: the row and the tree have to say the same thing, in the same place.
test fn the_table_lives_where_the_row_says_exactly_once() -> Bool {
  lines_containing(text: table_text(), needle: equality_route_table_retention.table_declaration) == 1
}

// Every consumer the row claims is a real declaration in that same file. A fold that stopped reading the
// table would leave it dangling, which section 3c forbids without a declared frontier.
test fn every_named_consumer_is_in_the_table_file() -> Bool {
  let text = table_text()
  all_true(
    flags: list_map(
      xs: equality_route_table_retention.reader_folds,
      f: fn(fold_name) { string_contains(s: text, pattern: fold_name) }
    )
  )
}

// The table has exactly as many rows as the row lists carriers.
test fn the_table_has_exactly_the_rows_the_row_lists() -> Bool {
  let row = equality_route_table_retention
  lines_containing(text: table_text(), needle: row.row_marker) == length(xs: row.routed_carrier_names)
}

// Each carrier sits on the SAME line as the function the row routes it by. The lists are paired by position
// with zip_map, so a carrier cannot borrow another carrier's function: reordering one list without the
// other puts a function on a line it does not belong to.
test fn each_carrier_shares_its_line_with_the_function_the_row_routes_it_by() -> Bool {
  let row = equality_route_table_retention
  let text = table_text()
  let pairs = zip_map(
    a: row.routed_carrier_names,
    b: row.routing_functions,
    f: fn(carrier, route_function) {
      if string_contains(s: carrier_line(text: text, carrier: carrier), pattern: route_function) {
        true
      } else {
        false
      }
    }
  )
  all_true(flags: pairs)
}

// The seed line that declares `carrier`, found by the field that names it. Returned so a caller can assert
// what ELSE sits on that same line, which is what makes carrier and function one fact rather than two.
fn carrier_line(text: String, carrier: String) -> String {
  fold_list(
    xs: text_lines(text: text),
    empty: "",
    cons: fn(found, line) {
      if found != "" {
        found
      } else if string_contains(s: line, pattern: equality_route_table_retention.row_marker)
        && string_contains(s: line, pattern: quoted(value: carrier)) {
        line
      } else {
        found
      }
    }
  )
}

// Root standing is carried per carrier, and the seed agrees: the number of rows admitted at the operand root
// and the number refused are both read off the same lines the rows occupy. A retention row that dropped the
// standing, or flipped one, is caught by the count that no longer matches.
test fn the_table_root_admission_matches_the_row() -> Bool {
  let row = equality_route_table_retention
  let text = table_text()
  let admitted_lines = lines_containing(text: text, needle: "admitted_at_root: true")
  let refused_lines = lines_containing(text: text, needle: "admitted_at_root: false")
  admitted_lines == count_true(flags: row.routing_admitted_at_root)
    && refused_lines == length(xs: row.routing_admitted_at_root) - count_true(flags: row.routing_admitted_at_root)
    && every_admitted_carrier_is_named_in_the_row()
}

// A row admitted at the root must be one of the carriers the row lists, and every routed function name must
// appear in the seed at all -- so the row cannot route a carrier the seed does not route, or invent a
// function name the seed never mentions.
fn every_admitted_carrier_is_named_in_the_row() -> Bool {
  let row = equality_route_table_retention
  let text = table_text()
  all_true(
    flags: list_map(
      xs: row.routing_functions,
      f: fn(route_function) { string_contains(s: text, pattern: route_function) }
    )
  )
    && all_true(
      flags: list_map(
        xs: row.routed_carrier_names,
        f: fn(carrier) { string_contains(s: text, pattern: quoted(value: carrier)) }
      )
    )
    && all_true(
      flags: list_map(
        xs: row.routed_carrier_files,
        f: fn(decl_file) { string_contains(s: text, pattern: decl_file) }
      )
    )
}

// No second copy. Until the move the table has ONE home, so the file a copy would land in carries no table
// declaration of its own. This is what answers the drift the earlier reviews raised: the claim does not
// compare two tables, it refuses the existence of a second one.
test fn no_second_copy_of_the_table_exists() -> Bool {
  let row = equality_route_table_retention
  !string_contains(s: copy_text(), pattern: row.forbidden_copy_declaration)
}

// The seed comment still commits to ONE move rather than two copies: it names the row's destination, keeps
// the one-change promise, and names the rung drop that gates the move.
test fn the_seed_still_declares_one_move_not_two() -> Bool {
  let row = equality_route_table_retention
  let text = table_text()
  string_contains(s: text, pattern: row.migration_destination)
    && string_contains(s: text, pattern: row.one_change_promise)
    && string_contains(s: text, pattern: row.blocker_rung_drop)
}

// The row carries its own reason, trigger and blocker (section 7). Asserted non-blank rather than read for
// its value: an empty string is the silent escape hatch that section forbids.
test fn the_row_states_its_reason_trigger_and_blocker() -> Bool {
  let row = equality_route_table_retention
  length(xs: row.reason) > 0
    && length(xs: row.migration_trigger) > 0
    && length(xs: row.blocker_rung_drop) > 0
    && length(xs: row.one_change_promise) > 0
    && length(xs: row.migration_destination) > 0
    && length(xs: row.reader_folds) > 0
}
