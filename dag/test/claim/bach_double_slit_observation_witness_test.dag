module test.claim.bach_double_slit_observation_witness_test

import std.types { Bool, List }
import gunbc.bach_double_slit_observation {
  BachBuildupProgressionRow,
  BachCitedDoubleSlitApparatus,
  BachNonCitedApparatus,
  bach_cited_buildup_row_from_extdeps,
  bach_distribution_observations_complete,
  bach_buildup_fold_derives_ensemble_interference,
  bach_buildup_progression_rejects_clearly_visible_at_low_count,
  bach_buildup_progression_rejects_not_yet_at_max_count,
  bach_buildup_progression_rejects_foreign_apparatus,
  bach_buildup_progression_rejects_reversed_order,
  bach_ensemble_interference_rejects_missing_both_open,
}
import extdeps.physics.bach_et_al_2013_double_slit {
  bach_et_al_2013_double_slit,
  bach_buildup_2_electrons,
  bach_buildup_7_electrons,
  bach_buildup_209_electrons,
  bach_buildup_1004_electrons,
  bach_buildup_6235_electrons,
  PatternClearlyVisible,
  PatternNotYetDiscernible,
  SlitOneSingleSlitDiffractionObserved,
  SlitTwoSingleSlitDiffractionObserved,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_bach_categorical_distribution_observations_complete() -> Bool {
  bach_distribution_observations_complete()
}

test fn w_bach_buildup_fold_derives_ensemble_interference() -> Bool {
  bach_buildup_fold_derives_ensemble_interference()
}

test fn w_bach_buildup_rejects_clearly_visible_at_seven_electrons() -> Bool {
  let bad_row = BachBuildupProgressionRow {
    apparatus: BachCitedDoubleSlitApparatus { subject: bach_et_al_2013_double_slit },
    detected_electrons: 7,
    pattern_status: PatternClearlyVisible,
  }
  let rows = [
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_2_electrons),
    bad_row,
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_209_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_1004_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_6235_electrons),
  ]
  bach_buildup_progression_rejects_clearly_visible_at_low_count(rows: rows)
}

test fn w_bach_buildup_rejects_not_yet_at_max_count() -> Bool {
  let bad_max = BachBuildupProgressionRow {
    apparatus: BachCitedDoubleSlitApparatus { subject: bach_et_al_2013_double_slit },
    detected_electrons: 6235,
    pattern_status: PatternNotYetDiscernible,
  }
  let rows = [
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_2_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_7_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_209_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_1004_electrons),
    bad_max,
  ]
  bach_buildup_progression_rejects_not_yet_at_max_count(rows: rows)
}

test fn w_bach_buildup_rejects_reversed_electron_order() -> Bool {
  let rows = [
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_6235_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_1004_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_209_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_7_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_2_electrons),
  ]
  bach_buildup_progression_rejects_reversed_order(rows: rows)
}

test fn w_bach_buildup_rejects_foreign_apparatus() -> Bool {
  let foreign_row = BachBuildupProgressionRow {
    apparatus: BachNonCitedApparatus {},
    detected_electrons: 1004,
    pattern_status: PatternClearlyVisible,
  }
  let rows = [
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_2_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_7_electrons),
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_209_electrons),
    foreign_row,
    bach_cited_buildup_row_from_extdeps(row: bach_buildup_6235_electrons),
  ]
  bach_buildup_progression_rejects_foreign_apparatus(rows: rows)
}

test fn w_bach_ensemble_rejects_missing_both_open_diffraction_observation() -> Bool {
  let without_both_open = [
    SlitOneSingleSlitDiffractionObserved,
    SlitTwoSingleSlitDiffractionObserved,
  ]
  bach_ensemble_interference_rejects_missing_both_open(observations: without_both_open)
}
