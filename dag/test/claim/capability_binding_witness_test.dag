module test.claim.capability_binding_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { String, Bool, Int, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalSubjectRef }
import gunbc.host_realization {
  ApplicationContainerKind, BrowserDocument, NativeDesktopProcess, NativeMobileProcess,
  EmbeddedWebView, CompanionDevice, container_kind_key, container_owns_its_process_lifetime,
  RendererKind, DomCssRenderer, WebGpuRenderer, NativeWidgetRenderer, GameEngineRenderer,
  renderer_kind_key,
  ResolvedRef, RefResolved, RefReducedByPolicy, RefNotProbed, RefUnpublishedByPlatform,
  ref_is_resolved, resolved_ref_key,
  HostRealization, host_identity_is_exact,
}
import gunbc.capability_binding {
  ImpulseDirection, ImpulseUp, ImpulseDown, ImpulseDirectionUnresolved, impulse_direction_key,
  PhysicalImpulse,
  GravityHandling, GravityIncluded, GravityExcluded, GravityHandlingUnspecified,
  PhysicalImpulseRequirement, bob_impulse_requirement,
  CapabilityBinding,
  BindingStreamState, InterfaceUnavailable, PolicyRefused, PermissionRefused,
  HardwareUnavailable, BackendConnectionRefused, ActivatedNoSamples, HollowSamplesObserved,
  SamplesObserved, TapDiscriminatorQualified, TapDiscriminatorRejected, BindingStreamUnobserved,
  binding_stream_key,
  CapabilityBindingObservation,
  TargetCapabilityVerdict, CapabilitySupported, CapabilityDegraded, CapabilityUnavailable,
  CapabilityUnobserved, capability_verdict_key, derive_capability_verdict,
  stream_meets_requirement, synthetic_alternative_label, any_capability_supported,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data capability_binding_witness_note: String = "The four-layer separation and the derived per-capability verdict, each law beside the control that reds it. The claims here are mostly about what the model REFUSES to say: that an operating system supports something, that a readable sensor is a fit one, that a degradation needs no alternative, and that a synthetic source may stand in for hardware without saying so."

fn a_host(container: ApplicationContainerKind, renderer: RendererKind) -> HostRealization {
  HostRealization {
    platform: ExternalSubjectRef {
      declaration: DeclarationRef {
        module_path: "extdeps.os.macos",
        decl_name: "macos",
        field: WholeDeclaration
      }
    },
    platform_revision: RefReducedByPolicy { reported: "Mac OS X 10_15_7" },
    device_identity: RefNotProbed,
    container_kind: container,
    container: DeclarationRef {
      module_path: "extdeps.browser.chromium",
      decl_name: "chromium",
      field: WholeDeclaration
    },
    container_build: RefReducedByPolicy { reported: "150.0.0.0" },
    renderer: renderer,
  }
}

data orthogonality_note: String = "The load-bearing structural claim: container and renderer are independent axes, so every pairing is constructible and none of them is a variant of 'website'. A native desktop process rendering DOM is the first native architecture worth building; a browser document rendering a WebGPU scene is a realization of the same projection. If these two axes were ever fused into one enumeration, both of those would become unspellable and the product would have silently become a website."

fn witness_container_and_renderer_are_independent_axes() -> Bool {
  let native_dom = a_host(container: NativeDesktopProcess, renderer: DomCssRenderer)
  let browser_gpu = a_host(container: BrowserDocument, renderer: WebGpuRenderer)
  let mobile_native = a_host(container: NativeMobileProcess, renderer: NativeWidgetRenderer)
  container_kind_key(c: native_dom.container_kind) == "native-desktop-process"
    && renderer_kind_key(r: native_dom.renderer) == "dom-css"
    && container_kind_key(c: browser_gpu.container_kind) == "browser-document"
    && renderer_kind_key(r: browser_gpu.renderer) == "webgpu"
    && container_kind_key(c: mobile_native.container_kind) == "native-mobile-process"
    && renderer_kind_key(r: mobile_native.renderer) == "native-widget"
}

fn witness_only_a_native_container_owns_its_process_lifetime() -> Bool {
  !container_owns_its_process_lifetime(c: BrowserDocument)
    && !container_owns_its_process_lifetime(c: EmbeddedWebView)
    && container_owns_its_process_lifetime(c: NativeDesktopProcess)
    && container_owns_its_process_lifetime(c: NativeMobileProcess)
    && container_owns_its_process_lifetime(c: CompanionDevice)
}

data unresolved_identity_note: String = "Three named reasons an identity goes unresolved, kept apart because their remedies differ: a frozen User-Agent literal is fixed by reading UA Client Hints, an unprobed identity is fixed by probing, and an identity the platform does not publish is fixed by neither. A single absent value would have made all three the same non-answer."

fn witness_unresolved_identity_keeps_its_cause() -> Bool {
  ref_is_resolved(r: RefResolved {
      declaration: DeclarationRef { module_path: "extdeps.os.macos", decl_name: "macos", field: WholeDeclaration }
    })
    && !ref_is_resolved(r: RefReducedByPolicy { reported: "Mac OS X 10_15_7" })
    && !ref_is_resolved(r: RefNotProbed)
    && !ref_is_resolved(r: RefUnpublishedByPlatform)
    && resolved_ref_key(r: RefReducedByPolicy { reported: "x" }) != resolved_ref_key(r: RefNotProbed)
    && resolved_ref_key(r: RefNotProbed) != resolved_ref_key(r: RefUnpublishedByPlatform)
    && !host_identity_is_exact(h: a_host(container: BrowserDocument, renderer: DomCssRenderer))
}

fn an_observation(s: BindingStreamState) -> CapabilityBindingObservation {
  CapabilityBindingObservation {
    binding: CapabilityBinding {
      host: a_host(container: BrowserDocument, renderer: DomCssRenderer),
      requirement: DeclarationRef {
        module_path: "gunbc.capability_binding",
        decl_name: "bob_impulse_requirement",
        field: WholeDeclaration
      },
      provider: DeclarationRef {
        module_path: "extdeps.w3c.device_orientation_and_motion",
        decl_name: "devicemotion_event_type",
        field: WholeDeclaration
      },
    },
    stream: s,
    observation_window_ms: 4000,
  }
}

fn verdict_of(s: BindingStreamState) -> String {
  capability_verdict_key(v: derive_capability_verdict(o: an_observation(s: s)))
}

data readability_is_not_fitness_note: String = "THE CENTRAL CLAIM OF THIS FILE. A stream delivering forty clean samples at sixty hertz with a healthy peak is a working sensor and is NOT a supported capability: nothing in it separated a deliberate knock from ordinary desk noise. Only a qualified discriminator supports. Everything between silence and qualification degrades, which is the honest middle a Boolean support table cannot express."

fn witness_only_a_qualified_tap_reaches_supported() -> Bool {
  verdict_of(s: TapDiscriminatorQualified { peak_magnitude_milli: 3100, detection_latency_ms: 40 }) == "supported"
    && verdict_of(s: SamplesObserved { count: 240, frequency_hz: 60, noise_floor_milli: 40, peak_magnitude_milli: 2600 }) == "degraded"
    && verdict_of(s: TapDiscriminatorRejected { reason: "cannot separate a knock from typing" }) == "degraded"
    && verdict_of(s: HollowSamplesObserved { count: 12, window_ms: 4000 }) == "degraded"
    && verdict_of(s: ActivatedNoSamples { window_ms: 4000 }) == "degraded"
}

fn witness_every_obstacle_reaches_unavailable_with_its_own_cause() -> Bool {
  verdict_of(s: InterfaceUnavailable) == "unavailable"
    && verdict_of(s: PolicyRefused) == "unavailable"
    && verdict_of(s: PermissionRefused) == "unavailable"
    && verdict_of(s: HardwareUnavailable) == "unavailable"
    && verdict_of(s: BackendConnectionRefused { error_name: "NotReadableError" }) == "unavailable"
    && match derive_capability_verdict(o: an_observation(s: BackendConnectionRefused { error_name: "NotReadableError" })) {
         CapabilityUnavailable { cause } => cause == "NotReadableError"
         CapabilitySupported { qualified_peak_milli } => false
         CapabilityDegraded { missing, explicit_alternative } => false
         CapabilityUnobserved => false
       }
}

fn witness_red_an_unexercised_binding_is_not_a_failure() -> Bool {
  verdict_of(s: BindingStreamUnobserved) == "unobserved"
    && verdict_of(s: BindingStreamUnobserved) != verdict_of(s: HardwareUnavailable)
    && verdict_of(s: BindingStreamUnobserved) != verdict_of(s: ActivatedNoSamples { window_ms: 4000 })
}

data explicit_alternative_note: String = "Every degradation names what is offered instead, and the alternative names ITSELF as synthetic. A degradation with an unnamed alternative is a failure with better manners, and a synthetic impulse presented without that label is the fabricated-plausible-output failure applied to hardware."

fn degraded_alternative_of(s: BindingStreamState) -> String {
  match derive_capability_verdict(o: an_observation(s: s)) {
    CapabilityDegraded { missing, explicit_alternative } => explicit_alternative
    CapabilitySupported { qualified_peak_milli } => ""
    CapabilityUnavailable { cause } => ""
    CapabilityUnobserved => ""
  }
}

fn witness_every_degradation_names_an_explicit_synthetic_alternative() -> Bool {
  degraded_alternative_of(s: SamplesObserved { count: 240, frequency_hz: 60, noise_floor_milli: 40, peak_magnitude_milli: 2600 }) == synthetic_alternative_label
    && degraded_alternative_of(s: HollowSamplesObserved { count: 12, window_ms: 4000 }) == synthetic_alternative_label
    && degraded_alternative_of(s: ActivatedNoSamples { window_ms: 4000 }) == synthetic_alternative_label
    && degraded_alternative_of(s: TapDiscriminatorRejected { reason: "typing" }) == synthetic_alternative_label
    && string_contains(s: synthetic_alternative_label, pattern: "not a hardware reading")
}

data requirement_is_a_contract_note: String = "Fitness is measured against the requirement's declared numbers, and BOTH conditions bind. A knock that clears the magnitude but arrives too late has not qualified, because a response that lands after the causal window reads as an animation rather than as a consequence. A prompt knock too weak to clear the floor has not qualified either, because it cannot be told from typing."

fn witness_a_tap_qualifies_only_on_magnitude_and_latency_together() -> Bool {
  stream_meets_requirement(
      s: TapDiscriminatorQualified { peak_magnitude_milli: 3100, detection_latency_ms: 40 },
      r: bob_impulse_requirement)
    && !stream_meets_requirement(
      s: TapDiscriminatorQualified { peak_magnitude_milli: 1900, detection_latency_ms: 40 },
      r: bob_impulse_requirement)
    && !stream_meets_requirement(
      s: TapDiscriminatorQualified { peak_magnitude_milli: 3100, detection_latency_ms: 400 },
      r: bob_impulse_requirement)
    && !stream_meets_requirement(
      s: SamplesObserved { count: 240, frequency_hz: 60, noise_floor_milli: 40, peak_magnitude_milli: 9000 },
      r: bob_impulse_requirement)
}

fn witness_the_bob_requirement_is_denominated() -> Bool {
  bob_impulse_requirement.axis_count == 3
    && bob_impulse_requirement.minimum_sample_rate_hz == 50
    && bob_impulse_requirement.maximum_detection_latency_ms == 120
    && bob_impulse_requirement.minimum_discriminating_magnitude_milli_m_per_s2 == 2000
}

data one_host_many_verdicts_note: String = "The claim that support is not an operating-system Boolean, made as a construction rather than as prose: ONE host, two providers, two different verdicts. A row saying 'macOS supported' could not have expressed this, and a row saying 'macOS unsupported' would have been equally wrong."

fn witness_one_host_carries_different_verdicts_per_binding() -> Bool {
  let rows = [
    an_observation(s: TapDiscriminatorQualified { peak_magnitude_milli: 3100, detection_latency_ms: 40 }),
    an_observation(s: InterfaceUnavailable),
    an_observation(s: BindingStreamUnobserved),
  ]
  any_capability_supported(rows: rows)
    && !any_capability_supported(rows: [an_observation(s: InterfaceUnavailable)])
    && !any_capability_supported(rows: [an_observation(s: SamplesObserved { count: 9, frequency_hz: 60, noise_floor_milli: 10, peak_magnitude_milli: 5000 })])
}

fn witness_an_impulse_names_the_binding_that_produced_it() -> Bool {
  let synthetic = PhysicalImpulse {
    source_binding: DeclarationRef {
      module_path: "gunbc.capability_binding",
      decl_name: "synthetic_alternative_label",
      field: WholeDeclaration
    },
    magnitude_milli_m_per_s2: 2600,
    direction: ImpulseDown,
    observed_at_ms: 1200,
  }
  synthetic.magnitude_milli_m_per_s2 == 2600
    && impulse_direction_key(d: synthetic.direction) == "down"
    && impulse_direction_key(d: ImpulseDirectionUnresolved) == "direction-unresolved"
    && synthetic.source_binding.decl_name == "synthetic_alternative_label"
}

test fn capability_binding_keystone_holds() -> Bool {
  witness_container_and_renderer_are_independent_axes()
    && witness_only_a_native_container_owns_its_process_lifetime()
    && witness_unresolved_identity_keeps_its_cause()
    && witness_only_a_qualified_tap_reaches_supported()
    && witness_every_obstacle_reaches_unavailable_with_its_own_cause()
    && witness_red_an_unexercised_binding_is_not_a_failure()
    && witness_every_degradation_names_an_explicit_synthetic_alternative()
    && witness_a_tap_qualifies_only_on_magnitude_and_latency_together()
    && witness_the_bob_requirement_is_denominated()
    && witness_one_host_carries_different_verdicts_per_binding()
    && witness_an_impulse_names_the_binding_that_produced_it()
}
