module test.claim.data_class_refusal_probe_witness_test

import std.types { String, Bool, Int, List }
import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE REDS, ENROLLED. Each probe under dag/test/probe/ is a whole module that MUST NOT RESOLVE,
// written as the single most tempting construction of one mishandling of classified data
// (product.data_class). This witness is what makes them evidence rather than decoration (DESIGN
// 4b: the RED must be authorable, and then it must be executed): it reads each probe's source off
// the tree, hands it to the compiler through compile_dag_diagnostic_census -- the same fixture
// harness the guarantee probe corpus uses for every sealed-record red -- and requires the census
// to carry a BLOCKING row of exactly the class the probe names. A probe that refuses for another
// reason is measuring another wall, so the class is asserted, not merely a nonzero exit.
//
// dag/test/probe/ is under the "/test/" whole-tree strict-resolve exclusion
// (gunbc.ci_layer_roots whole_tree_strict_resolve_exclusion_substrings), so the floor's own
// resolve never sees these modules as members of the accepted corpus; they reach the compiler
// only through this witness, which is the boundary DESIGN 4b names for a compiler's regression
// probes.
//
// THE FIFTH PROBE IS AN EXPECTING-RED HOLE, NOT A RED. personal_identity_to_log_channel_probe
// compiles today on the interpretation path (marker identity is not judged at generic argument
// positions -- gunbc.recurring_failure_mode direct_generic_application_admits_a_distinct_phantom_argument),
// and its runtime refusal is established by test.claim.fabric.data_class_admission_witness. This
// witness asserts the census carries NO blocking row for it, so the day the checker's wall lands
// the assertion goes red and the row is rewritten to expect the refusal -- the probe becomes the
// permanent regression control, exactly as the guarantee probe corpus handles
// ExpectSilentAcceptanceHole rows.

data probe_dir: String = "dag/test/probe/"

fn probe_source(name: String) -> String {
  filesystem_read(path: probe_dir + name + ".dag").content
}

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn blocking_count_for_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_total(c: CompileDiagnosticCensus) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_count_for_subject(c: CompileDiagnosticCensus, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows |> filter(r => r.subject_name == subject && r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn census_ran(c: CompileDiagnosticCensus) -> Bool {
  match c {
    CensusNotRunnable { cause: _ } => false
    CensusObserved { rows: _ } => true
  }
}

// THE CENSUS IS THE WHOLE COMPILE'S, IMPORTED CLOSURE INCLUDED (gunbc.compile_diagnostic_census
// carrier note), so no assertion here reads a total: every count is scoped to the class and the
// subject the probe names, and a hole is asserted as zero blocking rows AT THE PROBED ARGUMENT
// rather than zero rows anywhere.

// A source that names nothing wrong is the control that the harness itself is live: the census
// runs and carries zero blocking rows, so a zero elsewhere is an observation and not a harness
// that could not run.
data harness_control_source: String = "module probe_data_class_harness_control\nimport product.data_class { public_fabric_map }\nfn rows() -> Int { count(public_fabric_map().rows) }\n"

test fn the_harness_runs_and_a_clean_source_is_clean() -> Bool {
  blocking_total(c: census_of(source: harness_control_source)) == 0
}

// The missing-field refusal is reported under InternalError with the field and the type in its
// subject; that class is what the checker emits for a projection off a type that has no such
// field, so it is the class asserted, not a nicer-sounding one.
test fn a_bare_string_cannot_be_walked_out_of_the_boundary_and_a_value_cannot_be_self_classified() -> Bool {
  let c = census_of(source: probe_source(name: "bare_string_from_boundary_probe"))
  blocking_count_for_class_and_subject(c: c, wanted: "InternalError", subject: "no field 'email' on type 'Classified'") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "Classified") >= 1
}

// EXPECTING-RED HOLE. The probe hands the write a FilePath -- the type every caller actually
// holds -- and the interpretation path admits it SILENTLY at the declared permit position: a
// where-refined alias value is exempt from declared-type inhabitance there, while the same call
// with a bare String literal refuses (gunbc.recurring_failure_mode
// refined_alias_argument_exempt_from_declared_type_inhabitance, filed with this change). Both
// halves are enrolled: the literal form is the refusing control that shows the wall is reachable
// one term away, and the zero at the FilePath form is the tripwire that flips when the exemption
// closes.
data durable_write_literal_control_source: String = "module probe_durable_write_literal\nimport std.types { NonEmptyStr }\nimport std.resources { Network }\nimport gunbc.auth.access_token_source { AccessTokenSource }\nimport gunbc.fabric_m0_origin_commit { OriginObjectWrite, commit_object_to_origin }\nfn write_the_literal(token_source: AccessTokenSource) -> OriginObjectWrite uses net: Network {\n  commit_object_to_origin(permit: \"dag/test/fixture/fabric_m0_origin_readback/other_object.txt\", key: \"probe/never\" as NonEmptyStr, token_source: token_source)\n}\n"

test fn the_durable_write_refuses_a_bare_string_literal_where_the_permit_is_declared() -> Bool {
  blocking_count_for_class_and_subject(c: census_of(source: durable_write_literal_control_source), wanted: "DeclaredTypeNotInhabited", subject: "direct call argument for parameter 'permit'") >= 1
}

test fn the_durable_write_still_admits_a_file_path_where_the_permit_is_declared() -> Bool {
  let c = census_of(source: probe_source(name: "durable_write_takes_the_value_probe"))
  census_ran(c: c) && blocking_count_for_subject(c: c, subject: "direct call argument for parameter 'permit'") == 0
}

test fn a_permit_cannot_be_authored_outside_the_fold() -> Bool {
  let c = census_of(source: probe_source(name: "data_effect_permit_forged_probe"))
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "DataEffectPermit") >= 1
    && blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "Sink") >= 1
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") >= 1
}

test fn an_unwrap_helper_cannot_be_written_outside_the_module() -> Bool {
  blocking_count_for_class_and_subject(c: census_of(source: probe_source(name: "classified_unwrap_helper_probe")), wanted: "SoleConstructorViolation", subject: "DataRevealKey") >= 1
}

// THE SELF-AUTHORED MAP (review 65282). The literal refuses on the sealed record; the mint call
// and the fixture-builder call refuse on their admit_callers lists -- two ConstructorCall
// refusals, one per unadmitted call.
test fn a_policy_map_cannot_be_authored_or_minted_outside_its_authorities() -> Bool {
  let c = census_of(source: probe_source(name: "self_authored_map_probe"))
  blocking_count_for_class_and_subject(c: c, wanted: "SoleConstructorViolation", subject: "DataHandlingMap") >= 1
    && blocking_count_for_class(c: c, wanted: "ConstructorCallAdmissionRefused") >= 2
}

// EXPECTING-RED HOLE, see the module note. Zero blocking rows at the two probed arguments is the
// measured state of the interpretation path today; this assertion is the tripwire that flips when
// the marker wall lands.
test fn personal_identity_to_a_log_channel_still_compiles_on_the_interpretation_path() -> Bool {
  let c = census_of(source: probe_source(name: "personal_identity_to_log_channel_probe"))
  census_ran(c: c)
    && blocking_count_for_subject(c: c, subject: "direct call argument for parameter 'classified'") == 0
    && blocking_count_for_subject(c: c, subject: "direct call argument for parameter 'sink'") == 0
}
