// ---------------------------------------------------------------------------
data f9_generic_green_source: String = "module probe_f9_generic_green\nimport std.interval { degenerate_interval }\nfn legal() -> Int { 1 }\nfn legal_mint() -> Bool {\n  let iv = degenerate_interval(point: 5)\n  true\n}\n"

test fn f9_generic_carrier_green_control_clean() -> Bool {
  violation_count(source: f9_generic_green_source, wanted: "SoleConstructorViolation") == 0
}

