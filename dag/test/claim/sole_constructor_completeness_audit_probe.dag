data f16_map_value_source: String = "module probe_f16_map_value\nimport test.fixture.sole_constructor_sealed.definer { LocalValidated }\nimport std.types { Map }\ndata forged: Map<String, LocalValidated> = { \"k\": LocalValidated { n: 999 } }\n"

test fn f16_record_lit_map_value_refuses() -> Bool {
