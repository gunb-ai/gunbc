// ---------------------------------------------------------------------------
// Order-dependence probe: two modules declare a bare-name-identical type
// `DupShape`, one sole_constructor, one not (test.fixture.sole_constructor_order_probe
// .sealed_variant / .open_variant). One probe module directly-selects the
// SEALED one by name and merely transitively imports the open one; a sibling
// probe swaps which is directly-selected. A third pair imports BOTH bare
// (no braces - transitive presence only, neither directly selected) in
// opposite declaration order, to test whether resolution of an unqualified
// bare-name construction depends on import statement order.
// ---------------------------------------------------------------------------
data f10_direct_select_sealed_source: String = "module probe_f10_direct_sealed\nimport test.fixture.sole_constructor_order_probe.sealed_variant { DupShape }\nimport test.fixture.sole_constructor_order_probe.open_variant\nfn forged() -> DupShape { DupShape { tag: 999 } }\n"

test fn f10_direct_selected_sealed_type_refuses() -> Bool {
  violation_count(source: f10_direct_select_sealed_source, wanted: "SoleConstructorViolation") >= 1
}

data f10_direct_select_open_source: String = "module probe_f10_direct_open\nimport test.fixture.sole_constructor_order_probe.open_variant { DupShape }\nimport test.fixture.sole_constructor_order_probe.sealed_variant\nfn forged() -> DupShape { DupShape { tag: 999 } }\n"

test fn f10_direct_selected_open_type_is_clean() -> Bool {
  violation_count(source: f10_direct_select_open_source, wanted: "SoleConstructorViolation") == 0
}

data f10_neither_direct_ab_source: String = "module probe_f10_neither_ab\nimport test.fixture.sole_constructor_order_probe.sealed_variant\nimport test.fixture.sole_constructor_order_probe.open_variant\nfn forged() -> Bool {\n  let x = DupShape { tag: 999 }\n  true\n}\n"

data f10_neither_direct_ba_source: String = "module probe_f10_neither_ba\nimport test.fixture.sole_constructor_order_probe.open_variant\nimport test.fixture.sole_constructor_order_probe.sealed_variant\nfn forged() -> Bool {\n  let x = DupShape { tag: 999 }\n  true\n}\n"

test fn f10_neither_direct_ab_at_least_one_violation() -> Bool {
  violation_count(source: f10_neither_direct_ab_source, wanted: "SoleConstructorViolation") >= 1
}

test fn f10_neither_direct_ba_at_least_one_violation() -> Bool {
  violation_count(source: f10_neither_direct_ba_source, wanted: "SoleConstructorViolation") >= 1
}

test fn f10_neither_direct_order_independent() -> Bool {
  violation_count(source: f10_neither_direct_ab_source, wanted: "SoleConstructorViolation")
    == violation_count(source: f10_neither_direct_ba_source, wanted: "SoleConstructorViolation")
}

// Diagnostic (non-claim, printed value): exact integer counts behind the f10
// battery's Bool verdicts, to distinguish CensusNotRunnable (-1) from a real
// wrong count.
fn f10_diag_direct_sealed_count() -> Int {
  violation_count(source: f10_direct_select_sealed_source, wanted: "SoleConstructorViolation")
}
fn f10_diag_direct_open_count() -> Int {
  violation_count(source: f10_direct_select_open_source, wanted: "SoleConstructorViolation")
}
fn f10_diag_neither_ab_count() -> Int {
  violation_count(source: f10_neither_direct_ab_source, wanted: "SoleConstructorViolation")
}
fn f10_diag_neither_ba_count() -> Int {
  violation_count(source: f10_neither_direct_ba_source, wanted: "SoleConstructorViolation")
}

// ---------------------------------------------------------------------------
// Addendum form 11: does the wall fire at a SECOND, DIFFERENT concrete type
// argument of the same generic sole_constructor carrier - not just Int (the
// existing f9 uses Int; this instantiates a locally-declared non-Int record
// as T, to rule out the wall holding only because prior uses were monomorphic).
// ---------------------------------------------------------------------------
data f11_generic_poly_second_type_source: String = "module probe_f11_generic_poly\nimport std.interval { OrderedClosedInterval }\ntype ProbeMarker { x: Int }\nfn forged() -> OrderedClosedInterval<ProbeMarker> {\n  OrderedClosedInterval { low: ProbeMarker { x: 1 }, high: ProbeMarker { x: 2 } }\n}\n"

test fn f11_generic_carrier_second_type_arg_refuses() -> Bool {
  violation_count(source: f11_generic_poly_second_type_source, wanted: "SoleConstructorViolation") >= 1
}

// ---------------------------------------------------------------------------
// Addendum form 11b: BOTH instantiations forged in the SAME probe module, to
// confirm the wall fires independently per call site rather than only on
// the first occurrence encountered (a distinct order-dependence risk from
// form 10 - order across USES of one generic type, not across type DECLS).
// ---------------------------------------------------------------------------
data f11b_generic_poly_both_source: String = "module probe_f11b_generic_poly_both\nimport std.interval { OrderedClosedInterval }\ntype ProbeMarker { x: Int }\nfn forged_int() -> OrderedClosedInterval<Int> { OrderedClosedInterval { low: 5, high: 1 } }\nfn forged_marker() -> OrderedClosedInterval<ProbeMarker> {\n  OrderedClosedInterval { low: ProbeMarker { x: 1 }, high: ProbeMarker { x: 2 } }\n}\n"

test fn f11b_generic_carrier_both_type_args_each_refuse() -> Bool {
  violation_count(source: f11b_generic_poly_both_source, wanted: "SoleConstructorViolation") >= 2
}

// ---------------------------------------------------------------------------
// Addendum item 2: sole_constructor confines WHO writes the literal/cast; it
// says nothing about WHAT predicate the sanctioned mint enforces. std.interval
// closed_interval takes `le: fn(T, T) -> Bool` as a CALLER-SUPPLIED parameter,
// not a validator fixed by the declaring module. This probe drives the fully
// sanctioned, sole_constructor-confined route (no diagnostic, no violation)
// with a deliberately-broken caller-supplied predicate and low > high, and
// EXECUTES it (not just compile-checks it) to see whether the confined mint
// still emits an IntervalReady whose invariant is violated.
// ---------------------------------------------------------------------------

fn always_true_le(a: Int, b: Int) -> Bool { true }

test fn f12_caller_supplied_validator_defeats_ordering_invariant() -> Bool {
  match closed_interval(low: 10, high: 1, le: always_true_le) {
    IntervalReady { interval: iv } => true
    IntervalRefused { reason: _ } => false
  }
}

// Green control: an honest predicate on the same reversed bounds is refused
// by closed_interval's own logic (not by sole_constructor) - confirms f12's
// result is about validator identity, not a broken harness.
fn honest_le(a: Int, b: Int) -> Bool { a <= b }

test fn f12b_honest_validator_control_refuses_reversed_bounds() -> Bool {
  match closed_interval(low: 10, high: 1, le: honest_le) {
    IntervalReady { interval: _ } => false
    IntervalRefused { reason: _ } => true
  }
}

// ---------------------------------------------------------------------------
// Form: VARIANT construction of a sole_constructor COPRODUCT (not a record).
// f1-f4 (and every prior probe) forge a plain sole_constructor RECORD via a
// record literal. This probe asks whether forging one VARIANT of a
// sole_constructor coproduct, from outside its declaring module, reaches
// sole_constructor_construction_diags at all - by EXECUTION, not by trusting
// the source comment claiming only ExprCast and record-literal inference
// reach the check. Fixture: test.fixture.sole_constructor_variant_probe.definer
// declares `type SealedChoice sole_constructor = SealedA { n: Int } | SealedB { s: String }`.
// ---------------------------------------------------------------------------
data f13_variant_construction_source: String = "module probe_f13_variant_forge\nimport test.fixture.sole_constructor_variant_probe.definer { SealedChoice, SealedA }\nfn forged() -> SealedChoice {\n  SealedA { n: 999 }\n}\n"

fn f13_diag_variant_count() -> Int {
  violation_count(source: f13_variant_construction_source, wanted: "SoleConstructorViolation")
}

test fn f13_variant_construction_refuses() -> Bool {
  violation_count(source: f13_variant_construction_source, wanted: "SoleConstructorViolation") >= 1
}

// Calibration for f13: confirms the synthetic module actually compiled
// (CensusObserved, not the -1 CensusNotRunnable sentinel already built into
// violation_count above) and reports the RAW total diagnostic count so a
// zero SoleConstructorViolation count is read beside total row volume,
// never in isolation.
fn f13_diag_notrunnable_sentinel() -> Int {
  violation_count(source: f13_variant_construction_source, wanted: "SoleConstructorViolation")
}

fn f13_diag_total_row_count() -> Int {
  match census_of(source: f13_variant_construction_source) {
    CensusObserved { rows: rows } => census_total_count(rows: rows)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// ---------------------------------------------------------------------------
// Form: deserialization / from_value / emit-side reconstruction. Static read
// of v1_interpreter_dispatch_generated.rs's 124-entry builtin dispatch table
// found no builtin returning a generic/parametric T from untyped data - so
// there is no serde-style bypass distinct from record-literal/cast/variant
// construction. This probe turns that read-based claim into an EXECUTED one:
// it attempts the most plausible such call (a guessed from_json-shaped
// builtin name) against the sealed fixture type, cross-module, and measures
// what diagnostic class actually fires - confirming by execution that no
// such construction path resolves at all, rather than resolving and silently
// bypassing sole_constructor.
// ---------------------------------------------------------------------------
data f14_deserialize_attempt_source: String = "module probe_f14_deserialize_attempt\nimport test.fixture.sole_constructor_sealed.definer { LocalValidated }\nfn forged() -> LocalValidated {\n  from_json(source: \"{ \\\"n\\\": 999 }\")\n}\n"

fn f14_diag_total_row_count() -> Int {
  match census_of(source: f14_deserialize_attempt_source) {
    CensusObserved { rows: rows } => census_total_count(rows: rows)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn f14_diag_sole_ctor_count() -> Int {
  violation_count(source: f14_deserialize_attempt_source, wanted: "SoleConstructorViolation")
}

