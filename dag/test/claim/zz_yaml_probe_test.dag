module test.claim.zz_yaml_probe

import v2.compiler.emit_orchestration { orch_emit_join2 }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }

fn probe_join2() -> v2.std.diagnostic.Outcome<extdeps.communication.medium.Medium<String>> {
  orch_emit_join2(left: "echo a", right: "echo b", medium: bash_orchestration_emit_medium())
}
