module test.claim.dag_compile_clean_shard_refusal_witness

import v2.std.subject_evidence { EvidenceInstrumentRefused, EvidenceSubjectCompleted, EvidenceSubjectUnreached }
import tools.host_prelude { WitnessBinNotEnrolled }
import tools.dag_compile_clean_shard_transport { run_shard_a_exemplar_compile_with_unenrolled_compiler }

// A MISSING COMPILER IS A LOCATED INSTRUMENT REFUSAL, NEVER A SHARD VERDICT. The real shard receipt
// route (tools.dag_compile_clean_shard_transport single_module_shard_compile_typed) with a compiler
// that is not an enrolled release bin: the evidence must be the EvidenceInstrumentRefused arm
// naming that bin and WitnessBinNotEnrolled. Before the receipt was typed, this state and an
// unclean module answered the same false. The refusal fires before any cargo build, so this runs
// per-PR at the cost of one git toplevel and one enrollment lookup.
test fn shard_receipt_unready_compiler_surfaces_its_refusal() -> Bool {
  match run_shard_a_exemplar_compile_with_unenrolled_compiler() {
    EvidenceInstrumentRefused { cause: refusal } =>
      refusal.bin_name == "no_such_witness_bin_zzz" && refusal.reason == WitnessBinNotEnrolled
    EvidenceSubjectUnreached { cause: _ } => false
    EvidenceSubjectCompleted { outcome: _ } => false
  }
}
