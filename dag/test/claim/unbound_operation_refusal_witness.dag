module test.claim.unbound_operation_refusal_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executing witness for v1.compiler.emit emit_unbound_operation_refusal. An operation whose service
// declares no transport has no realization for the target; the emitter used to classify that
// absence as a "local" transport and render `Ok(start_detached())`, a call to a function nothing
// declares, so every crate reaching extdeps.posix.process failed rustc E0425 (measured on the
// rfm-rung-census route, class 4 of stern-bat-401's emitter-debt list). The reduction keeps that
// shape: an operation with an input and an output and no transport, inside a service with none.
// The RED is the must-not list: the fabricated call and its "Local binding" banner. The positive
// half is the refusal naming the operation, in the error-expression template every target shares.

test fn undeclared_transport_operation_refuses_by_name() -> Bool {
  compile_dag_rust_emit_check(
    "module unbound_operation_witness.process\n\ntype SpawnOutcome = Spawned { pid: Int } | SpawnRefused { reason: String }\n\nservice probe.Process {\n  operation StartDetached {\n    requires opaque\n    input {\n      program: String\n    }\n    output { spawn: SpawnOutcome }\n  }\n}\n",
    "src/unbound_operation_witness_process.rs",
    ["panic!(\"operation 'StartDetached' has no realization for target rust: its service declares no transport\")"],
    ["start_detached()", "Local binding"]
  )
}
