  VastAiInstance {
    id: id,
    machine_id: machine_id,
    actual_status: Present { value: "running" },
    gpu_name: "RTX PRO 6000",
    gpu_ram: 98304,
    num_gpus: 1,
    image_uuid: qwen_image(),
    is_bid: Present { value: true },
    min_bid: ExactDecimal { units: 1, fraction_digits: -1 },
    dph_total: ExactDecimal { units: 1, fraction_digits: -1 },
    label: Present { value: flex_owner_label_gunbc_flex as String },
  }
}

test fn write_decision_keeps_rate_and_currency_refusals_distinct_from_unreadable() -> Bool {
  let labelled = exhausted(rows: [
    inst_labelled(
      id: 1,
      machine_id: 1,
      label: Present { value: flex_owner_label_gunbc_flex as String },
      dollars: 1,
    ),
  ])
  match flex_write_decision(policy: live_policy(), roster: FlexInstancesUnreadable) {
    FlexWriteBlockedUnreadable =>
      match flex_write_decision(policy: live_policy(), roster: exhausted(rows: [inst_scale_refused(id: 1, machine_id: 1)])) {
        FlexWriteBlockedRateUnconverted =>
          match flex_write_decision(policy: eur_live_policy(), roster: labelled) {
            FlexWriteBlockedCurrencyMismatch { left: l, right: r } =>
              currency_code_eq(a: l, b: Eur) && currency_code_eq(a: r, b: Usd)
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn frontiers_are_unbound() -> Bool {
  match flex_search_offers_inhabitance_frontier {
    UnboundDissolution { description: _ } => true
    BoundDissolution { trigger: _ } => false
  }
}

fn objective_is_cost_per_accepted_unit() -> Bool {
  match flex_objective.measure {
    CostPerAcceptedUnit { unit: _ } => true
    NetValue => false
  }
}

