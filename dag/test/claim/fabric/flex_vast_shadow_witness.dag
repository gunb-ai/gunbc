data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn t_caps() -> CapabilityManifestRef { "gunbc.capabilities.linux-rust-toolchain" }
fn t_trust() -> TrustDomainRef { "gunbc.trust.internal-fleet" }

fn t_reqs() -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 8) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    revocation: RevocationAccepted,
  }
}

fn usd_hour(amount: MoneyAmountMicro) -> MoneyPerHour {
  MoneyPerHour { amount: amount, currency: Usd }
}

fn t_offer(key: OfferKey, rate: MoneyPerHour) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    route: fixture_route(),
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 64) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: 1,
    ready_at: "2026-10-13T00:00:00Z",
    quote: QuotedPerHour(rate),
    billing_quantum: second(count: 3600),
    evidence: ObservedSupply { observed_at: "2026-10-13T00:00:00Z", receipt: "obs-shadow" },
  }
}

fn t_bound(offer: SupplierOffer<NonEmptyStr>, revocable: Bool) -> List<CandidateOffer<NonEmptyStr>> {
  match bind_candidate(
    offer: offer,
    dispatch: DispatchInputs {
      offer: offer.id,
      availability: if revocable {
        AvailableRevocable { delay: second(count: 0), receipt: "avail-revocable" }
      } else {
        AvailableIndefinitely { delay: second(count: 0), receipt: "avail-1" }
      },
      commitment: PayAsYouGo,
      start: StartCostMeasured {
        amount: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
        receipt: "start-1",
      },
      transition: NoTransitionRequired,
      operating: OperatingCostBorneBySupplier,
      opportunity: NoFeasibleAlternativeUse { receipt: "opp-1" },
    },
    admission: fixture_admitted_for_offer(route: offer.route, offer: offer.id),
    demand: fixture_demand_for(offer: offer.id),
    work: fixture_work_for(offer: offer.id),
  ) {
    CandidateBound { candidate: c } => [c]
    DispatchInputsNameAnotherOffer { offer: _, inputs_name: _ } => []
    OfferNotAdmittedForUse { offer: _, cause: _ } => []
    PermitNamesAnotherOffer { offer: _, permit_names: _ } => []
    PermitNamesAnotherRoute { offer: _ } => []
    PermitNamesAnotherWork { permit_work: _, subject_work: _ } => []
    PermitNamesAnotherDemand { permit_demand: _, subject_demand: _ } => []
  }
}

fn t_machine(id: NonEmptyStr) -> FlexMachineKey {
  flex_machine_key(account: "vast-account-1", machine: id)
}

fn t_account() -> MoneyAccount {
  MoneyAccount {
    account: "flex-fleet",
    currency: Usd,
    ledger: EncumbranceLedger {
      appropriation: Appropriation { ceiling: flex_trial_total },
      entries: [],
    },
    leases: [],
  }
}

fn empty_occupancy() -> FlexFleetOccupancy {
  FlexFleetOccupancy { standing: [] }
}

fn t_window(remaining: Nat) -> FlexAcquisitionWindow {
  FlexAcquisitionWindow { remaining: remaining }
}

fn t_attempt(machine: FlexMachineKey, min_bid: ExactDecimal, quote: MoneyPerHour, key: OfferKey) -> FlexBidAttempt<NonEmptyStr> {
  FlexBidAttempt {
    machine: machine,
    min_bid: min_bid,
    quote_currency: vast_ai_quote_currency,
    candidates: fold(
      t_bound(offer: t_offer(key: key, rate: quote), revocable: true),
      init: [],
      f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
    ),
    subject: FlexNewAcquisition,
    on_demand_reference: fold(
      t_bound(offer: t_offer(key: "on-demand-ref", rate: usd_hour(amount: money_amount_micro(count: 2000000))), revocable: false),
      init: FlexOnDemandReferenceMissing,
      f: (acc, c) =>
        match acc {
          FlexOnDemandReferenceFresh { candidate: existing } =>
            FlexOnDemandReferenceFresh { candidate: existing }
          FlexOnDemandReferenceStale { candidate: s } => FlexOnDemandReferenceStale { candidate: s }
          FlexOnDemandReferenceMissing => FlexOnDemandReferenceFresh { candidate: c }
        },
    ),
    requirements: t_reqs(),
    reservation: "res-shadow",
    generation: 1,
    delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
    tie: StableRosterOrder,
    affinity: "test.flex.shadow" as PlacementAffinityKey,
    market: FlexMarketQuoted {
      median: usd_hour(amount: money_amount_micro(count: 1100000)),
      level: FlexBidLevelMarket,
    },
  }
}

fn wire_offer(name: String, ram: Int, bid: Bool, rentable: Bool) -> VastAiOffer {
  VastAiOffer {
    id: 7,
    machine_id: 42,
    gpu_name: name,
    num_gpus: 1,
    compute_cap: 1200,
    gpu_arch: Present { value: "nvidia" },
    verification: "verified",
    geolocation: "US",
    rentable: rentable,
    rented: false,
    is_bid: Present { value: bid },
    min_bid: ExactDecimal { units: 1, fraction_digits: 0 },
    dph_total: ExactDecimal { units: 2, fraction_digits: 0 },
    storage_cost: ExactDecimal { units: 15, fraction_digits: 2 },
    inet_up_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    inet_down_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    gpu_ram: ram,
    driver_version: Present { value: "580.65.06" },
    cuda_max_good: Present { value: ExactDecimal { units: 130, fraction_digits: 1 } },
    inet_down: Present { value: ExactDecimal { units: 2500, fraction_digits: 0 } },
  }
}

fn t_charge(start: Int, end: Int, desc: String) -> VastAiCharge {
  VastAiCharge {
    start: start,
    end: end,
    type: "compute",
    source: "vast",
    description: desc,
    amount: ExactDecimal { units: 1, fraction_digits: 0 },
    items: [],
  }
}

fn inst(id: Int, machine_id: Int) -> VastAiInstance {
  inst_labelled(id: id, machine_id: machine_id, label: none, dollars: 1)
}

fn inst_labelled(id: Int, machine_id: Int, label: String?, dollars: Int) -> VastAiInstance {
  VastAiInstance {
    id: id,
    machine_id: machine_id,
    actual_status: Present { value: "running" },
    gpu_name: "RTX PRO 6000",
    gpu_ram: 98304,
    num_gpus: 1,
    image_uuid: qwen_image(),
    is_bid: Present { value: true },
    min_bid: ExactDecimal { units: dollars, fraction_digits: 0 },
    dph_total: ExactDecimal { units: dollars, fraction_digits: 0 },
    label: label,
  }
}

fn exhausted(rows: List<VastAiInstance>) -> FlexInstancesStanding {
  flex_fold_instance_pages(pages: [
    FlexInstancesPageTurn {
      after_token: none,
      page: VastAiInstances {
        success: true,
        instances_found: rows |> length,
        total_instances: rows |> length,
        next_token: none,
        instances: rows,
      },
    },
  ])
}

fn qwen_image() -> String {
  match flex_host_image(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer) {
    Present { value: i } => i as String
    Absent => ""
  }
}

test fn flex_template_is_the_recipes_realization() -> Bool {
  // Flash-Next: the image is read, the served model id is not (ruling flex_first_recipe_is_flash_next), so the
  // template refuses to realize rather than invent an id. The 27B recipe stays modelled and realizes, and is not selected.
  (match flex_serving_template(recipe: flex_serving_recipe) {
    FlexTemplateServedIdUnread => true
    _ => false
  })
    && (match flex_host_image(recipe: flex_serving_recipe) {
      Present { value: i } => i as String == "ghcr.io/local-inference-lab/vllm@sha256:751ee72beb242b163e1124b2e0b825a509e20bacaf1423f467d65f6b8b664bc7"
      Absent => false
    })
    && (match flex_serving_template(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer) {
      FlexTemplateResolved { template: t } => t.model_id as String == "qwen"
      _ => false
    })
}

test fn operator_template_and_policy_are_named_facts() -> Bool {
  flex_template_is_the_recipes_realization()
    && flex_search_type == vast_ai_search_type_bid
    && money_per_hour_cap_is_three_dollars()
    && flex_actuation_mode_default_is_dry()
    && objective_is_cost_per_accepted_unit()
    && money_amount_micro_count(m: flex_delay_unvalued.amount) == 0
    && read_grant_is_accessor()
    && machine_key_follows_offer_id()
}

fn read_grant_is_accessor() -> Bool {
  let target = fleet_secret_ref(secret_id: "fixture-vast-api-key")
  let expected = secret_accessor_grant(target: target)
  let grant = flex_vast_api_read_grant(target: target)
  grant.role == expected.role && grant.target.secret == expected.target.secret
}

fn machine_key_follows_offer_id() -> Bool {
  let offer = wire_offer(name: "RTX PRO 6000", ram: 98304, bid: true, rentable: true)
  flex_machine_key_for_offer(account: "vast-account-1", offer: offer).machine
    == flex_machine_key(account: "vast-account-1", machine: "42").machine
}

fn money_per_hour_cap_is_three_dollars() -> Bool {
  money_amount_micro_count(m: flex_trial_fleet_rate_cap.amount) == 3000000
    && fold(
      design_rulings(),
      init: false,
      f: (acc, r) =>
        acc || (declaration_ref_eq(a: r.reference, b: flex_trial_fleet_rate_cap_authority)
          && r.decided == "2026-10-16"
          && string_contains(s: r.provenance, pattern: "$3.00/h")),
    )
}

test fn the_cap_authority_discriminates_the_old_ruling() -> Bool {
  fold(
    design_rulings(),
    init: false,
    f: (acc, r) =>
      acc || (declaration_ref_eq(a: r.reference, b: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_market_policy_is_operator_decided"))
        && string_contains(s: r.provenance, pattern: "raised by flex_fleet_cap_raised_to_three_dollars")),
  )
    && money_per_hour_cap_is_three_dollars()
}

fn flex_actuation_mode_default_is_dry() -> Bool {
  match flex_trial_policy.actuation {
    Plan => true
    Apply => false
  }
    && write_gate_conjunction()
    && frontiers_are_unbound()
}

fn live_policy() -> FlexPolicy {
  FlexPolicy {
    fleet_rate_cap: flex_trial_fleet_rate_cap,
    on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
    acquisition_horizon: second(count: 3600),
    owner: flex_owner_label_gunbc_flex,
    actuation: Apply,
  }
}

fn write_gate_conjunction() -> Bool {
  match flex_write_decision(policy: flex_trial_policy, roster: exhausted(rows: [])) {
    FlexWriteHeldDry =>
      match flex_write_decision(policy: live_policy(), roster: FlexInstancesUnreadable) {
        FlexWriteBlockedUnreadable =>
          match flex_write_decision(
            policy: live_policy(),
            roster: FlexInstancesPartial { next_token: "n", observed: [], total: 1 },
          ) {
            FlexWriteBlockedPartialRoster =>
              match flex_write_decision(
                policy: live_policy(),
                roster: exhausted(rows: [
                  inst_labelled(
                    id: 1,
                    machine_id: 1,
                    label: Present { value: flex_owner_label_gunbc_flex as String },
                    dollars: 4,
                  ),
                ]),
              ) {
                FlexWriteBlockedOverCap =>
                  match flex_write_decision(policy: live_policy(), roster: exhausted(rows: [])) {
                    FlexWriteWetUnwired => true
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn eur_live_policy() -> FlexPolicy {
  FlexPolicy {
    fleet_rate_cap: MoneyPerHour { amount: money_amount_micro(count: 1340000), currency: Eur },
    on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
    acquisition_horizon: second(count: 3600),
    owner: flex_owner_label_gunbc_flex,
    actuation: Apply,
  }
}

