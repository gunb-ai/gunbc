data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn t_caps() -> CapabilityManifestRef { "gunbc.capabilities.linux-rust-toolchain" }
fn t_trust() -> TrustDomainRef { "gunbc.trust.internal-fleet" }

fn t_reqs() -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 8) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    revocation: RevocationAccepted,
  }
}

fn usd_hour(amount: MoneyAmountMicro) -> MoneyPerHour {
  MoneyPerHour { amount: amount, currency: Usd }
}

fn t_offer(key: OfferKey, rate: MoneyPerHour) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    route: fixture_route(),
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 64) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: 1,
    ready_at: "2026-10-13T00:00:00Z",
    quote: QuotedPerHour(rate),
    billing_quantum: second(count: 3600),
    evidence: ObservedSupply { observed_at: "2026-10-13T00:00:00Z", receipt: "obs-shadow" },
  }
}

fn t_bound(offer: SupplierOffer<NonEmptyStr>, revocable: Bool) -> List<CandidateOffer<NonEmptyStr>> {
  match bind_candidate(
    offer: offer,
    dispatch: DispatchInputs {
      offer: offer.id,
      availability: if revocable {
        AvailableRevocable { delay: second(count: 0), receipt: "avail-revocable" }
      } else {
        AvailableIndefinitely { delay: second(count: 0), receipt: "avail-1" }
      },
      commitment: PayAsYouGo,
      start: StartCostMeasured {
        amount: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
        receipt: "start-1",
      },
      transition: NoTransitionRequired,
      operating: OperatingCostBorneBySupplier,
      opportunity: NoFeasibleAlternativeUse { receipt: "opp-1" },
    },
    admission: fixture_admitted_for_offer(route: offer.route, offer: offer.id),
    demand: fixture_demand_for(offer: offer.id),
    work: fixture_work_for(offer: offer.id),
  ) {
    CandidateBound { candidate: c } => [c]
    DispatchInputsNameAnotherOffer { offer: _, inputs_name: _ } => []
    OfferNotAdmittedForUse { offer: _, cause: _ } => []
    PermitNamesAnotherOffer { offer: _, permit_names: _ } => []
    PermitNamesAnotherRoute { offer: _ } => []
    PermitNamesAnotherWork { permit_work: _, subject_work: _ } => []
    PermitNamesAnotherDemand { permit_demand: _, subject_demand: _ } => []
  }
}

fn t_machine(id: NonEmptyStr) -> FlexMachineKey {
  flex_machine_key(account: "vast-account-1", machine: id)
}

fn t_account() -> MoneyAccount {
  MoneyAccount {
    account: "flex-fleet",
    currency: Usd,
    ledger: EncumbranceLedger {
      appropriation: Appropriation { ceiling: flex_trial_total },
      entries: [],
    },
    leases: [],
  }
}

fn empty_occupancy() -> FlexFleetOccupancy {
  FlexFleetOccupancy { standing: [] }
}

fn t_window(remaining: Nat) -> FlexAcquisitionWindow {
  FlexAcquisitionWindow { remaining: remaining }
}

fn t_attempt(machine: FlexMachineKey, min_bid: ExactDecimal, quote: MoneyPerHour, key: OfferKey) -> FlexBidAttempt<NonEmptyStr> {
  FlexBidAttempt {
    machine: machine,
    min_bid: min_bid,
    quote_currency: vast_ai_quote_currency,
    candidates: fold(
      t_bound(offer: t_offer(key: key, rate: quote), revocable: true),
      init: [],
      f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
    ),
    subject: FlexNewAcquisition,
    on_demand_reference: fold(
      t_bound(offer: t_offer(key: "on-demand-ref", rate: usd_hour(amount: money_amount_micro(count: 2000000))), revocable: false),
      init: FlexOnDemandReferenceMissing,
      f: (acc, c) =>
        match acc {
          FlexOnDemandReferenceFresh { candidate: existing } =>
            FlexOnDemandReferenceFresh { candidate: existing }
          FlexOnDemandReferenceStale { candidate: s } => FlexOnDemandReferenceStale { candidate: s }
          FlexOnDemandReferenceMissing => FlexOnDemandReferenceFresh { candidate: c }
        },
    ),
    requirements: t_reqs(),
    reservation: "res-shadow",
    generation: 1,
    delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
    tie: StableRosterOrder,
    affinity: "test.flex.shadow" as PlacementAffinityKey,
    market: FlexMarketQuoted {
      median: usd_hour(amount: money_amount_micro(count: 1100000)),
      level: FlexBidLevelMarket,
    },
  }
}

fn wire_offer(name: String, ram: Int, bid: Bool, rentable: Bool) -> VastAiOffer {
  VastAiOffer {
    id: 7,
    machine_id: 42,
    gpu_name: name,
    num_gpus: 1,
    compute_cap: 1200,
    gpu_arch: Present { value: "nvidia" },
    verification: "verified",
    geolocation: "US",
    rentable: rentable,
    rented: false,
    is_bid: Present { value: bid },
    min_bid: ExactDecimal { units: 1, fraction_digits: 0 },
    dph_total: ExactDecimal { units: 2, fraction_digits: 0 },
    storage_cost: ExactDecimal { units: 15, fraction_digits: 2 },
    inet_up_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    inet_down_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    gpu_ram: ram,
    driver_version: Present { value: "580.65.06" },
  }
}

fn inst(id: Int, machine_id: Int) -> VastAiInstance {
  inst_labelled(id: id, machine_id: machine_id, label: none, dollars: 1)
}

fn inst_labelled(id: Int, machine_id: Int, label: String?, dollars: Int) -> VastAiInstance {
  VastAiInstance {
    id: id,
    machine_id: machine_id,
    actual_status: Present { value: "running" },
    gpu_name: "RTX PRO 6000",
    gpu_ram: 98304,
    num_gpus: 1,
    image_uuid: flex_qwen_serving_image as String,
    is_bid: Present { value: true },
    min_bid: ExactDecimal { units: dollars, fraction_digits: 0 },
    dph_total: ExactDecimal { units: dollars, fraction_digits: 0 },
    label: label,
  }
}

fn exhausted(rows: List<VastAiInstance>) -> FlexInstancesStanding {
  FlexInstancesExhausted { instances: rows, total: 0 }
}

test fn operator_template_and_policy_are_named_facts() -> Bool {
  (flex_qwen_serving_template.image == flex_qwen_serving_image)
    && flex_qwen_serving_template.published_tcp_port == flex_qwen_published_tcp_port
    && byte_size_count(b: flex_qwen_serving_template.disk) == byte_size_count(b: flex_qwen_disk)
    && (flex_qwen_serving_template.model_id == flex_qwen_model_id)
    && flex_qwen_published_tcp_port == 8000
    && byte_size_count(b: flex_qwen_disk) == byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: 32)))
    && flex_search_type == vast_ai_search_type_bid
    && match flex_unit_min_host_driver(unit: Qwen3_8_27bOnNinfer) {
      Present { value: n } => n == flex_ninfer_min_driver
      Absent => false
    }
    && match flex_unit_min_host_driver(unit: Glm53FlashOnVllm) {
      Present { value: n } => n == flex_vllm_min_driver
      Absent => false
    }
    && money_per_hour_cap_is_one_thirty_four()
    && flex_actuation_mode_default_is_dry()
    && objective_is_cost_per_accepted_unit()
    && money_amount_micro_count(m: flex_delay_unvalued.amount) == 0
    && read_grant_is_accessor()
    && machine_key_follows_offer_id()
}

fn read_grant_is_accessor() -> Bool {
  let target = fleet_secret_ref(secret_id: "fixture-vast-api-key")
  let expected = secret_accessor_grant(target: target)
  let grant = flex_vast_api_read_grant(target: target)
  grant.role == expected.role && grant.target.secret == expected.target.secret
}

fn machine_key_follows_offer_id() -> Bool {
  let offer = wire_offer(name: "RTX PRO 6000", ram: 98304, bid: true, rentable: true)
  flex_machine_key_for_offer(account: "vast-account-1", offer: offer).machine
    == flex_machine_key(account: "vast-account-1", machine: "42").machine
}

fn money_per_hour_cap_is_one_thirty_four() -> Bool {
  money_amount_micro_count(m: flex_trial_fleet_rate_cap.amount) == 1340000
}

fn flex_actuation_mode_default_is_dry() -> Bool {
  match flex_trial_policy.actuation {
    FlexActuationDry => true
    FlexActuationWet => false
  }
    && write_gate_conjunction()
    && frontiers_are_unbound()
}

fn live_policy() -> FlexPolicy {
  FlexPolicy {
    fleet_rate_cap: flex_trial_fleet_rate_cap,
    on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
    acquisition_horizon: second(count: 3600),
    owner: flex_owner_label_gunbc_flex,
    actuation: FlexActuationWet,
  }
}

fn write_gate_conjunction() -> Bool {
  match flex_write_decision(policy: flex_trial_policy, roster: exhausted(rows: [])) {
    FlexWriteHeldDry =>
      match flex_write_decision(policy: live_policy(), roster: FlexInstancesUnreadable) {
        FlexWriteBlockedUnreadable =>
          match flex_write_decision(
            policy: live_policy(),
            roster: FlexInstancesPartial { next_token: "n", observed: [], total: 1 },
          ) {
            FlexWriteBlockedPartialRoster =>
              match flex_write_decision(
                policy: live_policy(),
                roster: exhausted(rows: [
                  inst_labelled(
                    id: 1,
                    machine_id: 1,
                    label: Present { value: flex_owner_label_gunbc_flex as String },
                    dollars: 2,
                  ),
                ]),
              ) {
                FlexWriteBlockedOverCap =>
                  match flex_write_decision(policy: live_policy(), roster: exhausted(rows: [])) {
                    FlexWriteWetUnwired => true
                    FlexWriteHeldDry => false
                    FlexWriteBlockedUnreadable => false
                    FlexWriteBlockedOverCap => false
                    FlexWriteBlockedPartialRoster => false
                  }
                FlexWriteHeldDry => false
                FlexWriteBlockedUnreadable => false
                FlexWriteBlockedPartialRoster => false
                FlexWriteWetUnwired => false
              }
            FlexWriteHeldDry => false
            FlexWriteBlockedUnreadable => false
            FlexWriteBlockedOverCap => false
            FlexWriteWetUnwired => false
          }
        FlexWriteHeldDry => false
        FlexWriteBlockedOverCap => false
        FlexWriteBlockedPartialRoster => false
        FlexWriteWetUnwired => false
      }
    FlexWriteBlockedUnreadable => false
    FlexWriteBlockedOverCap => false
    FlexWriteBlockedPartialRoster => false
    FlexWriteWetUnwired => false
  }
}

fn frontiers_are_unbound() -> Bool {
  match flex_search_offers_inhabitance_frontier {
    UnboundDissolution { description: _ } => true
    BoundDissolution { trigger: _ } => false
  }
    && match flex_m3_rent_cooldown_starts_at_ask {
      UnboundDissolution { description: _ } => true
      BoundDissolution { trigger: _ } => false
    }
    && match flex_m3_pass_stops_at_first_failure {
      UnboundDissolution { description: _ } => true
      BoundDissolution { trigger: _ } => false
    }
    && match flex_wet_create_release_consumer_frontier {
      UnboundDissolution { description: _ } => true
      BoundDissolution { trigger: _ } => false
    }
}

fn objective_is_cost_per_accepted_unit() -> Bool {
  match flex_objective.measure {
    CostPerAcceptedUnit { unit: _ } => true
    NetValue => false
  }
}

test fn supported_gpu_classes_screen_offers() -> Bool {
  flex_gpu_class_matches(
    offer: wire_offer(name: "RTX 5000 Ada", ram: 49152, bid: true, rentable: true),
    class: flex_gpu_class_rtx_5000_48gb,
  )
    && !flex_gpu_class_matches(
      offer: wire_offer(name: "RTX 4090", ram: 49152, bid: true, rentable: true),
      class: flex_gpu_class_rtx_5000_48gb,
    )
    && flex_gpu_class_matches(
      offer: wire_offer(name: "H100", ram: 73728, bid: true, rentable: true),
      class: flex_gpu_class_72gb,
    )
    && flex_gpu_class_matches(
      offer: wire_offer(name: "RTX PRO 6000 Blackwell", ram: 98304, bid: true, rentable: true),
      class: flex_gpu_class_rtx_pro_6000_96gb,
    )
    && flex_offer_supported(offer: wire_offer(name: "RTX PRO 6000 S", ram: 98304, bid: true, rentable: true))
    && !flex_offer_in_shadow_field(offer: wire_offer(name: "RTX PRO 6000 S", ram: 98304, bid: false, rentable: true))
    && !flex_offer_in_shadow_field(offer: wire_offer(name: "RTX 4090", ram: 24576, bid: true, rentable: true))
    && host_driver_screens_the_serving_unit()
}

fn wire_offer_driver(name: String, ram: Int, driver: String?) -> VastAiOffer {
  VastAiOffer {
    id: 7,
    machine_id: 42,
    gpu_name: name,
    num_gpus: 1,
    compute_cap: 1200,
    gpu_arch: Present { value: "nvidia" },
    verification: "verified",
    geolocation: "US",
    rentable: true,
    rented: false,
    is_bid: Present { value: true },
    min_bid: ExactDecimal { units: 1, fraction_digits: 0 },
    dph_total: ExactDecimal { units: 2, fraction_digits: 0 },
    storage_cost: ExactDecimal { units: 15, fraction_digits: 2 },
    inet_up_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    inet_down_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    gpu_ram: ram,
    driver_version: driver,
  }
}

fn host_driver_screens_the_serving_unit() -> Bool {
  let ok = wire_offer_driver(name: "RTX PRO 6000 S", ram: 98304, driver: Present { value: "580.65.06" })
  let unread = wire_offer_driver(name: "RTX PRO 6000 S", ram: 98304, driver: none)
  let low_ninfer = wire_offer_driver(name: "RTX PRO 6000 S", ram: 98304, driver: Present { value: "570.86.15" })
  let vllm_ok = wire_offer_driver(name: "RTX PRO 6000 S", ram: 98304, driver: Present { value: "590.44.01" })
  let vllm_low = wire_offer_driver(name: "RTX PRO 6000 S", ram: 98304, driver: Present { value: "580.65.06" })
  flex_offer_meets_unit_driver(offer: ok, unit: Qwen3_8_27bOnNinfer)
    && !flex_offer_meets_unit_driver(offer: unread, unit: Qwen3_8_27bOnNinfer)
    && !flex_offer_meets_unit_driver(offer: low_ninfer, unit: Qwen3_8_27bOnNinfer)
    && flex_serving_unit_accepts_offer(unit: Qwen3_8_27bOnNinfer, offer: ok)
    && !flex_serving_unit_accepts_offer(unit: Qwen3_8_27bOnNinfer, offer: unread)
    && flex_offer_meets_unit_driver(offer: vllm_ok, unit: Glm53FlashOnVllm)
    && !flex_offer_meets_unit_driver(offer: vllm_low, unit: DeepseekV4FlashOnVllm)
    && flex_offer_in_shadow_field(offer: ok)
    && !flex_offer_in_shadow_field(offer: unread)
}

test fn lost_create_plus_observed_instance_does_not_acquire_again() -> Bool {
  let observed = exhausted(rows: [inst(id: 99, machine_id: 42)])
  let empty = exhausted(rows: [])
  let lost = flex_reconcile_acquisition(
    standing: FlexCreateLost { ask_id: 7, machine_id: 42 },
    roster: observed,
  )
  let refused_empty = flex_reconcile_acquisition(
    standing: FlexCreateRefused { ask_id: 7, machine_id: 42 },
    roster: empty,
  )
  let lost_unseen = flex_reconcile_acquisition(
    standing: FlexCreateLost { ask_id: 7, machine_id: 42 },
    roster: empty,
  )
  let partial = flex_reconcile_acquisition(
    standing: FlexCreateLost { ask_id: 7, machine_id: 42 },
    roster: FlexInstancesPartial { next_token: "n", observed: [inst(id: 99, machine_id: 42)], total: 2 },
  )
  (match lost {
    FlexAlreadyHeld { instance: i } => i.id == 99
    FlexAcquisitionUnknown => false
    FlexMayAcquire => false
    FlexReconcileNeedsExhaustedRoster => false
  })
    && (match refused_empty {
      FlexMayAcquire => true
      _ => false
    })
    && (match lost_unseen {
      FlexAcquisitionUnknown => true
      _ => false
    })
    && (match partial {
      FlexReconcileNeedsExhaustedRoster => true
      _ => false
    })
    && (match flex_rental_readback(
      standing: FlexCreateLost { ask_id: 7, machine_id: 42 },
      roster: observed,
      bound_expired: false,
    ) {
      FlexRentalHeld { instance: i } => i.id == 99
      _ => false
    })
    && (match flex_rental_readback(
      standing: FlexCreateLost { ask_id: 7, machine_id: 42 },
      roster: empty,
      bound_expired: true,
    ) {
      FlexRentalUnknown => true
      FlexRentalPending { ask_id: _, machine_id: _ } => false
      FlexRentalHeld { instance: _ } => false
      FlexRentalGone => false
    })
    && release_counts_only_when_confirmed_gone()
    && excess_demand_uses_operator_share()
    && dry_pass_records_unreadable_list()
}

fn release_counts_only_when_confirmed_gone() -> Bool {
  let held = exhausted(rows: [inst(id: 99, machine_id: 42)])
  (match flex_release_readback(
    standing: FlexReleaseRequested { instance_id: 99 },
    roster: held,
  ) {
    FlexReleasePending { instance_id: i } => i == 99
    FlexReleaseConfirmedGone => false
    FlexReleaseUnknown => false
  })
    && (match flex_release_readback(
      standing: FlexReleaseLost { instance_id: 99 },
      roster: exhausted(rows: []),
    ) {
      FlexReleaseConfirmedGone => true
      FlexReleasePending { instance_id: _ } => false
      FlexReleaseUnknown => false
    })
    && (match flex_release_readback(
      standing: FlexReleaseLost { instance_id: 99 },
      roster: FlexInstancesUnreadable,
    ) {
      FlexReleaseUnknown => true
      FlexReleasePending { instance_id: _ } => false
      FlexReleaseConfirmedGone => false
    })
    && (match flex_release_readback(
      standing: FlexReleaseLost { instance_id: 99 },
      roster: FlexInstancesPartial { next_token: "n", observed: [], total: 1 },
    ) {
      FlexReleaseUnknown => true
      FlexReleasePending { instance_id: _ } => false
      FlexReleaseConfirmedGone => false
    })
}

fn excess_demand_uses_operator_share() -> Bool {
  let share = harness_operator_route.concurrency_ceiling
  share + 1 > share && !(share > share)
}

fn dry_pass_records_unreadable_list() -> Bool {
  let pass = flex_record_pass(
    policy: flex_trial_policy,
    roster: FlexInstancesUnreadable,
    receipts: [],
  )
  match pass.roster {
    FlexInstancesUnreadable =>
      match pass.write {
        FlexWriteHeldDry => true
        FlexWriteBlockedUnreadable => false
        FlexWriteBlockedOverCap => false
        FlexWriteBlockedPartialRoster => false
        FlexWriteWetUnwired => false
      }
    FlexInstancesExhausted { instances: _, total: _ } => false
    FlexInstancesPartial { next_token: _, observed: _, total: _ } => false
  }
}

test fn shadow_bid_records_m0_admission_and_stays_dry() -> Bool {
  let offer = wire_offer(name: "RTX PRO 6000 S", ram: 98304, bid: true, rentable: true)
  let receipt = flex_shadow_bid(
    policy: flex_trial_policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(),
    offer: offer,
    attempt: t_attempt(
      machine: t_machine(id: "9"),
      min_bid: ExactDecimal { units: 9, fraction_digits: 0 },
      quote: usd_hour(amount: money_amount_micro(count: 1100000)),
      key: "offer-42",
    ),
  )
  receipt.offer_id == 7
    && (receipt.offer_key == flex_vast_offer_key(offer: offer))
    && flex_machine_key_eq(left: receipt.machine, right: flex_machine_key_for_offer(account: "vast-account-1", offer: offer))
    && match receipt.actuation {
      FlexActuationDry => true
      FlexActuationWet => false
    }
    && match receipt.admission {
      FlexBidAdmitted { bid: _, selection: _, account: _, occupancy: _, window: _ } => false
      FlexBidUnchanged { bid: _, account: _, occupancy: _, window: _ } => false
      FlexBidRefused { cause: _ } => true
    }
}

test fn a_foreign_candidate_identity_does_not_ride_the_vast_offer() -> Bool {
  let offer = wire_offer(name: "RTX PRO 6000 S", ram: 98304, bid: true, rentable: true)
  let a = t_attempt(
    machine: t_machine(id: "9"),
    min_bid: ExactDecimal { units: 9, fraction_digits: 0 },
    quote: usd_hour(amount: money_amount_micro(count: 1100000)),
    key: "offer-42",
  )
  let b = t_attempt(
    machine: t_machine(id: "9"),
    min_bid: ExactDecimal { units: 9, fraction_digits: 0 },
    quote: usd_hour(amount: money_amount_micro(count: 1100000)),
    key: "offer-99",
  )
  let bound_a = flex_bind_attempt_to_offer(offer: offer, attempt: a)
  let bound_b = flex_bind_attempt_to_offer(offer: offer, attempt: b)
  let ra = flex_shadow_bid(
    policy: flex_trial_policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(),
    offer: offer,
    attempt: a,
  )
  let rb = flex_shadow_bid(
    policy: flex_trial_policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(),
    offer: offer,
    attempt: b,
  )
  (ra.offer_key == rb.offer_key)
    && (ra.offer_key == flex_vast_offer_key(offer: offer))
    && (ra.offer_key != ("offer-42" as OfferKey))
    && (bound_a.candidates |> length) == 0
    && (bound_b.candidates |> length) == 0
}

test fn instance_pages_exhaust_before_cap_or_reconcile() -> Bool {
  let first = VastAiInstances {
    success: true,
    instances_found: 1,
    total_instances: 2,
    next_token: Present { value: "tok" },
    instances: [inst(id: 1, machine_id: 1)],
  }
  let last = VastAiInstances {
    success: true,
    instances_found: 1,
    total_instances: 2,
    next_token: none,
    instances: [inst(id: 2, machine_id: 2)],
  }
  let charges_open = VastAiCharges {
    success: true,
    count: 0,
    total: 1,
    next_token: Present { value: "c" },
    results: [],
  }
  let charges_last = VastAiCharges {
    success: true,
    count: 0,
    total: 1,
    next_token: none,
    results: [],
  }
  (flex_keyset_page_limit == vast_ai_keyset_page_limit)
    && (match flex_instances_page(page: first) {
      FlexInstancesPartial { next_token: t, observed: rows, total: n } =>
        (t == "tok") && ((rows |> length) == 1) && (n == 2)
      _ => false
    })
    && (match flex_fold_instance_pages(pages: [first, last]) {
      FlexInstancesExhausted { instances: rows, total: n } => ((rows |> length) == 2) && (n == 2)
      _ => false
    })
    && (match flex_charges_page(page: charges_open) {
      FlexChargesPartial { next_token: t, observed: _, total: _ } => t == "c"
      FlexChargesExhausted { results: _, total: _ } => false
      FlexChargesUnreadable => false
    })
    && (match flex_fold_charge_pages(pages: [charges_open, charges_last]) {
      FlexChargesExhausted { results: rows, total: n } => ((rows |> length) == 0) && (n == 1)
      _ => false
    })
    && (match flex_cap_from_roster(
      policy: flex_trial_policy,
      roster: FlexInstancesPartial { next_token: "tok", observed: [], total: 1 },
    ) {
      FlexCapNeedsExhaustedRoster => true
      _ => false
    })
    && (match flex_cap_from_roster(
      policy: flex_trial_policy,
      roster: exhausted(rows: [
        inst_labelled(
          id: 1,
          machine_id: 1,
          label: Present { value: flex_owner_label_gunbc_flex as String },
          dollars: 2,
        ),
        inst_labelled(id: 2, machine_id: 2, label: Present { value: "ctrl-bidder" }, dollars: 9),
      ]),
    ) {
      FlexCapOver { occupied: o, cap: c } =>
        (money_amount_micro_count(m: o.amount) == 2000000)
          && (money_amount_micro_count(m: c.amount) == 1340000)
      _ => false
    })
}
