// THE PATH MINT IS DELETED, and the probe that used to RECORD the residual now attributes its closure: a foreign module
// asking for fabric_storage_file_root is refused with exactly one MissingExport keyed on that name; the lawful route (the
// ONE mint over a declared member chain and a business key) is zero blocking. The recorded residual stands for the AMBIENT
// route -- raw Filesystem over a literal path, file_slot_store_over -- which is a different probe and a different lane.
test fn the_deleted_path_mint_is_no_longer_reachable_from_any_module() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: file_root_path_mint, wanted_class: "MissingExport", wanted_subject: "fabric_storage_file_root"), holds: fn(n) { n == 1 }))
}

test fn the_lawful_fabric_store_mint_is_reachable() -> ProcessExit {
  census_exit(blocking_delta(hostile: file_root_lawful_mint, safe: file_root_baseline, holds: fn(n) { n <= 0 }))
}

// THE SECOND EXPECTING-RED PROBE: the LocalFiles arm of the binding carries that path-built FileRoot, and the store mints take the
// binding, so a workspace store over a literal path is ACCEPTED today. Same trigger; no rung claimed.
test fn the_local_files_binding_no_longer_takes_a_path_mint() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: local_files_store_path, wanted_class: "MissingExport", wanted_subject: "fabric_storage_file_root"), holds: fn(n) { n == 1 }))
}

// THE OUTCOME-TAKING FOLD IS DELETED: fabric_storage_put_from_create turned a supplied FilesystemCreated into FabricObjectStored
// (and trusted a supplied FabricObjectFetched), so any module could mint the success outcome. It is inlined into
// fabric_storage_file_put beside its own create and readback. RED: importing it is exactly one MissingExport keyed on the name;
// GREEN: importing the lawful fabric_storage_file_put is zero. Restoring the export flips the RED to zero.
data put_fold_import: String = "module probe_put_fold_import\nimport gunbc.fabric.fabric_storage_file_store { fabric_storage_put_from_create }\nfn f() -> Int {\n  1\n}\n"

data put_lawful_import: String = "module probe_put_lawful_import\nimport gunbc.fabric.fabric_storage_file_store { fabric_storage_file_put }\nfn f() -> Int {\n  1\n}\n"

test fn the_outcome_taking_put_fold_is_not_exported() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: put_fold_import, wanted_class: "MissingExport", wanted_subject: "fabric_storage_put_from_create"), holds: fn(n) { n == 1 }))
}

test fn the_lawful_put_is_exported() -> ProcessExit {
  census_exit(census_verdict(census: blocking_subject_census(source: put_lawful_import, wanted_class: "MissingExport", wanted_subject: "fabric_storage_file_put"), holds: fn(n) { n == 0 }))
}
