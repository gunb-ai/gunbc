module test.claim.fabric.fabric_storage_seal_witness

import std.types { Bool, Int, String, NonEmptyStr }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// THE FABRIC-DB-BACKED STORES ARE SEALED RECORDS MINTED FROM THEIR OWN SLOT DECLARATIONS. Each of the six workspace stores and the
// tailnet cutover journal is sole_constructor, minted only by its module over a FabricStorageBinding (never a path), with the slot
// member derived from its declaration; and gunbc.fabric.fabric_storage_file_store FabricStorageFileRoot is sole_constructor too.
// Each RED hands the compiler a foreign module and asserts EXACTLY ONE SoleConstructorViolation keyed on the exact type name
// (literal and cast); the GREEN is the lawful mint, with zero violations and no blocking delta over a baseline importing the
// same closure. WHAT IS SEALED IS CONSTRUCTION: field reads are not sealed, and the binding the mint takes is not sealed
// (its LocalFiles arm is built over a path by fabric_storage_file_root, the expecting-red probes at the end).

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

data workspace_allocation_literal: String = "module probe_workspace_allocation_literal\nimport std.types { NonEmptyStr, String }\nimport gunbc.fabric.fabric_storage_client { FabricStorageBinding }\nimport gunbc.workspace_allocation_store { WorkspaceAllocationStore, workspace_allocation_store }\nfn f(b: FabricStorageBinding, m: NonEmptyStr) -> WorkspaceAllocationStore {\n  WorkspaceAllocationStore { binding: b }\n}\n"

data workspace_allocation_cast: String = "module probe_workspace_allocation_cast\nimport std.types { NonEmptyStr, String }\nimport gunbc.fabric.fabric_storage_client { FabricStorageBinding }\nimport gunbc.workspace_allocation_store { WorkspaceAllocationStore, workspace_allocation_store }\nfn f(r: NonEmptyStr) -> WorkspaceAllocationStore {\n  r as WorkspaceAllocationStore\n}\n"

