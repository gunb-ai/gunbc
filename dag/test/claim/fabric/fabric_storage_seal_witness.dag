// THE SEAL IS WHAT REFUSES, not something else in the probe: the same construction over an UNSEALED twin of the
// record -- same fields, no sole_constructor -- is accepted, zero SoleConstructorViolations. The seal on
// FabricStorageOperations is the difference, and stripping it would flip the literal RED above to zero.
data file_root_unsealed_analogue: String = "module probe_file_root_unsealed_analogue\nimport std.types { NonEmptyStr }\nimport extdeps.access.posix { FileMode }\ntype OpsAnalogue {\n  objects: NonEmptyStr\n  heads: NonEmptyStr\n  entry_mode: FileMode?\n}\nfn f(r: NonEmptyStr) -> OpsAnalogue {\n  OpsAnalogue { objects: r, heads: r, entry_mode: none }\n}\n"

data local_files_store_path: String = "module probe_local_files_store_path\nimport std.types { NonEmptyStr, String }\nimport gunbc.fabric.fabric_storage_client { FabricStorageLocalFiles }\nimport gunbc.fabric.fabric_storage_file_store { fabric_storage_file_root }\nimport gunbc.workspace_allocation_store { WorkspaceAllocationStore, workspace_allocation_store }\nfn f() -> WorkspaceAllocationStore {\n  workspace_allocation_store(binding: FabricStorageLocalFiles { root: fabric_storage_file_root(root: \"/any/literal\") })\n}\n"

data local_files_baseline: String = "module probe_local_files_baseline\nimport std.types { NonEmptyStr, String }\nimport gunbc.fabric.fabric_storage_client { FabricStorageLocalFiles }\nimport gunbc.fabric.fabric_storage_file_store { fabric_storage_file_root }\nimport gunbc.workspace_allocation_store { WorkspaceAllocationStore, workspace_allocation_store }\nfn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n"

test fn a_forged_workspace_allocation_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: workspace_allocation_literal, subject: "WorkspaceAllocationStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_workspace_allocation_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: workspace_allocation_cast, subject: "WorkspaceAllocationStore"), holds: fn(n) { n == 1 }))
}

test fn the_lawful_workspace_allocation_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: workspace_allocation_lawful, safe: workspace_allocation_baseline, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: workspace_allocation_lawful, subject: "WorkspaceAllocationStore"), holds: fn(n) { n == 0 }),
  ])
}

