data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn t_caps() -> CapabilityManifestRef { "gunbc.capabilities.linux-rust-toolchain" }
fn t_trust() -> TrustDomainRef { "gunbc.trust.internal-fleet" }

fn t_reqs() -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 8) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    revocation: RevocationAccepted,
  }
}

fn t_offer(key: OfferKey, rate: MoneyPerHour) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    route: fixture_route(),
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 64) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: 1,
    ready_at: "2026-10-13T00:00:00Z",
    quote: QuotedPerHour(rate),
    billing_quantum: second(count: 3600),
    evidence: ObservedSupply { observed_at: "2026-10-13T00:00:00Z", receipt: "obs-recipe" },
  }
}

fn t_bound(offer: SupplierOffer<NonEmptyStr>, revocable: Bool) -> List<CandidateOffer<NonEmptyStr>> {
  match bind_candidate(
    offer: offer,
    dispatch: DispatchInputs {
      offer: offer.id,
      availability: if revocable {
        AvailableRevocable { delay: second(count: 0), receipt: "avail-revocable" }
      } else {
        AvailableIndefinitely { delay: second(count: 0), receipt: "avail-owned" }
      },
      commitment: PayAsYouGo,
      start: StartCostMeasured {
        amount: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
        receipt: "start-1",
      },
      transition: NoTransitionRequired,
      operating: OperatingCostBorneBySupplier,
      opportunity: NoFeasibleAlternativeUse { receipt: "opp-1" },
    },
    admission: fixture_admitted_for_offer(route: offer.route, offer: offer.id),
    demand: fixture_demand_for(offer: offer.id),
    work: fixture_work_for(offer: offer.id),
  ) {
    CandidateBound { candidate: c } => [c]
    DispatchInputsNameAnotherOffer { offer: _, inputs_name: _ } => []
    OfferNotAdmittedForUse { offer: _, cause: _ } => []
    PermitNamesAnotherOffer { offer: _, permit_names: _ } => []
    PermitNamesAnotherRoute { offer: _ } => []
    PermitNamesAnotherWork { permit_work: _, subject_work: _ } => []
    PermitNamesAnotherDemand { permit_demand: _, subject_demand: _ } => []
  }
}

fn t_no_delay() -> MoneyPerSecond {
  MoneyRate { amount: money_amount_micro(count: 0), currency: Usd }
}

fn t_select(candidates: List<CandidateOffer<NonEmptyStr>>) -> SupplySelection<NonEmptyStr> {
  select_supply(
    requirements: t_reqs(),
    candidates: candidates,
    duration: ExactGrantDuration { seconds: second(count: 90) },
    maximum_buy_order: money_amount_micro(count: 1000000),
    budget_currency: Usd,
    delay_valuation: t_no_delay(),
    tie: StableRosterOrder,
    affinity: "test.recipe" as PlacementAffinityKey,
  )
}

fn t_selected_key(s: SupplySelection<NonEmptyStr>) -> String {
  match s {
    OfferSelected { candidate: sel, cost: _, basis: _, horizon: _, considered: _, tie_policy: _ } =>
      (sel.candidate.offer.id.key as String)
    NoAdmissibleOffer { considered: _ } => "none"
    EqualCostTieUnresolved { digest: _, cause: _, considered: _ } => "tie-unresolved"
  }
}

fn usd_hour(micro: Nat) -> MoneyPerHour {
  MoneyPerHour { amount: money_amount_micro(count: micro), currency: Usd }
}

fn gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

fn card(name: String, vram_gib: Nat, driver: Nat?) -> ServingCardFacts {
  ServingCardFacts {
    product: if string_contains(s: name, pattern: "PRO 6000") {
      Present { value: nvidia_rtx_pro_6000_server_catalog }
    } else if string_contains(s: name, pattern: "PRO 5000 72") {
      Present { value: nvidia_rtx_pro_5000_72gb_catalog }
    } else if string_contains(s: name, pattern: "PRO 5000") {
      Present { value: nvidia_rtx_pro_5000_48gb_catalog }
    } else {
      none
    },
    vram: gib(n: vram_gib),
    driver_major: driver,
  }
}

fn verdict_is_accepted(v: ServingCardVerdict) -> Bool {
  match v {
    CardAccepted { class: _ } => true
    CardRefusedWrongCard => false
    CardRefusedDriverBelowFloor { required: _, observed: _ } => false
    CardRefusedDriverUnread => false
    CardScreenedOnUncitedFloor { class: _, required: _, observed: _, floor_met: met } => met
  }
}

fn accepts(recipe: ServingRecipe, c: ServingCardFacts) -> Bool {
  verdict_is_accepted(v: serving_recipe_accepts_card(recipe: recipe, card: c))
}

// ── each recipe resolves to its card classes ─────────────────────────────────────────────────

test fn qwen_recipe_resolves_to_the_catalogued_pro_6000_class() -> Bool {
  accepts(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer, c: card(name: "RTX PRO 6000", vram_gib: 96, driver: Present { value: 595 }))
}

test fn qwen_recipe_admits_the_48gb_and_72gb_pro_5000_catalog_rows() -> Bool {
  accepts(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer, c: card(name: "RTX PRO 5000", vram_gib: 48, driver: Present { value: 595 }))
    && accepts(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer, c: card(name: "RTX PRO 5000 72", vram_gib: 72, driver: Present { value: 595 }))
}

test fn flash_next_refuses_the_pro_5000_rows() -> Bool {
  match serving_recipe_accepts_card(
    recipe: serving_recipe_flash_next_lab_vllm,
    card: card(name: "RTX PRO 5000", vram_gib: 48, driver: Present { value: 595 }),
  ) {
    CardRefusedWrongCard => true
    _ => false
  }
}

test fn flash_next_recipe_resolves_to_pro_6000_only() -> Bool {
  accepts(recipe: serving_recipe_flash_next_lab_vllm, c: card(name: "RTX PRO 6000", vram_gib: 96, driver: Present { value: 595 }))
}

// ── refusals ─────────────────────────────────────────────────────────────────────────────────

test fn qwen_is_refused_on_cards_without_a_catalog_product_whatever_their_vram() -> Bool {
  (match serving_recipe_accepts_card(
    recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer,
    card: card(name: "RTX 5000 Ada", vram_gib: 48, driver: Present { value: 595 }),
  ) {
    CardRefusedWrongCard => true
    _ => false
  })
    && (match serving_recipe_accepts_card(
      recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer,
      card: card(name: "H100", vram_gib: 80, driver: Present { value: 595 }),
    ) {
      CardRefusedWrongCard => true
      _ => false
    })
}

test fn serving_recipe_frontier_builds_a_keyed_roster() -> Bool {
  match frontier_rows_keyed_roster_build(rows: serving_recipe_frontier) {
    KeyedRosterBuilt { rows: _ } => true
    KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

test fn flash_next_engine_ref_names_the_lab_release_row() -> Bool {
  (match serving_recipe_flash_next_lab_vllm.engine {
    EngineVllmLab { build: r } => (r.release_name as String) == (local_inference_lab_vllm_release.release_name as String)
    EngineNinfer { build: _ } => false
  })
    && (match serving_recipe_qwen3_8_27b_nvfp4_ninfer.engine {
      EngineNinfer { build: _ } => true
      EngineVllmLab { build: _ } => false
    })
    && (match local_inference_lab_vllm_release.standing {
      TranscribedUncited { read_obligation: _ } => true
      _ => false
    })
}

test fn flash_next_is_refused_off_pro_6000_even_with_enough_vram() -> Bool {
  match serving_recipe_accepts_card(
    recipe: serving_recipe_flash_next_lab_vllm,
    card: card(name: "RTX A6000", vram_gib: 96, driver: Present { value: 595 }),
  ) {
    CardRefusedWrongCard => true
    _ => false
  }
}

test fn a_driver_below_the_floor_is_refused_and_an_unread_driver_is_refused() -> Bool {
  (match serving_recipe_accepts_card(
    recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer,
    card: card(name: "RTX PRO 6000", vram_gib: 96, driver: Present { value: 570 }),
  ) {
    CardScreenedOnUncitedFloor { class: _, required: r, observed: o, floor_met: met } => r == 580 && o == 570 && !met
    _ => false
  })
    && (match serving_recipe_accepts_card(
      recipe: serving_recipe_flash_next_lab_vllm,
      card: card(name: "RTX PRO 6000", vram_gib: 96, driver: Present { value: 575 }),
    ) {
      CardScreenedOnUncitedFloor { class: _, required: r, observed: o, floor_met: met } => r == 580 && o == 575 && !met
      _ => false
    })
    && (match serving_recipe_accepts_card(
      recipe: serving_recipe_flash_next_lab_vllm,
      card: card(name: "RTX PRO 6000", vram_gib: 96, driver: none),
    ) {
      CardRefusedDriverUnread => true
      _ => false
    })
}

// ── non-fungible recipes are never substituted ───────────────────────────────────────────────

test fn flash_next_is_not_interchangeable_with_the_27b_in_either_direction() -> Bool {
  serving_recipes_interchangeable(left: serving_recipe_qwen3_8_27b_nvfp4_ninfer, right: serving_recipe_qwen3_8_27b_nvfp4_ninfer)
    && serving_recipes_interchangeable(left: serving_recipe_flash_next_lab_vllm, right: serving_recipe_flash_next_lab_vllm)
    && !serving_recipes_interchangeable(left: serving_recipe_qwen3_8_27b_nvfp4_ninfer, right: serving_recipe_flash_next_lab_vllm)
    && !serving_recipes_interchangeable(left: serving_recipe_flash_next_lab_vllm, right: serving_recipe_qwen3_8_27b_nvfp4_ninfer)
}

test fn the_27b_recipe_names_the_existing_catalog_unit_and_flash_next_names_none_yet() -> Bool {
  (match serving_recipe_qwen3_8_27b_nvfp4_ninfer.catalog_unit {
    Present { value: u } =>
      match u {
        Qwen3_8_27bOnNinfer => true
        _ => false
      }
    Absent => false
  })
    && (match serving_recipe_flash_next_lab_vllm.catalog_unit {
      Present { value: _ } => false
      Absent => true
    })
}

// ── disk is part of a rented card's cost ─────────────────────────────────────────────────────

// 400 GiB at 375 micro-dollars per GiB-hour is 150000 micro per hour (the operator's ~0.15/h).
fn t_disk_rate() -> ServingDiskRate {
  ServingDiskRate { rate: MoneyRate { amount: money_amount_micro(count: 375), currency: Usd } }
}

fn hourly_micro(h: ServingHourlyCost) -> Int {
  match h {
    HourlyCostQuoted { rate: r } => money_amount_micro_count(m: r.amount) as Int
    HourlyCostUnamortizable => -1
    HourlyCostCurrencyMismatch => -2
  }
}

test fn a_rented_cards_hourly_cost_is_its_dph_plus_the_recipes_disk() -> Bool {
  hourly_micro(h: serving_card_hourly(
    recipe: serving_recipe_flash_next_lab_vllm,
    supply: RentedCardSupply { dph: usd_hour(micro: 900000), disk_rate: t_disk_rate() },
  )) == 1050000
}

test fn disk_scales_with_the_recipes_disk_need() -> Bool {
  // 27B needs 32 GiB: 32 * 375 = 12000
  hourly_micro(h: serving_card_hourly(
    recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer,
    supply: RentedCardSupply { dph: usd_hour(micro: 900000), disk_rate: t_disk_rate() },
  )) == 912000
}

test fn a_disk_rate_in_another_currency_is_refused_not_added() -> Bool {
  match serving_card_hourly(
    recipe: serving_recipe_flash_next_lab_vllm,
    supply: RentedCardSupply {
      dph: usd_hour(micro: 900000),
      disk_rate: ServingDiskRate { rate: MoneyRate { amount: money_amount_micro(count: 375), currency: Eur } },
    },
  ) {
    HourlyCostCurrencyMismatch => true
    _ => false
  }
}

test fn an_owned_card_amortizes_its_capital_and_zero_hours_is_unamortizable() -> Bool {
  // $10,000 over 10,000 hours is $1/h.
  (hourly_micro(h: serving_card_hourly(
    recipe: serving_recipe_flash_next_lab_vllm,
    supply: OwnedCardSupply { capital: money_amount_micro(count: 10000000000), currency: Usd, amortization: second(count: 36000000) },
  )) == 1000000)
    && (hourly_micro(h: serving_card_hourly(
      recipe: serving_recipe_flash_next_lab_vllm,
      supply: OwnedCardSupply { capital: money_amount_micro(count: 10000000000), currency: Usd, amortization: second(count: 0) },
    )) == -1)
}

// ── owned and rented reach selection under one recipe; disk changes the ranking ──────────────

fn recipe_rate(supply: ServingCardSupply) -> MoneyPerHour {
  match serving_card_hourly(recipe: serving_recipe_flash_next_lab_vllm, supply: supply) {
    HourlyCostQuoted { rate: r } => r
    HourlyCostUnamortizable => usd_hour(micro: 0)
    HourlyCostCurrencyMismatch => usd_hour(micro: 0)
  }
}

fn owned_supply() -> ServingCardSupply {
  OwnedCardSupply { capital: money_amount_micro(count: 10000000000), currency: Usd, amortization: second(count: 36000000) }
}

fn rented_supply() -> ServingCardSupply {
  RentedCardSupply { dph: usd_hour(micro: 900000), disk_rate: t_disk_rate() }
}

fn candidates(owned_rate: MoneyPerHour, rented_rate: MoneyPerHour) -> List<CandidateOffer<NonEmptyStr>> {
  concat(
    t_bound(offer: t_offer(key: "owned-pro6000", rate: owned_rate), revocable: false),
    t_bound(offer: t_offer(key: "rented-pro6000", rate: rented_rate), revocable: true),
  )
}

test fn an_owned_and_a_rented_pro_6000_both_reach_select_supply_under_one_recipe() -> Bool {
  match t_select(candidates: candidates(owned_rate: recipe_rate(supply: owned_supply()), rented_rate: recipe_rate(supply: rented_supply()))) {
    OfferSelected { candidate: _, cost: _, basis: _, horizon: _, considered: cs, tie_policy: _ } => length(cs) == 2
    NoAdmissibleOffer { considered: _ } => false
    EqualCostTieUnresolved { digest: _, cause: _, considered: _ } => false
  }
}

test fn disk_cost_flips_the_selection_that_dph_alone_would_make() -> Bool {
  // dph only: rented 0.90/h undercuts owned 1.00/h. With the 0.15/h disk, rented is 1.05/h.
  (t_selected_key(s: t_select(candidates: candidates(owned_rate: usd_hour(micro: 1000000), rented_rate: usd_hour(micro: 900000))))
    == "rented-pro6000")
    && (t_selected_key(s: t_select(candidates: candidates(
      owned_rate: recipe_rate(supply: owned_supply()),
      rented_rate: recipe_rate(supply: rented_supply()),
    ))) == "owned-pro6000")
}

// ── cost per accepted unit, per recipe × card ────────────────────────────────────────────────

test fn cost_per_million_tokens_is_computable_where_throughput_is_read_and_unread_where_not() -> Bool {
  // Flash-Next: operator reading ~900 tok/s. 1.05/h -> 1050000 * 1e6 / (900 * 3600) = 324074 micro per Mtok.
  (match serving_cost_per_million_tokens(recipe: serving_recipe_flash_next_lab_vllm, hourly: usd_hour(micro: 1050000)) {
    UnitCostEstimated { amount: a, currency: _, standing: _ } => (money_amount_micro_count(m: a) as Int) == 324075
    UnitCostQuoted { amount: _, currency: _ } => false
    UnitCostThroughputUnread => false
  })
    && (match serving_cost_per_million_tokens(recipe: serving_recipe_flash_next_lab_vllm, hourly: usd_hour(micro: 3240000)) {
      UnitCostEstimated { amount: a, currency: _, standing: _ } => (money_amount_micro_count(m: a) as Int) == 1000000
      UnitCostQuoted { amount: _, currency: _ } => false
      UnitCostThroughputUnread => false
    })
    && (match serving_cost_per_million_tokens(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer, hourly: usd_hour(micro: 1050000)) {
      UnitCostEstimated { amount: _, currency: _, standing: _ } => false
      UnitCostQuoted { amount: _, currency: _ } => false
      UnitCostThroughputUnread => true
    })
}

// ── start route and cache adapt ──────────────────────────────────────────────────────────────

test fn flash_next_starts_from_the_object_store_only_with_no_hub_fallback() -> Bool {
  match serving_start_source(recipe: serving_recipe_flash_next_lab_vllm) {
    StartSourceObserved { store: _, hub_fallback: fb, standing: sd } =>
      !fb && (match sd {
        TranscribedUncited { read_obligation: _ } => true
        _ => false
      })
    _ => false
  }
}

test fn the_qwen_start_source_is_derived_from_its_placement() -> Bool {
  (match serving_start_source(recipe: serving_recipe_qwen3_8_27b_nvfp4_ninfer) {
    StartSourcePlaced { source: src } =>
      (src.locator.key as String) == (rented_qwen3_8_27b_nvfp4_weights_placement.object_key as String)
    _ => false
  })
    && (match serving_start_source(
      recipe: ServingRecipe {
        id: serving_recipe_flash_next_lab_vllm.id,
        model: serving_recipe_flash_next_lab_vllm.model,
        engine: serving_recipe_flash_next_lab_vllm.engine,
        catalog_unit: none,
        published_tcp_port: 8000,
        cards: [],
        driver_floor: serving_recipe_flash_next_lab_vllm.driver_floor,
        disk: serving_recipe_flash_next_lab_vllm.disk,
        cache: serving_recipe_flash_next_lab_vllm.cache,
        start: StartFromPlacedWeights,
        throughput: ThroughputUnread,
        settings: serving_recipe_flash_next_lab_vllm.settings,
      },
    ) {
      StartSourcePlacementMissing => true
      _ => false
    })
}

test fn bare_flash_settings_carry_standing() -> Bool {
  match serving_recipe_flash_next_lab_vllm.settings.disk {
    TranscribedUncited { read_obligation: _ } => true
    _ => false
  }
}

test fn cache_sizes_follow_the_host() -> Bool {
  // one half of the host
  let half = CacheFractionOfHost { fraction: NonzeroNatFraction { num: 1, denom_predecessor: 1 } }
  (byte_size_count(b: serving_cache_bytes(sizing: half, host: gib(n: 512))) == byte_size_count(b: gib(n: 256)))
    && (byte_size_count(b: serving_cache_bytes(sizing: half, host: gib(n: 128))) == byte_size_count(b: gib(n: 64)))
    && byte_size_count(b: serving_cache_bytes(sizing: CacheNone, host: gib(n: 512))) == 0
}

// 5400 s is 1.5 h: capital 3000000 micro over it is 2000000 micro/h, not the 3000000 a whole-hour floor gives;
// and a horizon under one hour is amortizable, not refused.
test fn an_owned_cards_horizon_is_not_rounded_to_whole_hours() -> Bool {
  (match serving_card_hourly(
    recipe: serving_recipe_flash_next_lab_vllm,
    supply: OwnedCardSupply { capital: money_amount_micro(count: 3000000), currency: Usd, amortization: second(count: 5400) },
  ) {
    HourlyCostQuoted { rate: r } => (money_amount_micro_count(m: r.amount) as Int) == 2000000
    _ => false
  })
    && (match serving_card_hourly(
      recipe: serving_recipe_flash_next_lab_vllm,
      supply: OwnedCardSupply { capital: money_amount_micro(count: 1000000), currency: Usd, amortization: second(count: 1800) },
    ) {
      HourlyCostQuoted { rate: r } => (money_amount_micro_count(m: r.amount) as Int) == 2000000
      _ => false
    })
    && (match serving_card_hourly(
      recipe: serving_recipe_flash_next_lab_vllm,
      supply: OwnedCardSupply { capital: money_amount_micro(count: 1000000), currency: Usd, amortization: second(count: 7000) },
    ) {
      HourlyCostQuoted { rate: r } => (money_amount_micro_count(m: r.amount) as Int) == 514286
      _ => false
    })
}
