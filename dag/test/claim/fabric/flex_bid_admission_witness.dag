    occupancy: empty_occupancy(),
    window: t_window(remaining: 0),
    account: t_account(ceiling: money_amount_micro(count: 10000000)),
    attempt: FlexBidAttempt {
      machine: machine,
      min_bid: one_dollar_wire(),
      quote_currency: vast_ai_quote_currency,
      candidates: fold(
        bound,
        init: [],
        f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
      ),
      subject: FlexExistingAcquisition { current_bid: usd_hour(amount: money_amount_micro(count: 1100000)) },
      on_demand_reference: t_on_demand_ref(rate: usd_hour(amount: money_amount_micro(count: 2000000)), key: "od-exist-zero-win"),
      requirements: t_reqs(revocation: RevocationAccepted),
      reservation: "res-exist-zero-win",
      generation: 1,
      delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
      tie: StableRosterOrder,
      affinity: "test.flex" as PlacementAffinityKey,
      market: t_default_market(),
    },
  ) {
    FlexBidAdmitted { bid: _, selection: _, account: _, occupancy: _, window: _ } => false
    FlexBidRefused { cause: _ } => false
    FlexBidUnchanged { bid: b, account: _, occupancy: _, window: w } =>
      (money_per_hour_micros(q: b) == 1100000) && (w.remaining == 0)
  }
}

test fn a_nonzero_setup_hold_covers_the_projected_liability() -> Bool {
  let machine = t_machine(id: "machine-a")
  let bound = t_bound_avail_start(
    offer: t_offer(key: "offer-setup-hold", rate: one_dollar()),
    availability: AvailableRevocable { delay: second(count: 0), receipt: "avail-revocable" },
    start: money_amount_micro(count: 50000),
  )
  match flex_bid_admission(
    policy: t_policy(cap: usd_hour(amount: money_amount_micro(count: 5000000))),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: money_amount_micro(count: 10000000)),
    attempt: FlexBidAttempt {
      machine: machine,
      min_bid: one_dollar_wire(),
      quote_currency: vast_ai_quote_currency,
      candidates: fold(
        bound,
        init: [],
        f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
      ),
      subject: FlexNewAcquisition,
      on_demand_reference: t_on_demand_ref(rate: usd_hour(amount: money_amount_micro(count: 2000000)), key: "od-setup-hold"),
      requirements: t_reqs(revocation: RevocationAccepted),
      reservation: "res-setup-hold",
      generation: 1,
      delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
      tie: StableRosterOrder,
      affinity: "test.flex" as PlacementAffinityKey,
      market: t_default_market(),
    },
  ) {
    FlexBidRefused { cause: _ } => false
    FlexBidUnchanged { bid: _, account: _, occupancy: _, window: _ } => false
    FlexBidAdmitted { bid: b, selection: _, account: next, occupancy: _, window: _ } =>
      (money_per_hour_micros(q: b) == 1100000)
        && fold(
          next.ledger.entries,
          init: false,
          f: (acc, e) =>
            acc || match e.state {
              Held { maximum_liability: m } => money_amount_micro_count(m: m) == 1150000
              Released { reason: _, released_at: _ } => false
              Expended { actual: _, settled_at: _ } => false
            },
        )
  }
}

test fn flex_price_offer_keeps_not_priceable_candidacy() -> Bool {
  t_horizon_arm(h: t_price_one(
    offer: t_offer(key: "price-unobs", rate: one_ten()),
    availability: AvailabilityUnobserved { obligation: "vendor console did not answer" },
    revocation: RevocationAccepted,
    budget: Usd,
    maximum_buy_order: money_amount_micro(count: 5000000),
  )) == "not-priceable"
}

test fn flex_price_offer_keeps_not_fungible_candidacy() -> Bool {
  t_horizon_arm(h: t_price_one(
    offer: SupplierOffer {
      id: FabricIdentity { principal: "gunbc", key: "price-thin" },
      executor: "gunbc",
      route: fixture_route(),
      shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 1) }, envelope: unstated_envelope() },
      capabilities: t_caps(),
      trust_domain: t_trust(),
      isolation: IsolationProfile { guarantees: [] },
      quantity_bound: 1,
      ready_at: "2026-10-12T00:00:00Z",
      quote: QuotedPerHour(one_ten()),
      billing_quantum: second(count: 3600),
      evidence: ObservedSupply { observed_at: "2026-10-12T00:00:00Z", receipt: "obs-1" },
    },
    availability: AvailableIndefinitely { delay: second(count: 0), receipt: "avail-1" },
    revocation: RevocationAccepted,
    budget: Usd,
    maximum_buy_order: money_amount_micro(count: 5000000),
  )) == "not-fungible"
}

test fn flex_price_offer_keeps_unavailable_for_grant_candidacy() -> Bool {
