    },
  ) {
    FlexBidAdmitted { bid: _, selection: _, account: _, occupancy: _, window: _ } => false
    FlexBidRefused { cause: _ } => false
    FlexBidUnchanged { bid: b, account: _, occupancy: _, window: w } =>
      (money_per_hour_micros(q: b) == 1100000) && (w.remaining == 1)
  }
}

