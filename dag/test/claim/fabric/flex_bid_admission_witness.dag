test fn admission_converts_the_vast_wire_min_bid() -> Bool {
  let offer = vast_min_sample()
  match vast_ai_min_bid_money_per_hour(offer: offer) {
    DecimalMoneyPerHourRefused { conversion: _ } => false
    DecimalMoneyPerHourConverted { rate: converted } => {
      match flex_bid_admission(
        policy: t_policy(cap: usd_hour(amount: money_amount_micro(count: 5000000))),
        occupancy: empty_occupancy(),
        window: t_window(remaining: 1),
        account: t_account(ceiling: money_amount_micro(count: 10000000)),
        attempt: t_attempt(
          machine: t_machine(id: "machine-a"),
          min_bid: offer.min_bid,
          quote: converted,
          key: "offer-wire",
          reservation: "res-wire",
          revocation: RevocationAccepted,
          revocable: true,
        ),
      ) {
        FlexBidRefused { cause: _ } => false
        FlexBidUnchanged { bid: _, account: _, occupancy: _, window: _ } => false
        FlexBidAdmitted { bid: b, selection: _, account: _, occupancy: _, window: _ } =>
          match flex_quoted_bid(quote: t_default_market(), floor: converted) {
            FlexBidMarketUnobserved => false
            FlexBidQuoteCurrencyMismatch { left: _, right: _ } => false
            FlexBidPriced { rate: priced } =>
              money_per_hour_micros(q: b) == money_per_hour_micros(q: priced)
          }
      }
    }
  }
}

// The benchmark is a reading, not a purchase: a 1.50M fleet cap, a 2.00M on-demand charge and a 0.05M
// start must read the complete 2.05M, not the charge alone.
test fn the_on_demand_reference_reads_charge_plus_start_above_the_fleet_cap() -> Bool {
  let reference = fold(
    t_bound_avail_start(
      offer: t_offer(key: "od-start", rate: usd_hour(amount: money_amount_micro(count: 2000000))),
      availability: AvailableIndefinitely { delay: second(count: 0), receipt: "avail-1" },
      start: money_amount_micro(count: 50000),
    ),
    init: FlexOnDemandReferenceMissing,
    f: (acc, c) => FlexOnDemandReferenceFresh { candidate: c },
  )
  let attempt = t_attempt_ref(
    machine: t_machine(id: "machine-a"),
    min_bid: one_dollar_wire(),
    quote: one_ten(),
    key: "od-start-probe",
    reservation: "res-od-start",
    revocation: RevocationAccepted,
    revocable: true,
    reference: reference,
  )
  match flex_on_demand_reference_cost(
    policy: t_policy(cap: usd_hour(amount: money_amount_micro(count: 1500000))),
    attempt: attempt,
    budget_currency: Usd,
    maximum_buy_order: money_amount_micro(count: 1500000),
  ) {
    FlexHorizonPriced { cost: c } => money_amount_micro_count(m: c) == 2050000
    FlexHorizonUnobserved => false
    FlexHorizonRefused { candidacy: _ } => false
  }
}
