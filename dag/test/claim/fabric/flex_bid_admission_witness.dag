    policy: t_policy(cap: usd_hour(amount: money_amount_micro(count: 5000000))),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: money_amount_micro(count: 10000000)),
    attempt: FlexBidAttempt {
      machine: machine,
      min_bid: one_dollar_wire(),
      quote_currency: vast_ai_quote_currency,
      candidates: fold(
        bound,
        init: [],
        f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
      ),
      subject: FlexExistingAcquisition { current_bid: usd_hour(amount: money_amount_micro(count: 1100000)) },
      on_demand_reference: t_on_demand_ref(rate: usd_hour(amount: money_amount_micro(count: 2000000)), key: "od-exist-ok"),
      requirements: t_reqs(revocation: RevocationAccepted),
      reservation: "res-exist-ok",
