test fn ctrl_labels_on_the_same_account_do_not_count_against_the_cap() -> Bool {
  let policy = t_policy(cap: usd_hour(amount: money_amount_micro(count: 1500000)))
  let mixed = FlexFleetOccupancy {
    standing: [
      AcquisitionActive { owner: "ctrl-bidder" as FlexOwnerLabel, rate: usd_hour(amount: money_amount_micro(count: 1497000)) },
      AcquisitionPending { owner: "ctrl-pool" as FlexOwnerLabel, rate: usd_hour(amount: money_amount_micro(count: 1497000)) },
    ],
  }
  match occupancy_sum(occupancy: mixed, currency: Usd, ours: flex_owner_label_gunbc_flex) {
    FlexOccupancyCurrencyMismatch { left: _, right: _ } => false
    FlexOccupancySummed { rate: occupied } =>
      (money_per_hour_micros(q: occupied) == 0)
        && (refusal_label(o: flex_bid_admission(
          policy: policy,
          occupancy: mixed,
          window: t_window(remaining: 1),
          account: t_account(ceiling: money_amount_micro(count: 10000000)),
          attempt: t_attempt(
            machine: t_machine(id: "machine-ours"),
            min_bid: one_dollar_wire(),
            quote: one_ten(),
            key: "offer-beside-ctrl",
            reservation: "res-beside-ctrl",
            revocation: RevocationAccepted,
            revocable: true,
          ),
        )) == "admitted")
  }
}

