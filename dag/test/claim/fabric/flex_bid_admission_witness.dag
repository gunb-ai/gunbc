test fn an_unobserved_on_demand_availability_refuses() -> Bool {
  let reference = fold(
    t_bound_avail(
      offer: t_offer(key: "od-unobserved", rate: usd_hour(amount: money_amount_micro(count: 2000000))),
      availability: AvailabilityUnobserved { obligation: "vendor console did not answer" },
    ),
    init: FlexOnDemandReferenceMissing,
    f: (acc, c) =>
      match acc {
        FlexOnDemandReferenceFresh { candidate: existing } =>
          FlexOnDemandReferenceFresh { candidate: existing }
        FlexOnDemandReferenceStale { candidate: stale_c } => FlexOnDemandReferenceStale { candidate: stale_c }
        FlexOnDemandReferenceMissing => FlexOnDemandReferenceFresh { candidate: c }
      },
  )
  refusal_label(o: flex_bid_admission(
    policy: t_policy(cap: usd_hour(amount: money_amount_micro(count: 5000000))),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: money_amount_micro(count: 10000000)),
    attempt: t_attempt_ref(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-unobserved-od",
      reservation: "res-unobserved-od",
      revocation: RevocationAccepted,
      revocable: true,
      reference: reference,
    ),
  )) == "on-demand-unobserved"
}

