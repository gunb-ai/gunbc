module test.claim.fabric.flex_vast_template_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, List, Bool, Int, String, Secret }
import std.optional { Present, Absent }
import extdeps.cloud.vast_ai { VastAiTemplateRow }
import product.fabric.flex_vast_template {
  FlexTemplateSpec, FlexTemplateNoop, FlexTemplateApply, FlexTemplateRefuse,
  flex_vast_template_spec, flex_template_env, flex_template_decide, flex_template_forbidden_env_names,
  flex_template_env_forbidden_name, flex_template_retired_hash,
}
import product.fabric.flex_vast_loop { mint_flex_pool_password }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Supplied rows as the Vast template list answers them (VastAiTemplateRow); the producer of the real
// answer is the srv1 ensure's readback receipt, not this file.
fn row(hash: String, env: String) -> VastAiTemplateRow {
  VastAiTemplateRow {
    id: 1,
    name: flex_vast_template_spec.name as String,
    image: flex_vast_template_spec.image as String,
    hash_id: Present { value: hash },
    env: Present { value: env },
  }
}

fn any_forbidden(env: String) -> Bool {
  match flex_template_env_forbidden_name(env: env) { Present { value: _ } => true  Absent => false }
}

// The declared template's env carries none of the retired template's credential names.
test fn the_declared_template_env_carries_no_credential_name() -> Bool {
  (list_length(flex_template_forbidden_env_names) == 4)
    && !any_forbidden(env: flex_template_env(spec: flex_vast_template_spec))
    && !(flex_vast_template_spec.onstart.contains("R2_"))
    && any_forbidden(env: "-e PORT=18000 -e POOL_API_KEY=x")
    && any_forbidden(env: "-e R2_ACCESS_KEY_ID=x")
}

test fn the_declared_env_is_the_port_and_container_flags_only() -> Bool {
  flex_template_env(spec: flex_vast_template_spec) == "-p 18000:18000 --shm-size 80g --ipc host -e PORT=18000"
}

test fn no_named_row_applies_and_a_matching_row_is_a_noop() -> Bool {
  let env = flex_template_env(spec: flex_vast_template_spec)
  match flex_template_decide(spec: flex_vast_template_spec, named: []) { FlexTemplateApply => true  _ => false }
    && match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "abc", env: env)]) { FlexTemplateNoop { hash: h } => h == "abc"  _ => false }
}

test fn a_credential_bearing_readback_is_refused_not_adopted() -> Bool {
  match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "abc", env: "-e PORT=18000 -e POOL_API_KEY=x")]) {
    FlexTemplateRefuse { cause: _ } => true
    _ => false
  }
}

test fn the_retired_hash_is_never_adopted_and_differing_content_is_not_edited() -> Bool {
  let env = flex_template_env(spec: flex_vast_template_spec)
  match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: flex_template_retired_hash as String, env: env)]) { FlexTemplateRefuse { cause: _ } => true  _ => false }
    && match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "abc", env: "-e PORT=8000")]) { FlexTemplateRefuse { cause: _ } => true  _ => false }
    && match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "a", env: env), row(hash: "b", env: env)]) { FlexTemplateRefuse { cause: _ } => true  _ => false }
}

// TWO CREATES, TWO PASSWORDS: each mint draws /dev/urandom afresh and is a well-formed env flag.
test fn two_mints_differ_and_each_names_pool_api_key() -> Bool {
  let a = mint_flex_pool_password() as String
  let b = mint_flex_pool_password() as String
  (a != b) && a.contains("-e POOL_API_KEY=") && b.contains("-e POOL_API_KEY=")
}
