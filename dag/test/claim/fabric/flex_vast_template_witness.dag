module test.claim.fabric.flex_vast_template_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, List, Bool, Int, String, Secret }
import std.optional { Present, Absent }
import std.render_repeat_string_bootstrap { repeat_string }
import extdeps.cloud.vast_ai { VastAiTemplateRow }
import product.fabric.flex_vast_template {
  FlexTemplateSpec, FlexTemplateNoop, FlexTemplateApply, FlexTemplateRefuse,
  flex_vast_template_spec, flex_template_env, flex_template_decide, flex_template_forbidden_env_names,
  flex_template_env_forbidden_name, flex_template_retired_hash,
  flex_vast_template_env_standing, flex_vast_template_env_max_chars, FlexTemplateEnvOverBound, FlexTemplateEnvWithinBound,
  flex_vast_create_env_observed_accepted, flex_vast_create_env_cap, FlexCreateEnvCapUnknown,
  flex_vast_rent_launch, FlexRentLaunchBuilt, FlexRentLaunchRefused, FlexSshLaunch, FlexArgsLaunch, flex_launch_runtype_wire, flex_launch_args, flex_launch_onstart, flex_vast_args_launch,
}
import product.fabric.flex_vast_loop { mint_flex_create_env }
import product.fabric.flex_serving_image { flex_lil_serving_image, flex_serving_image_reference, flex_serving_onstart }
import product.fabric.flex_vast_shadow { flex_serving_recipe, flex_host_image }
import product.fabric.flex_vast_template_control {
  FlexTemplateListed, FlexTemplateEnsured, FlexTemplateNotEnsured, flex_template_outcome,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Supplied rows as the Vast template list answers them (VastAiTemplateRow); the producer of the real
// answer is the srv1 ensure's readback receipt, not this file.
fn row(hash: String, env: String) -> VastAiTemplateRow {
  VastAiTemplateRow {
    id: 1,
    name: flex_vast_template_spec.name as String,
    image: flex_vast_template_spec.image as String,
    hash_id: Present { value: hash },
    env: Present { value: env },
  }
}

fn any_forbidden(env: String) -> Bool {
  match flex_template_env_forbidden_name(env: env) { Present { value: _ } => true  Absent => false }
}

// The declared template's env carries none of the retired template's credential names.
test fn the_declared_template_env_carries_no_credential_name() -> Bool {
  (list_length(flex_template_forbidden_env_names) == 4)
    && !any_forbidden(env: flex_template_env(spec: flex_vast_template_spec))
    && !(flex_launch_onstart(launch: flex_vast_template_spec.launch).contains("R2_"))
    && any_forbidden(env: "-e PORT=18000 -e POOL_API_KEY=x")
    && any_forbidden(env: "-e R2_ACCESS_KEY_ID=x")
}

test fn the_declared_env_is_the_port_and_container_flags_only() -> Bool {
  flex_template_env(spec: flex_vast_template_spec) == "-p 18000:18000 --shm-size 80g --ipc host -e PORT=18000"
}

test fn no_named_row_applies_and_a_matching_row_is_a_noop() -> Bool {
  let env = flex_template_env(spec: flex_vast_template_spec)
  match flex_template_decide(spec: flex_vast_template_spec, named: []) { FlexTemplateApply => true  _ => false }
    && match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "abc", env: env)]) { FlexTemplateNoop { hash: h } => h == "abc"  _ => false }
}

test fn a_credential_bearing_readback_is_refused_not_adopted() -> Bool {
  match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "abc", env: "-e PORT=18000 -e POOL_API_KEY=x")]) {
    FlexTemplateRefuse { cause: _ } => true
    _ => false
  }
}

test fn the_retired_hash_is_never_adopted_and_differing_content_is_not_edited() -> Bool {
  let env = flex_template_env(spec: flex_vast_template_spec)
  match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: flex_template_retired_hash as String, env: env)]) { FlexTemplateRefuse { cause: _ } => true  _ => false }
    && match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "abc", env: "-e PORT=8000")]) { FlexTemplateRefuse { cause: _ } => true  _ => false }
    && match flex_template_decide(spec: flex_vast_template_spec, named: [row(hash: "a", env: env), row(hash: "b", env: env)]) { FlexTemplateRefuse { cause: _ } => true  _ => false }
}

// TWO CREATES, TWO PASSWORDS: each mint draws /dev/urandom afresh, keeps the launch env, and names POOL_API_KEY.
test fn two_mints_differ_and_each_carries_the_launch_and_names_pool_api_key() -> Bool {
  match flex_vast_rent_launch(spec: flex_vast_template_spec) {
    FlexRentLaunchRefused { cause: _ } => false
    FlexRentLaunchBuilt { launch: l } =>
      let a = mint_flex_create_env(launch: l) as String
      let b = mint_flex_create_env(launch: l) as String
      (a != b) && a.contains("-e POOL_API_KEY=") && b.contains("-e POOL_API_KEY=") && a.contains("-e ONSTART_B64=") && a.contains(l.env)
  }
}

// THE LAUNCH SHAPE: runtype args, [bash, -c, <decode ONSTART_B64, run, exec sleep infinity>], stored onstart ''.
test fn the_spec_is_the_args_launch_with_an_empty_stored_onstart() -> Bool {
  (flex_launch_runtype_wire(launch: flex_vast_template_spec.launch) == "args")
    && (flex_launch_args(launch: flex_vast_template_spec.launch) == flex_vast_args_launch)
    && (list_length(flex_launch_args(launch: flex_vast_template_spec.launch)) == 3)
    && join(flex_launch_args(launch: flex_vast_template_spec.launch), " ").contains("ONSTART_B64")
    && join(flex_launch_args(launch: flex_vast_template_spec.launch), " ").contains("exec sleep infinity")
}

// A template env over Vast's 4096-char cap refuses; the declared env is within it; an ssh spec builds no
// per-rent launch.
test fn a_template_env_over_4096_chars_refuses() -> Bool {
  let over = join(["-e PORT=", repeat_string(s: "9", n: 4096)], "")
  (flex_vast_template_env_max_chars == 4096)
    && match flex_vast_template_env_standing(env: over) { FlexTemplateEnvOverBound { chars: _, max: m } => m == 4096  FlexTemplateEnvWithinBound { chars: _ } => false }
    && match flex_vast_template_env_standing(env: flex_template_env(spec: flex_vast_template_spec)) { FlexTemplateEnvWithinBound { chars: _ } => true  FlexTemplateEnvOverBound { chars: _, max: _ } => false }
}

test fn an_ssh_spec_builds_no_per_rent_launch() -> Bool {
  let ssh = FlexTemplateSpec {
    name: flex_vast_template_spec.name, image: flex_vast_template_spec.image, tag: flex_vast_template_spec.tag,
    launch: FlexSshLaunch { onstart: flex_lil_serving_image.onstart }, disk: flex_vast_template_spec.disk, port: flex_vast_template_spec.port,
    shm: flex_vast_template_spec.shm, ssh_direct: flex_vast_template_spec.ssh_direct,
    jup_direct: flex_vast_template_spec.jup_direct, use_jupyter_lab: flex_vast_template_spec.use_jupyter_lab,
    min_cuda_max_good: flex_vast_template_spec.min_cuda_max_good, min_cpu_ram: flex_vast_template_spec.min_cpu_ram,
    min_gpu_ram: flex_vast_template_spec.min_gpu_ram, min_inet_down: flex_vast_template_spec.min_inet_down,
    verified_only: flex_vast_template_spec.verified_only,
  }
  match flex_vast_rent_launch(spec: ssh) { FlexRentLaunchRefused { cause: _ } => true  FlexRentLaunchBuilt { launch: _ } => false }
}

// The run's verdict is a typed outcome: ensured only when the readback decides Noop AND the retired hash
// reads back as exactly one row. A missing or doubled retired row, or a credential-bearing readback, is
// not ensured (the exit is derived from this outcome, not from receipt text).
test fn the_outcome_is_ensured_only_with_a_clean_readback_and_one_retired_row() -> Bool {
  let env = flex_template_env(spec: flex_vast_template_spec)
  let good = FlexTemplateListed { rows: [row(hash: "abc", env: env)] }
  let one = FlexTemplateListed { rows: [row(hash: "old", env: "x")] }
  let empty = FlexTemplateListed { rows: [] }
  let dirty = FlexTemplateListed { rows: [row(hash: "abc", env: "-e POOL_API_KEY=x")] }
  match flex_template_outcome(spec: flex_vast_template_spec, after: good, retired: one) { FlexTemplateEnsured { hash: h } => h == "abc"  _ => false }
    && match flex_template_outcome(spec: flex_vast_template_spec, after: good, retired: empty) { FlexTemplateNotEnsured { reason: _ } => true  _ => false }
    && match flex_template_outcome(spec: flex_vast_template_spec, after: dirty, retired: one) { FlexTemplateNotEnsured { reason: _ } => true  _ => false }
}

// ONE IMAGE FACT, TWO VAST READINGS. The Vast template and the Vast host-image row both derive from
// product.fabric.flex_serving_image, and each still equals what the operator-account read of the Vast
// template returned on 2026-10-18 (the image field "repository@sha256", the digest in tag, port 18000,
// shm 80g). The literals are that read, not a copy of the carrier, so editing the carrier reds this.
test fn the_vast_realization_reads_the_one_serving_image() -> Bool {
  ((flex_vast_template_spec.image as String) == "ghcr.io/local-inference-lab/vllm@sha256")
    && ((flex_vast_template_spec.tag as String) == "751ee72beb242b163e1124b2e0b825a509e20bacaf1423f467d65f6b8b664bc7")
    && (flex_launch_onstart(launch: flex_vast_template_spec.launch) == "")
    && (flex_serving_onstart == flex_lil_serving_image.onstart)
    && ((flex_serving_image_reference(image: flex_lil_serving_image) as String) == "ghcr.io/local-inference-lab/vllm@sha256:751ee72beb242b163e1124b2e0b825a509e20bacaf1423f467d65f6b8b664bc7")
    && (match flex_host_image(recipe: flex_serving_recipe) {
          Present { value: i } => (i as String) == (flex_serving_image_reference(image: flex_lil_serving_image) as String)
          Absent => false
        })
}

// The create env's cap is unknown with a read obligation; the one observation is a receipt, and it is above
// the template bound, so the template bound is not applied to the create env.
test fn the_create_env_cap_is_unknown_and_the_observed_acceptance_is_above_the_template_bound() -> Bool {
  (match flex_vast_create_env_cap { FlexCreateEnvCapUnknown { read_obligation: _ } => true  _ => false })
    && (flex_vast_create_env_observed_accepted.env_chars > flex_vast_template_env_max_chars)
    && (flex_vast_create_env_observed_accepted.instance_id == 57968351)
}
