module test.claim.fabric.fabric_ci_program_witness_test

import std.types { Bool }
import gunbc.fabric_ci_program { fabric_ci_gates }

test fn fabric_ci_program_declares_the_closed_gate_chain_without_a_status_axis() -> Bool {
  let gates = fabric_ci_gates()
  gates.length() == 7
    && any(gates, g => g.id == "FCI-0")
    && any(gates, g => g.id == "FCI-6")
    && all(gates, g => g.exit_predicate != "" && g.positive_control != "")
}
