module test.claim.fabric_grant_issuance_witness

import std.types { NonEmptyStr, Bool, Int, List }
import std.measure { Count, One, MoneyRate, money_amount_micro, hardware_thread_count, second }
import std.nat { Nat }
import std.content_hash { content_hash_of_value }
import extdeps.currency.currency { Usd }
import extdeps.accounting.budget { Appropriation }
import extdeps.accounting.encumbrance { EncumbranceLedger }
import product.fabric.identity { FabricIdentity, GrantKey }
import product.fabric.isolation { shared_kernel_sandbox_profile }
import product.fabric.envelope { unstated_envelope }
import product.fabric.work {
  Work, WorkContract, WorkStep, ReceiptSatisfiable, ExecutionRequirements,
  Shape, HardRequirements, CapacityClass, ControlPlaneCapacity, work_for,
}
import product.fabric.demand { ObservationReceiptRef }
import product.fabric.supply { SupplierOffer, QuotedPerSecond, ObservedSupply }
import product.fabric.execution {
  Attempt, InitialAttempt, ExecutionGrant, LeaseIdentity, FabricGrantEvidence,
}
import product.fabric.budget { MoneyAccount, MoneyReservationRequest }
import product.fabric.grant_issue {
  GrantIssue, GrantCommitted, GrantRefused, GrantIssueRefusal,
  AttemptNamesAnotherWork, OfferNotFungibleForWork, OfferCapacityExhausted,
  GrantAlreadyIssuedForAttempt, MoneyReservationRefused, ResourceReservationRefused,
  derive_grant_key, issue_grant,
}

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// FCI-2's acceptance evidence: selection, reservation and commitment yield EXACTLY ONE fenced
// ExecutionGrant for the exact Work.
//
// Every refusal test names the ARM it expects rather than asserting that something refused. A
// boolean "did it refuse" is satisfied by a work mismatch, an exhausted offer and a ledger
// ceiling alike, so a test written against it passes against an implementation that refuses for
// entirely the wrong reason -- which is the defect product.fabric.budget's witness file records
// having shipped once already.

data fixture_shape: Shape = Shape {
  hard: HardRequirements { threads: hardware_thread_count(8) },
  envelope: unstated_envelope(),
}

data fixture_requirements: ExecutionRequirements = ExecutionRequirements {
  capacity_class: ControlPlaneCapacity,
  shape: fixture_shape,
  capabilities: "linux-x86_64-cargo",
  trust_domain: "gunbc-ci",
  isolation: shared_kernel_sandbox_profile(),
}

data fixture_contract: WorkContract = WorkContract {
  program: "gunbc.required-witnesses-build.program:1",
  steps: [WorkStep { step_id: "required-witnesses-build", resumability: ReceiptSatisfiable }],
  source: "source:1",
  inputs: "inputs:1",
  runtime_closure: "runtime:1",
  effect_contract: "effects:1",
  output_contract: "outputs:1",
}

data subject_work: Work<NonEmptyStr> =
  work_for(principal: "gunbc", contract: fixture_contract, requirements: fixture_requirements)

data other_contract: WorkContract = WorkContract {
  program: "gunbc.required-witnesses-build.program:2",
  steps: [WorkStep { step_id: "required-witnesses-build", resumability: ReceiptSatisfiable }],
  source: "source:2",
  inputs: "inputs:1",
  runtime_closure: "runtime:1",
  effect_contract: "effects:1",
  output_contract: "outputs:1",
}

data other_work: Work<NonEmptyStr> =
  work_for(principal: "gunbc", contract: other_contract, requirements: fixture_requirements)

// Same contract, DIFFERENT principal. FabricIdentity equality is over the pair, so this work is
// not the subject work even though the derived key half is identical -- the cross-tenant case.
data foreign_work: Work<NonEmptyStr> =
  work_for(principal: "other-tenant", contract: fixture_contract, requirements: fixture_requirements)

data first_attempt: Attempt<NonEmptyStr> = Attempt {
  id: FabricIdentity { principal: "gunbc", key: "attempt-1" },
  work: subject_work.id,
  lineage: InitialAttempt { initiating_demand: FabricIdentity { principal: "gunbc", key: "demand-1" } },
  created_at: "2026-09-04T00:00:00Z",
}

data second_attempt: Attempt<NonEmptyStr> = Attempt {
  id: FabricIdentity { principal: "gunbc", key: "attempt-2" },
  work: subject_work.id,
  lineage: InitialAttempt { initiating_demand: FabricIdentity { principal: "gunbc", key: "demand-1" } },
  created_at: "2026-09-04T00:05:00Z",
}

data misdirected_attempt: Attempt<NonEmptyStr> = Attempt {
  id: FabricIdentity { principal: "gunbc", key: "attempt-3" },
  work: other_work.id,
  lineage: InitialAttempt { initiating_demand: FabricIdentity { principal: "gunbc", key: "demand-1" } },
  created_at: "2026-09-04T00:06:00Z",
}

data foreign_attempt: Attempt<NonEmptyStr> = Attempt {
  id: FabricIdentity { principal: "other-tenant", key: "attempt-1" },
  work: foreign_work.id,
  lineage: InitialAttempt { initiating_demand: FabricIdentity { principal: "other-tenant", key: "demand-1" } },
  created_at: "2026-09-04T00:07:00Z",
}

data admitted_offer: SupplierOffer<NonEmptyStr> = SupplierOffer {
  id: FabricIdentity { principal: "supplier", key: "offer-1" },
  executor: "srv3",
  shape: fixture_shape,
  capabilities: "linux-x86_64-cargo",
  trust_domain: "gunbc-ci",
  isolation: shared_kernel_sandbox_profile(),
  quantity_bound: 1,
  ready_at: "2026-09-04T00:00:00Z",
  quote: QuotedPerSecond(MoneyRate { amount: money_amount_micro(count: 100), currency: Usd }),
  billing_quantum: second(count: 1),
  evidence: ObservedSupply { observed_at: "2026-09-04T00:00:00Z", receipt: "supply-observation-1" },
}

data foreign_domain_offer: SupplierOffer<NonEmptyStr> = SupplierOffer {
  id: FabricIdentity { principal: "supplier", key: "offer-2" },
  executor: "srv4",
  shape: fixture_shape,
  capabilities: "linux-x86_64-cargo",
  trust_domain: "public-untrusted",
  isolation: shared_kernel_sandbox_profile(),
  quantity_bound: 4,
  ready_at: "2026-09-04T00:00:00Z",
  quote: QuotedPerSecond(MoneyRate { amount: money_amount_micro(count: 100), currency: Usd }),
  billing_quantum: second(count: 1),
  evidence: ObservedSupply { observed_at: "2026-09-04T00:00:00Z", receipt: "supply-observation-1" },
}

data funded_account: MoneyAccount = MoneyAccount {
  account: "fleet-ci",
  currency: Usd,
  ledger: EncumbranceLedger {
    appropriation: Appropriation { ceiling: money_amount_micro(count: 1000000) },
    entries: [],
  },
  leases: [],
}

data exhausted_account: MoneyAccount = MoneyAccount {
  account: "fleet-ci",
  currency: Usd,
  ledger: EncumbranceLedger {
    appropriation: Appropriation { ceiling: money_amount_micro(count: 1) },
    entries: [],
  },
  leases: [],
}

data money_request: MoneyReservationRequest = MoneyReservationRequest {
  reference: "reservation-money-1",
  generation: 9,
  maximum_liability: money_amount_micro(count: 1000),
  currency: Usd,
}

data thread_appropriation: EncumbranceLedger<Count, One> = EncumbranceLedger {
  appropriation: Appropriation { ceiling: hardware_thread_count(64) },
  entries: [],
}

data exhausted_threads: EncumbranceLedger<Count, One> = EncumbranceLedger {
  appropriation: Appropriation { ceiling: hardware_thread_count(1) },
  entries: [],
}

data fixture_lease: LeaseIdentity = LeaseIdentity {
  lease_key: "lease-attempt-1",
  resource_fingerprint: content_hash_of_value(value: "srv3-slot-7"),
  generation: 9,
}

data fixture_evidence: FabricGrantEvidence = FabricGrantEvidence {
  fungibility_receipt: "fungibility-1",
  offer_authority: "offer-authority-1",
  resource_conservation: "resource-conservation-1",
  budget_conservation: "budget-conservation-1",
  principal_authority: "principal-authority-1",
}

fn issue(
  work: Work<NonEmptyStr>,
  attempt: Attempt<NonEmptyStr>,
  offer: SupplierOffer<NonEmptyStr>,
  outstanding: List<ExecutionGrant<NonEmptyStr>>,
  account: MoneyAccount,
  ledger: EncumbranceLedger<Count, One>,
) -> GrantIssue<NonEmptyStr, Count, One> {
  issue_grant(
    work: work,
    attempt: attempt,
    offer: offer,
    outstanding: outstanding,
    account: account,
    money_request: money_request,
    ledger: ledger,
    resource_reference: "reservation-threads-1",
    resource_liability: hardware_thread_count(8),
    lease: fixture_lease,
    demand: FabricIdentity { principal: "gunbc", key: "demand-1" },
    evidence: fixture_evidence,
    issued_at: "2026-09-04T00:10:00Z",
    maximum_liability: money_amount_micro(count: 1000),
  )
}

fn outcome_label(o: GrantIssue<NonEmptyStr, Count, One>) -> NonEmptyStr {
  match o {
    GrantCommitted { grant: _, account: _, ledger: _ } => "committed"
    GrantRefused { refusal: r } =>
      match r {
        AttemptNamesAnotherWork { attempt_work: _, subject_work: _ } => "attempt-names-another-work"
        OfferNotFungibleForWork { fungibility: _ } => "offer-not-fungible"
        OfferCapacityExhausted { offer: _, quantity_bound: _, grants_outstanding: _ } => "offer-capacity-exhausted"
        GrantAlreadyIssuedForAttempt { existing: _ } => "grant-already-issued"
        MoneyReservationRefused { refusal: _ } => "money-refused"
        ResourceReservationRefused { refusal: _ } => "resource-refused"
      }
  }
}

fn committed_grants(o: GrantIssue<NonEmptyStr, Count, One>) -> List<ExecutionGrant<NonEmptyStr>> {
  match o {
    GrantCommitted { grant: g, account: _, ledger: _ } => [g]
    GrantRefused { refusal: _ } => []
  }
}

// The positive control. One admitted offer yields one committed grant.
test fn one_admitted_offer_yields_one_committed_grant() -> Bool {
  outcome_label(o: issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  )) == "committed"
}

// The grant a committed issuance produces names the exact subject Work and the exact attempt, and
// its principal is the WORK's. Asserting "committed" alone would pass against an issuer that
// grants the wrong thing.
test fn the_committed_grant_names_the_exact_work_and_attempt() -> Bool {
  committed_grants(o: issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  )) |> all(g =>
    g.context.work.key == subject_work.id.key
      && g.context.work.principal == "gunbc"
      && g.id.principal == "gunbc"
      && g.context.attempt.key == "attempt-1"
  )
}

// DUPLICATE-GRANT. A second issuance for one attempt is refused by that name.
test fn a_second_grant_for_one_attempt_is_refused() -> Bool {
  let first = committed_grants(o: issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  ))
  outcome_label(o: issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: first,
    account: funded_account,
    ledger: thread_appropriation,
  )) == "grant-already-issued"
}

// WORK-MISMATCH. An attempt that names another Work cannot be authorized under this one.
test fn an_attempt_naming_another_work_is_refused() -> Bool {
  outcome_label(o: issue(
    work: subject_work,
    attempt: misdirected_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  )) == "attempt-names-another-work"
}

// The cross-tenant reading of the same wall. The foreign attempt's work key is byte-identical to
// the subject's -- same contract, same requirements -- and only the principal half differs, so a
// comparison on the key alone admits it.
test fn an_attempt_under_another_principal_is_refused() -> Bool {
  foreign_work.id.key == subject_work.id.key
    && outcome_label(o: issue(
      work: subject_work,
      attempt: foreign_attempt,
      offer: admitted_offer,
      outstanding: [],
      account: funded_account,
      ledger: thread_appropriation,
    )) == "attempt-names-another-work"
}

// Selection precedes reservation: an offer that cannot run the work is refused for that reason,
// not for a downstream one, and nothing is reserved on the way.
test fn an_offer_outside_the_trust_domain_is_refused_before_any_reservation() -> Bool {
  outcome_label(o: issue(
    work: subject_work,
    attempt: first_attempt,
    offer: foreign_domain_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  )) == "offer-not-fungible"
}

// Supply conservation. The offer's bound is 1, so a second attempt against it is refused even
// though that attempt has no grant of its own.
test fn a_second_attempt_against_a_single_bound_offer_is_refused() -> Bool {
  let first = committed_grants(o: issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: thread_appropriation,
  ))
  outcome_label(o: issue(
    work: subject_work,
    attempt: second_attempt,
    offer: admitted_offer,
    outstanding: first,
    account: funded_account,
    ledger: thread_appropriation,
  )) == "offer-capacity-exhausted"
}

// THE ATOMIC JOIN, MONEY SIDE. The budget ledger refuses; no grant exists and therefore no
// resource reservation was committed under one.
test fn a_refused_budget_yields_no_grant() -> Bool {
  let o = issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: exhausted_account,
    ledger: thread_appropriation,
  )
  outcome_label(o: o) == "money-refused" && committed_grants(o: o).length() == 0
}

// THE ATOMIC JOIN, RESOURCE SIDE. This is the arm the model calls unreachable only if the join is
// atomic: the budget ledger ADMITS and the resource ledger refuses. The advanced account is a
// component of the committed arm alone, so it reaches no caller -- there is no partial state to
// compensate for, because the refusal carries no advanced ledger at all.
test fn a_budget_that_admitted_beside_a_refused_resource_yields_no_grant() -> Bool {
  let o = issue(
    work: subject_work,
    attempt: first_attempt,
    offer: admitted_offer,
    outstanding: [],
    account: funded_account,
    ledger: exhausted_threads,
  )
  outcome_label(o: o) == "resource-refused" && committed_grants(o: o).length() == 0
}

// The key is DERIVED, so identical coordinates yield one key and a changed attempt yields another.
// Without the second half the first passes against a derivation that ignores every input.
test fn identical_coordinates_derive_one_grant_key() -> Bool {
  derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: admitted_offer.id,
    lease: fixture_lease,
  ) == derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: admitted_offer.id,
    lease: fixture_lease,
  )
}

test fn a_different_attempt_derives_a_different_grant_key() -> Bool {
  derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: admitted_offer.id,
    lease: fixture_lease,
  ) != derive_grant_key(
    work: subject_work.id,
    attempt: second_attempt.id,
    offer: admitted_offer.id,
    lease: fixture_lease,
  )
}

test fn a_different_offer_derives_a_different_grant_key() -> Bool {
  derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: admitted_offer.id,
    lease: fixture_lease,
  ) != derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: foreign_domain_offer.id,
    lease: fixture_lease,
  )
}

// The lease participates, so two grants over one work, attempt and offer under different leases
// are two authorizations rather than one presented twice.
test fn a_different_lease_derives_a_different_grant_key() -> Bool {
  derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: admitted_offer.id,
    lease: fixture_lease,
  ) != derive_grant_key(
    work: subject_work.id,
    attempt: first_attempt.id,
    offer: admitted_offer.id,
    lease: LeaseIdentity {
      lease_key: "lease-attempt-1-regenerated",
      resource_fingerprint: content_hash_of_value(value: "srv3-slot-7"),
      generation: 10,
    },
  )
}
