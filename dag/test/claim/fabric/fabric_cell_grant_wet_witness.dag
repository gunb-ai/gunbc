module test.claim.fabric.fabric_cell_grant_wet_witness

import extdeps.shell
import std.types { Bool, NonEmptyStr, String, List }
import std.algebra { Cons, Empty }
import std.measure { Count, One, hardware_thread_count }
import std.durable_compare_and_set { cas_generation_count }
import std.durable_exclusive_hold { DurableHoldOwnerRef, DurableHoldReleaseRef, HoldSlotAbsent }
import gunbc.durable_exclusive_hold_file_store {
  FileHoldReleasePlanned, FileHoldReleaseNotEligible, FileHoldReleased,
  file_hold_release_assess, file_hold_release_commit, observe_file_hold,
}
import product.fabric.execution { Attempt, ExecutionGrant }
import product.fabric.selection { SelectedOffer }
import product.fabric.grant_issue { AttemptNamesAnotherWork }
import gunbc.fabric.fabric_cell_grant {
  CellGrant, CellGranted, CellAlreadyGranted, CellGrantIssueRefused,
  CellGrantStanding, CellGrantLive, CellGrantReleased, CellGrantSuperseded, CellGrantNeverCommitted,
  grant_selected_cell, cell_grant_standing,
  CellGrantReread, CellGrantReadLive, CellGrantReadAbsent, CellGrantReadReleased, CellGrantReadForeign, reread_cell_grant,
}
import test.claim.fabric.fabric_grant_issuance_witness {
  subject_work, first_attempt, second_attempt, misdirected_attempt, admitted_offer,
  funded_account, money_request, thread_appropriation, fixture_evidence,
  subject_demand, selected_for, issue, committed_grants,
}

// FCI-2 BY REAL EXECUTION: selection, reservation and commitment yield exactly one fenced grant for
// the exact Work, durably. The issuance kernel's pure witness
// (test.claim.fabric.fabric_grant_issuance_witness) supplies the fixtures; this file reaches a
// throwaway temp directory, because "one grant per cell", "the lease names the hold" and "an
// expired reservation authorizes nothing" are facts about the compare-and-set store and only
// running the write establishes them.
//
// The three mutations FCI-2 names are each a red here: duplicate-grant (a second attempt against
// the held cell), expired-reservation (a released, and then a superseded, grant), work-mismatch
// (an attempt naming another Work writes nothing).

fn cg_fresh_root() -> String {
  shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_cell_grant.XXXXXX").path
}

fn cg_grant(root: NonEmptyStr, attempt: Attempt<NonEmptyStr>) -> List<CellGrant<Count, One>> {
  map(selected_for(offer: admitted_offer), selected => grant_selected_cell(
    root: root,
    work: subject_work,
    attempt: attempt,
    selected: selected,
    account: funded_account,
    money_request: money_request,
    ledger: thread_appropriation,
    resource_liability: hardware_thread_count(8),
    demand: subject_demand(),
    evidence: fixture_evidence,
    issued_at: "2026-10-14T00:00:00Z",
  ))
}

fn cg_granted(outcomes: List<CellGrant<Count, One>>) -> List<ExecutionGrant<NonEmptyStr>> {
  match outcomes {
    Cons { head: CellGranted { grant: g, account: _, ledger: _ }, tail: _ } => [g]
    _ => []
  }
}

fn cg_is_live(root: NonEmptyStr, grants: List<ExecutionGrant<NonEmptyStr>>) -> Bool {
  match grants {
    Cons { head: g, tail: _ } => match cell_grant_standing(root: root, grant: g) {
      CellGrantLive => true
      _ => false
    }
    Empty {} => false
  }
}

fn cg_release(root: NonEmptyStr, grants: List<ExecutionGrant<NonEmptyStr>>) -> Bool {
  match grants {
    Cons { head: g, tail: _ } =>
      match file_hold_release_assess(
        root: root,
        slot_key: admitted_offer.executor,
        owner: (g.id.key as String) as DurableHoldOwnerRef,
        acquired_generation: g.context.lease.generation,
        released_by: "witness-release" as DurableHoldReleaseRef,
      ) {
        FileHoldReleasePlanned { plan: p } => match file_hold_release_commit(plan: p) {
          FileHoldReleased { slot_key: _, generation: _ } => true
          _ => false
        }
        FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => false
      }
    Empty {} => false
  }
}

test fn one_selected_offer_yields_one_live_cell_grant_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let grants = cg_granted(outcomes: cg_grant(root: root, attempt: first_attempt))
  let live = cg_is_live(root: root, grants: grants)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  let shaped = match grants {
    Cons { head: g, tail: _ } =>
      g.context.lease.generation == 1
        && (g.context.lease.lease_key as String) == (admitted_offer.executor as String)
        && (g.context.work.key as String) == (subject_work.id.key as String)
        && (g.context.attempt.key as String) == (first_attempt.id.key as String)
    Empty {} => false
  }
  live && shaped && removed.success
}

// DUPLICATE-GRANT. The second attempt reaches issuance with an empty roster, exactly as the first
// did; what refuses it is the held slot, and the holder it reports is the first grant's key.
test fn a_second_grant_against_a_held_cell_refuses_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let first = cg_granted(outcomes: cg_grant(root: root, attempt: first_attempt))
  let second = cg_grant(root: root, attempt: second_attempt)
  let still_live = cg_is_live(root: root, grants: first)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  let refused_by_first = match first {
    Cons { head: g, tail: _ } => match second {
      Cons { head: CellAlreadyGranted { slot_key: _, holder: h, generation: gen }, tail: _ } =>
        (h as String) == (g.id.key as String) && cas_generation_count(g: gen) == 1
      _ => false
    }
    Empty {} => false
  }
  refused_by_first && still_live && removed.success
}

// EXPIRED-RESERVATION. Once the cell's hold is released the grant authorizes nothing; once another
// attempt is granted the same cell, the first grant is superseded and only the second is live.
test fn a_released_then_superseded_grant_is_not_live_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let first = cg_granted(outcomes: cg_grant(root: root, attempt: first_attempt))
  let released = cg_release(root: root, grants: first)
  let after_release = match first {
    Cons { head: g, tail: _ } => match cell_grant_standing(root: root, grant: g) {
      CellGrantReleased { generation: gen, released_by: _ } => cas_generation_count(g: gen) == 2
      _ => false
    }
    Empty {} => false
  }
  let second = cg_granted(outcomes: cg_grant(root: root, attempt: second_attempt))
  let after_regrant = match first {
    Cons { head: g, tail: _ } => match cell_grant_standing(root: root, grant: g) {
      CellGrantSuperseded { holder: _, generation: gen } => cas_generation_count(g: gen) == 3
      _ => false
    }
    Empty {} => false
  }
  let second_live = cg_is_live(root: root, grants: second)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  released && after_release && after_regrant && second_live && removed.success
}

// WORK-MISMATCH. Issuance refuses before the write, so the cell is never touched.
test fn an_attempt_for_another_work_writes_nothing_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let outcome = cg_grant(root: root, attempt: misdirected_attempt)
  let untouched = match observe_file_hold(root: root, key: admitted_offer.executor) {
    HoldSlotAbsent => true
    _ => false
  }
  let removed = shell.Remove.RecursiveForce(path: root_path)
  let refused = match outcome {
    Cons { head: CellGrantIssueRefused { slot_key: _, refusal: AttemptNamesAnotherWork { attempt_work: _, subject_work: _ } }, tail: _ } => true
    _ => false
  }
  refused && untouched && removed.success
}

// A grant issued by the pure kernel outside this transition was never committed to any cell, so
// the re-read refuses it even though it is well formed.
test fn a_grant_issued_outside_the_cell_transition_is_never_committed_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let standing = match issue(work: subject_work, attempt: first_attempt, offer: admitted_offer, outstanding: [], account: funded_account, ledger: thread_appropriation) {
    Cons { head: o, tail: _ } => match committed_grants(o: o) {
      Cons { head: g, tail: _ } => match cell_grant_standing(root: root, grant: g) {
        CellGrantNeverCommitted => true
        _ => false
      }
      Empty {} => false
    }
    Empty {} => false
  }
  let removed = shell.Remove.RecursiveForce(path: root_path)
  standing && removed.success
}

// FCI-3'S RE-READ, BY COORDINATES. The executor re-derives the grant key; the four mutations FCI-3
// names each read as not live.
fn cg_reread(root: NonEmptyStr, attempt: Attempt<NonEmptyStr>) -> CellGrantReread {
  reread_cell_grant(root: root, slot_key: admitted_offer.executor, work: subject_work.id, attempt: attempt.id, offer: admitted_offer.id)
}

test fn the_executor_reread_finds_the_live_grant_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let grants = cg_granted(outcomes: cg_grant(root: root, attempt: first_attempt))
  let read = cg_reread(root: root, attempt: first_attempt)
  let removed = shell.Remove.RecursiveForce(path: root_path)
  let live = match grants {
    Cons { head: g, tail: _ } => match read {
      CellGrantReadLive { generation: gen, grant: k } => (k as String) == (g.id.key as String) && cas_generation_count(g: gen) == 1
      _ => false
    }
    Empty {} => false
  }
  live && removed.success
}

test fn the_executor_reread_refuses_absent_removed_foreign_and_expired_by_real_execution() -> Bool {
  let root_path = cg_fresh_root()
  let root = root_path as NonEmptyStr
  let absent = match cg_reread(root: root, attempt: first_attempt) { CellGrantReadAbsent => true  _ => false }
  let first = cg_granted(outcomes: cg_grant(root: root, attempt: first_attempt))
  let foreign = match cg_reread(root: root, attempt: second_attempt) { CellGrantReadForeign { holder: _, generation: _ } => true  _ => false }
  let released = cg_release(root: root, grants: first)
  let removed_grant = match cg_reread(root: root, attempt: first_attempt) { CellGrantReadReleased { generation: _, released_by: _ } => true  _ => false }
  let second = cg_granted(outcomes: cg_grant(root: root, attempt: second_attempt))
  let expired = match cg_reread(root: root, attempt: first_attempt) {
    CellGrantReadForeign { holder: _, generation: gen } => cas_generation_count(g: gen) == 3
    _ => false
  }
  let second_live = match cg_reread(root: root, attempt: second_attempt) { CellGrantReadLive { generation: _, grant: _ } => true  _ => false }
  let removed = shell.Remove.RecursiveForce(path: root_path)
  absent && foreign && released && removed_grant && expired && second_live && removed.success
}
