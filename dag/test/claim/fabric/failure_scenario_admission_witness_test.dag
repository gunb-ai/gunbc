module test.claim.fabric.failure_scenario_admission_witness

import std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, String, Int, List, EpochSecs }
import std.decl_ref { DeclarationRef, decl_ref }
import std.measure { MoneyRate, money_amount_micro, second, hardware_thread_count, HardwareThreadCount }
import extdeps.currency.currency { Usd }
import product.fabric.identity { FabricIdentity, OfferKey, WorkKey, DemandKey }
import product.fabric.work {
  Shape, HardRequirements, ExecutionRequirements, CapabilityManifestRef, TrustDomainRef,
  ControlPlaneCapacity,
}
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { IsolationProfile }
import std.content_hash { ContentHash, as_content_hash_structural, content_hash_atom }
import product.fabric.provider_route {
  ProviderRoute, ProviderRouteFacts, CompliancePostureRevision,
  ProviderDataPathClosure, ProviderPathStanding, ProviderPathLocated, ProviderPathAbsent,
  PermittedJurisdictionPopulation, PermittedJurisdictionsEnumerated,
  DownstreamProviderPopulation, NoDownstreamProviders,
}
import product.fabric.provider_admission {
  RouteScopeSanction, ProviderUseScope, DispositionStanding, DispositionCleared,
}
import product.fabric.offer_route { OfferRouteRow }
import product.fabric.route_readiness { RequireExercisedRoute, ExerciseOfRoute }
import product.fabric.capacity_admission {
  AdmittedCapacity, CapacityAdmission, CapacityAdmittedForOrdinaryWork,
  RouteExercisePlacementAdmitted, CapacityRefused, admit_capacity,
}
import product.fabric.supply { SupplierOffer, QuotedPerHour, ObservedSupply, UnobservedSupply }
import product.fabric.route_readiness { RouteExercise }
import product.fabric.failure_scenario_admission {
  OfferFailureDomains, FailureScenario, CommittedDemand,
  FailureScenarioAdmission, FailureScenariosSurvived, FailureScenariosRefused, CoveredSubject,
  FailureScenarioRefusal, NoFailureScenariosDeclared, OfferFailureDomainsUndeclared,
  OfferFailureDomainsAmbiguous, OfferSharedAcrossDemands, ScenarioNotSurvived,
  ScenarioNamesUnknownOffer, CapacityListedTwiceForOneSubject,
  admit_failure_scenarios,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS ONE SMALL PORTFOLIO, and every name, count and domain in it is this witness's
// declared input rather than a reading of any real fleet or vendor. Two owned nodes on two circuits
// at one site, one exercised external route, and one external route with a larger quota that nobody
// has exercised. Demand is 15 grants with a margin of 5, so 20 must survive every scenario.

data fsa_module: NonEmptyStr = "test.claim.fabric.failure_scenario_admission_witness"
data fsa_owned_provider: NonEmptyStr = "fsa-owned-provider"
data fsa_owned_site: NonEmptyStr = "fsa-owned-site"
data fsa_circuit_a: NonEmptyStr = "fsa-circuit-a"
data fsa_circuit_b: NonEmptyStr = "fsa-circuit-b"
data fsa_node_1: NonEmptyStr = "fsa-node-1"
data fsa_node_2: NonEmptyStr = "fsa-node-2"
data fsa_cloud_x_provider: NonEmptyStr = "fsa-cloud-x-provider"
data fsa_cloud_x_region: NonEmptyStr = "fsa-cloud-x-region"
data fsa_cloud_y_provider: NonEmptyStr = "fsa-cloud-y-provider"
data fsa_cloud_y_region: NonEmptyStr = "fsa-cloud-y-region"
data fsa_service: NonEmptyStr = "fsa-service"
data fsa_exercise_receipt: NonEmptyStr = "fsa-exercise-receipt"
data fsa_planned_fleet_obligation: NonEmptyStr = "fsa-planned-fleet-obligation"
data fsa_scenario_node: NonEmptyStr = "fsa-scenario-node"
data fsa_scenario_circuit: NonEmptyStr = "fsa-scenario-circuit"
data fsa_scenario_site: NonEmptyStr = "fsa-scenario-site"
data fsa_scenario_site_and_cloud_x: NonEmptyStr = "fsa-scenario-site-and-cloud-x"

fn r(name: String) -> DeclarationRef { decl_ref(module_path: fsa_module, decl_name: name) }

fn owned_route() -> ProviderRoute {
  ProviderRoute { provider: r(name: "fsa_owned_provider"), service: r(name: "fsa_service"), region: r(name: "fsa_owned_site") }
}
fn cloud_x_route() -> ProviderRoute {
  ProviderRoute { provider: r(name: "fsa_cloud_x_provider"), service: r(name: "fsa_service"), region: r(name: "fsa_cloud_x_region") }
}
fn cloud_y_route() -> ProviderRoute {
  ProviderRoute { provider: r(name: "fsa_cloud_y_provider"), service: r(name: "fsa_service"), region: r(name: "fsa_cloud_y_region") }
}

fn shape(threads: HardwareThreadCount) -> Shape {
  Shape { hard: HardRequirements { threads: threads }, envelope: unstated_envelope() }
}

fn caps() -> CapabilityManifestRef { "gunbc.capabilities.linux-rust-toolchain" }
fn trust() -> TrustDomainRef { "gunbc.trust.internal-fleet" }

fn requirements(caps: CapabilityManifestRef) -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: shape(threads: hardware_thread_count(count: 8)),
    capabilities: caps,
    trust_domain: trust(),
    isolation: IsolationProfile { guarantees: [] },
  }
}

fn offer(key: OfferKey, route: ProviderRoute, grants: Int) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    route: route,
    shape: shape(threads: hardware_thread_count(count: 16)),
    capabilities: caps(),
    trust_domain: trust(),
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: grants,
    ready_at: "2026-09-17T00:00:00Z",
    quote: QuotedPerHour(MoneyRate { amount: money_amount_micro(count: 0), currency: Usd }),
    billing_quantum: second(count: 0),
    evidence: ObservedSupply { observed_at: "2026-09-17T00:00:00Z", receipt: "fsa-supply-observation" },
  }
}

fn offers() -> List<SupplierOffer<NonEmptyStr>> {
  [
    offer(key: "owned-node-1", route: owned_route(), grants: 10),
    offer(key: "owned-node-2", route: owned_route(), grants: 10),
    offer(key: "cloud-x", route: cloud_x_route(), grants: 20),
    offer(key: "cloud-y", route: cloud_y_route(), grants: 50),
  ]
}

fn row(key: OfferKey, domains: List<DeclarationRef>) -> OfferFailureDomains<NonEmptyStr> {
  OfferFailureDomains { offer: FabricIdentity { principal: "gunbc", key: key }, domains: domains }
}

fn domains() -> List<OfferFailureDomains<NonEmptyStr>> {
  [
    row(key: "owned-node-1", domains: [r(name: "fsa_circuit_a"), r(name: "fsa_node_1")]),
    row(key: "owned-node-2", domains: [r(name: "fsa_circuit_b"), r(name: "fsa_node_2")]),
    row(key: "cloud-x", domains: []),
    row(key: "cloud-y", domains: []),
  ]
}

data now: EpochSecs = 1000

fn exercise(route: ProviderRoute) -> RouteExercise {
  RouteExercise { route: route, exercised_at: 900, valid_through: 2000, receipt: r(name: "fsa_exercise_receipt") }
}

// Cloud Y is deliberately absent: it is listed and has the largest quota, and it is not capacity.
fn exercises() -> List<RouteExercise> { [exercise(route: owned_route()), exercise(route: cloud_x_route())] }

fn demand(key: WorkKey) -> CommittedDemand<NonEmptyStr> {
  CommittedDemand {
    demand: FabricIdentity { principal: "gunbc", key: "fsa-demand" },
    work: FabricIdentity { principal: "gunbc", key: key },
    grants: 15,
    margin: 5,
  }
}

// A second customer's demand over the SAME work: same shape, different demand identity.
fn other_customer_demand(key: WorkKey) -> CommittedDemand<NonEmptyStr> {
  CommittedDemand {
    demand: FabricIdentity { principal: "gunbc", key: "fsa-other-demand" },
    work: FabricIdentity { principal: "gunbc", key: key },
    grants: 15,
    margin: 5,
  }
}



fn scenario(name: String, lost: List<DeclarationRef>) -> FailureScenario<NonEmptyStr> {
  FailureScenario { scenario: r(name: name), lost: lost, lost_offers: [] }
}

fn losing_offers(name: String, keys: List<OfferKey>) -> FailureScenario<NonEmptyStr> {
  FailureScenario {
    scenario: r(name: name),
    lost: [],
    lost_offers: map(keys, k => FabricIdentity { principal: "gunbc", key: k }),
  }
}

fn absorbed_scenarios() -> List<FailureScenario<NonEmptyStr>> {
  [
    scenario(name: "fsa_scenario_node", lost: [r(name: "fsa_node_1")]),
    scenario(name: "fsa_scenario_circuit", lost: [r(name: "fsa_circuit_b")]),
    scenario(name: "fsa_scenario_site", lost: [r(name: "fsa_owned_site")]),
  ]
}

fn site_and_cloud_x() -> FailureScenario<NonEmptyStr> {
  scenario(name: "fsa_scenario_site_and_cloud_x", lost: [r(name: "fsa_owned_site"), r(name: "fsa_cloud_x_provider")])
}

// THE SCREENS THE CAPACITY CARRIER RUNS, AS THIS WITNESS'S DECLARED INPUTS. They are here because the
// subject changed with the carrier: a capacity is admitted by product.fabric.capacity_admission, so
// these claims now exercise that real path rather than handing the fold a list it screened itself.
// Nothing below is a reading of any vendor: the paths, posture, jurisdiction and contract terms are
// this module's own rows, and their standing is "witness input".
data fsa_operator: NonEmptyStr = "fsa-operator"
data fsa_jurisdiction: NonEmptyStr = "fsa-jurisdiction"
data fsa_read_obligation: NonEmptyStr = "fsa-read-obligation"
data fsa_no_spill_path: NonEmptyStr = "fsa-no-spill-path"
data fsa_contract_terms: NonEmptyStr = "fsa-contract-terms"
data fsa_no_downstream: NonEmptyStr = "fsa-no-downstream"
data fsa_posture_authority: NonEmptyStr = "fsa-posture-authority"
data fsa_customer_profile: NonEmptyStr = "fsa-customer-profile"
data fsa_data_handling_profile: NonEmptyStr = "fsa-data-handling-profile"
data fsa_agreement: NonEmptyStr = "fsa-agreement"
data fsa_prohibited_use_cleared: NonEmptyStr = "fsa-prohibited-use-cleared"
data fsa_sanctions_cleared: NonEmptyStr = "fsa-sanctions-cleared"
data fsa_export_cleared: NonEmptyStr = "fsa-export-cleared"
data fsa_decision_receipt: NonEmptyStr = "fsa-decision-receipt"

fn hash(seed: String) -> ContentHash { as_content_hash_structural(structural: content_hash_atom(value: seed)) }

fn located() -> ProviderPathStanding {
  ProviderPathLocated {
    operator: r(name: "fsa_operator"),
    jurisdiction: r(name: "fsa_jurisdiction"),
    evidence: r(name: "fsa_read_obligation"),
  }
}

fn closure() -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: located(), durable_storage: located(), backups: located(), logs: located(),
    telemetry: located(), control_plane: located(), support_access: located(),
    administrative_access: located(),
    spill: ProviderPathAbsent { evidence: r(name: "fsa_no_spill_path") },
  }
}

fn facts(route: ProviderRoute) -> ProviderRouteFacts {
  ProviderRouteFacts {
    route: route,
    contract_terms: r(name: "fsa_contract_terms"),
    data_paths: closure(),
    downstream: NoDownstreamProviders { evidence: r(name: "fsa_no_downstream") },
    observed_at: "2026-09-17T00:00:00Z",
    facts_revision: hash(seed: "fsa-facts-r1"),
  }
}

fn posture() -> CompliancePostureRevision {
  CompliancePostureRevision {
    authority: r(name: "fsa_posture_authority"),
    revision: hash(seed: "fsa-posture-r1"),
    permitted_jurisdictions: PermittedJurisdictionsEnumerated { first: r(name: "fsa_jurisdiction"), further: [] },
    jurisdiction_drop_enrollments: [],
  }
}

fn sanction(route: ProviderRoute) -> RouteScopeSanction {
  RouteScopeSanction {
    route: route,
    posture: posture(),
    customer_profile: r(name: "fsa_customer_profile"),
    data_handling_profile: r(name: "fsa_data_handling_profile"),
    requires_agreement: r(name: "fsa_agreement"),
  }
}

fn cleared(ev: DeclarationRef) -> DispositionStanding { DispositionCleared { evidence: ev } }

fn scope(work: WorkKey) -> ProviderUseScope<NonEmptyStr> {
  scope_for(demand_key: "fsa-demand", work: work)
}

fn scope_for(demand_key: DemandKey, work: WorkKey) -> ProviderUseScope<NonEmptyStr> {
  ProviderUseScope {
    demand: FabricIdentity { principal: "gunbc", key: demand_key },
    work: FabricIdentity { principal: "gunbc", key: work },
    customer_profile: r(name: "fsa_customer_profile"),
    data_handling_profile: r(name: "fsa_data_handling_profile"),
    agreement: r(name: "fsa_agreement"),
    prohibited_use_disposition: cleared(ev: r(name: "fsa_prohibited_use_cleared")),
    sanctions_disposition: cleared(ev: r(name: "fsa_sanctions_cleared")),
    export_disposition: cleared(ev: r(name: "fsa_export_cleared")),
  }
}

fn route_rows(offers: List<SupplierOffer<NonEmptyStr>>) -> List<OfferRouteRow<NonEmptyStr>> {
  map(offers, o => OfferRouteRow { offer: o.id, facts: facts(route: o.route) })
}

fn sanctions() -> List<RouteScopeSanction> {
  [sanction(route: owned_route()), sanction(route: cloud_x_route()), sanction(route: cloud_y_route())]
}

// Capacity admitted for one work, through the real fold. An offer the screens refuse simply is not
// capacity, which is the point: this witness can no longer hand the scenario fold something the
// dispatch path would have rejected.
fn capacity_for(
  offers: List<SupplierOffer<NonEmptyStr>>,
  exercises: List<RouteExercise>,
  work: WorkKey,
  caps: CapabilityManifestRef,
) -> List<AdmittedCapacity<NonEmptyStr>> {
  flat_map(offers, o =>
    match admit_capacity(
      routes: route_rows(offers: offers),
      sanctions: sanctions(),
      active: posture(),
      scope: scope(work: work),
      decision_receipt: r(name: "fsa_decision_receipt"),
      exercises: exercises,
      readiness_requirement: RequireExercisedRoute,
      at: now,
      requirements: requirements(caps: caps),
      offer: o,
    ) {
      CapacityAdmittedForOrdinaryWork { capacity: c } => [c]
      RouteExercisePlacementAdmitted { placement: _ } => []
      CapacityRefused { refusal: _ } => []
    })
}

fn admit(
  offers: List<SupplierOffer<NonEmptyStr>>,
  domains: List<OfferFailureDomains<NonEmptyStr>>,
  exercises: List<RouteExercise>,
  demands: List<CommittedDemand<NonEmptyStr>>,
  scenarios: List<FailureScenario<NonEmptyStr>>,
) -> FailureScenarioAdmission<NonEmptyStr> {
  admit_failure_scenarios(
    capacities: flat_map(demands, d =>
      capacity_for(offers: offers, exercises: exercises, work: (d.work.key as WorkKey), caps: caps())),
    domains: domains,
    demands: demands,
    scenarios: scenarios,
  )
}

fn admit_with_capacity(
  capacities: List<AdmittedCapacity<NonEmptyStr>>,
  demands: List<CommittedDemand<NonEmptyStr>>,
  scenarios: List<FailureScenario<NonEmptyStr>>,
) -> FailureScenarioAdmission<NonEmptyStr> {
  admit_failure_scenarios(capacities: capacities, domains: domains(), demands: demands, scenarios: scenarios)
}

fn survived(a: FailureScenarioAdmission<NonEmptyStr>) -> Bool {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _, covered: _ } => true
    FailureScenariosRefused { refusals: _ } => false
  }
}

fn tag(x: FailureScenarioRefusal<NonEmptyStr>) -> String {
  match x {
    NoFailureScenariosDeclared => "no-scenarios"
    OfferFailureDomainsUndeclared { offer: o } => join(["undeclared:", (o.key as NonEmptyStr)], "")
    OfferFailureDomainsAmbiguous { offer: o } => join(["ambiguous:", (o.key as NonEmptyStr)], "")
    OfferSharedAcrossDemands { offer: o } => join(["shared:", (o.key as NonEmptyStr)], "")
    ScenarioNamesUnknownOffer { scenario: _, offer: o } => join(["unknown-offer:", (o.key as NonEmptyStr)], "")
    CapacityListedTwiceForOneSubject { offer: o, demand: _, work: _ } => join(["duplicate:", (o.key as NonEmptyStr)], "")
    ScenarioNotSurvived { shortfall: s } => join(["short:", s.scenario.decl_name], "")
  }
}

fn tags(a: FailureScenarioAdmission<NonEmptyStr>) -> List<String> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _, covered: _ } => []
    FailureScenariosRefused { refusals: xs } => map(xs, x => tag(x: x))
  }
}

fn shortfall_numbers(a: FailureScenarioAdmission<NonEmptyStr>) -> List<Int> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _, covered: _ } => []
    FailureScenariosRefused { refusals: xs } => flat_map(xs, x =>
      match x {
        ScenarioNotSurvived { shortfall: s } => [s.surviving, s.required]
        NoFailureScenariosDeclared => []
        OfferFailureDomainsUndeclared { offer: _ } => []
        OfferFailureDomainsAmbiguous { offer: _ } => []
        OfferSharedAcrossDemands { offer: _ } => []
        ScenarioNamesUnknownOffer { scenario: _, offer: _ } => []
        CapacityListedTwiceForOneSubject { offer: _, demand: _, work: _ } => []
      })
  }
}

fn one_demand() -> List<CommittedDemand<NonEmptyStr>> { [demand(key: "committed-ci")] }

// Capacity admitted for THIS witness's demand identity ("fsa-demand", the one scope() names).
fn capacity_admitted_for_the_witness_demand() -> List<AdmittedCapacity<NonEmptyStr>> {
  capacity_for(offers: offers(), exercises: exercises(), work: "committed-ci", caps: caps())
}

// A node, a circuit and the whole owned site are each absorbed: losing the site leaves exactly the
// exercised external route's 20, which is the required 15 + 5.
test fn w_node_circuit_and_site_loss_are_absorbed() -> Bool {
  survived(a: admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios()))
}

// The discriminating red, with its number: losing the site AND the exercised provider leaves nothing
// that counts. Cloud Y's 50 is still standing and still does not count, because it was never run.
test fn w_losing_the_site_and_the_only_exercised_cloud_is_refused_by_name() -> Bool {
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: [site_and_cloud_x()])
  tags(a: a) == ["short:fsa_scenario_site_and_cloud_x"] && shortfall_numbers(a: a) == [0, 20]
}

// The same scenario survives once Cloud Y is exercised: readiness, not quota, is what made it red.
test fn w_exercising_the_second_cloud_is_what_survives_it() -> Bool {
  survived(a: admit(
    offers: offers(), domains: domains(),
    exercises: concat(exercises(), [exercise(route: cloud_y_route())]),
    demands: one_demand(), scenarios: [site_and_cloud_x()]))
}

test fn w_no_declared_scenarios_refuses_rather_than_admitting_vacuously() -> Bool {
  tags(a: admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: [])) == ["no-scenarios"]
}

// An owned node with no domain row is refused, not treated as surviving its own circuit's loss.
test fn w_an_offer_without_failure_domains_refuses() -> Bool {
  let partial = filter(domains(), d => (d.offer.key as NonEmptyStr) != "owned-node-2")
  tags(a: admit(offers: offers(), domains: partial, exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios())) == ["undeclared:owned-node-2"]
}

test fn w_two_domain_rows_for_one_offer_refuse() -> Bool {
  let doubled = concat(domains(), [row(key: "cloud-x", domains: [r(name: "fsa_circuit_a")])])
  tags(a: admit(offers: offers(), domains: doubled, exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios())) == ["ambiguous:cloud-x"]
}

// Two demands that can both use the same offers would each count them in full; that is selling the
// same capacity twice, so it refuses. Demands with disjoint eligibility do not.
test fn w_supply_counted_for_two_demands_refuses() -> Bool {
  let two = [demand(key: "committed-ci"), demand(key: "committed-batch")]
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: two, scenarios: absorbed_scenarios())
  tags(a: a) == ["shared:owned-node-1", "shared:owned-node-2", "shared:cloud-x"]
}

// A demand whose requirements no offer can run admits no capacity at all, so every scenario is short
// by the whole reserve. The requirements live on the capacity that proved them, so this is asked of
// capacity_for rather than of a requirements field on the demand.
test fn w_a_demand_no_offer_can_run_admits_no_capacity() -> Bool {
  count(capacity_for(offers: offers(), exercises: exercises(), work: "committed-gpu", caps: "gunbc.capabilities.gpu-runtime")) == 0
    && shortfall_numbers(a: admit_with_capacity(
      capacities: [],
      demands: [demand(key: "committed-gpu")],
      scenarios: [site_and_cloud_x()])) == [0, 20]
}

// CAPACITY PERMITTED FOR ONE CUSTOMER'S DEMAND IS NOT ANOTHER'S, even over the same work: the join is
// both identities, so the second customer sees nothing and is short by the whole reserve.
test fn w_capacity_admitted_for_one_demand_does_not_count_for_another() -> Bool {
  shortfall_numbers(a: admit_with_capacity(
    capacities: capacity_admitted_for_the_witness_demand(),
    demands: [other_customer_demand(key: "committed-ci")],
    scenarios: [site_and_cloud_x()])) == [0, 20]
}

// A PLANNED FLEET IS NOT CAPACITY AT ALL NOW: the screens run in product.fabric.capacity_admission,
// so an unobserved offer never becomes an AdmittedCapacity and the scenario fold never sees it. The
// discriminator is the same as before - the same twenty grants, evidence switched - and the shortfall
// is what remains: 20 from the exercised cloud against 20 required survives, and losing that cloud's
// provider does not.
fn planned_owned_offers() -> List<SupplierOffer<NonEmptyStr>> {
  map(offers(), o =>
    if (o.id.key as NonEmptyStr) == "cloud-x" || (o.id.key as NonEmptyStr) == "cloud-y" {
      o
    } else {
      SupplierOffer {
        id: o.id, executor: o.executor, route: o.route, shape: o.shape, capabilities: o.capabilities,
        trust_domain: o.trust_domain, isolation: o.isolation, quantity_bound: o.quantity_bound,
        ready_at: o.ready_at, quote: o.quote, billing_quantum: o.billing_quantum,
        evidence: UnobservedSupply { obligation: r(name: "fsa_planned_fleet_obligation") },
      }
    })
}

test fn w_unobserved_supply_is_never_admitted_as_capacity() -> Bool {
  count(capacity_for(offers: planned_owned_offers(), exercises: exercises(), work: "committed-ci", caps: caps())) == 1
    && count(capacity_for(offers: offers(), exercises: exercises(), work: "committed-ci", caps: caps())) == 3
}

// NO CLAIM THAT A PLANNED DEMAND REFUSES, AND THAT IS THE POINT: after review 67483 a planning
// figure cannot inhabit CommittedDemand at all, so the state has no spelling here to be red about
// (DESIGN section 4b - ask whether the red is authorable before writing the check). What answers the
// planning question instead is gunbc-private#141's own RepairIntervalPlanAssessment, which carries
// the assumptions it rests on and cannot say "survived".

// A SCENARIO CITES THE CLAIM THAT OWNS IT, which is a declaration this module really carries, so the
// citation resolves without minting an anchor row for it. review 67458 is right that the two anchor
// rows an earlier revision added were read by nothing - but consuming their VALUES in r(...) would
// have cited "fsa-scenario-two-nodes", a declaration that does not exist, which is the dangling
// citation this PR exists to remove. Naming the claim is the third option: no unread row, no minted
// name.
//
// A HOST HAS NO DECLARATION, SO LOSING ONE IS AN IDENTITY, NOT A MINTED CITATION. Losing both owned
// nodes by name leaves the exercised cloud's 20, which is exactly the required 15 + 5; losing one of
// them and the exercised cloud's whole provider does not.

test fn w_named_offers_are_lost_without_minting_a_citation_for_them() -> Bool {
  survived(a: admit(
    offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(),
    scenarios: [losing_offers(name: "w_named_offers_are_lost_without_minting_a_citation_for_them", keys: ["owned-node-1", "owned-node-2"])]))
}

test fn w_a_named_offer_and_a_lost_domain_compose() -> Bool {
  let mixed = FailureScenario {
    scenario: r(name: "w_a_named_offer_and_a_lost_domain_compose"),
    lost: [r(name: "fsa_cloud_x_provider")],
    lost_offers: [FabricIdentity { principal: "gunbc", key: "owned-node-1" }],
  }
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: [mixed])
  tags(a: a) == ["short:w_a_named_offer_and_a_lost_domain_compose"] && shortfall_numbers(a: a) == [10, 20]
}

// A SCENARIO THAT NAMES AN OFFER NOBODY HOLDS APPLIES NO LOSS, so the survival it would report is
// vacuous: a misspelled host reads as "this failure is absorbed" while the failure never happened.
// It refuses instead, and the red is the spelling: "owned-node-3" does not exist.
test fn w_a_scenario_naming_an_offer_nobody_holds_refuses() -> Bool {
  tags(a: admit(
    offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(),
    scenarios: [losing_offers(name: "w_a_scenario_naming_an_offer_nobody_holds_refuses", keys: ["owned-node-1", "owned-node-3"])]))
    == ["unknown-offer:owned-node-3"]
}

// DUPLICATE CAPACITY CANNOT MANUFACTURE QUANTITY. The same admitted capacity listed twice would make
// a 20-slot cloud read as 40 and survive a scenario it cannot; it refuses on arity before anything is
// summed, and the surviving-grants number never gets computed.
test fn w_the_same_capacity_listed_twice_refuses_before_it_is_summed() -> Bool {
  let once = capacity_admitted_for_the_witness_demand()
  tags(a: admit_with_capacity(capacities: concat(once, once), demands: one_demand(), scenarios: absorbed_scenarios()))
    == ["duplicate:owned-node-1", "duplicate:owned-node-2", "duplicate:cloud-x"]
}

// A ROUTE ADMITTED ONLY TO RUN ITS OWN FIRST EXERCISE IS NOT RESERVE. Cloud Y has no exercise, so
// asking for it under the exercise requirement admits a PLACEMENT - dispatchable, and not capacity -
// so the reserve is unchanged and the scenario that needed it is still short.
fn cloud_y_exercise_admission() -> CapacityAdmission<NonEmptyStr> {
  admit_capacity(
    routes: route_rows(offers: offers()),
    sanctions: sanctions(),
    active: posture(),
    scope: scope(work: "committed-ci"),
    decision_receipt: r(name: "fsa_decision_receipt"),
    exercises: exercises(),
    readiness_requirement: ExerciseOfRoute {
      route: cloud_y_route(),
      work: FabricIdentity { principal: "gunbc", key: "committed-ci" },
    },
    at: now,
    requirements: requirements(caps: caps()),
    offer: offer(key: "cloud-y", route: cloud_y_route(), grants: 50),
  )
}

test fn w_a_bootstrap_exercise_placement_is_not_reserve_capacity() -> Bool {
  match cloud_y_exercise_admission() {
    RouteExercisePlacementAdmitted { placement: p } => (p.offer.id.key as NonEmptyStr) == "cloud-y"
    CapacityAdmittedForOrdinaryWork { capacity: _ } => false
    CapacityRefused { refusal: _ } => false
  }
}

// THE SURVIVAL SAYS WHAT IT COVERED, and the subject it reports is the one the screens proved: the
// capability manifest fungibility was established against, and the exercise that made the route
// ready. A survival that could not name those would leave a reader to reconstruct them.
fn covered_capabilities(a: FailureScenarioAdmission<NonEmptyStr>) -> List<String> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _, covered: cs } =>
      map(cs, c => (c.requirements.capabilities as String))
    FailureScenariosRefused { refusals: _ } => []
  }
}

fn covered_grants(a: FailureScenarioAdmission<NonEmptyStr>) -> List<Int> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _, covered: cs } => map(cs, c => c.grants)
    FailureScenariosRefused { refusals: _ } => []
  }
}

// The exercise each covered capacity reports is the one that made ITS OWN route ready: the two owned
// nodes name the owned route's provider and the cloud names cloud X's. A carrier that attached the
// wrong exercise - or the first exercise in the list - would report the owned provider three times.
fn covered_exercise_providers(a: FailureScenarioAdmission<NonEmptyStr>) -> List<String> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _, covered: cs } =>
      map(cs, c => (c.exercise.route.provider.decl_name as String))
    FailureScenariosRefused { refusals: _ } => []
  }
}

test fn w_a_survival_reports_the_subject_its_capacity_was_proved_for() -> Bool {
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios())
  covered_capabilities(a: a) == ["gunbc.capabilities.linux-rust-toolchain", "gunbc.capabilities.linux-rust-toolchain", "gunbc.capabilities.linux-rust-toolchain"]
    && covered_grants(a: a) == [10, 10, 20]
    && covered_exercise_providers(a: a) == ["fsa_owned_provider", "fsa_owned_provider", "fsa_cloud_x_provider"]
}

// review 67526's specimen, exactly: the same offer admitted once for another demand and TWICE for
// this one. Suppressing on offer id alone reported nothing and let this demand count the offer twice;
// keyed on the whole subject, the duplicate for THIS demand is named.
fn capacity_for_demand(demand_key: DemandKey) -> List<AdmittedCapacity<NonEmptyStr>> {
  flat_map(offers(), o =>
    match admit_capacity(
      routes: route_rows(offers: offers()),
      sanctions: sanctions(),
      active: posture(),
      scope: scope_for(demand_key: demand_key, work: "committed-ci"),
      decision_receipt: r(name: "fsa_decision_receipt"),
      exercises: exercises(),
      readiness_requirement: RequireExercisedRoute,
      at: now,
      requirements: requirements(caps: caps()),
      offer: o,
    ) {
      CapacityAdmittedForOrdinaryWork { capacity: c } => if (c.offer.id.key as NonEmptyStr) == "cloud-x" { [c] } else { [] }
      RouteExercisePlacementAdmitted { placement: _ } => []
      CapacityRefused { refusal: _ } => []
    })
}

test fn w_a_duplicate_hidden_behind_another_demands_row_is_still_named() -> Bool {
  let for_other = capacity_for_demand(demand_key: "fsa-other-demand")
  let for_this = capacity_for_demand(demand_key: "fsa-demand")
  tags(a: admit_with_capacity(
    capacities: concat(for_other, concat(for_this, for_this)),
    demands: one_demand(),
    scenarios: absorbed_scenarios()))
    == ["duplicate:cloud-x"]
}
