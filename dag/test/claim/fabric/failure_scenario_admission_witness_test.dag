module test.claim.fabric.failure_scenario_admission_witness

import std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, String, Int, List, EpochSecs }
import std.decl_ref { DeclarationRef, decl_ref }
import std.measure { MoneyRate, money_amount_micro, second, hardware_thread_count, HardwareThreadCount }
import extdeps.currency.currency { Usd }
import product.fabric.identity { FabricIdentity, OfferKey, WorkKey }
import product.fabric.work {
  Shape, HardRequirements, ExecutionRequirements, CapabilityManifestRef, TrustDomainRef,
  ControlPlaneCapacity,
}
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { IsolationProfile }
import product.fabric.provider_route { ProviderRoute }
import product.fabric.supply { SupplierOffer, QuotedPerHour, ObservedSupply, UnobservedSupply }
import product.fabric.route_readiness { RouteExercise }
import product.fabric.failure_scenario_admission {
  OfferFailureDomains, FailureScenario, CommittedDemand,
  FailureScenarioAdmission, FailureScenariosSurvived, FailureScenariosRefused,
  FailureScenarioRefusal, NoFailureScenariosDeclared, OfferFailureDomainsUndeclared,
  OfferFailureDomainsAmbiguous, OfferSharedAcrossDemands, ScenarioNotSurvived, OfferSupplyUnobserved,
  ScenarioNamesUnknownOffer,
  admit_failure_scenarios,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS ONE SMALL PORTFOLIO, and every name, count and domain in it is this witness's
// declared input rather than a reading of any real fleet or vendor. Two owned nodes on two circuits
// at one site, one exercised external route, and one external route with a larger quota that nobody
// has exercised. Demand is 15 grants with a margin of 5, so 20 must survive every scenario.

data fsa_module: NonEmptyStr = "test.claim.fabric.failure_scenario_admission_witness"
data fsa_owned_provider: NonEmptyStr = "fsa-owned-provider"
data fsa_owned_site: NonEmptyStr = "fsa-owned-site"
data fsa_circuit_a: NonEmptyStr = "fsa-circuit-a"
data fsa_circuit_b: NonEmptyStr = "fsa-circuit-b"
data fsa_node_1: NonEmptyStr = "fsa-node-1"
data fsa_node_2: NonEmptyStr = "fsa-node-2"
data fsa_cloud_x_provider: NonEmptyStr = "fsa-cloud-x-provider"
data fsa_cloud_x_region: NonEmptyStr = "fsa-cloud-x-region"
data fsa_cloud_y_provider: NonEmptyStr = "fsa-cloud-y-provider"
data fsa_cloud_y_region: NonEmptyStr = "fsa-cloud-y-region"
data fsa_service: NonEmptyStr = "fsa-service"
data fsa_exercise_receipt: NonEmptyStr = "fsa-exercise-receipt"
data fsa_planned_fleet_obligation: NonEmptyStr = "fsa-planned-fleet-obligation"
data fsa_scenario_node: NonEmptyStr = "fsa-scenario-node"
data fsa_scenario_circuit: NonEmptyStr = "fsa-scenario-circuit"
data fsa_scenario_site: NonEmptyStr = "fsa-scenario-site"
data fsa_scenario_site_and_cloud_x: NonEmptyStr = "fsa-scenario-site-and-cloud-x"

fn r(name: String) -> DeclarationRef { decl_ref(module_path: fsa_module, decl_name: name) }

fn owned_route() -> ProviderRoute {
  ProviderRoute { provider: r(name: "fsa_owned_provider"), service: r(name: "fsa_service"), region: r(name: "fsa_owned_site") }
}
fn cloud_x_route() -> ProviderRoute {
  ProviderRoute { provider: r(name: "fsa_cloud_x_provider"), service: r(name: "fsa_service"), region: r(name: "fsa_cloud_x_region") }
}
fn cloud_y_route() -> ProviderRoute {
  ProviderRoute { provider: r(name: "fsa_cloud_y_provider"), service: r(name: "fsa_service"), region: r(name: "fsa_cloud_y_region") }
}

fn shape(threads: HardwareThreadCount) -> Shape {
  Shape { hard: HardRequirements { threads: threads }, envelope: unstated_envelope() }
}

fn caps() -> CapabilityManifestRef { "gunbc.capabilities.linux-rust-toolchain" }
fn trust() -> TrustDomainRef { "gunbc.trust.internal-fleet" }

fn requirements(caps: CapabilityManifestRef) -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: shape(threads: hardware_thread_count(count: 8)),
    capabilities: caps,
    trust_domain: trust(),
    isolation: IsolationProfile { guarantees: [] },
  }
}

fn offer(key: OfferKey, route: ProviderRoute, grants: Int) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    route: route,
    shape: shape(threads: hardware_thread_count(count: 16)),
    capabilities: caps(),
    trust_domain: trust(),
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: grants,
    ready_at: "2026-09-17T00:00:00Z",
    quote: QuotedPerHour(MoneyRate { amount: money_amount_micro(count: 0), currency: Usd }),
    billing_quantum: second(count: 0),
    evidence: ObservedSupply { observed_at: "2026-09-17T00:00:00Z", receipt: "fsa-supply-observation" },
  }
}

fn offers() -> List<SupplierOffer<NonEmptyStr>> {
  [
    offer(key: "owned-node-1", route: owned_route(), grants: 10),
    offer(key: "owned-node-2", route: owned_route(), grants: 10),
    offer(key: "cloud-x", route: cloud_x_route(), grants: 20),
    offer(key: "cloud-y", route: cloud_y_route(), grants: 50),
  ]
}

fn row(key: OfferKey, domains: List<DeclarationRef>) -> OfferFailureDomains<NonEmptyStr> {
  OfferFailureDomains { offer: FabricIdentity { principal: "gunbc", key: key }, domains: domains }
}

fn domains() -> List<OfferFailureDomains<NonEmptyStr>> {
  [
    row(key: "owned-node-1", domains: [r(name: "fsa_circuit_a"), r(name: "fsa_node_1")]),
    row(key: "owned-node-2", domains: [r(name: "fsa_circuit_b"), r(name: "fsa_node_2")]),
    row(key: "cloud-x", domains: []),
    row(key: "cloud-y", domains: []),
  ]
}

data now: EpochSecs = 1000

fn exercise(route: ProviderRoute) -> RouteExercise {
  RouteExercise { route: route, exercised_at: 900, valid_through: 2000, receipt: r(name: "fsa_exercise_receipt") }
}

// Cloud Y is deliberately absent: it is listed and has the largest quota, and it is not capacity.
fn exercises() -> List<RouteExercise> { [exercise(route: owned_route()), exercise(route: cloud_x_route())] }

fn demand(caps: CapabilityManifestRef, key: WorkKey) -> CommittedDemand<NonEmptyStr> {
  CommittedDemand { work: FabricIdentity { principal: "gunbc", key: key }, requirements: requirements(caps: caps), grants: 15, margin: 5 }
}

fn scenario(name: String, lost: List<DeclarationRef>) -> FailureScenario<NonEmptyStr> {
  FailureScenario { scenario: r(name: name), lost: lost, lost_offers: [] }
}

fn losing_offers(name: String, keys: List<OfferKey>) -> FailureScenario<NonEmptyStr> {
  FailureScenario {
    scenario: r(name: name),
    lost: [],
    lost_offers: map(keys, k => FabricIdentity { principal: "gunbc", key: k }),
  }
}

fn absorbed_scenarios() -> List<FailureScenario<NonEmptyStr>> {
  [
    scenario(name: "fsa_scenario_node", lost: [r(name: "fsa_node_1")]),
    scenario(name: "fsa_scenario_circuit", lost: [r(name: "fsa_circuit_b")]),
    scenario(name: "fsa_scenario_site", lost: [r(name: "fsa_owned_site")]),
  ]
}

fn site_and_cloud_x() -> FailureScenario<NonEmptyStr> {
  scenario(name: "fsa_scenario_site_and_cloud_x", lost: [r(name: "fsa_owned_site"), r(name: "fsa_cloud_x_provider")])
}

fn admit(
  offers: List<SupplierOffer<NonEmptyStr>>,
  domains: List<OfferFailureDomains<NonEmptyStr>>,
  exercises: List<RouteExercise>,
  demands: List<CommittedDemand<NonEmptyStr>>,
  scenarios: List<FailureScenario<NonEmptyStr>>,
) -> FailureScenarioAdmission<NonEmptyStr> {
  admit_failure_scenarios(offers: offers, domains: domains, exercises: exercises, at: now, demands: demands, scenarios: scenarios)
}

fn survived(a: FailureScenarioAdmission<NonEmptyStr>) -> Bool {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _ } => true
    FailureScenariosRefused { refusals: _ } => false
  }
}

fn tag(x: FailureScenarioRefusal<NonEmptyStr>) -> String {
  match x {
    NoFailureScenariosDeclared => "no-scenarios"
    OfferFailureDomainsUndeclared { offer: o } => join(["undeclared:", (o.key as NonEmptyStr)], "")
    OfferFailureDomainsAmbiguous { offer: o } => join(["ambiguous:", (o.key as NonEmptyStr)], "")
    OfferSharedAcrossDemands { offer: o } => join(["shared:", (o.key as NonEmptyStr)], "")
    OfferSupplyUnobserved { offer: o, obligation: _ } => join(["unobserved:", (o.key as NonEmptyStr)], "")
    ScenarioNamesUnknownOffer { scenario: _, offer: o } => join(["unknown-offer:", (o.key as NonEmptyStr)], "")
    ScenarioNotSurvived { shortfall: s } => join(["short:", s.scenario.decl_name], "")
  }
}

fn tags(a: FailureScenarioAdmission<NonEmptyStr>) -> List<String> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _ } => []
    FailureScenariosRefused { refusals: xs } => map(xs, x => tag(x: x))
  }
}

fn shortfall_numbers(a: FailureScenarioAdmission<NonEmptyStr>) -> List<Int> {
  match a {
    FailureScenariosSurvived { scenarios: _, demands: _ } => []
    FailureScenariosRefused { refusals: xs } => flat_map(xs, x =>
      match x {
        ScenarioNotSurvived { shortfall: s } => [s.surviving, s.required]
        NoFailureScenariosDeclared => []
        OfferFailureDomainsUndeclared { offer: _ } => []
        OfferFailureDomainsAmbiguous { offer: _ } => []
        OfferSharedAcrossDemands { offer: _ } => []
        OfferSupplyUnobserved { offer: _, obligation: _ } => []
        ScenarioNamesUnknownOffer { scenario: _, offer: _ } => []
      })
  }
}

fn one_demand() -> List<CommittedDemand<NonEmptyStr>> { [demand(caps: caps(), key: "committed-ci")] }

// A node, a circuit and the whole owned site are each absorbed: losing the site leaves exactly the
// exercised external route's 20, which is the required 15 + 5.
test fn w_node_circuit_and_site_loss_are_absorbed() -> Bool {
  survived(a: admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios()))
}

// The discriminating red, with its number: losing the site AND the exercised provider leaves nothing
// that counts. Cloud Y's 50 is still standing and still does not count, because it was never run.
test fn w_losing_the_site_and_the_only_exercised_cloud_is_refused_by_name() -> Bool {
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: [site_and_cloud_x()])
  tags(a: a) == ["short:fsa_scenario_site_and_cloud_x"] && shortfall_numbers(a: a) == [0, 20]
}

// The same scenario survives once Cloud Y is exercised: readiness, not quota, is what made it red.
test fn w_exercising_the_second_cloud_is_what_survives_it() -> Bool {
  survived(a: admit(
    offers: offers(), domains: domains(),
    exercises: concat(exercises(), [exercise(route: cloud_y_route())]),
    demands: one_demand(), scenarios: [site_and_cloud_x()]))
}

test fn w_no_declared_scenarios_refuses_rather_than_admitting_vacuously() -> Bool {
  tags(a: admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: [])) == ["no-scenarios"]
}

// An owned node with no domain row is refused, not treated as surviving its own circuit's loss.
test fn w_an_offer_without_failure_domains_refuses() -> Bool {
  let partial = filter(domains(), d => (d.offer.key as NonEmptyStr) != "owned-node-2")
  tags(a: admit(offers: offers(), domains: partial, exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios())) == ["undeclared:owned-node-2"]
}

test fn w_two_domain_rows_for_one_offer_refuse() -> Bool {
  let doubled = concat(domains(), [row(key: "cloud-x", domains: [r(name: "fsa_circuit_a")])])
  tags(a: admit(offers: offers(), domains: doubled, exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios())) == ["ambiguous:cloud-x"]
}

// Two demands that can both use the same offers would each count them in full; that is selling the
// same capacity twice, so it refuses. Demands with disjoint eligibility do not.
test fn w_supply_counted_for_two_demands_refuses() -> Bool {
  let two = [demand(caps: caps(), key: "committed-ci"), demand(caps: caps(), key: "committed-batch")]
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: two, scenarios: absorbed_scenarios())
  tags(a: a) == ["shared:owned-node-1", "shared:owned-node-2", "shared:cloud-x"]
}

test fn w_a_demand_no_offer_can_run_is_short_in_every_scenario() -> Bool {
  let foreign = [demand(caps: "gunbc.capabilities.gpu-runtime", key: "committed-gpu")]
  shortfall_numbers(a: admit(offers: offers(), domains: domains(), exercises: exercises(), demands: foreign, scenarios: [site_and_cloud_x()])) == [0, 20]
}

// A PLANNED FLEET IS NOT A RESERVE. The same twenty grants of owned capacity, with their evidence
// switched from observed to unobserved, refuse by their own arm rather than surviving or arriving at
// a shortfall - so "we reserved against hosts that never booted" cannot be reported as coverage.
fn planned_owned_offers() -> List<SupplierOffer<NonEmptyStr>> {
  map(offers(), o =>
    if (o.id.key as NonEmptyStr) == "cloud-x" || (o.id.key as NonEmptyStr) == "cloud-y" {
      o
    } else {
      SupplierOffer {
        id: o.id, executor: o.executor, route: o.route, shape: o.shape, capabilities: o.capabilities,
        trust_domain: o.trust_domain, isolation: o.isolation, quantity_bound: o.quantity_bound,
        ready_at: o.ready_at, quote: o.quote, billing_quantum: o.billing_quantum,
        evidence: UnobservedSupply { obligation: r(name: "fsa_planned_fleet_obligation") },
      }
    })
}

test fn w_unobserved_supply_refuses_by_its_own_arm() -> Bool {
  tags(a: admit(offers: planned_owned_offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: absorbed_scenarios()))
    == ["unobserved:owned-node-1", "unobserved:owned-node-2"]
}

// A HOST HAS NO DECLARATION, SO LOSING ONE IS AN IDENTITY, NOT A MINTED CITATION. Losing both owned
// nodes by name leaves the exercised cloud's 20, which is exactly the required 15 + 5; losing one of
// them and the exercised cloud's whole provider does not.
data fsa_scenario_two_nodes: NonEmptyStr = "fsa-scenario-two-nodes"
data fsa_scenario_node_and_cloud_x: NonEmptyStr = "fsa-scenario-node-and-cloud-x"

test fn w_named_offers_are_lost_without_minting_a_citation_for_them() -> Bool {
  survived(a: admit(
    offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(),
    scenarios: [losing_offers(name: "fsa_scenario_two_nodes", keys: ["owned-node-1", "owned-node-2"])]))
}

test fn w_a_named_offer_and_a_lost_domain_compose() -> Bool {
  let mixed = FailureScenario {
    scenario: r(name: "fsa_scenario_node_and_cloud_x"),
    lost: [r(name: "fsa_cloud_x_provider")],
    lost_offers: [FabricIdentity { principal: "gunbc", key: "owned-node-1" }],
  }
  let a = admit(offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(), scenarios: [mixed])
  tags(a: a) == ["short:fsa_scenario_node_and_cloud_x"] && shortfall_numbers(a: a) == [10, 20]
}

// A SCENARIO THAT NAMES AN OFFER NOBODY HOLDS APPLIES NO LOSS, so the survival it would report is
// vacuous: a misspelled host reads as "this failure is absorbed" while the failure never happened.
// It refuses instead, and the red is the spelling: "owned-node-3" does not exist.
test fn w_a_scenario_naming_an_offer_nobody_holds_refuses() -> Bool {
  tags(a: admit(
    offers: offers(), domains: domains(), exercises: exercises(), demands: one_demand(),
    scenarios: [losing_offers(name: "fsa_scenario_two_nodes", keys: ["owned-node-1", "owned-node-3"])]))
    == ["unknown-offer:owned-node-3"]
}
