module test.claim.fabric.fci1_bounded_execution_context_emit_witness_test

import std.types { Bool, list_length }
import gunbc.fci1_bounded_execution_context_emit {
  expected_fci1_bounded_execution_context_env,
  Fci1BoundedExecutionContextEmitted,
  Fci1BoundedExecutionContextEmissionRefused,
}
import gunbc.generated_artifact {
  Fci1BoundedExecutionContextArtifact,
  artifact_path,
  committed_generated_artifacts,
}

fn fci1_bounded_context_fragment_is_the_rostered_projection() -> Bool {
  list_length(items: committed_generated_artifacts()) == 36
    && artifact_path(a: Fci1BoundedExecutionContextArtifact)
      == "tools/fabric_ci_fci1_bounded_execution_context.env"
    && match expected_fci1_bounded_execution_context_env() {
      Fci1BoundedExecutionContextEmitted { content: content } => content == join([
        "#!/usr/bin/env bash\n",
        "# GENERATED by dag/gunbc/fabric/fci1_bounded_execution_context_emit.dag — DO NOT HAND-EDIT.\n",
        "FCI1_MEMORY_MAX_BYTES=17179869184\n",
        "FCI1_MEMORY_HIGH_BYTES=16106127360\n",
        "FCI1_DRIVER_UNIT=fci1-bounded-driver.service\n",
        "readonly FCI1_MEMORY_MAX_BYTES FCI1_MEMORY_HIGH_BYTES FCI1_DRIVER_UNIT\n",
      ], "")
      Fci1BoundedExecutionContextEmissionRefused { reason: _ } => false
    }
}
