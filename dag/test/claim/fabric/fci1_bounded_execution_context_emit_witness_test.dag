module test.claim.fabric.fci1_bounded_execution_context_emit_witness_test

import std.types { Bool, list_length }
import v2.std.algebra { filter }
import extdeps.systemd { MemoryMax, systemd_unit_property_wire }
import gunbc.fci1_bounded_execution_context_emit {
  expected_fci1_bounded_execution_context_env,
  Fci1BoundedExecutionContextEmitted,
}
import gunbc.generated_artifact {
  Fci1BoundedExecutionContextArtifact,
  artifact_path, artifact_eq, artifact_commit_policy, CommitRequired, HostReconciler,
  committed_generated_artifacts,
}

test fn fci1_bounded_context_fragment_is_the_rostered_projection() -> Bool {
  list_length(items: filter(xs: committed_generated_artifacts(), predicate: fn(a) { artifact_eq(a: a, b: Fci1BoundedExecutionContextArtifact) })) == 1
    && artifact_path(a: Fci1BoundedExecutionContextArtifact)
      == "tools/fabric_ci_fci1_bounded_execution_context.env"
    && match artifact_commit_policy(a: Fci1BoundedExecutionContextArtifact) {
      CommitRequired { consumer: HostReconciler } => true
      _ => false
    }
    && systemd_unit_property_wire(property: MemoryMax) as String == "MemoryMax"
    && match expected_fci1_bounded_execution_context_env() {
      Fci1BoundedExecutionContextEmitted { content: content } =>
        list_length(items: filter(xs: [content], predicate: fn(value) {
          value == content
        })) == 1
      _ => false
    }
}
