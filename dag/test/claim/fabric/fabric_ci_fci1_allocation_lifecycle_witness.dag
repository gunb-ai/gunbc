// The held arm now asserts the CAUSE and the observed generation, not merely that the slot was
// refused: under the previous Bool a held slot and an unreadable one were the same observation.
test fn witness_fci1_absent_slot_is_available_but_held_slot_is_not() -> Bool {
  match fci1_allocation_slot_admission(prestate: AllocationSlotAbsent { path: "/fixture/store" }) {
    AllocationSlotAdmitted { path: p } => p == "/fixture/store"
    _ => false
  } && match fci1_allocation_slot_admission(prestate: AllocationSlotHeld { path: "/fixture/store", generation: 1 }) {
    AllocationSlotRefusedHeld { path: _, generation: g } => g == 1
    _ => false
  }
}

test fn witness_fci1_unreadable_slot_is_never_available() -> Bool {
  match fci1_allocation_slot_admission(prestate: AllocationSlotUnreadable { path: "/fixture/store" }) {
    AllocationSlotRefusedUnreadable { path: p } => p == "/fixture/store"
    _ => false
  }
}

test fn witness_fci1_absent_slot_exactly_returns_free_at_generation_two() -> Bool {
  match fci1_exact_allocation_restoration(
    prestate: AllocationSlotAbsent { path: "/fixture/store" },
    held_generation: 1,
    poststate: AllocationSlotFree { path: "/fixture/store", generation: 2 },
  ) {
    AllocationSlotAbsentReturnedFree { path: p, held_generation: h, post_generation: f } =>
      p == "/fixture/store" && h == 1 && f == 2
    _ => false
  }
}

test fn witness_fci1_free_slot_exactly_advances_reserve_then_release() -> Bool {
  match fci1_exact_allocation_restoration(
    prestate: AllocationSlotFree { path: "/fixture/store", generation: 7 },
    held_generation: 8,
    poststate: AllocationSlotFree { path: "/fixture/store", generation: 9 },
  ) {
    AllocationSlotFreeReturnedFree { path: p, pre_generation: pre, held_generation: held, post_generation: post } =>
      p == "/fixture/store" && pre == 7 && held == 8 && post == 9
    _ => false
  }
}

test fn witness_fci1_unexpected_extra_generation_refuses() -> Bool {
  match fci1_exact_allocation_restoration(
    prestate: AllocationSlotFree { path: "/fixture/store", generation: 7 },
    held_generation: 8,
    poststate: AllocationSlotFree { path: "/fixture/store", generation: 10 },
  ) {
    AllocationStoreRestorationRefused { path: p } => p == "/fixture/store"
    _ => false
  }
}

test fn witness_fci1_wrong_held_generation_refuses() -> Bool {
  match fci1_exact_allocation_restoration(
    prestate: AllocationSlotAbsent { path: "/fixture/store" },
    held_generation: 2,
    poststate: AllocationSlotFree { path: "/fixture/store", generation: 2 },
  ) {
    AllocationStoreRestorationRefused { path: p } => p == "/fixture/store"
    _ => false
  }
}

test fn witness_fci1_missing_transport_checkpoint_has_closed_identity() -> Bool {
  fci1_checkpoint_token(checkpoint: Fci1CheckpointAfterCanonicalCommitBeforeTransport)
    == "after-canonical-commit-before-transport"
}

test fn witness_fci1_already_free_checkpoint_is_distinct_from_held() -> Bool {
  fci1_checkpoint_token(checkpoint: Fci1CheckpointAfterReleaseBeforeGrading)
    != fci1_checkpoint_token(checkpoint: Fci1CheckpointAfterCanonicalCommitBeforeTransport)
}

test fn witness_fci1_disposable_replacement_checkpoint_is_separate() -> Bool {
  fci1_checkpoint_token(checkpoint: Fci1CheckpointGenerationHeldTwo) == "generation-held-two"
}

// ---------------------------------------------------------------------------
// THE FCI-1 INSTRUMENT'S SUBJECT IS DERIVED FROM THE FABRIC EXECUTION ROSTER.
//
// gunbc.instruments.fabric_control_plane_live_probe used to answer its subject as the authored literal
// `RunnerSlotIdentity { host: "srv3", slot_index: 6 }`, and no leg ever joined that literal back to
// gunbc.runner.runner_slot_allocation::fabric_execution_slot_identities -- the slot was an allocation key,
// a /opt/fabric-cells path component and a systemd unit name, and nothing asked whether the fleet had
// committed it to fabric execution. gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci (2026-11-09)
// returned srv3-06/07 and srv4-06/07 to GitHub Actions, so the literal had become a pointer at a CI
// runner. These rows feed the gate rosters it has never seen, which is what makes the refusal
// discriminating rather than always-on: it tracks the roster, and the located cause cites the ruling.
// ---------------------------------------------------------------------------

fn fci1_roster_names(roster: List<RunnerSlotIdentity>, want: RunnerSlotIdentity) -> Bool {
  match roster {
    Cons { head: h, tail: t } => runner_slot_identity_equal(a: h, b: want)
      || fci1_roster_names(roster: t, want: want)
    Empty => false
  }
}

fn fci1_roster_names_none(roster: List<RunnerSlotIdentity>, none_of: List<RunnerSlotIdentity>) -> Bool {
  match none_of {
    Cons { head: h, tail: t } => !fci1_roster_names(roster: roster, want: h)
      && fci1_roster_names_none(roster: roster, none_of: t)
    Empty => true
  }
}

fn fci1_projection_names_its_own_absence(subject: CpProbeSubject) -> Bool {
  // Post-review-92428 a refusal projects NOTHING rather than a stand-in that merely names no real host:
  // cp_probe_slot_from is an Optional, so with no subject there is no identity at all -- not srv1-13, not
  // a fabricated host -- for an allocation key, a /opt/fabric-cells path or a systemctl unit to be built
  // from. Asserting Absent is what keeps the deleted sentinel from coming back dressed up as a "safe"
  // placeholder (gunbc.design_argument::continuous_generalization: a sentinel in a model that could
  // express the case is a fork).
  match cp_probe_slot_from(subject: subject) {
    Absent {} => true
    Present { value: _ } => false
  }
}

test fn witness_fci1_subject_follows_the_roster_and_not_the_old_literal() -> Bool {
  let srv4_nine = RunnerSlotIdentity { host: "srv4", slot_index: 9 }
  let srv1_thirteen = RunnerSlotIdentity { host: "srv1", slot_index: 13 }
  match cp_probe_subject_from(roster: [srv4_nine], served_host: "srv4" as HostIdentity) {
    // A member on the host the instrument serves is selected exactly as the roster names it -- including
    // a slot the authored literal could never have produced.
    CpProbeSubjectSelected { slot } => runner_slot_identity_equal(a: slot, b: srv4_nine)
    _ => false
  }
    // A member on a host whose legs this instrument does not carry is NOT silently adopted: the refusal
    // carries the derived identity, so the operator can see what the roster asked for.
    && match cp_probe_subject_from(roster: [srv1_thirteen], served_host: cp_probe_served_host()) {
      CpProbeSubjectHostMachineryUnavailable { cause } =>
        runner_slot_identity_equal(a: cause.derived, b: srv1_thirteen)
          && (cause.served_host as String) == "srv3"
      _ => false
    }
}

test fn witness_fci1_no_committed_fabric_execution_slot_refuses_with_a_located_cause() -> Bool {
  let nothing = cp_probe_subject_from(roster: [], served_host: cp_probe_served_host())
  match nothing {
    CpProbeSubjectNoFabricExecutionSlot { cause } =>
      cause.authority == "gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci (2026-11-09)"
        && cause.why == "no fabric execution slot is committed: FCI-1 declines to act rather than drive allocation keys, /opt/fabric-cells paths and systemctl at a slot that serves GitHub Actions"
    _ => false
  }
    // With no subject there is no plausible slot to act on either: the projection names its own absence
    // instead of falling back to a host, so a caller that skipped the gate still cannot name a cell path.
    && fci1_projection_names_its_own_absence(subject: nothing)
}

test fn witness_fci1_cannot_take_a_slot_the_operator_returned_to_ci_as_its_subject() -> Bool {
  let returned = [
    RunnerSlotIdentity { host: "srv3", slot_index: 6 },
    RunnerSlotIdentity { host: "srv3", slot_index: 7 },
    RunnerSlotIdentity { host: "srv4", slot_index: 6 },
    RunnerSlotIdentity { host: "srv4", slot_index: 7 },
  ]
  fci1_roster_names_none(roster: fabric_execution_slot_identities(), none_of: returned)
    // And so the instrument cannot act on any of them, nor label anything with them: the gate selects
    // nothing today and the label projection has no subject at all -- the concrete failure the literal
    // subject would have caused on srv3, where the instrument still runs its legs.
    && match cp_probe_slot() {
      Absent {} => true
      Present { value: slot } => false
    }
}

// THE EFFECT SURFACE CANNOT OBTAIN A SLOT THE ROSTER DID NOT SELECT (2026-11-09 review).
// The reviewer's point was exact: a total projection over the refusal arms put safety on "every one of
// those 30 callers having checked cp_probe_subject() first", and DESIGN.md's fail-closed standing
// (gunbc.design_argument::fail_closed) refuses exactly that -- "a failure arm refuses, never widens",
// "making it unwritable" beats catching the wrong state. So the legs that mutate (market reservation,
// CAS attempt, release commit, host preconditions, cell observation, the systemctl read) take
// cp_probe_authorized_slot and act on the identity BOUND by the Selected arm, and a refusal projects a
// MARKER that is not a slot at all. These rows are the discriminator: the same function, fed rosters it
// has never seen, selects on one and refuses on the others -- an always-refusing helper would fail the
// first clause, and a projection that widened would fail the last two.
test fn witness_fci1_effect_legs_act_only_on_the_roster_selected_subject() -> Bool {
  let srv3_six = RunnerSlotIdentity { host: "srv3", slot_index: 6 }
  let srv1_thirteen = RunnerSlotIdentity { host: "srv1", slot_index: 13 }
  // Committed on the host whose legs the instrument carries: the effect may proceed, ON THAT IDENTITY.
  match cp_probe_authorized_from(roster: [srv3_six], served_host: cp_probe_served_host()) {
    CpProbeAuthorizedSlot { slot } => runner_slot_identity_equal(a: slot, b: srv3_six)
    CpProbeAuthorizedRefused { detail: _ } => false
  }
    // Committed nowhere: refused, and the refusal carries the cause rather than a value.
    && match cp_probe_authorized_from(roster: [], served_host: cp_probe_served_host()) {
      CpProbeAuthorizedRefused { detail } => detail != ""
      CpProbeAuthorizedSlot { slot: _ } => false
    }
    // Committed on a host whose legs it does not carry: refused too, NOT adopted. This is the clause that
    // would go green-by-luck if the instrument quietly took srv1-13 as its fixture.
    && match cp_probe_authorized_from(roster: [srv1_thirteen], served_host: cp_probe_served_host()) {
      CpProbeAuthorizedRefused { detail } => detail != ""
      CpProbeAuthorizedSlot { slot: _ } => false
    }
}

test fn witness_fci1_refusal_projection_is_no_slot_at_all() -> Bool {
  // A refusal projects NOTHING, not a stand-in. Today the roster commits srv1's members and these are the
  // srv3 legs, so there is no subject: the projection is Absent -- neither srv1-13 nor srv1-14 nor a
  // fabricated identity, because the sentinel identity was deleted rather than dressed up (a placeholder
  // in a model-shaped field is a fork: gunbc.design_argument::continuous_generalization). What a refusal
  // may put into a label field is the string that names its own absence, and nothing else; that string is
  // not a host the fleet has, so no key, path or systemctl unit built from it can name a real cell.
  match cp_probe_slot() {
    Absent {} => true
    Present { value: slot } => false
  }
    && cp_probe_subject_key_label() == cp_probe_no_subject_label()
    && cp_probe_subject_cell_text() == cp_probe_no_subject_label() as String
    && all(fabric_execution_slot_identities(), identity => identity.host != cp_probe_no_subject_label())
}

// ─── A REFUSAL MUST NOT WEAR A CELL STATE ──────────────────────────────────────────────────────
// review 92425 (PR #16137) found that the instrument's readers answered "no fabric execution slot is
// committed" with arms that are real observations of a cell: fci1_allocation_prestate returned
// AllocationSlotAbsent, which fci1_live_reserve_and_observe_available_in reads as "the slot is free" and
// reserves over, and fci1_live_binding_observation called the host observer with a made-up identity. Both
// now report their own arm. These rows are what keeps that from quietly collapsing back into Absent:
// Absent and Free are ADMITTED (the contrast clauses below are deliberately not tautologies -- they
// state what those arms mean, so a future edit that routes a refusal through either one goes red), while
// the no-subject arm is admitted by nothing, grants no generation, restores nothing, matches no
// authority, and does not survive a wire round-trip as a cell state.
test fn witness_fci1_no_subject_is_admitted_by_nothing_grants_no_generation() -> Bool {
  let why = "no fabric execution slot is committed -- srv3-06/07 and srv4-06/07 serve GitHub Actions (gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci)"
  match fci1_allocation_slot_admission(prestate: AllocationSlotAbsent { path: "/fixture/store" }) {
    AllocationSlotAdmitted { path: p } => p == "/fixture/store"
    _ => false
  } && match fci1_allocation_slot_admission(prestate: AllocationSlotFree { path: "/fixture/store", generation: 3 }) {
    AllocationSlotAdmitted { path: p } => p == "/fixture/store"
    _ => false
  } && match fci1_allocation_slot_admission(prestate: AllocationSlotNoSubject { why: why }) {
    AllocationSlotRefusedNoSubject { why: reported } => reported == why
    _ => false
  } && fci1_expected_held_generation(prestate: AllocationSlotNoSubject { why: why }) == -1
    && match fci1_exact_allocation_restoration(
      prestate: AllocationSlotNoSubject { why: why },
      held_generation: 1,
      poststate: AllocationSlotFree { path: "/fixture/store", generation: 2 },
    ) {
      AllocationStoreRestorationRefusedNoSubject { why: reported } => reported == why
      _ => false
    }
}

// A refusal that can be decoded back into a cell state is a refusal that will be acted on. The wire tag
// is its own, and the decoder -- which knows only slot-absent / slot-free / slot-held -- refuses it
// rather than defaulting to the absent arm.
test fn witness_fci1_no_subject_wire_never_decodes_as_a_cell_state() -> Bool {
  let why = "no fabric execution slot is committed"
  let wire = fci1_allocation_prestate_wire(prestate: AllocationSlotNoSubject { why: why })
  wire == join(["no-subject\n", why], "") as NonEmptyStr
    && match fci1_decode_allocation_prestate(wire: wire as String) {
      AllocationSlotUnreadable { path: _ } => true
      _ => false
    }
}

// THE CLEANUP AUTHORITY COMPARATORS MUST NOT MATCH A READ THAT NEVER HAPPENED. The fixture's slot_key is
// the label the comparator itself derives for the current subject (the label-side rung,
// gunbc.integration_concern::cp_probe_labels_are_built_from_an_unbound_subject), so both sides take the
// same branch and the only
// thing varying below is the observation arm: a genuine held observation for the same key MATCHES, and
// the no-subject observation does not. That rules out a comparator that simply returns false.
test fn witness_fci1_no_subject_observation_matches_no_cleanup_authority() -> Bool {
  let authority = Fci1ReservationCleanupAuthority {
    root: "/fixture/store",
    slot_key: cp_probe_subject_key_label(),
    generation: 2,
    reservation_identity: "reserved-by-fci1",
    reservation_payload: "payload",
    reservation_content: "content",
  }
  !fci1_authority_matches_held(authority: authority, observed: Fci1SlotNoSubject { why: "no subject" })
    && !fci1_authority_matches_exact_free(authority: authority, observed: Fci1SlotNoSubject { why: "no subject" })
    && fci1_authority_matches_held(authority: authority, observed: Fci1SlotHeld {
      path: "/fixture/store", generation: 2, reservation_identity: "reserved-by-fci1",
      payload: "payload", content: "content",
    })
}
