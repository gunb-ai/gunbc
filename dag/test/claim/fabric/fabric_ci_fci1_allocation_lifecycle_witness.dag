  AllocationSlotNoSubject, AllocationSlotRefusedNoSubject, AllocationStoreRestorationRefusedNoSubject,
  AllocationStoreRestorationRefused,
  AllocationSlotAbsentReturnedFree, AllocationSlotFreeReturnedFree,
  AllocationSlotAdmitted, AllocationSlotRefusedHeld, AllocationSlotRefusedUnreadable,
  fci1_allocation_slot_admission, fci1_exact_allocation_restoration,
}
import gunbc.instruments.fabric_control_plane_live_probe {
  Fci1CheckpointAfterCanonicalCommitBeforeTransport,
  cp_probe_served_host,
  cp_probe_subject,
  cp_probe_subject_from,
  cp_probe_slot_from,
  cp_probe_authorized_from,
  cp_probe_authorized_slot,
  cp_probe_no_subject_label,
  cp_probe_subject_key_label,
  cp_probe_subject_cell_text,
  Fci1SlotNoSubject,
  Fci1SlotHeld,
  Fci1ReservationCleanupAuthority,
  fci1_authority_matches_held,
  fci1_authority_matches_exact_free,
  fci1_allocation_prestate_wire,
  fci1_decode_allocation_prestate,
  fci1_expected_held_generation,
  fabric_cell_allocation_key,
  CpProbeSubjectSelected,
  CpProbeSubjectNoFabricExecutionSlot,
  CpProbeSubjectHostMachineryUnavailable,
  CpProbeSubject,
  CpProbeAuthorized,
