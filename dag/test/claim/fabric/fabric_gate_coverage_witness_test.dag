module test.claim.fabric.fabric_gate_coverage_witness_test

import std.types { Bool, Int, List, NonEmptyStr }
import gunbc.fabric_ci_program { FabricCiGate, fabric_ci_gates }
import v2.workflow.floor_terminal_ledger {
  WitnessIdentity,
  ClaimTerminalRow,
  ClaimAttemptTerminal,
  ClaimObservation,
  ClaimExpectation,
  LedgerBinding,
  RepositorySnapshot,
}
import std.materialization_provider { Fnv1a64Structural }
import gunbc.fabric_gate_coverage {
  MutationEnrolment,
  MutationDischarge,
  CoverageVerdict,
  CoverageRefusal,
  gate_coverage,
  fabric_mutation_enrolments,
  fabric_gate_coverage,
  StandingCause,
  ObligationStanding,
  GateStandingVerdict,
  gate_standing,
}

// THE RED IS AUTHORED HERE, DELIBERATELY. A coverage lens run only over the roster it ships with can
// never be observed refusing, because that roster is maintained to be total -- and a check whose
// failing value cannot be constructed is a decoration (DESIGN 4b). So the discriminating inputs are
// built as fixtures: a partial enrolment list, a duplicated row, and rows naming a gate and a
// mutation the program does not declare. Each must refuse, and each must refuse BY ITS OWN NAME,
// because a refusal witness satisfied by any refusal is satisfied by an unrelated bug.
fn one_real_gate() -> List<FabricCiGate> {
  filter(fabric_ci_gates(), g => g.id == "FCI-2")
}

fn fixture_identity() -> WitnessIdentity {
  WitnessIdentity { module_path: "fixture.module", function: "fixture_fn" }
}

fn discharged_row(gate: NonEmptyStr, mutation: NonEmptyStr) -> MutationEnrolment {
  MutationEnrolment { gate: gate, mutation: mutation, discharge: DischargedByWitness { witness: fixture_identity() } }
}

// EVERY LABEL CARRIES BOTH COORDINATES. An earlier revision encoded only one -- the mutation for
// three arms, the gate for the fourth -- so a regression could return the correct arm, carry the one
// field the witness read, and locate the refusal on the WRONG (gate, mutation) pair while every test
// still passed. A located refusal whose location is unverified is an unlocated refusal.
fn located(arm: NonEmptyStr, gate: NonEmptyStr, mutation: NonEmptyStr) -> NonEmptyStr {
  concat(concat(arm, "|"), concat(gate, concat("|", mutation))) as NonEmptyStr
}

fn refusal_labels(v: CoverageVerdict) -> List<NonEmptyStr> {
  match v {
    CoverageTotal { discharged, undischarged } => [],
    CoverageRefused { refusals } => map(refusals, r => match r {
      GateIdDeclaredSeveralTimes { gate } => located("dup-gate-id", gate, "-"),
      MutationDeclaredSeveralTimes { gate, mutation } => located("dup-declared-mutation", gate, mutation),
      MutationHasNoEnrolmentRow { gate, mutation } => located("no-row", gate, mutation),
      MutationHasSeveralEnrolmentRows { gate, mutation } => located("several-rows", gate, mutation),
      EnrolmentNamesUnknownGate { gate, mutation } => located("unknown-gate", gate, mutation),
      EnrolmentNamesUndeclaredMutation { gate, mutation } => located("undeclared-mutation", gate, mutation),
    }),
  }
}

fn total_undischarged(v: CoverageVerdict) -> List<MutationEnrolment> {
  match v {
    CoverageTotal { discharged, undischarged } => undischarged,
    CoverageRefused { refusals } => [],
  }
}

fn total_discharged(v: CoverageVerdict) -> List<MutationEnrolment> {
  match v {
    CoverageTotal { discharged, undischarged } => discharged,
    CoverageRefused { refusals } => [],
  }
}

// POSITIVE CONTROL. FCI-2 declares three mutations; three matching rows join totally.
test fn a_complete_enrolment_joins_totally() -> Bool {
  let v = gate_coverage(one_real_gate(), [
    discharged_row("FCI-2", "duplicate-grant"),
    discharged_row("FCI-2", "work-mismatch"),
    discharged_row("FCI-2", "expired-reservation"),
  ])
  refusal_labels(v).length() == 0 && total_discharged(v).length() == 3
}

// THE MUTATION THIS LENS WAS BUILT FOR: a mutation with no row refuses, and names itself. Dropping
// the expired-reservation row is exactly the state the FCI-2 pull request was in when its description
// claimed each discriminating mutation was enrolled.
test fn a_mutation_with_no_enrolment_row_refuses_by_name() -> Bool {
  let labels = refusal_labels(gate_coverage(one_real_gate(), [
    discharged_row("FCI-2", "duplicate-grant"),
    discharged_row("FCI-2", "work-mismatch"),
  ]))
  labels.length() == 1 && any(labels, l => l == "no-row|FCI-2|expired-reservation")
}

// An empty enrolment list refuses once per declared mutation rather than passing vacuously -- the
// zero-population trap, where a guard over an empty roster is green because it checked nothing.
test fn an_empty_enrolment_refuses_once_per_declared_mutation() -> Bool {
  refusal_labels(gate_coverage(one_real_gate(), [])).length() == 3
}

test fn a_duplicated_row_refuses_rather_than_being_counted_twice() -> Bool {
  let labels = refusal_labels(gate_coverage(one_real_gate(), [
    discharged_row("FCI-2", "duplicate-grant"),
    discharged_row("FCI-2", "duplicate-grant"),
    discharged_row("FCI-2", "work-mismatch"),
    discharged_row("FCI-2", "expired-reservation"),
  ]))
  labels.length() == 1 && any(labels, l => l == "several-rows|FCI-2|duplicate-grant")
}

// DIRECTION TWO, AND THE TWO FOREIGN CASES ARE DISTINGUISHED. Enrolling work nobody asked about must
// not raise coverage, and a misspelled gate is a different repair from a misspelled mutation.
test fn an_enrolment_naming_an_unknown_gate_refuses_by_that_name() -> Bool {
  let labels = refusal_labels(gate_coverage(one_real_gate(), [
    discharged_row("FCI-2", "duplicate-grant"),
    discharged_row("FCI-2", "work-mismatch"),
    discharged_row("FCI-2", "expired-reservation"),
    discharged_row("FCI-9", "duplicate-grant"),
  ]))
  labels.length() == 1 && any(labels, l => l == "unknown-gate|FCI-9|duplicate-grant")
}

test fn an_enrolment_naming_an_undeclared_mutation_refuses_by_that_name() -> Bool {
  let labels = refusal_labels(gate_coverage(one_real_gate(), [
    discharged_row("FCI-2", "duplicate-grant"),
    discharged_row("FCI-2", "work-mismatch"),
    discharged_row("FCI-2", "expired-reservation"),
    discharged_row("FCI-2", "grant-corrupt"),
  ]))
  labels.length() == 1 && any(labels, l => l == "undeclared-mutation|FCI-2|grant-corrupt")
}

// DIRECTION ZERO, WITH DESTRUCTIVE CONTROLS. The identity the whole join rests on is (gate,
// mutation), and an earlier revision policed its uniqueness only among ENROLMENT rows. A gate
// declaring one mutation twice was then answered by a SINGLE enrolment row: each declaration visit
// found exactly one match, the reverse direction saw a declared pair, and the verdict came back
// CoverageTotal with one row covering two obligations. The length-equality witness below happens to
// notice that one fixture, but it is not a located refusal and it cannot see a duplicated gate id at
// all, so the census belongs in the verdict where it can name its subject.
fn gate_with(id: NonEmptyStr, mutations: List<NonEmptyStr>) -> FabricCiGate {
  FabricCiGate {
    id: id,
    owned_question: "fixture",
    exit_predicate: "fixture",
    positive_control: "fixture",
    discriminating_mutations: mutations,
    frozen_output_identities: [],
    non_goals: [],
  }
}

test fn a_mutation_declared_twice_by_one_gate_refuses_rather_than_being_answered_once() -> Bool {
  let labels = refusal_labels(gate_coverage(
    [gate_with("FCI-X", ["duplicate-grant", "duplicate-grant"])],
    [discharged_row("FCI-X", "duplicate-grant")],
  ))
  labels.length() == 1 && any(labels, l => l == "dup-declared-mutation|FCI-X|duplicate-grant")
}

test fn two_gates_sharing_one_id_refuse_by_that_id() -> Bool {
  let labels = refusal_labels(gate_coverage(
    [gate_with("FCI-X", ["m"]), gate_with("FCI-X", ["m"])],
    [discharged_row("FCI-X", "m")],
  ))
  any(labels, l => l == "dup-gate-id|FCI-X|-")
}

// The positive control for direction zero: a well-formed authority is NOT refused by the census, so
// the two witnesses above discriminate duplication rather than reporting that the census always
// fires.
test fn a_well_formed_authority_is_not_refused_by_the_identity_census() -> Bool {
  refusal_labels(gate_coverage([gate_with("FCI-X", ["m", "n"])], [
    discharged_row("FCI-X", "m"),
    discharged_row("FCI-X", "n"),
  ])).length() == 0
}

// THE SHIPPED ROSTER IS TOTAL OVER ALL SEVEN GATES. This is the assertion that reds when somebody
// adds a discriminating mutation to gunbc.fabric_ci_program without enrolling it -- the whole point.
test fn the_shipped_enrolment_is_total_over_every_gate() -> Bool {
  refusal_labels(fabric_gate_coverage()).length() == 0
    && fabric_mutation_enrolments().length()
      == fold(fabric_ci_gates(), init: 0, f: (acc, g) => acc + g.discriminating_mutations.length())
}

// THE ROSTER IS HONEST RATHER THAN FLATTERING: it reports real remaining work, and specifically it
// reports the mutation whose coverage was once claimed in prose. A roster that discharged everything
// would satisfy the totality witness above and mean nothing, so this pins the opposite direction.
// THE PARTITION IS NOW DISCRIMINATED ON BOTH SIDES OF THE SHIPPED ROSTER. A correction to an earlier
// version of this comment: the undischarged-membership requirement below ALREADY refused an
// all-discharged roster, because it demands (FCI-2, expired-reservation) be present. A uniform
// positive population did not make it vacuous, and claiming this mixed check as the first shipped
// protection against a flattering roster was wrong. What the discharged-side conjuncts add is that
// the two promoted obligations are absent from undischarged -- which is what caught a promotion
// applied to the wrong gate.
test fn the_shipped_enrolment_reports_expired_reservation_as_undischarged() -> Bool {
  let undischarged = total_undischarged(fabric_gate_coverage())
  undischarged.length() > 0
    && any(undischarged, e => e.gate == "FCI-2" && e.mutation == "expired-reservation")
    && !any(undischarged, e => e.gate == "FCI-2" && e.mutation == "duplicate-grant")
    && !any(undischarged, e => e.gate == "FCI-2" && e.mutation == "work-mismatch")
}

// THE DISCHARGED SIDE IS PINNED AT FULL (gate, mutation, witness) IDENTITY. An earlier revision
// asserted only cardinality, gate, mutation membership and the constructor, so swapping the two
// witness strings -- or substituting any other symbol -- left it unchanged. NonEmptyStr establishes
// that a witness string is non-empty; it establishes nothing about WHICH declaration it names, and
// the binding is the entire content of a discharge.
//
// The obligation identity is the PAIR. An earlier revision of the roster promoted (FCI-1,
// work-mismatch) instead of (FCI-2, work-mismatch) because the edit keyed on the mutation SPELLING,
// which both gates declare -- FCI-1 for cell realization, FCI-2 for issuance -- and discharged a
// cell-realization obligation with an issuance witness. These assertions are what exposed it.
//
// This witness checks the PARTITION AND THE BINDING at one head. It cannot establish that a row
// changed arm BECAUSE its trigger fired: no previous roster and no transition evidence is in scope,
// so trigger satisfaction and declaration existence remain MANUALLY adjudicated until the receipt
// join exists.
fn discharged_by(v: CoverageVerdict, gate: NonEmptyStr, mutation: NonEmptyStr, expected: WitnessIdentity) -> Bool {
  match v {
    CoverageRefused { refusals } => false,
    CoverageTotal { discharged, undischarged } =>
      any(discharged, e => e.gate == gate && e.mutation == mutation && match e.discharge {
        DischargedByWitness { witness } => witness.module_path == expected.module_path && witness.function == expected.function,
        Undischarged { reason, restoration_trigger } => false,
      }),
  }
}

test fn the_discharged_rows_are_exactly_the_two_fci_2_obligations_bound_to_their_named_witnesses() -> Bool {
  match fabric_gate_coverage() {
    CoverageRefused { refusals } => false,
    CoverageTotal { discharged, undischarged } =>
      discharged.length() == 2
        && discharged_by(
             fabric_gate_coverage(),
             "FCI-2",
             "duplicate-grant",
             WitnessIdentity { module_path: "test.claim.fabric_grant_issuance_witness", function: "a_second_grant_for_one_attempt_is_refused" },
           )
        && discharged_by(
             fabric_gate_coverage(),
             "FCI-2",
             "work-mismatch",
             WitnessIdentity { module_path: "test.claim.fabric_grant_issuance_witness", function: "an_attempt_naming_another_work_is_refused" },
           ),
  }
}

// Undischarged is never a bare admission: every such row is an Undischarged CONSTRUCTOR, which is
// what carries the trigger that retires it (DESIGN 4b(2), no untracked stall).
//
// TWO CORRECTIONS LIVE IN THIS WITNESS, and both were mine. It projected the verdict to a list first,
// so a CoverageRefused -- which projects to [] -- passed by universal quantification over nothing:
// the third instance in two days of the same all([]) class, in the very module built to refuse
// unearned coverage claims. It now matches the coproduct and answers false on the refusal arm, so
// there is no empty population to defend. And it asserted reason != "" on fields already typed
// NonEmptyStr, whose non-emptiness is STRUCTURAL -- a check restating a constraint the model already
// carries is a second representation of it (DESIGN 5), permanently green and worth nothing. What is
// worth asserting is that the property was evaluated over a genuinely TOTAL verdict at all.
test fn every_undischarged_row_is_an_undischarged_constructor_over_a_total_verdict() -> Bool {
  match fabric_gate_coverage() {
    CoverageRefused { refusals } => false,
    CoverageTotal { discharged, undischarged } =>
      undischarged.length() > 0
        && all(undischarged, e => match e.discharge {
          DischargedByWitness { witness } => false,
          Undischarged { reason, restoration_trigger } => true,
        }),
  }
}

// ============================================================================
// THE ACCEPTANCE TEST FOR EARNED STANDING, stated by the reviewer who rejected the authored-only
// contract: hold the obligations and the NOMINATIONS fixed, supply matching evidence, then remove it
// or substitute wrong-subject evidence. Enrolment WELL-FORMEDNESS may remain unchanged; earned
// STANDING must not. Every witness below varies only the observation population, and the paired
// coverage assertion pins that the census really did stay unchanged -- without that pairing the test
// would pass for a construction that simply broke well-formedness too.
fn one_gate_two_obligations() -> List<FabricCiGate> {
  [gate_with("FCI-X", ["m", "n"])]
}

fn nominated_identity() -> WitnessIdentity {
  WitnessIdentity { module_path: "t", function: "w_m" }
}

fn nominated_rows() -> List<MutationEnrolment> {
  [
    MutationEnrolment { gate: "FCI-X", mutation: "m", discharge: DischargedByWitness { witness: nominated_identity() } },
    MutationEnrolment { gate: "FCI-X", mutation: "n", discharge: Undischarged { reason: "unread", restoration_trigger: "owner supplies it" } },
  ]
}

fn subject(hex: NonEmptyStr) -> Fnv1a64Structural {
  Fnv1a64Structural { digest: hex }
}

fn ledger_of(hex: NonEmptyStr) -> LedgerBinding {
  LedgerBinding {
    repository_snapshot: UnpublishedWorkingTree,
    prepared_subject: subject(hex),
  }
}

fn row_of(expectation: ClaimExpectation, terminal: ClaimAttemptTerminal) -> ClaimTerminalRow {
  ClaimTerminalRow { identity: nominated_identity(), expectation: expectation, terminal: terminal }
}

fn passing_row() -> ClaimTerminalRow {
  row_of(ExpectedToHold, Returned { observation: ObservedVerdict { holds: true } })
}

fn standing_is_refused(v: GateStandingVerdict) -> Bool {
  match v {
    StandingRefusedUnwellFormedEnrolment { refusals } => true,
    StandingRefusedLedgerIsOfAnotherSubject { observed, adjudicated } => true,
    StandingDerived { covered, uncovered } => false,
  }
}

fn covered_count(v: GateStandingVerdict) -> Int {
  match v {
    StandingRefusedUnwellFormedEnrolment { refusals } => 0,
    StandingRefusedLedgerIsOfAnotherSubject { observed, adjudicated } => 0,
    StandingDerived { covered, uncovered } => covered.length(),
  }
}

fn cause_labels(v: GateStandingVerdict) -> List<NonEmptyStr> {
  match v {
    StandingRefusedUnwellFormedEnrolment { refusals } => ["standing-refused-unwell-formed"],
    StandingRefusedLedgerIsOfAnotherSubject { observed, adjudicated } => ["standing-refused-other-subject"],
    StandingDerived { covered, uncovered } => map(uncovered, s => match s {
      Covered { gate, mutation, witness } => "covered",
      NotCovered { gate, mutation, cause } => match cause {
        NominationHasNoObservation { witness } => located("no-observation", gate, mutation),
        ObservedWrongTerminal { witness } => located("wrong-terminal", gate, mutation),
        SeveralObservationsForOneNomination { witness } => located("several-observations", gate, mutation),
        NotNominated {} => located("not-nominated", gate, mutation),
      },
    }),
  }
}

// THE ENROLMENT IS WELL-FORMED IN EVERY CASE BELOW. Pinned once so the standing witnesses cannot
// pass by having quietly broken the census instead of the evidence.
test fn the_fixture_enrolment_is_well_formed_regardless_of_evidence() -> Bool {
  refusal_labels(gate_coverage(one_gate_two_obligations(), nominated_rows())).length() == 0
}

test fn a_nomination_with_matching_evidence_earns_standing() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"), [passing_row()], subject("aaaaaaaaaaaaaaaa"))
  covered_count(v) == 1 && any(cause_labels(v), l => l == "not-nominated|FCI-X|n")
}

// EVIDENCE REMOVED -> standing collapses while well-formedness is untouched. This is the exact
// discrimination the authored-only contract could not make, and the reason it was rejected.
test fn removing_the_evidence_collapses_standing_without_touching_well_formedness() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"), [], subject("aaaaaaaaaaaaaaaa"))
  covered_count(v) == 0
    && any(cause_labels(v), l => l == "no-observation|FCI-X|m")
    && refusal_labels(gate_coverage(one_gate_two_obligations(), nominated_rows())).length() == 0
}

// WRONG-SUBJECT EVIDENCE. A ledger of another prepared subject REFUSES rather than deriving zero:
// evidence about another tree is not evidence of no coverage.
test fn a_ledger_of_another_subject_refuses_rather_than_deriving_zero() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("bbbbbbbbbbbbbbbb"), [passing_row()], subject("aaaaaaaaaaaaaaaa"))
  standing_is_refused(v) && any(cause_labels(v), l => l == "standing-refused-other-subject")
}

test fn evidence_that_errored_earns_nothing() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"),
    [row_of(ExpectedToHold, RuntimeErrored { message: "boom" })], subject("aaaaaaaaaaaaaaaa"))
  covered_count(v) == 0 && any(cause_labels(v), l => l == "wrong-terminal|FCI-X|m")
}

test fn evidence_that_was_never_attempted_earns_nothing() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"),
    [row_of(ExpectedToHold, NotAttempted { halted_by: "halt" })], subject("aaaaaaaaaaaaaaaa"))
  covered_count(v) == 0 && any(cause_labels(v), l => l == "wrong-terminal|FCI-X|m")
}

// THE EXPECTATION IS HALF THE ADEQUACY JUDGEMENT. The same observed verdict earns standing under one
// expectation and nothing under the other, which is why the ledger holds them as two fields and why
// an earlier draft of this module -- which re-minted a single flat "refused as expected" arm -- could
// not express it.
test fn a_false_verdict_earns_standing_when_expected_red_and_nothing_when_expected_to_hold() -> Bool {
  let red = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"),
    [row_of(ExpectedRed, Returned { observation: ObservedVerdict { holds: false } })], subject("aaaaaaaaaaaaaaaa"))
  let hold = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"),
    [row_of(ExpectedToHold, Returned { observation: ObservedVerdict { holds: false } })], subject("aaaaaaaaaaaaaaaa"))
  covered_count(red) == 1 && covered_count(hold) == 0
}

test fn an_unrepresentable_observation_earns_nothing() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"),
    [row_of(ExpectedToHold, Returned { observation: ObservationUnrepresentable { reason: "not-a-process-exit" } })], subject("aaaaaaaaaaaaaaaa"))
  covered_count(v) == 0 && any(cause_labels(v), l => l == "wrong-terminal|FCI-X|m")
}

test fn two_observations_for_one_nomination_earn_nothing() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"), [passing_row(), passing_row()], subject("aaaaaaaaaaaaaaaa"))
  covered_count(v) == 0 && any(cause_labels(v), l => l == "several-observations|FCI-X|m")
}

// A REFUSAL STAYS A REFUSAL: an unwell-formed enrolment refuses rather than deriving an empty
// successful population -- the absorbing-fallback shape, where "nothing covered" arrives in the same
// value a caller reads as "nothing to worry about".
test fn an_unwell_formed_enrolment_refuses_standing_rather_than_deriving_an_empty_one() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), [], ledger_of("aaaaaaaaaaaaaaaa"), [passing_row()], subject("aaaaaaaaaaaaaaaa"))
  standing_is_refused(v) && any(cause_labels(v), l => l == "standing-refused-unwell-formed")
}

// The paired positive control, without which "refuses when unwell-formed" is indistinguishable from
// "always refuses": a well-formed enrolment with no evidence DERIVES zero rather than refusing.
test fn a_well_formed_enrolment_with_no_evidence_derives_rather_than_refuses() -> Bool {
  let v = gate_standing(one_gate_two_obligations(), nominated_rows(), ledger_of("aaaaaaaaaaaaaaaa"), [], subject("aaaaaaaaaaaaaaaa"))
  !standing_is_refused(v) && covered_count(v) == 0
}
