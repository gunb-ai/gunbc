module test.claim.fabric.flex_aws_apply_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String, NonEmptyStr, Int, List }
import std.optional { Present, Absent }
import std.apply_mode { Apply }
import std.measure { second, MoneyPerHour, money_amount_micro, money_per_hour_micros }
import extdeps.currency.currency { Usd }
import extdeps.cloud.aws_ec2 {
  AwsEc2Instance, AwsEc2InstanceState, AwsEc2Placement, AwsEc2Running, AwsEc2Terminated, AwsEc2ShuttingDown, AwsEc2ActionTerminate,
  AwsEc2LaunchInline, AwsEc2SpotMarket, AwsEc2TagInstance, AwsEc2TagVolume,
}
import extdeps.cloud.aws_cli { aws_cli_run_instances, aws_cli_money_wire }
import extdeps.exec.command { argv_words }
import extdeps.cloud.aws_ec2 { AwsEc2IamInstanceProfileByName }
import product.fabric.flex_aws_row { FlexAwsCandidate, FlexAwsSpot, FlexAwsOnDemand, FlexAwsQuotaBelowVcpus }
import product.fabric.flex_ec2_boot { FlexEc2BootPolicy }
import product.fabric.flex_aws_apply {
  FlexAwsApplyPolicy, FlexAwsNotice, FlexAwsInterruptionWarning, FlexAwsRebalanceRecommendation,
  FlexAwsNoticeParsed, FlexAwsNoticeForeign, FlexAwsNoticeUnreadable,
  FlexAwsRelease, FlexAwsLaunch, FlexAwsHold, FlexAwsReleaseLifetimeSpent, FlexAwsReleaseSurplus,
  FlexAwsReleaseLaunchTimeUnreadable, FlexAwsDemandFixed, FlexAwsDemandRouter,
  flex_aws_read_notice, flex_aws_decide, flex_aws_run_request,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED at the decision's interface: the candidates the screen produced, the owned roster and the
// notices, as values. The real producers are witnessed elsewhere (test.claim.fabric.flex_aws_row_witness
// for the screen, test.claim.cloud.aws_cli_projection_witness for the readers); the inhabitance run is the
// live pass receipt of gunbc.fleet.flex_aws_pass.

fn rate(micros: Int) -> MoneyPerHour { MoneyPerHour { amount: money_amount_micro(count: micros), currency: Usd } }

data policy: FlexAwsApplyPolicy = FlexAwsApplyPolicy {
  actuation: Apply,
  region: "us-east-1" as NonEmptyStr,
  instance_type: "g7e.2xlarge" as NonEmptyStr,
  liability_ceiling: money_amount_micro(count: 50000000),
  lifetime: second(count: 14400),
}

fn cand(zone: String, micros: Int) -> FlexAwsCandidate {
  FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: zone as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: micros) }, per_gpu_hour_micros: Present { value: micros }, walls: [] }
}

fn card(id: String, launched: String) -> AwsEc2Instance {
  AwsEc2Instance {
    instance_id: id as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
    state: AwsEc2InstanceState { code: 16, name: AwsEc2Running },
    state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
    launch_time: launched, public_ip_address: none, tags: [],
  }
}

// 2026-11-25T03:00:00Z
data now_unix: Int = 1795575600

// THE NOTICES, as EventBridge delivers them to the queue (the envelope's fields the reader uses).
test fn the_two_events_parse_and_anything_else_does_not() -> Bool {
  (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Spot Instance Interruption Warning\",\"source\":\"aws.ec2\",\"detail\":\{\"instance-id\":\"i-0abc\",\"instance-action\":\"terminate\"}}") {
    FlexAwsNoticeParsed { notice: FlexAwsInterruptionWarning { instance_id: i, action: AwsEc2ActionTerminate } } => (i as String) == "i-0abc"
    _ => false
  })
  && (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Instance Rebalance Recommendation\",\"source\":\"aws.ec2\",\"detail\":\{\"instance-id\":\"i-0abc\"}}") {
    FlexAwsNoticeParsed { notice: FlexAwsRebalanceRecommendation { instance_id: i } } => (i as String) == "i-0abc"
    _ => false
  })
  && (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Instance State-change Notification\",\"detail\":\{\"instance-id\":\"i-0abc\"}}") { FlexAwsNoticeForeign { detail_type: _ } => true  _ => false })
  && (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Spot Instance Interruption Warning\",\"detail\":\{\"instance-id\":\"i-0abc\"}}") { FlexAwsNoticeUnreadable { cause: c } => c.contains("instance-action")  _ => false })
  && (match flex_aws_read_notice(body: "not json") { FlexAwsNoticeUnreadable { cause: _ } => true  _ => false })
}

// With no card and room for one, the cheapest admissible candidate launches at its own rate as MaxPrice.
test fn an_empty_pool_launches_the_cheapest_admissible_card() -> Bool {
  match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1c", micros: 2719400), cand(zone: "us-east-1b", micros: 2350500)], owned: [], notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: m, fallbacks: f } => ((c.zone as String) == "us-east-1b") && (money_per_hour_micros(q: m) == 2350500) && (map(f, x => x.zone as String) == ["us-east-1c"])
    _ => false
  }
}

// REDs of admission: a walled candidate, an on-demand one, another size, and one whose rate times the
// four-hour lifetime exceeds the 50 USD ceiling (13 USD/h x 4 h = 52 USD) are all refused; the pass holds.
test fn walled_on_demand_wrong_size_and_over_ceiling_candidates_hold() -> Bool {
  let walled = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1a" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: none, walls: [FlexAwsQuotaBelowVcpus { quota_vcpus: 0, needs: 8 }] }
  let on_demand = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1a" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsOnDemand, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: none, walls: [] }
  let other_size = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1a" as NonEmptyStr, instance_type: "g7e.4xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 16, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: none, walls: [] }
  match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [walled, on_demand, other_size, cand(zone: "us-east-1d", micros: 13000000)], owned: [], notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("no admissible candidate")
    _ => false
  }
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1d", micros: 12500000)], owned: [], notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// CARDS ARE DISPOSABLE: an interruption warning does not release the card (AWS reclaims it); it stops
// counting, and its replacement is asked for at once in ANOTHER zone first, the warned card's zone last.
test fn an_interruption_warning_asks_for_a_replacement_elsewhere() -> Bool {
  let warned = FlexAwsInterruptionWarning { instance_id: "i-0abc" as NonEmptyStr, action: AwsEc2ActionTerminate }
  match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500), cand(zone: "us-east-1c", micros: 2719400)], owned: [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")], notices: [warned], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: f } => ((c.zone as String) == "us-east-1c") && (map(f, x => x.zone as String) == ["us-east-1b"])
    _ => false
  }
}

// DEMAND IS THE ROUTER'S: stranded conversations ask for a card only when the rented pool is full (or there
// is none, as after a card dies and takes its row with it); stranded demand beside a pool with room holds;
// no card is asked for past the ceiling.
test fn stranded_demand_rents_only_when_the_rented_pool_is_full_or_gone() -> Bool {
  let cs = [cand(zone: "us-east-1b", micros: 2350500)]
  let one = [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")]
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandRouter { stranded: 57, rented_active: 0, rented_cap: 0, max_cards: 3 }, candidates: cs, owned: [], notices: [], spot_quota_vcpus: 24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandRouter { stranded: 57, rented_active: 4, rented_cap: 4, max_cards: 3 }, candidates: cs, owned: one, notices: [], spot_quota_vcpus: 24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandRouter { stranded: 57, rented_active: 2, rented_cap: 4, max_cards: 3 }, candidates: cs, owned: one, notices: [], spot_quota_vcpus: 24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("wanted=1")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandRouter { stranded: 0, rented_active: 0, rented_cap: 0, max_cards: 3 }, candidates: cs, owned: [], notices: [], spot_quota_vcpus: 24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("wanted=0")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandRouter { stranded: 57, rented_active: 0, rented_cap: 0, max_cards: 0 }, candidates: cs, owned: [], notices: [], spot_quota_vcpus: 24, now_unix: now_unix) {
    FlexAwsHold { why: _ } => true
    _ => false
  })
}

// A REBALANCE RECOMMENDATION keeps the card serving but stops it counting, so its replacement is asked
// for; without the recommendation the same pool holds.
test fn a_rebalance_recommendation_asks_for_a_replacement_and_keeps_serving() -> Bool {
  let owned = [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")]
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1c", micros: 2719400)], owned: owned, notices: [FlexAwsRebalanceRecommendation { instance_id: "i-0abc" as NonEmptyStr }], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: _ } => (c.zone as String) == "us-east-1c"
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1c", micros: 2719400)], owned: owned, notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsHold { why: _ } => true
    _ => false
  })
}

// THE LIFETIME BOUND: a card older than four hours is released; a card whose launch time cannot be read
// is released rather than kept unbounded; a terminated card neither counts nor is released.
test fn a_spent_or_unreadable_lifetime_releases_and_a_dead_card_is_ignored() -> Bool {
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [], owned: [card(id: "i-0old", launched: "2026-11-24T22:59:00+00:00")], notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsRelease { instance_id: i, why: FlexAwsReleaseLifetimeSpent { age_seconds: a } } => ((i as String) == "i-0old") && (a == 14460)
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [], owned: [card(id: "i-0bad", launched: "yesterday")], notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsRelease { instance_id: _, why: FlexAwsReleaseLaunchTimeUnreadable { launch_time: _ } } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500)], owned: [AwsEc2Instance {
      instance_id: "i-0dead" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
      placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
      state: AwsEc2InstanceState { code: 48, name: AwsEc2Terminated },
      state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
      launch_time: "2026-11-24T00:00:00+00:00", public_ip_address: none, tags: [],
    }], notices: [], spot_quota_vcpus: 16, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// THE REQUEST ON THE WIRE: spot one-time/terminate, MaxPrice the admitted rate in six digits, the owner tag
// on the instance and the volume, inline launch data with the card role, and no credential in argv.
test fn the_launch_argv_is_tagged_spot_at_the_admitted_rate() -> Bool {
  let boot = FlexEc2BootPolicy {
    ssm_key_prefix: "/gunbc-flex/pool-key" as NonEmptyStr, cert_prefix: "/gunbc-flex/card-cert" as NonEmptyStr,
    bucket_parameter: "/gunbc-flex/weights-bucket" as NonEmptyStr, key_wait: second(count: 600), root_volume_gib: 150,
    instance_profile: AwsEc2IamInstanceProfileByName { name: "gunbc-flex-card" as NonEmptyStr },
  }
  let request = flex_aws_run_request(candidate: cand(zone: "us-east-1b", micros: 2350500), max_price: rate(micros: 2350500), ami: "ami-0ba1ac2e319bff082" as NonEmptyStr, user_data: "#!/bin/bash\ntrue\n", boot: boot, subnet_id: "subnet-0c20b51dafdea4021" as NonEmptyStr, security_group_id: "sg-0c7d008b7591fca04" as NonEmptyStr, client_token: "gunbc-flex-us-east-1b-29926260" as NonEmptyStr)
  let argv = join(argv_words(command: aws_cli_run_instances(credentials_file: "/etc/gunbc-flex/aws-credentials", region: "us-east-1" as NonEmptyStr, request: request)), " ")
  (aws_cli_money_wire(m: rate(micros: 2350500)) == "2.350500")
    && (aws_cli_money_wire(m: rate(micros: 7)) == "0.000007")
    && argv.contains("\"MarketType\": \"spot\"")
    && argv.contains("\"MaxPrice\": \"2.350500\"")
    && argv.contains("\"InstanceInterruptionBehavior\": \"terminate\"")
    && argv.contains("\"ResourceType\": \"volume\"")
    && argv.contains("gunbc-flex-owner")
    && argv.contains("--iam-instance-profile")
    && argv.contains("--count 1:1")
    && !argv.contains("aws_secret_access_key")
}

// QUOTA HELD BY OUR OWN CARDS: with an 8-vCPU quota, a card still shutting down holds all of it, so the
// replacement is not asked for until it is gone; the same pool with the card terminated launches.
test fn a_card_still_shutting_down_holds_the_quota() -> Bool {
  let dying = AwsEc2Instance {
    instance_id: "i-0dying" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
    state: AwsEc2InstanceState { code: 32, name: AwsEc2ShuttingDown },
    state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
    launch_time: "2026-11-25T02:50:32+00:00", public_ip_address: none, tags: [],
  }
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500)], owned: [dying], notices: [], spot_quota_vcpus: 8, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("0 spot vCPUs")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500)], owned: [], notices: [], spot_quota_vcpus: 8, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}
