import std.apply_mode { Apply }
import std.measure { second, MoneyPerHour, money_amount_micro, money_per_hour_micros }
import extdeps.currency.currency { Usd }
import extdeps.cloud.aws_ec2 {
  AwsEc2Instance, AwsEc2InstanceState, AwsEc2Placement, AwsEc2Running, AwsEc2Terminated, AwsEc2ShuttingDown, AwsEc2ActionTerminate,
  AwsEc2LaunchInline, AwsEc2SpotMarket, AwsEc2TagInstance, AwsEc2TagVolume, AwsEc2Tag,
}
import extdeps.cloud.aws_cli { aws_cli_run_instances, aws_cli_money_wire }
import extdeps.exec.command { argv_words }
import extdeps.cloud.aws_ec2 { AwsEc2IamInstanceProfileByName }
import product.fabric.flex_aws_row { FlexAwsCandidate, FlexAwsSpot, FlexAwsOnDemand, FlexAwsQuotaBelowVcpus }
import product.fabric.flex_ec2_boot { FlexEc2BootPolicy }
import product.fabric.flex_aws_apply {
  FlexAwsApplyPolicy, FlexAwsNotice, FlexAwsInterruptionWarning, FlexAwsRebalanceRecommendation,
  FlexAwsNoticeParsed, FlexAwsNoticeForeign, FlexAwsNoticeUnreadable,
  FlexAwsDrain, FlexAwsTerminate, FlexAwsLaunch, FlexAwsHold, FlexAwsDemand, FlexAwsDemandFixed, FlexAwsDemandRouter, FlexAwsRegionQuota,
  FlexAwsDrainIdle, FlexAwsDrainSurplus, FlexAwsTerminateDrained, FlexAwsTerminateDrainTimedOut,
  FlexAwsTerminateDrainMarkUnreadable, FlexAwsTerminateNeverReady, FlexAwsMarkWrite, FlexAwsMarkSet, FlexAwsMarkClear,
  flex_aws_mark_unready, flex_aws_mark_idle, flex_aws_mark_drain, flex_aws_mark_noticed,
  flex_aws_read_notice, flex_aws_decide, flex_aws_run_request, flex_aws_marks, flex_aws_notice_marks, flex_aws_with_marks, flex_aws_steady,
  FlexAwsOutstanding, flex_aws_notices_held, flex_aws_notice_settled,
}
import gunbc.serving.flex_aws_router_rows { FlexAwsRouterReading, FlexAwsCardUse }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUPPLIED at the decision's interface: the candidates the screen produced, the owned roster and the
// notices, as values. The real producers are witnessed elsewhere (test.claim.fabric.flex_aws_row_witness
// for the screen, test.claim.cloud.aws_cli_projection_witness for the readers); the inhabitance run is the
// live pass receipt of gunbc.fleet.flex_aws_pass.

fn rate(micros: Int) -> MoneyPerHour { MoneyPerHour { amount: money_amount_micro(count: micros), currency: Usd } }

data policy: FlexAwsApplyPolicy = FlexAwsApplyPolicy {
  actuation: Apply,
  gpus_per_card: 1,
  // Claims about notices, walls and regions run under a ceiling that never binds; the burn claim below
  // builds the operator's $5/h policy itself.
  burn_ceiling: rate(micros: 100000000),
  idle_window: second(count: 1800),
  drain_timeout: second(count: 600),
  boot_deadline: second(count: 2700),
}

fn cand(zone: String, micros: Int) -> FlexAwsCandidate {
  FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: zone as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: micros) }, per_gpu_hour_micros: Present { value: micros }, walls: [] }
}

fn card(id: String, launched: String) -> AwsEc2Instance {
  AwsEc2Instance {
    instance_id: id as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
    state: AwsEc2InstanceState { code: 16, name: AwsEc2Running },
    state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
    launch_time: launched, public_ip_address: none, tags: [],
  }
}

fn tagged(id: String, tags: List<AwsEc2Tag>) -> AwsEc2Instance {
  AwsEc2Instance {
    instance_id: id as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
    state: AwsEc2InstanceState { code: 16, name: AwsEc2Running },
    state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
    launch_time: "2026-11-25T02:30:00+00:00", public_ip_address: none, tags: tags,
  }
}

fn tag_at(key: NonEmptyStr, unix: Int) -> AwsEc2Tag { AwsEc2Tag { key: key, value: to_string(unix) } }

fn card_use(id: String, enrolled: Bool, in_flight: Int, seen: Int) -> FlexAwsCardUse { FlexAwsCardUse { instance_id: id as NonEmptyStr, enrolled: enrolled, in_flight: in_flight, seen_recent: seen } }

// The router's reading in the shape the decision cares about: a waiter another rented card would serve, which the
// router counts as unplaceable when no rented row admits it -- here, when the rented pool's turns meet its cap (cap
// 0: no rented row is routed) -- the rows it routes, and our cards' use.
fn router(waiting: Bool, active: Int, cap: Int, uses: List<FlexAwsCardUse>) -> FlexAwsDemand {
  FlexAwsDemandRouter { router: FlexAwsRouterReading { unplaceable: if waiting && ((cap == 0) || (active >= cap)) { 1 } else { 0 }, rows: if cap == 0 { [] } else { ["aws-i-0row"] }, cards: uses }, max_cards: 3 }
}

fn idle_for(seconds: Int) -> AwsEc2Instance { tagged(id: "i-0idle", tags: [tag_at(key: flex_aws_mark_idle, unix: now_unix - seconds)]) }
fn draining(seconds: Int) -> AwsEc2Instance { tagged(id: "i-0dr", tags: [tag_at(key: flex_aws_mark_drain, unix: now_unix - seconds)]) }
fn unready_for(seconds: Int) -> AwsEc2Instance { tagged(id: "i-0slow", tags: [tag_at(key: flex_aws_mark_unready, unix: now_unix - seconds)]) }

data quota24: List<FlexAwsRegionQuota> = [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 24 }]

// 2026-11-25T03:00:00Z
data now_unix: Int = 1795575600

// THE NOTICES, as EventBridge delivers them to the queue (the envelope's fields the reader uses).
test fn the_two_events_parse_and_anything_else_does_not() -> Bool {
  (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Spot Instance Interruption Warning\",\"source\":\"aws.ec2\",\"detail\":\{\"instance-id\":\"i-0abc\",\"instance-action\":\"terminate\"}}") {
    FlexAwsNoticeParsed { notice: FlexAwsInterruptionWarning { instance_id: i, action: AwsEc2ActionTerminate } } => (i as String) == "i-0abc"
    _ => false
  })
  && (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Instance Rebalance Recommendation\",\"source\":\"aws.ec2\",\"detail\":\{\"instance-id\":\"i-0abc\"}}") {
    FlexAwsNoticeParsed { notice: FlexAwsRebalanceRecommendation { instance_id: i } } => (i as String) == "i-0abc"
    _ => false
  })
  && (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Instance State-change Notification\",\"detail\":\{\"instance-id\":\"i-0abc\"}}") { FlexAwsNoticeForeign { detail_type: _ } => true  _ => false })
  && (match flex_aws_read_notice(body: "\{\"detail-type\":\"EC2 Spot Instance Interruption Warning\",\"detail\":\{\"instance-id\":\"i-0abc\"}}") { FlexAwsNoticeUnreadable { cause: c } => c.contains("instance-action")  _ => false })
  && (match flex_aws_read_notice(body: "not json") { FlexAwsNoticeUnreadable { cause: _ } => true  _ => false })
}

// With no card and room for one, the cheapest admissible candidate launches at its own rate as MaxPrice.
test fn an_empty_pool_launches_the_cheapest_admissible_card() -> Bool {
  match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1c", micros: 2719400), cand(zone: "us-east-1b", micros: 2350500)], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 16 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: m, fallbacks: f } => ((c.zone as String) == "us-east-1b") && (money_per_hour_micros(q: m) == 2350500) && (map(f, x => x.zone as String) == ["us-east-1c"])
    _ => false
  }
}

// REDs of admission: a walled candidate, an on-demand one, a two-GPU size, and one with no price are all
// refused, and the pass holds; the same card priced is admitted.
test fn walled_on_demand_wrong_size_and_unpriced_candidates_hold() -> Bool {
  let walled = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1a" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: none, walls: [FlexAwsQuotaBelowVcpus { quota_vcpus: 0, needs: 8 }] }
  let on_demand = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1a" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsOnDemand, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: none, walls: [] }
  let other_size = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1a" as NonEmptyStr, instance_type: "g7e.12xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 2, vcpus: 48, rate: Present { value: rate(micros: 1000000) }, per_gpu_hour_micros: none, walls: [] }
  let unpriced = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1d" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: none, per_gpu_hour_micros: none, walls: [] }
  match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [walled, on_demand, other_size, unpriced], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 16 }], now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("no admissible candidate")
    _ => false
  }
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1d", micros: 12500000)], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 16 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// CARDS ARE DISPOSABLE: a notice becomes the card's drain and noticed marks (persisted on the card, so a
// later pass that receives nothing still sees the withdrawal); the withdrawn card stops counting and its
// replacement is asked for at once in ANOTHER zone first, the noticed card's zone last.
fn warned_and_marked() -> AwsEc2Instance {
  let warned = FlexAwsInterruptionWarning { instance_id: "i-0abc" as NonEmptyStr, action: AwsEc2ActionTerminate }
  let owned = [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")]
  match flex_aws_with_marks(owned: owned, written: flex_aws_notice_marks(owned: owned, notices: [warned], now_unix: now_unix)).first() {
    Present { value: i } => i
    Absent => card(id: "i-0none", launched: "2026-11-25T02:30:00+00:00")
  }
}

test fn an_interruption_warning_asks_for_a_replacement_elsewhere() -> Bool {
  // The warned card's turns are still finishing (2 in flight, its row withdrawn), and a waiter is stranded.
  let finishing = router(waiting: true, active: 0, cap: 0, uses: [card_use(id: "i-0abc", enrolled: false, in_flight: 2, seen: 2)])
  match flex_aws_decide(policy: policy, demand: finishing, candidates: [cand(zone: "us-east-1b", micros: 2350500), cand(zone: "us-east-1c", micros: 2719400)], owned: [warned_and_marked()], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 16 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: f } => ((c.zone as String) == "us-east-1c") && (map(f, x => x.zone as String) == ["us-east-1b"])
    _ => false
  }
}

// THE WITHDRAWAL OUTLIVES THE MESSAGE (review of fb2594de: the warning, hidden by the queue's visibility
// timeout on the next receive, let the card re-enter the router a tick later). Pass one marks the card; pass
// two receives NO notice and the card is still withdrawn -- not steady, and its notice is not re-marked.
test fn a_warning_followed_by_an_empty_receive_keeps_the_card_withdrawn() -> Bool {
  let marked = warned_and_marked()
  (count(flex_aws_steady(owned: [marked])) == 0)
    && (count(flex_aws_notice_marks(owned: [marked], notices: [FlexAwsInterruptionWarning { instance_id: "i-0abc" as NonEmptyStr, action: AwsEc2ActionTerminate }], now_unix: now_unix + 30)) == 0)
    && (count(flex_aws_steady(owned: [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")])) == 1)
}

// DEMAND IS THE ROUTER'S: a waiter a rented card could take asks for a card only when the rented pool is
// full (or gone, as after a card dies and takes its row with it); the same waiter beside a pool with room
// holds; waiters bound to their own engines ask for nothing; no card is asked for past the ceiling.
test fn rentable_waiters_rent_only_when_the_rented_pool_is_full_or_gone() -> Bool {
  let cs = [cand(zone: "us-east-1b", micros: 2350500)]
  (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 0, cap: 0, uses: []), candidates: cs, owned: [], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 4, cap: 4, uses: [card_use(id: "i-0abc", enrolled: true, in_flight: 4, seen: 6)]), candidates: cs, owned: [tagged(id: "i-0abc", tags: [])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 2, cap: 4, uses: [card_use(id: "i-0abc", enrolled: true, in_flight: 2, seen: 3)]), candidates: cs, owned: [tagged(id: "i-0abc", tags: [])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("wanted=1")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: false, active: 0, cap: 0, uses: []), candidates: cs, owned: [], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("wanted=0")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandRouter { router: FlexAwsRouterReading { unplaceable: 1, rows: [], cards: [] }, max_cards: 0 }, candidates: cs, owned: [], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: _ } => true
    _ => false
  })
}

// THE OVERSHOOT RED (observed 2026-11-25 13:21-13:32): a card still booting is not in the router, so the
// router reports no rented pool and keeps asking. That ask is already answered by the booting card, so the
// pass holds instead of launching a second; once the card is enrolled and its pool fills, a second is asked.
test fn a_booting_card_answers_the_ask_it_was_launched_for() -> Bool {
  let cs = [cand(zone: "us-east-1b", micros: 2350500), cand(zone: "us-east-1c", micros: 2719400)]
  (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 0, cap: 0, uses: [card_use(id: "i-0boot", enrolled: false, in_flight: 0, seen: 0)]), candidates: cs, owned: [tagged(id: "i-0boot", tags: [tag_at(key: flex_aws_mark_unready, unix: now_unix - 300)])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("steady=1 outstanding=0 wanted=1")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 4, cap: 4, uses: [card_use(id: "i-0boot", enrolled: true, in_flight: 4, seen: 5)]), candidates: cs, owned: [tagged(id: "i-0boot", tags: [])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// A REBALANCE RECOMMENDATION withdraws the card the same way (the router and the count read one mark): it
// is drained, its replacement asked for elsewhere, and it is terminated once its running turns finish.
test fn a_rebalance_recommendation_drains_the_card_and_asks_for_a_replacement() -> Bool {
  let owned = [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")]
  let marked = flex_aws_with_marks(owned: owned, written: flex_aws_notice_marks(owned: owned, notices: [FlexAwsRebalanceRecommendation { instance_id: "i-0abc" as NonEmptyStr }], now_unix: now_unix))
  let finishing = router(waiting: true, active: 0, cap: 0, uses: [card_use(id: "i-0abc", enrolled: false, in_flight: 1, seen: 1)])
  (match flex_aws_decide(policy: policy, demand: finishing, candidates: [cand(zone: "us-east-1b", micros: 2350500), cand(zone: "us-east-1c", micros: 2719400)], owned: marked, outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 16 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: _ } => (c.zone as String) == "us-east-1c"
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500), cand(zone: "us-east-1c", micros: 2719400)], owned: owned, outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 16 }], now_unix: now_unix) {
    FlexAwsHold { why: _ } => true
    _ => false
  })
}

// THE CEILING IS ON CARDS RUNNING (review of fb2594de): three live cards, one withdrawn by a warning and still
// running, two enrolled and full, and a waiter a rented card could serve -- demand wants a third steady card,
// but a fourth would run at once with the warned one, so the pass holds at the ceiling.
test fn a_withdrawn_card_still_running_counts_against_the_ceiling() -> Bool {
  let full = router(waiting: true, active: 8, cap: 8, uses: [card_use(id: "i-0a", enrolled: true, in_flight: 4, seen: 4), card_use(id: "i-0b", enrolled: true, in_flight: 4, seen: 4), card_use(id: "i-0w", enrolled: false, in_flight: 1, seen: 1)])
  let three = [tagged(id: "i-0a", tags: []), tagged(id: "i-0b", tags: []), tagged(id: "i-0w", tags: [tag_at(key: flex_aws_mark_drain, unix: now_unix - 20), tag_at(key: flex_aws_mark_noticed, unix: now_unix - 20)])]
  (match flex_aws_decide(policy: policy, demand: full, candidates: [cand(zone: "us-east-1c", micros: 2719400), cand(zone: "us-east-1b", micros: 2350500)], owned: three, outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 48 }], now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("at the card ceiling: live=3 outstanding=0 of 3")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: full, candidates: [cand(zone: "us-east-1c", micros: 2719400), cand(zone: "us-east-1b", micros: 2350500)], owned: [tagged(id: "i-0a", tags: []), tagged(id: "i-0b", tags: [])], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 48 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// AN ACTIVE CARD IS NEVER DRAINED AS IDLE (review of fb2594de): the idle clock has run the whole window, but
// the card took a turn this tick -- the pass's own bookkeeping clears the clock, and the decision, reading the
// card's use now, keeps it. Without the clear the decision still keeps it, because it is not idle now.
test fn a_card_used_this_tick_is_not_drained_however_old_its_idle_clock() -> Bool {
  let used = router(waiting: false, active: 1, cap: 4, uses: [card_use(id: "i-0idle", enrolled: true, in_flight: 1, seen: 1)])
  let owned = [idle_for(seconds: 3600)]
  let cleared = flex_aws_with_marks(owned: owned, written: flex_aws_marks(demand: used, owned: owned, now_unix: now_unix))
  (match flex_aws_decide(policy: policy, demand: used, candidates: [], owned: owned, outstanding: [], quotas: quota24, now_unix: now_unix) { FlexAwsDrain { instance_id: _, why: _ } => false  _ => true })
    && (match flex_aws_decide(policy: policy, demand: used, candidates: [], owned: cleared, outstanding: [], quotas: quota24, now_unix: now_unix) { FlexAwsDrain { instance_id: _, why: _ } => false  _ => true })
    && !any(cleared, i => any(i.tags, t => (t.key as String) == (flex_aws_mark_idle as String)))
}

// IDLE RELEASE: an enrolled card unused for the whole window is drained, never one second sooner, and not
// while demand is asking; a terminated card neither counts nor is let go.
test fn an_idle_card_is_drained_after_the_window_and_a_dead_card_is_ignored() -> Bool {
  let quiet = router(waiting: false, active: 0, cap: 4, uses: [card_use(id: "i-0idle", enrolled: true, in_flight: 0, seen: 0)])
  (match flex_aws_decide(policy: policy, demand: quiet, candidates: [], owned: [idle_for(1800)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsDrain { instance_id: i, why: FlexAwsDrainIdle { idle_seconds: a } } => ((i as String) == "i-0idle") && (a == 1800)
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: quiet, candidates: [], owned: [idle_for(1799)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 0, cap: 0, uses: [card_use(id: "i-0idle", enrolled: true, in_flight: 0, seen: 0)]), candidates: [], owned: [idle_for(3600)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsDrain { instance_id: _, why: _ } => false
    _ => true
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500)], owned: [AwsEc2Instance {
      instance_id: "i-0dead" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
      placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
      state: AwsEc2InstanceState { code: 48, name: AwsEc2Terminated },
      state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
      launch_time: "2026-11-25T00:00:00+00:00", public_ip_address: none, tags: [tag_at(key: flex_aws_mark_idle, unix: 0)],
    }], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// DRAIN, THEN TERMINATE: a draining card is terminated once the router has withdrawn it and nothing of it
// is in flight; while a turn runs it is kept, up to the drain timeout; a drain mark that does not read is
// terminated rather than guessed. A draining card does not count, so its replacement can be asked for.
test fn a_drained_card_terminates_only_when_its_turns_finish_or_time_runs_out() -> Bool {
  let gone = router(waiting: false, active: 0, cap: 0, uses: [card_use(id: "i-0dr", enrolled: false, in_flight: 0, seen: 2)])
  let busy = router(waiting: false, active: 0, cap: 0, uses: [card_use(id: "i-0dr", enrolled: false, in_flight: 2, seen: 2)])
  (match flex_aws_decide(policy: policy, demand: gone, candidates: [], owned: [draining(40)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: i, why: FlexAwsTerminateDrained { drain_seconds: d } } => ((i as String) == "i-0dr") && (d == 40)
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: busy, candidates: [], owned: [draining(40)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("steady=0")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: busy, candidates: [], owned: [draining(600)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: _, why: FlexAwsTerminateDrainTimedOut { drain_seconds: d } } => d == 600
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: busy, candidates: [], owned: [tagged(id: "i-0dr", tags: [AwsEc2Tag { key: flex_aws_mark_drain, value: "soon" }])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: _, why: FlexAwsTerminateDrainMarkUnreadable { value: v } } => v == "soon"
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 0, cap: 0, uses: [card_use(id: "i-0dr", enrolled: false, in_flight: 2, seen: 2)]), candidates: [cand(zone: "us-east-1b", micros: 2350500), cand(zone: "us-east-1c", micros: 2719400)], owned: [draining(40)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// THE BOOT DEADLINE: a card out of the router since its unready mark for the whole deadline is terminated
// (it carries nothing, so it is not drained); one second short it is kept; a card the router lists is
// never judged by that clock.
test fn a_card_never_ready_by_its_deadline_is_terminated() -> Bool {
  let out = router(waiting: false, active: 0, cap: 0, uses: [card_use(id: "i-0slow", enrolled: false, in_flight: 0, seen: 0)])
  (match flex_aws_decide(policy: policy, demand: out, candidates: [], owned: [unready_for(2700)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: i, why: FlexAwsTerminateNeverReady { unready_seconds: u } } => ((i as String) == "i-0slow") && (u == 2700)
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: out, candidates: [], owned: [unready_for(2699)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: router(waiting: false, active: 1, cap: 4, uses: [card_use(id: "i-0slow", enrolled: true, in_flight: 1, seen: 1)]), candidates: [], owned: [unready_for(9000)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: _, why: _ } => false
    _ => true
  })
}

// THE MARKS: a card out of the router starts its unready clock and loses it once enrolled; an enrolled card
// with nothing in flight and no conversation seen starts its idle clock and loses it once used; a fixed
// count reads no use and starts no clock.
fn mark_set_of(ms: List<FlexAwsMarkWrite>, key: NonEmptyStr) -> Bool {
  (count(ms) == 1) && match ms.first() {
    Present { value: FlexAwsMarkSet { instance_id: _, key: k, unix: t } } => ((k as String) == (key as String)) && (t == now_unix)
    _ => false
  }
}

fn mark_clear_of(ms: List<FlexAwsMarkWrite>, key: NonEmptyStr) -> Bool {
  (count(ms) == 1) && match ms.first() {
    Present { value: FlexAwsMarkClear { instance_id: _, key: k } } => (k as String) == (key as String)
    _ => false
  }
}

test fn the_marks_start_and_clear_each_clock() -> Bool {
  let fresh = tagged(id: "i-0m", tags: [])
  let unready = tagged(id: "i-0m", tags: [tag_at(key: flex_aws_mark_unready, unix: now_unix - 60)])
  let idle = tagged(id: "i-0m", tags: [tag_at(key: flex_aws_mark_idle, unix: now_unix - 60)])
  mark_set_of(ms: flex_aws_marks(demand: router(waiting: false, active: 0, cap: 0, uses: [card_use(id: "i-0m", enrolled: false, in_flight: 0, seen: 0)]), owned: [fresh], now_unix: now_unix), key: flex_aws_mark_unready)
  && mark_clear_of(ms: flex_aws_marks(demand: router(waiting: false, active: 0, cap: 4, uses: [card_use(id: "i-0m", enrolled: true, in_flight: 1, seen: 1)]), owned: [unready], now_unix: now_unix), key: flex_aws_mark_unready)
  && mark_set_of(ms: flex_aws_marks(demand: router(waiting: false, active: 0, cap: 4, uses: [card_use(id: "i-0m", enrolled: true, in_flight: 0, seen: 0)]), owned: [fresh], now_unix: now_unix), key: flex_aws_mark_idle)
  && mark_clear_of(ms: flex_aws_marks(demand: router(waiting: false, active: 0, cap: 4, uses: [card_use(id: "i-0m", enrolled: true, in_flight: 0, seen: 3)]), owned: [idle], now_unix: now_unix), key: flex_aws_mark_idle)
  && (count(flex_aws_marks(demand: FlexAwsDemandFixed { cards: 1 }, owned: [fresh], now_unix: now_unix)) == 0)
}

// THE REQUEST ON THE WIRE: spot one-time/terminate, MaxPrice the admitted rate in six digits, the owner tag
// on the instance and the volume, inline launch data with the card role, and no credential in argv.
test fn the_launch_argv_is_tagged_spot_at_the_admitted_rate() -> Bool {
  let boot = FlexEc2BootPolicy {
    ssm_key_prefix: "/gunbc-flex/pool-key" as NonEmptyStr, cert_prefix: "/gunbc-flex/card-cert" as NonEmptyStr,
    bucket_parameter: "/gunbc-flex/weights-bucket" as NonEmptyStr, key_wait: second(count: 600),
    heartbeat_parameter: "/gunbc-flex/heartbeat" as NonEmptyStr, heartbeat_stale: second(count: 1800), root_volume_gib: 150,
    instance_profile: AwsEc2IamInstanceProfileByName { name: "gunbc-flex-card" as NonEmptyStr },
  }
  let request = flex_aws_run_request(instance_type: "g7e.2xlarge" as NonEmptyStr, max_price: rate(micros: 2350500), ami: "ami-0ba1ac2e319bff082" as NonEmptyStr, user_data: "#!/bin/bash\ntrue\n", boot: boot, subnet_id: "subnet-0c20b51dafdea4021" as NonEmptyStr, security_group_id: "sg-0c7d008b7591fca04" as NonEmptyStr, client_token: "gunbc-flex-us-east-1b-29926260" as NonEmptyStr)
  let argv = join(argv_words(command: aws_cli_run_instances(credentials_file: "/etc/gunbc-flex/aws-credentials", region: "us-east-1" as NonEmptyStr, request: request)), " ")
  (aws_cli_money_wire(m: rate(micros: 2350500)) == "2.350500")
    && (aws_cli_money_wire(m: rate(micros: 7)) == "0.000007")
    && argv.contains("\"MarketType\": \"spot\"")
    && argv.contains("\"MaxPrice\": \"2.350500\"")
    && argv.contains("\"InstanceInterruptionBehavior\": \"terminate\"")
    && argv.contains("\"ResourceType\": \"volume\"")
    && argv.contains("gunbc-flex-owner")
    && argv.contains("--iam-instance-profile")
    && argv.contains("--count 1:1")
    && !argv.contains("aws_secret_access_key")
}

// QUOTA HELD BY OUR OWN CARDS: with an 8-vCPU quota, a card still shutting down holds all of it, so the
// replacement is not asked for until it is gone; the same pool with the card terminated launches.
test fn a_card_still_shutting_down_holds_the_quota() -> Bool {
  let dying = AwsEc2Instance {
    instance_id: "i-0dying" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr,
    placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr },
    state: AwsEc2InstanceState { code: 32, name: AwsEc2ShuttingDown },
    state_reason: none, instance_lifecycle: none, spot_instance_request_id: none,
    launch_time: "2026-11-25T02:50:32+00:00", public_ip_address: none, tags: [],
  }
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500)], owned: [dying], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 8 }], now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("inside its region's free spot vCPUs")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2350500)], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 8 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// THE CHEAPEST SINGLE-GPU SIZE WINS: a 4xlarge cheaper than the 2xlarge (as on 2026-11-25) is chosen, its
// 16 vCPUs counted against the quota; with 8 vCPUs free only the 2xlarge fits.
test fn the_cheapest_single_gpu_size_wins_within_the_free_quota() -> Bool {
  let big = FlexAwsCandidate { region: "us-east-1" as NonEmptyStr, zone: "us-east-1c" as NonEmptyStr, instance_type: "g7e.4xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 16, rate: Present { value: rate(micros: 1353200) }, per_gpu_hour_micros: Present { value: 1353200 }, walls: [] }
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2365300), big], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 24 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: _ } => (c.instance_type as String) == "g7e.4xlarge"
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [cand(zone: "us-east-1b", micros: 2365300), big], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 8 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: f } => ((c.instance_type as String) == "g7e.2xlarge") && (count(f) == 0)
    _ => false
  })
}

// LOWEST PRICE GLOBALLY: a cheaper card in another region wins when that region has the quota; with no
// quota there the next cheapest region that has it is chosen, and a card already held in a region counts
// only against that region's quota.
test fn the_cheapest_card_anywhere_wins_where_its_region_has_quota() -> Bool {
  let oregon = FlexAwsCandidate { region: "us-west-2" as NonEmptyStr, zone: "us-west-2a" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, market: FlexAwsSpot, gpus: 1, vcpus: 8, rate: Present { value: rate(micros: 475000) }, per_gpu_hour_micros: Present { value: 475000 }, walls: [] }
  let virginia = cand(zone: "us-east-1c", micros: 1353200)
  let both = [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 8 }, FlexAwsRegionQuota { region: "us-west-2" as NonEmptyStr, spot_vcpus: 24 }]
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [virginia, oregon], owned: [], outstanding: [], quotas: both, now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: _ } => (c.zone as String) == "us-west-2a"
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [virginia, oregon], owned: [], outstanding: [], quotas: [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 8 }], now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: f } => ((c.zone as String) == "us-east-1c") && (count(f) == 0)
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 2 }, candidates: [cand(zone: "us-east-1b", micros: 2350500), virginia, oregon], owned: [card(id: "i-0east", launched: "2026-11-25T02:30:00+00:00")], outstanding: [], quotas: both, now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: f } => ((c.zone as String) == "us-west-2a") && (count(f) == 0)
    _ => false
  })
}

// THE DOLLAR BUDGET: with two live cards burning $2.37 + $2.48 = $4.85/h against a $5/h ceiling, a third at
// $1.35/h would make $6.20/h and is not asked for even though demand and quota allow it; a third at $0.15/h
// fits. A live card whose price was not read refuses rather than counting as free.
test fn the_burn_ceiling_bounds_the_summed_hourly_price() -> Bool {
  let five = FlexAwsApplyPolicy { actuation: Apply, gpus_per_card: 1, burn_ceiling: rate(micros: 5000000), idle_window: second(count: 1800), drain_timeout: second(count: 600), boot_deadline: second(count: 2700) }
  let a = AwsEc2Instance { instance_id: "i-0a" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, placement: AwsEc2Placement { availability_zone: "us-east-1b" as NonEmptyStr }, state: AwsEc2InstanceState { code: 16, name: AwsEc2Running }, state_reason: none, instance_lifecycle: none, spot_instance_request_id: none, launch_time: "2026-11-25T02:30:00+00:00", public_ip_address: none, tags: [] }
  let b = AwsEc2Instance { instance_id: "i-0b" as NonEmptyStr, instance_type: "g7e.2xlarge" as NonEmptyStr, placement: AwsEc2Placement { availability_zone: "us-east-1d" as NonEmptyStr }, state: AwsEc2InstanceState { code: 16, name: AwsEc2Running }, state_reason: none, instance_lifecycle: none, spot_instance_request_id: none, launch_time: "2026-11-25T02:30:00+00:00", public_ip_address: none, tags: [] }
  let priced = [cand(zone: "us-east-1b", micros: 2365300), cand(zone: "us-east-1d", micros: 2481800)]
  let roomy = [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 48 }]
  (match flex_aws_decide(policy: five, demand: FlexAwsDemandFixed { cards: 3 }, candidates: concat(priced, [cand(zone: "us-east-1c", micros: 1353200)]), owned: [a, b], outstanding: [], quotas: roomy, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("burn ceiling")
    _ => false
  })
  && (match flex_aws_decide(policy: five, demand: FlexAwsDemandFixed { cards: 3 }, candidates: concat(priced, [cand(zone: "us-east-1c", micros: 150000)]), owned: [a, b], outstanding: [], quotas: roomy, now_unix: now_unix) {
    FlexAwsLaunch { candidate: c, max_price: _, fallbacks: _ } => (c.zone as String) == "us-east-1c"
    _ => false
  })
  && (match flex_aws_decide(policy: five, demand: FlexAwsDemandFixed { cards: 3 }, candidates: [cand(zone: "us-east-1c", micros: 150000)], owned: [a], outstanding: [], quotas: roomy, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("cannot count the burn rate")
    _ => false
  })
}

// RETENTION IS ADMISSION (review of e50999ce): one rented card with all eight retained conversations warm between
// tool calls and no turn in flight refuses a ninth; the router counts that waiter as unplaceable, and the decision
// asks for a second card even though the card's active slots are free (a reading of active turns alone held).
test fn a_card_whose_retention_is_full_asks_for_a_second() -> Bool {
  let warm = FlexAwsDemandRouter { router: FlexAwsRouterReading { unplaceable: 1, rows: ["aws-i-0warm"], cards: [card_use(id: "i-0warm", enrolled: true, in_flight: 0, seen: 8)] }, max_cards: 3 }
  let room = FlexAwsDemandRouter { router: FlexAwsRouterReading { unplaceable: 0, rows: ["aws-i-0warm"], cards: [card_use(id: "i-0warm", enrolled: true, in_flight: 0, seen: 7)] }, max_cards: 3 }
  (match flex_aws_decide(policy: policy, demand: warm, candidates: [cand(zone: "us-east-1c", micros: 2719400), cand(zone: "us-east-1b", micros: 2350500)], owned: [tagged(id: "i-0warm", tags: [])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: room, candidates: [cand(zone: "us-east-1c", micros: 2719400)], owned: [tagged(id: "i-0warm", tags: [])], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("wanted=1")
    _ => false
  })
}

// UNOBSERVED USE IS NOT PROOF (review of e50999ce): with router=off a fixed count reads no router, so a draining
// card -- here one a rebalance recommendation marks on this very tick, with turns that may be running -- is NOT
// terminated as drained; only the drain timeout lets it go.
test fn a_card_whose_use_is_unobserved_is_terminated_only_by_the_timeout() -> Bool {
  let owned = [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")]
  let marked = flex_aws_with_marks(owned: owned, written: flex_aws_notice_marks(owned: owned, notices: [FlexAwsRebalanceRecommendation { instance_id: "i-0abc" as NonEmptyStr }], now_unix: now_unix))
  (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [], owned: marked, outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: _, why: _ } => false
    _ => true
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [], owned: [draining(599)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: _, why: _ } => false
    _ => true
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 1 }, candidates: [], owned: [draining(600)], outstanding: [], quotas: quota24, now_unix: now_unix) {
    FlexAwsTerminate { instance_id: _, why: FlexAwsTerminateDrainTimedOut { drain_seconds: d } } => d == 600
    _ => false
  })
}

// A PURCHASE IN FLIGHT IS A CARD (review of e50999ce): EC2 answered a third launch but does not list it yet. It
// answers the ask it was bought for; beside two enrolled, full cards it is the third the ceiling allows; and while it
// is outstanding no second purchase is made even below the ceiling. Without it, the same pass would buy.
test fn a_purchase_not_yet_listed_counts_and_blocks_a_second() -> Bool {
  let bought = [FlexAwsOutstanding { token: "gunbc-flex-us-east-1c-1795575540" as NonEmptyStr, region: "us-east-1" as NonEmptyStr, zone: "us-east-1c" as NonEmptyStr }]
  let full_two = router(waiting: true, active: 8, cap: 8, uses: [card_use(id: "i-0a", enrolled: true, in_flight: 4, seen: 4), card_use(id: "i-0b", enrolled: true, in_flight: 4, seen: 4)])
  let two = [tagged(id: "i-0a", tags: []), tagged(id: "i-0b", tags: [])]
  let cs = [cand(zone: "us-east-1c", micros: 2719400), cand(zone: "us-east-1b", micros: 2350500)]
  let q = [FlexAwsRegionQuota { region: "us-east-1" as NonEmptyStr, spot_vcpus: 48 }]
  (match flex_aws_decide(policy: policy, demand: router(waiting: true, active: 0, cap: 0, uses: []), candidates: cs, owned: [], outstanding: bought, quotas: q, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("outstanding=1 wanted=1")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: full_two, candidates: cs, owned: two, outstanding: bought, quotas: q, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("steady=2 outstanding=1 wanted=3")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: FlexAwsDemandFixed { cards: 3 }, candidates: cs, owned: [], outstanding: bought, quotas: q, now_unix: now_unix) {
    FlexAwsHold { why: w } => w.contains("a purchase is outstanding")
    _ => false
  })
  && (match flex_aws_decide(policy: policy, demand: full_two, candidates: cs, owned: two, outstanding: [], quotas: q, now_unix: now_unix) {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => true
    _ => false
  })
}

// A NOTICE IS HELD UNTIL ITS MARKS READ BACK (review of e50999ce). Pass one sees the warning; its tag write FAILS,
// so the card as read back carries no mark: the notice is held, not settled. Pass two RECEIVES NOTHING; the held
// notice still withdraws the card and still owes both marks. A partial write (drain only) leaves the zone mark
// owed and the notice held. Read back with both marks, it is settled; a card that is gone settles it, unless some
// region could not be read.
test fn a_failed_mark_write_and_an_empty_receive_keep_the_card_withdrawn() -> Bool {
  let warned = FlexAwsInterruptionWarning { instance_id: "i-0abc" as NonEmptyStr, action: AwsEc2ActionTerminate }
  let unmarked = [card(id: "i-0abc", launched: "2026-11-25T02:30:00+00:00")]
  let held = flex_aws_notices_held(notices: [warned], owned: unmarked, blind: false)
  let pass_two = flex_aws_with_marks(owned: unmarked, written: flex_aws_notice_marks(owned: unmarked, notices: concat([], held), now_unix: now_unix + 30))
  let drain_only = [tagged(id: "i-0abc", tags: [tag_at(key: flex_aws_mark_drain, unix: now_unix)])]
  let partial = flex_aws_notice_marks(owned: drain_only, notices: [warned], now_unix: now_unix + 30)
  (count(held) == 1)
    && (count(flex_aws_steady(owned: pass_two)) == 0)
    && (count(flex_aws_notice_marks(owned: unmarked, notices: held, now_unix: now_unix + 30)) == 2)
    && (count(flex_aws_notices_held(notices: [warned], owned: drain_only, blind: false)) == 1)
    && (count(partial) == 1)
    && (match partial.first() { Present { value: FlexAwsMarkSet { instance_id: _, key: k, unix: _ } } => (k as String) == (flex_aws_mark_noticed as String)  _ => false })
    && flex_aws_notice_settled(owned: [warned_and_marked()], instance_id: "i-0abc" as NonEmptyStr, blind: false)
    && (count(flex_aws_notices_held(notices: [warned], owned: [warned_and_marked()], blind: false)) == 0)
    && flex_aws_notice_settled(owned: [], instance_id: "i-0abc" as NonEmptyStr, blind: false)
    && !flex_aws_notice_settled(owned: [], instance_id: "i-0abc" as NonEmptyStr, blind: true)
}
