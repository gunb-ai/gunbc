module test.claim.fabric.fabric_storage_file_store_wet_witness

import extdeps.shell
import std.algebra { trim }
import extdeps.access.posix { FileMode, PermissionBits, file_mode_octal }
import extdeps.tools.coreutils_stat { coreutils_stat_path_mode, PathModeObserved, PathModeUnobservable }
import gunbc.durable_cas_file_store { cas_file_slot_path }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.types { Bool, NonEmptyStr, String, List, FilePath }
import std.durable_compare_and_set { cas_generation_count }
import std.fabric_storage {
  FabricObject, fabric_object_ref_of, fabric_object_ref_eq, fabric_object_ref_wire,
  FabricObjectStored, FabricPutRefused, FabricObjectFetched, FabricObjectGetRefused,
  FabricHeadAbsent, FabricHeadAt, ExpectHeadAbsent, ExpectHeadAt,
  FabricHeadObserved, FabricHeadReadRefused,
  FabricHeadAdvanced, FabricHeadMoved, FabricHeadAdvanceRefused,
  FabricClosureRead, FabricClosureBudgetExhausted, FabricClosureRefused,
  FabricObjectMissing, FabricObjectCorrupt, FabricHeadNameRefused, FabricWriterRefused,
  FabricPut, FabricHeadAdvance, fabric_object_preimage,
}
import gunbc.fabric_storage_serve { fabric_storage_serve_handle_over, FabricDoorRosters }
import gunbc.fabric_storage_wire { fabric_storage_unwire_identity, FabricIdentityPresented, FabricIdentityUnproxied, FabricIdentityReadRefused }
import extdeps.tailscale.identity { TailnetUser, TailnetIdentityAbsent }
import gunbc.fabric_storage_wire { fabric_storage_unwire_advance, fabric_storage_unwire_put }
import gunbc.fabric_storage_client { served_reply_from, ServedAnswered, ServedFault }
import gunbc.fabric_storage_file_store {
  FabricStorageFileRoot, fabric_storage_file_root, fabric_storage_file_root_with, fabric_storage_file_root_ensure, FabricStorageRootReady, FabricStorageRootRefused,
  fabric_storage_file_put, fabric_storage_file_get, fabric_storage_file_head, fabric_storage_file_advance, fabric_storage_file_closure, fabric_storage_object_path,
}

// Wet controls for the file-backed fabric DB: a throwaway temp directory, no network. This is the
// real path every other fabric DB claim supplies values for -- the store publishing, reading and
// walking actual files -- and each refusal arm the store owns has its discriminating red here.

fn fresh_store() -> FabricStorageFileRoot {
  let root = fabric_storage_file_root(root: shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_fabric_storage.XXXXXX").path as NonEmptyStr)
  match fabric_storage_file_root_ensure(root: root) {
    FabricStorageRootReady => root
    FabricStorageRootRefused { area: _, detail: _ } => root
  }
}

data fixture_writer: NonEmptyStr = "writer@example.ts.net" as NonEmptyStr

data fixture_local_writer: NonEmptyStr = "ghrunner" as NonEmptyStr

fn fixture_rosters() -> FabricDoorRosters {
  FabricDoorRosters { logins: [fixture_writer], locals: [fixture_local_writer] }
}

fn event(body: NonEmptyStr, parent: FabricObject?) -> FabricObject {
  match parent {
    Absent => FabricObject { links: [], body: body }
    Present { value: p } => FabricObject { links: [fabric_object_ref_of(object: p)], body: body }
  }
}

// THE INHABITANCE CLAIM: a three-event chain appended through put + advance is read back whole by
// the closure walk, from files, newest first -- the route the P0-B hole broke.
test fn a_chain_appended_through_the_store_is_read_back_whole_by_the_closure() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: Present { value: a })
  let c = event(body: "c", parent: Present { value: b })
  let put_all = [fabric_storage_file_put(root: s, object: a), fabric_storage_file_put(root: s, object: b), fabric_storage_file_put(root: s, object: c)]
  let stored = length(filter(put_all, p => match p { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false })) == 3
  let adv1 = fabric_storage_file_advance(root: s, name: "group-a", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: a))
  let adv2 = fabric_storage_file_advance(root: s, name: "group-a", expected: ExpectHeadAt { object: fabric_object_ref_of(object: a) }, target: fabric_object_ref_of(object: b))
  let adv3 = fabric_storage_file_advance(root: s, name: "group-a", expected: ExpectHeadAt { object: fabric_object_ref_of(object: b) }, target: fabric_object_ref_of(object: c))
  let advanced = match adv3 { FabricHeadAdvanced { object: _, generation: g } => cas_generation_count(g: g) == 3  _ => false }
  let walked = match fabric_storage_file_closure(root: s, name: "group-a", bound: 16) {
    FabricClosureRead { reading: _, newest_first: xs } =>
      length(xs) == 3 && match first(xs) { Present { value: h } => fabric_object_ref_eq(a: h.object, b: fabric_object_ref_of(object: c))  Absent => false }
    _ => false
  }
  stored && advanced && walked
}

// LOST RACE: a writer expecting the head it built on, after another writer moved it, is answered
// FabricHeadMoved carrying the head that beat it -- never a store refusal.
test fn an_advance_against_a_moved_head_is_a_lost_race_naming_the_winner() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: Present { value: a })
  let b2 = event(body: "b2", parent: Present { value: a })
  let _p = [fabric_storage_file_put(root: s, object: a), fabric_storage_file_put(root: s, object: b), fabric_storage_file_put(root: s, object: b2)]
  let _1 = fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: a))
  let _2 = fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAt { object: fabric_object_ref_of(object: a) }, target: fabric_object_ref_of(object: b))
  match fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAt { object: fabric_object_ref_of(object: a) }, target: fabric_object_ref_of(object: b2)) {
    FabricHeadMoved { expected: _, observed: o } => match o { FabricHeadAt { object: w, generation: _ } => fabric_object_ref_eq(a: w, b: fabric_object_ref_of(object: b))  FabricHeadAbsent => false }
    _ => false
  }
}

// MISSING OBJECT: a head is never pointed at an object the store does not hold.
test fn an_advance_to_an_unstored_object_is_refused_as_missing_and_the_head_stays_absent() -> Bool {
  let s = fresh_store()
  let refused = match fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: event(body: "never-put", parent: none))) {
    FabricHeadAdvanceRefused { fault: f } => match f { FabricObjectMissing { object: _ } => true  _ => false }
    _ => false
  }
  let still_absent = match fabric_storage_file_head(root: s, name: "p") { FabricHeadObserved { reading: FabricHeadAbsent } => true  _ => false }
  refused && still_absent
}

// A HOLE IN A CHAIN: a head whose parent was never stored is refused by the closure with the
// missing ref, never returned as a shorter chain.
test fn a_closure_over_a_hole_refuses_with_the_missing_object() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: Present { value: a })
  let _p = fabric_storage_file_put(root: s, object: b)
  let _1 = fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: b))
  match fabric_storage_file_closure(root: s, name: "p", bound: 16) {
    FabricClosureRefused { fault: f } => match f { FabricObjectMissing { object: m } => fabric_object_ref_eq(a: m, b: fabric_object_ref_of(object: a))  _ => false }
    _ => false
  }
}

// CORRUPTION: bytes under an object's name that do not hash to it are refused, never served.
test fn an_object_file_holding_other_bytes_is_refused_as_corrupt() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let _w = Filesystem.Write(path: fabric_storage_object_path(root: s, object: fabric_object_ref_of(object: a)), content: "fabric_storage.object;B1:z")
  match fabric_storage_file_get(root: s, object: fabric_object_ref_of(object: a)) {
    FabricObjectGetRefused { fault: f } => match f { FabricObjectCorrupt { object: _, detail: _ } => true  _ => false }
    FabricObjectFetched { stored: _ } => false
  }
}

// THE BOUND REFUSES RATHER THAN TRUNCATING.
test fn a_closure_longer_than_its_bound_refuses_rather_than_truncating() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: Present { value: a })
  let _p = [fabric_storage_file_put(root: s, object: a), fabric_storage_file_put(root: s, object: b)]
  let _1 = fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: b))
  match fabric_storage_file_closure(root: s, name: "p", bound: 1) {
    FabricClosureBudgetExhausted { at: _, bound: _ } => true
    _ => false
  }
}

// A NAME THAT WOULD NAVIGATE is the caller's defect, refused before the store is read.
test fn a_head_name_with_a_separator_is_refused() -> Bool {
  let s = fresh_store()
  match fabric_storage_file_head(root: s, name: "../escape") {
    FabricHeadReadRefused { fault: f } => match f { FabricHeadNameRefused { name: _ } => true  _ => false }
    FabricHeadObserved { reading: _ } => false
  }
}

// PUT IS IDEMPOTENT: the same object twice is stored once and answered stored both times.
test fn putting_the_same_object_twice_is_answered_stored_both_times() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let one = fabric_storage_file_put(root: s, object: a)
  let two = fabric_storage_file_put(root: s, object: a)
  match one { FabricObjectStored { object: _ } => match two { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false }  FabricPutRefused { fault: _ } => false }
}

// THE SERVED HANDLER'S STORE SIDE, BY REAL EXECUTION: a request body through fabric_storage_serve's
// handler runs the file store on real files, and the reply -- with the status line the transport
// appends -- decodes on the caller's side as the same arm the store decided. Only the HTTP carrier
// itself is not in this claim; its receipt is the live endpoint probe.
test fn a_lost_race_through_the_served_handler_decodes_as_the_same_lost_race_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: Present { value: a })
  let _p = [fabric_storage_file_put(root: s, object: a), fabric_storage_file_put(root: s, object: b)]
  let _1 = fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: a))
  let reply = fabric_storage_serve_handle_over(root: s, rosters: fixture_rosters(), method: "POST", path: "/fabric-storage/advance", body: join(["p absent ", fabric_object_ref_wire(object: fabric_object_ref_of(object: b)) as String], ""), tailscale_identity: fixture_writer as String, peer_user: "root")
  match served_reply_from(exit_code: 0, stdout: join([reply.body, "\n", to_string(reply.status)], ""), stderr: "") {
    ServedFault { fault: _ } => false
    ServedAnswered { body: text } =>
      match fabric_storage_unwire_advance(text: text) {
        FabricHeadMoved { expected: _, observed: o } => match o { FabricHeadAt { object: w, generation: _ } => fabric_object_ref_eq(a: w, b: fabric_object_ref_of(object: a))  FabricHeadAbsent => false }
        _ => false
      }
  }
}

// THE IDENTITY ROUTE THROUGH THE REAL HANDLER: the login the proxy handed the handler is what the
// caller's side decodes, and the request reads no head and writes no object (the store is empty
// before and after). An empty header decodes as absent, never as a login.
test fn the_identity_route_echoes_the_presented_login_and_touches_no_head_by_real_execution() -> Bool {
  let s = fresh_store()
  let reply = fabric_storage_serve_handle_over(root: s, rosters: fixture_rosters(), method: "POST", path: "/fabric-storage/identity", body: "", tailscale_identity: "writer@example.ts.net", peer_user: "root")
  let echoed = match served_reply_from(exit_code: 0, stdout: join([reply.body, "\n", to_string(reply.status)], ""), stderr: "") {
    ServedFault { fault: _ } => false
    ServedAnswered { body: text } =>
      match fabric_storage_unwire_identity(text: text) {
        FabricIdentityPresented { identity: i } => match i { TailnetUser { login: l } => (l as String) == "writer@example.ts.net"  TailnetIdentityAbsent => false }
        _ => false
      }
  }
  let absent = match fabric_storage_unwire_identity(text: fabric_storage_serve_handle_over(root: s, rosters: fixture_rosters(), method: "POST", path: "/fabric-storage/identity", body: "", tailscale_identity: "", peer_user: "root").body) {
    FabricIdentityPresented { identity: i } => match i { TailnetIdentityAbsent => true  TailnetUser { login: _ } => false }
    _ => false
  }
  let untouched = match fabric_storage_file_head(root: s, name: "p") { FabricHeadObserved { reading: r } => match r { FabricHeadAbsent => true  FabricHeadAt { object: _, generation: _ } => false }  FabricHeadReadRefused { fault: _ } => false }
  echoed && absent && untouched
}

// THE DECLARED ENTRY MODE REACHES BOTH PUBLICATIONS. A store rooted with a declared mode publishes
// its object (Filesystem.WriteCreateNewWithMode) and its head generation (the CAS's
// DeclaredModeCreateOnly) at exactly that mode, read back with stat from the files themselves. 0444
// is the placement's derived mode (a fixture mode; the placement's own is test.claim.live_deploy.emit the_placed_fabric_store_derives_entry_mode_0400)
// and differs from what any umask can produce from create-new's 0666, so a realization that dropped
// the declared bits and fell back to the umask is red here whatever umask the runner has. The
// umask-077 case that failed on srv1 is exercised directly in the seed's
// a_declared_mode_is_published_regardless_of_the_umask. The control inside the claim runs the SAME
// operations on a store with no declared mode and requires that it does not publish 0444.
fn read_only_by_all() -> FileMode {
  FileMode {
    owner: PermissionBits { read: true, write: false, execute: false },
    group: PermissionBits { read: true, write: false, execute: false },
    other: PermissionBits { read: true, write: false, execute: false },
    setuid: false, setgid: false, sticky: false,
  }
}

fn observed_mode_octal(path: String) -> String {
  match coreutils_stat_path_mode(path: path as NonEmptyStr) {
    PathModeObserved { path: _, mode } => file_mode_octal(mode: mode)
    PathModeUnobservable { path: _, reason } => join(["unobservable: ", reason], "")
  }
}

test fn a_declared_entry_mode_is_the_published_mode_of_objects_and_heads() -> Bool {
  let base = fresh_store()
  let s = fabric_storage_file_root_with(root: shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_fabric_storage_mode.XXXXXX").path as NonEmptyStr, entry_mode: Present { value: read_only_by_all() })
  let ready = match fabric_storage_file_root_ensure(root: s) { FabricStorageRootReady => true  FabricStorageRootRefused { area: _, detail: _ } => false }
  let a = event(body: "a", parent: none)
  let put = match fabric_storage_file_put(root: s, object: a) { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false }
  let object_mode = observed_mode_octal(path: fabric_storage_object_path(root: s, object: fabric_object_ref_of(object: a)))
  let head_mode = match fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: a)) {
    FabricHeadAdvanced { object: _, generation: g } => observed_mode_octal(path: cas_file_slot_path(root: s.heads, key: "p", generation: g))
    _ => "not advanced"
  }
  let _b = fabric_storage_file_put(root: base, object: a)
  let undeclared_mode = observed_mode_octal(path: fabric_storage_object_path(root: base, object: fabric_object_ref_of(object: a)))
  ready && put && object_mode == "0444" && head_mode == "0444" && undeclared_mode != "0444"
}

// ── THE WRITER WALL AT THE SERVED DOOR, BY REAL EXECUTION ────────────────────────────────────
// A put and an advance through the real handler, over real files, from three presented identities
// against one supplied roster: the rostered login writes (the positive control, same requests); a
// login outside the roster and an absent login are each refused with FabricWriterRefused, decoded
// on the caller's side as that arm, and neither leaves an object file or moves the head. Deleting
// the admission from fabric_storage_serve's put or advance arm reds the refused cases here.
fn served_put(s: FabricStorageFileRoot, peer: String, login: String, o: FabricObject) -> FabricPut {
  let reply = fabric_storage_serve_handle_over(root: s, rosters: fixture_rosters(), method: "POST", path: "/fabric-storage/put", body: fabric_object_preimage(object: o) as String, tailscale_identity: login, peer_user: peer)
  match served_reply_from(exit_code: 0, stdout: join([reply.body, "\n", to_string(reply.status)], ""), stderr: "") {
    ServedFault { fault: f } => FabricPutRefused { fault: f }
    ServedAnswered { body: text } => fabric_storage_unwire_put(text: text)
  }
}

fn served_advance_absent(s: FabricStorageFileRoot, peer: String, login: String, o: FabricObject) -> FabricHeadAdvance {
  let reply = fabric_storage_serve_handle_over(root: s, rosters: fixture_rosters(), method: "POST", path: "/fabric-storage/advance", body: join(["p absent ", fabric_object_ref_wire(object: fabric_object_ref_of(object: o)) as String], ""), tailscale_identity: login, peer_user: peer)
  match served_reply_from(exit_code: 0, stdout: join([reply.body, "\n", to_string(reply.status)], ""), stderr: "") {
    ServedFault { fault: f } => FabricHeadAdvanceRefused { fault: f }
    ServedAnswered { body: text } => fabric_storage_unwire_advance(text: text)
  }
}

fn put_writer_refused(p: FabricPut) -> Bool {
  match p { FabricPutRefused { fault: f } => match f { FabricWriterRefused { refusal: _ } => true  _ => false }  FabricObjectStored { object: _ } => false }
}

fn advance_writer_refused(a: FabricHeadAdvance) -> Bool {
  match a { FabricHeadAdvanceRefused { fault: f } => match f { FabricWriterRefused { refusal: _ } => true  _ => false }  _ => false }
}

fn head_absent(s: FabricStorageFileRoot) -> Bool {
  match fabric_storage_file_head(root: s, name: "p") { FabricHeadObserved { reading: r } => match r { FabricHeadAbsent => true  FabricHeadAt { object: _, generation: _ } => false }  FabricHeadReadRefused { fault: _ } => false }
}

fn object_absent(s: FabricStorageFileRoot, o: FabricObject) -> Bool {
  match fabric_storage_file_get(root: s, object: fabric_object_ref_of(object: o)) { FabricObjectGetRefused { fault: f } => match f { FabricObjectMissing { object: _ } => true  _ => false }  FabricObjectFetched { stored: _ } => false }
}

test fn a_put_or_advance_from_a_login_outside_the_roster_is_refused_at_the_served_door_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let outsider_put = served_put(s: s, peer: "root", login: "stranger@example.ts.net", o: a)
  let outsider_left_nothing = object_absent(s: s, o: a)
  let _stored = fabric_storage_file_put(root: s, object: a)
  let outsider_advance = served_advance_absent(s: s, peer: "root", login: "stranger@example.ts.net", o: a)
  put_writer_refused(p: outsider_put) && outsider_left_nothing && advance_writer_refused(a: outsider_advance) && head_absent(s: s)
}

test fn a_put_or_advance_with_no_presented_login_is_refused_at_the_served_door_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let absent_put = served_put(s: s, peer: "root", login: "", o: a)
  let absent_left_nothing = object_absent(s: s, o: a)
  let _stored = fabric_storage_file_put(root: s, object: a)
  let absent_advance = served_advance_absent(s: s, peer: "root", login: "", o: a)
  put_writer_refused(p: absent_put) && absent_left_nothing && advance_writer_refused(a: absent_advance) && head_absent(s: s)
}

test fn a_rostered_login_puts_and_advances_through_the_served_door_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let put = match served_put(s: s, peer: "root", login: fixture_writer as String, o: a) { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false }
  let advanced = match served_advance_absent(s: s, peer: "root", login: fixture_writer as String, o: a) { FabricHeadAdvanced { object: _, generation: _ } => true  _ => false }
  put && advanced && head_absent(s: s) == false
}

// ── THE WRITER WALL ON THE PLACED HOST'S LOCAL PATH, BY REAL EXECUTION ───────────────────────
// A local writer on the placed host runs the file store in process, so its admission is the
// kernel's: the store areas' ownership and mode, derived from the placement's writer dependents
// (gunbc.fabric_storage_placement fabric_storage_directory, whose writer roster claim is
// test.claim.fabric.fabric_writer_roster_witness). This claim is the file store's half: when the
// areas grant this process's principal no write, the REAL file store's put and advance refuse with
// a typed fault, create nothing and leave the head absent -- never a panic, never a partial write.
// The control is the same operations on the same store before write is withdrawn.
//
// THE PRINCIPAL IS THE RUNNER'S, SO THE VERDICT IS A RELATION TO IT, NOT A FIXED ARM
// (gunbc.recurring_failure_mode wet_witness_keyed_to_the_runner_not_its_subject). A read-only mode
// does not bind uid 0, so under root the kernel admits the write and a fixed refusal arm was red by
// runner assignment. The effective uid is read with shell.Id.UserId: an unprivileged principal must
// be refused as above; root must be ADMITTED by the same real file store -- which is the other half
// of "the admission is the kernel's", not a pass by default. An unreadable uid is red.
//
// THE REFUSAL ROUTE ITSELF DOES NOT WAIT FOR AN UNPRIVILEGED RUNNER. Whether a mode binds is the
// kernel's decision and cannot be supplied, so the file store's half -- a refused write becomes a
// typed fault, creates nothing, never panics -- is exercised on EVERY runner by
// a_put_or_advance_into_store_areas_that_refuse_every_principal_is_a_typed_fault_by_real_execution,
// which supplies a refusal no uid bypasses. This claim is the inhabitance claim for the arm the
// runner's own principal selects.
test fn a_put_or_advance_by_a_principal_the_store_areas_do_not_admit_is_refused_by_the_real_file_store() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: none)
  let control = match fabric_storage_file_put(root: s, object: a) { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false }
  let withdrawn = shell.Chmod.RecursiveReadOnly(path: (s.objects as String) as FilePath).success && shell.Chmod.RecursiveReadOnly(path: (s.heads as String) as FilePath).success
  let put_refused = match fabric_storage_file_put(root: s, object: b) { FabricPutRefused { fault: _ } => true  FabricObjectStored { object: _ } => false }
  let advance_refused = match fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: a)) { FabricHeadAdvanceRefused { fault: _ } => true  _ => false }
  let uid = shell.Id.UserId()
  let is_root = trim(s: uid.stdout) == "0"
  let arm_holds = if is_root {
    !put_refused && !object_absent(s: s, o: b) && !advance_refused && !head_absent(s: s)
  } else {
    put_refused && object_absent(s: s, o: b) && advance_refused && head_absent(s: s)
  }
  uid.success && control && withdrawn && arm_holds
}

// A REFUSED WRITE IS A TYPED FAULT WHATEVER THE RUNNER'S PRINCIPAL (gunbc.recurring_failure_mode
// wet_witness_keyed_to_the_runner_not_its_subject). The store areas are replaced by plain files after
// a control write, so every put and advance is refused by the kernel with ENOTDIR -- a refusal uid 0
// does not bypass. The real file store must answer each with a typed refusal, and leave the planted
// files as they were: no area recreated, no partial write.
test fn a_put_or_advance_into_store_areas_that_refuse_every_principal_is_a_typed_fault_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let b = event(body: "b", parent: none)
  let control = match fabric_storage_file_put(root: s, object: a) { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false }
  let objects = s.objects as String
  let heads = s.heads as String
  let planted = "not a store area"
  let cleared = shell.Remove.RecursiveForce(path: objects).success && shell.Remove.RecursiveForce(path: heads).success
  let placed = Filesystem.Write(path: objects, content: planted).success && Filesystem.Write(path: heads, content: planted).success
  let put_refused = match fabric_storage_file_put(root: s, object: b) { FabricPutRefused { fault: _ } => true  FabricObjectStored { object: _ } => false }
  let advance_refused = match fabric_storage_file_advance(root: s, name: "p", expected: ExpectHeadAbsent, target: fabric_object_ref_of(object: a)) { FabricHeadAdvanceRefused { fault: _ } => true  _ => false }
  let objects_after = Filesystem.Read(path: objects)
  let heads_after = Filesystem.Read(path: heads)
  control && cleared && placed && put_refused && advance_refused
    && objects_after.success && objects_after.content == planted
    && heads_after.success && heads_after.content == planted
}

// ── THE DOOR'S LOCAL PEERS, BY REAL EXECUTION ────────────────────────────────────────────────
// A writer on the placed host reaches the same door through its socket, where the kernel names its
// account: a rostered account writes whatever header it sends, an unrostered account is refused even
// when it presents a rostered login (the header is believed only from the proxy), and a connection
// whose peer was never attested is refused. Same requests, same real handler over real files.
test fn a_put_or_advance_from_an_unrostered_local_account_is_refused_even_with_a_rostered_login_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let forged_put = served_put(s: s, peer: "stranger", login: fixture_writer as String, o: a)
  let left_nothing = object_absent(s: s, o: a)
  let _stored = fabric_storage_file_put(root: s, object: a)
  let forged_advance = served_advance_absent(s: s, peer: "stranger", login: fixture_writer as String, o: a)
  put_writer_refused(p: forged_put) && left_nothing && advance_writer_refused(a: forged_advance) && head_absent(s: s)
}

test fn a_put_or_advance_on_an_unattested_connection_is_refused_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let put = served_put(s: s, peer: "", login: fixture_writer as String, o: a)
  let left_nothing = object_absent(s: s, o: a)
  let _stored = fabric_storage_file_put(root: s, object: a)
  let advance = served_advance_absent(s: s, peer: "", login: fixture_writer as String, o: a)
  put_writer_refused(p: put) && left_nothing && advance_writer_refused(a: advance) && head_absent(s: s)
}

test fn a_rostered_local_account_puts_and_advances_through_the_door_by_real_execution() -> Bool {
  let s = fresh_store()
  let a = event(body: "a", parent: none)
  let put = match served_put(s: s, peer: fixture_local_writer as String, login: "", o: a) { FabricObjectStored { object: _ } => true  FabricPutRefused { fault: _ } => false }
  let advanced = match served_advance_absent(s: s, peer: fixture_local_writer as String, login: "", o: a) { FabricHeadAdvanced { object: _, generation: _ } => true  _ => false }
  put && advanced && head_absent(s: s) == false
}
