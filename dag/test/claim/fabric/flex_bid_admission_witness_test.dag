data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn t_caps() -> CapabilityManifestRef { "gunbc.capabilities.linux-rust-toolchain" }
fn t_trust() -> TrustDomainRef { "gunbc.trust.internal-fleet" }

fn t_reqs(revocation: RevocationStanding) -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 8) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    revocation: revocation,
  }
}

fn usd_hour(micros: Nat) -> MoneyPerHour {
  MoneyPerHour { amount: money_amount_micro(count: micros), currency: Usd }
}

fn t_offer(key: OfferKey, rate: MoneyPerHour) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: FabricIdentity { principal: "gunbc", key: key },
    executor: "gunbc",
    route: fixture_route(),
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 64) }, envelope: unstated_envelope() },
    capabilities: t_caps(),
    trust_domain: t_trust(),
    isolation: IsolationProfile { guarantees: [] },
    quantity_bound: 1,
    ready_at: "2026-10-12T00:00:00Z",
    quote: QuotedPerHour(rate),
    billing_quantum: second(count: 3600),
    evidence: ObservedSupply { observed_at: "2026-10-12T00:00:00Z", receipt: "obs-1" },
  }
}

fn t_bound(offer: SupplierOffer<NonEmptyStr>, revocable: Bool) -> List<CandidateOffer<NonEmptyStr>> {
  match bind_candidate(
    offer: offer,
    dispatch: DispatchInputs {
      offer: offer.id,
      availability: if revocable {
        AvailableRevocable { delay: second(count: 0), receipt: "avail-revocable" }
      } else {
        AvailableIndefinitely { delay: second(count: 0), receipt: "avail-1" }
      },
      commitment: PayAsYouGo,
      start: StartCostMeasured {
        amount: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
        receipt: "start-1",
      },
      transition: NoTransitionRequired,
      operating: OperatingCostBorneBySupplier,
      opportunity: NoFeasibleAlternativeUse { receipt: "opp-1" },
    },
    admission: fixture_admitted_for_offer(route: offer.route, offer: offer.id),
    demand: fixture_demand_for(offer: offer.id),
    work: fixture_work_for(offer: offer.id),
  ) {
    CandidateBound { candidate: c } => [c]
    DispatchInputsNameAnotherOffer { offer: _, inputs_name: _ } => []
    OfferNotAdmittedForUse { offer: _, cause: _ } => []
    PermitNamesAnotherOffer { offer: _, permit_names: _ } => []
    PermitNamesAnotherRoute { offer: _ } => []
    PermitNamesAnotherWork { permit_work: _, subject_work: _ } => []
    PermitNamesAnotherDemand { permit_demand: _, subject_demand: _ } => []
  }
}

fn t_machine(id: NonEmptyStr) -> FlexMachineKey {
  FlexMachineKey {
    provider: decl_ref(module_path: "extdeps.cloud.vast_ai", decl_name: "extdeps_external_authority_anchor"),
    account: "vast-account-1",
    machine: id,
  }
}

fn t_policy(cap_micros: Nat) -> FlexPolicy {
  FlexPolicy {
    fleet_rate_cap: usd_hour(micros: cap_micros),
    floor_buffer: flex_floor_buffer,
    on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
    acquisition_horizon: second(count: 3600),
  }
}

fn eur_hour(micros: Nat) -> MoneyPerHour {
  MoneyPerHour { amount: money_amount_micro(count: micros), currency: Eur }
}

fn t_policy_eur(cap_micros: Nat) -> FlexPolicy {
  FlexPolicy {
    fleet_rate_cap: eur_hour(micros: cap_micros),
    floor_buffer: flex_floor_buffer,
    on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
    acquisition_horizon: second(count: 3600),
  }
}

fn t_account(ceiling: Nat) -> MoneyAccount {
  MoneyAccount {
    account: "flex-fleet",
    currency: Usd,
    ledger: EncumbranceLedger {
      appropriation: Appropriation { ceiling: money_amount_micro(count: ceiling) },
      entries: [],
    },
    leases: [],
  }
}

fn t_window(remaining: Nat) -> FlexAcquisitionWindow {
  FlexAcquisitionWindow { remaining: remaining }
}

fn t_on_demand_ref(rate: MoneyPerHour, key: OfferKey) -> FlexOnDemandReference<NonEmptyStr> {
  fold(
    t_bound(offer: t_offer(key: key, rate: rate), revocable: false),
    init: FlexOnDemandReferenceMissing,
    f: (acc, c) =>
      match acc {
        FlexOnDemandReferenceFresh { candidate: existing } =>
          FlexOnDemandReferenceFresh { candidate: existing }
        FlexOnDemandReferenceStale { candidate: s } => FlexOnDemandReferenceStale { candidate: s }
        FlexOnDemandReferenceMissing => FlexOnDemandReferenceFresh { candidate: c }
      },
  )
}

fn t_attempt(
  machine: FlexMachineKey,
  min_bid: ExactDecimal,
  quote: MoneyPerHour,
  key: OfferKey,
  reservation: NonEmptyStr,
  revocation: RevocationStanding,
  revocable: Bool,
) -> FlexBidAttempt<NonEmptyStr> {
  FlexBidAttempt {
    machine: machine,
    min_bid: min_bid,
    quote_currency: vast_ai_quote_currency,
    candidates: fold(
      t_bound(offer: t_offer(key: key, rate: quote), revocable: revocable),
      init: [],
      f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
    ),
    subject: FlexNewAcquisition,
    on_demand_reference: t_on_demand_ref(rate: usd_hour(micros: 2000000), key: "on-demand-ref"),
    requirements: t_reqs(revocation: revocation),
    reservation: reservation,
    generation: 1,
    delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
    tie: StableRosterOrder,
    affinity: "test.flex" as PlacementAffinityKey,
  }
}

fn t_attempt_ref(
  machine: FlexMachineKey,
  min_bid: ExactDecimal,
  quote: MoneyPerHour,
  key: OfferKey,
  reservation: NonEmptyStr,
  revocation: RevocationStanding,
  revocable: Bool,
  reference: FlexOnDemandReference<NonEmptyStr>,
) -> FlexBidAttempt<NonEmptyStr> {
  FlexBidAttempt {
    machine: machine,
    min_bid: min_bid,
    quote_currency: vast_ai_quote_currency,
    candidates: fold(
      t_bound(offer: t_offer(key: key, rate: quote), revocable: revocable),
      init: [],
      f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
    ),
    subject: FlexNewAcquisition,
    on_demand_reference: reference,
    requirements: t_reqs(revocation: revocation),
    reservation: reservation,
    generation: 1,
    delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
    tie: StableRosterOrder,
    affinity: "test.flex" as PlacementAffinityKey,
  }
}

fn empty_occupancy() -> FlexFleetOccupancy {
  FlexFleetOccupancy { standing: [] }
}

fn admitted_bid(o: FlexBidAdmission) -> Nat {
  match o {
    FlexBidAdmitted { bid: b, selection: _, account: _, occupancy: _, window: _ } => money_per_hour_micros(q: b)
    FlexBidRefused { cause: _ } => 0
  }
}

fn refusal_label(o: FlexBidAdmission) -> NonEmptyStr {
  match o {
    FlexBidAdmitted { bid: _, selection: _, account: _, occupancy: _, window: _ } => "admitted"
    FlexBidRefused { cause: c } =>
      match c {
        FlexNoAcquisitionRemaining => "no-remaining"
        FlexCurrencyMismatch { left: _, right: _ } => "currency"
        FlexDecimalConversionRefused { conversion: _ } => "decimal"
        FlexRateCapBelowMin { cap: _, min_bid: _ } => "rate-cap"
        FlexRateCapOccupied { cap: _, occupied: _, proposed: _ } => "rate-cap-occupied"
        FlexExistingBidWouldRise { current: _, min_bid: _ } => "existing-would-rise"
        FlexOnDemandReferenceUnobserved => "on-demand-unobserved"
        FlexOnDemandRelativeCeilingExceeded { ceiling: _, projected: _ } => "on-demand-ceiling"
        FlexSupplyNotSelected { selection: _ } => "supply"
        FlexCandidateMachineMismatch { named: _, observed: _ } => "machine-mismatch"
        FlexMoneyRefused { refusal: _ } => "money"
      }
  }
}

// Dollar amounts as ExactDecimal: 1.00 = 100 cents at 2 fraction digits → 1_000_000 micros.
fn one_dollar() -> MoneyPerHour { usd_hour(micros: 1000000) }
fn one_ten() -> MoneyPerHour { usd_hour(micros: 1100000) }
fn one_dollar_wire() -> ExactDecimal { ExactDecimal { units: 1, fraction_digits: 0 } }
fn one_twenty_wire() -> ExactDecimal { ExactDecimal { units: 12, fraction_digits: 1 } }

fn vast_min_sample() -> VastAiOffer {
  VastAiOffer {
    id: 1, machine_id: 9, gpu_name: "x", num_gpus: 1, compute_cap: 1,
    gpu_arch: Present { value: "nvidia" }, verification: "verified", geolocation: "US",
    rentable: true, rented: false, is_bid: Present { value: true },
    min_bid: ExactDecimal { units: 1111111, fraction_digits: 7 },
    dph_total: ExactDecimal { units: 2, fraction_digits: 0 },
    storage_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    inet_up_cost: ExactDecimal { units: 1, fraction_digits: 3 },
    inet_down_cost: ExactDecimal { units: 1, fraction_digits: 3 },
  }
}

test fn an_unrepresentable_money_scale_refuses_instead_of_wrapping() -> Bool {
  match exact_decimal_to_money_amount_micro_ceil(d: ExactDecimal { units: 1, fraction_digits: 40 }) {
    DecimalMoneyUnrepresentable { cause: _ } => true
    DecimalMoneyConverted { amount: _ } => false
    DecimalMoneyNegativeRefused { units: _ } => false
    DecimalMoneyScaleRefused { fraction_digits: _ } => false
  }
}

test fn vast_min_bid_rounds_up_a_seventh_fraction_digit() -> Bool {
  match exact_decimal_to_money_amount_micro_ceil(d: ExactDecimal { units: 1111111, fraction_digits: 7 }) {
    DecimalMoneyConverted { amount: a } => money_amount_micro_count(m: a) == 111112
    DecimalMoneyNegativeRefused { units: _ } => false
    DecimalMoneyScaleRefused { fraction_digits: _ } => false
    DecimalMoneyUnrepresentable { cause: _ } => false
  } && match vast_ai_min_bid_money_per_hour(offer: vast_min_sample()) {
    DecimalMoneyPerHourConverted { rate: r } => money_per_hour_micros(q: r) == 111112
    DecimalMoneyPerHourRefused { conversion: _ } => false
  } && match vast_ai_dph_total_money_per_hour(offer: vast_min_sample()) {
    DecimalMoneyPerHourConverted { rate: r } => money_per_hour_micros(q: r) == 2000000
    DecimalMoneyPerHourRefused { conversion: _ } => false
  }
}

test fn two_acquisitions_race_one_allowance_and_the_second_is_refused() -> Bool {
  let policy = t_policy(cap_micros: 5000000)
  let first = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-a",
      reservation: "res-a",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  match first {
    FlexBidRefused { cause: _ } => false
    FlexBidAdmitted { bid: _, selection: _, account: next_account, occupancy: next_occupancy, window: next_window } =>
      refusal_label(o: flex_bid_admission(
        policy: policy,
        occupancy: next_occupancy,
        window: next_window,
        account: next_account,
        attempt: t_attempt(
          machine: t_machine(id: "machine-b"),
          min_bid: one_dollar_wire(),
          quote: one_ten(),
          key: "offer-b",
          reservation: "res-b",
          revocation: RevocationAccepted,
          revocable: true,
        ),
      )) == "no-remaining"
  }
}

// RED: a history-keyed retained limit would refuse rediscovery of machine-a at a higher min.
// Rediscovery is a new acquisition: same ceiling as an equivalent fresh machine, never above policy.
test fn a_rediscovered_machine_is_not_penalized_relative_to_a_fresh_equivalent() -> Bool {
  let policy = t_policy(cap_micros: 5000000)
  let first = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-a",
      reservation: "res-a",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  let rediscovered = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_twenty_wire(),
      quote: usd_hour(micros: 1320000),
      key: "offer-a-again",
      reservation: "res-a-again",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  let fresh = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-b"),
      min_bid: one_twenty_wire(),
      quote: usd_hour(micros: 1320000),
      key: "offer-b",
      reservation: "res-b",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  match first {
    FlexBidRefused { cause: _ } => false
    FlexBidAdmitted { bid: first_bid, selection: _, account: _, occupancy: _, window: _ } =>
      (money_per_hour_micros(q: first_bid) == 1100000)
        && (refusal_label(o: rediscovered) == "admitted")
        && (refusal_label(o: fresh) == "admitted")
        && (admitted_bid(o: rediscovered) == admitted_bid(o: fresh))
        && (admitted_bid(o: rediscovered) == 1320000)
        && (admitted_bid(o: rediscovered) <= 5000000)
  }
}

test fn repeated_outbid_and_rediscovery_never_admits_above_the_policy_ceiling() -> Bool {
  let policy = t_policy(cap_micros: 1500000)
  let under = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-under",
      reservation: "res-under",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  let over_min = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: ExactDecimal { units: 16, fraction_digits: 1 },
      quote: usd_hour(micros: 1760000),
      key: "offer-over",
      reservation: "res-over",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  (refusal_label(o: under) == "admitted")
    && (admitted_bid(o: under) <= 1500000)
    && (refusal_label(o: over_min) == "rate-cap")
}

test fn the_fleet_rate_cap_is_the_sum_of_standing_plus_the_proposed_bid() -> Bool {
  let policy = t_policy(cap_micros: 1500000)
  let occupied = FlexFleetOccupancy {
    standing: [AcquisitionActive { rate: usd_hour(micros: 1497000) }],
  }
  let proposed = flex_bid_admission(
    policy: policy,
    occupancy: occupied,
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-b"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-raise",
      reservation: "res-raise",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  refusal_label(o: proposed) == "rate-cap-occupied"
}

test fn an_existing_acquisition_bid_is_never_raised() -> Bool {
  let policy = t_policy(cap_micros: 5000000)
  let bound = t_bound(offer: t_offer(key: "offer-hold", rate: usd_hour(micros: 1320000)), revocable: true)
  let machine = t_machine(id: "machine-a")
  let o = flex_bid_admission(
    policy: policy,
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: FlexBidAttempt {
      machine: machine,
      min_bid: one_twenty_wire(),
      quote_currency: vast_ai_quote_currency,
      candidates: fold(
        bound,
        init: [],
        f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: machine, candidate: c }]),
      ),
      subject: FlexExistingAcquisition { current_bid: usd_hour(micros: 1100000) },
      on_demand_reference: t_on_demand_ref(rate: usd_hour(micros: 2000000), key: "on-demand-hold"),
      requirements: t_reqs(revocation: RevocationAccepted),
      reservation: "res-hold",
      generation: 1,
      delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
      tie: StableRosterOrder,
      affinity: "test.flex" as PlacementAffinityKey,
    },
  )
  refusal_label(o: o) == "existing-would-rise"
}

test fn rate_cap_and_cash_invariants_are_both_enforced() -> Bool {
  let cap_refuse = flex_bid_admission(
    policy: t_policy(cap_micros: 500000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-cap",
      reservation: "res-cap",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  let cash_refuse = flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 1000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-cash",
      reservation: "res-cash",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  (refusal_label(o: cap_refuse) == "rate-cap") && (refusal_label(o: cash_refuse) == "money")
}

test fn a_revocable_offer_is_refused_for_warm_residency() -> Bool {
  let o = flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-warm",
      reservation: "res-warm",
      revocation: WarmResidencyRequired,
      revocable: true,
    ),
  )
  refusal_label(o: o) == "supply"
}

test fn floor_buffer_is_the_exact_tenth_ratio() -> Bool {
  flex_floor_buffer.num == 1
    && nonzero_nat_fraction_field(r: flex_floor_buffer).denom == 10
    && money_per_hour_micros(q: flex_buffered_min(min_bid: one_dollar(), buffer: flex_floor_buffer)) == 1100000
}

test fn a_currency_mismatch_is_refused_not_compared() -> Bool {
  let eur_account = MoneyAccount {
    account: "flex-eur",
    currency: Eur,
    ledger: EncumbranceLedger {
      appropriation: Appropriation { ceiling: money_amount_micro(count: 10000000) },
      entries: [],
    },
    leases: [],
  }
  refusal_label(o: flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: eur_account,
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-fx",
      reservation: "res-fx",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )) == "currency"
}

test fn a_candidate_tagged_for_another_machine_is_refused() -> Bool {
  let named = t_machine(id: "machine-a")
  let other = t_machine(id: "machine-b")
  let bound = t_bound(offer: t_offer(key: "offer-b", rate: one_ten()), revocable: true)
  refusal_label(o: flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: FlexBidAttempt {
      machine: named,
      min_bid: one_dollar_wire(),
      quote_currency: vast_ai_quote_currency,
      candidates: fold(
        bound,
        init: [],
        f: (acc, c) => concat(acc, [FlexScreenedCandidate { machine: other, candidate: c }]),
      ),
      subject: FlexNewAcquisition,
      on_demand_reference: t_on_demand_ref(rate: usd_hour(micros: 2000000), key: "on-demand-mismatch"),
      requirements: t_reqs(revocation: RevocationAccepted),
      reservation: "res-mismatch",
      generation: 1,
      delay_valuation: MoneyRate { amount: money_amount_micro(count: 0), currency: Usd },
      tie: StableRosterOrder,
      affinity: "test.flex" as PlacementAffinityKey,
    },
  )) == "machine-mismatch"
}

test fn a_usd_wire_min_bid_is_refused_against_a_eur_cap() -> Bool {
  let eur_account = MoneyAccount {
    account: "flex-eur-cap",
    currency: Eur,
    ledger: EncumbranceLedger {
      appropriation: Appropriation { ceiling: money_amount_micro(count: 10000000) },
      entries: [],
    },
    leases: [],
  }
  refusal_label(o: flex_bid_admission(
    policy: t_policy_eur(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: eur_account,
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-usd-vs-eur",
      reservation: "res-usd-vs-eur",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )) == "currency"
}

test fn a_buffered_min_under_the_on_demand_relative_ceiling_admits() -> Bool {
  let o = flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-under-od",
      reservation: "res-under-od",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  (refusal_label(o: o) == "admitted") && (admitted_bid(o: o) == 1100000)
}

test fn a_buffered_min_over_the_on_demand_relative_ceiling_refuses() -> Bool {
  refusal_label(o: flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt_ref(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-over-od",
      reservation: "res-over-od",
      revocation: RevocationAccepted,
      revocable: true,
      reference: t_on_demand_ref(rate: usd_hour(micros: 1000000), key: "od-cheap"),
    ),
  )) == "on-demand-ceiling"
}

test fn a_missing_on_demand_reference_refuses() -> Bool {
  refusal_label(o: flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt_ref(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-no-od",
      reservation: "res-no-od",
      revocation: RevocationAccepted,
      revocable: true,
      reference: FlexOnDemandReferenceMissing,
    ),
  )) == "on-demand-unobserved"
}

test fn a_stale_on_demand_reference_refuses() -> Bool {
  match t_on_demand_ref(rate: usd_hour(micros: 2000000), key: "od-stale") {
    FlexOnDemandReferenceMissing => false
    FlexOnDemandReferenceFresh { candidate: c } =>
      refusal_label(o: flex_bid_admission(
        policy: t_policy(cap_micros: 5000000),
        occupancy: empty_occupancy(),
        window: t_window(remaining: 1),
        account: t_account(ceiling: 10000000),
        attempt: t_attempt_ref(
          machine: t_machine(id: "machine-a"),
          min_bid: one_dollar_wire(),
          quote: one_ten(),
          key: "offer-stale-od",
          reservation: "res-stale-od",
          revocation: RevocationAccepted,
          revocable: true,
          reference: FlexOnDemandReferenceStale { candidate: c },
        ),
      )) == "on-demand-unobserved"
    FlexOnDemandReferenceStale { candidate: _ } => false
  }
}

test fn rediscovery_never_lifts_the_on_demand_relative_ceiling() -> Bool {
  let first = flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: one_dollar_wire(),
      quote: one_ten(),
      key: "offer-first-od",
      reservation: "res-first-od",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  let lifted = flex_bid_admission(
    policy: t_policy(cap_micros: 5000000),
    occupancy: empty_occupancy(),
    window: t_window(remaining: 1),
    account: t_account(ceiling: 10000000),
    attempt: t_attempt(
      machine: t_machine(id: "machine-a"),
      min_bid: ExactDecimal { units: 19, fraction_digits: 1 },
      quote: usd_hour(micros: 2090000),
      key: "offer-rediscover-od",
      reservation: "res-rediscover-od",
      revocation: RevocationAccepted,
      revocable: true,
    ),
  )
  (refusal_label(o: first) == "admitted")
    && (admitted_bid(o: first) == 1100000)
    && (refusal_label(o: lifted) == "on-demand-ceiling")
}

test fn admission_converts_the_vast_wire_min_bid() -> Bool {
  let offer = vast_min_sample()
  match vast_ai_min_bid_money_per_hour(offer: offer) {
    DecimalMoneyPerHourRefused { conversion: _ } => false
    DecimalMoneyPerHourConverted { rate: converted } => {
      let buffered = flex_buffered_min(min_bid: converted, buffer: flex_floor_buffer)
      match flex_bid_admission(
        policy: t_policy(cap_micros: 5000000),
        occupancy: empty_occupancy(),
        window: t_window(remaining: 1),
        account: t_account(ceiling: 10000000),
        attempt: t_attempt(
          machine: t_machine(id: "machine-a"),
          min_bid: offer.min_bid,
          quote: buffered,
          key: "offer-wire",
          reservation: "res-wire",
          revocation: RevocationAccepted,
          revocable: true,
        ),
      ) {
        FlexBidRefused { cause: _ } => false
        FlexBidAdmitted { bid: b, selection: _, account: _, occupancy: _, window: _ } =>
          money_per_hour_micros(q: b) == money_per_hour_micros(q: buffered)
      }
    }
  }
}
