module test.claim.fabric_control_plane_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.durable_compare_and_set {
  CasUnreadableReadRefused, ExpectSlotAbsent,
  CasSlotObservation, CasObservedReadable, CasReadablePresent, CasSlotVersion,
  cas_generation_first,
}
import std.content_hash { content_hash_of_value }
import product.fabric.execution {
  ReservationRef, LeaseIdentity, Receipt, ReceiptPayload, SettlementReceipt, ExecutionReceipt,
  ExecutionGrant, FabricGrantObject, FabricGrantContext, FabricGrantEvidence,
}
import product.fabric.identity { FabricIdentity, OfferKey, DemandKey }
import extdeps.currency.currency { Usd, Eur, CurrencyCode }
import std.measure {
  MoneyOnce, MoneyPerSecond, money_amount_micro, Second, second, hardware_thread_count,
}
import product.fabric.work { Shape, HardRequirements }
import product.fabric.envelope { unstated_envelope }
import product.fabric.isolation { IsolationProfile }
import product.fabric.supply { SupplierOffer, QuotedPerSecond, ObservedSupply }
import extdeps.accounting.budget { Appropriation }
import extdeps.accounting.encumbrance { EncumbranceLedger, ExceedsAppropriation }
import product.fabric.budget {
  MoneyAccount, MoneyRefusal, CurrencyMismatch, LedgerRefused, StaleLeaseGeneration,
  MoneyReservationRequest, AccountAdvanced, MoneyRefused, reserve_money, release_money,
}
import product.fabric.selection {
  CandidateOffer, DispatchInputs, SelectionCost, selection_liability, bind_candidate, CandidateBound, DispatchInputsNameAnotherOffer,
  AvailabilityObservation, AvailableIndefinitely,
  CommitmentState, PayAsYouGo,
  StartCostObservation, StartCostMeasured,
  TransitionCostObservation, NoTransitionRequired,
  OperatingCostObservation, OperatingCostMeasured,
  OpportunityCostObservation, NoFeasibleAlternativeUse,
}
