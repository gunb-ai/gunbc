module test.claim.fabric.fabric_event_log_wet_witness

import extdeps.shell
import std.types { Bool, NonEmptyStr, String, List, EpochSecs }
import std.fabric_db { fabric_object_ref_of_wire, FabricObjectFetched, FabricObjectGetRefused }
import product.capacity.event_chain { PartitionId, EventId, ChainEvent, HeadExpectation, HeadAbsent, HeadAt, ChainWalked, ChainIncomplete, ChainBudgetExhausted }
import product.capacity.pool_events { PoolEvent, PoolAcquired, PoolReleased, pool_event_wire_text }
import gunbc.fabric_db_client { FabricDbBinding, FabricDbLocalFiles }
import gunbc.fabric_db_file_store { FabricDbFileRoot, fabric_db_file_root, fabric_db_file_root_ensure, fabric_db_file_get }
import gunbc.fabric_event_log {
  event_log_append, EventAppended, EventAppendStale, EventAppendRefused,
  event_log_read_partition, PartitionReadOk, PartitionReadRefused,
}

// THE EVENT LOG OVER THE FABRIC DB, by real execution against a store in a temporary directory: the
// production append and read, through the file binding the placed host uses. This is the route the
// P0-B hole broke under git -- a partition read that could not see past its tip -- and the claims
// below assert the ROUTE, not only the answer: the whole chain arrives from the store's own closure.

fn witness_partition() -> PartitionId { "witness-seats" as PartitionId }

fn fresh_files() -> FabricDbFileRoot {
  let files = fabric_db_file_root(root: shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_fabric_log.XXXXXX").path as NonEmptyStr)
  let _ready = fabric_db_file_root_ensure(root: files)
  files
}

fn event(parent: HeadExpectation, at: EpochSecs, payload: PoolEvent) -> ChainEvent<PoolEvent> {
  ChainEvent {
    partition: witness_partition(),
    parent: match parent { HeadAbsent => none  HeadAt { id: h } => Present { value: h } },
    recorded_at: at,
    actor: "witness" as NonEmptyStr,
    payload: payload,
  }
}

fn acquired(reference: String) -> PoolEvent {
  PoolAcquired { reference: reference as NonEmptyStr, amount: 1, term_seconds: 300 }
}

fn append_id(store: FabricDbBinding, parent: HeadExpectation, at: EpochSecs, payload: PoolEvent) -> EventId? {
  match event_log_append(store: store, partition: witness_partition(), event: event(parent: parent, at: at, payload: payload), expected: parent) {
    EventAppended { id: i } => Present { value: i }
    EventAppendStale { expected: _, observed: _ } => none
    EventAppendRefused { cause: _ } => none
  }
}

// THE INHABITANCE CLAIM: three chained appends, then one partition read walks all three, oldest
// first, with ids equal to what each append was answered.
test fn three_chained_appends_read_back_whole_oldest_first_by_real_execution() -> Bool {
  let store = FabricDbLocalFiles { root: fresh_files() }
  match append_id(store: store, parent: HeadAbsent, at: 1000, payload: acquired(reference: "a")) {
    Absent => false
    Present { value: a } =>
      match append_id(store: store, parent: HeadAt { id: a }, at: 1001, payload: acquired(reference: "b")) {
        Absent => false
        Present { value: b } =>
          match append_id(store: store, parent: HeadAt { id: b }, at: 1002, payload: PoolReleased { reference: "a" as NonEmptyStr, reason: "done" as NonEmptyStr }) {
            Absent => false
            Present { value: c } =>
              match event_log_read_partition(store: store, partition: witness_partition(), budget: 16) {
                PartitionReadRefused { cause: _ } => false
                PartitionReadOk { head: _, walk: w } =>
                  match w {
                    ChainWalked { oldest_first: xs } => map(xs, x => x.id as String) == [a as String, b as String, c as String]
                    ChainIncomplete { missing: _, newest_first_so_far: _ } => false
                    ChainBudgetExhausted { at: _ } => false
                  }
              }
          }
      }
  }
}

// A LOST RACE IS STALE, NEVER A REFUSAL: a second writer that also observed the empty partition is
// answered with the first writer's event as the observed head.
test fn a_second_append_against_an_absent_head_is_stale_naming_the_first_by_real_execution() -> Bool {
  let store = FabricDbLocalFiles { root: fresh_files() }
  match append_id(store: store, parent: HeadAbsent, at: 1000, payload: acquired(reference: "first")) {
    Absent => false
    Present { value: first } =>
      match event_log_append(store: store, partition: witness_partition(), event: event(parent: HeadAbsent, at: 1001, payload: acquired(reference: "racer")), expected: HeadAbsent) {
        EventAppendStale { expected: _, observed: o } => match o { HeadAt { id: h } => (h as String) == (first as String)  HeadAbsent => false }
        EventAppended { id: _ } => false
        EventAppendRefused { cause: _ } => false
      }
  }
}

// THE BYTES PUBLISHED ARE THE BYTES SERIALIZED: the stored object under an admitted event's id holds
// exactly the event's wire text. The git realization once published its empty blob as a head; here
// the object is built from the event value, and this reads it back from the file the store wrote.
test fn an_admitted_event_is_stored_as_exactly_its_wire_text_by_real_execution() -> Bool {
  let files = fresh_files()
  let e = event(parent: HeadAbsent, at: 1000, payload: acquired(reference: "exact"))
  match event_log_append(store: FabricDbLocalFiles { root: files }, partition: witness_partition(), event: e, expected: HeadAbsent) {
    EventAppended { id: i } =>
      match fabric_object_ref_of_wire(wire: i as String) {
        Absent => false
        Present { value: r } =>
          match fabric_db_file_get(root: files, object: r) {
            FabricObjectFetched { stored: s } => (s.content.body as String) == pool_event_wire_text(event: e)
            FabricObjectGetRefused { fault: _ } => false
          }
      }
    EventAppendStale { expected: _, observed: _ } => false
    EventAppendRefused { cause: _ } => false
  }
}
