module test.claim.fabric.provider_admission_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.decl_ref { DeclarationRef, decl_ref }
import std.content_hash { ContentHash, as_content_hash_structural, content_hash_atom }
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey }
import product.fabric.provider_route {
  ProviderRouteRef, CompliancePostureRevision, ProviderRouteFacts,
  ProviderDataPathClosure, ProviderPathStanding,
  ProviderPathLocated, ProviderPathAbsent, ProviderPathUnread,
  DownstreamProviderPopulation, NoDownstreamProviders, DownstreamProvidersUnread,
  data_path_closure_is_complete, downstream_is_assessed,
}
import product.fabric.provider_admission {
  RouteScopeSanction, ProviderUseScope, ProviderUseAdmission,
  ProviderUseAdmitted, ProviderUseDenied,
  ProviderRouteUnclassified, TransferOrLocationUnresolved, PostureRevisionStale,
  CustomerScopeUnsupported, RequiredAgreementAuthorityAbsent,
  admit_provider_use, admission_is_admitted,
}

// THE DISCRIMINATING CLAIMS FOR THE PROVIDER-USE JOIN. Each red below is a state the previous
// routing decision could not even express: ci_spill_policy's route_admits is a four-term
// conjunction over architecture, dedication, interruption and price, and its RouteRejection has
// four arms, none of which names a jurisdiction, a subprocessor, an access path or a data class.
// So these are not stricter versions of an existing check - they are the first checks of their
// kind on the path that actually places work.
//
// SCOPE OF THIS WITNESS, stated so a green is not read as more than it is. Four of the eight
// required reds live here, because they are properties of the admission decision itself. The
// other four - a cheapest unadmitted route never winning, a zero-dollar demand refusing without
// a permit, money not overriding a denial, and a permit not overriding an exhausted budget - are
// properties of what SELECTION does with a permit, and cannot be asserted until the permit is
// threaded through CandidateOffer, SupplySelection and issue_grant. They are deliberately absent
// rather than weakly approximated here.

fn ref_of(name: String) -> DeclarationRef {
  decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: name)
}

fn hash_of(seed: String) -> ContentHash {
  as_content_hash_structural(structural: content_hash_atom(value: seed))
}

fn posture(seed: String) -> CompliancePostureRevision {
  CompliancePostureRevision {
    authority: ref_of(name: "strategy.compliance_posture"),
    revision: hash_of(seed: seed),
  }
}

fn located(where_it_is: String) -> ProviderPathStanding {
  ProviderPathLocated {
    operator: ref_of(name: "operator"),
    jurisdiction: ref_of(name: where_it_is),
    evidence: ref_of(name: "evidence"),
  }
}

// Every governed path resolved and located in one jurisdiction.
fn closure_all_located(where_it_is: String) -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: located(where_it_is: where_it_is),
    durable_storage: located(where_it_is: where_it_is),
    backups: located(where_it_is: where_it_is),
    logs: located(where_it_is: where_it_is),
    telemetry: located(where_it_is: where_it_is),
    control_plane: located(where_it_is: where_it_is),
    support_access: located(where_it_is: where_it_is),
    administrative_access: located(where_it_is: where_it_is),
    spill: ProviderPathAbsent { evidence: ref_of(name: "no-spill-configured") },
  }
}

// The SAME closure with telemetry unread. This is the discriminator that separates "we looked
// and telemetry stays in region" from "nobody has examined where telemetry goes" - two states an
// ordinary optional destination would render identically.
fn closure_telemetry_unread(where_it_is: String) -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: located(where_it_is: where_it_is),
    durable_storage: located(where_it_is: where_it_is),
    backups: located(where_it_is: where_it_is),
    logs: located(where_it_is: where_it_is),
    telemetry: ProviderPathUnread { obligation: ref_of(name: "telemetry-destination-unread") },
    control_plane: located(where_it_is: where_it_is),
    support_access: located(where_it_is: where_it_is),
    administrative_access: located(where_it_is: where_it_is),
    spill: ProviderPathAbsent { evidence: ref_of(name: "no-spill-configured") },
  }
}

fn route_facts(
  route: ProviderRouteRef,
  paths: ProviderDataPathClosure,
  downstream: DownstreamProviderPopulation,
) -> ProviderRouteFacts {
  ProviderRouteFacts {
    route: route,
    provider: ref_of(name: "provider"),
    service: ref_of(name: "service"),
    contract_terms: ref_of(name: "contract-terms"),
    data_paths: paths,
    downstream: downstream,
    observed_at: "2026-09-07T00:00:00Z",
    facts_revision: hash_of(seed: "facts-r1"),
  }
}

fn no_downstream() -> DownstreamProviderPopulation {
  NoDownstreamProviders { evidence: ref_of(name: "provider-declares-none") }
}

fn scope_ordinary() -> ProviderUseScope<NonEmptyStr> {
  ProviderUseScope {
    demand: FabricIdentity { principal: "tenant-a", key: "demand-1" as DemandKey },
    work: FabricIdentity { principal: "tenant-a", key: "work-1" as WorkKey },
    customer_profile: ref_of(name: "us-business-pilot"),
    data_handling_profile: ref_of(name: "ordinary-build-source"),
    agreement: ref_of(name: "pilot-agreement-v1"),
    prohibited_use_disposition: ref_of(name: "permitted"),
    sanctions_disposition: ref_of(name: "cleared"),
    export_disposition: ref_of(name: "not-controlled"),
  }
}

// The same tenant asking to run a REGULATED data class the roster does not sanction.
fn scope_regulated() -> ProviderUseScope<NonEmptyStr> {
  ProviderUseScope {
    demand: FabricIdentity { principal: "tenant-a", key: "demand-1" as DemandKey },
    work: FabricIdentity { principal: "tenant-a", key: "work-2" as WorkKey },
    customer_profile: ref_of(name: "us-business-pilot"),
    data_handling_profile: ref_of(name: "ephi"),
    agreement: ref_of(name: "pilot-agreement-v1"),
    prohibited_use_disposition: ref_of(name: "permitted"),
    sanctions_disposition: ref_of(name: "cleared"),
    export_disposition: ref_of(name: "not-controlled"),
  }
}

fn offer_id() -> FabricIdentity<NonEmptyStr, OfferKey> {
  FabricIdentity { principal: "tenant-a", key: "offer-1" as OfferKey }
}

// THE ROSTER SANCTIONS ONE ROUTE IN ONE REGION FOR ONE DATA CLASS. Its sibling region is
// deliberately absent, which is the point of red 3: the roster's subject is a route, so a second
// region of the same provider is a different subject and inherits nothing.
fn roster() -> List<RouteScopeSanction> {
  [
    RouteScopeSanction {
      route: "acme/cx/region-one" as ProviderRouteRef,
      posture: posture(seed: "posture-r1"),
      customer_profile: ref_of(name: "us-business-pilot"),
      data_handling_profile: ref_of(name: "ordinary-build-source"),
      requires_agreement: ref_of(name: "pilot-agreement-v1"),
    },
  ]
}

fn decide(
  route: ProviderRouteRef,
  paths: ProviderDataPathClosure,
  downstream: DownstreamProviderPopulation,
  active: CompliancePostureRevision,
  scope: ProviderUseScope<NonEmptyStr>,
) -> ProviderUseAdmission<NonEmptyStr> {
  admit_provider_use(
    roster: roster(),
    facts: route_facts(route: route, paths: paths, downstream: downstream),
    active: active,
    scope: scope,
    offer: offer_id(),
    decision_receipt: ref_of(name: "decision-receipt"),
  )
}

// POSITIVE CONTROL. Without this every red below is satisfied by a decision that refuses
// everything, which would be a wall that carries no information.
fn admits_the_sanctioned_route() -> Bool {
  admission_is_admitted(a: decide(
    route: "acme/cx/region-one" as ProviderRouteRef,
    paths: closure_all_located(where_it_is: "jurisdiction-one"),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ))
}

// RED 2 - an unclassified route REFUSES rather than defaulting. The route is otherwise perfect:
// every path located, downstream assessed, posture current, agreement bound.
fn unclassified_route_refuses() -> Bool {
  match decide(
    route: "acme/cx/region-two" as ProviderRouteRef,
    paths: closure_all_located(where_it_is: "jurisdiction-two"),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ) {
    ProviderUseAdmitted { permit } => false,
    ProviderUseDenied { decision, cause } =>
      match cause {
        ProviderRouteUnclassified { route } => true,
        ProviderRouteFactsIncomplete { route, obligation } => false,
        PostureRevisionStale { evaluated, active } => false,
        CustomerScopeUnsupported { cause } => false,
        DataHandlingUnsupported { cause } => false,
        RequiredAgreementAuthorityAbsent { obligation } => false,
        TransferOrLocationUnresolved { obligation } => false,
        DownstreamProviderUnassessed { obligation } => false,
        ProviderAccessPathUnsupported { cause } => false,
      },
  }
}

// RED 3 - the same provider in two regions produces different standings. region-one admits and
// region-two refuses under identical facts, so a permit is a fact about a ROUTE and never about
// a company.
fn same_provider_two_regions_differ() -> Bool {
  admits_the_sanctioned_route() && unclassified_route_refuses()
}

// RED 4 - a missing telemetry path refuses customer-executable work, on a route that IS
// classified and whose posture IS current. Only the unread arm separates this from the positive
// control, so a green here cannot come from any other cause.
fn unread_telemetry_refuses() -> Bool {
  match decide(
    route: "acme/cx/region-one" as ProviderRouteRef,
    paths: closure_telemetry_unread(where_it_is: "jurisdiction-one"),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ) {
    ProviderUseAdmitted { permit } => false,
    ProviderUseDenied { decision, cause } =>
      match cause {
        TransferOrLocationUnresolved { obligation } => true,
        ProviderRouteUnclassified { route } => false,
        ProviderRouteFactsIncomplete { route, obligation } => false,
        PostureRevisionStale { evaluated, active } => false,
        CustomerScopeUnsupported { cause } => false,
        DataHandlingUnsupported { cause } => false,
        RequiredAgreementAuthorityAbsent { obligation } => false,
        DownstreamProviderUnassessed { obligation } => false,
        ProviderAccessPathUnsupported { cause } => false,
      },
  }
}

// RED 5 - a sanction written against posture R is STALE under active posture R+1. The route,
// paths, scope and agreement are all identical to the positive control; only the active posture
// revision moves.
fn stale_posture_refuses() -> Bool {
  match decide(
    route: "acme/cx/region-one" as ProviderRouteRef,
    paths: closure_all_located(where_it_is: "jurisdiction-one"),
    downstream: no_downstream(),
    active: posture(seed: "posture-r2"),
    scope: scope_ordinary(),
  ) {
    ProviderUseAdmitted { permit } => false,
    ProviderUseDenied { decision, cause } =>
      match cause {
        PostureRevisionStale { evaluated, active } => true,
        ProviderRouteUnclassified { route } => false,
        ProviderRouteFactsIncomplete { route, obligation } => false,
        CustomerScopeUnsupported { cause } => false,
        DataHandlingUnsupported { cause } => false,
        RequiredAgreementAuthorityAbsent { obligation } => false,
        TransferOrLocationUnresolved { obligation } => false,
        DownstreamProviderUnassessed { obligation } => false,
        ProviderAccessPathUnsupported { cause } => false,
      },
  }
}

// The same route, admitted for ordinary build source, REFUSES a regulated data class. This is
// what makes the permit a fact about a use rather than about a route, and it is the shape that
// keeps an ePHI workload from riding an otherwise-admitted route.
fn regulated_scope_refuses_on_admitted_route() -> Bool {
  !admission_is_admitted(a: decide(
    route: "acme/cx/region-one" as ProviderRouteRef,
    paths: closure_all_located(where_it_is: "jurisdiction-one"),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_regulated(),
  ))
}

// An unread downstream population refuses even when every first-party path is located: a
// provider's own subprocessors are part of our data path whether or not its price list says so.
fn unread_downstream_refuses() -> Bool {
  !admission_is_admitted(a: decide(
    route: "acme/cx/region-one" as ProviderRouteRef,
    paths: closure_all_located(where_it_is: "jurisdiction-one"),
    downstream: DownstreamProvidersUnread { obligation: ref_of(name: "subprocessors-unread") },
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ))
}

// Non-vacuity for the closure predicates themselves, so a green above cannot come from both
// arms of the path helpers being accidentally equal.
fn closure_predicates_discriminate() -> Bool {
  data_path_closure_is_complete(c: closure_all_located(where_it_is: "jurisdiction-one"))
    && !data_path_closure_is_complete(c: closure_telemetry_unread(where_it_is: "jurisdiction-one"))
    && downstream_is_assessed(d: no_downstream())
    && !downstream_is_assessed(d: DownstreamProvidersUnread { obligation: ref_of(name: "x") })
}

fn provider_admission_witness_main() -> ProcessExit {
  let positive = admits_the_sanctioned_route()
  let unclassified = unclassified_route_refuses()
  let two_regions = same_provider_two_regions_differ()
  let telemetry = unread_telemetry_refuses()
  let stale = stale_posture_refuses()
  let regulated = regulated_scope_refuses_on_admitted_route()
  let downstream = unread_downstream_refuses()
  let discriminating = closure_predicates_discriminate()
  if positive && unclassified && two_regions && telemetry && stale && regulated && downstream && discriminating {
    ExitSuccess
  } else {
    ExitFailure
  }
}
