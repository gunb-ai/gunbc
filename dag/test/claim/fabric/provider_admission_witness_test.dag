module test.claim.fabric.provider_admission_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.content_hash { ContentHash, as_content_hash_structural, content_hash_atom }
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey }
import product.fabric.provider_route {
  ProviderRoute, CompliancePostureRevision, ProviderRouteFacts,
  ProviderDataPathClosure, ProviderPathStanding,
  ProviderPathLocated, ProviderPathAbsent, ProviderPathUnread,
  DownstreamProviderPopulation, NoDownstreamProviders, DownstreamProvidersUnread,
  first_unresolved_obligation, downstream_obligation,
}
import product.fabric.provider_admission {
  RouteScopeSanction, ProviderUseScope, ProviderUseAdmission,
  ProviderUseAdmitted, ProviderUseDenied, ProviderUseRefusal,
  ProviderRouteUnclassified, ProviderRouteFactsIncomplete, DownstreamProviderUnassessed,
  PostureRevisionStale, CustomerScopeUnsupported, DataHandlingUnsupported,
  RequiredAgreementAuthorityAbsent, ProhibitedUseNotCleared, SanctionsNotCleared, ExportNotCleared,
  DispositionStanding, DispositionCleared, DispositionRefused, DispositionUnresolved,
  admit_provider_use,
}

// THE DISCRIMINATING CLAIMS FOR THE PROVIDER-USE JOIN. Each red below is a state the routing
// decision in this tree cannot express at all: product.fabric.supply admits an offer on
// architecture, dedication, interruption and price, so no jurisdiction, subprocessor, access path
// or data class has a spelling in the deciding path, and a refusal with no spelling can never
// fire.
//
// EVERY RED ASSERTS THE TYPED CAUSE AND THE LOCATED OBLIGATION, NOT MERELY THAT SOMETHING WAS
// REFUSED. An earlier revision of this witness asserted only that the decision was not admitted for the
// regulated-data red, which greened while the decision returned CustomerScopeUnsupported for
// what was actually a data-class mismatch - the category wrong and the remedy wrong, and the
// witness blind to both. A refusal that refuses for the wrong reason is a fabricated diagnosis
// under DESIGN section 5, so a witness that cannot see the reason is not testing the wall.
//
// SCOPE OF THIS WITNESS, stated so a green is not read as more than it is. These are properties
// of the admission DECISION. Four further required reds - a cheapest unadmitted route never
// winning, a zero-dollar demand refusing without a permit, money not overriding a denial, and a
// permit not overriding an exhausted budget - are properties of what SELECTION does with a
// permit, and cannot be asserted until it is threaded through CandidateOffer, SupplySelection
// and issue_grant. They are deliberately absent rather than weakly approximated here.


// THE SUBJECTS THIS WITNESS CITES, declared so every citation resolves. They are written out at
// each call site with both arguments as literals rather than routed through a name-taking helper:
// the declaration-index gate ingests a citation only when both arguments are string literals, so a
// helper deduplicating them would remove the citations from the gate's universe entirely - the
// exact way an earlier revision of this branch turned twenty-four real findings green without
// fixing one of them.
data acme: NonEmptyStr = "acme"
data contract_terms: NonEmptyStr = "contract-terms"
data controlled_technical_data: NonEmptyStr = "controlled-technical-data"
data cx: NonEmptyStr = "cx"
data decision_receipt: NonEmptyStr = "decision-receipt"
data ephi: NonEmptyStr = "ephi"
data eu_enterprise: NonEmptyStr = "eu-enterprise"
data evidence: NonEmptyStr = "evidence"
data export_cleared: NonEmptyStr = "export-cleared"
data jurisdiction_one: NonEmptyStr = "jurisdiction-one"
data jurisdiction_two: NonEmptyStr = "jurisdiction-two"
data no_spill_configured: NonEmptyStr = "no-spill-configured"
data operator: NonEmptyStr = "operator"
data ordinary_build_source: NonEmptyStr = "ordinary-build-source"
data pilot_agreement_v1: NonEmptyStr = "pilot-agreement-v1"
data posture_authority: NonEmptyStr = "posture-authority"
data potential_match_open: NonEmptyStr = "potential-match-open"
data prohibited_use_cleared: NonEmptyStr = "prohibited-use-cleared"
data provider_declares_none: NonEmptyStr = "provider-declares-none"
data region_one: NonEmptyStr = "region-one"
data region_two: NonEmptyStr = "region-two"
data sanctions_cleared: NonEmptyStr = "sanctions-cleared"
data some_other_agreement: NonEmptyStr = "some-other-agreement"
data subprocessors_unread: NonEmptyStr = "subprocessors-unread"
data telemetry_destination_unread: NonEmptyStr = "telemetry-destination-unread"
data us_business_pilot: NonEmptyStr = "us-business-pilot"
data use_review_open: NonEmptyStr = "use-review-open"

fn hash_of(seed: String) -> ContentHash {
  as_content_hash_structural(structural: content_hash_atom(value: seed))
}

fn posture(seed: String) -> CompliancePostureRevision {
  CompliancePostureRevision {
    authority: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "posture_authority"),
    revision: hash_of(seed: seed),
  }
}

// A route is three cited declarations. The two routes below share a provider and a service and
// differ ONLY in the region, which is what makes the two-regions red a statement about the route
// rather than about the company.
fn route_of(region: DeclarationRef) -> ProviderRoute {
  ProviderRoute {
    provider: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "acme"),
    service: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "cx"),
    region: region,
  }
}

fn located(where_it_is: DeclarationRef) -> ProviderPathStanding {
  ProviderPathLocated {
    operator: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "operator"),
    jurisdiction: where_it_is,
    evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "evidence"),
  }
}

fn telemetry_obligation() -> DeclarationRef {
  decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "telemetry_destination_unread")
}

fn subprocessor_obligation() -> DeclarationRef {
  decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "subprocessors_unread")
}

fn closure_all_located(where_it_is: DeclarationRef) -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: located(where_it_is: where_it_is),
    durable_storage: located(where_it_is: where_it_is),
    backups: located(where_it_is: where_it_is),
    logs: located(where_it_is: where_it_is),
    telemetry: located(where_it_is: where_it_is),
    control_plane: located(where_it_is: where_it_is),
    support_access: located(where_it_is: where_it_is),
    administrative_access: located(where_it_is: where_it_is),
    spill: ProviderPathAbsent { evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "no_spill_configured") },
  }
}

// The SAME closure with telemetry unread. This separates "we looked and telemetry stays in
// region" from "nobody has examined where telemetry goes" - two states an ordinary optional
// destination would render identically.
fn closure_telemetry_unread(where_it_is: DeclarationRef) -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: located(where_it_is: where_it_is),
    durable_storage: located(where_it_is: where_it_is),
    backups: located(where_it_is: where_it_is),
    logs: located(where_it_is: where_it_is),
    telemetry: ProviderPathUnread { obligation: telemetry_obligation() },
    control_plane: located(where_it_is: where_it_is),
    support_access: located(where_it_is: where_it_is),
    administrative_access: located(where_it_is: where_it_is),
    spill: ProviderPathAbsent { evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "no_spill_configured") },
  }
}

fn route_facts(
  route: ProviderRoute,
  paths: ProviderDataPathClosure,
  downstream: DownstreamProviderPopulation,
) -> ProviderRouteFacts {
  ProviderRouteFacts {
    route: route,
    contract_terms: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "contract_terms"),
    data_paths: paths,
    downstream: downstream,
    observed_at: "2026-09-07T00:00:00Z",
    facts_revision: hash_of(seed: "facts-r1"),
  }
}

fn no_downstream() -> DownstreamProviderPopulation {
  NoDownstreamProviders { evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "provider_declares_none") }
}

fn cleared(evidence: DeclarationRef) -> DispositionStanding {
  DispositionCleared { evidence: evidence }
}

fn scope_with(
  data_handling: DeclarationRef,
  prohibited: DispositionStanding,
  sanctions: DispositionStanding,
  export: DispositionStanding,
) -> ProviderUseScope<NonEmptyStr> {
  ProviderUseScope {
    demand: FabricIdentity { principal: "tenant-a", key: "demand-1" as DemandKey },
    work: FabricIdentity { principal: "tenant-a", key: "work-1" as WorkKey },
    customer_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "us_business_pilot"),
    data_handling_profile: data_handling,
    agreement: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "pilot_agreement_v1"),
    prohibited_use_disposition: prohibited,
    sanctions_disposition: sanctions,
    export_disposition: export,
  }
}

fn scope_ordinary() -> ProviderUseScope<NonEmptyStr> {
  scope_with(
    data_handling: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
    prohibited: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")),
    sanctions: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")),
    export: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")),
  )
}

fn offer_id() -> FabricIdentity<NonEmptyStr, OfferKey> {
  FabricIdentity { principal: "tenant-a", key: "offer-1" as OfferKey }
}

// THE ROSTER SANCTIONS ONE ROUTE IN ONE REGION FOR ONE DATA CLASS. Its sibling region is
// deliberately absent: the roster's subject is a route, so a second region of the same provider
// is a different subject and inherits nothing.
fn roster() -> List<RouteScopeSanction> {
  [
    RouteScopeSanction {
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      posture: posture(seed: "posture-r1"),
      customer_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "us_business_pilot"),
      data_handling_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
      requires_agreement: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "pilot_agreement_v1"),
    },
  ]
}

fn decide(
  route: ProviderRoute,
  paths: ProviderDataPathClosure,
  downstream: DownstreamProviderPopulation,
  active: CompliancePostureRevision,
  scope: ProviderUseScope<NonEmptyStr>,
) -> ProviderUseAdmission<NonEmptyStr> {
  admit_provider_use(
    roster: roster(),
    facts: route_facts(route: route, paths: paths, downstream: downstream),
    active: active,
    scope: scope,
    offer: offer_id(),
    decision_receipt: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "decision_receipt"),
  )
}

// The refusal surface read once, exhaustively, so every red below can name a cause without
// restating ten arms. A new refusal arm forces this match to be extended rather than silently
// falling into a catch-all that would let an unasserted cause pass as any other.
fn refusal_tag(c: ProviderUseRefusal) -> String {
  match c {
    ProviderRouteUnclassified { route } => "route-unclassified",
    ProviderRouteFactsIncomplete { route, obligation } => "facts-incomplete",
    DownstreamProviderUnassessed { obligation } => "downstream-unassessed",
    PostureRevisionStale { evaluated, active } => "posture-stale",
    CustomerScopeUnsupported { cause } => "customer-unsupported",
    DataHandlingUnsupported { cause } => "data-handling-unsupported",
    RequiredAgreementAuthorityAbsent { accepted } => "agreement-absent",
    ProhibitedUseNotCleared { obligation } => "prohibited-use-not-cleared",
    SanctionsNotCleared { obligation } => "sanctions-not-cleared",
    ExportNotCleared { obligation } => "export-not-cleared",
  }
}

// The located reference each refusal hands back. This is what makes "names its own remedy"
// testable rather than aspirational: the arms that carry an obligation must carry the RIGHT one.
fn refusal_located(c: ProviderUseRefusal) -> List<DeclarationRef> {
  match c {
    ProviderRouteUnclassified { route } => [],
    ProviderRouteFactsIncomplete { route, obligation } => [obligation],
    DownstreamProviderUnassessed { obligation } => [obligation],
    PostureRevisionStale { evaluated, active } => [],
    CustomerScopeUnsupported { cause } => [cause],
    DataHandlingUnsupported { cause } => [cause],
    RequiredAgreementAuthorityAbsent { accepted } => accepted,
    ProhibitedUseNotCleared { obligation } => [obligation],
    SanctionsNotCleared { obligation } => [obligation],
    ExportNotCleared { obligation } => [obligation],
  }
}

fn denied_with(a: ProviderUseAdmission<NonEmptyStr>, tag: String, located: DeclarationRef) -> Bool {
  match a {
    ProviderUseAdmitted { permit } => false,
    ProviderUseDenied { decision, cause } =>
      refusal_tag(c: cause) == tag
        && count(filter(refusal_located(c: cause), r => declaration_ref_eq(a: r, b: located))) == 1,
  }
}

// THE ARM SELECTOR IS LOCAL TO THIS WITNESS, and it is deliberately not exported beside the
// decision. A Bool over an admission coproduct is the same predicate dissolution the product
// module deleted from path_is_resolved, downstream_is_assessed and disposition_is_cleared: it
// discards the permit, so a caller that wanted the permit has to walk the value a second time,
// and the second walk is where an invented value gets to live. Exported, it reopens that
// attractor for every future caller of admit_provider_use; kept here it is only ever a witness
// asserting which arm came back. fabric_capacity_class_witness_test made the same cut in the same
// direction after dropping capacity_admission_is_admitted from its product module.
fn admitted(a: ProviderUseAdmission<NonEmptyStr>) -> Bool {
  match a {
    ProviderUseAdmitted { permit } => true,
    ProviderUseDenied { decision, cause } => false,
  }
}

fn denied_tagged(a: ProviderUseAdmission<NonEmptyStr>, tag: String) -> Bool {
  match a {
    ProviderUseAdmitted { permit } => false,
    ProviderUseDenied { decision, cause } => refusal_tag(c: cause) == tag,
  }
}

// POSITIVE CONTROL. Without this every red is satisfied by a decision that refuses everything,
// which would be a wall carrying no information.
test fn w_admits_the_sanctioned_route() -> Bool {
  admitted(a: decide(
    route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
    paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ))
}

// RED - an unclassified route REFUSES rather than defaulting, on a route that is otherwise
// perfect: every path located, downstream assessed, posture current, agreement bound.
test fn w_unclassified_route_refuses() -> Bool {
  denied_tagged(a: decide(
    route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_two")),
    paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_two")),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ), tag: "route-unclassified")
}

// RED - the same provider in two regions produces different standings, so a permit is a fact
// about a ROUTE and never about a company.
test fn w_same_provider_two_regions_differ() -> Bool {
  admitted(a: decide(
    route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
    paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  )) && denied_tagged(a: decide(
    route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_two")),
    paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_two")),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ), tag: "route-unclassified")
}

// RED - unread telemetry refuses AND the refusal names the TELEMETRY obligation, not the
// provider row. Naming the provider would keep the category right and the remedy wrong.
test fn w_unread_telemetry_names_its_obligation() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_telemetry_unread(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: scope_ordinary(),
    ),
    tag: "facts-incomplete",
    located: telemetry_obligation(),
  )
}

// RED - an unread downstream population refuses and names ITS OWN obligation. A provider's
// subprocessors are part of our data path whether or not its price list says so.
test fn w_unread_downstream_names_its_obligation() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: DownstreamProvidersUnread { obligation: subprocessor_obligation() },
      active: posture(seed: "posture-r1"),
      scope: scope_ordinary(),
    ),
    tag: "downstream-unassessed",
    located: subprocessor_obligation(),
  )
}

// RED - a sanction written against posture R is STALE under active posture R+1. Route, paths,
// scope and agreement are identical to the positive control; only the active revision moves.
test fn w_stale_posture_refuses() -> Bool {
  denied_tagged(a: decide(
    route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
    paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
    downstream: no_downstream(),
    active: posture(seed: "posture-r2"),
    scope: scope_ordinary(),
  ), tag: "posture-stale")
}

// RED - THE ONE THE EARLIER WITNESS MISSED. A regulated data class on a route admitted for
// ordinary source must refuse as DATA HANDLING unsupported, naming the data-handling profile.
// The customer profile is identical to the positive control's, so a decision that blamed the
// customer scope here would be diagnosing the wrong thing, and the previous !admitted assertion
// could not tell the difference.
test fn w_regulated_data_class_refuses_with_data_handling_cause() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: scope_with(
        data_handling: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ephi"),
        prohibited: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")),
        sanctions: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")),
        export: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")),
      ),
    ),
    tag: "data-handling-unsupported",
    located: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ephi"),
  )
}

// RED - an UNSANCTIONED CUSTOMER PROFILE refuses as customer scope, which is the sibling of the
// red above. Both are empty full-match sets; only these two together prove the decision tells
// them apart rather than collapsing both into one cause.
test fn w_unsanctioned_customer_refuses_with_customer_cause() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: ProviderUseScope {
        demand: FabricIdentity { principal: "tenant-b", key: "demand-2" as DemandKey },
        work: FabricIdentity { principal: "tenant-b", key: "work-9" as WorkKey },
        customer_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "eu_enterprise"),
        data_handling_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
        agreement: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "pilot_agreement_v1"),
        prohibited_use_disposition: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")),
        sanctions_disposition: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")),
        export_disposition: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")),
      },
    ),
    tag: "customer-unsupported",
    located: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "eu_enterprise"),
  )
}

// REDS - each of the three use dispositions gates, and each names its own program. These fields
// were previously bare references that the decision never read: an unresolved sanctions case was
// indistinguishable from a cleared one, which is the fail-open these arms exist to close.
test fn w_unresolved_sanctions_refuses() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: scope_with(
        data_handling: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
        prohibited: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")),
        sanctions: DispositionUnresolved { obligation: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "potential_match_open") },
        export: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")),
      ),
    ),
    tag: "sanctions-not-cleared",
    located: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "potential_match_open"),
  )
}

test fn w_refused_export_refuses() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: scope_with(
        data_handling: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
        prohibited: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")),
        sanctions: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")),
        export: DispositionRefused { cause: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "controlled_technical_data") },
      ),
    ),
    tag: "export-not-cleared",
    located: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "controlled_technical_data"),
  )
}

test fn w_unresolved_prohibited_use_refuses() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: scope_with(
        data_handling: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
        prohibited: DispositionUnresolved { obligation: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "use_review_open") },
        sanctions: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")),
        export: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")),
      ),
    ),
    tag: "prohibited-use-not-cleared",
    located: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "use_review_open"),
  )
}

// RED - an agreement the roster does not accept refuses, and the refusal reports the agreement
// that WOULD have bound. Every other input is identical to the positive control.
test fn w_wrong_agreement_refuses() -> Bool {
  denied_with(
    a: decide(
      route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
      paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
      downstream: no_downstream(),
      active: posture(seed: "posture-r1"),
      scope: ProviderUseScope {
        demand: FabricIdentity { principal: "tenant-a", key: "demand-1" as DemandKey },
        work: FabricIdentity { principal: "tenant-a", key: "work-1" as WorkKey },
        customer_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "us_business_pilot"),
        data_handling_profile: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "ordinary_build_source"),
        agreement: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "some_other_agreement"),
        prohibited_use_disposition: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")),
        sanctions_disposition: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")),
        export_disposition: cleared(evidence: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")),
      },
    ),
    tag: "agreement-absent",
    located: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "pilot_agreement_v1"),
  )
}

// Non-vacuity for the obligation extractors, so a green above cannot come from both arms of the
// path helpers being accidentally equal. Asserted on the OBLIGATION LISTS rather than on Bool
// predicates, because the lists are what the decision actually consumes now - a Bool helper here
// would be a second answer to a question the extractor already answers, and would be testing
// something the wall does not use.
test fn w_closure_extractors_discriminate() -> Bool {
  count(first_unresolved_obligation(c: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")))) == 0
    && count(first_unresolved_obligation(c: closure_telemetry_unread(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")))) == 1
    && count(downstream_obligation(d: no_downstream())) == 0
    && count(downstream_obligation(d: DownstreamProvidersUnread { obligation: subprocessor_obligation() })) == 1
}

// RED - the permit RECORDS the clearance evidence it gated on. The three evidences were once
// extracted with a fallback that substituted the customer profile when a disposition was not
// cleared; the fallback sat on a path the gate made unreachable, but an unreachable value naming
// the wrong kind of thing is a lie waiting for the guard to move. As zero-or-one lists there is
// nothing to substitute, and this asserts the admitted arm carries exactly one of each rather
// than an empty audit trail.
test fn w_permit_records_its_clearances() -> Bool {
  match decide(
    route: route_of(region: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "region_one")),
    paths: closure_all_located(where_it_is: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "jurisdiction_one")),
    downstream: no_downstream(),
    active: posture(seed: "posture-r1"),
    scope: scope_ordinary(),
  ) {
    ProviderUseDenied { decision, cause } => false,
    ProviderUseAdmitted { permit } =>
      count(filter(permit.evidence.prohibited_use_evidence,
                   r => declaration_ref_eq(a: r, b: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "prohibited_use_cleared")))) == 1
        && count(filter(permit.evidence.sanctions_evidence,
                        r => declaration_ref_eq(a: r, b: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "sanctions_cleared")))) == 1
        && count(filter(permit.evidence.export_evidence,
                        r => declaration_ref_eq(a: r, b: decl_ref(module_path: "test.claim.fabric.provider_admission_witness", decl_name: "export_cleared")))) == 1,
  }
}
