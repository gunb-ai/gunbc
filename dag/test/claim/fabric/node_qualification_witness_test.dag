test fn group_b_shared_window_and_different_nccl_do_not_hold() -> Bool {
  match group_b_group_admission() {
    GroupQualified { receipt: _ } => false
    GroupNotQualified { receipt: r, refusals: _ } =>
      match r.window {
        WindowSharedWithDeclaredTraffic => true
        WindowIsolated => false
        WindowStandingUnread { because: _ } => false
      }
        && match r.primitive_attribution {
          CollectivePrimitiveMeasuredOnDifferentRuntime { measured_with: _, serving: _ } => true
          CollectivePrimitiveAttributionUnestablished => false
          CollectivePrimitiveSameRuntime { nccl: _ } => false
        }
  }
}

test fn a_positive_admission_relabeled_as_another_offer_is_refused() -> Bool {
  match claimed_delivery_check(
    claim: OfferClaimsNodeDelivery {
      offer: FabricIdentity { principal: WitnessOther, key: "same-key" },
      admission: GroupQualified {
        receipt: fx_positive_group_receipt(
          offer: FabricIdentity { principal: WitnessGunbc, key: "same-key" },
        ),
      },
    },
  ) {
    ClaimedDeliveryOfferMismatch { claim_names: c, receipt_names: r } =>
      match c.principal {
        WitnessOther => match r.principal {
          WitnessGunbc => (c.key as String) == "same-key" && (r.key as String) == "same-key"
          WitnessOther => false
        }
        WitnessGunbc => false
      }
    ClaimedDeliveryHolds => false
    ClaimedDeliveryUnqualified { refusals: _ } => false
  }
}

test fn a_failing_group_receipt_wrapped_as_group_qualified_is_refused() -> Bool {
  group_admission_refusals(
    a: GroupQualified { receipt: fx_positive_group_receipt(offer: fx_offer_a()) },
  ).length() > 0
}

test fn a_failing_host_receipt_wrapped_as_host_qualified_is_refused() -> Bool {
  let unread = qualify_host(
    node: fx_node,
    advertised: fx_advertised().host,
    measured: HostMeasuredDelivery {
      accelerator_count: CountUnread { because: "not run" as NonEmptyStr },
      usable_memory: ByteSizeUnread { because: "not run" as NonEmptyStr },
      rail_link_mode: LinkModeUnread { because: "not run" as NonEmptyStr },
      nic_pcie: PcieLinkUnread { because: "not run" as NonEmptyStr },
      gpu_direct: fx_gdr_unread(),
    },
  )
  host_admission_refusals(a: HostQualified { receipt: unread }).length() > 0
}

test fn a_curve_from_another_four_host_roster_is_unread() -> Bool {
  match qualify_collective_latency(
    ceiling: nanosecond(count: 1000),
    at: byte_size(count: 8),
    expected: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
    required: fx_all_reduce_protocol(),
    reading: CollectiveCurveRead {
      observation: CollectiveObservationIdentity {
        protocol: fx_all_reduce_protocol(),
        run_identity: "fixture-all-reduce" as NonEmptyStr,
        ranks: ["other-0" as HostIdentity, "other-1" as HostIdentity],
        samples: [fx_sample()],
        provenance: SuppliedHistoricalDemonstration,
      },
      small_message_shape: SmallMessageShapeUncharacterized,
      engine_buffer_mode: EngineBufferModeUnestablished,
      per_layer_all_reduce_count: PerLayerAllReduceCountUnestablished,
      primitive_attribution: CollectivePrimitiveSameRuntime {
        nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
      },
      window: WindowIsolated,
    },
  ) {
    CollectiveLatencyUnread { ceiling: _, because: _ } => true
    CollectiveLatencyAgrees { ceiling: _, measured: _ } => false
    CollectiveLatencyFallsShort { ceiling: _, measured: _ } => false
  }
}

test fn group_a_samples_relabeled_as_group_b_do_not_agree() -> Bool {
  match qualify_collective_latency(
    ceiling: nanosecond(count: 1000),
    at: byte_size(count: 8),
    expected: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
    required: fx_all_reduce_protocol(),
    reading: CollectiveCurveRead {
      observation: CollectiveObservationIdentity {
        protocol: fx_all_reduce_protocol(),
        run_identity: "group-a-run" as NonEmptyStr,
        ranks: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
        samples: [fx_sample()],
        provenance: SuppliedHistoricalDemonstration,
      },
      small_message_shape: SmallMessageShapeUncharacterized,
      engine_buffer_mode: EngineBufferModeUnestablished,
      per_layer_all_reduce_count: PerLayerAllReduceCountUnestablished,
      primitive_attribution: CollectivePrimitiveSameRuntime {
        nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
      },
      window: WindowIsolated,
    },
  ) {
    CollectiveLatencyUnread { ceiling: _, because: b } =>
      (b as String) == (supplied_historical_curve_unread as String)
    CollectiveLatencyAgrees { ceiling: _, measured: _ } => false
    CollectiveLatencyFallsShort { ceiling: _, measured: _ } => false
  }
}

test fn a_gb10_zero_capability_receipt_is_device_unsupported() -> Bool {
  match qualify_gpu_direct(platform: spark_gb10_platform, reading: fx_gdr_unsupported_reading()) {
    GpuDirectDeviceUnsupported { capability: c } => match c {
      GpuDirectRdmaDeviceUnsupported { platform: p, dma_buf: _, capability_receipt: _ } =>
        (p as String) == (spark_gb10_platform as String)
      GpuDirectRdmaDevicePrerequisiteMet { dma_buf: _, capability_receipt: _ } => false
      GpuDirectRdmaCapabilityUnread { cause: _ } => false
    }
    GpuDirectDevicePrerequisiteMet { capability: _ } => false
    GpuDirectUnread { because: _ } => false
  }
}

test fn an_unread_gpu_direct_receipt_is_not_host_qualification() -> Bool {
  match fx_admit_host(
    m: MeasuredNodeDelivery {
      host: HostMeasuredDelivery {
        accelerator_count: CountRead { count: 4 },
        usable_memory: ByteSizeRead { bytes: byte_size(count: 1000) },
        rail_link_mode: LinkModeRead { mode: ieee_100gbase_cr2, instrument: EthtoolLinkModes },
        nic_pcie: PcieLinkRead { link: fx_pcie4(), instrument: LspciLnkSta },
        gpu_direct: fx_gdr_unread(),
      },
      group: fx_measured_all_agree().group,
    },
  ) {
    HostQualified { receipt: _ } => false
    HostNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.gpu_direct {
          GpuDirectUnread { because: _ } => true
          GpuDirectDeviceUnsupported { capability: _ } => false
          GpuDirectDevicePrerequisiteMet { capability: _ } => false
        }
  }
}
