    CollectiveLatencyAgrees { ceiling: _, measured: _ } => false
    CollectiveLatencyFallsShort { ceiling: _, measured: _ } => false
  }
}

test fn a_protocol_rank_count_that_is_not_the_roster_is_unread() -> Bool {
  match qualify_collective_latency(
    ceiling: nanosecond(count: 1000),
    at: byte_size(count: 8),
    expected: ["rank-0" as HostIdentity, "rank-1" as HostIdentity, "rank-2" as HostIdentity, "rank-3" as HostIdentity],
