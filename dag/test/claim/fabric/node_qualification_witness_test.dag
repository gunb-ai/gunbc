}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fx_node: HostIdentity = "fixture-node" as HostIdentity

fn fx_pcie16() -> PcieLink { PcieLink { generation: Gen5, lane_count: 16 } }
fn fx_pcie4() -> PcieLink { PcieLink { generation: Gen5, lane_count: 4 } }

fn fx_pcie_adv(link: PcieLink) -> AdvertisedPcie {
  AdvertisedPcie { link: link, provenance: DgxSparkConnectX7PerPortAttachment }
}

fn fx_gdr_supported() -> GpuDirectRdmaCapability {
  gpu_direct_rdma_capability(
    platform: "fixture" as NonEmptyStr,
    device_api: CudaQuerySucceeded { value: 1 },
    dma_buf: CudaQuerySucceeded { value: 0 },
  )
}

fn fx_gdr_unsupported() -> GpuDirectRdmaCapability {
  gpu_direct_rdma_capability(
    platform: "GB10" as NonEmptyStr,
    device_api: CudaQuerySucceeded { value: 0 },
    dma_buf: CudaQuerySucceeded { value: 0 },
  )
}

fn fx_gdr_unread() -> GpuDirectRdmaCapability {
  GpuDirectRdmaCapabilityUnread { cause: "cuda query not run" as NonEmptyStr }
}

fn fx_advertised() -> AdvertisedNodeOffer {
  AdvertisedNodeOffer {
    host: HostAdvertisedDelivery {
      accelerator_count: 4,
      usable_memory: byte_size(count: 1000),
      rail_link_mode: ieee_100gbase_cr2,
      nic_pcie: fx_pcie_adv(link: fx_pcie16()),
    },
    group: CollectiveGroupAdvertised {
      expected_ranks: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
      latency_ceiling: nanosecond(count: 1000),
      latency_message_bytes: byte_size(count: 8),
      all_reduce_size_semantics: EachRankContributesTheSizeColumn,
      bandwidth_floor: bandwidth(count: 100),
      bandwidth_message_bytes: byte_size(count: 8),
      all_to_all_latency_ceiling: nanosecond(count: 1000),
      all_to_all_message_bytes: byte_size(count: 8),
      all_to_all_size_semantics: TotalBufferSplitPerPeer { rank_count: 2 },
      rank_symmetry_max_latency_multiple: 2,
    },
  }
}

fn fx_sample() -> CollectiveSample {
  CollectiveSample {
    message_bytes: byte_size(count: 8),
    bus_bandwidth: bandwidth(count: 200),
    in_place_latency: nanosecond(count: 10),
    out_of_place_latency: nanosecond(count: 10),
  }
}

fn fx_curve(samples: List<CollectiveSample>) -> CollectiveCurveReading {
  CollectiveCurveRead {
    samples: samples,
    instrument: NcclTestsAllReducePerf,
    size_semantics: EachRankContributesTheSizeColumn,
    small_message_shape: SmallMessageShapeUncharacterized,
    engine_buffer_mode: EngineBufferModeUnestablished,
    per_layer_all_reduce_count: PerLayerAllReduceCountUnestablished,
    primitive_attribution: CollectivePrimitiveSameRuntime {
      nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    },
    window: WindowIsolated,
  }
}

fn fx_all_to_all_curve(samples: List<CollectiveSample>) -> CollectiveCurveReading {
  CollectiveCurveRead {
    samples: samples,
    instrument: NcclTestsAllToAllPerf,
    size_semantics: TotalBufferSplitPerPeer { rank_count: 2 },
    small_message_shape: SmallMessageShapeUncharacterized,
    engine_buffer_mode: EngineBufferModeUnestablished,
    per_layer_all_reduce_count: PerLayerAllReduceCountUnestablished,
    primitive_attribution: CollectivePrimitiveSameRuntime {
      nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    },
    window: WindowIsolated,
  }
}

fn fx_all_to_all_unread() -> CollectiveCurveReading {
  CollectiveCurveUnread { because: "fixture has no all-to-all curve" as NonEmptyStr }
}

fn fx_ib_ok() -> HostRegisteredIbFallbackStanding {
  HostRegisteredIbFallbackCitedOnServingRuntime {
    nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
  }
}

fn fx_ib_measured_only() -> HostRegisteredIbFallbackStanding {
  HostRegisteredIbFallbackCitedOnMeasuredNcclOnly {
    measured_with: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    serving_revisions_not_censused: ServingNcclIdentity {
      torch_built_against: NcclLibraryVersion { major: 2, minor: 29, patch: 7 },
      loaded_runtime: NcclLibraryVersion { major: 2, minor: 30, patch: 7 },
    },
  }
}

fn fx_ib_fallback_unread() -> HostRegisteredIbFallbackStanding {
  HostRegisteredIbFallbackUnread { because: "fixture has no IB fallback census" as NonEmptyStr }
}

fn fx_measured_all_agree() -> MeasuredNodeDelivery {
  MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: CountRead { count: 4 },
      usable_memory: ByteSizeRead { bytes: byte_size(count: 1000) },
      rail_link_mode: LinkModeRead { mode: ieee_100gbase_cr2, instrument: EthtoolLinkModes },
      nic_pcie: PcieLinkRead { link: fx_pcie16(), instrument: LspciLnkSta },
      gpu_direct_rdma: fx_gdr_supported(),
    },
    group: CollectiveGroupMeasured {
      collective: fx_curve(samples: [fx_sample()]),
      all_to_all: fx_all_to_all_curve(samples: [fx_sample()]),
      host_registered_ib_fallback: fx_ib_ok(),
      ranks: [
        RankCollectiveReading {
          rank: "rank-0" as HostIdentity,
          curve: fx_curve(samples: [fx_sample()]),
        },
        RankCollectiveReading {
          rank: "rank-1" as HostIdentity,
          curve: fx_curve(samples: [fx_sample()]),
        },
      ],
    },
  }
}

test fn a_fully_read_agreeing_node_is_qualified() -> Bool {
  match admit_qualified_node(
    receipt: qualify_node(node: fx_node, advertised: fx_advertised(), measured: fx_measured_all_agree()),
  ) {
    NodeQualified { receipt: _ } => true
    NodeNotQualified { receipt: _, refusals: _ } => false
  }
}

test fn unread_evidence_is_not_qualification() -> Bool {
  let unread = MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: CountUnread { because: "cudaGetDeviceCount not run" as NonEmptyStr },
      usable_memory: ByteSizeUnread { because: "memory query not run" as NonEmptyStr },
      rail_link_mode: LinkModeUnread { because: "ethtool not run" as NonEmptyStr },
      nic_pcie: PcieLinkUnread { because: "lspci not run" as NonEmptyStr },
      gpu_direct_rdma: fx_gdr_unread(),
    },
    group: CollectiveGroupMeasured {
      collective: CollectiveCurveUnread { because: "nccl-tests not run" as NonEmptyStr },
      all_to_all: CollectiveCurveUnread { because: "alltoall_perf not run" as NonEmptyStr },
      host_registered_ib_fallback: fx_ib_fallback_unread(),
      ranks: [],
    },
  }
  match admit_qualified_node(
    receipt: qualify_node(node: fx_node, advertised: fx_advertised(), measured: unread),
  ) {
    NodeQualified { receipt: _ } => false
    NodeNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.host.accelerators {
          AcceleratorCountUnread { advertised: n, because: _ } => n == 4
          AcceleratorCountAgrees { count: _ } => false
          AcceleratorCountFallsShort { advertised: _, measured: _ } => false
        }
        && match r.host.rail_link_mode {
          RailLinkModeUnread { advertised: _, because: _ } => true
          RailLinkModeAgrees { mode: _, instrument: _ } => false
          RailLinkModeDiffers { advertised: _, measured: _, instrument: _ } => false
        }
        && match r.group.collective_latency {
          CollectiveLatencyUnread { ceiling: _, because: _ } => true
          CollectiveLatencyAgrees { ceiling: _, measured: _ } => false
          CollectiveLatencyFallsShort { ceiling: _, measured: _ } => false
        }
        && match r.group.rank_symmetry {
          RankSymmetryUnread { because: _ } => true
          RankSymmetryAgrees { rank_count: _ } => false
          RankSymmetryFallsShort { degraded: _ } => false
        }
        && match r.host.gpu_direct_rdma {
          GpuDirectRdmaEvidenceMissing { capability: _ } => true
          GpuDirectRdmaRecorded { capability: _ } => false
        }
  }
}

test fn equal_aggregate_is_not_equal_link_mode() -> Bool {
  bandwidth_count(b: link_mode_aggregate(m: ieee_100gbase_cr2))
    == bandwidth_count(b: link_mode_aggregate(m: ieee_100gbase_cr4))
    && !link_mode_eq(a: ieee_100gbase_cr2, b: ieee_100gbase_cr4)
    && match qualify_rail_link_mode(
      advertised: ieee_100gbase_cr2,
      reading: LinkModeRead { mode: ieee_100gbase_cr4, instrument: EthtoolLinkModes },
    ) {
      RailLinkModeDiffers { advertised: a, measured: m, instrument: _ } =>
        link_mode_eq(a: a, b: ieee_100gbase_cr2) && link_mode_eq(a: m, b: ieee_100gbase_cr4)
      RailLinkModeAgrees { mode: _, instrument: _ } => false
      RailLinkModeUnread { advertised: _, because: _ } => false
    }
}

test fn realized_50g_against_advertised_100g_cr2_falls_short() -> Bool {
  match qualify_rail_link_mode(
    advertised: ieee_100gbase_cr2,
    reading: LinkModeRead { mode: ieee_50gbase_cr2, instrument: EthtoolLinkModes },
  ) {
    RailLinkModeDiffers { advertised: _, measured: m, instrument: _ } =>
      link_mode_eq(a: m, b: ieee_50gbase_cr2)
    RailLinkModeAgrees { mode: _, instrument: _ } => false
    RailLinkModeUnread { advertised: _, because: _ } => false
  }
}

test fn a_zero_from_a_succeeding_cuda_query_is_unsupported_not_unread() -> Bool {
  match gpu_direct_rdma_capability(
    platform: "GB10" as NonEmptyStr,
    device_api: CudaQuerySucceeded { value: 0 },
    dma_buf: CudaQuerySucceeded { value: 0 },
  ) {
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => true
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
    GpuDirectRdmaCapabilityUnread { cause: _ } => false
  }
}

test fn a_failed_cuda_query_is_not_a_zero() -> Bool {
  match gpu_direct_rdma_capability(
    platform: "GB10" as NonEmptyStr,
    device_api: CudaQueryFailed { result_code: 3 },
    dma_buf: CudaQuerySucceeded { value: 0 },
  ) {
    GpuDirectRdmaCapabilityUnread { cause: _ } => true
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => false
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
  }
}

test fn gb10_unsupported_gdr_does_not_refuse_a_node_that_otherwise_agrees() -> Bool {
  let measured = fx_measured_all_agree()
  let gdr_zero = MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: measured.host.accelerator_count,
      usable_memory: measured.host.usable_memory,
      rail_link_mode: measured.host.rail_link_mode,
      nic_pcie: measured.host.nic_pcie,
      gpu_direct_rdma: fx_gdr_unsupported(),
    },
    group: measured.group,
  }
  match admit_qualified_node(
    receipt: qualify_node(node: fx_node, advertised: fx_advertised(), measured: gdr_zero),
  ) {
    NodeQualified { receipt: r } => match r.host.gpu_direct_rdma {
      GpuDirectRdmaRecorded { capability: c } => match c {
        GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => true
        GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
        GpuDirectRdmaCapabilityUnread { cause: _ } => false
      }
      GpuDirectRdmaEvidenceMissing { capability: _ } => false
    }
    NodeNotQualified { receipt: _, refusals: _ } => false
  }
}

test fn fewer_accelerators_than_advertised_falls_short() -> Bool {
  match qualify_accelerator_count(advertised: 4, reading: CountRead { count: 3 }) {
    AcceleratorCountFallsShort { advertised: a, measured: m } => a == 4 && m == 3
    AcceleratorCountAgrees { count: _ } => false
    AcceleratorCountUnread { advertised: _, because: _ } => false
  }
}

fn fx_slow_sample() -> CollectiveSample {
  CollectiveSample {
    message_bytes: byte_size(count: 8),
    bus_bandwidth: bandwidth(count: 200),
    in_place_latency: nanosecond(count: 5000),
    out_of_place_latency: nanosecond(count: 5000),
  }
}

fn fx_rank_pair_advertised() -> AdvertisedNodeOffer {
  let a = fx_advertised()
  AdvertisedNodeOffer {
    host: a.host,
    group: CollectiveGroupAdvertised {
      expected_ranks: ["rank-fast" as HostIdentity, "rank-slow" as HostIdentity],
      latency_ceiling: a.group.latency_ceiling,
      latency_message_bytes: a.group.latency_message_bytes,
      all_reduce_size_semantics: a.group.all_reduce_size_semantics,
      bandwidth_floor: a.group.bandwidth_floor,
      bandwidth_message_bytes: a.group.bandwidth_message_bytes,
      all_to_all_latency_ceiling: a.group.all_to_all_latency_ceiling,
      all_to_all_message_bytes: a.group.all_to_all_message_bytes,
      all_to_all_size_semantics: a.group.all_to_all_size_semantics,
      rank_symmetry_max_latency_multiple: a.group.rank_symmetry_max_latency_multiple,
    },
  }
}

fn fx_rank(id: String, sample: CollectiveSample) -> RankCollectiveReading {
  RankCollectiveReading {
    rank: id as HostIdentity,
    curve: fx_curve(samples: [sample]),
  }
}

fn fx_measured_with_ranks(ranks: List<RankCollectiveReading>) -> MeasuredNodeDelivery {
  MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: CountRead { count: 4 },
      usable_memory: ByteSizeRead { bytes: byte_size(count: 1000) },
      rail_link_mode: LinkModeRead { mode: ieee_100gbase_cr2, instrument: EthtoolLinkModes },
      nic_pcie: PcieLinkRead { link: fx_pcie16(), instrument: LspciLnkSta },
      gpu_direct_rdma: fx_gdr_supported(),
    },
    group: CollectiveGroupMeasured {
      collective: fx_curve(samples: [fx_sample()]),
      all_to_all: fx_all_to_all_curve(samples: [fx_sample()]),
      host_registered_ib_fallback: fx_ib_ok(),
      ranks: ranks,
    },
  }
}

test fn a_degraded_rank_is_named_not_averaged() -> Bool {
  match admit_qualified_node(
    receipt: qualify_node(
      node: fx_node,
      advertised: fx_rank_pair_advertised(),
      measured: fx_measured_with_ranks(ranks: [
        fx_rank(id: "rank-fast", sample: fx_sample()),
        fx_rank(id: "rank-slow", sample: fx_slow_sample()),
      ]),
    ),
  ) {
    NodeQualified { receipt: _ } => false
    NodeNotQualified { receipt: r, refusals: _ } => match r.group.rank_symmetry {
      RankSymmetryFallsShort { degraded: d } => (d as String) == "rank-slow"
      RankSymmetryAgrees { rank_count: _ } => false
      RankSymmetryUnread { because: _ } => false
    }
  }
}

test fn a_slow_rank_listed_first_is_still_degraded() -> Bool {
  match qualify_rank_symmetry(
    expected: ["rank-fast" as HostIdentity, "rank-slow" as HostIdentity],
    ranks: [
    fx_rank(id: "rank-slow", sample: fx_slow_sample()),
    fx_rank(id: "rank-fast", sample: fx_sample()),
  ], max_latency_multiple: 2, at: byte_size(count: 8)) {
    RankSymmetryFallsShort { degraded: d } => (d as String) == "rank-slow"
    RankSymmetryAgrees { rank_count: _ } => false
    RankSymmetryUnread { because: _ } => false
  }
    && match admit_qualified_node(
      receipt: qualify_node(
        node: fx_node,
        advertised: fx_rank_pair_advertised(),
        measured: fx_measured_with_ranks(ranks: [
          fx_rank(id: "rank-slow", sample: fx_slow_sample()),
          fx_rank(id: "rank-fast", sample: fx_sample()),
        ]),
      ),
    ) {
      NodeQualified { receipt: _ } => false
      NodeNotQualified { receipt: r, refusals: _ } => match r.group.rank_symmetry {
        RankSymmetryFallsShort { degraded: d } => (d as String) == "rank-slow"
        RankSymmetryAgrees { rank_count: _ } => false
        RankSymmetryUnread { because: _ } => false
      }
    }
}

test fn group_b_live_receipt_is_not_qualified() -> Bool {
  match group_b_qualification_admission() {
    NodeQualified { receipt: _ } => false
    NodeNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.host.rail_link_mode {
          RailLinkModeDiffers { advertised: a, measured: m, instrument: _ } =>
            link_mode_eq(a: a, b: ieee_100gbase_cr2) && link_mode_eq(a: m, b: ieee_50gbase_cr2)
          RailLinkModeAgrees { mode: _, instrument: _ } => false
          RailLinkModeUnread { advertised: _, because: _ } => false
        }
        && match r.host.nic_pcie {
          NicPcieAgrees { link: m, instrument: _ } => m.lane_count == 4
          NicPcieFallsShort { advertised: _, measured: _, instrument: _ } => false
          NicPcieUnread { advertised: _, because: _ } => false
          NicPcieExceeds { advertised: _, measured: _, instrument: _ } => false
          NicPcieDiffers { advertised: _, measured: _, instrument: _ } => false
          NicPcieOfferUngrounded { advertised: _, because: _ } => false
        }
        && match r.host.gpu_direct_rdma {
          GpuDirectRdmaRecorded { capability: c } => match c {
            GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => true
            GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
            GpuDirectRdmaCapabilityUnread { cause: _ } => false
          }
          GpuDirectRdmaEvidenceMissing { capability: _ } => false
        }
  }
}

test fn group_b_curve_keeps_both_columns_and_the_16kb_step() -> Bool {
  match group_b_measured.group.collective {
    CollectiveCurveUnread { because: _ } => false
    CollectiveCurveRead {
      samples: samples,
      instrument: _,
      size_semantics: sem,
      small_message_shape: shape,
      engine_buffer_mode: buf,
      per_layer_all_reduce_count: layers,
      primitive_attribution: attr,
      window: _,
    } =>
      match samples.first() {
        Absent => false
        Present { value: s } =>
          byte_size_count(b: s.message_bytes) == 8192
            && nanosecond_count(n: s.in_place_latency) == 108420
            && nanosecond_count(n: s.out_of_place_latency) == 179540
            && nanosecond_count(n: s.in_place_latency) != nanosecond_count(n: s.out_of_place_latency)
            && match sem {
              EachRankContributesTheSizeColumn => true
              TotalBufferSplitPerPeer { rank_count: _ } => false
            }
            && match shape {
              SmallMessageStepThenPlateau { step_at: at } => byte_size_count(b: at) == 16384
              SmallMessageShapeUncharacterized => false
            }
            && match buf {
              EngineBufferModeUnestablished => true
              EngineBufferModeInPlace => false
              EngineBufferModeOutOfPlace => false
            }
            && match layers {
              PerLayerAllReduceCountUnestablished => true
              PerLayerAllReduceCount { count: _ } => false
            }
            && match attr {
              CollectivePrimitiveMeasuredOnDifferentRuntime { measured_with: m, serving: srv } =>
                m.major == 2 && m.minor == 31 && m.patch == 2
                  && srv.torch_built_against.major == 2
                  && srv.torch_built_against.minor == 29
                  && srv.torch_built_against.patch == 7
                  && srv.loaded_runtime.major == 2
                  && srv.loaded_runtime.minor == 30
                  && srv.loaded_runtime.patch == 7
                  && !(srv.torch_built_against.minor == srv.loaded_runtime.minor
                    && srv.torch_built_against.patch == srv.loaded_runtime.patch)
              CollectivePrimitiveAttributionUnestablished => false
              CollectivePrimitiveSameRuntime { nccl: _ } => false
            }
            && match group_b_measured.group.host_registered_ib_fallback {
              HostRegisteredIbFallbackCitedOnMeasuredNcclOnly {
                measured_with: fb,
                serving_revisions_not_censused: _,
              } => fb.major == 2 && fb.minor == 31 && fb.patch == 2
              HostRegisteredIbFallbackUnread { because: _ } => false
              HostRegisteredIbFallbackCitedOnServingRuntime { nccl: _ } => false
            }
      }
  }
}

test fn group_b_alltoall_size_column_is_not_allreduce_work() -> Bool {
  match group_b_measured.group.collective {
    CollectiveCurveUnread { because: _ } => false
    CollectiveCurveRead {
      samples: ar,
      instrument: _,
      size_semantics: ar_sem,
      small_message_shape: _,
      engine_buffer_mode: _,
      per_layer_all_reduce_count: _,
      primitive_attribution: _,
      window: _,
    } => match group_b_measured.group.all_to_all {
      CollectiveCurveUnread { because: _ } => false
      CollectiveCurveRead {
        samples: a2a,
        instrument: _,
        size_semantics: a2a_sem,
        small_message_shape: _,
        engine_buffer_mode: _,
        per_layer_all_reduce_count: _,
        primitive_attribution: _,
        window: _,
      } =>
        match ar.first() {
          Absent => false
          Present { value: ar0 } => match a2a.first() {
            Absent => false
            Present { value: a2a0 } =>
              byte_size_count(b: ar0.message_bytes) == byte_size_count(b: a2a0.message_bytes)
                && byte_size_count(b: ar0.message_bytes) == 8192
                && nanosecond_count(n: ar0.in_place_latency) == 108420
                && nanosecond_count(n: a2a0.in_place_latency) == 20150
                && match ar_sem {
                  EachRankContributesTheSizeColumn => true
                  TotalBufferSplitPerPeer { rank_count: _ } => false
                }
                && match a2a_sem {
                  TotalBufferSplitPerPeer { rank_count: n } => n == 4
                  EachRankContributesTheSizeColumn => false
                }
          }
        }
    }
  }
}

test fn a_cuda_value_other_than_0_or_1_is_unread_not_supported() -> Bool {
  match gpu_direct_rdma_capability(
    platform: "GB10" as NonEmptyStr,
    device_api: CudaQuerySucceeded { value: 2 },
    dma_buf: CudaQuerySucceeded { value: 0 },
  ) {
    GpuDirectRdmaCapabilityUnread { cause: _ } => true
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => false
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
  }
}

test fn a_discrete_adapter_x16_brief_is_ungrounded_not_a_node_shortfall() -> Bool {
  match qualify_nic_pcie(
    advertised: AdvertisedPcie {
      link: fx_pcie16(),
      provenance: DiscreteAdapterSkuBrief { sku: "ConnectX-7 x16 adapter brief" as NonEmptyStr },
    },
    reading: PcieLinkRead { link: fx_pcie4(), instrument: LspciLnkSta },
  ) {
    NicPcieOfferUngrounded { advertised: _, because: _ } => true
    NicPcieAgrees { link: _, instrument: _ } => false
    NicPcieFallsShort { advertised: _, measured: _, instrument: _ } => false
    NicPcieExceeds { advertised: _, measured: _, instrument: _ } => false
    NicPcieDiffers { advertised: _, measured: _, instrument: _ } => false
    NicPcieUnread { advertised: _, because: _ } => false
  }
}

test fn claiming_group_b_delivery_on_an_offer_is_refused() -> Bool {
  match claimed_delivery_refusals(
    claim: OfferClaimsNodeDelivery { admission: group_b_qualification_admission() },
  ) {
    Present { value: r } => r.length() > 0
    Absent => false
  }
}

test fn a_partly_missing_expected_rank_is_unread_not_agrees() -> Bool {
  match qualify_rank_symmetry(
    expected: ["rank-0" as HostIdentity, "rank-1" as HostIdentity, "rank-2" as HostIdentity, "rank-3" as HostIdentity],
    ranks: [
      fx_rank(id: "rank-0", sample: fx_sample()),
      fx_rank(id: "rank-1", sample: fx_sample()),
    ],
    max_latency_multiple: 2,
    at: byte_size(count: 8),
  ) {
    RankSymmetryUnread { because: _ } => true
    RankSymmetryAgrees { rank_count: _ } => false
    RankSymmetryFallsShort { degraded: _ } => false
  }
}

test fn rank_symmetry_compares_the_advertised_size_not_each_curve_head() -> Bool {
  match qualify_rank_symmetry(
    expected: ["rank-fast" as HostIdentity, "rank-other" as HostIdentity],
    ranks: [
      fx_rank(id: "rank-fast", sample: fx_sample()),
      RankCollectiveReading {
        rank: "rank-other" as HostIdentity,
        curve: fx_curve(samples: [
          CollectiveSample {
            message_bytes: byte_size(count: 1048576),
            bus_bandwidth: bandwidth(count: 200),
            in_place_latency: nanosecond(count: 4494060),
            out_of_place_latency: nanosecond(count: 4494060),
          },
        ]),
      },
    ],
    max_latency_multiple: 2,
    at: byte_size(count: 8),
  ) {
    RankSymmetryUnread { because: _ } => true
    RankSymmetryFallsShort { degraded: _ } => false
    RankSymmetryAgrees { rank_count: _ } => false
  }
}

test fn all_to_all_is_not_scored_on_all_reduce_size_semantics() -> Bool {
  match qualify_collective_latency(
    ceiling: nanosecond(count: 100000),
    at: byte_size(count: 8192),
    required_semantics: EachRankContributesTheSizeColumn,
    reading: fx_all_to_all_curve(samples: [fx_sample()]),
  ) {
    CollectiveLatencyUnread { ceiling: _, because: _ } => true
    CollectiveLatencyAgrees { ceiling: _, measured: _ } => false
    CollectiveLatencyFallsShort { ceiling: _, measured: _ } => false
  }
}

test fn ib_cited_only_on_nccl_tests_does_not_qualify() -> Bool {
  let measured = fx_measured_all_agree()
  let ib_gap = MeasuredNodeDelivery {
    host: measured.host,
    group: CollectiveGroupMeasured {
      collective: measured.group.collective,
      all_to_all: measured.group.all_to_all,
      host_registered_ib_fallback: fx_ib_measured_only(),
      ranks: measured.group.ranks,
    },
  }
  match admit_qualified_node(
    receipt: qualify_node(node: fx_node, advertised: fx_advertised(), measured: ib_gap),
  ) {
    NodeQualified { receipt: _ } => false
    NodeNotQualified { receipt: r, refusals: refusals } =>
      match r.group.host_registered_ib_fallback {
        HostRegisteredIbFallbackCitedOnMeasuredNcclOnly {
          measured_with: _,
          serving_revisions_not_censused: _,
        } => refusals.length() > 0
        HostRegisteredIbFallbackUnread { because: _ } => false
        HostRegisteredIbFallbackCitedOnServingRuntime { nccl: _ } => false
      }
  }
}

test fn group_b_shared_window_and_different_nccl_do_not_hold() -> Bool {
  match group_b_qualification_admission() {
    NodeQualified { receipt: _ } => false
    NodeNotQualified { receipt: r, refusals: _ } =>
      match r.group.window {
        WindowSharedWithDeclaredTraffic => true
        WindowIsolated => false
        WindowStandingUnread { because: _ } => false
      }
        && match r.group.primitive_attribution {
          CollectivePrimitiveMeasuredOnDifferentRuntime { measured_with: _, serving: _ } => true
          CollectivePrimitiveAttributionUnestablished => false
          CollectivePrimitiveSameRuntime { nccl: _ } => false
        }
  }
}

test fn a_truncated_cuda_reply_is_unparsed_not_unsupported() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 0 0") {
    CudaQueryUnparsed { cause: _ } => true
    CudaQuerySucceeded { value: _ } => false
    CudaQueryFailed { result_code: _ } => false
  }
}

test fn a_wrong_ordinal_cuda_reply_is_unparsed_not_this_attribute() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "124 0 0 0 0") {
    CudaQueryUnparsed { cause: _ } => true
    CudaQuerySucceeded { value: _ } => false
    CudaQueryFailed { result_code: _ } => false
  }
}

test fn group_b_gdr_stdout_parses_as_succeeding_zero() -> Bool {
  match cuda_attribute_outcome(
    a: GpuDirectRdmaSupportedAttribute,
    stdout: group_b_gdr_cu_device_get_attribute_stdout,
  ) {
    CudaQuerySucceeded { value: v } => v == 0
    CudaQueryFailed { result_code: _ } => false
    CudaQueryUnparsed { cause: _ } => false
  }
}

test fn cuda_gdr_argv_is_python_dash_c_with_ordinal_116() -> Bool {
  cuda_device_attribute_ordinal(a: GpuDirectRdmaSupportedAttribute) == 116
    && match cuda_device_attribute_argv(a: GpuDirectRdmaSupportedAttribute) {
      Cons {
        head: interpreter,
        tail: Cons {
          head: flag,
          tail: Cons { head: program, tail: Empty },
        },
      } =>
        interpreter == python_interpreter_command
          && flag == python_program_flag
          && program == (cuda_device_attribute_program(a: GpuDirectRdmaSupportedAttribute) as String)
      _ => false
    }
}

test fn group_b_gdr_wire_is_device_unsupported() -> Bool {
  (gpu_direct_rdma_capability_wire(c: group_b_measured.host.gpu_direct_rdma) as String) == "device-unsupported"
}
