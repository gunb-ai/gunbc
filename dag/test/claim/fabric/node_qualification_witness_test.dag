data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type WitnessOfferPrincipal
  = WitnessGunbc
  | WitnessOther

fn symmetry_because(s: RankSymmetryStanding, want: NonEmptyStr) -> Bool {
  match s {
    RankSymmetryUnread { because: b } => (b as String) == (want as String)
  }
}

data fx_node: HostIdentity = "fixture-node" as HostIdentity

fn fx_gdr_unread() -> GpuDirectCapabilityReading {
  GpuDirectReceiptUnread { because: "cudaDeviceGetAttribute GPUDirect probe not run" as NonEmptyStr }
}

fn fx_gdr_unsupported_reading() -> GpuDirectCapabilityReading {
  match container_incarnation_id(id: "0f3a9c1d2e4b") {
    Absent => fx_gdr_unread()
    Present { value: cid } => GpuDirectReceiptPresent {
      receipt: RankGpuDirectCapabilityReceipt {
        from: ObservedRankIncarnation { host: fx_node, container: cid, node_rank: 0 },
        device_ordinal: 0,
        device_api: ProbeReplied { stdout: "116 0 0 0 0" },
        dma_buf: ProbeReplied { stdout: "124 0 0 0 0" },
      },
    }
  }
}

fn fx_pcie16() -> PcieLink { PcieLink { generation: Gen5, lane_count: 16 } }
fn fx_pcie4() -> PcieLink { PcieLink { generation: Gen5, lane_count: 4 } }

fn fx_all_reduce_protocol() -> CollectiveProtocol {
  CollectiveProtocol {
    instrument: NcclTestsAllReducePerf,
    size_semantics: EachRankContributesTheSizeColumn,
    dtype: NcclTestsHalf,
    rank_count: 2,
  }
}

fn fx_all_to_all_protocol() -> CollectiveProtocol {
  CollectiveProtocol {
    instrument: NcclTestsAllToAllPerf,
    size_semantics: TotalBufferSplitPerPeer { rank_count: 2 },
    dtype: NcclTestsHalf,
    rank_count: 2,
  }
}

fn fx_observation(
  protocol: CollectiveProtocol,
  run: String,
  samples: List<CollectiveSample>,
) -> CollectiveObservationIdentity {
  CollectiveObservationIdentity {
    protocol: protocol,
    run_identity: run as NonEmptyStr,
    ranks: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
    samples: samples,
    provenance: SuppliedHistoricalDemonstration,
  }
}

fn fx_offer_a() -> FabricIdentity<NonEmptyStr, OfferKey> {
  FabricIdentity { principal: "gunbc", key: "fixture-offer-a" }
}

fn fx_offer_b() -> FabricIdentity<NonEmptyStr, OfferKey> {
  FabricIdentity { principal: "gunbc", key: "fixture-offer-b" }
}

fn fx_positive_group_receipt<P>(offer: FabricIdentity<P, OfferKey>) -> CollectiveGroupReceipt<P> {
  CollectiveGroupReceipt {
    offer: offer,
    advertised: fx_advertised().group,
    host_roster: GroupHostRosterComplete { rank_count: 2 },
    collective_latency: CollectiveLatencyAgrees {
      ceiling: nanosecond(count: 1000),
      measured: nanosecond(count: 10),
    },
    collective_bandwidth: CollectiveBandwidthAgrees {
      floor: bandwidth(count: 100),
      measured: bandwidth(count: 200),
    },
    all_to_all_latency: CollectiveLatencyAgrees {
      ceiling: nanosecond(count: 1000),
      measured: nanosecond(count: 10),
    },
    rank_symmetry: RankSymmetryUnread { because: rank_symmetry_unread_awaits_rank_local_receipt },
    host_registered_ib_fallback: fx_ib_ok(),
    window: WindowIsolated,
    primitive_attribution: CollectivePrimitiveSameRuntime {
      nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    },
  }
}

fn fx_advertised() -> AdvertisedNodeOffer {
  AdvertisedNodeOffer {
    host: HostAdvertisedDelivery {
      accelerator_count: 4,
      usable_memory: byte_size(count: 1000),
      rail_link_mode: ieee_100gbase_cr2,
      nic_pcie: AdvertisedSparkConnectX7PerPort,
      gpu_direct_platform: spark_gb10_platform,
    },
    group: CollectiveGroupAdvertised {
      expected_ranks: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
      latency_ceiling: nanosecond(count: 1000),
      latency_message_bytes: byte_size(count: 8),
      all_reduce_protocol: fx_all_reduce_protocol(),
      bandwidth_floor: bandwidth(count: 100),
      bandwidth_message_bytes: byte_size(count: 8),
      all_to_all_latency_ceiling: nanosecond(count: 1000),
      all_to_all_message_bytes: byte_size(count: 8),
      all_to_all_protocol: fx_all_to_all_protocol(),
    },
  }
}

fn fx_sample() -> CollectiveSample {
  CollectiveSample {
    message_bytes: byte_size(count: 8),
    bus_bandwidth: bandwidth(count: 200),
    in_place_latency: nanosecond(count: 10),
    out_of_place_latency: nanosecond(count: 10),
  }
}

fn fx_curve(samples: List<CollectiveSample>) -> CollectiveCurveReading {
  CollectiveCurveRead {
    observation: fx_observation(protocol: fx_all_reduce_protocol(), run: "fixture-all-reduce", samples: samples),
    small_message_shape: SmallMessageShapeUncharacterized,
    engine_buffer_mode: EngineBufferModeUnestablished,
    per_layer_all_reduce_count: PerLayerAllReduceCountUnestablished,
    primitive_attribution: CollectivePrimitiveSameRuntime {
      nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    },
    window: WindowIsolated,
  }
}

fn fx_all_to_all_curve(samples: List<CollectiveSample>) -> CollectiveCurveReading {
  CollectiveCurveRead {
    observation: fx_observation(protocol: fx_all_to_all_protocol(), run: "fixture-all-to-all", samples: samples),
    small_message_shape: SmallMessageShapeUncharacterized,
    engine_buffer_mode: EngineBufferModeUnestablished,
    per_layer_all_reduce_count: PerLayerAllReduceCountUnestablished,
    primitive_attribution: CollectivePrimitiveSameRuntime {
      nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    },
    window: WindowIsolated,
  }
}

fn fx_ib_ok() -> HostRegisteredIbFallbackStanding {
  HostRegisteredIbFallbackCitedOnServingRuntime {
    nccl: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
  }
}

fn fx_ib_measured_only() -> HostRegisteredIbFallbackStanding {
  HostRegisteredIbFallbackCitedOnMeasuredNcclOnly {
    measured_with: NcclLibraryVersion { major: 2, minor: 31, patch: 2 },
    serving_revisions_not_censused: ServingNcclIdentity {
      torch_built_against: NcclLibraryVersion { major: 2, minor: 29, patch: 7 },
      loaded_runtime: NcclLibraryVersion { major: 2, minor: 30, patch: 7 },
    },
  }
}

fn fx_ib_fallback_unread() -> HostRegisteredIbFallbackStanding {
  HostRegisteredIbFallbackUnread { because: "fixture has no IB fallback census" as NonEmptyStr }
}

fn fx_measured_all_agree() -> MeasuredNodeDelivery {
  MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: CountRead { count: 4 },
      usable_memory: ByteSizeRead { bytes: byte_size(count: 1000) },
      rail_link_mode: LinkModeRead { mode: ieee_100gbase_cr2, instrument: EthtoolLinkModes },
      nic_pcie: PcieLinkRead { link: fx_pcie4(), instrument: LspciLnkSta },
      gpu_direct: fx_gdr_unsupported_reading(),
    },
    group: CollectiveGroupMeasured {
      collective: fx_curve(samples: [fx_sample()]),
      all_to_all: fx_all_to_all_curve(samples: [fx_sample()]),
      host_registered_ib_fallback: fx_ib_ok(),
      ranks: [
        RankCollectiveReading {
          rank: "rank-0" as HostIdentity,
          curve: fx_curve(samples: [fx_sample()]),
          producer: RankLocalCollectiveCurve,
        },
        RankCollectiveReading {
          rank: "rank-1" as HostIdentity,
          curve: fx_curve(samples: [fx_sample()]),
          producer: RankLocalCollectiveCurve,
        },
      ],
    },
  }
}

test fn a_fully_read_agreeing_node_is_qualified() -> Bool {
  match fx_admit_host(m: fx_measured_all_agree()) {
    HostQualified { receipt: _ } => true
    HostNotQualified { receipt: _, refusals: _ } => false
  } && match fx_admit_group(m: fx_measured_all_agree()) {
    GroupQualified { receipt: _ } => false
    GroupNotQualified { receipt: r, refusals: _ } =>
      symmetry_because(s: r.rank_symmetry, want: rank_symmetry_unread_awaits_rank_local_receipt)
  }
}

fn fx_rank(id: String, sample: CollectiveSample) -> RankCollectiveReading {
  RankCollectiveReading {
    rank: id as HostIdentity,
    curve: fx_curve(samples: [sample]),
    producer: RankLocalCollectiveCurve,
  }
}

fn fx_pair_hosts() -> List<HostQualificationAdmission> {
  [
    admit_qualified_host(
      receipt: qualify_host(
        node: "rank-0" as HostIdentity,
        advertised: fx_advertised().host,
        measured: fx_measured_all_agree().host,
      ),
    ),
    admit_qualified_host(
      receipt: qualify_host(
        node: "rank-1" as HostIdentity,
        advertised: fx_advertised().host,
        measured: fx_measured_all_agree().host,
      ),
    ),
  ]
}

fn fx_unqualified_host_measured() -> HostMeasuredDelivery {
  HostMeasuredDelivery {
    accelerator_count: CountRead { count: 4 },
    usable_memory: ByteSizeRead { bytes: byte_size(count: 1000) },
    rail_link_mode: LinkModeRead { mode: ieee_50gbase_cr2, instrument: EthtoolLinkModes },
    nic_pcie: PcieLinkRead { link: fx_pcie4(), instrument: LspciLnkSta },
    gpu_direct: fx_gdr_unsupported_reading(),
  }
}

fn fx_pair_unqualified_hosts() -> List<HostQualificationAdmission> {
  [
    admit_qualified_host(
      receipt: qualify_host(
        node: "rank-0" as HostIdentity,
        advertised: fx_advertised().host,
        measured: fx_unqualified_host_measured(),
      ),
    ),
    admit_qualified_host(
      receipt: qualify_host(
        node: "rank-1" as HostIdentity,
        advertised: fx_advertised().host,
        measured: fx_unqualified_host_measured(),
      ),
    ),
  ]
}

fn fx_admit_host(m: MeasuredNodeDelivery) -> HostQualificationAdmission {
  admit_qualified_host(
    receipt: qualify_host(node: fx_node, advertised: fx_advertised().host, measured: m.host),
  )
}

fn fx_admit_group(m: MeasuredNodeDelivery) -> GroupQualificationAdmission<NonEmptyStr> {
  admit_qualified_group(
    receipt: qualify_collective_group(
      offer: fx_offer_a(),
      advertised: fx_advertised().group,
      measured: m.group,
      host_admissions: fx_pair_hosts(),
    ),
  )
}

fn fx_admit_group_for(
  advertised: AdvertisedNodeOffer,
  m: MeasuredNodeDelivery,
  hosts: List<HostQualificationAdmission>,
) -> GroupQualificationAdmission<NonEmptyStr> {
  admit_qualified_group(
    receipt: qualify_collective_group(
      offer: fx_offer_a(),
      advertised: advertised.group,
      measured: m.group,
      host_admissions: hosts,
    ),
  )
}

fn fx_measured_with_ranks(ranks: List<RankCollectiveReading>) -> MeasuredNodeDelivery {
  MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: CountRead { count: 4 },
      usable_memory: ByteSizeRead { bytes: byte_size(count: 1000) },
      rail_link_mode: LinkModeRead { mode: ieee_100gbase_cr2, instrument: EthtoolLinkModes },
      nic_pcie: PcieLinkRead { link: fx_pcie4(), instrument: LspciLnkSta },
      gpu_direct: fx_gdr_unsupported_reading(),
    },
    group: CollectiveGroupMeasured {
      collective: fx_curve(samples: [fx_sample()]),
      all_to_all: fx_all_to_all_curve(samples: [fx_sample()]),
      host_registered_ib_fallback: fx_ib_ok(),
      ranks: ranks,
    },
  }
}

test fn unread_evidence_is_not_qualification() -> Bool {
  let unread = MeasuredNodeDelivery {
    host: HostMeasuredDelivery {
      accelerator_count: CountUnread { because: "cudaGetDeviceCount not run" as NonEmptyStr },
      usable_memory: ByteSizeUnread { because: "memory query not run" as NonEmptyStr },
      rail_link_mode: LinkModeUnread { because: "ethtool not run" as NonEmptyStr },
      nic_pcie: PcieLinkUnread { because: "lspci not run" as NonEmptyStr },
      gpu_direct: fx_gdr_unread(),
    },
    group: CollectiveGroupMeasured {
      collective: CollectiveCurveUnread { because: "nccl-tests not run" as NonEmptyStr },
      all_to_all: CollectiveCurveUnread { because: "alltoall_perf not run" as NonEmptyStr },
      host_registered_ib_fallback: fx_ib_fallback_unread(),
      ranks: [],
    },
  }
  match fx_admit_host(m: unread) {
    HostNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.accelerators {
          AcceleratorCountUnread { advertised: n, because: _ } => n == 4
          AcceleratorCountAgrees { count: _ } => false
          AcceleratorCountFallsShort { advertised: _, measured: _ } => false
        }
    HostQualified { receipt: _ } => false
  } && match fx_admit_group(m: unread) {
    GroupNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.collective_latency {
          CollectiveLatencyUnread { ceiling: _, because: _ } => true
          CollectiveLatencyAgrees { ceiling: _, measured: _ } => false
          CollectiveLatencyFallsShort { ceiling: _, measured: _ } => false
        }
        && match r.rank_symmetry {
          RankSymmetryUnread { because: b } =>
            (b as String) == (rank_symmetry_unread_missing_rank as String)
        }
    GroupQualified { receipt: _ } => false
  }
}

test fn equal_aggregate_is_not_equal_link_mode() -> Bool {
  bandwidth_count(b: link_mode_aggregate(m: ieee_100gbase_cr2))
    == bandwidth_count(b: link_mode_aggregate(m: ieee_100gbase_cr4))
    && !link_mode_eq(a: ieee_100gbase_cr2, b: ieee_100gbase_cr4)
    && match qualify_rail_link_mode(
      advertised: ieee_100gbase_cr2,
      reading: LinkModeRead { mode: ieee_100gbase_cr4, instrument: EthtoolLinkModes },
    ) {
      RailLinkModeDiffers { advertised: a, measured: m, instrument: _ } =>
        link_mode_eq(a: a, b: ieee_100gbase_cr2) && link_mode_eq(a: m, b: ieee_100gbase_cr4)
      RailLinkModeAgrees { mode: _, instrument: _ } => false
      RailLinkModeUnread { advertised: _, because: _ } => false
    }
}

test fn realized_50g_against_advertised_100g_cr2_falls_short() -> Bool {
  match qualify_rail_link_mode(
    advertised: ieee_100gbase_cr2,
    reading: LinkModeRead { mode: ieee_50gbase_cr2, instrument: EthtoolLinkModes },
  ) {
    RailLinkModeDiffers { advertised: _, measured: m, instrument: _ } =>
      link_mode_eq(a: m, b: ieee_50gbase_cr2)
    RailLinkModeAgrees { mode: _, instrument: _ } => false
    RailLinkModeUnread { advertised: _, because: _ } => false
  }
}

test fn fewer_accelerators_than_advertised_falls_short() -> Bool {
  match qualify_accelerator_count(advertised: 4, reading: CountRead { count: 3 }) {
    AcceleratorCountFallsShort { advertised: a, measured: m } => a == 4 && m == 3
    AcceleratorCountAgrees { count: _ } => false
    AcceleratorCountUnread { advertised: _, because: _ } => false
  }
}

test fn group_b_live_receipt_is_not_qualified() -> Bool {
  match group_b_host_admission() {
    HostQualified { receipt: _ } => false
    HostNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.rail_link_mode {
          RailLinkModeDiffers { advertised: a, measured: m, instrument: _ } =>
            link_mode_eq(a: a, b: ieee_100gbase_cr2) && link_mode_eq(a: m, b: ieee_50gbase_cr2)
          RailLinkModeAgrees { mode: _, instrument: _ } => false
          RailLinkModeUnread { advertised: _, because: _ } => false
        }
        && match r.nic_pcie {
          NicPcieAgrees { link: m, instrument: _ } => m.lane_count == 4
          NicPcieFallsShort { advertised: _, measured: _, instrument: _ } => false
          NicPcieUnread { advertised: _, because: _ } => false
          NicPcieExceeds { advertised: _, measured: _, instrument: _ } => false
          NicPcieDiffers { advertised: _, measured: _, instrument: _ } => false
          NicPcieOfferUngrounded { advertised: _, because: _ } => false
        }
  } && match group_b_group_admission() {
    GroupQualified { receipt: _ } => false
    GroupNotQualified { receipt: r, refusals: refusals } =>
      refusals.length() > 0
        && match r.host_roster {
          GroupHostRosterUnread { because: _ } => true
          GroupHostRosterComplete { rank_count: _ } => false
          GroupMemberNotQualified { host: _, receipt: _ } => false
        }
  }
}

test fn group_b_curve_keeps_both_columns_and_the_16kb_step() -> Bool {
  match group_b_measured.group.collective {
    CollectiveCurveUnread { because: _ } => false
    CollectiveCurveRead {
      observation: proto,
      small_message_shape: shape,
      engine_buffer_mode: buf,
      per_layer_all_reduce_count: layers,
      primitive_attribution: attr,
      window: _,
    } =>
      match proto.samples.first() {
        Absent => false
        Present { value: s } =>
          byte_size_count(b: s.message_bytes) == 8192
            && nanosecond_count(n: s.in_place_latency) == 108420
            && nanosecond_count(n: s.out_of_place_latency) == 179540
            && nanosecond_count(n: s.in_place_latency) != nanosecond_count(n: s.out_of_place_latency)
            && match proto.protocol.size_semantics {
              EachRankContributesTheSizeColumn => true
              TotalBufferSplitPerPeer { rank_count: _ } => false
            }
            && match shape {
              SmallMessageStepThenPlateau { step_at: at } => byte_size_count(b: at) == 16384
              SmallMessageShapeUncharacterized => false
            }
            && match buf {
              EngineBufferModeUnestablished => true
              EngineBufferModeInPlace => false
              EngineBufferModeOutOfPlace => false
            }
            && match layers {
              PerLayerAllReduceCountUnestablished => true
              PerLayerAllReduceCount { count: _ } => false
            }
            && match attr {
              CollectivePrimitiveMeasuredOnDifferentRuntime { measured_with: m, serving: srv } =>
                m.major == 2 && m.minor == 31 && m.patch == 2
                  && srv.torch_built_against.major == 2
                  && srv.torch_built_against.minor == 29
                  && srv.torch_built_against.patch == 7
                  && srv.loaded_runtime.major == 2
                  && srv.loaded_runtime.minor == 30
                  && srv.loaded_runtime.patch == 7
                  && !(srv.torch_built_against.minor == srv.loaded_runtime.minor
                    && srv.torch_built_against.patch == srv.loaded_runtime.patch)
              CollectivePrimitiveAttributionUnestablished => false
              CollectivePrimitiveSameRuntime { nccl: _ } => false
            }
            && match group_b_measured.group.host_registered_ib_fallback {
              HostRegisteredIbFallbackCitedOnMeasuredNcclOnly {
                measured_with: fb,
                serving_revisions_not_censused: _,
              } => fb.major == 2 && fb.minor == 31 && fb.patch == 2
              HostRegisteredIbFallbackUnread { because: _ } => false
              HostRegisteredIbFallbackCitedOnServingRuntime { nccl: _ } => false
            }
      }
  }
}

test fn group_b_alltoall_size_column_is_not_allreduce_work() -> Bool {
  match group_b_measured.group.collective {
    CollectiveCurveUnread { because: _ } => false
    CollectiveCurveRead {
      observation: ar_proto,
      small_message_shape: _,
      engine_buffer_mode: _,
      per_layer_all_reduce_count: _,
      primitive_attribution: _,
      window: _,
    } => match group_b_measured.group.all_to_all {
      CollectiveCurveUnread { because: _ } => false
      CollectiveCurveRead {
        observation: a2a_proto,
        small_message_shape: _,
        engine_buffer_mode: _,
        per_layer_all_reduce_count: _,
        primitive_attribution: _,
        window: _,
      } =>
        match ar_proto.samples.first() {
          Absent => false
          Present { value: ar0 } => match a2a_proto.samples.first() {
            Absent => false
            Present { value: a2a0 } =>
              byte_size_count(b: ar0.message_bytes) == byte_size_count(b: a2a0.message_bytes)
                && byte_size_count(b: ar0.message_bytes) == 8192
                && nanosecond_count(n: ar0.in_place_latency) == 108420
                && nanosecond_count(n: a2a0.in_place_latency) == 20150
                && match ar_proto.protocol.size_semantics {
                  EachRankContributesTheSizeColumn => true
                  TotalBufferSplitPerPeer { rank_count: _ } => false
                }
                && match a2a_proto.protocol.size_semantics {
                  TotalBufferSplitPerPeer { rank_count: n } => n == 4
                  EachRankContributesTheSizeColumn => false
                }
                && (ar_proto.run_identity as String) != (a2a_proto.run_identity as String)
          }
        }
    }
  }
}

test fn a_discrete_adapter_x16_brief_is_ungrounded_not_a_node_shortfall() -> Bool {
  match qualify_nic_pcie(
    advertised: AdvertisedDiscreteAdapterSku {
      sku: "ConnectX-7 x16 adapter brief" as NonEmptyStr,
      link: fx_pcie16(),
    },
    reading: PcieLinkRead { link: fx_pcie4(), instrument: LspciLnkSta },
  ) {
    NicPcieOfferUngrounded { advertised: _, because: _ } => true
    NicPcieAgrees { link: _, instrument: _ } => false
    NicPcieFallsShort { advertised: _, measured: _, instrument: _ } => false
    NicPcieExceeds { advertised: _, measured: _, instrument: _ } => false
    NicPcieDiffers { advertised: _, measured: _, instrument: _ } => false
    NicPcieUnread { advertised: _, because: _ } => false
  }
}

test fn spark_per_port_attachment_does_not_admit_a_caller_x16() -> Bool {
  match qualify_nic_pcie(
    advertised: AdvertisedSparkConnectX7PerPort,
    reading: PcieLinkRead { link: fx_pcie16(), instrument: LspciLnkSta },
  ) {
    NicPcieExceeds { advertised: a, measured: m, instrument: _ } =>
      a.lane_count == 4 && m.lane_count == 16
    NicPcieAgrees { link: _, instrument: _ } => false
    NicPcieFallsShort { advertised: _, measured: _, instrument: _ } => false
    NicPcieDiffers { advertised: _, measured: _, instrument: _ } => false
    NicPcieOfferUngrounded { advertised: _, because: _ } => false
    NicPcieUnread { advertised: _, because: _ } => false
  }
}

test fn claiming_group_b_delivery_on_an_offer_is_refused() -> Bool {
  match claimed_delivery_refusals(claim: group_b_delivery_claim) {
    Present { value: r } => r.length() > 0
    Absent => false
  }
}

test fn a_partly_missing_expected_rank_is_unread_not_agrees() -> Bool {
  symmetry_because(
    s: qualify_rank_symmetry(
      expected: ["rank-0" as HostIdentity, "rank-1" as HostIdentity],
      ranks: [
        fx_rank(id: "rank-0", sample: fx_sample()),
      ],
      required: fx_all_reduce_protocol(),
    ),
    want: rank_symmetry_unread_missing_rank,
  )
}

test fn one_host_receipt_does_not_qualify_a_two_rank_group() -> Bool {
  match fx_admit_group_for(
    advertised: fx_advertised(),
    m: fx_measured_all_agree(),
    hosts: [
      admit_qualified_host(
        receipt: qualify_host(
          node: "rank-0" as HostIdentity,
          advertised: fx_advertised().host,
          measured: fx_measured_all_agree().host,
        ),
      ),
    ],
  ) {
    GroupQualified { receipt: _ } => false
    GroupNotQualified { receipt: r, refusals: _ } => match r.host_roster {
      GroupHostRosterUnread { because: _ } => true
      GroupHostRosterComplete { rank_count: _ } => false
      GroupMemberNotQualified { host: _, receipt: _ } => false
    }
  }
}

test fn a_complete_roster_of_unqualified_hosts_does_not_qualify_the_group() -> Bool {
  match fx_admit_group_for(
    advertised: fx_advertised(),
    m: fx_measured_all_agree(),
    hosts: fx_pair_unqualified_hosts(),
  ) {
    GroupQualified { receipt: _ } => false
    GroupNotQualified { receipt: r, refusals: _ } => match r.host_roster {
      GroupMemberNotQualified { host: _, receipt: rec } =>
        host_qualification_refusals(receipt: rec).length() > 0
      GroupHostRosterUnread { because: _ } => false
      GroupHostRosterComplete { rank_count: _ } => false
    }
  }
}

