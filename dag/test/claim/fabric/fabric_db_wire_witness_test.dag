module test.claim.fabric.fabric_db_wire_witness

import std.types { NonEmptyStr, String, Bool }
import std.durable_compare_and_set { CasSlotObservationRefused, CasUnreadableObservationBoundExceeded, CasGenerationPublicationRefused }
import std.fabric_db {
  FabricObject, fabric_object_ref_of, fabric_object_ref_eq, fabric_object_preimage, FabricStoredObject,
  FabricHeadAbsent, FabricHeadAt, ExpectHeadAt,
  FabricStoreUnreachable, FabricStoreRefused, FabricObjectMissing, FabricReplyUndecodable,
  FabricHeadObserved, FabricHeadReadRefused, FabricHeadMoved, FabricHeadAdvanced, FabricHeadAdvanceRefused,
  FabricClosureRead, FabricClosureRefused,
}
import gunbc.fabric_db_wire {
  fabric_db_wire_head, fabric_db_wire_advance, fabric_db_wire_closure,
  fabric_db_unwire_head, fabric_db_unwire_advance, fabric_db_unwire_closure,
}
import gunbc.fabric_db_client { served_reply_from, ServedAnswered, ServedFault }

// Evidence that the typed arms survive the hop: each outcome the store side writes is read back as
// the same arm by the caller side, and the transport outcome is classified before any reply. Values
// are supplied; the served route's execution is the live endpoint's receipt.

fn a() -> FabricObject { FabricObject { links: [], body: "a" } }
fn b() -> FabricObject { FabricObject { links: [fabric_object_ref_of(object: a())], body: "b\nwith a newline" } }

test fn a_lost_race_crosses_the_wire_as_a_lost_race_naming_the_winner() -> Bool {
  let moved = FabricHeadMoved { expected: ExpectHeadAt { object: fabric_object_ref_of(object: a()) }, observed: FabricHeadAt { object: fabric_object_ref_of(object: b()), generation: 2 } }
  match fabric_db_unwire_advance(text: fabric_db_wire_advance(advance: moved)) {
    FabricHeadMoved { expected: _, observed: o } => match o { FabricHeadAt { object: w, generation: g } => fabric_object_ref_eq(a: w, b: fabric_object_ref_of(object: b())) && g == 2  FabricHeadAbsent => false }
    _ => false
  }
}

test fn a_missing_object_crosses_the_wire_as_missing_not_as_a_store_refusal() -> Bool {
  match fabric_db_unwire_advance(text: fabric_db_wire_advance(advance: FabricHeadAdvanceRefused { fault: FabricObjectMissing { object: fabric_object_ref_of(object: a()) } })) {
    FabricHeadAdvanceRefused { fault: f } => match f { FabricObjectMissing { object: m } => fabric_object_ref_eq(a: m, b: fabric_object_ref_of(object: a()))  _ => false }
    _ => false
  }
}

test fn a_store_bound_refusal_keeps_its_cause_across_the_wire() -> Bool {
  let refused = FabricHeadReadRefused { fault: FabricStoreRefused { cause: CasSlotObservationRefused { cause: CasUnreadableObservationBoundExceeded { bound: 4096 } } } }
  match fabric_db_unwire_head(text: fabric_db_wire_head(read: refused)) {
    FabricHeadReadRefused { fault: f } => match f {
      FabricStoreRefused { cause: c } => match c { CasSlotObservationRefused { cause: u } => match u { CasUnreadableObservationBoundExceeded { bound: n } => n == 4096  _ => false }  _ => false }
      _ => false
    }
    FabricHeadObserved { reading: _ } => false
  }
}

test fn a_closure_whose_bodies_hold_newlines_round_trips_whole() -> Bool {
  let read = FabricClosureRead {
    reading: FabricHeadAt { object: fabric_object_ref_of(object: b()), generation: 2 },
    newest_first: [FabricStoredObject { object: fabric_object_ref_of(object: b()), content: b() }, FabricStoredObject { object: fabric_object_ref_of(object: a()), content: a() }],
  }
  match fabric_db_unwire_closure(text: fabric_db_wire_closure(read: read)) {
    FabricClosureRead { reading: _, newest_first: xs } => length(xs) == 2
    _ => false
  }
}

test fn a_closure_whose_tip_is_not_the_named_head_is_refused() -> Bool {
  let read = FabricClosureRead {
    reading: FabricHeadAt { object: fabric_object_ref_of(object: b()), generation: 2 },
    newest_first: [FabricStoredObject { object: fabric_object_ref_of(object: a()), content: a() }],
  }
  match fabric_db_unwire_closure(text: fabric_db_wire_closure(read: read)) {
    FabricClosureRefused { fault: f } => match f { FabricReplyUndecodable { detail: _ } => true  _ => false }
    _ => false
  }
}

test fn a_reply_in_another_protocol_is_undecodable_not_a_store_answer() -> Bool {
  match fabric_db_unwire_head(text: "fabric_db/2 head absent") {
    FabricHeadReadRefused { fault: f } => match f { FabricReplyUndecodable { detail: _ } => true  _ => false }
    FabricHeadObserved { reading: _ } => false
  }
}

// THE TRANSPORT ARMS: curl never connecting is unreachable; an answered non-200 is undecodable; an
// answered 200 is decoded. The git realization answered a lost race and an unreachable store both
// with exit 128.
test fn a_connect_failure_is_unreachable_before_any_reply_is_read() -> Bool {
  match served_reply_from(exit_code: 7, stdout: "", stderr: "Failed to connect") {
    ServedFault { fault: f } => match f { FabricStoreUnreachable { detail: _ } => true  _ => false }
    ServedAnswered { body: _ } => false
  }
}

test fn a_timeout_is_unreachable() -> Bool {
  match served_reply_from(exit_code: 28, stdout: "", stderr: "timed out") {
    ServedFault { fault: f } => match f { FabricStoreUnreachable { detail: _ } => true  _ => false }
    ServedAnswered { body: _ } => false
  }
}

test fn an_answered_non_200_is_undecodable_not_unreachable() -> Bool {
  match served_reply_from(exit_code: 0, stdout: "fabric_db/1 no route /x\n404", stderr: "") {
    ServedFault { fault: f } => match f { FabricReplyUndecodable { detail: _ } => true  _ => false }
    ServedAnswered { body: _ } => false
  }
}

test fn an_answered_200_hands_back_the_body_without_the_status_line() -> Bool {
  match served_reply_from(exit_code: 0, stdout: "fabric_db/1 head absent\n200", stderr: "") {
    ServedAnswered { body: body } => body == "fabric_db/1 head absent"
    ServedFault { fault: _ } => false
  }
}
