  ProviderRoute {
    provider: decl_ref(module_path: "extdeps.cloud.hetzner", decl_name: "extdeps_external_authority_anchor"),
    service: decl_ref(module_path: "extdeps.cloud.hetzner", decl_name: "hetzner_cloud_listed_catalog"),
    region: decl_ref(module_path: "test.claim.fabric.spill_candidate_field_witness", decl_name: "spill_hetzner_helsinki_region"),
  }
}

