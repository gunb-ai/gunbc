    demand: s_demand(),
    work: s_work(),
    customer_profile: s_customer_profile(),
    data_handling_profile: s_data_handling_profile(),
    agreement: s_agreement(),
    prohibited_use_disposition: s_cleared(ev: decl_ref(module_path: "test.claim.fabric.spill_candidate_field_witness", decl_name: "spill_witness_prohibited_use_cleared")),
    sanctions_disposition: s_cleared(ev: decl_ref(module_path: "test.claim.fabric.spill_candidate_field_witness", decl_name: "spill_witness_sanctions_cleared")),
    export_disposition: s_cleared(ev: decl_ref(module_path: "test.claim.fabric.spill_candidate_field_witness", decl_name: "spill_witness_export_cleared")),
