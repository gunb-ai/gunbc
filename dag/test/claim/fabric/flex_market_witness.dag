module test.claim.fabric.flex_market_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.measure {
  money_amount_micro, money_amount_micro_count, money_per_hour_micros, second, MoneyPerHour,
  ByteSize, gibibyte, gibibyte_to_byte_size, byte_size, byte_size_count,
}
import extdeps.currency.currency { Usd }
import std.decision { SelectedWithin }
import product.fabric.flex_market {
  FlexBidLevel, FlexBidLevelThreeFifths, FlexBidLevelFourFifths, FlexBidLevelMarket,
  FlexMarketQuoted, FlexMarketUnobserved,
  FlexBidPriced, FlexBidMarketUnobserved, FlexBidQuoteCurrencyMismatch,
  FlexMedianFound, FlexMedianEmpty, FlexMedianCurrencyMismatch,
  FlexVramClass96, FlexVramClass48, FlexVramClassOther,
  FlexLevelChosen, FlexLevelExplore, FlexLevelNeedsEvidence, FlexLevelSelectionRefused,
  FlexWireOwnerPresent, FlexWireOwnerAbsent,
  FlexOwnerLabel, FlexOurs, FlexForeign, FlexUnlabelled,
  FlexOwnedCard, FlexDestroy, FlexKeep, FlexCleanupOutbid, FlexCleanupStaleLoading,
  FlexCleanupNotRunningDropped, FlexCleanupReleasedForValue,
  FlexReleaseNow, FlexReleaseHoldLast, FlexReleaseHoldUntilReplacement,
  flex_quoted_bid, flex_class_market_median, flex_choose_bid_level,
  flex_vram_class, flex_ownership, flex_ours_only,
  flex_owner_label_gunbc_flex, flex_card_dead, flex_cleanup_dead, flex_release_admit,
  flex_held_effective_rate, flex_dollars_per_vram, FlexVramHourlyQuoted, FlexVramHourlyZeroCapacity,
  flex_rank_entry, flex_select_owned_cards,
  FlexRentalSample,
  FlexCardUnitEstablished, FlexCardUnitUnconfirmed, flex_rented_card_fungible, flex_ninfer_qwen_probe,
}
import gunbc.harness.harness_reasoning_wire {
  Qwen3_8_27bOnNinfer, NemotronUltraFreeOnOpenRouter, Glm53FlashOnVllm,
  harness_unit_tool_call_parser,
}
import extdeps.cloud.vast_ai { VastAiCreateAskRequest, VastAiChangeBidRequest }
import std.decimal { ExactDecimal }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn usd_hour(n: Nat) -> MoneyPerHour {
  MoneyPerHour { amount: money_amount_micro(count: n), currency: Usd }
}

fn gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

test fn an_empty_class_has_no_market_median() -> Bool {
  match flex_class_market_median(floors: []) {
    FlexMedianEmpty => true
    FlexMedianFound { rate: _ } => false
    FlexMedianCurrencyMismatch { left: _, right: _ } => false
  }
}

test fn even_population_median_is_the_upper_middle_sample() -> Bool {
  match flex_class_market_median(floors: [
    usd_hour(n: 400000),
    usd_hour(n: 100000),
    usd_hour(n: 300000),
    usd_hour(n: 200000),
  ]) {
    FlexMedianEmpty => false
    FlexMedianCurrencyMismatch { left: _, right: _ } => false
    FlexMedianFound { rate: m } => money_per_hour_micros(q: m) == 300000
  }
}

test fn a_bid_is_the_level_of_the_median_never_below_the_floor() -> Bool {
  let quote = FlexMarketQuoted { median: usd_hour(n: 1000000), level: FlexBidLevelThreeFifths }
  match flex_quoted_bid(quote: quote, floor: usd_hour(n: 500000)) {
    FlexBidMarketUnobserved => false
    FlexBidQuoteCurrencyMismatch { left: _, right: _ } => false
    FlexBidPriced { rate: r } => money_per_hour_micros(q: r) == 600000
  }
}

test fn a_machine_floor_above_the_level_price_is_the_bid() -> Bool {
  let quote = FlexMarketQuoted { median: usd_hour(n: 1000000), level: FlexBidLevelThreeFifths }
  match flex_quoted_bid(quote: quote, floor: usd_hour(n: 800000)) {
    FlexBidMarketUnobserved => false
    FlexBidQuoteCurrencyMismatch { left: _, right: _ } => false
    FlexBidPriced { rate: r } => money_per_hour_micros(q: r) == 800000
  }
}

test fn missing_market_quote_does_not_fall_back_to_a_floor_buffer() -> Bool {
  match flex_quoted_bid(quote: FlexMarketUnobserved, floor: usd_hour(n: 1000000)) {
    FlexBidMarketUnobserved => true
    FlexBidPriced { rate: _ } => false
    FlexBidQuoteCurrencyMismatch { left: _, right: _ } => false
  }
}

test fn four_fifths_and_market_levels_are_exact_ratios() -> Bool {
  let mid = FlexMarketQuoted { median: usd_hour(n: 1000000), level: FlexBidLevelFourFifths }
  let mkt = FlexMarketQuoted { median: usd_hour(n: 1000000), level: FlexBidLevelMarket }
  match flex_quoted_bid(quote: mid, floor: usd_hour(n: 1)) {
    FlexBidPriced { rate: a } =>
      match flex_quoted_bid(quote: mkt, floor: usd_hour(n: 1)) {
        FlexBidPriced { rate: b } =>
          (money_per_hour_micros(q: a) == 800000) && (money_per_hour_micros(q: b) == 1000000)
        _ => false
      }
    _ => false
  }
}

fn ended_row(level: FlexBidLevel, serving_s: Nat, bid: Nat) -> FlexRentalSample {
  FlexRentalSample {
    class: FlexVramClass48,
    level: level,
    bid: usd_hour(n: bid),
    serving: second(count: serving_s),
    ended: true,
  }
}

test fn a_class_with_no_samples_tries_three_fifths_first() -> Bool {
  match flex_choose_bid_level(rows: [], class: FlexVramClass48, rentals_so_far: 0, quote_currency: Usd) {
    FlexLevelExplore { level: _, best: _ } => false
    FlexLevelNeedsEvidence => false
    FlexLevelSelectionRefused => false
    FlexLevelChosen { level: l, samples: n } =>
      match l {
        FlexBidLevelThreeFifths => n == 0
        FlexBidLevelFourFifths => false
        FlexBidLevelMarket => false
      }
  }
}

test fn after_min_samples_the_cheaper_productive_hour_wins() -> Bool {
  let cheap = [
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 3600, bid: 600000),
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 3600, bid: 600000),
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 3600, bid: 600000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 3600, bid: 800000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 3600, bid: 800000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 3600, bid: 800000),
    ended_row(level: FlexBidLevelMarket, serving_s: 3600, bid: 1000000),
    ended_row(level: FlexBidLevelMarket, serving_s: 3600, bid: 1000000),
    ended_row(level: FlexBidLevelMarket, serving_s: 3600, bid: 1000000),
  ]
  match flex_choose_bid_level(rows: cheap, class: FlexVramClass48, rentals_so_far: 1, quote_currency: Usd) {
    FlexLevelExplore { level: _, best: _ } => false
    FlexLevelNeedsEvidence => false
    FlexLevelSelectionRefused => false
    FlexLevelChosen { level: l, samples: n } =>
      match l {
        FlexBidLevelThreeFifths => n == 3
        FlexBidLevelFourFifths => false
        FlexBidLevelMarket => false
      }
  }
}

test fn every_fifth_rental_explores_another_level() -> Bool {
  let cheap = [
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 3600, bid: 600000),
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 3600, bid: 600000),
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 3600, bid: 600000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 3600, bid: 800000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 3600, bid: 800000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 3600, bid: 800000),
    ended_row(level: FlexBidLevelMarket, serving_s: 3600, bid: 1000000),
    ended_row(level: FlexBidLevelMarket, serving_s: 3600, bid: 1000000),
    ended_row(level: FlexBidLevelMarket, serving_s: 3600, bid: 1000000),
  ]
  match flex_choose_bid_level(rows: cheap, class: FlexVramClass48, rentals_so_far: 5, quote_currency: Usd) {
    FlexLevelChosen { level: _, samples: _ } => false
    FlexLevelNeedsEvidence => false
    FlexLevelSelectionRefused => false
    FlexLevelExplore { level: l, best: b } =>
      match b { FlexBidLevelThreeFifths => match l { FlexBidLevelThreeFifths => false FlexBidLevelFourFifths => true FlexBidLevelMarket => true } FlexBidLevelFourFifths => false FlexBidLevelMarket => false }
  }
}

test fn ninety_six_gb_is_the_eighty_and_up_class() -> Bool {
  match flex_vram_class(vram: gib(n: 80)) {
    FlexVramClass96 => match flex_vram_class(vram: gib(n: 48)) {
      FlexVramClass48 => true
      FlexVramClass96 => false
      FlexVramClassOther { vram: _ } => false
    }
    FlexVramClass48 => false
    FlexVramClassOther { vram: _ } => false
  }
}

test fn unlabelled_and_foreign_cards_are_not_ours() -> Bool {
  let ours = flex_ownership(wire: FlexWireOwnerPresent { label: flex_owner_label_gunbc_flex }, ours: flex_owner_label_gunbc_flex)
  let bidder = flex_ownership(wire: FlexWireOwnerPresent { label: "ctrl-bidder" as FlexOwnerLabel }, ours: flex_owner_label_gunbc_flex)
  let pool = flex_ownership(wire: FlexWireOwnerPresent { label: "ctrl-pool" as FlexOwnerLabel }, ours: flex_owner_label_gunbc_flex)
  let unlabeled = flex_ownership(wire: FlexWireOwnerAbsent, ours: flex_owner_label_gunbc_flex)
  flex_ours_only(owner: ours)
    && !flex_ours_only(owner: bidder)
    && !flex_ours_only(owner: pool)
    && !flex_ours_only(owner: unlabeled)
    && match unlabeled { FlexUnlabelled => true FlexOurs { owner: _ } => false FlexForeign { label: _ } => false }
}

fn owned(
  id: NonEmptyStr,
  vram: ByteSize,
  rate: Nat,
  held: Bool,
  running: Bool,
  loading: Bool,
  outbid: Bool,
  age: Nat,
) -> FlexOwnedCard {
  FlexOwnedCard {
    owner: flex_owner_label_gunbc_flex,
    id: id,
    vram: vram,
    rate: usd_hour(n: rate),
    held: held,
    running: running,
    loading: loading,
    outbid: outbid,
    loading_age: second(count: age),
  }
}

test fn outbid_and_ten_minute_loading_are_dead() -> Bool {
  flex_card_dead(card: owned(id: "a", vram: gib(n: 48), rate: 600000, held: true, running: false, loading: false, outbid: true, age: 0))
    && flex_card_dead(card: owned(id: "b", vram: gib(n: 48), rate: 600000, held: true, running: false, loading: true, outbid: false, age: 600))
    && !flex_card_dead(card: owned(id: "c", vram: gib(n: 48), rate: 600000, held: true, running: false, loading: true, outbid: false, age: 599))
    && !flex_card_dead(card: owned(id: "d", vram: gib(n: 48), rate: 600000, held: true, running: true, loading: false, outbid: false, age: 0))
}

test fn cleanup_destroys_only_dead_owned_cards() -> Bool {
  let foreign_dead = FlexOwnedCard {
    owner: "ctrl-bidder" as FlexOwnerLabel,
    id: "ctrl",
    vram: gib(n: 48),
    rate: usd_hour(n: 600000),
    held: true,
    running: false,
    loading: false,
    outbid: true,
    loading_age: second(count: 0),
  }
  let actions = flex_cleanup_dead(
    cards: [
      owned(id: "live", vram: gib(n: 48), rate: 600000, held: true, running: true, loading: false, outbid: false, age: 0),
      owned(id: "dead", vram: gib(n: 48), rate: 600000, held: true, running: false, loading: false, outbid: true, age: 0),
      foreign_dead,
    ],
    ours: flex_owner_label_gunbc_flex,
  )
  (actions |> length) == 1
    && match actions.first() {
      Absent => false
      Present { value: a } =>
        match a {
          FlexKeep { id: _ } => false
          FlexDestroy { id: i, why: w } =>
            (i == "dead") && match w {
              FlexCleanupOutbid => true
              FlexCleanupStaleLoading => false
              FlexCleanupNotRunningDropped => false
              FlexCleanupReleasedForValue => false
            }
        }
    }
}

test fn release_never_drops_the_last_running_card() -> Bool {
  match flex_release_admit(running_count: 1, over_cap: true, no_room: true, replacement_serving: true) {
    FlexReleaseHoldLast => true
    FlexReleaseNow { because_over_cap: _, because_no_room: _, replacement_serving: _ } => false
    FlexReleaseHoldUntilReplacement => false
  }
}

test fn a_value_release_waits_for_a_serving_replacement_unless_the_cap_requires_it() -> Bool {
  match flex_release_admit(running_count: 2, over_cap: false, no_room: false, replacement_serving: false) {
    FlexReleaseHoldUntilReplacement =>
      match flex_release_admit(running_count: 2, over_cap: true, no_room: false, replacement_serving: false) {
        FlexReleaseNow { because_over_cap: o, because_no_room: n, replacement_serving: r } => o && !n && !r
        FlexReleaseHoldLast => false
        FlexReleaseHoldUntilReplacement => false
      }
    FlexReleaseHoldLast => false
    FlexReleaseNow { because_over_cap: _, because_no_room: _, replacement_serving: _ } => false
  }
}

test fn a_held_card_is_ranked_at_the_switch_premium() -> Bool {
  let raw = usd_hour(n: 1250000)
  let effective = flex_held_effective_rate(rate: raw, held: true)
  match flex_dollars_per_vram(rate: effective, vram: gib(n: 48)) {
    FlexVramHourlyZeroCapacity => false
    FlexVramHourlyQuoted { rate: ev } =>
      match flex_dollars_per_vram(rate: raw, vram: gib(n: 48)) {
        FlexVramHourlyZeroCapacity => false
        FlexVramHourlyQuoted { rate: rv } =>
          (money_amount_micro_count(m: ev.amount) < money_amount_micro_count(m: rv.amount))
            && (money_per_hour_micros(q: effective) == 1000000)
      }
  }
}

test fn zero_vram_does_not_pretend_to_be_a_rate_per_byte() -> Bool {
  match flex_dollars_per_vram(rate: usd_hour(n: 1000000), vram: byte_size(count: 0)) {
    FlexVramHourlyZeroCapacity => true
    FlexVramHourlyQuoted { rate: _ } => false
  }
}

test fn unscored_ended_rentals_need_evidence_instead_of_a_market_default() -> Bool {
  let short = [
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 300, bid: 600000),
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 300, bid: 600000),
    ended_row(level: FlexBidLevelThreeFifths, serving_s: 300, bid: 600000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 300, bid: 800000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 300, bid: 800000),
    ended_row(level: FlexBidLevelFourFifths, serving_s: 300, bid: 800000),
    ended_row(level: FlexBidLevelMarket, serving_s: 300, bid: 1000000),
    ended_row(level: FlexBidLevelMarket, serving_s: 300, bid: 1000000),
    ended_row(level: FlexBidLevelMarket, serving_s: 300, bid: 1000000),
  ]
  match flex_choose_bid_level(rows: short, class: FlexVramClass48, rentals_so_far: 1, quote_currency: Usd) {
    FlexLevelNeedsEvidence => true
    FlexLevelChosen { level: _, samples: _ } => false
    FlexLevelExplore { level: _, best: _ } => false
    FlexLevelSelectionRefused => false
  }
}

data id_cheap: DeclarationRef = decl_ref(module_path: "test.claim.fabric.flex_market_witness", decl_name: "id_cheap")
data id_held: DeclarationRef = decl_ref(module_path: "test.claim.fabric.flex_market_witness", decl_name: "id_held")

test fn ranking_selects_the_held_card_when_the_premium_covers_a_small_price_gap() -> Bool {
  let offer = owned(id: "offer", vram: gib(n: 48), rate: 1100000, held: false, running: false, loading: false, outbid: false, age: 0)
  let held = owned(id: "held", vram: gib(n: 48), rate: 1250000, held: true, running: true, loading: false, outbid: false, age: 0)
  match flex_select_owned_cards(
    entries: [
      flex_rank_entry(id: id_cheap, label: "offer" as NonEmptyStr, card: offer),
      flex_rank_entry(id: id_held, label: "held" as NonEmptyStr, card: held),
    ],
    currency: Usd,
  ) {
    SelectedWithin { candidate: c, receipt: _ } => declaration_ref_eq(a: c.identity, b: id_held)
    _ => false
  }
}

test fn a_ninfer_qwen_catalog_unit_is_placeable_and_unconfirmed_is_not() -> Bool {
  flex_rented_card_fungible(probe: flex_ninfer_qwen_probe())
    && flex_rented_card_fungible(probe: FlexCardUnitEstablished { unit: Qwen3_8_27bOnNinfer })
    && !flex_rented_card_fungible(probe: FlexCardUnitUnconfirmed)
    && !flex_rented_card_fungible(probe: FlexCardUnitEstablished { unit: NemotronUltraFreeOnOpenRouter })
}

test fn vllm_parser_names_stay_on_the_catalog_unit() -> Bool {
  match harness_unit_tool_call_parser(unit: Glm53FlashOnVllm) {
    Absent => false
    Present { value: _ } =>
      match harness_unit_tool_call_parser(unit: Qwen3_8_27bOnNinfer) {
        Absent => true
        Present { value: _ } => false
      }
  }
}

test fn a_create_ask_shape_requires_a_label() -> Bool {
  let req = VastAiCreateAskRequest {
    price: ExactDecimal { units: 6, fraction_digits: 1 },
    disk: 32,
    template_hash_id: "abc" as NonEmptyStr,
    label: flex_owner_label_gunbc_flex as NonEmptyStr,
  }
  let bid = VastAiChangeBidRequest { price: ExactDecimal { units: 6, fraction_digits: 1 } }
  (req.label as String) == (flex_owner_label_gunbc_flex as String)
    && (req.disk == 32)
    && (bid.price.units == 6)
}
