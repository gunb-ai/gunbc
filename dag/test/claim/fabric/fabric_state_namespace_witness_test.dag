module test.claim.fabric_state_namespace_witness_test

import std.types { NonEmptyStr }
import extdeps.shell
import std.fabric_storage { FabricObject, FabricObjectStored, FabricObjectMissing, FabricHeadAdvanceRefused, ExpectHeadAbsent }
import gunbc.fabric_storage_file_store { fabric_storage_file_root, fabric_storage_file_root_ensure, FabricStorageRootReady, fabric_storage_file_put, fabric_storage_file_advance }
import gunbc.fabric_storage_address { fabric_storage_state_file_root }
import gunbc.fabric_storage_state_serve { fabric_storage_state_serve_over }

// A known private object reference still cannot be aliased through the legacy public namespace.
test fn witness_public_head_cannot_alias_private_state_object() -> Bool {
  let directory = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_state_isolation.XXXXXX").path
  if directory == "" { false } else {
    let public_root = fabric_storage_file_root(root: directory as NonEmptyStr)
    let private_root = fabric_storage_state_file_root(store_root: directory as NonEmptyStr)
    match fabric_storage_file_root_ensure(root: public_root) {
      FabricStorageRootReady => match fabric_storage_file_root_ensure(root: private_root) {
        FabricStorageRootReady => match fabric_storage_file_put(root: private_root, object: FabricObject { links: [], body: "owner-private-record" }) {
          FabricObjectStored { object: private_ref } => match fabric_storage_file_advance(root: public_root, name: "public-alias", expected: ExpectHeadAbsent, target: private_ref) {
            FabricHeadAdvanceRefused { fault: FabricObjectMissing { object: _ } } => true
            _ => false
          }
          _ => false
        }
        _ => false
      }
      _ => false
    }
  }
}

test fn witness_state_raw_routes_require_service_authentication() -> Bool {
  let root = fabric_storage_file_root(root: "/fixture-never-read")
  all(["head", "closure", "put", "advance"], operation =>
    fabric_storage_state_serve_over(root: root, method: "POST", path: concat("/fabric-storage/state/", operation), body: "untrusted").status == 403)
}
