module test.claim.fabric_sanitation_witness_test

import std.types { Bool, String, List, NonEmptyStr }
import product.fabric.sanitation {
  CellId, SandboxId, SanitationFact, SanitationObservation, SanitationReadback,
  NoSurvivingProcesses, CgroupEmpty, MountsRemoved,
  NetworkNamespaceRemoved, SlotNetworkQuiescent, WritableLayersDeleted, SecretsRemoved,
  SandboxNetworkScope, AttemptScopedNetwork, SlotScopedNetwork,
  FactConfirmed, FactRefuted, FactUnobservable,
  required_sanitation_facts, sanitation_fact_label,
  unproven_facts, unproven_fact_label,
  cell_readiness_after, cell_is_ready, cell_readiness_line,
  readiness_without_readback,
  CellReady, CellQuarantined,
  FactNotObserved, FactObservedFailing,
}

fn a_cell() -> CellId { "srv3-06" as CellId }
fn a_sandbox() -> SandboxId { "sandbox-attempt-1-gen-4" as SandboxId }

fn readback_of(obs: List<SanitationObservation>) -> SanitationReadback {
  SanitationReadback { cell: a_cell(), sandbox: a_sandbox(), network_scope: AttemptScopedNetwork, observations: obs }
}

fn all_confirmed() -> List<SanitationObservation> {
  map(required_sanitation_facts(scope: AttemptScopedNetwork), f => FactConfirmed { fact: f })
}

// A FULLY PROVEN TEARDOWN RETURNS THE CELL. The positive control: without it every assertion below
// is satisfied by a fold that quarantines unconditionally.
test fn a_fully_proven_teardown_returns_the_cell() -> Bool {
  let readiness = cell_readiness_after(readback: readback_of(obs: all_confirmed()))
  cell_is_ready(readiness: readiness)
    && (unproven_facts(readback: readback_of(obs: all_confirmed())) |> count) == 0
}

// AN OMITTED OBSERVATION DOES NOT PASS, WHICH IS THE LOAD-BEARING WITNESS IN THIS FILE.
//
// A readback confirming five facts and not mentioning the sixth is the empty-observation narrow in
// its most dangerous form: "nothing was reported wrong" concluded from a report that never covered
// the subject. A fold walking the OBSERVED list instead of the REQUIRED list passes this readback
// and returns a cell with the previous tenant's writable layer still on it — and passes every other
// witness here.
test fn five_confirmations_and_a_silence_do_not_return_the_cell() -> Bool {
  let five = filter(all_confirmed(), o => match o {
    FactConfirmed { fact: f } => f != WritableLayersDeleted
    FactRefuted { fact: _, detail: _ } => true
    FactUnobservable { fact: _, reason: _ } => true
  })
  let readiness = cell_readiness_after(readback: readback_of(obs: five))
  let unproven = unproven_facts(readback: readback_of(obs: five))
  !cell_is_ready(readiness: readiness)
    && (unproven |> count) == 1
    && any(unproven, u => match u {
         FactNotObserved { fact: f } => f == WritableLayersDeleted
         FactObservedFailing { observation: _ } => false
       })
}

// UNOBSERVABLE IS NOT CONFIRMED, AND IT IS ALSO NOT REFUTED.
//
// The discriminating pair: a fact the readback could not reach must refuse reuse exactly as a
// refuted one does, while remaining distinguishable from it — the operator remedies differ
// (teardown failed, versus we could not tell). Collapsing Unobservable into Confirmed lets residue
// through; collapsing it into Refuted is safe but reports a failure that did not happen.
test fn an_unobservable_fact_refuses_reuse_without_claiming_teardown_failed() -> Bool {
  let with_unobservable = concat(
    filter(all_confirmed(), o => match o {
      FactConfirmed { fact: f } => f != CgroupEmpty
      FactRefuted { fact: _, detail: _ } => true
      FactUnobservable { fact: _, reason: _ } => true
    }),
    [FactUnobservable { fact: CgroupEmpty, reason: "host agent unreachable" as NonEmptyStr }],
  )
  let readiness = cell_readiness_after(readback: readback_of(obs: with_unobservable))
  let line = cell_readiness_line(readiness: readiness)
  !cell_is_ready(readiness: readiness)
    && string_contains(s: line, pattern: "unobservable")
    && !string_contains(s: line, pattern: "refuted")
}

// A REFUTED FACT NAMES WHAT WAS FOUND, BECAUSE "DIRTY" IS UNACTIONABLE.
test fn a_refused_teardown_names_the_fact_and_its_detail() -> Bool {
  let with_refuted = concat(
    filter(all_confirmed(), o => match o {
      FactConfirmed { fact: f } => f != NoSurvivingProcesses
      FactRefuted { fact: _, detail: _ } => true
      FactUnobservable { fact: _, reason: _ } => true
    }),
    [FactRefuted {
      fact: NoSurvivingProcesses,
      detail: "pid 41207 still in cgroup" as NonEmptyStr,
    }],
  )
  let line = cell_readiness_line(readiness: cell_readiness_after(readback: readback_of(obs: with_refuted)))
  string_contains(s: line, pattern: "no-surviving-processes")
    && string_contains(s: line, pattern: "pid 41207")
    && string_contains(s: line, pattern: "quarantined")
}

// A LOST HOST AGENT QUARANTINES THE CELL RATHER THAN RETURNING IT.
//
// No readback at all is the tempting place to answer "nothing to clean". It is the same narrow one
// level out — no observation becoming no problem — and the case where the cell is MOST likely
// dirty, since the agent vanished mid-attempt. Every required fact comes back unobserved.
test fn a_lost_host_agent_quarantines_with_every_fact_unproven() -> Bool {
  let readiness = readiness_without_readback(cell: a_cell(), sandbox: a_sandbox(), network_scope: AttemptScopedNetwork)
  let unproven = unproven_facts(readback: readback_of(obs: []))
  !cell_is_ready(readiness: readiness)
    && (unproven |> count) == (required_sanitation_facts(scope: AttemptScopedNetwork) |> count)
    && (required_sanitation_facts(scope: AttemptScopedNetwork) |> count) == 6
}

// EVERY FACT HAS ITS OWN WIRE WORD.
// A label function collapsing two facts still renders a plausible quarantine line, and the collapse
// would only surface as an operator inspecting the wrong subsystem.
test fn the_six_facts_do_not_share_a_wire_word() -> Bool {
  let labels = map(required_sanitation_facts(scope: AttemptScopedNetwork), f => sanitation_fact_label(fact: f))
  (labels |> count) == 6
    && !any(labels, a => (filter(labels, b => b == a) |> count) > 1)
}

// A SLOT-SCOPED SANDBOX OWES QUIESCENCE, NOT REMOVAL, AND ONE FACT DOES NOT STAND FOR THE OTHER.
// A slot-scoped readback that confirms every attempt-scoped fact -- namespace removal included --
// still quarantines, naming slot-network-quiescent as not observed; and confirming quiescence in its
// place returns the cell. An attempt-scoped readback is untouched by the new fact.
test fn a_slot_scoped_network_owes_quiescence_and_removal_does_not_stand_for_it() -> Bool {
  let attempt_facts = map(required_sanitation_facts(scope: AttemptScopedNetwork), f => FactConfirmed { fact: f })
  let slot_facts = map(required_sanitation_facts(scope: SlotScopedNetwork), f => FactConfirmed { fact: f })
  let wrong = SanitationReadback { cell: a_cell(), sandbox: a_sandbox(), network_scope: SlotScopedNetwork, observations: attempt_facts }
  let right = SanitationReadback { cell: a_cell(), sandbox: a_sandbox(), network_scope: SlotScopedNetwork, observations: slot_facts }
  let missing = match unproven_facts(readback: wrong).first() {
    Present { value: FactNotObserved { fact: SlotNetworkQuiescent } } => (unproven_facts(readback: wrong) |> count) == 1
    _ => false
  }
  missing
    && cell_is_ready(readiness: cell_readiness_after(readback: right))
    && cell_is_ready(readiness: cell_readiness_after(readback: readback_of(obs: attempt_facts)))
}
