module test.claim.root_d_checkpoint_scalar_declared_arity_witness

import std.types { is_container_type }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data root_d_checkpoint_scalar_declared_arity_witness_note: String = "Root D half 2: a leaf whose arity is declared by the single authority (std.types container_type_arity) may never be classified a checkpoint scalar, because the E0109 strip in v1.compiler.05_emit_rust rust_render_checkpoint_scalar_bare removes EVERY type argument from whatever it matches. Before the guard, extdeps.languages.rust.types carried a { dag_name: Witness, target_type: Witness } spelling row, so v2.std.witness.Witness<C> was read as arity 0 and emitted as Rc<Witness> — rustc E0107 'missing generics for enum Witness'. The positive fixture RED-fails on that emission. The null control keeps the wall it must not break: a genuine arity-0 checkpoint scalar reached with phantom arguments still renders bare (i64, never i64<T>), which is the class rust_checkpoint_scalar_phantom_params_note exists for. Live measurement and localisation: docs/probes/root_d_generic_arity_2026-08-16.md.

The positive fixture declares its own Witness<C> rather than importing v2.std.witness, and the reason is not cosmetic: the table this witness constrains is keyed on the BARE SPELLING, so the spelling is the load-bearing input and a synthetic name would exercise nothing. This is not a second authority for the concept — the fixture declares a two-arm coproduct with no consumer, and the real declaration keeps its single home in v2.std.witness. It is also why the fixture cannot simply import that module: compile_dag_rust_emit_check compiles a virtual single-module source through the witness-root index, and importing v2.std.witness (or v2.std.node beneath it) refuses with hard diagnostics in that mode, which would make this claim unrunnable rather than red. Dissolve-on: when lookup_checkpoint is re-keyed from a bare String to a resolved declaration identity (eager-deer-389's lane), the spelling stops being the key and this fixture should import the authority instead."

fn w_declared_arity_leaf_is_not_a_checkpoint_scalar() -> Bool {
  compile_dag_rust_emit_check(
    "module root_d.witness_arity\n\ntype Witness<C>\n  = Holds { value: C }\n  | Violates { reason: String }\n\nfn root_d_probe<T>(w: Witness<T>) -> Witness<T> {\n  w\n}\n",
    "src/root_d_witness_arity.rs",
    ["Witness<T>"],
    ["-> Rc<Witness> {", "-> Witness {"]
  )
}

fn w_arity_zero_checkpoint_scalar_still_strips_phantom_arguments() -> Bool {
  compile_dag_rust_emit_check(
    "module root_d.checkpoint_scalar\nimport std.integer { Int8 }\n\nfn root_d_scalar_probe(value: Int8) -> Int8 {\n  value\n}\n",
    "src/std_integer.rs",
    ["Compose<i64,"],
    ["i64<"]
  )
}

fn w_arity_authority_answers_for_both_fixtures() -> Bool {
  is_container_type(name: "Witness")
    && !is_container_type(name: "Int")
}

data root_d_decomposition_note: String = "DECOMPOSED 2026-08-18, and the reason is polarity rather than cost. These three claims were one conjoined test fn enrolled expected-red. Only the FIRST is red: the positive fixture carries the live E0107 defect. The other two are controls that must be GREEN — the null control keeps the arity-0 wall that must not break, and the authority row asserts std.types answers for both fixtures. Fused under one Bool and enrolled expected-red, a break in either control was UNOBSERVABLE: the row was already red for the defect, so a regression in a green arm changed nothing anyone could see, and the expected-red enrollment was masking two live guarantees rather than covering them. Splitting is therefore a coverage repair (DESIGN 4b: an inflated class never ranks for climbing), not a cost move — total work is unchanged, since the same two compile_dag_rust_emit_check invocations still run. The eponymous name stays on the red arm because the positive fixture IS this witness's subject, which also leaves the floor_expected_red roster identity untouched."

test fn root_d_checkpoint_scalar_declared_arity_witness_holds() -> Bool {
  w_declared_arity_leaf_is_not_a_checkpoint_scalar()
}

test fn root_d_arity_zero_checkpoint_scalar_still_strips_phantom_arguments() -> Bool {
  w_arity_zero_checkpoint_scalar_still_strips_phantom_arguments()
}

test fn root_d_arity_authority_answers_for_both_fixtures() -> Bool {
  w_arity_authority_answers_for_both_fixtures()
}
