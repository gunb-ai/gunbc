module test.claim.dispatch_presentation_witness

import std.types { Int, String, Bool, List }
import gunbc.design.material { CssDecl, decl, css_block }
import gunbc.design.theme { role_var, FigureRole, BoundaryRole, TextDimRole, TextRole }
import gunbc.design.component { ComponentState, component_state_for_label }
import gunbc.roadmap_component {
  dispatch_reserved_ch, dispatch_reserved_ch_for, longest_label_len,
  dispatch_class_requested, dispatch_class_ok, dispatch_class_refused,
  dispatch_button_component, dispatch_client_js_source,
  dispatch_caption_set,
  DispatchWireReasonField,
  dispatch_wire_reason_fields,
}
import gunbc.roadmap_belt_actuate {
  belt_dispatch_all_status_labels,
  belt_dispatch_label_band_key,
  belt_dispatch_disabled_status_label,
  belt_dispatch_provider_label,
  belt_dispatch_result_exemplars,
  belt_dispatch_result_json_value,
  belt_dispatch_status_label,
}
import extdeps.languages.json.emit { serialize_json }
import gunbc.roadmap_style { roadmap_css }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data dispatch_presentation_witness_note: String = "P3 keystone, re-grounded by remodel W1d (2026-07-24) and lifecycle correction (2026-07-27): the dispatch button's presentation is a projection of modeled rows, not hand pixels/colors. Reserved width derives from every caption it can wear, including dispatch receipts and observed-session presence; each state class paints its BAND's exact fill/ink vars; located fields surface in the title; and client plus stylesheet share one class vocabulary."

fn role_var_for_label(wire_label: String) -> String {
  fold(component_state_for_label(c: dispatch_button_component(), wire_label: wire_label),
    init: "", f: (acc, s) => role_var(r: s.role))
}

test fn witness_reserved_width_is_caption_projection() -> Bool {
  let captions = dispatch_caption_set()
  let real = dispatch_reserved_ch()
  real == longest_label_len(labels: captions) + 2
    && real >= longest_label_len(labels: captions)
    && dispatch_reserved_ch_for(labels: ["short"]) == 7
    && dispatch_reserved_ch_for(labels: ["already_done_signed_off"]) > dispatch_reserved_ch_for(labels: ["short"])
    && string_contains(s: roadmap_css(), pattern: join([to_string(real), "ch"], ""))
}

test fn witness_chip_material_is_band_paint() -> Bool {
  let css = roadmap_css()
  let ok_block = css_block(
    selector: join([".dispatch-btn.", dispatch_class_ok], ""),
    decls: [
      decl(prop: Color, value: "var(--band-ok-ink)"),
      decl(prop: Background, value: "var(--band-ok)"),
      decl(prop: BorderColor, value: "var(--band-ok)"),
    ])
  let refused_block = css_block(
    selector: join([".dispatch-btn.", dispatch_class_refused], ""),
    decls: [
      decl(prop: Color, value: "var(--band-fail-ink)"),
      decl(prop: Background, value: "var(--band-fail)"),
      decl(prop: BorderColor, value: "var(--band-fail)"),
    ])
  string_contains(s: css, pattern: ok_block)
    && string_contains(s: css, pattern: refused_block)
    && belt_dispatch_label_band_key(wire_label: "spawned") == "ok"
    && belt_dispatch_label_band_key(wire_label: "spawn_failed") == "loud"
    && role_var_for_label(wire_label: "spawned") == role_var(r: FigureRole)
}

test fn witness_chip_wrong_paint_not_shipped() -> Bool {
  let wrong = css_block(
    selector: join([".dispatch-btn.", dispatch_class_ok], ""),
    decls: [
      decl(prop: Color, value: "var(--band-fail-ink)"),
      decl(prop: Background, value: "var(--band-fail)"),
      decl(prop: BorderColor, value: "var(--band-fail)"),
    ])
  !string_contains(s: roadmap_css(), pattern: wrong)
}

test fn witness_located_fields_surface_to_title() -> Bool {
  let js = dispatch_client_js_source()
  string_contains(s: js, pattern: "b.title =")
    && string_contains(s: js, pattern: "j.step")
    && string_contains(s: js, pattern: "j.detail")
}

test fn witness_dispatch_receipt_is_provider_agnostic() -> Bool {
  let js = dispatch_client_js_source()
  let captions = dispatch_caption_set()
  any(captions, c => c == "dispatch · accepted")
    && any(captions, c => c == "dispatch · disabled")
    && !any(
      captions,
      c => string_contains(s: c, pattern: belt_dispatch_provider_label()),
    )
    && !string_contains(s: js, pattern: "j.provider")
    && string_contains(s: js, pattern: "dispatch · accepted")
    && string_contains(s: js, pattern: belt_dispatch_disabled_status_label())
}

test fn witness_js_and_css_share_class_authority() -> Bool {
  let js = dispatch_client_js_source()
  let css = roadmap_css()
  string_contains(s: js, pattern: dispatch_class_ok)
    && string_contains(s: js, pattern: dispatch_class_refused)
    && string_contains(s: js, pattern: dispatch_class_requested)
    && string_contains(s: css, pattern: join([".dispatch-btn.", dispatch_class_ok], ""))
    && string_contains(s: css, pattern: join([".dispatch-btn.", dispatch_class_refused], ""))
    && string_contains(s: css, pattern: join([".dispatch-btn.", dispatch_class_requested], ""))
}

data dispatch_wire_reason_join_note: String = "COMPLETENESS AS AN IDENTITY JOIN, not a count. The defect this closes was a client that read two wire fields while the emitter sent seven, so five loud variants delivered a located cause the page reported as absent. Asserting 'the client reads five fields' would have passed just as happily against the wrong five, and asserting a count would pass against any five.\\n\\nSo the join runs over belt_dispatch_result_exemplars — the roster the wire contract already pins, one exemplar per BeltDispatchResult variant — selects the loud band, serializes each payload through the real emitter, and requires that every one of them carries either step (the DispatchSpawnFailed shape the client already handled) or a key some dispatch_wire_reason_fields row actually reads. A new loud variant emitting a field no row names goes red HERE, at the variant that introduced it, rather than on the operator's screen as a claim that the wire said nothing."

fn dispatch_reason_field_keys() -> List<String> {
  fold(dispatch_wire_reason_fields(), init: [], f: (acc, row) =>
    if row.also_key == "" {
      concat(acc, [row.key])
    } else {
      concat(acc, [row.key, row.also_key])
    })
}

fn json_carries_readable_reason(payload: String) -> Bool {
  string_contains(s: payload, pattern: "\"step\"")
    || fold(dispatch_reason_field_keys(), init: false, f: (acc, k) =>
         acc || string_contains(s: payload, pattern: join(["\"", k, "\""], "")))
}

fn loud_dispatch_exemplars() -> List<String> {
  fold(belt_dispatch_result_exemplars(), init: [], f: (acc, r) =>
    if belt_dispatch_label_band_key(wire_label: belt_dispatch_status_label(r: r)) == "loud" {
      concat(acc, [serialize_json(v: belt_dispatch_result_json_value(r: r))])
    } else {
      acc
    })
}

test fn witness_every_loud_dispatch_payload_carries_a_readable_reason() -> Bool {
  let louds = loud_dispatch_exemplars()
  count(louds) >= 6
    && all(louds, p => json_carries_readable_reason(payload: p))
}

data dispatch_reason_client_reads_rows_note: String = "The emitted program is the consumer that matters, so the rows are asserted against the BYTES the browser receives rather than against the row list itself — a fold that produced no statements would satisfy a check on its own input. The negative control pins the exact defective derivation: `j.step ? j.step + ': ' + d : j.reason || ''` routed every step-less payload into the reason branch, and its absence is what makes the recovery reachable."

test fn witness_dispatch_client_reads_every_declared_reason_field() -> Bool {
  let js = dispatch_client_js_source()
  all(dispatch_reason_field_keys(), k => string_contains(s: js, pattern: join(["j.", k], "")))
    && !string_contains(s: js, pattern: "j.step + ': ' + d : j.reason")
    && string_contains(s: js, pattern: "desired ")
    && string_contains(s: js, pattern: " · local ")
}
