module test.claim.effect_grant_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// P-A discriminating witnesses for std.effect_grant. The core claim is fail-closed admissibility (DESIGN 5): an effect whose target is not under any grant root for its verb is REFUSED, never widened. Every positive arm is paired with a negative arm that goes RED if the refusal is dropped (empty envelope admits, wrong verb admits, wrong tree admits, sibling path admits, a child envelope widens past its parent).
fn frame_named(name: String) -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: name, kind: SharedStateFrame }
}

data test_frame: std.materialization_ladder.Frame = frame_named(name: "eval")

data workspace_root: std.effect_grant.NamespacePosition = std.effect_grant.NamespacePosition {
  tree: FilesystemPathTree,
  path: ["workspace"]
}

data workspace_file: std.effect_grant.NamespacePosition = std.effect_grant.NamespacePosition {
  tree: FilesystemPathTree,
  path: ["workspace", "src", "foo.rs"]
}

data outside_workspace: std.effect_grant.NamespacePosition = std.effect_grant.NamespacePosition {
  tree: FilesystemPathTree,
  path: ["etc", "passwd"]
}

data bmc_uri: std.effect_grant.NamespacePosition = std.effect_grant.NamespacePosition {
  tree: UriTree,
  path: ["https://bmc.local", "power"]
}

data workspace_write_grant: std.effect_grant.Grant = std.effect_grant.Grant {
  verb: Write,
  root: workspace_root,
  binding: RealTransport,
  lifecycle: LifecycleByConvention
}

data write_only_env: std.effect_grant.Envelope = std.effect_grant.Envelope {
  frame: test_frame,
  grants: [workspace_write_grant]
}

data usr_bin_root: std.effect_grant.NamespacePosition = filesystem_position(path: ["usr", "bin"])

data apt_get_target: std.effect_grant.NamespacePosition = filesystem_position(path: ["usr", "bin", "apt-get"])

data other_bin_target: std.effect_grant.NamespacePosition = filesystem_position(path: ["usr", "sbin", "other"])

data execute_only_grant: std.effect_grant.Grant = std.effect_grant.Grant {
  verb: Execute,
  root: usr_bin_root,
  binding: RealTransport,
  lifecycle: LifecycleByConstruction
}

data execute_only_env: std.effect_grant.Envelope = std.effect_grant.Envelope {
  frame: test_frame,
  grants: [execute_only_grant]
}

data empty_env: std.effect_grant.Envelope = std.effect_grant.Envelope {
  frame: test_frame,
  grants: []
}

fn is_admitted(a: std.access.AccessDecision) -> Bool {
  match a {
    Permit => true
    Deny { refusal: refusal } => false
  }
}

fn is_refused(a: std.access.AccessDecision) -> Bool {
  match a {
    Permit => false
    Deny { refusal: refusal } => true
  }
}

test fn effect_grant_verb_coarsening_witnesses() -> Bool {
  verb_eq(a: verb_of_effect_shape(shape: ReadEffect), b: Read)
    && verb_eq(a: verb_of_effect_shape(shape: std.effects.UpsertEffect { key_source: PathParam { param: "id" } }), b: Write)
    && verb_eq(a: verb_of_effect_shape(shape: std.effects.DeleteEffect { key_source: PathParam { param: "id" } }), b: Write)
    && verb_eq(a: verb_of_effect_shape(shape: std.effects.CreateEffect { cause: PostAlways }), b: Write)
    && verb_eq(a: verb_of_effect_shape(shape: AppendEffect), b: Write)
    && verb_eq(a: verb_of_effect_shape(shape: ExecuteEffect), b: Execute)
    && !verb_eq(a: verb_of_effect_shape(shape: ReadEffect), b: Write)
    && !verb_eq(a: verb_of_effect_shape(shape: ExecuteEffect), b: Write)
}

test fn effect_grant_position_under_witnesses() -> Bool {
  position_under(target: workspace_file, root: workspace_root)
    && position_under(target: workspace_root, root: workspace_root)
    && !position_under(target: outside_workspace, root: workspace_root)
    && !position_under(
         target: std.effect_grant.NamespacePosition { tree: UriTree, path: ["workspace", "src", "foo.rs"] },
         root: workspace_root
       )
}

test fn effect_grant_admission_witnesses() -> Bool {
  is_admitted(a: admit_effect(env: write_only_env, verb: Write, target: workspace_file))
    && is_refused(a: admit_effect(env: write_only_env, verb: Write, target: outside_workspace))
    && is_refused(a: admit_effect(env: write_only_env, verb: Read, target: workspace_file))
    && is_refused(a: admit_effect(env: write_only_env, verb: Write, target: bmc_uri))
    && is_refused(a: admit_effect(env: empty_env, verb: Write, target: workspace_file))
}

test fn effect_grant_execute_admission_witnesses() -> Bool {
  is_admitted(a: admit_effect(env: execute_only_env, verb: Execute, target: apt_get_target))
    && is_refused(a: admit_effect(env: execute_only_env, verb: Execute, target: other_bin_target))
    && is_refused(a: admit_effect(env: execute_only_env, verb: Write, target: apt_get_target))
    && is_refused(a: admit_effect(env: execute_only_env, verb: Read, target: apt_get_target))
    && is_refused(a: admit_effect(env: write_only_env, verb: Execute, target: apt_get_target))
    && is_refused(a: admit_effect(env: empty_env, verb: Execute, target: apt_get_target))
}

test fn effect_grant_execute_refusal_is_located_witnesses() -> Bool {
  match admit_effect(env: execute_only_env, verb: Execute, target: other_bin_target) {
    Deny { refusal: refusal } =>
      refusal.location.profile == "EffectRequest"
        && refusal.location.subject == test_frame.name
        && refusal.location.action == "execute"
        && refusal.location.object == "usr/sbin/other"
    Permit => false
  }
}

test fn effect_grant_refusal_is_located_witnesses() -> Bool {
  match admit_effect(env: write_only_env, verb: Write, target: outside_workspace) {
    Deny { refusal: refusal } =>
      refusal.location.profile == "EffectRequest"
        && refusal.location.subject == test_frame.name
        && refusal.location.action == "write"
        && refusal.location.object == "etc/passwd"
    Permit => false
  }
}

test fn effect_grant_bounding_witnesses() -> Bool {
  let parent = std.effect_grant.Envelope {
    frame: test_frame,
    grants: [workspace_write_grant]
  }
  let child_ok = std.effect_grant.Envelope {
    frame: frame_named(name: "child"),
    grants: [std.effect_grant.Grant {
      verb: Write,
      root: std.effect_grant.NamespacePosition { tree: FilesystemPathTree, path: ["workspace", "scratch"] },
      binding: RealTransport,
      lifecycle: LifecycleByConstruction
    }]
  }
  let child_widens_tree = std.effect_grant.Envelope {
    frame: frame_named(name: "child"),
    grants: [std.effect_grant.Grant {
      verb: Write,
      root: std.effect_grant.NamespacePosition { tree: FilesystemPathTree, path: ["etc"] },
      binding: RealTransport,
      lifecycle: LifecycleByConvention
    }]
  }
  let child_widens_verb = std.effect_grant.Envelope {
    frame: frame_named(name: "child"),
    grants: [std.effect_grant.Grant {
      verb: Read,
      root: std.effect_grant.NamespacePosition { tree: FilesystemPathTree, path: ["workspace", "scratch"] },
      binding: RealTransport,
      lifecycle: LifecycleByConvention
    }]
  }
  let child_widens_execute = std.effect_grant.Envelope {
    frame: frame_named(name: "child"),
    grants: [std.effect_grant.Grant {
      verb: Execute,
      root: std.effect_grant.NamespacePosition { tree: FilesystemPathTree, path: ["usr", "bin", "apt-get"] },
      binding: RealTransport,
      lifecycle: LifecycleByConstruction
    }]
  }
  envelope_bounded_by(child: child_ok, parent: parent)
    && !envelope_bounded_by(child: child_widens_tree, parent: parent)
    && !envelope_bounded_by(child: child_widens_verb, parent: parent)
    && !envelope_bounded_by(child: child_widens_execute, parent: parent)
}
