module test.claim.printer_workflow_binding_witness_test

import std.types { Bool, String }
import v2.std.optional { Present, Absent }
import extdeps.github.actions { Step, RunStep, UsesStep }
import extdeps.languages.yaml.types { YamlString }
import gunbc.fleet_converge_workflow {
  PrinterWorkflow, FleetSshKeyNotConsumed,
  fleet_converge_mode_options, fleet_converge_mode_fleet_ssh_key_demand,
  fleet_converge_printer_job, fleet_converge_shared_job_if,
  fleet_converge_checkout_ref_expr, fleet_converge_event_sha_checkout_ref_expr,
}
import gunbc.ci_spec { gunbc_run_step_targets }
import gunbc.fleet.printer_federation { printer_service_account, printer_provider_resource }

import test.claim.printer_workflow_witness_test {
  w_print_needs_exact_version_clear_bed_digest_and_first_attempt,
  w_unknown_printer_never_selects_a_default_machine,
  w_printer_federation_rejects_other_workflow_branch_and_environment,
  w_tool_probe_requires_mosquitto_version_two_or_newer,
}
import test.claim.printer_job_start_witness_test { no_start_outcome_authorizes_a_second_publish }
import test.claim.gcp_iam_converge_witness_test {
  every_target_is_bound_resource_locally_and_the_own_trust_is_not,
  only_a_live_approval_admits_the_mint_gate_or_the_apply,
}
import gunbc.fleet.printer_federation_provision { printer_dedicated_federation }
import gunbc.fleet.printer_host_tools { converge }

fn auth_step_matches(st: Step) -> Bool {
  match st {
    UsesStep { name: _, id, uses: _, with: args, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match id { Present { value: value } => value == "wif_auth" && match args {
        Present { value: fields } => any(fields, f => f.key == "service_account" && match f.value { YamlString { value: v } => v == (printer_service_account as String) _ => false })
          && any(fields, f => f.key == "workload_identity_provider" && match f.value { YamlString { value: v } => v == printer_provider_resource() _ => false })
        Absent => false
      } Absent => false }
    _ => false
  }
}
test fn separate_job_uses_dedicated_identity() -> Bool {
  let job = fleet_converge_printer_job()
  job.id == "printer" && match job.environment { Present { value } => value == "printer-lan" Absent => false }
    && count(filter(job.steps, s => auth_step_matches(st: s))) == 1
    && any(job.needs, n => n == "build")
}
test fn observer_has_no_fleet_ssh_demand() -> Bool {
  match fleet_converge_mode_fleet_ssh_key_demand(mode: PrinterWorkflow) { FleetSshKeyNotConsumed => true _ => false }
}
test fn trusted_code_cannot_be_replaced_by_dispatch_revision() -> Bool {
  string_contains(s: fleet_converge_checkout_ref_expr, pattern: "github.event.inputs.mode == 'printer'")
    && fleet_converge_event_sha_checkout_ref_expr == "${{ github.sha }}"
    && string_contains(s: fleet_converge_shared_job_if, pattern: "github.event.inputs.mode != 'printer'")
}
test fn observer_is_a_registered_dispatch_and_run_target() -> Bool {
  any(fleet_converge_mode_options, m => m == "printer")
    && count(filter(gunbc_run_step_targets(), t => t.entry == "dag/gunbc/fleet/printer_workflow_run.dag" && t.function == "run")) == 1
}

test fn print_input_and_tool_controls_hold() -> Bool {
  w_print_needs_exact_version_clear_bed_digest_and_first_attempt() &&
  w_unknown_printer_never_selects_a_default_machine() &&
  w_tool_probe_requires_mosquitto_version_two_or_newer()
}

test fn approval_and_start_replay_regressions_hold() -> Bool {
  w_printer_federation_rejects_other_workflow_branch_and_environment() &&
  no_start_outcome_authorizes_a_second_publish() &&
  every_target_is_bound_resource_locally_and_the_own_trust_is_not() &&
  only_a_live_approval_admits_the_mint_gate_or_the_apply()
}

test fn printer_identity_reads_only_the_two_printer_secrets() -> Bool {
  let f = printer_dedicated_federation()
  length(f.secret_grants) == 2 &&
  all(f.secret_grants, g => g.role == "roles/secretmanager.secretAccessor" &&
    ((g.target.secret as String) == "printer-01-lan-access-code" || (g.target.secret as String) == "printer-02-lan-access-code"))
}
