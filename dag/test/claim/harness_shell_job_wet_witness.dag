module test.claim.harness_shell_job_wet_witness

import std.types { Bool, String, List, FilePath, NonEmptyStr, Timestamp }
import std.optional { Present }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.measure { second }
import std.algebra { trim }
import extdeps.shell
import extdeps.posix.signal
import extdeps.filesystem.filesystem_io
import extdeps.tools.gnu_coreutils { pwd_command }
import gunbc.command_runner { run_shell_command_capture, LocalExec }
import extdeps.shell.exec { ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import extdeps.languages.json.emit { json_object, json_kv, json_string }
import gunbc.harness.harness_wire { WireToolUseBlock }
import gunbc.harness.harness_shell_job_policy {
  ShellJobSchedule, WaitUseDefault, WaitPaceReset,
}
import gunbc.harness.harness_tool {
  HarnessToolEnvironment, HarnessToolOutcome, ToolJob, ToolCompleted, ToolReport, ToolRefused, DurationExceeded,
  harness_tool_environment, harness_run_command_scheduled, harness_wait_jobs_scheduled,
  harness_kill_job, harness_read_job_output, harness_outcome_text, harness_env_with_jobs,
}
import gunbc.harness.harness_shell_job {
  HarnessShellJob, JobFinished, JobExitedOutcome,
  harness_observe_job, JobStillRunning, JobExited, JobSignaled, JobReapRefused,
  harness_job_is_running,
}
import gunbc.harness.harness_turn {
  harness_prepare_hand_in_round, HandInRoundBlocked, HandInRoundClear,
}
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_schedule() -> ShellJobSchedule {
  ShellJobSchedule {
    inline_hold: second(count: 1),
    wait_base: second(count: 3),
    wait_factor: 2,
    wait_request_cap_factor: 4,
    wait_minimum: second(count: 1),
    backstop: second(count: 20),
  }
}

fn wait_early_schedule() -> ShellJobSchedule {
  ShellJobSchedule {
    inline_hold: second(count: 0),
    wait_base: second(count: 5),
    wait_factor: 2,
    wait_request_cap_factor: 4,
    wait_minimum: second(count: 1),
    backstop: second(count: 20),
  }
}

fn env_at(worktree: String, output: String) -> HarnessToolEnvironment {
  harness_tool_environment(
    working_directory: worktree as FilePath,
    timeout_program: "/usr/bin/timeout" as FilePath,
    job_output_directory: output as FilePath,
  )
}

fn is_job(outcome: HarnessToolOutcome) -> Bool {
  match outcome {
    ToolJob { id: _, text: _ } => true
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
    ToolReport { text: _, standing: _ } => false
    ToolRefused { disposition: _ } => false
  }
}

fn is_duration_exceeded(outcome: HarnessToolOutcome) -> Bool {
  match outcome {
    ToolRefused { disposition: d } =>
      match d {
        DurationExceeded { limit_seconds: _ } => true
        _ => false
      }
    ToolJob { id: _, text: _ } => false
    ToolCompleted { text: _, exit_code: _, standing: _ } => false
    ToolReport { text: _, standing: _ } => false
  }
}

fn claim_process_cwd() -> String {
  match run_shell_command_capture(command: pwd_command(), transport: LocalExec) {
    ProcessOutputPresent { text } => trim(s: text)
    ProcessOutputAbsent => ""
    ProcessRefused { exit_code: _, stderr: _ } => ""
  }
}

test fn a_command_over_the_inline_hold_returns_a_job_not_duration_exceeded() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let step = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 20",
    schedule: fixture_schedule(),
  )
  let ok = is_job(outcome: step.outcome) && !is_duration_exceeded(outcome: step.outcome)
  let _stop = match step.environment.jobs.first() {
    Absent => step
    Present { value: j } => harness_kill_job(environment: step.environment, id: j.id)
  }
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success && ok
}

test fn run_command_pwd_equals_the_environment_working_directory() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let process_cwd = claim_process_cwd()
  let step = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "pwd",
    schedule: fixture_schedule(),
  )
  let text = trim(s: harness_outcome_text(outcome: step.outcome))
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success
    && process_cwd != dir.path
    && text.contains(dir.path)
}

test fn wait_with_no_running_job_is_refused() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let waited = harness_wait_jobs_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    schedule: wait_early_schedule(),
    request: WaitUseDefault,
  )
  let text = harness_outcome_text(outcome: waited.outcome)
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && text.contains("no running job")
}

test fn wait_after_a_job_finishes_does_not_return_early_while_another_runs() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let first_job = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 1",
    schedule: wait_early_schedule(),
  )
  let second_job = harness_run_command_scheduled(
    environment: first_job.environment,
    command: "sleep 20",
    schedule: wait_early_schedule(),
  )
  let first_wait = harness_wait_jobs_scheduled(
    environment: second_job.environment,
    schedule: wait_early_schedule(),
    request: WaitUseDefault,
  )
  let short_wait = ShellJobSchedule {
    inline_hold: second(count: 0),
    wait_base: second(count: 2),
    wait_factor: 2,
    wait_request_cap_factor: 4,
    wait_minimum: second(count: 1),
    backstop: second(count: 20),
  }
  let second_wait = harness_wait_jobs_scheduled(
    environment: first_wait.environment,
    schedule: short_wait,
    request: WaitUseDefault,
  )
  let first_text = harness_outcome_text(outcome: first_wait.outcome)
  let second_text = harness_outcome_text(outcome: second_wait.outcome)
  let still_running = any(second_wait.environment.jobs, j => harness_job_is_running(job: j))
  let _stop = fold(second_wait.environment.jobs, init: second_wait, f: (acc, j) =>
    if harness_job_is_running(job: j) {
      harness_kill_job(environment: acc.environment, id: j.id)
    } else {
      acc
    })
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success
    && first_text.contains("a job finished before the wait elapsed")
    && first_text.contains("exit 0")
    && second_text.contains("wait elapsed with no job finishing")
    && !second_text.contains("a job finished before the wait elapsed")
    && still_running
}

test fn wait_returns_when_a_job_finishes_before_the_timeout() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let started = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 1; exit 7",
    schedule: wait_early_schedule(),
  )
  let waited = harness_wait_jobs_scheduled(
    environment: started.environment,
    schedule: wait_early_schedule(),
    request: WaitUseDefault,
  )
  let text = harness_outcome_text(outcome: waited.outcome)
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && text.contains("a job finished before the wait elapsed") && text.contains("exit 7")
    && !text.contains("[exit 0]")
}

test fn wait_result_over_a_job_that_exited_1_does_not_say_exit_0() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let started = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 1; exit 1",
    schedule: wait_early_schedule(),
  )
  let waited = harness_wait_jobs_scheduled(
    environment: started.environment,
    schedule: wait_early_schedule(),
    request: WaitUseDefault,
  )
  let text = harness_outcome_text(outcome: waited.outcome)
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && text.contains("exit 1") && !text.contains("[exit 0]")
}

test fn job_output_after_the_backstop_is_duration_exceeded() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let tight = ShellJobSchedule {
    inline_hold: second(count: 1),
    wait_base: second(count: 6),
    wait_factor: 2,
    wait_request_cap_factor: 4,
    wait_minimum: second(count: 1),
    backstop: second(count: 2),
  }
  let started = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 20",
    schedule: tight,
  )
  let waited = harness_wait_jobs_scheduled(
    environment: started.environment,
    schedule: tight,
    request: WaitUseDefault,
  )
  let read = match waited.environment.jobs.first() {
    Absent => waited
    Present { value: j } => harness_read_job_output(environment: waited.environment, id: j.id)
  }
  let _stop = fold(read.environment.jobs, init: read, f: (acc, j) =>
    if harness_job_is_running(job: j) {
      harness_kill_job(environment: acc.environment, id: j.id)
    } else {
      acc
    })
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success && is_duration_exceeded(outcome: read.outcome)
}

test fn a_command_exit_124_inside_the_backstop_is_not_duration_exceeded() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let step = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "exit 124",
    schedule: fixture_schedule(),
  )
  let text = harness_outcome_text(outcome: step.outcome)
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success
    && !is_duration_exceeded(outcome: step.outcome)
    && match step.outcome {
      ToolCompleted { text: _, exit_code, standing: _ } => exit_code == 124 && text.contains("[exit 124]")
      ToolJob { id: _, text: _ } => false
      ToolReport { text: _, standing: _ } => false
      ToolRefused { disposition: _ } => false
    }
}

test fn the_backstop_kills_the_process_group() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let marker = join([out.path, "/grandchild-28391.pid"], "")
  let tight = ShellJobSchedule {
    inline_hold: second(count: 1),
    wait_base: second(count: 6),
    wait_factor: 2,
    wait_request_cap_factor: 4,
    wait_minimum: second(count: 1),
    backstop: second(count: 2),
  }
  let started = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: join(["sleep 28391 & printf %s $! > ", marker, "; sleep 28392"], ""),
    schedule: tight,
  )
  let waited = harness_wait_jobs_scheduled(
    environment: started.environment,
    schedule: tight,
    request: WaitUseDefault,
  )
  let read = match waited.environment.jobs.first() {
    Absent => waited
    Present { value: j } => harness_read_job_output(environment: waited.environment, id: j.id)
  }
  let timeout_dead = is_duration_exceeded(outcome: started.outcome)
    || is_duration_exceeded(outcome: waited.outcome)
    || is_duration_exceeded(outcome: read.outcome)
  let grandchild = Filesystem.Read(path: marker)
  let grandchild_gone = if grandchild.success && grandchild.content.length() > 0 {
    !posix.Signal.TerminateProcess(pid: grandchild.content as NonEmptyStr).success
  } else {
    false
  }
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success && timeout_dead && grandchild_gone
}

test fn job_kill_keeps_the_job_running_unless_reap_confirms_death() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let started = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 20",
    schedule: wait_early_schedule(),
  )
  let killed = match started.environment.jobs.first() {
    Absent => started
    Present { value: j } => harness_kill_job(environment: started.environment, id: j.id)
  }
  let text = harness_outcome_text(outcome: killed.outcome)
  let confirmed = match killed.environment.jobs.first() {
    Absent => false
    Present { value: j } =>
      match harness_observe_job(job: j) {
        JobStillRunning { job: _ } => false
        JobExited { job: _, code: _ } => true
        JobSignaled { job: _, signal: _ } => true
        JobReapRefused { job: _, cause: _ } => false
      }
  }
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success && confirmed && text.contains("killed process group")
}

test fn job_output_of_a_finished_exit_3_job_does_not_say_exit_0() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let started = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "sleep 2; exit 3",
    schedule: fixture_schedule(),
  )
  let waited = harness_wait_jobs_scheduled(
    environment: started.environment,
    schedule: fixture_schedule(),
    request: WaitUseDefault,
  )
  let read = match waited.environment.jobs.first() {
    Absent => waited
    Present { value: j } => harness_read_job_output(environment: waited.environment, id: j.id)
  }
  let text = harness_outcome_text(outcome: read.outcome)
  let _stop = fold(read.environment.jobs, init: read, f: (acc, j) =>
    if harness_job_is_running(job: j) {
      harness_kill_job(environment: acc.environment, id: j.id)
    } else {
      acc
    })
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success
    && !text.contains("[exit 0]")
    && match read.outcome {
      ToolCompleted { text: _, exit_code, standing: _ } => exit_code == 3 && text.contains("[exit 3]")
      ToolRefused { disposition: _ } => false
      ToolReport { text: _, standing: _ } => false
      ToolJob { id: _, text: _ } => false
    }
}

test fn unread_job_output_is_typed_unreadable_not_empty() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let missing = join([out.path, "/no-such-job.out"], "")
  let job = HarnessShellJob {
    id: "1",
    pid: 1,
    command: "true",
    stdout_file: missing as FilePath,
    stderr_file: missing as FilePath,
    stdio_note: "",
    started_at: "1970-01-01T00:00:00Z" as Timestamp,
    backstop: second(count: 20),
    state: JobFinished { outcome: JobExitedOutcome { code: 0 }, elapsed: Present { value: second(count: 0) } },
  }
  let step = harness_read_job_output(
    environment: harness_env_with_jobs(
      environment: env_at(worktree: dir.path, output: out.path),
      jobs: [job],
      wait_pace: WaitPaceReset,
    ),
    id: "1",
  )
  let text = harness_outcome_text(outcome: step.outcome)
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success
    && match step.outcome {
      ToolRefused { disposition: _ } => text.contains("unreadable") && !text.contains("[exit 0]")
      ToolCompleted { text: _, exit_code: _, standing: _ } => false
      ToolReport { text: _, standing: _ } => false
      ToolJob { id: _, text: _ } => false
    }
}

test fn run_command_does_not_dirty_the_worktree_git_status() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let inited = shell.Exec.RunArgv(program: "git" as NonEmptyStr, arguments: ["-C", dir.path, "init", "-q"])
  let configured = shell.Exec.RunArgv(
    program: "git" as NonEmptyStr,
    arguments: ["-C", dir.path, "config", "user.email", "job@example.test"],
  )
  let named = shell.Exec.RunArgv(
    program: "git" as NonEmptyStr,
    arguments: ["-C", dir.path, "config", "user.name", "job"],
  )
  let committed = shell.Exec.RunArgv(
    program: "git" as NonEmptyStr,
    arguments: ["-C", dir.path, "-c", "commit.gpgsign=false", "commit", "--allow-empty", "-qm", "seed"],
  )
  let before = shell.Exec.RunArgv(
    program: "git" as NonEmptyStr,
    arguments: ["-C", dir.path, "status", "--porcelain"],
  )
  let step = harness_run_command_scheduled(
    environment: env_at(worktree: dir.path, output: out.path),
    command: "true",
    schedule: fixture_schedule(),
  )
  let after = shell.Exec.RunArgv(
    program: "git" as NonEmptyStr,
    arguments: ["-C", dir.path, "status", "--porcelain"],
  )
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success
    && inited.exit_code == 0
    && configured.exit_code == 0
    && named.exit_code == 0
    && committed.exit_code == 0
    && before.stdout == after.stdout
    && match step.outcome {
      ToolCompleted { text: _, exit_code, standing: _ } => exit_code == 0
      ToolJob { id: _, text: _ } => false
      ToolReport { text: _, standing: _ } => false
      ToolRefused { disposition: _ } => false
    }
}

test fn hand_in_in_the_same_round_as_a_backgrounded_command_is_refused() -> Bool {
  let dir = shell.Mktemp.Dir()
  let out = shell.Mktemp.Dir()
  let uses = [
    WireToolUseBlock {
      id: "c1",
      name: "run_command",
      input: json_object([json_kv(key: "command", value: json_string(s: "sleep 95"))]),
    },
    WireToolUseBlock {
      id: "h1",
      name: "hand_in",
      input: json_object([]),
    },
  ]
  let prepared = harness_prepare_hand_in_round(
    environment: env_at(worktree: dir.path, output: out.path),
    uses: uses,
  )
  let blocked = match prepared {
    HandInRoundBlocked { environment: env, results: _, detail } => {
      let _stop = fold(env.jobs, init: env, f: (acc, j) =>
        if harness_job_is_running(job: j) {
          harness_kill_job(environment: acc, id: j.id).environment
        } else {
          acc
        })
      detail.contains("wait or job_kill")
    }
    HandInRoundClear { environment: env, results: _ } => {
      let _stop = fold(env.jobs, init: env, f: (acc, j) =>
        if harness_job_is_running(job: j) {
          harness_kill_job(environment: acc, id: j.id).environment
        } else {
          acc
        })
      false
    }
  }
  let _cleanup = shell.Remove.RecursiveForce(path: dir.path)
  let _cleanup_out = shell.Remove.RecursiveForce(path: out.path)
  dir.success && out.success && blocked
}
