module test.claim.stage0_rust_product_reachability_witness


test fn product_reachability_note_forbids_tracking_as_proof() -> Bool {
  string_contains(s: gunbc.stage0_rust_product_reachability.stage0_rust_product_reachability_note, pattern: "NOT proof")
    && string_contains(s: gunbc.stage0_rust_product_reachability.stage0_rust_product_reachability_note, pattern: "C2 carrier")
    && string_contains(s: gunbc.stage0_rust_product_reachability.stage0_rust_product_reachability_note, pattern: "does NOT prove non-reachability")
}

test fn product_reachability_cargo_bin_is_product_entry() -> Bool {
  match gunbc.stage0_rust_product_reachability.product_reachability_verdict_for_path(
    path: "src/v1/stage0/src/bin/claim_executor.rs",
    cargo_bin_repo_paths: ["src/v1/stage0/src/bin/claim_executor.rs"]
  ) {
    gunbc.stage0_rust_product_reachability.ProductReachable { path: path, entry_path: entry } =>
      path == "src/v1/stage0/src/bin/claim_executor.rs"
        && entry == "src/v1/stage0/src/bin/claim_executor.rs"
    _ => false
  }
}

test fn product_reachability_test_harness_is_test_only() -> Bool {
  match gunbc.stage0_rust_product_reachability.product_reachability_verdict_for_path(
    path: "src/v1/tests/foo.rs",
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
  ) {
    gunbc.stage0_rust_product_reachability.TestOnlyReachable { path: path } => path == "src/v1/tests/foo.rs"
    _ => false
  }
}

test fn product_reachability_tooling_refuses_instead_of_manufacturing_negative() -> Bool {
  match gunbc.stage0_rust_product_reachability.product_reachability_verdict_for_path(
    path: "dag/tools/foo/witness_main.rs",
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
  ) {
    gunbc.stage0_rust_product_reachability.ReachabilityRefused { path: path, unresolved_edge: edge } =>
      path == "dag/tools/foo/witness_main.rs" && edge != ""
    _ => false
  }
}

test fn product_reachability_red_control_refuses_unresolved_edge() -> Bool {
  match gunbc.stage0_rust_product_reachability.product_reachability_verdict_for_path(
    path: "src/v1/stage0/src/cli_run.rs",
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
  ) {
    gunbc.stage0_rust_product_reachability.ReachabilityRefused { path: path, unresolved_edge: edge } =>
      path == "src/v1/stage0/src/cli_run.rs" && edge != ""
    _ => false
  }
}

test fn product_reachability_exact_paths_refuse_on_observation_refusal() -> Bool {
  match gunbc.stage0_rust_product_reachability.exact_product_reachable_paths(receipt: gunbc.stage0_rust_product_reachability.ProductReachabilityObservationRefused) {
    gunbc.stage0_rust_product_reachability.ProductReachabilityExactPathsRefused => true
    _ => false
  }
    && match gunbc.stage0_rust_product_reachability.exact_reachability_refused_paths(receipt: gunbc.stage0_rust_product_reachability.ProductReachabilityObservationRefused) {
      gunbc.stage0_rust_product_reachability.ProductReachabilityExactPathsRefused => true
      _ => false
    }
}

test fn product_reachability_exact_sets_partition_verdicts() -> Bool {
  let receipt = gunbc.stage0_rust_product_reachability.product_reachability_receipt(
    observation: gunbc.stage0_rust_product_reachability.product_reachability_witness_observation(
      tracked_paths: [
        "src/v1/stage0/src/main.rs",
        "src/v1/tests/foo.rs",
        "src/v1/stage0/src/cli_run.rs"
      ],
      cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
    )
  )
  match receipt {
    gunbc.stage0_rust_product_reachability.ProductReachabilityDerived { cargo_root_paths: cargo_root_paths, verdicts: verdicts } =>
      match gunbc.stage0_rust_product_reachability.exact_product_reachable_paths(receipt: receipt) {
        gunbc.stage0_rust_product_reachability.ProductReachabilityExactPathsDerived { paths: product_paths } =>
          match gunbc.stage0_rust_product_reachability.exact_reachability_refused_paths(receipt: receipt) {
            gunbc.stage0_rust_product_reachability.ProductReachabilityExactPathsDerived { paths: refused_paths } =>
              v2.std.algebra.length(xs: product_paths) == 1
                && v2.std.algebra.length(xs: refused_paths) == 1
                && v2.std.algebra.length(xs: verdicts) == 3
            _ => false
          }
        _ => false
      }
    _ => false
  }
}
