module test.probe.review_sheet_validated_header_schema_forged_probe

// THIS MODULE MUST NOT RESOLVE. A ValidatedHeaderSchema is minted by
// gunbc.review_sheet_projection validate_header_schema and by nothing else: it is
// sole_constructor, so the record literal below -- a header row authored beside the fold that is
// supposed to derive it, with a schema whose identity column and whose sole column are both
// "Listing", and with the header names chosen by the author to render that name twice -- refuses
// as SoleConstructorViolation.
//
// This is the whole point of the carrier rather than a validation function. Every consumer of a
// header row now takes ValidatedHeaderSchema (classify_review_sheet's missing_schema_header, the
// format actuator's band extent and standing-column position), so the duplicate header row this
// module tries to build has no route to a writer that does not pass through the mint. If the
// literal below ever compiles, the wall is gone and the mint is advice.

import std.types { NonEmptyStr }
import gunbc.review_sheet_projection {
  ValidatedHeaderSchema,
  ReviewSheetSchema,
  ReviewColumn,
  DerivedField,
}

fn forged_header_schema() -> ValidatedHeaderSchema {
  ValidatedHeaderSchema {
    schema: ReviewSheetSchema {
      identity_column: "Listing" as NonEmptyStr,
      columns: [
        ReviewColumn { name: "Listing" as NonEmptyStr, kind: DerivedField { source_field: "listing" as NonEmptyStr } },
      ],
    },
    header_names: ["Listing" as NonEmptyStr, "Listing" as NonEmptyStr],
  }
}
