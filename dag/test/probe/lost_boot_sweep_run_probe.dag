module test.probe.lost_boot_sweep_run_probe

// THIS MODULE MUST NOT RESOLVE. The run witness's supplied_population supplies a width to a restricted
// constructor, so it is a boundary of its own: admit_callers-restricted to run_sweep. A call from here
// must refuse AT THE HELPER. The witness test.claim.runner.runner_lost_boot_sweep_run_probe_witness
// requires that refusal by subject name. dag/test/probe/ sits under the strict-resolve exclusion.

import std.types { String }
