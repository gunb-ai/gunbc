module test.probe.bare_string_from_boundary_probe

// THIS MODULE MUST NOT RESOLVE. The second most tempting mishandling: pull a bare String out of
// what the boundary produced. Before this change gunbc.principal_projection carried the raw
// OidcIdTokenClaims on its projection, so `projection.claims.standard.email` was one field walk
// away from any consumer. Now the projection carries Classified<PersonalIdentity,
// OidcStandardClaims>, which has no `email` and no `value`: the walk below has no field to land
// on and refuses as InternalError ("no field 'email' on type 'Classified'" -- the class the checker
// actually emits for a projection off a type without the field; FieldNotFound is never emitted for
// field access, per gunbc.recurring_failure_mode diagnostic_name_mechanism_silent). The second function is the same temptation aimed at the
// carrier itself -- constructing a Classified in this module from a String -- which refuses as
// SoleConstructorViolation: classification happens at a boundary or not at all.

import std.types { String, NonEmptyStr }
import std.decl_ref { decl_ref }
import extdeps.auth.jwt { JwtUriString, JwtBareString, JwtAudienceSingle, NumericDateWholeSeconds }
import extdeps.auth.oidc { OidcIdTokenClaims, OidcStandardClaims }
import product.data_category { PersonalIdentity, personal_identity_ref }
import product.data_class { Classified }
import gunbc.principal_projection { oidc_projection }

fn claims() -> OidcIdTokenClaims {
  OidcIdTokenClaims {
    issuer: JwtUriString { value: "https://issuer.example" as NonEmptyStr, scheme: "https" as NonEmptyStr },
    subject: JwtBareString { value: "external-subject" as NonEmptyStr },
    audience: JwtAudienceSingle { value: JwtBareString { value: "client" as NonEmptyStr } },
    expires_at: NumericDateWholeSeconds { seconds: 2000 },
    issued_at: NumericDateWholeSeconds { seconds: 1000 },
    auth_time: none, nonce: none, acr: none, amr: none, azp: none, session_id: none,
    standard: OidcStandardClaims { email: Present { value: "person@example.test" }, email_verified: none, name: none },
  }
}

fn email_in_the_clear() -> String {
  match oidc_projection(claims: claims()).standard.email {
    Present { value: e } => e as String
    Absent => ""
  }
}

fn self_classified(raw: String) -> Classified<PersonalIdentity, String> {
  Classified { category: personal_identity_ref(), reveal: fn(k) { raw } }
}
