module test.probe.principal_mint_unadmitted_probe

// THIS MODULE MUST NOT RESOLVE. The construction wall on a human principal is a caller seal, not
// a convention: mint_human_principal_from_verdict admits only the named login/witness boundary
// decls, so a call from any other module -- even one holding a perfectly good verified verdict --
// refuses as ConstructorCallAdmissionRefused. Holding the evidence is not the authority to
// project it; the projection boundary decides who mints principals.

import std.types { NonEmptyStr }
import extdeps.auth.jwt { JwtUriString, JwtBareString, JwtAudienceSingle, NumericDateWholeSeconds }
import extdeps.auth.oidc { OidcIdTokenClaims, OidcStandardClaims, OidcHostedDomain, OidcIdTokenVerdict, OidcIdTokenVerified }
import gunbc.principal_projection { HumanPrincipalMint, mint_human_principal_from_verdict }

fn claims() -> OidcIdTokenClaims {
  OidcIdTokenClaims {
    issuer: JwtUriString { value: "https://accounts.google.com" as NonEmptyStr, scheme: "https" as NonEmptyStr },
    subject: JwtBareString { value: "external-subject" as NonEmptyStr },
    audience: JwtAudienceSingle { value: JwtBareString { value: "client" as NonEmptyStr } },
    expires_at: NumericDateWholeSeconds { seconds: 2000 },
    issued_at: NumericDateWholeSeconds { seconds: 1000 },
    auth_time: none, nonce: none, acr: none, amr: none, azp: none, session_id: none,
    hosted_domain: Present { value: OidcHostedDomain { domain: "gunb.ai" as NonEmptyStr } },
    standard: OidcStandardClaims { email: Present { value: "person@gunb.ai" }, email_verified: Present { value: true }, name: Present { value: "A Person" }, picture: none },
  }
}

fn verdict() -> OidcIdTokenVerdict {
  OidcIdTokenVerified { claims: claims() }
}

fn mint_from_outside_the_boundary() -> HumanPrincipalMint {
  mint_human_principal_from_verdict(verdict: verdict())
}
