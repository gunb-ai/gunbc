module test.probe.fold_result_closes_at_step_probe

// A FOLD'S RESULT IS ITS ACCUMULATOR, AND AN OPEN CARRIER CLOSES AT THE TYPE THE STEP PRODUCES.
// Each fn below folds from a carrier its init leaves open: `init: none` (an Optional with no element),
// or an arm of a generic declaration that does not mention the parameter (a T-free arm, an empty
// list field). The step closes it. Before the v1 seed closed the carrier at the step, the call's
// inferred result stayed open (Option<_>, or a bare generic head), the emitter wrote `|acc: _, ..|`,
// and rustc refused the closure's first use of acc with E0282. tally is the control: a concrete init
// whose carrier was always closed and whose emitted fold must stay byte-identical.
import std.types { List, Bool, String, Map, Int }

type Probe = ProbeHit { n: Int } | ProbeMiss

fn probe_once(x: Int) -> Probe? {
  if x > 0 { Present { value: ProbeHit { n: x } } } else { none }
}

// gunbc.durable_cas_file_store cas_observe_window's shape: init none, one arm re-wraps the
// accumulator's own payload, the other is another call's Optional.
fn first_probe(xs: List<Int>) -> Probe? {
  fold(xs, init: none, f: (acc, x) => match acc {
    Present { value: p } => Present { value: p }
    Absent => probe_once(x: x)
  })
}

// std.list first_where's shape: init none over a generic element.
fn first_kept<T>(xs: List<T>, keep: fn(T) -> Bool) -> T? {
  fold(xs, init: none, f: fn(acc, x) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if keep(x) { Present { value: x } } else { none }
    }
  })
}

type ScanFor<T>
  = ScanNotFound { seen: Map<String, Bool> }
  | ScanFound { value: T }

// std.list first_duplicate_by_key's shape: the init is the arm of ScanFor<T> that does not mention T.
fn first_repeat<T>(xs: List<T>, key: fn(T) -> String) -> T? {
  match fold(xs, init: ScanNotFound { seen: empty_map() }, f: fn(acc, x) {
    match acc {
      ScanFound { value: v } => ScanFound { value: v }
      ScanNotFound { seen: seen } =>
        match map_get(seen, key(x)) {
          Present { value: _ } => ScanFound { value: x }
          Absent => ScanNotFound { seen: map_insert(seen, key(x), true) }
        }
    }
  }) {
    ScanFound { value: v } => Present { value: v }
    ScanNotFound { seen: _ } => none
  }
}

type KeptScan<T> {
  seen: Map<String, Int>
  kept_reversed: List<T>
}

// std.list distinct_by_key's shape: a record init whose only T-carrying field is an empty list.
fn distinct_kept<T>(xs: List<T>, key: fn(T) -> String) -> List<T> {
  let scan = fold(xs, init: KeptScan { seen: empty_map(), kept_reversed: [] }, f: fn(acc, x) {
    match map_get(acc.seen, key(x)) {
      Present { value: _ } => acc
      Absent => KeptScan { seen: map_insert(acc.seen, key(x), 1), kept_reversed: concat([x], acc.kept_reversed) }
    }
  })
  reverse(scan.kept_reversed)
}

type Tally {
  hits: Int
  misses: Int
}

// Control: a concrete init closes the carrier as written.
fn tally(xs: List<Int>) -> Tally {
  fold(xs, init: Tally { hits: 0, misses: 0 }, f: (acc, x) => if x > 0 { Tally { hits: acc.hits + 1, misses: acc.misses } } else { Tally { hits: acc.hits, misses: acc.misses + 1 } })
}
