module test.probe.unit_hold_proof_forged_probe

// THIS MODULE MUST NOT RESOLVE. Each function is one way to reach a Mt. Collins BMC write without
// holding the unit, and each must refuse at compile time
// (test.claim.machine_intake.mtcollins1_maintenance_hold_witness_test enrolls the refusals):
//   - a UnitHoldProof authored outside the hold module: SoleConstructorViolation at the literal;
//   - a call to each admit_callers-sealed write from outside its admitted callers:
//     ConstructorCallAdmissionRefused, keyed by the callee's name;
//   - THE SKIP-THE-READ MUTATION: a boot path that does not read the operator's stored approval of the
//     standing ruling has only a forged StandingRulingConfirmation to pass (SoleConstructorViolation),
//     and the hold-owning path refuses any caller but mtcollins1_boot_wet_on_srv1.

import std.types { NonEmptyStr, String }
import std.durable_compare_and_set { cas_generation_first }
import std.durable_exclusive_hold { DurableHoldOwnerRef }
import gunbc.machine_intake_mtcollins1_maintenance_hold { UnitHoldProof }
import gunbc.machine_intake_mtcollins1_standing_ruling { StandingRulingConfirmation }
import gunbc.machine_intake_mtcollins1_boot_run { mtcollins1_boot_under_live_unit_hold, mtcollins1_boot_actuate, mtcollins1_boot_param5_under_hold, mtcollins1_boot_power_after_poll }
import gunbc.machine_intake_mtcollins1_boot_diagnostic_bundle { mtcollins1_boot_param5, mtcollins1_boot_chassis_power }
import gunbc.machine_intake_mtcollins1_maintenance_hold { unit_hold_acquire }
import gunbc.machine_intake_mtcollins1_standing_ruling { mtcollins1_boot_standing_ruling_read }
import gunbc.machine_intake_mtcollins1_actuate { mtcollins1_drive_handoff, mtcollins1_cdrom_selection }
import gunbc.machine_intake_mtcollins1_media_attach { mtcollins1_attach_diskless_image }
import gunbc.machine_intake_mtcollins1_boot_authorization { mtcollins1_boot_subject }
import gunbc.machine_intake_oob_boot_handoff { oob_boot_handoff, oob_power_action_after_confirmed_selection, oob_power_actuate_and_read_back, OobPowerUp }
import gunbc.machine_intake_megarac_media_attach { megarac_attach_remote_image }
import gunbc.machine_intake_mtcollins1_access_observation { mtcollins1_capability_row, mtcollins1_access_observation, mtcollins1_endpoint, mtcollins1_firmware }

fn forged_proof() -> UnitHoldProof {
  UnitHoldProof {
    root: "/var/lib/gunbc/unit-holds",
    key: "mtcollins1",
    owner: "forger" as DurableHoldOwnerRef,
    generation: cas_generation_first(),
  }
}

fn power_cycle_through_the_wrapper_from_outside() -> String {
  let _x = mtcollins1_drive_handoff(proof: forged_proof(), label: "forged", password_file_raw: "/tmp/pw", capability_row: mtcollins1_capability_row, selection: mtcollins1_cdrom_selection)
  ""
}

fn attach_through_the_wrapper_from_outside() -> String {
  let _x = mtcollins1_attach_diskless_image(proof: forged_proof(), subject: mtcollins1_boot_subject(execution_revision: "0000000000000000000000000000000000000000"), password_file: "/tmp/pw", attempt: "forged")
  ""
}

fn power_cycle_through_the_generic_handoff_from_outside() -> String {
  let _x = oob_boot_handoff(observation: mtcollins1_access_observation, capability_row: mtcollins1_capability_row, username: "admin", password_file: "/tmp/pw", selection: mtcollins1_cdrom_selection)
  ""
}

fn power_action_past_the_verified_selection_from_outside() -> String {
  let _x = oob_power_action_after_confirmed_selection(bmc_host: mtcollins1_endpoint.host, username: "admin", password_file: "/tmp/pw", device: "cdrom")
  ""
}

fn power_command_past_the_state_read_from_outside() -> String {
  let _x = oob_power_actuate_and_read_back(bmc_host: mtcollins1_endpoint.host, username: "admin", password_file: "/tmp/pw", device: "cdrom", action: OobPowerUp)
  ""
}

fn boot_param5_read_from_outside_the_actuation() -> String {
  let _x = mtcollins1_boot_param5_under_hold(password_file: "/tmp/pw")
  ""
}

fn final_power_read_from_outside_the_actuation() -> String {
  let _x = mtcollins1_boot_power_after_poll(password_file: "/tmp/pw", census_ended: true, remaining: 1)
  ""
}

fn bundle_param5_read_from_outside_the_hold() -> String {
  let _x = mtcollins1_boot_param5(username: "admin", password_file: "/tmp/pw")
  ""
}

fn bundle_chassis_read_from_outside_the_hold() -> String {
  let _x = mtcollins1_boot_chassis_power(username: "admin", password_file: "/tmp/pw")
  ""
}

fn attach_through_the_generic_megarac_route_from_outside() -> String {
  let _x = megarac_attach_remote_image(bmc_host: mtcollins1_endpoint.host, username: "admin", password_file: "/tmp/pw", cookie_jar: "/tmp/jar", image_name: "x.iso", firmware: mtcollins1_firmware)
  ""
}

fn forged_ruling_confirmation() -> StandingRulingConfirmation {
  StandingRulingConfirmation { revision: "sha256:forged" }
}

fn boot_without_reading_the_standing_ruling() -> String {
  let _x = mtcollins1_boot_under_live_unit_hold(ruling: forged_ruling_confirmation(), run_id: "forged", subject: mtcollins1_boot_subject(execution_revision: "0000000000000000000000000000000000000000"), password_file: "/tmp/pw", sol_pid_path: "/tmp/pid", sol_capture_path: "/tmp/cap")
  ""
}

fn actuate_with_a_proof_but_no_ruling_read() -> String {
  let _x = mtcollins1_boot_actuate(proof: forged_proof(), subject: mtcollins1_boot_subject(execution_revision: "0000000000000000000000000000000000000000"), password_file: "/tmp/pw", attempt: "forged", sol_pid_path: "/tmp/pid", sol_capture_path: "/tmp/cap")
  ""
}

fn acquire_the_unit_hold_from_outside_its_roots() -> String {
  let _x = unit_hold_acquire(ruling: forged_ruling_confirmation(), root: "/tmp/holds", key: "mtcollins1", owner: "forger" as DurableHoldOwnerRef)
  ""
}

fn read_the_ruling_from_outside_its_roots() -> String {
  let _x = mtcollins1_boot_standing_ruling_read()
  ""
}
