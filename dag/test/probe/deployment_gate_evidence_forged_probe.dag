module test.probe.deployment_gate_evidence_forged_probe

// THIS MODULE MUST NOT RESOLVE. gunbc.auth.deployment_gate_authorization's claim is that removing a
// required reviewer from srv1-production requires BOTH arms of the gate to have been WITNESSED on real
// dispatches -- one released by the rule, one refused by it. The previous round of this file's history
// modelled that as a Bool read from prose in the operator step, which is the weakest rung: a Bool is
// true whenever someone writes true. Sealing the value is only worth anything if the seal bites where
// the value is MADE, so the two types the removal admission is built from are sole_constructor and the
// only door is admit_reviewer_removal, which takes two Optional<ObservedRuleReview> readbacks.
//
// THE TWO FORGERIES BELOW ARE THE TWO ROUTES A CALLER WOULD TAKE.
//
// (a) THE EVIDENCE ITSELF. A hand-written DeploymentGateTrialEvidence over two convenient run ids is a
// receipt for trials that never happened, and reviewer_removal_is_admitted would read it as admitted.
// DeploymentGateTrialEvidence and ObservedRuleReview are sole_constructor, so each literal refuses at
// the record as SoleConstructorViolation.
//
// (b) THE MINT, FED AN AUTHORED READBACK. ObservedRuleReview is the type a readback is supposed to
// produce by reading GitHub's record of the run and the pending_deployments readback. The strongest
// thing an outside caller can still write is an Optional built from ... something. It cannot build the
// carrier at all, so this call refuses at the two argument expressions rather than at the mint: the mint
// is reachable, and nothing can be handed to it that has not been read.
//
// The witness test.claim.deployment_gate_evidence_forged_probe_witness enrolls this probe and asserts
// each refusal class at its subject by name, against a control that only names the module. dag/test/probe/
// sits under the whole-tree strict-resolve exclusion, so this source reaches the compiler only through
// that witness.

import std.types { String, Int, Bool, List }
import std.optional { Present }
import gunbc.auth.deployment_gate_authorization {
  ObservedRuleReview,
  DeploymentGateTrialEvidence,
  ReviewerRemovalAdmission,
  admit_reviewer_removal,
  reviewer_removal_obstacle,
}
import extdeps.github.actions_runs { WorkflowRunRecord }
import extdeps.github.deployment_protection_rule { Approved, Rejected }

// (a) THE FORGED RECEIPT. Two run ids, the gated environment name, and a review state each -- fields
// chosen to satisfy every check the fold performs, which is exactly why the type must not be writable.
data forged_evidence: DeploymentGateTrialEvidence = DeploymentGateTrialEvidence {
  run_id_approved: 35447067113,
  run_id_rejected: 35447067114,
  environment_name: "srv1-production",
}

// (a') THE FORGED READBACK. The carrier the mint reads its two arms out of, written instead of read.
data forged_approved_review: ObservedRuleReview = ObservedRuleReview {
  run_id: 35447067113,
  environment_name: "srv1-production",
  state: Approved,
}

// (b) THE ROUTE: THE MINT, CALLED WITH AUTHORED ARMS. If this resolved, `is_admitted` would be a Bool
// a fixture could set.
data forged_admission: ReviewerRemovalAdmission = admit_reviewer_removal(
  approved: Present { value: forged_approved_review },
  rejected: Present {
    value: ObservedRuleReview {
      run_id: 35447067114,
      environment_name: "srv1-production",
      state: Rejected,
    },
  },
)

// Whether the forged admission would read as admitted. The obstacle carries the missing trial by name,
// so a forgery that made it through would report NO obstacle -- that is what this returns true for.
fn forged_removal_looks_admitted() -> Bool {
  match reviewer_removal_obstacle(admission: forged_admission) {
    none => true
    Present { value: _ } => false
  }
}

// A run record written here, so the forgery above does not depend on a helper it could not obtain.
fn an_unread_run() -> WorkflowRunRecord {
  WorkflowRunRecord {
    run_id: 35447067113,
    event: "workflow_dispatch",
    head_branch: "main",
    status: "completed",
    conclusion: "success",
    created_at_epoch_s: 1792000000,
    run_started_at_epoch_s: 1792000060,
    updated_at_epoch_s: 1792000120,
  }
}
