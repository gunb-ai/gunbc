module test.probe.deployment_gate_carrier_axis_forgery

// THE CARRIER'S OWN RED, AS A REAL COMPILED SOURCE (review 83825). One deliberate type error per
// compiled source: this census surfaces a module's FIRST type error and stops, so a second in the
// same file would be invisible -- measured in gate10, not theorised. The run-digits forgery lives in
// deployment_gate_evidence_forged_probe.dag; the foreign-carrier forgery lives HERE.
//
// WHY A FILE AND NOT AN INLINE STRING: the inline cut of this source read zero TypeMismatch rows with
// no way to see WHY (unrunnable? refused earlier? never attempted?). As a file on disk the compiler's
// own diagnostics are readable, and the witness reads it the same way its sibling probe_source reads
// the evidence probe.
//
// THE FORGERY: an INSTALLATION id in the RULE-id slot. GitHubAppInstallationId is the closest
// neighbour the confusion could actually take -- same { value: Int } shape, same extdeps.github
// family, imported here so the refusal cannot be an unknown-name artifact. If the two carriers were
// one shared GitHubId type, or the rule field had been mistyped as the installation type, this line
// would COMPILE. That is the mistake the separate carriers exist to make unwritable (§5: construction
// over validation), and this line is the witness that it is.
import extdeps.github.app { GitHubAppInstallationId, GitHubAppId }
import extdeps.github.deployment_protection_rule {
  EnabledDeploymentProtectionRule,
  RuleOwningApp,
}

data an_installation: GitHubAppInstallationId = GitHubAppInstallationId { value: 987654 }
data an_app: GitHubAppId = GitHubAppId { value: 7 }

data forged_foreign_carrier_row: EnabledDeploymentProtectionRule = EnabledDeploymentProtectionRule {
  id: an_installation,
  node_id: "DPPR_axis",
  enabled: true,
  app: RuleOwningApp { id: an_app, slug: "owning-app" },
}
