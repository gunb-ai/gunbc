module test.probe.deployment_gate_carrier_axis_forgery

// THE CARRIER'S CROSS-AXIS RED, as a real compiled source (review 83825). One deliberate type error
// per compiled source: this census surfaces a module's FIRST type error and stops, so a second in
// the same file would be invisible -- measured in gate10, not theorised. The run-digits forgery
// lives in deployment_gate_evidence_forged_probe.dag; the foreign-carrier forgery lives HERE.
//
// A FILE, NOT AN INLINE STRING: the inline cut read zero TypeMismatch rows with no way to see WHY.
// As a file on disk the witness reads it through the same probe_source the evidence probe uses,
// and a zero can be interrogated against the compiler's own diagnostics.
import std.types { String }
import extdeps.github.app { GitHubAppInstallationId, GitHubAppId }
import extdeps.github.deployment_protection_rule {
  EnabledDeploymentProtectionRule,
  RuleOwningApp,
}

data an_installation: GitHubAppInstallationId = GitHubAppInstallationId { value: 987654 }
data an_app: GitHubAppId = GitHubAppId { value: 7 }

// THE FORGERY: an INSTALLATION id in the RULE-id slot -- the closest neighbour the confusion could
// actually take (same { value: Int } shape, same extdeps.github family). If the two carriers were
// ever collapsed into one GitHubId type, or the rule field mistyped as the installation type, this
// line would COMPILE.
data forged_foreign_carrier_row: EnabledDeploymentProtectionRule = EnabledDeploymentProtectionRule {
  id: an_installation,
  node_id: "DPPR_axis",
  enabled: true,
  app: RuleOwningApp { id: an_app, slug: "owning-app" },
}
