module test.probe.qualification_generate_answer_rewrap_probe

// THIS MODULE MUST NOT RESOLVE. The generate fold pairs a dispatch with a 201 body it is handed, so
// an outside caller would mint a delivery for dispatch A from any created body. Only the perform
// function, whose body is GitHub's answer to dispatch.request, is admitted. Reached only through
// test.claim.runner_qualification_delivery_rewrap_witness.

import extdeps.transports.rest { RestAnswered }
import extdeps.github.actions_jit_runner { JitConfigCreatedBody }
import gunbc.runner.runner_jit_perform { JitMintDispatch }
import gunbc.github_effect_perform { JitMintPerformance, jit_mint_performance_of_generate }

fn mint_from_a_supplied_body(a: JitMintDispatch, body: JitConfigCreatedBody) -> JitMintPerformance {
  jit_mint_performance_of_generate(dispatch: a, outcome: RestAnswered { answer: body })
}
