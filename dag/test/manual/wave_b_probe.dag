module test.manual.wave_b_probe

import v2.std.effect_plan { Do, EffectPlan }
import v2.std.operation_argv {
  BoundOperationInvocation,
  OperationRef,
  bind_operation_invocation,
  operation_argv_bind_text,
  operation_argv_bind_text_list
}
import v2.std.orchestration { FailFast }
import v2.workflow.effect_plan_bash_materialize {
  EffectPlanBashMaterializationRefused,
  EffectPlanBashMaterialized,
  effect_plan_bash_materialize
}

fn probe_plan() -> EffectPlan<BoundOperationInvocation> {
  EffectPlan {
    steps: [
      Do { effect: bind_operation_invocation(
        at: OperationRef { path: "dag/extdeps/git/git.dag", service: "git.Core", operation: "FetchNoTags" },
        bindings: [
          operation_argv_bind_text(name: "remote", text: "origin"),
          operation_argv_bind_text(name: "ref", text: "main")
        ]
      ) },
      Do { effect: bind_operation_invocation(
        at: OperationRef { path: "dag/extdeps/gunbc/gunbc.dag", service: "gunbc.WitnessBin", operation: "Run" },
        bindings: [
          operation_argv_bind_text(name: "workdir", text: "."),
          operation_argv_bind_text(name: "bin_path", text: "target/release/gunbc"),
          operation_argv_bind_text_list(name: "args", items: [
            "run", "--source-root", "dag",
            "--entry", "dag/tools/merge_admission_gate.dag",
            "--function", "main"
          ])
        ]
      ) }
    ],
    on_failure: FailFast
  }
}

fn main() -> String {
  match effect_plan_bash_materialize(plan: probe_plan()) {
    EffectPlanBashMaterialized { source: s } => s
    EffectPlanBashMaterializationRefused { refusal: r } => concat("REFUSED step=", to_string(r.step_index))
  }
}
