module test.manual.command_runner_local_argv_receipt

import std.types { Bool, String }
import extdeps.exec.command { LocalExec }
import extdeps.tools.gnu_coreutils { printf_command, true_command }
import extdeps.posix.sh_invocation { posix_sh_program_command }
import gunbc.command_runner { run_shell_command_capture, process_outcome_receipt_text }
import extdeps.shell.exec { ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }

// THE DISCRIMINATING RECEIPT FOR command_runner's TRANSPORT-AGNOSTIC RUN SITE.
//
// WHAT IT DISCRIMINATES, which is the only thing that makes it worth running. The run site used
// to render an ArgvCommand to quoted text and hand it to bash, which split it back apart on
// whitespace -- and for a time carried a per-transport `match` at the call site that duplicated
// the dispatch command_over_transport already performs. Both are gone: run_shell_command_capture
// now asks command_over_transport ONCE for the outer ArgvCommand (LocalExec is the identity;
// SshExec already folds the remote program into one RFC 4254 string) and hands that argv,
// word-for-word, straight to shell.Exec.RunArgv -- no shell, no re-parse, no transport match. A
// test that merely runs a command green proves nothing about that change -- it would be equally
// green with the bash hop restored. So the subject is an argument the two paths DISAGREE about:
// one containing a space.
//
//   argv:            ["printf", "%s|", "a b"]
//   direct exec:     one operand "a b"          -> stdout "a b|"
//   via a shell:     two operands "a" and "b"   -> stdout "a|b|"
//
// If this ever reads "a|b|", the run site has reached a shell again and the collapse has silently
// regressed. That is the failure this file exists to make loud.
//
// WHY IT IS WET AND NOT ENROLLED. Hermetic evaluation replays an operation's declared
// mock_response off the declaration and never constructs an argv at all, so the property under
// test -- how the words reach the process -- is not observable hermetically by construction. A
// hermetic version of this file could only assert the mock, which is the specification-without-
// execution trap. It therefore runs wet, by hand, and is excluded from the floor exactly as
// test/manual/process_argv_expansion_receipt_test.dag is, for the same reason.

test fn spaced_operand_survives_as_one_argument() -> Bool {
  process_outcome_receipt_text(
    outcome: run_shell_command_capture(
      command: printf_command(format: "%s|", values: ["a b"]),
      transport: LocalExec,
    )
  ) == "a b|"
}

// The RED half of the same observation, stated as its own assertion rather than left implicit in
// the equality above: the shell-split rendering must NOT be what comes back. Written separately so
// a future edit that weakens the positive into something like a nonempty check still trips here.
test fn shell_split_rendering_is_not_what_comes_back() -> Bool {
  process_outcome_receipt_text(
    outcome: run_shell_command_capture(
      command: printf_command(format: "%s|", values: ["a b"]),
      transport: LocalExec,
    )
  ) != "a|b|"
}

// Control that the runner works at all on the ordinary case, so a failure above is read as a
// splitting regression rather than as the whole path being broken.
test fn plain_operand_round_trips() -> Bool {
  process_outcome_receipt_text(
    outcome: run_shell_command_capture(
      command: printf_command(format: "%s|", values: ["plain"]),
      transport: LocalExec,
    )
  ) == "plain|"
}

// THE DISCRIMINATING RED FOR THE COPRODUCT MIGRATION.
//
// The two states the old ShellCaptureResult could not tell apart:
//   a program that RAN AND FAILED printing nothing   -> success=false, stdout=""
//   a program that RAN AND SUCCEEDED printing nothing -> success=true,  stdout=""
// Both are stdout == "". Eight live sites read stdout without consulting success, so at every one
// of them a failure and an empty result were the same value.
//
// NOTE WHAT IS *NOT* BEING TESTED, because it was the first RED proposed and it proves nothing: a
// program that does not EXIST is already distinguishable, because the transport refuses the whole
// evaluation with a typed diagnostic naming the program and the OS error. That property holds with
// or without this migration, so a test of it would pass against the old record too.
//
// These two go red if ShellCaptureResult is restored, because then both arms are stdout == "" and
// nothing in the value distinguishes them.

test fn nonzero_exit_printing_nothing_is_refused_not_absent() -> Bool {
  match run_shell_command_capture(
    command: posix_sh_program_command(script: "exit 3"),
    transport: LocalExec,
  ) {
    ProcessRefused { exit_code: _, stderr: _ } => true
    ProcessOutputAbsent => false
    ProcessOutputPresent { text: _ } => false
  }
}

test fn zero_exit_printing_nothing_is_absent_not_refused() -> Bool {
  match run_shell_command_capture(
    command: true_command(),
    transport: LocalExec,
  ) {
    ProcessOutputAbsent => true
    ProcessRefused { exit_code: _, stderr: _ } => false
    ProcessOutputPresent { text: _ } => false
  }
}

// The positive arm, so a failure above reads as a lost distinction rather than as everything
// collapsing into one variant.
test fn zero_exit_with_output_is_present() -> Bool {
  match run_shell_command_capture(
    command: printf_command(format: "%s", values: ["value"]),
    transport: LocalExec,
  ) {
    ProcessOutputPresent { text: t } => t == "value"
    ProcessOutputAbsent => false
    ProcessRefused { exit_code: _, stderr: _ } => false
  }
}

// EMPTY ARGV NO LONGER HAS A TEST BECAUSE IT NO LONGER HAS A STATE, and this paragraph stands where
// the test did rather than the test being quietly dropped.
//
// `empty_argv_refuses` asserted that run_shell_command_capture refuses ArgvCommand { argv: [] } with
// the empty-argv guard, never reaching a process. That guard is gone, and so is the value that
// reached it: extdeps.exec.command ArgvCommand now carries `program: NonEmptyStr` beside its
// arguments, so a command naming no program cannot be written -- not by a caller, not by this file,
// which could not construct one even if the sole_constructor seal admitted it.
//
// THE EVIDENCE RULE THIS FOLLOWS, since DESIGN section 4b(4) says a climb deletes the production
// machinery and KEEPS the discriminating evidence: what is kept is the evidence that can still be
// expressed. An expecting-red probe becomes a permanent regression control when its wall lands -- but
// that presumes the probe remains WRITABLE once the wall exists. Here the wall's whole content is
// that the probe's input is unconstructible, so there is no test to flip: re-admitting the empty
// value in order to keep testing its refusal would reopen exactly the state the climb closed. The
// enrolled evidence for this class is now the type declaration itself, which every caller of every
// builder compiles against.
//
// RUNG, STATED HONESTLY: structurally impossible for the empty-argv class specifically -- the state
// has no representation in the carrier. That is a claim about this ONE class, not about argv
// construction generally: hand-spelled FLAGS remain writable inside a builder's own module, which is
// the point of homing each builder beside its cited authority rather than the seal's guarantee.
