module test.manual.runner_microvm_lifecycle_wet_receipt

import std.types { String, NonEmptyStr, Bool, List, Int }
import std.algebra { trim }
import std.resources { Network, Filesystem }
import std.measure { Second, second }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import extdeps.systemd { SliceProperty, SystemdUnitProperty, ActiveState, systemd_unit_property_wire_word, SystemdSliceCgroupPath, SliceCgroupPath, SliceNameNotASlice, systemd_slice_cgroup_path }
import extdeps.systemd.systemd_run { SystemdRunProperty, systemd_run_property_argv }
import extdeps.linux.cgroup_v2 { cgroup_v2_mount_point, cgroup_v2_child_path }

import gunbc.runner_microvm_lifecycle {
  CgroupSubtreeReadback, CgroupSubtreeEmpty, CgroupSubtreePopulated, CgroupSubtreeReadFailed,
  TeardownStop, StoppedGracefully, StoppedByForce, ForceStopBoundExceeded, ForceStopOutcomeUnobservable,
  StopFoundAlreadyQuiescent, ForceNotAsked,
  UnitInvocationReading, UnitInvocationRead, UnitInvocationUnread,
  ResourceReadback, ResourceAbsent, ResourcePresent, ResourceUnreadable,
}
import gunbc.runner_microvm_lifecycle_realize {
  observe_cgroup_subtree, stop_attempt, observe_resource_absence,
  observe_unit_attempt_invocation, attempt_invocation_env_setting,
}

// THE SIX REDs, EXECUTED AGAINST REAL PROCESSES. This is the file the whole microVM lifecycle lane
// exists to make possible, and it is the only thing in it that has run a process.
//
// WHY IT IS WET AND NOT ENROLLED, and the distinction is the point rather than an excuse. The
// hermetic witness test.claim.runner.runner_microvm_lifecycle_witness_test SUPPLIES every
// CgroupSubtreeReadback, TeardownStop and ResourceReadback and asks what the decision layer does
// with them. That is the right subject for those claims (DESIGN section 3: a witness discriminates at
// one interface) and it establishes nothing at all about whether a readback taken on a host ever
// PRODUCES those values. This file is the pairing obligation that makes those supplied inputs a
// reading: it executes the producers in gunbc.runner_microvm_lifecycle_realize against transient
// systemd units on a real host and asserts which arm comes back.
//
// IT COULD NOT BE HERMETIC. Hermetic evaluation replays each operation's declared mock_response, so
// linux.CgroupV2.ReadEvents would return the mock's `populated 0` whatever the host held --
// which is exactly the property under test. A hermetic version of this file would assert the mocks.
//
// IT RUNS IN TRANSIENT UNITS AND NEVER ON A LIVE SLOT. Every unit below is systemd-run --collect
// under one test slice this file owns, and no claim touches a fabric-cell slice, a runner slot or
// the cell-readiness store. The one host mutation outside that slice is a chmod of the test slice's
// own cgroup.events, restored by the claim that makes it.
//
// WHERE IT RAN: srv1, over ssh, as root, with a locally built arm64 claim_batch. It needs root
// because systemctl kill and the transient system units do; it is invoked by hand and is excluded
// from the floor, exactly as test/manual/command_runner_local_argv_receipt_test.dag is and for the
// same reason.
//
// THE SHELL PAYLOADS ARE FIXTURES, NOT MODELLED SEMANTICS. `/bin/sh -c "trap '' TERM; sleep 600"`
// is not this repository implementing anything in shell; it is the HOST CONDITION the claim needs
// to exist -- a process that ignores SIGTERM -- and there is no way to produce one without running
// one. What is under test is the .dag producer that observes it.

// THE TEST SLICE NAME IS DASHED ON PURPOSE. systemd expands a dashed slice name into a path
// (extdeps.systemd systemd_slice_cgroup_path), so `gunbc-wetlifecycle.slice` lives at
// gunbc.slice/gunbc-wetlifecycle.slice. Every cell slice is dashed too -- fabric-cell-<host>-<NN>
// -- so a dashed test slice keeps this file honest: if the path expansion regresses to a naive
// join, every claim here goes red instead of quietly reading an empty subtree.
data wet_slice: NonEmptyStr = "gunbc-wetlifecycle.slice"

fn wet_slice_property() -> SystemdRunProperty {
  SystemdRunProperty { property: SliceProperty, value: wet_slice }
}

fn start_payload(unit: NonEmptyStr, argv: List<String>) -> Bool
  uses net: Network
{
  systemd.SystemdRun.RunTransient(
    unit: unit,
    property_argv: systemd_run_property_argv(properties: [wet_slice_property()]),
    command_argv: argv,
  ).success
}

// EVERY CLAIM TEARS ITS OWN SLICE DOWN FIRST AND THEN WAITS FOR IT TO BE OBSERVABLY EMPTY.
//
// THE WAIT IS THE PART THE FIRST CUT WAS MISSING, AND IT COST A FLAKE. Claims share one host and the
// substrate does not promise an order, so a claim that assumed a clean slice would pass or fail on
// whichever claim ran before it -- and one of them deliberately LEAVES a process running, which is
// the fact it exists to establish. `systemctl stop` on a slice returns before the units under it are
// gone, so stopping and immediately starting raced: the_cell_wide_force_ends_a_survivor_in_a_sibling
// _cgroup passed in isolation and failed when it ran after the claim that leaves a survivor behind.
// The controller was right both times; the harness was not.
//
// SO THE PRECONDITION IS ASSERTED RATHER THAN ASSUMED. This polls the same readback the claims use
// until the slice reads EMPTY, and returns false if it never does -- so a claim whose slice could not
// be cleared fails on its own setup instead of on a verdict about a cell it does not own.
fn clear_slice() -> Bool
  uses net: Network
{
  let _stopped = systemd.Systemctl.Stop(unit: wet_slice).success
  slice_is_quiet(polls_remaining: 20)
}

fn slice_is_quiet(polls_remaining: Int) -> Bool
  uses net: Network
{
  if readback_is_empty(r: observe_cgroup_subtree(slice: wet_slice)) {
    true
  } else if polls_remaining <= 0 {
    false
  } else {
    let _slept = sleep_delay_seconds_second_carrier_projection(duration: second(count: 1))
    slice_is_quiet(polls_remaining: polls_remaining - 1)
  }
}

fn sigterm_ignoring_payload() -> List<String> {
  ["/bin/sh", "-c", "trap '' TERM; while true; do sleep 1; done"]
}

// A SURVIVOR THE UNIT'S OWN KILL CANNOT REACH: a second transient unit under the SLICE rather than
// under the first unit. `systemctl kill --kill-whom=all <unit>` signals that unit's control group and
// nothing else, so this process is still there afterwards -- which is the host fact
// ForceStopBoundExceeded names.
//
// THE CHILD IS A TRANSIENT SERVICE AND NOT A BACKGROUNDED SCOPE, AND THE FIRST CUT GOT THIS WRONG.
// It ran `systemd-run --scope ... &` and then `sleep 1`, which is a race against the claim: the stop
// arrived while the payload was still sleeping, systemd SIGTERMed the not-yet-created scope along
// with everything else in the unit, and the readback correctly found an EMPTY slice. The claim FAILED
// and the controller was right. `systemd-run` without `--scope` returns only once PID 1 has started
// the unit, so when the payload exits the survivor already exists -- the dependency is on systemd's
// own acknowledgement rather than on a sleep being long enough.
fn sibling_survivor_payload(scope_unit: String) -> List<String> {
  [
    "/bin/sh", "-c",
    join([
      "systemd-run --quiet --collect --unit=", scope_unit,
      " --property=Slice=", wet_slice as String, " /bin/sleep 600",
    ], ""),
  ]
}

fn wet_slice_cgroup_path() -> String {
  match systemd_slice_cgroup_path(mount_point: cgroup_v2_mount_point, slice: wet_slice) {
    SliceCgroupPath { path: p } => p as String
    SliceNameNotASlice { spelling: s } => s
  }
}

fn readback_is_populated(r: CgroupSubtreeReadback) -> Bool {
  match r {
    CgroupSubtreePopulated { pids: p, cgroups: _ } => (p |> count) > 0
    CgroupSubtreeEmpty => false
    CgroupSubtreeReadFailed { reason: _ } => false
  }
}

fn readback_is_read_failure(r: CgroupSubtreeReadback) -> Bool {
  match r {
    CgroupSubtreeReadFailed { reason: _ } => true
    CgroupSubtreeEmpty => false
    CgroupSubtreePopulated { pids: _, cgroups: _ } => false
  }
}

fn resource_is_absent_here(r: ResourceReadback) -> Bool {
  match r {
    ResourceAbsent => true
    ResourcePresent { detail: _ } => false
    ResourceUnreadable { reason: _ } => false
  }
}

fn readback_is_empty(r: CgroupSubtreeReadback) -> Bool {
  match r {
    CgroupSubtreeEmpty => true
    CgroupSubtreePopulated { pids: _, cgroups: _ } => false
    CgroupSubtreeReadFailed { reason: _ } => false
  }
}

// RED 1 -- A CHILD THAT IGNORES SIGTERM IS STOPPED BY FORCE, AND THE CONTROLLER SAYS SO.
//
// WHAT WOULD MAKE THIS GREEN WRONGLY, which is why the assertion is StoppedByForce and not "the
// cgroup ended up empty": `systemctl stop` escalates to SIGKILL on its own schedule and reports one
// success, so a controller built on it would report the same thing here as for a unit that exited on
// SIGTERM. StoppedGracefully is the arm this must NOT return, and it is asserted separately below so
// a future edit that weakens the positive still trips.
test fn a_sigterm_ignoring_child_is_stopped_by_force() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_payload(unit: "gunbc-wet-term.service" as NonEmptyStr, argv: sigterm_ignoring_payload()) {
    false
  } else {
    match stop_attempt(unit: "gunbc-wet-term.service" as NonEmptyStr, slice: wet_slice) {
      StoppedByForce => true
      StoppedGracefully => false
      StopFoundAlreadyQuiescent => false
      ForceStopBoundExceeded { survivors: _ } => false
      ForceNotAsked { reason: _ } => false
      ForceStopOutcomeUnobservable { reason: _ } => false
    }
  }
}

// RED 2 -- A PROCESS ONE LEVEL DOWN IS FOUND, AND A FLAT cgroup.procs READ WOULD MISS IT.
//
// THE SLICE'S OWN cgroup.procs IS EMPTY BY CONSTRUCTION in cgroup v2: an inner node with controllers
// enabled holds no processes, they all sit in leaf cgroups. So a readback that read the slice's
// cgroup.procs and nothing else would report EVERY cell empty, including one with a VMM running in
// it. This claim asserts the recursive readback finds a pid the flat read could not, and asserts the
// flat read is in fact empty, so the discrimination is established rather than assumed.
test fn a_process_in_a_child_cgroup_is_found_and_the_flat_read_is_empty() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_payload(unit: "gunbc-wet-child.service" as NonEmptyStr, argv: ["/bin/sleep", "600"]) {
    false
  } else {
    let flat = linux.CgroupV2.ReadInterfaceFile(
      file_path: cgroup_v2_child_path(parent: wet_slice_cgroup_path() as NonEmptyStr, child: "cgroup.procs" as NonEmptyStr),
    )
    readback_is_populated(r: observe_cgroup_subtree(slice: wet_slice))
      && flat.success
      && trim(s: flat.value) == ""
  }
}

// RED 3 -- THE ONE THAT DOES NOT EXIST, AND THIS BLOCK IS WHAT IS THERE INSTEAD OF IT.
//
// ForceStopBoundExceeded HAS NO WET PRODUCER ON THIS HOST AND THE ARM IS DECLARED UNEXECUTED. It
// means a task the KERNEL could not end. Its producers are uninterruptible sleep and, on cgroup v1,
// a frozen cgroup. D state needs a wedged device or a hung filesystem on a host running other
// people's CI, and manufacturing one is a worse defect than the one it would cover.
//
// THE FREEZER WAS OFFERED AS THE SAFE PRODUCER AND IT IS NOT ONE ON v2. A review (vivid-stag-809,
// relayed by sunny-ant-606) proposed freezing the cgroup, which is real on cgroup v1. cgroup v2
// deliberately reversed it: the admin guide states that unlike the v1 freezer, tasks in a frozen v2
// cgroup CAN be killed. Measured on srv1 rather than taken from the page -- freeze a slice holding a
// live sleep, confirm `frozen 1`, write cgroup.kill, and the slice reads `populated 0` three seconds
// later. So the claim written against that design failed, and it failed because its premise was
// wrong rather than because the controller was.
//
// AND A SECOND REASON IT CANNOT BE A CLAIM HERE TODAY, worth recording because it is a fact about
// this repository rather than about the kernel: Filesystem.Write returns success=false for
// `cgroup.freeze` while it writes `cgroup.kill` on the same host in the same run -- the force claim
// below is that write executing and working. So the freezer has no .dag writer, which is why this
// corpus carries no cgroup.freeze rows: modelling an interface nothing can drive would be dangling
// (DESIGN 3c). It returns when a consumer can reach it.
//
// WHAT COVERS THE ARM MEANWHILE: test.claim.runner.runner_microvm_lifecycle_witness_test supplies it
// and checks what the controller does with it -- that it refutes, that it names its pid, and that it
// is not confused with the unobservable arm. Nothing has produced it against a real kernel.

// RED 4 -- A CGROUP READ THAT FAILS IS UNOBSERVABLE, NEVER EMPTY.
//
// "could not read" is the one answer that must not release a cell, and the readback is built so the
// unreadable case cannot fall through to CgroupSubtreeEmpty. Both arms are asserted here, over two
// paths that a naive reader cannot tell apart: BOTH are directories that exist, and only one of them
// has a cgroup.events to read.
//
// THE CONDITION IS THE KERNEL'S OWN, NOT ONE THIS CLAIM MANUFACTURES. The cgroup v2 admin guide says
// cgroup.events "exists on non-root cgroups"; systemd names the root slice `-.slice`, which
// extdeps.systemd systemd_slice_cgroup_path resolves to the mount point itself. So a readback of
// `-.slice` finds a directory and then finds no cgroup.events, which is exactly the shape of a
// permissions or mount defect on a real cell. Measured on srv1: /sys/fs/cgroup/cgroup.events does not
// exist.
//
// WHY NOT chmod: the first cut of this claim made the test slice's own cgroup.events mode 000. That
// claim FAILED, and the failure was the claim's, not the readback's -- this file runs as root, and
// root bypasses the permission bits, so the file was still perfectly readable. A blinding that does
// not blind is a red that cannot go red, which is the decoration DESIGN section 4b warns about at the
// top rung; it is recorded here rather than quietly replaced.
test fn a_missing_cgroup_events_is_unobservable_and_never_empty() -> Bool
  uses net: Network
{
  readback_is_read_failure(r: observe_cgroup_subtree(slice: "-.slice" as NonEmptyStr))
}


// THE SHOW-PROPERTY PAIR, AND IT IS A DISCRIMINATOR RATHER THAN TWO READINGS.
//
// systemd.Systemctl.ShowProperty takes a SystemdUnitProperty and interpolates it into
// `--property={property}`. extdeps.systemd carries systemd_unit_property_wire precisely because a
// variant's NAME and its wire spelling are not the same string -- ActiveState happens to be both,
// EnvironmentProperty is spelled `Environment` on the wire -- so if the transport renders the
// VARIANT name, every property whose two spellings differ reads EMPTY with exit 0. systemctl does
// not refuse an unknown property; it prints nothing and succeeds, which makes this a silent empty
// reading rather than a failure. Measured at the shell on srv1:
// `systemctl show <unit> --property=InvocationID --value` prints a value and
// `--property=InvocationIDProperty --value` prints nothing, exit 0.
//
// THE TWO CLAIMS TOGETHER SAY WHICH IT IS. If both pass, the operation renders the wire spelling and
// gunbc.runner_microvm_lifecycle_realize observe_unit_attempt_invocation is sound -- Environment is
// spelled EnvironmentProperty as a variant. If the ActiveState one passes and the Environment one
// fails, the operation renders the variant name and every consumer that names a property whose two
// spellings differ is reading an empty string as a fact.
test fn show_property_reads_a_units_active_state() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_payload(unit: "gunbc-wet-show.service" as NonEmptyStr, argv: ["/bin/sleep", "300"]) {
    false
  } else {
    unit_property_text(unit: "gunbc-wet-show.service" as NonEmptyStr, property: ActiveState) == "active"
  }
}

test fn show_property_reads_a_units_environment() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_with_invocation(unit: "gunbc-wet-show-inv.service" as NonEmptyStr, invocation: "probe-inv", sleep_for: "301") {
    false
  } else {
    invocation_text(reading: observe_unit_attempt_invocation(unit: "gunbc-wet-show-inv.service" as NonEmptyStr)) == "probe-inv"
  }
}

fn unit_property_text(unit: NonEmptyStr, property: SystemdUnitProperty) -> String
  uses net: Network
{
  let shown = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire_word(property: property))
  if shown.success == false { "" } else { trim(s: shown.value) }
}

// RED 5 -- THE INVOCATION ID THE TEARDOWN COMPARES IS READ OFF THE UNIT, AND IT TRACKS THE
// INCARNATION.
//
// THIS CLAIM REPLACED ONE THAT WAS ABOUT THE WRONG IDENTIFIER. It used to assert that systemd mints
// a fresh InvocationID per start -- true, and irrelevant: the teardown join compares the ATTEMPT's
// invocation id, which the store records before the unit exists. A review (zesty-pike-444, relayed
// by sunny-ant-606) found that the controller was filling the observed side with systemd's id, so
// the join would have refused every teardown. The controller now carries the attempt's id into the
// unit's Environment and reads it back out, and this is the claim that says the readback is an
// OBSERVATION OF THE UNIT rather than a copy of the request.
//
// WHAT IT DISCRIMINATES: one unit NAME, two incarnations carrying different attempt ids, and the
// readback returns each unit's OWN id. A controller that echoed the request would return whatever it
// was asked about and pass a weaker claim; a controller reading systemd's InvocationID would return
// a 32-hex string matching neither.
//
// THE TWO STARTS DIFFER IN THEIR ARGUMENTS, AND THAT IS A SUBSTRATE OBLIGATION. This is a pure
// dependency graph: two calls with identical arguments are ONE node, so a claim that asked for the
// same start twice would get one start and compare a value against itself. Here the ids differ,
// which is also what the claim is about.
test fn the_unit_reports_the_attempt_invocation_id_it_was_started_with() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_with_invocation(unit: incarnation_unit(), invocation: "attempt-inv-one", sleep_for: "600") {
    false
  } else {
    let first = invocation_text(reading: observe_unit_attempt_invocation(unit: incarnation_unit()))
    if first != "attempt-inv-one" {
      false
    } else if !stop_incarnation_unit(after: first) {
      false
    } else if !start_with_invocation(unit: incarnation_unit(), invocation: "attempt-inv-two", sleep_for: "601") {
      false
    } else {
      invocation_text(reading: observe_unit_attempt_invocation(unit: incarnation_unit())) == "attempt-inv-two"
    }
  }
}

// THE READING IS UNWRAPPED HERE AND NOWHERE ELSE, and an unread one renders as the empty string --
// which no attempt id can equal, so a claim below cannot pass on a reading that was never taken. The
// UNREAD arm is asserted on its own in the claim beneath these.
fn invocation_text(reading: UnitInvocationReading) -> String {
  match reading {
    UnitInvocationRead { invocation_id: v } => v as String
    UnitInvocationUnread { reason: _ } => ""
  }
}

// A UNIT THAT CARRIES NO ATTEMPT ASSIGNMENT READS AS UNREAD, NOT AS A VALUE. This is the wet half of
// review 69057's finding: the producer used to return "" for exactly this case and the caller crossed
// it into a NonEmptyStr, which -- measured on this host -- SILENTLY ADMITS, so a NonEmptyStr held the
// empty string. The claim asserts the arm rather than the string, because a producer that returned
// UnitInvocationRead { invocation_id: "" } would render identically through invocation_text above.
test fn a_unit_with_no_attempt_assignment_reads_as_unread() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_payload(unit: "gunbc-wet-noenv.service" as NonEmptyStr, argv: ["/bin/sleep", "302"]) {
    false
  } else {
    match observe_unit_attempt_invocation(unit: "gunbc-wet-noenv.service" as NonEmptyStr) {
      UnitInvocationUnread { reason: r } => (r as String) != ""
      UnitInvocationRead { invocation_id: _ } => false
    }
  }
}

fn incarnation_unit() -> NonEmptyStr {
  "gunbc-wet-incarnation.service" as NonEmptyStr
}

// THE UNIT IS STARTED THE WAY THE CONTROLLER STARTS ONE: retained, with the attempt's invocation id
// as an Environment property. A claim that started it with --collect would read an empty Environment
// back for a unit that had exited, which is the case the retained form exists for.
fn start_with_invocation(unit: NonEmptyStr, invocation: String, sleep_for: String) -> Bool
  uses net: Network
{
  systemd.SystemdRun.RunTransientRetained(
    unit: unit,
    property_argv: systemd_run_property_argv(properties: [
      wet_slice_property(),
      attempt_invocation_env_setting(invocation_id: invocation as NonEmptyStr),
    ]),
    command_argv: ["/bin/sleep", sleep_for],
  ).success
}

// THE STOP TAKES THE FIRST READING AS AN ARGUMENT SO IT CANNOT BE HOISTED ABOVE IT. Order in this
// substrate is data dependence and nothing else.
// THE STOP DOES NOT REQUIRE THE RESET TO SUCCEED, and the first cut did, which made the claim fail
// for a reason that was not about it: `systemctl stop` on a retained unit that has exited already
// unloads it, so the reset that follows reports "not loaded" -- the state the reset was for, reached
// by the stop. What this needs is that the unit is gone, and Stop establishes that.
fn stop_incarnation_unit(after: String) -> Bool
  uses net: Network
{
  after != "" && systemd.Systemctl.Stop(unit: incarnation_unit()).success
}

// RED 6 -- A JOB THAT EXITS ZERO CAN LEAVE THE CELL'S SUBTREE POPULATED.
//
// The unit's own command exits 0 and the unit is gone; a process it started outside its control group
// is still running in the cell's slice afterwards. That is the case product.fabric.sanitation exists
// for -- the exit status is an input to sanitation and never its verdict -- and it is the half only a
// host can establish. What the hermetic witness already establishes, and this deliberately does not
// repeat, is what settle_teardown does with a populated readback.
//
// THIS CLAIM CHANGED WITH THE FORCE REPAIR AND IS WEAKER THAN ITS FIRST CUT, WHICH IS CORRECT. It
// used to assert that the survivor was still there AFTER the stop, which only held because the force
// could not reach a sibling cgroup. The repaired force ends it, so the surviving fact is the one
// before teardown: a successful job CAN leave the cell dirty, and the readback sees it.
test fn a_successful_job_can_leave_the_cell_subtree_populated() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else if !start_payload(unit: "gunbc-wet-background.service" as NonEmptyStr, argv: sibling_survivor_payload(scope_unit: "gunbc-wet-background-child")) {
    false
  } else {
    readback_is_populated(r: observe_cgroup_subtree(slice: wet_slice))
  }
}

// AND THE OTHER HALF OF THE REPAIR: THE CELL-WIDE FORCE ENDS THAT SURVIVOR. This is the claim the
// force repair owes, and it is the exact inverse of the one above -- same payload, same sibling
// cgroup, and the stop now reaches it. Before the repair this would have read
// ForceStopBoundExceeded; a regression to a unit-scoped kill reds it.
test fn the_cell_wide_force_ends_a_survivor_in_a_sibling_cgroup() -> Bool
  uses net: Network, fs: Filesystem
{
  if !clear_slice() {
    false
  } else if !start_payload(unit: "gunbc-wet-reach.service" as NonEmptyStr, argv: sibling_survivor_payload(scope_unit: "gunbc-wet-reach-child")) {
    false
  } else if !readback_is_populated(r: observe_cgroup_subtree(slice: wet_slice)) {
    false
  } else {
    match stop_attempt(unit: "gunbc-wet-reach.service" as NonEmptyStr, slice: wet_slice) {
      StoppedByForce => readback_is_empty(r: observe_cgroup_subtree(slice: wet_slice))
      StoppedGracefully => false
      StopFoundAlreadyQuiescent => false
      ForceStopBoundExceeded { survivors: _ } => false
      ForceNotAsked { reason: _ } => false
      ForceStopOutcomeUnobservable { reason: _ } => false
    }
  }
}

// THE POSITIVE CONTROL. Without it every red above is satisfied by a readback that can only ever say
// "not empty", and the arm that matters most in production -- a cell that IS clean returning to
// supply -- would be established by nothing. A slice with nothing under it reads EMPTY, and the
// attempt paths that were never created read ABSENT.
test fn a_clean_slice_reads_empty_and_absent_paths_read_absent() -> Bool
  uses net: Network
{
  if !clear_slice() {
    false
  } else {
    readback_is_empty(r: observe_cgroup_subtree(slice: wet_slice))
      && resource_is_absent_here(r: observe_resource_absence(path: "/var/lib/gunbc/no-such-attempt-directory"))
  }
}
