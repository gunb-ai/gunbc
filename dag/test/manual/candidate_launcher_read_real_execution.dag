module test.manual.candidate_launcher_read_real_execution

// WET controls for the CI-side event-log read and the surface identity it renders (manual/ — these are the ONLY
// controls that execute the real carrier read; they are run by hand, NOT by CI: the CI lane is tests/ and no
// witness lives there, and the claim lane mocks git, so neither can prove the launcher read works).
//
// The hermetic witnesses in dag/test/claim/live_deploy/candidate_surface_roster_refusal_witness.dag establish the
// LOGIC (a refused read refuses the candidate, never a fabricated surface). They cannot establish that the CI
// launcher read OPENS at all, because the carrier read is effectful git — which the hermetic lane only offers via
// its mock. These controls close exactly that gap. They build a real origin, real runner clones and real events,
// then drive the launcher read through the real entry point `roadmap_events_read_all` under the REAL
// roadmap_event_carrier_ci_layout, so they cannot stay green if that layout or its lifecycle is reverted.
//
// Discriminating controls (all must PASS):
//   1. the real launcher read runs TWICE against one checkout with origin unchanged, renders the SAME non-empty
//      roster each time, closes each snapshot, and leaves NO runner worktree registration behind. Reverting the
//      layout to a persistent branch-attached anchor turns this red (a registration is left).
//   2. the OLD branch-attached lifecycle is RED: two reads with `git fetch origin roadmap-events:roadmap-events`
//      collide on the second read, and the corrected ref assertion (exit status, not suppressed stdout) reports
//      the branch PRESENT where control 1 reports it ABSENT.
//   3. two INDEPENDENT launcher reads of the same origin render the same non-empty roster — two reads, not one
//      bundle handed to a fold.
//   4. the corrected ref assertion DISCRIMINATES: on the real scoped read the branch ref is ABSENT, and after the
//      prohibited `branch:branch` fetch operand the very same assertion reports it PRESENT. Absence must be
//      established, never assumed from a suppressed `--quiet` failure.
//   5. a worktree add that FAILS AFTER registering (a post-checkout hook exits non-zero) is CLEANED UP: the read
//      refuses at the snapshot step, the close is a real Closed (the close verified registration and directory are
//      gone), and the runner holds no registration. This is the leak the recursive-removal-only close used to leave.
//   6. `roadmap_event_scratch_dir_presence` DISTINGUISHES an existing-but-UNREADABLE scratch (folds the parent
//      listing → Present), proving the premise first (mode 000 + a child listing that really fails; SKIP if root).
//   7. the REAL scoped reader under a sabotaged add (post-checkout hook locks + moves + symlinks after registering)
//      reports a LEAK, never Closed — the close verifies the CARRIED canonical identity, not a symlink spelling.
//   8. the PRE-ADD identity-unestablishable route, with an injected failing realpath and a scratch that SURVIVES
//      removal, reports a directory leak — never a silent SnapshotNotOpened (the pre-fix unchecked `rm`).
//
// The event files are the committed roadmap-event/v3 shape (fixtures/roadmap_authority), so the reader decodes
// them exactly as it decodes the service's own log.

import std.types { String, Bool, Int, List, FilePath }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.algebra { trim, string_contains }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap.roadmap_event_carrier {
  RoadmapEventCarrierRead, CarrierReadAttached, CarrierReadScopedDetached,
  roadmap_event_carrier_ci_layout, roadmap_event_carrier_layout,
  roadmap_events_read_all, carrier_exec_program, RoadmapAllEventsRead, AllEventsRead, AllEventsReadRefused,
  CarrierExec, CarrierExecOk, CarrierExecFailed, CarrierSnapshotClose, SnapshotClosed, SnapshotNotOpened, SnapshotCloseFailed, SnapshotCloseVerificationFailed,
  roadmap_event_scratch_dir_presence, roadmap_event_scratch_close, RoadmapEventCarrierScopedLayout, CloseVerifyRegistrationPersists, CloseVerifyDirectoryPersists, CloseVerifyDirectoryPresenceUnobservable, carrier_close_verification_reason,
}
import extdeps.filesystem.filesystem_io { FilesystemEntryPresence, FilesystemEntryAbsent, FilesystemEntryListed, FilesystemEntryPresenceIndeterminate, FilesystemEntrySubjectRefused }
import gunbc.roadmap.roadmap_event_log { RoadmapEventEnvelope }

type LauncherControlled {
  ok: Bool
  base: String
  runner: String
  note: String
}

// A read that returned at least one decoded envelope (as opposed to a refusal).
fn launcher_is_rendered(read: RoadmapAllEventsRead) -> Bool {
  match read {
    AllEventsRead { envelopes: envs } => !(length(values: envs) == 0)
    AllEventsReadRefused { step: _, reason: _ } => false
  }
}

// The refusal step of a refused read, or "" when it rendered.
fn launcher_refusal_step(read: RoadmapAllEventsRead) -> String {
  match read {
    AllEventsRead { envelopes: _ } => ""
    AllEventsReadRefused { step: step, reason: _ } => step
  }
}

// Did the read's close report a fully-established Closed (registration and directory verified gone), as opposed to
// a not-opened, a failed removal, or a close whose cleanliness could NOT be established? A scoped read that created
// a worktree — even one whose add later failed — must report Closed after cleanup; an UNVERIFIABLE close (missing
// directory, unreadable, still-registered) is NOT closed and must not pass a control.
fn launcher_close_is_closed(close: CarrierSnapshotClose) -> Bool {
  match close {
    SnapshotClosed => true
    SnapshotNotOpened => false
    SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => false
    SnapshotCloseVerificationFailed { worktree: _, verification: _ } => false
  }
}

// A raw git run in a workdir, carrying the EXIT STATUS (CarrierExecFailed carries exit_code).
fn launcher_git(workdir: String, args: List<String>) -> CarrierExec {
  carrier_exec_program(program: "git", workdir: workdir, args: concat(["-c", "init.defaultBranch=main"], args))
}

// stdout of a successful git run, "" when it failed. Only for outputs compared for CONTENT.
fn launcher_git_stdout(workdir: String, args: List<String>) -> String {
  match launcher_git(workdir: workdir, args: args) {
    CarrierExecOk { stdout: out } => out
    CarrierExecFailed { exit_code: _, stderr: _ } => ""
  }
}

// TYPED presence of a ref, established from the git EXIT STATUS, never from a suppressed stdout. `git show-ref <ref>`
// (WITHOUT --verify, which fatals 128 on a missing fully-qualified ref) exits 0 when the ref EXISTS, 1 when it is
// ABSENT, and >=2 on a real failure (not-a-repo, unreadable). So absence is ESTABLISHED by exit 1, distinguished
// from a broken repo (>=2) — the superseded `show-ref --verify --quiet … == ""` passed for both present and absent.
type LauncherRefPresence = RefPresent | RefAbsent | RefUnknown { exit_code: Int }

fn launcher_ref_presence(workdir: String, ref: String) -> LauncherRefPresence {
  match launcher_git(workdir: workdir, args: ["show-ref", ref]) {
    CarrierExecOk { stdout: _ } => RefPresent
    CarrierExecFailed { exit_code, stderr: _ } => if exit_code == 1 { RefAbsent } else { RefUnknown { exit_code: exit_code } }
  }
}

// A human tag for the presence, for the observed: lines.
fn launcher_ref_presence_tag(presence: LauncherRefPresence) -> String {
  match presence {
    RefPresent => "present"
    RefAbsent => "absent"
    RefUnknown { exit_code: c } => join(["unknown(exit ", to_string(value: c), ")"], "")
  }
}

// THE LAUNCHER LAYOUT, built through the REAL roadmap_event_carrier_ci_layout (so reverting that layout turns the
// control red), wrapped in the ScopedDetached arm of the read boundary it is read through.
fn launcher_scoped_layout_for(runner: String) -> RoadmapEventCarrierScopedLayout {
  let service_layout = roadmap_event_carrier_layout(repo_root: runner as FilePath, instance_root: runner, git_program: "git", directory_program: "install")
  roadmap_event_carrier_ci_layout(checkout_root: runner as FilePath, instance_layout: service_layout)
}

fn launcher_layout_for(runner: String) -> RoadmapEventCarrierRead {
  CarrierReadScopedDetached { scoped: launcher_scoped_layout_for(runner: runner) }
}

// Same scoped layout but with an INJECTED realpath program, so a control can reach the pre-add
// identity-unestablishable arm (which is otherwise unreachable because shell.Mktemp.Dir is a fixed host builtin
// whose /tmp scratch realpath always resolves). Everything else is identical to the real launcher layout, so the
// real scoped reader and close still run. remote/git/directory match ci_layout.
fn launcher_layout_for_realpath(runner: String, rp: String) -> RoadmapEventCarrierRead {
  CarrierReadScopedDetached {
    scoped: RoadmapEventCarrierScopedLayout {
      repo_root: runner as FilePath,
      git_program: "git",
      directory_program: "install",
      realpath_program: rp,
      remote: "origin",
    }
  }
}

// Count runner worktree registrations by parsing `git worktree list --porcelain -z` NUL records, not by substring
// counting and not by newline splitting: the header record is always present, and a path containing a NEWLINE must
// not be split into two fields and missed (the same reason the close parses -z). A record counts only when its path
// is not the runner checkout itself.
fn launcher_registry_count(runner: String) -> Int {
  let out = launcher_git_stdout(workdir: runner, args: ["worktree", "list", "--porcelain", "-z"])
  let paths = filter(split(s: out, delimiter: "\u{0}"), line => string_contains(s: line, pattern: "worktree "))
  let others = filter(paths, line => line != join(["worktree ", runner], ""))
  length(values: others)
}

// The roster tag set of a rendered read — the same fold the surface bundle uses — joined and sorted only by
// arrival order (stable, no sort primitive needed). Built DYNAMICALLY so it is a function of the fixture, not a
// literal a change could silently break.
fn launcher_roster_tag(read: RoadmapAllEventsRead) -> String {
  match read {
    AllEventsRead { envelopes: envs } => join(map(values: envs, e => join([e.event.node as String, "@", e.id as String], "")), delimiter: ",")
    AllEventsReadRefused { step: step, reason: _ } => join(["<refused:", step, ">"], "")
  }
}

// Build a controlled origin + runner clone with a roadmap-events branch carrying the committed events.
fn launcher_build_controlled(repo: String, base_name: String) -> LauncherControlled {
  let base = shell.Mktemp.Dir()
  if !base.success {
    LauncherControlled { ok: false, base: base.path, runner: "", note: "mktemp base failed" }
  } else {
    let origin = under(base.path, "origin.git")
    let seed = under(base.path, "seed")
    let runner = under(base.path, "runner")
    let create = launcher_git(workdir: base.path, args: ["init", "--bare", "-q", origin])
    let seed_init_ok = match launcher_git(workdir: base.path, args: ["init", "-q", seed]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    let seeded = seed_init_ok
      && Filesystem.Write(path: under(seed, "README"), content: "launcher seed\n").success
      && match launcher_git(workdir: seed, args: ["-c", "user.name=launcher-witness", "-c", "user.email=launcher@gunbc.test", "-c", "commit.gpgsign=false", "add", "-A"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["-c", "user.name=launcher-witness", "-c", "user.email=launcher@gunbc.test", "-c", "commit.gpgsign=false", "commit", "-q", "-m", "seed"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["remote", "add", "origin", origin]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["push", "-q", "origin", "main"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["checkout", "-q", "-b", "roadmap-events"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_exec(program: "cp", workdir: seed, args: ["-r", under(repo, "fixtures/roadmap_authority/events"), under(seed, "events")]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_exec(program: "mkdir", workdir: seed, args: ["-p", under(seed, "retired")]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["-c", "user.name=launcher-witness", "-c", "user.email=launcher@gunbc.test", "-c", "commit.gpgsign=false", "add", "-A"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["-c", "user.name=launcher-witness", "-c", "user.email=launcher@gunbc.test", "-c", "commit.gpgsign=false", "commit", "-q", "--allow-empty", "-m", "events"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      && match launcher_git(workdir: seed, args: ["push", "-q", "origin", "roadmap-events"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    if !seeded {
      // The base was created before the failure; remove it so a setup failure cannot leak a partial tree.
      let _ = shell.Remove.RecursiveForce(path: base.path)
      LauncherControlled { ok: false, base: base.path, runner: "", note: "seed build failed" }
    } else {
      let clone_ok = match launcher_git(workdir: base.path, args: ["clone", "-q", "--branch", "main", origin, runner]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
      if !clone_ok {
        let _ = shell.Remove.RecursiveForce(path: base.path)
        LauncherControlled { ok: false, base: base.path, runner: runner, note: "runner clone failed" }
      } else {
        LauncherControlled { ok: true, base: base.path, runner: runner, note: "ok" }
      }
    }
  }
}

// Prune the runner's dangling worktree registrations (a registration whose directory was recursively removed is
// "prunable"). The removals themselves are issued by each control (their dir set is statically known), so a control
// reports whether EVERY cleanup step succeeded — a leak cannot masquerade as a green control.
fn launcher_prune(runner: String) -> Bool {
  match launcher_git(workdir: runner, args: ["worktree", "prune"]) {
    CarrierExecOk { stdout: _ } => true
    CarrierExecFailed { exit_code: _, stderr: _ } => false
  }
}

// Run EVERY cleanup step and combine the results — never && -chain, which short-circuits: if prune returned
// false the base removal never ran and the whole controlled tree leaked. Each step runs, then the outcomes
// are AND-ed, so a failed prune still removes the base and the failure is still reported.
fn launcher_cleanup_all(runner: String, base: String) -> Bool {
  // Unlock every registration first (a control may have LOCKED one so `worktree remove`/`prune` refuse; unlocking
  // a non-locked worktree is a harmless error we ignore), THEN run every removal and combine -- never && -chain.
  let _ = launcher_unlock_all_registered(runner: runner)
  let pruned = launcher_prune(runner: runner)
  let removed = shell.Remove.RecursiveForce(path: base).success
  pruned && removed
}

// Unlock each registered worktree of the runner so a locked registration can be pruned. Paths come from
// `worktree list --porcelain -z` NUL records (a path with a newline is not split). Per-record unlock failures
// (already unlocked, or the main checkout) are ignored -- this is best-effort cleanup, not a verdict.
fn launcher_unlock_all_registered(runner: String) -> Bool {
  let out = launcher_git_stdout(workdir: runner, args: ["worktree", "list", "--porcelain", "-z"])
  // `map`, not `any`: `any` short-circuits on the first true, and since every callback returns true it would stop
  // after the FIRST record and leave the rest locked. `map` visits every record, so every registration is unlocked.
  let _ = map(values: split(s: out, delimiter: "\u{0}"), rec =>
    if string_contains(s: rec, pattern: "worktree ") {
      match launcher_git(workdir: runner, args: ["worktree", "unlock", substring(s: rec, start: 9, end: string_length(s: rec))]) {
        CarrierExecOk { stdout: _ } => true
        CarrierExecFailed { exit_code: _, stderr: _ } => true
      }
    } else {
      true
    }
  )
  true
}

// CONTROL 1 — the real launcher read, TWICE, one checkout, origin unchanged.
fn launcher_control_repeats_and_cleans_up(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-repeat")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    let layout = launcher_layout_for(runner: c.runner)
    let first = roadmap_events_read_all(read: layout)
    let second = roadmap_events_read_all(read: layout)
    let scratch = shell.Mktemp.Dir()
    let scratch_used = scratch.success
    let first_tag = launcher_roster_tag(read: first.result)
    let second_tag = launcher_roster_tag(read: second.result)
    let registry_after = launcher_registry_count(runner: c.runner)
    let branch_state = launcher_ref_presence(workdir: c.runner, ref: "refs/heads/roadmap-events")
    let pruned = launcher_prune(runner: c.runner)
    let base_removed = shell.Remove.RecursiveForce(path: c.base).success
    let scratch_removed = shell.Remove.RecursiveForce(path: scratch.path).success
    let cleaned = pruned && base_removed && scratch_removed
    // BOTH reads must be RENDERED, not merely equal. Two identical REFUSALS (both <refused:fetch>, both with a
    // Closed close after a post-add failure) share a tag and would satisfy a bare tag-equality check while proving
    // nothing -- that is the gap this control existed to close. launcher_is_rendered admits only a rendered roster
    // whose close was verified clean, for both the first and the second read.
    let ok = launcher_is_rendered(read: first.result) && launcher_is_rendered(read: second.result) && launcher_close_is_closed(close: first.close) && launcher_close_is_closed(close: second.close) && first_tag != "" && second_tag == first_tag && registry_after == 0 && branch_state == RefAbsent && scratch_used && cleaned
    if ok { "PASS" } else { control_result(ok: false, note: join(["first:", first_tag, " second:", second_tag, " registry:", to_string(value: registry_after), " branch:", launcher_ref_presence_tag(presence: branch_state), " close1_closed:", to_string(value: if launcher_close_is_closed(close: first.close) { 1 } else { 0 }), " close2_closed:", to_string(value: if launcher_close_is_closed(close: second.close) { 1 } else { 0 }), " scratch_ok:", to_string(value: if scratch_used { 1 } else { 0 }), " cleaned:", to_string(value: if cleaned { 1 } else { 0 })], "") ) }
  }
}

// CONTROL 2 — the OLD branch-attached lifecycle is RED. The red-before case the whole change removes. Also
// establishes the branch is genuinely ATTACHED under the old lifecycle (RefPresent) — the corrected assertion.
fn launcher_control_branch_attached_lifecycle_collides(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-branchattach")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    let mk1 = shell.Mktemp.Dir()
    let mk2 = shell.Mktemp.Dir()
    if !mk1.success || !mk2.success {
      let _ = shell.Remove.RecursiveForce(path: c.base)
      let _ = shell.Remove.RecursiveForce(path: mk1.path)
      let _ = shell.Remove.RecursiveForce(path: mk2.path)
      control_result(ok: false, note: "scratch allocation failed")
    } else {
      let attached1 = roadmap_event_carrier_layout(repo_root: c.runner as FilePath, instance_root: mk1.path, git_program: "git", directory_program: "install")
      let first = roadmap_events_read_all(read: CarrierReadAttached { attached: attached1 })
      let attached2 = roadmap_event_carrier_layout(repo_root: c.runner as FilePath, instance_root: mk2.path, git_program: "git", directory_program: "install")
      let second = roadmap_events_read_all(read: CarrierReadAttached { attached: attached2 })
      let first_read = launcher_is_rendered(read: first.result)
      let second_read = launcher_is_rendered(read: second.result)
      let registry_now = launcher_registry_count(runner: c.runner)
      // Under the branch-attached lifecycle the named branch is ATTACHED in the runner — the corrected assertion
      // must report it PRESENT here, where control 1 reported it ABSENT.
      let branch_state = launcher_ref_presence(workdir: c.runner, ref: "refs/heads/roadmap-events")
      let removed_mk1 = shell.Remove.RecursiveForce(path: mk1.path).success
      let removed_mk2 = shell.Remove.RecursiveForce(path: mk2.path).success
      let cleaned_all = launcher_cleanup_all(runner: c.runner, base: c.base)
      let cleaned = removed_mk1 && removed_mk2 && cleaned_all
      let ok = first_read && !second_read && registry_now > 0 && branch_state == RefPresent && cleaned
      if ok { "PASS" } else { control_result(ok: false, note: join(["first_read:", to_string(value: if first_read { 1 } else { 0 }), " second_read:", to_string(value: if second_read { 1 } else { 0 }), " registry:", to_string(value: registry_now), " branch:", launcher_ref_presence_tag(presence: branch_state), " cleaned:", to_string(value: if cleaned { 1 } else { 0 })], "") ) }
    }
  }
}

// CONTROL 3 — TWO INDEPENDENT launcher reads of one origin render the SAME non-empty roster.
fn launcher_control_two_readers_agree(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-two")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    let runner_b = under(c.base, "runner-b")
    let clone_ok = match launcher_git(workdir: c.base, args: ["clone", "-q", "--branch", "roadmap-events", under(c.base, "origin.git"), runner_b]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    if !clone_ok {
      let _ = shell.Remove.RecursiveForce(path: c.base)
      control_result(ok: false, note: "second clone failed")
    } else {
      let a = roadmap_events_read_all(read: launcher_layout_for(runner: c.runner))
      let b = roadmap_events_read_all(read: launcher_layout_for(runner: runner_b))
      let ta = launcher_roster_tag(read: a.result)
      let tb = launcher_roster_tag(read: b.result)
      let cleaned = launcher_cleanup_all(runner: c.runner, base: c.base)
      let ok = ta != "" && launcher_is_rendered(read: a.result) && ta == tb && cleaned
      if ok { "PASS" } else { control_result(ok: false, note: join(["readerA:", ta, " readerB:", tb, " cleaned:", to_string(value: if cleaned { 1 } else { 0 })], "") ) }
    }
  }
}

// CONTROL 4 — the corrected assertion DISCRIMINATES. On the real scoped read the branch is ABSENT (the read never
// maps branch:branch); after running the PROHIBITED fetch operand the very same assertion reports it PRESENT. So
// control 1's ABSENT is a real judgement, not stdout being suppressed.
fn launcher_control_ref_assertion_discriminates(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-assert")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    // The real scoped read leaves the named branch absent.
    let scoped = roadmap_events_read_all(read: launcher_layout_for(runner: c.runner))
    let after_scoped = launcher_ref_presence(workdir: c.runner, ref: "refs/heads/roadmap-events")
    // Now the prohibited operand: fetch that DOES map the branch. Same assertion must catch it.
    let forced = match launcher_git(workdir: c.runner, args: ["fetch", "-q", "origin", "roadmap-events:roadmap-events"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    let after_forced = launcher_ref_presence(workdir: c.runner, ref: "refs/heads/roadmap-events")
    let cleaned = launcher_cleanup_all(runner: c.runner, base: c.base)
    let scoped_read = launcher_is_rendered(read: scoped.result)
    let ok = scoped_read && after_scoped == RefAbsent && forced && after_forced == RefPresent && cleaned
    if ok { "PASS" } else { control_result(ok: false, note: join(["scoped_rendered:", to_string(value: if scoped_read { 1 } else { 0 }), " after_scoped:", launcher_ref_presence_tag(presence: after_scoped), " forced_ok:", to_string(value: if forced { 1 } else { 0 }), " after_forced:", launcher_ref_presence_tag(presence: after_forced), " cleaned:", to_string(value: if cleaned { 1 } else { 0 })], "") ) }
  }
}

// CONTROL 5 — a worktree add that FAILS AFTER REGISTERING (a post-checkout hook exits non-zero) is CLEANED UP.
// Reproduces the reviewer's leak: recursive removal alone left the registration behind. The scoped read's close
// runs `worktree remove` + `worktree prune` and VERIFIES the end state, so after this failed add the runner holds
// no registration and the close reports a real Closed (never SnapshotNotOpened for state that may exist).
fn launcher_control_failed_add_is_cleaned_up(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-failedadd")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    // Plant a post-checkout hook that always fails. git worktree add checks out HEAD, fires this hook, and
    // returns non-zero AFTER the worktree has been created and registered.
    let hook = under(c.runner, ".git/hooks/post-checkout")
    let planted = Filesystem.Write(path: hook, content: "#!/bin/sh\nexit 1\n").success
      && match carrier_exec_program(program: "chmod", workdir: c.runner, args: ["+x", hook]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    if !planted {
      let _ = shell.Remove.RecursiveForce(path: c.base)
      control_result(ok: false, note: "post-checkout hook not planted")
    } else {
      let read = roadmap_events_read_all(read: launcher_layout_for(runner: c.runner))
      let step = launcher_refusal_step(read: read.result)
      let registry_after = launcher_registry_count(runner: c.runner)
      let cleaned = launcher_cleanup_all(runner: c.runner, base: c.base)
      // The read must REFUSE at the snapshot step (the add failed), the close must report a real Closed (it
      // verified the registration AND the directory are gone — never SnapshotNotOpened for state that existed),
      // and the runner must hold no registration.
      let ok = step == "snapshot" && registry_after == 0 && cleaned && launcher_close_is_closed(close: read.close)
      if ok { "PASS" } else { control_result(ok: false, note: join(["step:", step, " registry_after:", to_string(value: registry_after), " close_closed:", to_string(value: if launcher_close_is_closed(close: read.close) { 1 } else { 0 }), " cleaned:", to_string(value: if cleaned { 1 } else { 0 })], "") ) }
    }
  }
}

// Did a raw program run succeed?
fn launcher_exec_ok(e: CarrierExec) -> Bool {
  match e { CarrierExecOk { stdout: _ } => true  CarrierExecFailed { exit_code: _, stderr: _ } => false }
}

// Is the presence observation a POSITIVE (established present) or an ESTABLISHED absence? An indeterminate or a
// refused subject is neither -- the close must not read either as closed, and neither satisfies these.
fn launcher_presence_present(p: FilesystemEntryPresence) -> Bool {
  match p {
    FilesystemEntryListed { directory: _, name: _ } => true
    FilesystemEntryAbsent(_) => false
    FilesystemEntryPresenceIndeterminate { cause: _ } => false
    FilesystemEntrySubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

fn launcher_presence_absent(p: FilesystemEntryPresence) -> Bool {
  match p {
    FilesystemEntryAbsent(_) => true
    FilesystemEntryListed { directory: _, name: _ } => false
    FilesystemEntryPresenceIndeterminate { cause: _ } => false
    FilesystemEntrySubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

// CONTROL 6 — the close's directory-presence observation separates PRESENT from ESTABLISHED-ABSENT and does NOT
// collapse on an UNREADABLE directory. The reviewer reproduced the false closure exactly here: the old
// roadmap_event_scratch_dir_present (Filesystem.List(...).success) read a directory that still EXISTED but could
// not be listed as absent, so the close minted SnapshotClosed on a lie. The new helper folds the PARENT listing
// (filesystem_entry_presence_of_path), so a present directory is Present whatever its own mode. This control plants
// an EMPTY scratch, makes it mode 000 -- which blocks the (unprivileged) owner from LISTING the directory itself,
// exactly what the old List.success tested -- and asserts the helper STILL says Present: RED against the List.success
// implementation. It then restores mode, removes it, and asserts established Absent. Mode is restored before the
// removal so the control is not flaky under a restrictive umask, and every removal result is combined, not chained.
fn launcher_control_dir_presence_distinguishes_unreadable() -> String {
  let base = shell.Mktemp.Dir()
  if !base.success {
    control_result(ok: false, note: "mktemp failed for dir-presence control")
  } else {
    let made = launcher_exec(program: "mkdir", workdir: base.path, args: ["-p", "roadmap-events"])
    if !launcher_exec_ok(e: made) {
      let _ = shell.Remove.RecursiveForce(path: base.path)
      control_result(ok: false, note: "mkdir scratch failed")
    } else {
      let scratch = under(base.path, "roadmap-events") as FilePath
      let present0 = launcher_presence_present(p: roadmap_event_scratch_dir_presence(path: scratch))
      let chmod000 = launcher_exec_ok(e: launcher_exec(program: "chmod", workdir: base.path, args: ["000", "roadmap-events"]))
      // PROVE THE PREMISE before relying on it: mode 000 must actually block the owner from LISTING the scratch.
      // A direct listing that still SUCCEEDS means the process is root (or the fs ignores mode), so the whole
      // "unreadable" scenario is void -- SKIP with a stated reason instead of asserting something we cannot set up.
      let child_listing = Filesystem.List(path: scratch)
      if !chmod000 {
        let _ = launcher_exec(program: "chmod", workdir: base.path, args: ["755", "roadmap-events"])
        let _ = shell.Remove.RecursiveForce(path: base.path)
        control_result(ok: false, note: "chmod 000 did not take (required for this control)")
      } else if child_listing.success {
        let _ = launcher_exec(program: "chmod", workdir: base.path, args: ["755", "roadmap-events"])
        let _ = shell.Remove.RecursiveForce(path: base.path)
        "SKIP(root: mode 000 does not block listing, cannot make the directory unreadable)"
      } else {
        // The premise holds (the child listing genuinely failed): the parent-folding helper must STILL say Present.
        let present_unreadable = launcher_presence_present(p: roadmap_event_scratch_dir_presence(path: scratch))
        let restore = launcher_exec_ok(e: launcher_exec(program: "chmod", workdir: base.path, args: ["755", "roadmap-events"]))
        let removed = shell.Remove.RecursiveForce(path: scratch).success
        let absent = launcher_presence_absent(p: roadmap_event_scratch_dir_presence(path: scratch))
        let base_removed = shell.Remove.RecursiveForce(path: base.path).success
        let ok = present0 && present_unreadable && restore && removed && absent && base_removed
        if ok { "PASS" } else { control_result(ok: false, note: join(["present0:", to_string(value: if present0 { 1 } else { 0 }), " present_unreadable:", to_string(value: if present_unreadable { 1 } else { 0 }), " restore:", to_string(value: if restore { 1 } else { 0 }), " removed:", to_string(value: if removed { 1 } else { 0 }), " absent:", to_string(value: if absent { 1 } else { 0 }), " base_removed:", to_string(value: if base_removed { 1 } else { 0 })], "") ) }
      }
    }
  }
}

// Short summary of a close standing, for control diagnostics.
fn launcher_close_tag(close: CarrierSnapshotClose) -> String {
  match close {
    SnapshotClosed => "closed"
    SnapshotNotOpened => "not-opened"
    SnapshotCloseFailed { worktree: _, exit_code, stderr: _ } => join(["close-failed:", to_string(value: exit_code)], "")
    SnapshotCloseVerificationFailed { worktree: _, verification } => join(["unverified:", carrier_close_verification_reason(verification: verification)], "")
  }
}

// CONTROL 7 — the REAL scoped reader + close under a sabotaged add. The post-checkout hook runs DURING
// `git worktree add`, AFTER git has registered the worktree: it LOCKS the worktree (so `worktree remove --force`
// and `prune` both refuse), MOVES the checked-out directory to a known path, SYMLINKS the vacated path to it, and
// fails the add. So the registration survives at the CANONICAL path while the directory is reached only via a
// symlink. The pre-fix verifier (realpath at CLOSE) canonicalized the symlink AFTER the sabotage, resolved it to
// the MOVED tree, compared the registration to the WRONG string, saw nothing, and minted a FALSE SnapshotClosed.
// The reader establishes the canonical identity BEFORE the add (before the hook runs), so its close compares against
// the true registration and MUST report a leak -- never Closed. GREEN only on the bind-identity-to-the-add design;
// RED on realpath-at-close. The read must also refuse at the snapshot step (the add failed).
fn launcher_control_real_reader_locked_moved_add_is_caught(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-leak")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    let moved = under(c.base, "hook-moved")
    let marker = under(c.base, "hook-marker")
    let hook = under(c.runner, ".git/hooks/post-checkout")
    // The hook writes the marker ONLY if BOTH the mv and the ln succeeded, so the control can PROVE the sabotage
    // actually happened rather than trusting `|| true` that would pass even when mv/ln silently failed.
    let body = join([
      "#!/bin/sh\n",
      "wt=\"$(pwd)\"\n",
      "git -C \"$wt\" worktree lock . >/dev/null 2>&1\n",
      "cd /\n",
      "if mv \"$wt\" \"", moved, "\" 2>/dev/null && ln -s \"", moved, "\" \"$wt\" 2>/dev/null; then printf ok > \"", marker, "\"; fi\n",
      "exit 1\n"
    ], "")
    let planted = Filesystem.Write(path: hook, content: body).success
      && match carrier_exec_program(program: "chmod", workdir: c.runner, args: ["+x", hook]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    if !planted {
      let _ = shell.Remove.RecursiveForce(path: c.base)
      control_result(ok: false, note: "post-checkout hook not planted")
    } else {
      let read = roadmap_events_read_all(read: launcher_layout_for(runner: c.runner))
      let step = launcher_refusal_step(read: read.result)
      let registry_after = launcher_registry_count(runner: c.runner)
      let not_closed = !launcher_close_is_closed(close: read.close)
      let sabotaged = launcher_exec_ok(e: launcher_exec(program: "test", workdir: c.base, args: ["-e", "hook-marker"]))
      // cleanup_all now unlocks every registration first, so the locked one is prunable and the base is removable.
      let cleaned = launcher_cleanup_all(runner: c.runner, base: c.base)
      let ok = step == "snapshot" && registry_after >= 1 && not_closed && sabotaged && cleaned
      if ok { "PASS" } else { control_result(ok: false, note: join(["step:", step, " registry_after:", to_string(value: registry_after), " not_closed:", to_string(value: if not_closed { 1 } else { 0 }), " sabotaged(mv+ln):", to_string(value: if sabotaged { 1 } else { 0 }), " cleaned:", to_string(value: if cleaned { 1 } else { 0 }), " close:", launcher_close_tag(close: read.close)], "") ) }
    }
  }
}

// CONTROL 8 — the PRE-ADD identity-failure route with a scratch that SURVIVES. shell.Mktemp.Dir is a fixed host
// builtin (its /tmp scratch always resolves to real realpath), so the identity-unestablishable arm is otherwise
// unreachable; we inject a realpath program (like git_program) that records the scratch path, plants an UNDELETABLE
// subtree (a 0500 subdir holding a file), then exits 1. The scoped reader therefore: mktemps, fails to establish
// the canonical identity, and enters the pre-add arm — which removes the scratch (rm FAILS on the undeletable
// child), then OBSERVES presence. The scratch survives, so a correct close reports a directory leak, never a silent
// SnapshotNotOpened. The pre-fix code returned `SnapshotNotOpened` unconditionally after an unchecked `rm`, so
// `is_reported_dir_failure` would be false and this control would be RED.
fn launcher_control_pre_add_identity_failure_reports_surviving_scratch(repo: String) -> String {
  let c = launcher_build_controlled(repo: repo, base_name: "launcher-preadd")
  if !c.ok {
    let _ = shell.Remove.RecursiveForce(path: c.base)
    control_result(ok: false, note: join(["controlled build failed: ", c.note], ""))
  } else {
    let recorder = under(c.base, "scratch-path")
    let fake = under(c.base, "fake-realpath")
    let body = join([
      "#!/bin/sh\n",
      "p=\"$3\"\n",
      "printf '%s' \"$p\" > \"", recorder, "\"\n",
      "mkdir -p \"$p/k\" 2>/dev/null\n",
      "touch \"$p/k/f\" 2>/dev/null\n",
      "chmod 500 \"$p/k\" 2>/dev/null\n",
      "chmod 500 \"$p\" 2>/dev/null\n",
      "exit 1\n"
    ], "")
    let planted = Filesystem.Write(path: fake, content: body).success
      && match carrier_exec_program(program: "chmod", workdir: c.base, args: ["+x", "fake-realpath"]) { CarrierExecOk { stdout: _ } => true CarrierExecFailed { exit_code: _, stderr: _ } => false }
    if !planted {
      let _ = shell.Remove.RecursiveForce(path: c.base)
      control_result(ok: false, note: "fake realpath not planted")
    } else {
      let read = roadmap_events_read_all(read: launcher_layout_for_realpath(runner: c.runner, rp: fake))
      let step = launcher_refusal_step(read: read.result)
      let reported = launcher_close_is_reported_dir_failure(close: read.close)
      let sp = launcher_cat(workdir: c.base, rel: "scratch-path")
      let survived = launcher_path_exists(path: sp)
      // restore perms on the planted undeletable subtree, then remove the surviving scratch and the base.
      let _ = launcher_exec(program: "chmod", workdir: "/", args: ["-R", "u+rwX", "--", sp])
      let _ = shell.Remove.RecursiveForce(path: sp as FilePath)
      let cleaned = launcher_cleanup_all(runner: c.runner, base: c.base)
      let ok = step == "identity" && reported && survived && cleaned
      if ok { "PASS" } else { control_result(ok: false, note: join(["step:", step, " reported:", to_string(value: if reported { 1 } else { 0 }), " survived:", to_string(value: if survived { 1 } else { 0 }), " cleaned:", to_string(value: if cleaned { 1 } else { 0 }), " close:", launcher_close_tag(close: read.close)], "") ) }
    }
  }
}

// The close reported a DIRECTORY-side leak (present or unobservable) -- proof the surviving scratch was reported,
// not swallowed as SnapshotNotOpened. A registration cause would be wrong here (no worktree was ever added).
fn launcher_close_is_reported_dir_failure(close: CarrierSnapshotClose) -> Bool {
  match close {
    SnapshotCloseVerificationFailed { worktree: _, verification: CloseVerifyDirectoryPersists } => true
    SnapshotCloseVerificationFailed { worktree: _, verification: CloseVerifyDirectoryPresenceUnobservable { reason: _ } } => true
    SnapshotClosed => false
    SnapshotNotOpened => false
    SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => false
    SnapshotCloseVerificationFailed { worktree: _, verification: _ } => false
  }
}

fn launcher_cat(workdir: String, rel: String) -> String {
  match carrier_exec_program(program: "cat", workdir: workdir, args: ["--", rel]) {
    CarrierExecOk { stdout: out } => out
    CarrierExecFailed { exit_code: _, stderr: _ } => ""
  }
}

fn launcher_path_exists(path: String) -> Bool {
  match carrier_exec_program(program: "test", workdir: "/", args: ["-e", path]) {
    CarrierExecOk { stdout: _ } => true
    CarrierExecFailed { exit_code: _, stderr: _ } => false
  }
}

// A raw program run in a workdir (git via launcher_git; cp/mkdir here), returning the typed CarrierExec so the
// exit status is available.
fn launcher_exec(program: String, workdir: String, args: List<String>) -> CarrierExec {
  carrier_exec_program(program: program, workdir: workdir, args: args)
}

fn control_result(ok: Bool, note: String) -> String {
  if ok { "PASS" } else { join(["FAIL: ", note], "") }
}

fn under(dir: String, rel: String) -> String { join([dir, "/", rel], "") }

fn candidate_launcher_read_real_execution(repo: String) -> ProcessExit {
  let one = launcher_control_repeats_and_cleans_up(repo: repo)
  let two = launcher_control_branch_attached_lifecycle_collides(repo: repo)
  let three = launcher_control_two_readers_agree(repo: repo)
  let four = launcher_control_ref_assertion_discriminates(repo: repo)
  let five = launcher_control_failed_add_is_cleaned_up(repo: repo)
  let six = launcher_control_dir_presence_distinguishes_unreadable()
  let seven = launcher_control_real_reader_locked_moved_add_is_caught(repo: repo)
  let eight = launcher_control_pre_add_identity_failure_reports_surviving_scratch(repo: repo)
  if one == "PASS" && two == "PASS" && three == "PASS" && four == "PASS" && five == "PASS" && six == "PASS" && seven == "PASS" && eight == "PASS" { ExitSuccess }
  else { exit_failure(reason: join(["launcher real-read controls failed\nobserved: 1:", one, " 2:", two, " 3:", three, " 4:", four, " 5:", five, " 6:", six, " 7:", seven, " 8:", eight, "\n(all eight must PASS)\n"], "")) }
}
