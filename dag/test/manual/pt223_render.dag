module test.manual.pt223_render

import std.types { String, List }
import gunbc.generated_artifact { GeneratedArtifact, artifact_path }
import gunbc.generated_artifact_registry { committed_generated_artifacts }
import gunbc.generated_artifact_emit { artifact_generate, ArtifactGenerated, ArtifactGenerationRefused }

// Scratch entry, never committed: renders EVERY committed generated artifact through the same
// producer the regen uses (gunbc.generated_artifact_emit.artifact_generate), so two trees' outputs
// can be compared byte for byte. proud-tern-223.
fn pt223_one(a: GeneratedArtifact) -> String {
  match artifact_generate(a: a) {
    ArtifactGenerated { content } => concat(concat(concat("=====PT223 ", artifact_path(a: a)), "\n"), content)
    ArtifactGenerationRefused { reason } => concat(concat(concat("=====PT223 ", artifact_path(a: a)), " REFUSED\n"), reason)
  }
}

fn pt223_render() -> String {
  fold(committed_generated_artifacts(), init: "", f: fn(acc, a) { concat(acc, pt223_one(a: a)) })
}
