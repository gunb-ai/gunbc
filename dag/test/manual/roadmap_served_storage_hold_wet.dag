module test.manual.roadmap_served_storage_hold_wet

import std.types { String, NonEmptyStr, Bool }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.shell
import extdeps.http.server { ServeWireResponse }
import gunbc.fabric_storage_file_store { fabric_storage_file_root, fabric_storage_file_root_ensure, FabricStorageRootReady }
import gunbc.fabric_storage_state_serve { fabric_storage_state_serve_over }
import gunbc.fabric_storage_protocol { text_response, fabric_storage_closure_bound_cap }
import gunbc.fabric_storage_client { FabricStorageServed, served_post, ServedAnswered, ServedFault }
import std.fabric_storage { FabricReplyUndecodable }
import gunbc.roadmap.roadmap_event_carrier { roadmap_event_carrier_layout, roadmap_event_snapshot_read, roadmap_event_append, RoadmapEventSnapshotObserved, EventAppended }
import test.claim.roadmap.roadmap_event_carrier_witness_test { roadmap_carrier_test_event }

fn served_storage_hold_check(endpoint: String, step: String) -> ProcessExit {
  if !starts_with(s: endpoint, prefix: "http://127.0.0.1:") { exit_failure(reason: "loopback fixture only") }
  else { let layout = roadmap_event_carrier_layout(store: FabricStorageServed { endpoint: endpoint as NonEmptyStr })
    let passed = if step == "empty" {
      match roadmap_event_snapshot_read(layout: layout) { RoadmapEventSnapshotObserved { snapshot } => count(snapshot.events) == 0 _ => false }
    } else if step == "append" {
      match roadmap_event_append(layout: layout, event: roadmap_carrier_test_event(note: "served hold repair")) { EventAppended { id: _ } => true _ => false }
    } else if step == "read" {
      match roadmap_event_snapshot_read(layout: layout) { RoadmapEventSnapshotObserved { snapshot } => count(snapshot.events) == 1 _ => false }
    } else if step == "above-cap" {
      match served_post(endpoint: endpoint as NonEmptyStr, operation: "closure", request: concat("roadmap-events-v1 ", to_string(fabric_storage_closure_bound_cap + 1))) {
        ServedFault { fault: FabricReplyUndecodable { detail: detail } } =>
          (detail as String) == "HTTP 400: fabric_storage/1 malformed request: closure bound out of range\n"
        _ => false
      }
    } else { false }
    if passed { ExitSuccess } else { exit_failure(reason: concat("served storage check failed: ", step)) }
  }
}
