module test.manual.git_upstream_model_execution

import extdeps.shell.exec { TransportScript }
import gunbc.output_policy { ExpectSuccess }
import test.claim.git_upstream_model_witness {
  git_r0_fixture_expected_readback_receipt,
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data git_r0_execution_receipt_note: String = "Offline wet T1 receipt for the bounded Git R0 fixture. The shell creates a fresh real SHA-1 repository, lets Git hash every object, builds the raw-path/mode tree, commits and annotated tag, materializes the index/worktree, checks fsck, advances the managed ref with exact-old-OID compare-and-swap, proves stale and nonexistent-object updates refuse, and reads every reported identity back through Git. The expected line comes from the pure fixture module; the script computes rather than embeds its object IDs. Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/manual/git_upstream_model_execution_test.dag --function witness_git_cli_fixture_hashes_projects_and_independently_reads_back."

fn git_r0_fixture_execution_script() -> TransportScript {
  join(
    [
      "set -euo pipefail",
      "fixture_tmp=$(mktemp -d)",
      "sha256_tmp=$(mktemp -d)",
      "cleanup() { if [ -n \"$\{fixture_tmp:-}\" ] && [ -d \"$fixture_tmp\" ]; then rm -rf -- \"$fixture_tmp\"; fi; if [ -n \"$\{sha256_tmp:-}\" ] && [ -d \"$sha256_tmp\" ]; then rm -rf -- \"$sha256_tmp\"; fi; }",
      "trap cleanup EXIT",
      "git -C \"$fixture_tmp\" init -q --object-format=sha1",
      "blob_regular=$(printf source | git -C \"$fixture_tmp\" hash-object -w --stdin)",
      "blob_exec=$(printf run | git -C \"$fixture_tmp\" hash-object -w --stdin)",
      "blob_link=$(printf readme | git -C \"$fixture_tmp\" hash-object -w --stdin)",
      "empty_tree=$(git -C \"$fixture_tmp\" mktree </dev/null)",
      "export GIT_AUTHOR_NAME='A. U. Thor' GIT_AUTHOR_EMAIL='author@example.invalid' GIT_AUTHOR_DATE='2000-01-01T00:00:00Z'",
      "export GIT_COMMITTER_NAME='A. U. Thor' GIT_COMMITTER_EMAIL='author@example.invalid' GIT_COMMITTER_DATE='2000-01-01T00:00:00Z'",
      "gitlink_commit=$(printf 'gitlink\\n' | git -C \"$fixture_tmp\" commit-tree \"$empty_tree\")",
      "printf '100644 blob %s\\t\\377.dag\\0' \"$blob_regular\" >\"$fixture_tmp/tree.in\"",
      "printf '120000 blob %s\\tlink\\0' \"$blob_link\" >>\"$fixture_tmp/tree.in\"",
      "printf '100755 blob %s\\trun\\0' \"$blob_exec\" >>\"$fixture_tmp/tree.in\"",
      "printf '040000 tree %s\\tsrc\\0' \"$empty_tree\" >>\"$fixture_tmp/tree.in\"",
      "printf '160000 commit %s\\tvendor\\0' \"$gitlink_commit\" >>\"$fixture_tmp/tree.in\"",
      "root_tree=$(git -C \"$fixture_tmp\" mktree -z <\"$fixture_tmp/tree.in\")",
      "parent_commit=$(printf 'parent\\n' | git -C \"$fixture_tmp\" commit-tree \"$root_tree\")",
      "next_commit=$(printf 'next\\n' | git -C \"$fixture_tmp\" commit-tree \"$root_tree\" -p \"$parent_commit\")",
      "tag_payload=$(printf 'object %s\\ntype commit\\ntag v0\\ntagger A. U. Thor <author@example.invalid> 946684800 +0000\\n\\nbounded annotated tag\\n' \"$parent_commit\")",
      "tag_oid=$(printf '%s' \"$tag_payload\" | git -C \"$fixture_tmp\" mktag)",
      "git -C \"$sha256_tmp\" init -q --bare --object-format=sha256",
      "sha256_blob=$(printf source | git --git-dir=\"$sha256_tmp\" hash-object -w --stdin)",
      "test \"$(git --git-dir=\"$sha256_tmp\" rev-parse --show-object-format)\" = sha256",
      "git -C \"$fixture_tmp\" update-ref refs/heads/main \"$parent_commit\"",
      "git -C \"$fixture_tmp\" symbolic-ref HEAD refs/heads/main",
      "git -C \"$fixture_tmp\" update-ref refs/tags/v0 \"$tag_oid\"",
      "git -C \"$fixture_tmp\" read-tree \"$root_tree\"",
      "git -C \"$fixture_tmp\" checkout-index -a -f",
      "test \"$(git -C \"$fixture_tmp\" ls-files --stage | wc -l)\" -eq 4",
      "test -L \"$fixture_tmp/link\"",
      "test \"$(readlink \"$fixture_tmp/link\")\" = readme",
      "test -x \"$fixture_tmp/run\"",
      "test \"$(git -C \"$fixture_tmp\" hash-object \"$fixture_tmp/run\")\" = \"$blob_exec\"",
      "test -d \"$fixture_tmp/vendor\"",
      "test -f \"$fixture_tmp/\"$'\\377.dag'",
      "git -C \"$fixture_tmp\" fsck --strict --no-dangling >/dev/null 2>&1",
      "git -C \"$fixture_tmp\" update-ref refs/heads/main \"$next_commit\" \"$parent_commit\"",
      "if git -C \"$fixture_tmp\" update-ref refs/heads/main \"$parent_commit\" \"$parent_commit\" >/dev/null 2>&1; then exit 91; fi",
      "if git -C \"$fixture_tmp\" update-ref refs/heads/nonexistent cccccccccccccccccccccccccccccccccccccccc >/dev/null 2>&1; then exit 92; fi",
      "main_readback=$(git -C \"$fixture_tmp\" rev-parse refs/heads/main)",
      "tag_type=$(git -C \"$fixture_tmp\" cat-file -t refs/tags/v0)",
      "modes=$(git -C \"$fixture_tmp\" ls-tree --format='%(objectmode)' \"$root_tree\" | paste -sd, -)",
      "printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|sha256=%s|modes=%s|main=%s|tag_type=%s\\n' \"$(git -C \"$fixture_tmp\" rev-parse --show-object-format)\" \"$blob_regular\" \"$blob_exec\" \"$blob_link\" \"$empty_tree\" \"$gitlink_commit\" \"$root_tree\" \"$parent_commit\" \"$next_commit\" \"$tag_oid\" \"$sha256_blob\" \"$modes\" \"$main_readback\" \"$tag_type\"",
    ],
    "\n",
  ) as TransportScript
}

test fn witness_git_cli_fixture_hashes_projects_and_independently_reads_back() -> Bool {
  let execution = shell.Exec.Run(
    script: git_r0_fixture_execution_script(),
    expect: ExpectSuccess,
  )
  execution.success
    && trim(s: execution.stdout) == git_r0_fixture_expected_readback_receipt()
}
