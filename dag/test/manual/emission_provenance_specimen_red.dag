module test.manual.emission_provenance_specimen_red

// DISCRIMINATING RED: `emission_combined_read_preserves_content_order_and_origin_multiplicity`
// is an unmarked `fn`, not a `test` decl. The required floor folds every prepared `.dag`
// source, including `dag/test/manual`, through floor_discovery_fold_source, so a `test`
// marker here is FloorDiscoveryRefused (TestMarkedDecl). The compiler defect at
// gunbc.recurring_failure_mode.match_bound_element_type_mask makes the
// element type arrive as Empty when a FreeMonoid<DeclarationRef> bound
// by a match-arm pattern is consumed inside a lambda, so this body does not
// compile and cannot be an enrolled floor row until gunbc#10625 lands.
//
// When that repair lands, mark this function `test` and move the file into
// dag/test/claim as an executing required-floor witness.

import std.content_hash { as_content_hash_structural, content_hash_atom }
import std.decl_ref { decl_ref, declaration_ref_eq, declaration_ref_display_key }
import std.occurrence_identity { OccurrenceId, OccurrenceMinted }
import std.types { NonEmptyStr, String }
import std.emission_provenance {
  EmissionAuthoredFragment, EmissionSourceComposition, EmissionUnobservedFragment,
  EmissionOriginsObserved, EmissionOriginsIncomplete,
  emission_contribution_read, emission_contribution_source, emission_contribution_origins
}

fn emission_combined_read_preserves_content_order_and_origin_multiplicity() -> Bool {
  let root = decl_ref(module_path: "fixture.runtime", decl_name: "root")
  let empty = decl_ref(module_path: "fixture.runtime", decl_name: "empty")
  let leaf = decl_ref(module_path: "fixture.runtime", decl_name: "leaf")
  let nested = decl_ref(module_path: "fixture.runtime", decl_name: "nested")
  let unknown = decl_ref(module_path: "fixture.runtime", decl_name: "unknown")
  let contribution = EmissionSourceComposition {
    origin: root,
    parts: [
      EmissionSourceComposition { origin: empty, parts: [] },
      EmissionAuthoredFragment { origin: leaf, source: "A" },
      EmissionSourceComposition {
        origin: nested,
        parts: [
          EmissionUnobservedFragment { producer: unknown, cause: "first" as NonEmptyStr, source: "B" },
          EmissionAuthoredFragment { origin: leaf, source: "C" }
        ]
      },
      EmissionUnobservedFragment { producer: unknown, cause: "second" as NonEmptyStr, source: "D" }
    ]
  }
  let result = emission_contribution_read(contribution: contribution)
  result.source == emission_contribution_source(contribution: contribution)
    && result.origins == emission_contribution_origins(contribution: contribution)
    && result.source == "ABCD" && match result.origins {
    EmissionOriginsIncomplete { observed, missing } =>
      (observed |> map(origin => declaration_ref_display_key(ref: origin)) |> join(separator: "|")) == "fixture.runtime::root|fixture.runtime::empty|fixture.runtime::leaf|fixture.runtime::nested|fixture.runtime::leaf"
        && declaration_ref_eq(a: missing.head.producer, b: unknown)
        && missing.head.cause == ("first" as NonEmptyStr)
        && (missing.tail |> count == 1)
        && (missing.tail |> all(gap => declaration_ref_eq(a: gap.producer, b: unknown)
          && gap.cause == ("second" as NonEmptyStr)))
    _ => false
  }
}
