module test.manual.mercurial_upstream_model_execution

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.gunbc
import gunbc.output_policy { ExpectSuccess }
import extdeps.mercurial {
  MercurialNodeIdentityObservation,
  MercurialChangesetNodeIdentity,
  MercurialNodeIdentityDecoded,
  mercurial_decode_node_identity,
}
import test.claim.mercurial_upstream_model_witness {
  mercurial_r0_fixture_expected_execution_receipt,
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data mercurial_r0_execution_receipt_note: String = "Offline wet T1 receipt for the bounded Mercurial R0 fixture. This is a runtime-present typed effect graph: shell.Mktemp/Mkdir/Test/Remove, Filesystem.Write, and individual gunbc.WitnessBin.Run argv invocations. No shell program is serialized. A real Mercurial CLI creates three changesets on two heads, observes portable node identities separately from clone-local revision numbers, reads a bookmark and local tag, checks public/draft/secret phases, copy metadata, manifest executable/symlink flags, repository requirements, and runs `hg verify`. Changeset identities are computed by Mercurial and checked as distinct 40-character upstream identities rather than embedded constants. Local recipe: put a real `hg` on PATH, then run claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/manual/mercurial_upstream_model_execution_test.dag --function witness_mercurial_cli_fixture_projects_and_independently_reads_back."

fn mercurial_wire_identity_decodes(text: String) -> Bool {
  match mercurial_decode_node_identity(
    observation: MercurialNodeIdentityObservation {
      role: MercurialChangesetNodeIdentity,
      text: text,
    },
  ) {
    MercurialNodeIdentityDecoded { node: _ } => true
    _ => false
  }
}

fn mercurial_r0_typed_execution_read_back() -> String {
  let fixture = shell.Mktemp.Dir()
  if !fixture.success {
    "fixture-mktemp-refused"
  } else {
    let src_dir = concat(fixture.path, "/src")
    let bin_dir = concat(fixture.path, "/bin")
    let source_path = concat(src_dir, "/main.dag")
    let link_path = concat(fixture.path, "/link")
    let run_path = concat(bin_dir, "/run")
    let requires_path = concat(fixture.path, "/.hg/requires")

    let initialized = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["init", "."],
      expect: ExpectSuccess,
    )
    let src_created = shell.Mkdir.Parents(path: src_dir)
    let bin_created = shell.Mkdir.Parents(path: bin_dir)
    let source_written = Filesystem.Write(path: source_path, content: "main")
    let link_created = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "/bin/ln",
      args: ["-s", "src/main.dag", "link"],
      expect: ExpectSuccess,
    )
    let root_added = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["add", "src/main.dag", "link"],
      expect: ExpectSuccess,
    )
    let root_committed = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: [
        "--config",
        "ui.username=author@example.invalid",
        "commit",
        "-d",
        "0 0",
        "-m",
        "root",
      ],
      expect: ExpectSuccess,
    )
    let c0 = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", ".", "-T", "\{node}"],
      expect: ExpectSuccess,
    )
    let root_published = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["phase", "--force", "--public", "-r", trim(s: c0.stdout)],
      expect: ExpectSuccess,
    )

    let copied = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["copy", "src/main.dag", "bin/run"],
      expect: ExpectSuccess,
    )
    let run_written = Filesystem.Write(path: run_path, content: "run")
    let run_executable = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "/bin/chmod",
      args: ["+x", "bin/run"],
      expect: ExpectSuccess,
    )
    let executable_recorded = shell.Test.IsExecutable(path: run_path)
    let left_committed = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: [
        "--config",
        "ui.username=author@example.invalid",
        "commit",
        "-d",
        "1 0",
        "-m",
        "left",
      ],
      expect: ExpectSuccess,
    )
    let c1 = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", ".", "-T", "\{node}"],
      expect: ExpectSuccess,
    )
    let bookmark_created = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["bookmark", "-r", trim(s: c1.stdout), "main"],
      expect: ExpectSuccess,
    )

    let root_updated = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["update", "-q", "-r", trim(s: c0.stdout)],
      expect: ExpectSuccess,
    )
    let source_changed = Filesystem.Write(path: source_path, content: "mainside")
    let right_committed = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: [
        "--config",
        "ui.username=author@example.invalid",
        "commit",
        "-d",
        "2 0",
        "-m",
        "right",
      ],
      expect: ExpectSuccess,
    )
    let c2 = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", ".", "-T", "\{node}"],
      expect: ExpectSuccess,
    )
    let right_secret = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["phase", "--force", "--secret", "-r", trim(s: c2.stdout)],
      expect: ExpectSuccess,
    )
    let local_tag_created = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["tag", "--local", "-r", trim(s: c2.stdout), "scratch"],
      expect: ExpectSuccess,
    )

    let local_revisions = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", "all()", "-T", "\{rev},"],
      expect: ExpectSuccess,
    )
    let heads = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["heads", "-T", "\{node}\n"],
      expect: ExpectSuccess,
    )
    let bookmark = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", "bookmark(main)", "-T", "\{node}"],
      expect: ExpectSuccess,
    )
    let local_tag = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", "tag(scratch)", "-T", "\{node}"],
      expect: ExpectSuccess,
    )
    let branches = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", "all()", "-T", "\{branch},"],
      expect: ExpectSuccess,
    )
    let phases = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", "all()", "-T", "\{phase},"],
      expect: ExpectSuccess,
    )
    let copy_metadata = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["log", "-r", trim(s: c1.stdout), "-T", "\{file_copies}"],
      expect: ExpectSuccess,
    )
    let manifest = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["manifest", "-v", "-r", trim(s: c1.stdout)],
      expect: ExpectSuccess,
    )
    let verified = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "hg",
      args: ["verify"],
      expect: ExpectSuccess,
    )
    let requires_present = shell.Test.IsNonEmpty(path: requires_path)
    let symlink_present = gunbc.WitnessBin.Run(
      workdir: fixture.path,
      bin_path: "/usr/bin/test",
      args: ["-L", link_path],
      expect: ExpectSuccess,
    )

    let cleaned = shell.Remove.RecursiveForce(path: fixture.path)

    let all_operations_succeeded = initialized.success
      && src_created.success
      && bin_created.success
      && source_written.success
      && link_created.success
      && root_added.success
      && root_committed.success
      && c0.success
      && root_published.success
      && copied.success
      && run_written.success
      && run_executable.success
      && executable_recorded.executable
      && left_committed.success
      && c1.success
      && bookmark_created.success
      && root_updated.success
      && source_changed.success
      && right_committed.success
      && c2.success
      && right_secret.success
      && local_tag_created.success
      && local_revisions.success
      && heads.success
      && bookmark.success
      && local_tag.success
      && branches.success
      && phases.success
      && copy_metadata.success
      && manifest.success
      && verified.success
      && requires_present.nonempty
      && symlink_present.success
      && cleaned.success

    let identities_grounded = mercurial_wire_identity_decodes(
      text: trim(s: c0.stdout),
    )
      && mercurial_wire_identity_decodes(text: trim(s: c1.stdout))
      && mercurial_wire_identity_decodes(text: trim(s: c2.stdout))
      && !(trim(s: c0.stdout) == trim(s: c1.stdout))
      && !(trim(s: c0.stdout) == trim(s: c2.stdout))
      && !(trim(s: c1.stdout) == trim(s: c2.stdout))

    let topology_grounded = trim(s: local_revisions.stdout) == "0,1,2,"
      && count(split(s: trim(s: heads.stdout), delimiter: "\n")) == 2
      && trim(s: bookmark.stdout) == trim(s: c1.stdout)
      && trim(s: local_tag.stdout) == trim(s: c2.stdout)
      && trim(s: branches.stdout) == "default,default,default,"
      && trim(s: phases.stdout) == "public,draft,secret,"

    let file_facts_grounded = trim(s: copy_metadata.stdout) == "bin/run (src/main.dag)"
        && string_contains(s: manifest.stdout, pattern: "755 * bin/run")
        && string_contains(s: manifest.stdout, pattern: "644 @ link")
        && string_contains(s: manifest.stdout, pattern: "644   src/main.dag")

    if all_operations_succeeded
      && identities_grounded
      && topology_grounded
      && file_facts_grounded {
      mercurial_r0_fixture_expected_execution_receipt()
    } else {
      join(
        [
          concat("all=", to_string(all_operations_succeeded)),
          concat("identities=", to_string(identities_grounded)),
          concat("topology=", to_string(topology_grounded)),
          concat("files=", to_string(file_facts_grounded)),
          concat("root_err=", root_committed.stderr),
          concat("left_err=", left_committed.stderr),
          concat("right_err=", right_committed.stderr),
          concat("phases=", phases.stdout),
          concat("heads=", heads.stdout),
          concat("copies=", copy_metadata.stdout),
          concat("manifest=", manifest.stdout),
          concat("verify_err=", verified.stderr),
        ],
        "|",
      )
    }
  }
}

test fn witness_mercurial_cli_fixture_projects_and_independently_reads_back() -> Bool {
  mercurial_r0_typed_execution_read_back() == mercurial_r0_fixture_expected_execution_receipt()
}
