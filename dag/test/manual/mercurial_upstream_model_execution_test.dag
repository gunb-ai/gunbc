module test.manual.mercurial_upstream_model_execution

import extdeps.shell.exec { TransportScript }
import gunbc.output_policy { ExpectSuccess }
import gunbc.retained_shell_script { retained_foreign }
import test.claim.mercurial_upstream_model_witness {
  mercurial_r0_fixture_expected_execution_receipt,
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data mercurial_r0_execution_receipt_note: String = "Offline wet T1 receipt for the bounded Mercurial R0 fixture. A real Mercurial CLI creates three changesets on two heads, observes portable node identities separately from clone-local revision numbers, reads a bookmark and local tag, checks public/draft/secret phases, copy metadata, manifest executable/symlink flags, repository requirements, and runs `hg verify`. The fixed result names only semantic facts; changeset hashes are computed and checked as 40-hex upstream identities rather than embedded. The script is a counted retained-foreign realization that dissolves into v2.workflow.bash_emit. Local recipe: put a real `hg` on PATH, then run claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/manual/mercurial_upstream_model_execution_test.dag --function witness_mercurial_cli_fixture_projects_and_independently_reads_back."

fn mercurial_r0_fixture_execution_script() -> TransportScript {
  retained_foreign(
    body: join(
      [
        "set -euo pipefail",
        "command -v hg >/dev/null",
        "fixture_tmp=$(mktemp -d)",
        "cleanup() { if [ -n \"$\{fixture_tmp:-}\" ] && [ -d \"$fixture_tmp\" ]; then rm -rf -- \"$fixture_tmp\"; fi; }",
        "trap cleanup EXIT",
        "repo=\"$fixture_tmp/repo\"",
        "hg init \"$repo\"",
        "mkdir -p \"$repo/src\" \"$repo/bin\"",
        "printf main >\"$repo/src/main.dag\"",
        "ln -s ../src/main.dag \"$repo/link\"",
        "hg -R \"$repo\" add \"$repo/src/main.dag\" \"$repo/link\"",
        "HGDATE='0 0' hg -R \"$repo\" -q --config ui.username=author@example.invalid commit -m root",
        "c0=$(hg -R \"$repo\" log -r . -T '\{node}')",
        "hg -R \"$repo\" -q phase --force --public -r \"$c0\"",
        "hg -R \"$repo\" copy \"$repo/src/main.dag\" \"$repo/bin/run\"",
        "printf run >\"$repo/bin/run\"",
        "chmod +x \"$repo/bin/run\"",
        "HGDATE='1 0' hg -R \"$repo\" -q --config ui.username=author@example.invalid commit -m left",
        "c1=$(hg -R \"$repo\" log -r . -T '\{node}')",
        "hg -R \"$repo\" -q bookmark -r \"$c1\" main",
        "hg -R \"$repo\" -q update -r \"$c0\"",
        "printf side >>\"$repo/src/main.dag\"",
        "HGDATE='2 0' hg -R \"$repo\" -q --config ui.username=author@example.invalid commit -m right",
        "c2=$(hg -R \"$repo\" log -r . -T '\{node}')",
        "hg -R \"$repo\" -q phase --force --secret -r \"$c2\"",
        "hg -R \"$repo\" -q tag --local -r \"$c2\" scratch",
        "for node in \"$c0\" \"$c1\" \"$c2\"; do test \"$\{#node}\" -eq 40; printf '%s\\n' \"$node\" | grep -Eq '^[0-9a-f]{40}$'; done",
        "test \"$(hg -R \"$repo\" log -r \"$c0\" -T '\{rev}')\" = 0",
        "test \"$(hg -R \"$repo\" log -r \"$c1\" -T '\{rev}')\" = 1",
        "test \"$(hg -R \"$repo\" log -r \"$c2\" -T '\{rev}')\" = 2",
        "test \"$(hg -R \"$repo\" heads -T '\{node}\\n' | wc -l | tr -d ' ')\" = 2",
        "test \"$(hg -R \"$repo\" log -r 'bookmark(main)' -T '\{node}')\" = \"$c1\"",
        "test \"$(hg -R \"$repo\" log -r 'tag(scratch)' -T '\{node}')\" = \"$c2\"",
        "test \"$(hg -R \"$repo\" log -r 'all()' -T '\{branch},')\" = 'default,default,default,'",
        "test \"$(hg -R \"$repo\" log -r 'all()' -T '\{phase},')\" = 'public,draft,secret,'",
        "test \"$(hg -R \"$repo\" log -r \"$c1\" -T '\{file_copies}')\" = 'bin/run (src/main.dag)'",
        "manifest=$(hg -R \"$repo\" manifest -v -r \"$c1\")",
        "printf '%s\\n' \"$manifest\" | grep -Eq '^755 \\* bin/run$'",
        "printf '%s\\n' \"$manifest\" | grep -Eq '^644 @ link$'",
        "printf '%s\\n' \"$manifest\" | grep -Eq '^644   src/main\\.dag$'",
        "test -s \"$repo/.hg/requires\"",
        "hg -R \"$repo\" verify >/dev/null 2>&1",
        "printf '%s\\n' 'node_width=40|local_revs=0,1,2|heads=2|bookmark=left|local_tag=right|branches=default,default,default|phases=public,draft,secret|copy=bin/run<-src/main.dag|flags=exec,symlink,regular|requirements=present|verify=ok'",
      ],
      "\n",
    ),
    reason: "Mercurial R0 wet fixture execution pending typed orchestration-to-shell emission",
  )
}

test fn witness_mercurial_cli_fixture_projects_and_independently_reads_back() -> Bool {
  let execution = shell.Exec.Run(
    script: mercurial_r0_fixture_execution_script(),
    expect: ExpectSuccess,
  )
  execution.success
    && trim(s: execution.stdout) == mercurial_r0_fixture_expected_execution_receipt()
}
