module test.manual.workspace_actor_record_census

import std.types { String, NonEmptyStr, Int, List, list_length }
import std.process { ProcessExit, exit_failure }
import gunbc.principal_projection { PrincipalRef }
import gunbc.fabric.fabric_storage_binding { fabric_state_storage_binding }
import gunbc.workspace_allocation_store { workspace_allocation_store, workspace_read_owner, WorkspaceStoreReadOk, WorkspaceStoreUnreadable }
import gunbc.workspace_acquisition_invocation {
  workspace_acquisition_store, workspace_recorded_actor,
  RecordedActorAbsent, RecordedActorInvocation, RecordedActorCancelled, RecordedActorLegacyBareId, RecordedActorUnreadable,
}

// READ-ONLY CENSUS of the workspace acquisition-actor records of ONE OWNER, run from a host that reaches the fabric
// endpoint (fabric_state_storage_binding). The store has no list operation, so the walk is owner -> allocations ->
// plan -> derived actor key -> head read; the caller names the owner (run once per owner):
//   gunbc run --source-root dag --source-root src/v2 --entry dag/test/manual/workspace_actor_record_census.dag \
//     --function workspace_actor_record_census --arg authority=<a> --arg namespace=<n> --arg subject=<s>
// It prints, per allocation carrying a plan, whether the actor record is a run wire, a bare legacy InvocationID
// (RecordedActorLegacyBareId), a cancellation tombstone, absent or unreadable, then the totals. It writes nothing.
// gunbc run carries only an exit reason out of an entry, so the report IS the exit reason (exit 1 by construction;
// the report, not the code, is the observation).
fn census_count(kinds: List<String>, kind: String) -> Int { list_length(items: filter(kinds, x => x == kind)) }

fn workspace_actor_record_census(authority: String, namespace: String, subject: String) -> ProcessExit {
  if authority == "" || namespace == "" || subject == "" { exit_failure(reason: "census: authority, namespace and subject are all required") }
  else {
    let owner = PrincipalRef { authority: authority as NonEmptyStr, namespace: namespace as NonEmptyStr, subject: subject as NonEmptyStr }
    let binding = fabric_state_storage_binding()
    match workspace_read_owner(store: workspace_allocation_store(binding: binding), owner: owner) {
      WorkspaceStoreUnreadable { reason: r } => exit_failure(reason: concat("census: owner ledger unreadable: ", r))
      WorkspaceStoreReadOk { snapshot: s } => {
        let kinds = map(s.allocations, a => match a.plan {
          Absent => "no-plan"
          Present { value: plan } => match workspace_recorded_actor(store: workspace_acquisition_store(binding: binding), plan: plan) {
            RecordedActorAbsent => "absent"
            RecordedActorInvocation { generation: _, run: _ } => "run-wire"
            RecordedActorCancelled { generation: _ } => "cancelled"
            RecordedActorLegacyBareId { generation: _, invocation_id: _ } => "legacy-bare-id"
            RecordedActorUnreadable { reason: _ } => "unreadable"
          }
        })
        exit_failure(reason: join(["census: allocations=", concat("", list_length(items: kinds)),
          " run-wire=", concat("", census_count(kinds: kinds, kind: "run-wire")), " legacy-bare-id=", concat("", census_count(kinds: kinds, kind: "legacy-bare-id")),
          " cancelled=", concat("", census_count(kinds: kinds, kind: "cancelled")), " absent=", concat("", census_count(kinds: kinds, kind: "absent")),
          " unreadable=", concat("", census_count(kinds: kinds, kind: "unreadable")), " no-plan=", concat("", census_count(kinds: kinds, kind: "no-plan")),
          " per-allocation=", join(kinds, ",")], ""))
      }
    }
  }
}
