module test.scratch_regen_c11

import std.types { String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.fleet_converge_workflow { expected_fleet_converge_yml, FleetConvergeYamlGenerated, FleetConvergeYamlGenerationRefused }

fn regen_c11() -> ProcessExit {
  match expected_fleet_converge_yml() {
    FleetConvergeYamlGenerationRefused { reason } => exit_failure(reason: reason)
    FleetConvergeYamlGenerated { content } => {
      let wrote = Filesystem.Write(path: ".github/workflows/fleet-converge.yml", content: content)
      if !wrote.success { exit_failure(reason: wrote.error) } else { ExitSuccess }
    }
  }
}
