module ctrl.pr_digests

import extdeps.github.pulls { PullRequest, PullReview, ReviewComment }
import extdeps.github.errors { GitHubErrorShape }
import std.types { NonEmptyStr }

type MergeReadinessVerdict
  = Ready
  | NotReady { first_reason: String, more_reasons: List<String> }

type AttachedUrl {
  url: NonEmptyStr
  container: AttachedUrlContainer
  context: AttachedUrlTextContext
}

type AttachedUrlContainer
  = PrBody
  | PullReviewBody
  | ReviewCommentBody

type AttachedUrlTextContext
  = Prose
  | InlineCode

type RestFallbackReason
  = GraphqlIncomplete
  | GraphqlRateLimited
  | GraphqlSchemaUnknown

service ctrl.PrDigests {
  operation ExtractAttachedUrls {
    input {
      pr: PullRequest
      reviews: List<PullReview>
      review_line_comments: List<ReviewComment>
    }
    output {
      urls: List<AttachedUrl>
    }
    readonly
  }

  operation RenderPrSummaryLine {
    input {
      pr: PullRequest
    }
    output {
      line: String
    }
    readonly
  }

  operation JudgeMergeReadiness {
    input {
      pr: PullRequest
      reviews: List<PullReview>
    }
    output {
      verdict: MergeReadinessVerdict
    }
    readonly
  }

  operation ClassifyRestFallback {
    input {
      error: GitHubErrorShape
    }
    output {
      reason: RestFallbackReason?
    }
    readonly
  }
}
