module ctrl.review_verdict

import std.types { ArtifactId, CommitSha, ContentHash, NonEmptyStr, Timestamp }
import extdeps.github.pulls { ReviewState }

type LlmReviewProvider
  = OpenaiPro
  | Codex
  | Claude
  | Cursor

type ReviewProvider
  = Llm { provider: LlmReviewProvider }
  | HumanReviewer
  | ProviderOther { name: NonEmptyStr }

type ReviewSource
  = LlmSource
  | Human
  | Policy
  | Unattributed

type PolicyRef {
  id: NonEmptyStr
  version: NonEmptyStr
}

type Reviewer
  = AgentReviewer { provider: LlmReviewProvider }
  | HumanSeatReviewer
  | PolicyReviewer { policy: PolicyRef }
  | UnattributedReviewer { provider_name: NonEmptyStr }

fn reviewer_source(reviewer: Reviewer) -> ReviewSource {
  match reviewer {
    AgentReviewer { provider: _ } => LlmSource
    HumanSeatReviewer => Human
    PolicyReviewer { policy: _ } => Policy
    UnattributedReviewer { provider_name: _ } => Unattributed
  }
}

type ReviewArtifactKind
  = GitHubReview { state: ReviewState }
  | GitHubReviewComment
  | GitHubIssueComment
  | DashboardReviewArtifact

type ReviewVerdict
  = Approve
  | ApproveWithComments
  | RequestChanges
  | NeedsHumanTriage
  | NoVerdict

type FindingSeverity
  = Blocking
  | NonBlocking
  | Info

type FindingPriority
  = P0
  | P1
  | P2
  | P3
  | Unprioritized

type VerdictEvidence
  = ExplicitVerdictLine { verdict: ReviewVerdict }
  | GitHubReviewStateEvidence { state: ReviewState }
  | BlockingFindingPresent
  | NoBlockingConcernsText
  | HumanOverride { reason: String }
  | TextualVerdictMarker { marker: NonEmptyStr }

type ReportExtractionState
  = ParsedDiscreteFindings
  | FallbackWholeCommentStored

type ParseDeferredState
  = DeferredCommentNotFound
  | DeferredAmbiguousShaMarker
  | DeferredEmptyComment

type ReviewArtifact {
  artifact_id: ArtifactId
  reviewer: Reviewer
  kind: ReviewArtifactKind
  repo: NonEmptyStr
  pr_number: Int

  source_commit_sha: CommitSha?
  source_url: NonEmptyStr?
  body_hash: ContentHash?
  body_text: String
  observed_at: Timestamp?
}

type ReviewFinding {
  index_in_run: Int
  severity: FindingSeverity
  priority: FindingPriority
  heading: String?
  path: String?
  line: Int?
  body: String
  source_artifact_id: ArtifactId
}

type ReviewVerdictReport {
  reviewer: Reviewer
  repo: NonEmptyStr
  pr_number: Int
  head_sha: CommitSha
  artifact_id: ArtifactId
  verdict: ReviewVerdict
  extraction_state: ReportExtractionState
  findings: List<ReviewFinding>
  evidence: List<VerdictEvidence>
  parsed_at: Timestamp?
}

type MergeReadinessTally {
  repo: NonEmptyStr
  pr_number: Int
  head_sha: CommitSha

  source_artifact_ids: List<ArtifactId>
  approval_count: Int
  request_changes_count: Int
  blocking_finding_count: Int
  mergeable_clean: Bool
}

type ReviewVerdictParseRequest {
  artifact: ReviewArtifact
  expected_head_sha: CommitSha
}

type ReviewVerdictParseResult
  = ParsedReport { report: ReviewVerdictReport }
  | ParseDeferred { state: ParseDeferredState, artifact: ReviewArtifact }

fn is_approving_verdict(verdict: ReviewVerdict) -> Bool {
  match verdict {
    Approve => true
    ApproveWithComments => true
    RequestChanges => false
    NeedsHumanTriage => false
    NoVerdict => false
  }
}

fn is_actionable_finding(finding: ReviewFinding) -> Bool {
  match finding.priority {
    P0 => true
    P1 => true
    P2 => match finding.severity {
      Blocking => true
      NonBlocking => false
      Info => false
    }
    P3 => match finding.severity {
      Blocking => true
      NonBlocking => false
      Info => false
    }
    Unprioritized => match finding.severity {
      Blocking => true
      NonBlocking => false
      Info => false
    }
  }
}

service ctrl.ReviewVerdicts {
  operation Parse {
    input {
      request: ReviewVerdictParseRequest
    }
    output {
      result: ReviewVerdictParseResult
    }
    readonly
  }

  operation Tally {
    input {
      repo: NonEmptyStr
      pr_number: Int
      head_sha: CommitSha
      reports: List<ReviewVerdictReport>
      mergeable_clean: Bool
    }
    output {
      tally: MergeReadinessTally
    }
    readonly
  }
}
