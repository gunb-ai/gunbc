module probe.p1

import std.types { Int }
import std.upsert_decision { ObservationVerdict, Converged, Drifted, Conflict, Inaccessible, UnknownRefused }

fn rank(v: ObservationVerdict) -> Int {
  match v {
    Converged => 0
    std.upsert_decision.Absent => 1
    Drifted => 2
    Conflict => 3
    Inaccessible => 4
    UnknownRefused => 5
  }
}
