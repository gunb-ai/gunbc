module t.c
type Link { id: String }
type Inf = Applicable { link: Link } | Insufficient { why: String }
type InfFold<R> {
  applicable: fn(Link) -> R
  insufficient: fn(String) -> R
}
fn inf_fold<R>(inf: Inf, fold: InfFold<R>) -> R {
  match inf {
    Applicable { link: link } => fold.applicable(link)
    Insufficient { why: why } => fold.insufficient(why)
  }
}
fn links(inf: Inf) -> List<Link> {
  inf_fold(inf: inf, fold: InfFold {
    applicable: fn(link) { [link] },
    insufficient: fn(_) { [] },
  })
}
